#!/sbin/openrc-run
# Self-hosted GitHub Actions runner for a non-root user (default: github-runner).
# Source: ~/dev/custom/system-files/ — installed to /etc/init.d/ by
# scripts/setup-github-runner. Runs the runner's ./run.sh as the user, after
# that user's rootless Docker is up, so jobs use the rootless daemon.

# Overridable in /etc/conf.d/github-runner
: "${RUNNER_USER:=github-runner}"
: "${RUNNER_DIR:=/home/github-runner/actions-runner}"
: "${RUNNER_OPTS:=}"

_uid="$(id -u "${RUNNER_USER}" 2>/dev/null || true)"

description="GitHub Actions self-hosted runner (user: ${RUNNER_USER})"

command="${RUNNER_DIR}/run.sh"
command_args="${RUNNER_OPTS}"
command_user="${RUNNER_USER}:${RUNNER_USER}"
# supervise-daemon watches run.sh and respawns it if it exits/crashes (not just
# at boot). respawn_delay spaces retries so a hard failure backs off instead of
# tight-looping; respawn_max=0 = retry indefinitely.
supervisor="supervise-daemon"
respawn_delay=5
respawn_max=0
directory="${RUNNER_DIR}"
pidfile="/run/${RC_SVCNAME}.pid"
# DND-812: the supervisor signals ONLY the command's pid on stop. Anything the
# command forked would re-parent to PID 1 and keep running (a "stopped" GitHub
# runner kept taking jobs that way). Tag the command's whole tree, for THIS
# instance only, so stop_post can end it and assert nothing is left. The lib
# is a root-owned copy of system-files/lib/initd-proc-tree.sh.
: "${ATHENA_PROC_TREE_LIB:=/usr/local/lib/athena/initd-proc-tree.sh}"
supervise_daemon_args="${supervise_daemon_args:+${supervise_daemon_args} }--env ATHENA_SVC_TREE=${RC_SVCNAME}"
output_log="/var/log/${RC_SVCNAME}.log"
error_log="/var/log/${RC_SVCNAME}.log"

# The runner and its jobs need the user's HOME, rootless Docker socket, and a
# sane PATH. The bundled .NET uses invariant globalization to avoid an ICU
# dependency on Gentoo.
export HOME="/home/${RUNNER_USER}"
export XDG_RUNTIME_DIR="/run/user/${_uid}"
export DOCKER_HOST="unix:///run/user/${_uid}/docker.sock"
# Prepend standard dirs but KEEP OpenRC's PATH (it holds the rc helper bin dir,
# e.g. /usr/libexec/rc/bin, where start-stop-daemon/mountinfo/shell_var live).
# Replacing it made those "command not found" and broke the start wrapper.
export PATH="/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:${PATH}}"
export DOTNET_SYSTEM_GLOBALIZATION_INVARIANT="${DOTNET_SYSTEM_GLOBALIZATION_INVARIANT:-1}"

depend() {
	need net
	after elogind firewall docker-rootless-github-runner
}

start_pre() {
	# start_pre runs as root; pre-create the logfile owned by the runner user,
	# because start-stop-daemon opens stdout/stderr AFTER dropping to that user
	# and /var/log is not user-writable. Uses coreutils only (not checkpath),
	# since this box's OpenRC helper env is unreliable.
	_log="/var/log/${RC_SVCNAME}.log"
	[ -e "${_log}" ] || : > "${_log}"
	chown "${RUNNER_USER}:${RUNNER_USER}" "${_log}" 2>/dev/null || true
	chmod 0644 "${_log}" 2>/dev/null || true
	if [ -z "${_uid}" ]; then
		eerror "user ${RUNNER_USER} does not exist — run setup-github-runner-user"
		return 1
	fi
	if [ ! -x "${command}" ]; then
		eerror "${command} not found — run scripts/setup-github-runner first"
		return 1
	fi
	if [ ! -f "${RUNNER_DIR}/.runner" ]; then
		eerror "runner not registered. As ${RUNNER_USER}, run:"
		eerror "  ${RUNNER_DIR}/config.sh --url https://github.com/CJPoll/gen_saas \\"
		eerror "    --token <TOKEN> --labels self-hosted,linux,x64 --unattended"
		return 1
	fi
	if [ ! -d "${XDG_RUNTIME_DIR}" ]; then
		eerror "${XDG_RUNTIME_DIR} missing — enable linger: loginctl enable-linger ${RUNNER_USER}"
		return 1
	fi
	_proc_tree_reap || return 1
}

# End every process of this instance's tree and assert none is left; stop
# fails loudly otherwise. The tree: tagged, or with its exe or cwd under
# RUNNER_DIR. Also runs before start, so a leftover from an unclean stop never
# becomes a second copy of the service.
_proc_tree_reap() {
	if [ ! -r "${ATHENA_PROC_TREE_LIB}" ]; then
		eerror "${ATHENA_PROC_TREE_LIB} is missing, so ${RC_SVCNAME} cannot end its process tree."
		eerror "Fix: sudo install -D -m 644 <custom checkout>/system-files/lib/initd-proc-tree.sh ${ATHENA_PROC_TREE_LIB}"
		return 1
	fi
	. "${ATHENA_PROC_TREE_LIB}" || return 1
	proc_tree_reap "${RC_SVCNAME}" "${_uid}" "${ATHENA_PROC_TREE_TIMEOUT:-10}" "${RUNNER_DIR}"
}

stop_post() {
	_proc_tree_reap
}
