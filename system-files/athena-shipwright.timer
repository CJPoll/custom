[Unit]
Description=Run athena-shipwright on a schedule (harness retrospective + repo sync)

[Timer]
# Nightly at 03:30 local time. Change OnCalendar to retune the cadence
# (e.g. "hourly", "*-*-* 03,15:30:00" for twice daily).
OnCalendar=*-*-* 03:30:00
# If the machine was asleep at the scheduled time, run once on next wake.
Persistent=true
# Spread the start a little so it never lands exactly on other timers.
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
