[Unit]
Description=athena-shipwright — mine fleet run artifacts and improve the Athena harness
Documentation=file://%h/dev/custom/ai/agents/athena-shipwright.md.in

[Service]
Type=oneshot
# oneshot + the runner's own flock: overlapping ticks are skipped, not queued.
ExecStart=%h/dev/custom/scripts/athena-shipwright-run.sh
Nice=10
# Give a long retrospective room to finish; adjust to taste.
TimeoutStartSec=3600
