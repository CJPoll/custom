# Options for the rootless Docker service (/etc/init.d/docker-rootless-athena).
#
# Which user's rootless daemon this service manages. The user must exist, have
# /etc/subuid + /etc/subgid ranges, and lingering enabled
# (loginctl enable-linger <user>). Default: athena.
#DOCKER_ROOTLESS_USER="athena"

# Extra args passed through to dockerd (inside dockerd-rootless.sh).
# Example: pin the storage driver.
#DOCKERD_ROOTLESS_OPTS="--storage-driver=fuse-overlayfs"
