#!/sbin/openrc-run
# Self-hosted GitLab Runner for a non-root user (default: gitlab-runner).
# Source: ~/dev/custom/system-files/ — installed to /etc/init.d/ by
# scripts/setup-gitlab-runner. One runner user per trust domain (DND-1937):
# /etc/init.d/gitlab-runner serves user gitlab-runner, and each OpenRC instance
# /etc/init.d/gitlab-runner.<suffix> (a symlink to this file) serves user
# gitlab-runner-<suffix>, after its own docker-rootless-gitlab-runner.<suffix>. Runs `gitlab-runner run` AS the user (a deliberate
# divergence from GitLab's default root-service packaging), after that user's
# rootless Docker is up, so the docker executor's jobs use the rootless daemon
# on the user's own socket.

# The default user follows the service name: gitlab-runner.<suffix> runs as
# gitlab-runner-<suffix>; anything else as gitlab-runner.
case "${RC_SVCNAME}" in
	gitlab-runner.?*) _default_user="gitlab-runner-${RC_SVCNAME#gitlab-runner.}" ;;
	*) _default_user="gitlab-runner" ;;
esac

# Overridable in /etc/conf.d/${RC_SVCNAME}
: "${RUNNER_USER:=${_default_user}}"
: "${RUNNER_HOME:=/home/${RUNNER_USER}}"
: "${RUNNER_CONFIG:=${RUNNER_HOME}/.gitlab-runner/config.toml}"
: "${RUNNER_BIN:=/usr/local/bin/gitlab-runner}"
: "${RUNNER_OPTS:=}"

_uid="$(id -u "${RUNNER_USER}" 2>/dev/null || true)"

description="GitLab Runner self-hosted (user: ${RUNNER_USER})"

command="${RUNNER_BIN}"
command_args="run --config ${RUNNER_CONFIG} --working-directory ${RUNNER_HOME} ${RUNNER_OPTS}"
command_user="${RUNNER_USER}:${RUNNER_USER}"
# supervise-daemon watches `gitlab-runner run` and respawns it if it exits/crashes
# (not just at boot). respawn_delay spaces retries so a hard failure backs off
# instead of tight-looping; respawn_max=0 = retry indefinitely.
supervisor="supervise-daemon"
respawn_delay=5
respawn_max=0
directory="${RUNNER_HOME}"
# DND-1439: test seams for the self-test (system-files/test/initd-proc-tree),
# which points these at its own temp dirs so it writes nothing under the real
# /var/log and needs no /run/user. Unset in production: the defaults below are
# the real paths. Namespaced ATHENA_INITD_*, and read from the init environment
# or a root-owned /etc/conf.d file, so nothing a runner job exports reaches an
# initd.
: "${ATHENA_INITD_LOG_DIR:=/var/log}"
: "${ATHENA_INITD_RUN_USER_DIR:=/run/user}"
pidfile="/run/${RC_SVCNAME}.pid"
# DND-812: the supervisor signals ONLY the command's pid on stop. Anything the
# command forked would re-parent to PID 1 and keep running (a "stopped" GitHub
# runner kept taking jobs that way). Tag the command's whole tree, for THIS
# instance only, so stop_post can end it and assert nothing is left. The lib
# is a root-owned copy of system-files/lib/initd-proc-tree.sh.
: "${ATHENA_PROC_TREE_LIB:=/usr/local/lib/athena/initd-proc-tree.sh}"
supervise_daemon_args="${supervise_daemon_args:+${supervise_daemon_args} }--env ATHENA_SVC_TREE=${RC_SVCNAME}"
# DND-838: when the command dies, supervise-daemon starts it again itself and
# runs NO start_pre, so the reap there never runs on that path. The command is
# therefore initd-reap-exec, which ends this instance's leftover tree on EVERY
# start (first or respawn) and then execs the real program: the word after
# `--`. It runs as command_user, next to the lib, root-owned.
: "${ATHENA_REAP_EXEC:=/usr/local/lib/athena/initd-reap-exec}"
_svc_program="${command}"
command_args="--lib ${ATHENA_PROC_TREE_LIB} --timeout ${ATHENA_PROC_TREE_TIMEOUT:-10} --anchor ${RUNNER_BIN} -- ${_svc_program}${command_args:+ ${command_args}}"
command="${ATHENA_REAP_EXEC}"
output_log="${ATHENA_INITD_LOG_DIR}/${RC_SVCNAME}.log"
error_log="${ATHENA_INITD_LOG_DIR}/${RC_SVCNAME}.log"

# The runner and its docker executor need the user's HOME, rootless Docker
# socket, and a sane PATH.
export HOME="${RUNNER_HOME}"
export XDG_RUNTIME_DIR="${ATHENA_INITD_RUN_USER_DIR}/${_uid}"
export DOCKER_HOST="unix://${ATHENA_INITD_RUN_USER_DIR}/${_uid}/docker.sock"
# Prepend standard dirs but KEEP OpenRC's PATH (it holds the rc helper bin dir,
# e.g. /usr/libexec/rc/bin, where start-stop-daemon/mountinfo/shell_var live).
# Replacing it made those "command not found" and broke the start wrapper.
export PATH="/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:${PATH}}"

depend() {
	need net
	after elogind firewall docker-rootless-${RC_SVCNAME}
}

# DND-1937: OpenRC sources /etc/conf.d/gitlab-runner before
# /etc/conf.d/gitlab-runner.<suffix>, so an instance inherits whatever the base
# conf.d sets and its own does not. An instance therefore refuses to start
# unless it resolved to its OWN user, that user's home, and a config inside it:
# one trust domain never runs as, or with the token of, another.
_instance_guard() {
	case "${RC_SVCNAME}" in
		gitlab-runner.?*) ;;
		*) return 0 ;;
	esac
	_want_home="$(getent passwd "${_default_user}" 2>/dev/null | cut -d: -f6)"
	: "${_want_home:=/home/${_default_user}}"
	if [ "${RUNNER_USER}" != "${_default_user}" ] || [ "${RUNNER_HOME}" != "${_want_home}" ]; then
		eerror "${RC_SVCNAME} resolved RUNNER_USER=${RUNNER_USER} RUNNER_HOME=${RUNNER_HOME}, not ${_default_user} ${_want_home} (inherited from /etc/conf.d/gitlab-runner?)"
		eerror "Fix: set RUNNER_USER=\"${_default_user}\", RUNNER_HOME=\"${_want_home}\" and RUNNER_CONFIG in /etc/conf.d/${RC_SVCNAME}, or re-run scripts/setup-gitlab-runner --user ${_default_user}"
		return 1
	fi
	case "${RUNNER_CONFIG}" in
		"${RUNNER_HOME}"/*) ;;
		*)
			eerror "${RC_SVCNAME} resolved RUNNER_CONFIG=${RUNNER_CONFIG}, outside ${RUNNER_HOME}"
			eerror "Fix: set RUNNER_CONFIG=\"${RUNNER_HOME}/.gitlab-runner/config.toml\" in /etc/conf.d/${RC_SVCNAME}"
			return 1 ;;
	esac
}

start_pre() {
	_instance_guard || return 1
	# start_pre runs as root; pre-create the logfile owned by the runner user,
	# because start-stop-daemon opens stdout/stderr AFTER dropping to that user
	# and /var/log is not user-writable. Uses coreutils only (not checkpath),
	# since this box's OpenRC helper env is unreliable.
	_log="${ATHENA_INITD_LOG_DIR}/${RC_SVCNAME}.log"
	[ -e "${_log}" ] || : > "${_log}"
	chown "${RUNNER_USER}:${RUNNER_USER}" "${_log}" 2>/dev/null || true
	chmod 0644 "${_log}" 2>/dev/null || true
	if [ -z "${_uid}" ]; then
		eerror "user ${RUNNER_USER} does not exist — run setup-gitlab-runner-user"
		return 1
	fi
	if [ ! -x "${_svc_program}" ]; then
		eerror "${_svc_program} not found — run scripts/setup-gitlab-runner first"
		return 1
	fi
	if [ ! -f "${RUNNER_CONFIG}" ] || ! grep -q '\[\[runners\]\]' "${RUNNER_CONFIG}" 2>/dev/null; then
		eerror "runner not registered (${RUNNER_CONFIG} has no [[runners]])."
		eerror "Fix: sudo <custom checkout>/scripts/setup-gitlab-runner --user ${RUNNER_USER} --runner <name>:<tag>"
		eerror "     (one glrt- token per --runner on stdin, never as an argument)"
		return 1
	fi
	if [ ! -d "${XDG_RUNTIME_DIR}" ]; then
		eerror "${XDG_RUNTIME_DIR} missing — enable linger: loginctl enable-linger ${RUNNER_USER}"
		return 1
	fi
	if [ ! -x "${ATHENA_REAP_EXEC}" ]; then
		eerror "${ATHENA_REAP_EXEC} is missing, so a respawn of ${RC_SVCNAME} could start next to a crashed copy's children."
		eerror "Fix: sudo install -D -m 755 <custom checkout>/system-files/lib/initd-reap-exec ${ATHENA_REAP_EXEC}"
		return 1
	fi
	_proc_tree_reap || return 1
}

# End every process of this instance's tree and assert none is left; stop
# fails loudly otherwise. The tree: tagged, or running RUNNER_BIN. Also runs
# before start, so a leftover from an unclean stop never becomes a second copy
# of the service.
_proc_tree_reap() {
	if [ ! -r "${ATHENA_PROC_TREE_LIB}" ]; then
		eerror "${ATHENA_PROC_TREE_LIB} is missing, so ${RC_SVCNAME} cannot end its process tree."
		eerror "Fix: sudo install -D -m 644 <custom checkout>/system-files/lib/initd-proc-tree.sh ${ATHENA_PROC_TREE_LIB}"
		return 1
	fi
	. "${ATHENA_PROC_TREE_LIB}" || return 1
	proc_tree_reap "${RC_SVCNAME}" "${_uid}" "${ATHENA_PROC_TREE_TIMEOUT:-10}" "${RUNNER_BIN}"
}

stop_post() {
	_proc_tree_reap
}
