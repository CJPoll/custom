# Example config for the self-hosted GitLab Runner (walt_ui).
#
# The LIVE config, WITH the `glrt-` authentication token, is generated by
# `gitlab-runner register` at ~gitlab-runner/.gitlab-runner/config.toml — that
# file is a secret and is NEVER committed. This example is the non-secret shape
# to reconcile the registered config against, especially the [runners.docker]
# block (which `register --docker-*` flags set, but which is easy to drift).
#
# Design (see system-files/gitlab-runner-runbook.md):
#   * privileged = false — the whole point of the rootless setup; a CI job can
#     never reach host root.
#   * security_opt unconfined — lets `moby/buildkit:rootless` (the job image used
#     for image builds) nest an unprivileged user namespace WITHOUT privileged.
#     Blast radius stays contained to the unprivileged gitlab-runner user. A
#     targeted seccomp profile permitting only BuildKit's syscalls is an optional
#     hardening upgrade; unconfined is acceptable for a single-owner monorepo.
#   * NO socket mount — image builds run via `buildctl-daemonless.sh` inside the
#     job (not `docker build` against a mounted daemon), so no daemon socket is
#     exposed to jobs.

concurrent = 3          # global cap on parallel jobs on this box; tune to capacity
check_interval = 0

[[runners]]
  name = "walt_ui-self-hosted-rootless"
  url = "https://gitlab.com"
  # token = "glrt-..."          # filled by `gitlab-runner register`; NEVER commit
  executor = "docker"
  [runners.docker]
    image = "alpine:3.20"
    privileged = false
    security_opt = ["seccomp:unconfined", "apparmor:unconfined"]
    volumes = ["/cache"]
