# Options for the self-hosted GitLab Runner (/etc/init.d/gitlab-runner, or an
# instance /etc/init.d/gitlab-runner.<suffix> with /etc/conf.d/gitlab-runner.<suffix>).
#
# Which user runs the runner. Must exist, have rootless Docker
# (docker-rootless-gitlab-runner[.<suffix>]), and lingering enabled. Default:
# gitlab-runner-<suffix> for an instance, else gitlab-runner. scripts/setup-gitlab-runner
# writes a new install's conf.d with these set.
#RUNNER_USER="gitlab-runner"
#RUNNER_HOME="/home/gitlab-runner"

# Path to the registered config.toml (holds the glrt- token + the [[runners]]
# block; generated by `gitlab-runner register`). NEVER commit this file.
#RUNNER_CONFIG="/home/gitlab-runner/.gitlab-runner/config.toml"

# The gitlab-runner binary.
#RUNNER_BIN="/usr/local/bin/gitlab-runner"

# Extra args to `gitlab-runner run` (rarely needed).
#RUNNER_OPTS=""
