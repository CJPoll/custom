#!/sbin/openrc-run
# Rootless Docker daemon for a non-root user (default: gitlab-runner).
# Source: ~/dev/custom/system-files/ — installed to /etc/init.d/ by
# scripts/setup-gitlab-runner-docker. Runs dockerd as the user with NO host
# root: separate socket ($XDG_RUNTIME_DIR/docker.sock) and data root
# (~/.local/share/docker), isolated from the system docker daemon AND from the
# github-runner user's rootless daemon. This is the Docker the self-hosted GitLab
# Runner's docker-executor jobs use.

# Overridable in /etc/conf.d/docker-rootless-gitlab-runner
: "${DOCKER_ROOTLESS_USER:=gitlab-runner}"
: "${DOCKERD_ROOTLESS_OPTS:=}"

_uid="$(id -u "${DOCKER_ROOTLESS_USER}" 2>/dev/null || true)"

description="Rootless Docker daemon (user: ${DOCKER_ROOTLESS_USER})"

command="/usr/bin/dockerd-rootless.sh"
command_args="${DOCKERD_ROOTLESS_OPTS}"
command_user="${DOCKER_ROOTLESS_USER}:${DOCKER_ROOTLESS_USER}"
# supervise-daemon watches the daemon and respawns it if it exits/crashes
# (not just at boot). respawn_delay spaces retries so a hard failure backs off
# instead of tight-looping; respawn_max=0 = retry indefinitely.
supervisor="supervise-daemon"
respawn_delay=5
respawn_max=0
# DND-1439: test seams for the self-test (system-files/test/initd-proc-tree),
# which points these at its own temp dirs so it writes nothing under the real
# /var/log and needs no /run/user. Unset in production: the defaults below are
# the real paths. Namespaced ATHENA_INITD_*, and read from the init environment
# or a root-owned /etc/conf.d file, so nothing a runner job exports reaches an
# initd.
: "${ATHENA_INITD_LOG_DIR:=/var/log}"
: "${ATHENA_INITD_RUN_USER_DIR:=/run/user}"
pidfile="/run/${RC_SVCNAME}.pid"
# DND-812: the supervisor signals ONLY the command's pid on stop. Anything the
# command forked would re-parent to PID 1 and keep running (a "stopped" GitHub
# runner kept taking jobs that way). Tag the command's whole tree, for THIS
# instance only, so stop_post can end it and assert nothing is left. The lib
# is a root-owned copy of system-files/lib/initd-proc-tree.sh.
: "${ATHENA_PROC_TREE_LIB:=/usr/local/lib/athena/initd-proc-tree.sh}"
supervise_daemon_args="${supervise_daemon_args:+${supervise_daemon_args} }--env ATHENA_SVC_TREE=${RC_SVCNAME}"
# DND-838: when the command dies, supervise-daemon starts it again itself and
# runs NO start_pre, so the reap there never runs on that path. The command is
# therefore initd-reap-exec, which ends this instance's leftover tree on EVERY
# start (first or respawn) and then execs the real program: the word after
# `--`. It runs as command_user, next to the lib, root-owned.
: "${ATHENA_REAP_EXEC:=/usr/local/lib/athena/initd-reap-exec}"
_svc_program="${command}"
command_args="--lib ${ATHENA_PROC_TREE_LIB} --timeout ${ATHENA_PROC_TREE_TIMEOUT:-10} -- ${_svc_program}${command_args:+ ${command_args}}"
command="${ATHENA_REAP_EXEC}"
output_log="${ATHENA_INITD_LOG_DIR}/${RC_SVCNAME}.log"
error_log="${ATHENA_INITD_LOG_DIR}/${RC_SVCNAME}.log"

export HOME="/home/${DOCKER_ROOTLESS_USER}"
export XDG_RUNTIME_DIR="${ATHENA_INITD_RUN_USER_DIR}/${_uid}"
# Prepend standard dirs but KEEP OpenRC's PATH (it holds the rc helper bin dir,
# e.g. /usr/libexec/rc/bin, where start-stop-daemon/mountinfo/shell_var live).
# Replacing it made those "command not found" and broke the start wrapper.
export PATH="/usr/sbin:/usr/bin:/sbin:/bin${PATH:+:${PATH}}"

depend() {
	need net
	after elogind firewall
}

start_pre() {
	# start_pre runs as root; pre-create the logfile owned by the daemon user,
	# because start-stop-daemon opens stdout/stderr AFTER dropping to that user
	# and /var/log is not user-writable. Uses coreutils only (not checkpath),
	# since this box's OpenRC helper env is unreliable.
	_log="${ATHENA_INITD_LOG_DIR}/${RC_SVCNAME}.log"
	[ -e "${_log}" ] || : > "${_log}"
	chown "${DOCKER_ROOTLESS_USER}:${DOCKER_ROOTLESS_USER}" "${_log}" 2>/dev/null || true
	chmod 0644 "${_log}" 2>/dev/null || true
	if [ -z "${_uid}" ]; then
		eerror "user ${DOCKER_ROOTLESS_USER} does not exist"
		return 1
	fi
	# Linger makes elogind create ${XDG_RUNTIME_DIR} at boot without a login.
	if [ ! -d "${XDG_RUNTIME_DIR}" ]; then
		eerror "${XDG_RUNTIME_DIR} is missing — enable lingering so it"
		eerror "persists at boot:  loginctl enable-linger ${DOCKER_ROOTLESS_USER}"
		return 1
	fi
	if [ ! -x "${ATHENA_REAP_EXEC}" ]; then
		eerror "${ATHENA_REAP_EXEC} is missing, so a respawn of ${RC_SVCNAME} could start next to a crashed copy's children."
		eerror "Fix: sudo install -D -m 755 <custom checkout>/system-files/lib/initd-reap-exec ${ATHENA_REAP_EXEC}"
		return 1
	fi
	_proc_tree_reap || return 1
}

# End every process of this instance's tree and assert none is left; stop
# fails loudly otherwise. The tree: rootlesskit, dockerd, containerd and
# shims: all tagged. Also runs before start, so a leftover from an unclean
# stop never becomes a second copy of the service.
_proc_tree_reap() {
	if [ ! -r "${ATHENA_PROC_TREE_LIB}" ]; then
		eerror "${ATHENA_PROC_TREE_LIB} is missing, so ${RC_SVCNAME} cannot end its process tree."
		eerror "Fix: sudo install -D -m 644 <custom checkout>/system-files/lib/initd-proc-tree.sh ${ATHENA_PROC_TREE_LIB}"
		return 1
	fi
	. "${ATHENA_PROC_TREE_LIB}" || return 1
	proc_tree_reap "${RC_SVCNAME}" "${_uid}" "${ATHENA_PROC_TREE_TIMEOUT:-10}"
}

stop_post() {
	_proc_tree_reap
}
