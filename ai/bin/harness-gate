}.freeze

# tool -> why its inline --self-test is NOT run by the gate. Only for a suite
# that is not gate-safe, or a tool that mentions the flag without defining a
# suite of its own. Never to turn a red suite green.
# Empty today: every inline suite found at DND-507 is gate-safe.
INLINE_SELF_TEST_EXCEPTIONS = {}.freeze

MIN_EXCEPTION_REASON = 20

def comment_line?(line)
  line.lstrip.start_with?("#")
end

# The non-comment lines of a text file; [] for a binary or unreadable file.
def code_lines(abs)
  data = File.binread(abs)
  return [] if data.include?("\0")

  data.force_encoding(Encoding::UTF_8).scrub.each_line.reject { |l| comment_line?(l) }
rescue SystemCallError
  []
end

def inline_self_test_definer?(abs)
  code_lines(abs).any? { |l| l.match?(INLINE_SELF_TEST_RE) }
end

# Does the tool's code name `suite` specifically enough to be the thing it
# execs? The basename alone is enough unless it is the generic self-test.sh,
# which then needs its parent directory too ("control/self-test.sh").
def names_suite?(tool_lines, suite)
  segs = suite.split("/")
  need = segs.last == "self-test.sh" ? 2 : 1
  tail = segs.last(need).join("/")
  tool_lines.any? { |l| l.include?(tail) }
end

def covered_by_corroborated?(root, tool, suite)
  tool_lines = code_lines(File.join(root, tool))
  return true if names_suite?(tool_lines, suite)

  suite_lines = code_lines(File.join(root, suite))
  suite_lines.any? { |l| l.include?(File.basename(tool)) } &&
    suite_lines.any? { |l| l.match?(INLINE_SELF_TEST_RE) }
end

# The whole evaluation, as data. Raises FirstParty::MeasureError when it cannot
# measure: no git, an empty first-party set, or zero definers (this repo has
# dozens, so zero means the detector broke, not that there is nothing to run).
def inline_self_test_coverage(root:, checks: STATIC_CHECKS + self_test_checks(root),
                              delegates: SELF_TEST_DELEGATES,
                              covered_by: INLINE_SELF_TEST_COVERED_BY,
                              exceptions: INLINE_SELF_TEST_EXCEPTIONS)
  tools, found, skipped = FirstParty.executables(root)
  raise FirstParty::MeasureError, "discovered 0 first-party files under #{root}" if found.empty?
  raise FirstParty::MeasureError, "discovered 0 first-party executables under #{root}" if tools.empty?

  candidates = tools.select { |rel| inline_self_test_definer?(File.join(root, rel)) }
  if candidates.empty?
    raise FirstParty::MeasureError,
          "found no inline --self-test in #{tools.size} first-party executable(s) under #{root}"
  end

  run_paths = checks.map { |(_, argv)| argv.first }
  # One tool may declare its suite as several DISTINCT argvs (harness-gate's
  # own --self-test --group NAME, DND-1007): each runs a different part, so
  # that tool is accounted once. The same argv declared twice still runs the
  # same suite twice, and is an error below.
  declared_argvs = checks.map { |(_, argv)| argv }.select { |argv| argv.drop(1).include?("--self-test") }
  declared = declared_argvs.map(&:first).uniq
  errors = []
  declared_argvs.tally.each do |argv, n|
    next if n < 2

    errors << "#{argv.join(' ')} is declared #{n} times in STATIC_CHECKS; " \
              "its suite would run #{n} times"
  end

  accounted = Hash.new { |h, k| h[k] = [] }
  declared.each { |t| accounted[t] << "STATIC_CHECKS" }
  delegates.each_key { |t| accounted[t] << "SELF_TEST_DELEGATES" }
  covered_by.each_key { |t| accounted[t] << "INLINE_SELF_TEST_COVERED_BY" }
  exceptions.each_key { |t| accounted[t] << "INLINE_SELF_TEST_EXCEPTIONS" }
  accounted.each do |tool, where|
    next if where.size < 2

    errors << "#{tool} is accounted for more than one way (#{where.join(', ')}); " \
              "its suite would run twice or be excepted while declared"
  end

  exceptions.each do |tool, reason|
    next if reason.to_s.strip.length >= MIN_EXCEPTION_REASON

    errors << "INLINE_SELF_TEST_EXCEPTIONS[#{tool}] needs a real reason (why the suite " \
              "is not gate-safe), got #{reason.inspect}"
  end

  covered_by.merge(delegates).each do |tool, check|
    next if run_paths.include?(check)

    errors << "#{tool} is marked covered by #{check}, which is not a check the gate runs"
  end

  uncorroborated = covered_by.select do |tool, suite|
    candidates.include?(tool) && run_paths.include?(suite) &&
      !covered_by_corroborated?(root, tool, suite)
  end.keys.sort

  map_keys = (delegates.keys + covered_by.keys + exceptions.keys).uniq
  {
    root: root,
    tools: tools,
    skipped: skipped,
    candidates: candidates,
    uncovered: (candidates - declared - map_keys).sort,
    stale: (map_keys - candidates).sort,
    uncorroborated: uncorroborated,
    errors: errors,
  }
end

def failed_inline_coverage?(result)
  %i[uncovered stale uncorroborated errors].any? { |k| result[k].any? }
end

# Prints the verdict; returns 0 or 1.
def report_inline_self_test_coverage(result)
  summary = "#{result[:candidates].size} of #{result[:tools].size} first-party " \
            "executable(s) define an inline --self-test " \
            "(#{result[:skipped].size} untracked third-party file(s) skipped)"
  unless failed_inline_coverage?(result)
    puts "inline --self-test coverage: OK — #{summary}; every one is run or excepted"
    return 0
  end

  warn "harness-gate: FAILED — inline --self-test coverage (#{summary}):"
  unless result[:uncovered].empty?
    warn "  inline --self-test suite(s) the gate never runs:"
    result[:uncovered].each { |t| warn "    - #{t}" }
    warn "  Fix: run `<tool> --self-test` once. If it is gate-safe (no model, no " \
         "network, no live config), add [\"<tool> self-test\", %w[<tool> --self-test]] " \
         "to STATIC_CHECKS in ai/bin/harness-gate. If its --self-test only execs a " \
         "suite the gate already runs (or such a suite runs it), map it in " \
         "INLINE_SELF_TEST_COVERED_BY instead. Only a suite that truly cannot run " \
         "in the gate goes in INLINE_SELF_TEST_EXCEPTIONS, with that reason. If the " \
         "suite is red, fix it; never except it to make this pass."
  end
  unless result[:stale].empty?
    warn "  map entries whose tool no longer exists or no longer defines --self-test:"
    result[:stale].each { |t| warn "    - #{t}" }
    warn "  Fix: remove each stale entry from SELF_TEST_DELEGATES / " \
         "INLINE_SELF_TEST_COVERED_BY / INLINE_SELF_TEST_EXCEPTIONS in " \
         "ai/bin/harness-gate, or restore the tool if it was removed by mistake."
  end
  unless result[:uncorroborated].empty?
    warn "  INLINE_SELF_TEST_COVERED_BY entries with no evidence the named suite runs the tool's suite:"
    result[:uncorroborated].each { |t| warn "    - #{t} -> #{INLINE_SELF_TEST_COVERED_BY[t]}" }
    warn "  Fix: point the entry at the suite the tool's --self-test actually execs " \
         "(its code must name that path), or at a suite that runs `<tool> --self-test`; " \
         "otherwise declare the tool in STATIC_CHECKS."
  end
  unless result[:errors].empty?
    warn "  malformed coverage bookkeeping:"
    result[:errors].each { |e| warn "    - #{e}" }
    warn "  Fix: account for each tool exactly once, give every exception a real " \
         "reason, and point every covering entry at a check in CHECKS."
  end
  1
end

# Measure + report, with a measurement failure reported as a failure.
def run_inline_self_test_coverage(root = CUSTOM_DIR)
  report_inline_self_test_coverage(inline_self_test_coverage(root: root))
rescue FirstParty::MeasureError => e
  warn "harness-gate: FAILED — could not measure inline --self-test coverage: #{e.message}"
  warn "  Fix: run from a git checkout of ~/dev/custom with git on PATH. A " \
       "coverage check that cannot look must not pass; if discovery or the " \
       "--self-test detector in ai/bin/harness-gate / ai/lib/first_party.rb " \
       "broke, repair it rather than skipping this check."
  1
end

# `git ls-files` under root, or nil if root isn't a git worktree (a --self-test
# fixture root, deliberately never a git repo). Used to keep discovery scoped
# to committed source: a raw Dir.glob would also pick up an untracked/ignored
# tree that happens to exist in this checkout — e.g. this repo's own
# `ai/skills/synced/` (".gitignore: vendored plugin skills; NOT harness
# source") — silently promoting vendored third-party code into the blocking
# gate, with a `Fix: chmod +x it` for code we don't own if it isn't executable.
# It would also make the check LIST itself a property of the checkout rather
# than the commit. When root has no git metadata (a fixture tmpdir), this
# returns nil and callers skip the filter, so the existing fixture-based
# --self-test cases are unaffected.
# Raised only when root IS a confirmed git worktree but `git ls-files` itself
# failed — never for "this isn't a repo" (see below). Left uncaught, this must
# never surface as a bare Ruby backtrace (CLAUDE.md -> "Guard/error messages
# are written for the LLM"); the top-level dispatch below rescues it into a
# Fix:-carrying message.
GitTrackingError = Class.new(StandardError)

def tracked_files(root)
  # Two DISTINCT questions, on purpose, so failure can never look like "not a
  # repo" (fail nil/skip-filter — the fixture-root case) when it is actually
  # "a repo git itself couldn't read" (fail LOUD — the ai/skills/synced/ case
  # this filter exists to guard, if it ever went wrong). Collapsing them was a
  # prior version's bug: both a fixture root AND a `git`/`.git` error returned
  # nil, so a genuine git failure on the REAL repo would have silently skipped
  # the filter and let an untracked/vendored self-test.sh straight into the
  # blocking gate — the exact failure this filter exists to prevent.
  _out, _err, probe = Open3.capture3("git", "-C", root, "rev-parse", "--is-inside-work-tree")
  return nil unless probe.success? # not a git worktree at all -> a fixture root; skip the filter

  out, err, status = Open3.capture3("git", "-C", root, "ls-files")
  raise GitTrackingError, "git -C #{root} ls-files failed: #{err.strip}" unless status.success?

  out.split("\n")
rescue Errno::ENOENT
  raise GitTrackingError, "git executable not found on PATH"
end

# ---------------------------------------------------------------------------
# WHICH TREE AM I GATING?
#
# Every check in CHECKS is resolved against CUSTOM_DIR, which is derived from
# __dir__ — the location of THIS FILE, not the caller's cwd. So
# `~/dev/custom/ai/bin/harness-gate`, run from a worktree, gates the MAIN
# CHECKOUT and reports PASS about code the caller is not committing. Nothing in
# the output said so: the gate printed per-check PASS and "38/38 ... safe to
# commit" without ever naming the tree it measured.
#
# Measured 2026-09-20 (run 2026-09-20-notif-platform, state.md "CORRECTED
# DIAGNOSIS"): an admiral gated the dnd-247 worktree with the main checkout's
# binary. check-inbox-registry compares the LIVE registry against the
# registry.json beside the script, so it compared MAIN's copy — the gate went
# RED, was diagnosed as live-registry "drift", and an operational revert was
# considered before the real cause (wrong tree) was found. A false GREEN in the
# same shape is the strictly worse half and leaves no symptom at all.
#
# This is CLAUDE.md -> "A failed lookup must never look like an empty one" at
# the level of a measurement: a gate run against the wrong tree is
# indistinguishable from a gate run against the right one. Two responses, in
# order of how much they cost:
#   1. ALWAYS name the tree in the output, so any PASS/FAIL can be attributed.
#   2. REFUSE when cwd is a DIFFERENT worktree OF THE SAME REPO — the one state
#      where the caller demonstrably has their own copy of every file and the
#      main-checkout path can only be a mistake.
# Deliberately NOT refused: a cwd outside any repo, or inside an UNRELATED repo
# (gating custom from elsewhere is a real thing to want), or a cwd that cannot
# be resolved at all. Fail open, per house style — but say so, never silently.
TreeIdentityError = Class.new(StandardError)

# [worktree_root, repo_identity] for `dir`, both absolute realpaths, or nil if
# `dir` is not inside a git worktree (fail-open: nothing to compare).
def git_tree_identity(dir)
  return nil unless File.directory?(dir.to_s)

  top, _e, st = Open3.capture3("git", "-C", dir, "rev-parse", "--show-toplevel")
  return nil unless st.success?

  common, _e2, st2 = Open3.capture3("git", "-C", dir, "rev-parse", "--git-common-dir")
  return nil unless st2.success?

  top = top.strip
  common = common.strip
  return nil if top.empty? || common.empty?

  # THE TRAP THIS REPO HAS HIT FOUR TIMES (DND-183/202/208, custom PR #6):
  # --git-common-dir is CWD-RELATIVE in a main checkout (literally ".git") and
  # absolute only in a linked worktree. Left unexpanded, a main checkout and
  # its own worktree yield ".git" vs "/abs/path/.git" — UNEQUAL — so the two
  # would be classified as different repositories and the guard below would
  # never fire. `git -C dir` makes the relative form relative to `dir`, so
  # expand against `dir` and NEVER against Dir.pwd. A value still not absolute
  # after expansion is a FAILED resolution, not a legitimate no-match.
  #
  # The EXPANSION is the live defence and is what --self-test case 7b drives
  # (with a stubbed git returning the relative form). The raise below is a
  # backstop only: File.expand_path always yields an absolute path today, so
  # it is unreachable until someone resolves this value a different way —
  # which is exactly when a silent relative path would come back.
  common = File.expand_path(common, dir)
  unless common.start_with?("/")
    raise TreeIdentityError,
          "git -C #{dir} rev-parse --git-common-dir gave #{common.inspect}, which is not an absolute path"
  end

  [File.realpath(top), File.realpath(common)]
rescue Errno::ENOENT, Errno::EACCES
  nil
end

# nil when there is nothing to refuse; otherwise the two tree roots, as
# [cwd_root, gate_root]. Pure (both inputs injected) so --self-test can drive
# it with fixture repos instead of the live checkout.
def foreign_gate_tree(gate_root: CUSTOM_DIR, cwd: Dir.pwd)
  here = git_tree_identity(cwd)
  gate = git_tree_identity(gate_root)
  return nil if here.nil? || gate.nil?   # cannot tell -> allow
  return nil if here[0] == gate[0]       # same worktree -> the normal case
  return nil if here[1] != gate[1]       # a genuinely different repo -> allow

  [here[0], gate[0]]
end

# ATTRIBUTION FOR THE OK/FAILED SUMMARY LINES. DND-896: the wrong-tree guard
# above stops a MISMATCHED gate from running at all, but even a matched run's
# final "OK -- N/N checks PASS; safe to commit." line named neither the tree
# nor the HEAD it measured -- a report that quotes only that line (as captains
# do) cannot be attributed to a commit. Deliberately reuses git_tree_identity,
# the SAME resolution foreign_gate_tree already trusts, rather than
# recomputing the root a second way: a second implementation could name a
# DIFFERENT tree than the one that was actually gated, which is exactly the
# failed-lookup-reads-as-success class this ticket exists to close.
#
# WHEN it is read matters as much as how (coordinator-train critic on
# b8a500b8). The gate runs for minutes, possibly in a shared checkout, so the
# tree can move under it: a commit, a checkout, an edit. A snapshot read only
# at report time names the tree as it is THEN, which may be a commit no check
# ever ran against. So run_gate takes the snapshot BEFORE anything measures
# the tree, and the report re-reads it: the same tree -> the line names it;
# a different one -> FAILED with a Fix:, never an OK naming either.
GateAttributionError = Class.new(StandardError)

# One reading of a gated tree. `fingerprint` covers HEAD, the index and
# working-tree state (`git status`), the content of every tracked change
# (`git diff HEAD --binary`), the index's content (`git diff --cached
# --binary`, so an index-only change to an already-`MM` file counts), and
# the content of every untracked,
# not-ignored file, so any edit between two readings changes it -- not just
# a HEAD move or a newly dirty tree. Ignored files are outside it on purpose:
# they are build and runtime output, not the tree under review.
GateSnapshot = Struct.new(:worktree_root, :sha, :dirty, :fingerprint, keyword_init: true) do
  # " [tree <root> @ <sha>]", with ", dirty" inside the brackets when the
  # worktree has uncommitted changes (staged, unstaged, or untracked).
  def attribution
    " [tree #{worktree_root} @ #{sha}#{dirty ? ', dirty' : ''}]"
  end
end

def gate_git!(worktree_root, *args)
  out, _e, st = Open3.capture3("git", "--no-optional-locks", "-C", worktree_root, *args)
  raise GateAttributionError, "git -C #{worktree_root} #{args.join(' ')} failed" unless st.success?

  out
rescue Errno::ENOENT
  raise GateAttributionError, "git executable not found on PATH"
end

# Digest of every untracked file's content, in the order `git status -z`
# listed them. A symlink contributes its target; a file that vanished
# between the listing and the read, or that the gate cannot read (a
# root-owned 0600 file a container left), contributes a marker naming why.
# None of them raises: a bare Errno here would end the run with a backtrace
# and, at report time, discard every per-check result (case 7g).
def untracked_content_digest(worktree_root, status_z)
  paths = status_z.split("\0").select { |e| e.start_with?("?? ") }.map { |e| e[3..] }
  digest = Digest::SHA256.new
  paths.each do |rel|
    path = File.join(worktree_root, rel)
    digest << rel << "\0"
    digest << begin
      if File.symlink?(path) then "link:#{File.readlink(path)}"
      elsif File.file?(path) then Digest::SHA256.file(path).hexdigest
      else "missing"
      end
    rescue SystemCallError => e
      "unreadable:#{e.class}"
    end
    digest << "\0"
  end
  digest.hexdigest
end

# Raises rather than silently omitting/blanking when the tree or its HEAD
# cannot be resolved -- a MISSING attribution must never look like "nothing
# to report".
def gate_snapshot(root = CUSTOM_DIR)
  identity = git_tree_identity(root)
  raise GateAttributionError,
        "git_tree_identity(#{root}) could not resolve a worktree/common-dir " \
        "for the tree being gated" if identity.nil?

  worktree_root, = identity
  sha = gate_git!(worktree_root, "rev-parse", "HEAD").strip
  raise GateAttributionError,
        "git -C #{worktree_root} rev-parse HEAD returned an empty SHA" if sha.empty?

  status = gate_git!(worktree_root, "status", "--porcelain=v1", "-z", "--untracked-files=all")
  diff = gate_git!(worktree_root, "diff", "HEAD", "--binary")
  index = gate_git!(worktree_root, "diff", "--cached", "--binary")
  fingerprint = Digest::SHA256.hexdigest(
    [sha, status, Digest::SHA256.hexdigest(diff), Digest::SHA256.hexdigest(index),
     untracked_content_digest(worktree_root, status)].join("\0\0")
  )
  GateSnapshot.new(worktree_root: worktree_root, sha: sha, dirty: !status.empty?,
                   fingerprint: fingerprint)
end

def gate_attribution(root = CUSTOM_DIR)
  gate_snapshot(root).attribution
end

# The Fix: for any attribution failure, at start or at report time.
def gate_attribution_fix(root)
  "  Fix: run `git -C #{root} rev-parse HEAD` and `git -C #{root} status " \
    "--porcelain` by hand — one of them is failing, or #{root} is not inside a " \
    "resolvable git worktree."
end

# run_gate's snapshot of the tree it is about to gate, taken before anything
# measures it. Returns the GateSnapshot, or nil after printing a FAILED line
# with a Fix: -- a gate whose result could never be attributed stops before
# spending minutes on checks.
def gate_start_snapshot(root)
  snap = gate_snapshot(root)
  puts "harness-gate: checks run against#{snap.attribution}"
  snap
rescue GateAttributionError => e
  warn "harness-gate: FAILED — cannot identify the tree being gated, so no result " \
       "could be attributed to a commit: #{e.message}"
  warn "#{gate_attribution_fix(root)} No check has run yet."
  nil
end

# Byte-identical prefix `harness-gate: OK -- N/N checks PASS; safe to
# commit.` (consumers may match this prefix) with the tree/HEAD attribution
# appended.
def gate_ok_message(passed, total, attribution)
  "harness-gate: OK — #{passed}/#{total} checks PASS; safe to commit.#{attribution}"
end

# Same idea for the FAILED header line.
def gate_failed_header(count, total, attribution)
  "harness-gate: FAILED — #{count} of #{total} check(s) did not pass:#{attribution}"
end

# Re-reads root at report time and compares it with `pre`, the snapshot taken
# before the checks ran. Returns [attribution, nil] when it is the same tree,
# or [nil, [reason, fix]] when it moved or can no longer be read.
def verified_attribution(pre, root)
  post = gate_snapshot(root)
  if post.worktree_root == pre.worktree_root && post.fingerprint == pre.fingerprint
    return [pre.attribution, nil]
  end

  change = if post.sha == pre.sha
             "HEAD is still #{pre.sha}, but the working tree's contents changed"
           else
             "HEAD moved #{pre.sha} -> #{post.sha}"
           end
  [nil, ["the tree changed while the checks ran (#{change}), so the result " \
         "describes neither the tree at the start#{pre.attribution} nor the tree " \
         "now#{post.attribution}",
         "  Fix: something committed, checked out, or edited in #{pre.worktree_root} " \
         "during the run. Commit your work first, then re-run the gate in a tree " \
         "nothing else is writing to (your own worktree, not a shared checkout). " \
         "Do not quote either SHA as gated."]]
rescue GateAttributionError => e
  [nil, ["the gated tree could no longer be identified at report time: #{e.message}",
         gate_attribution_fix(root)]]
end

# DND-209: this repo has real self-tests (e.g. scripts/test/athena-inbox-client/
# self-test.sh, 42 cases; ai/skills/athena:inbox/test/self-test.sh;
# ai/skills/athena:slack/test/self-test.sh) that nothing ran automatically —
# harness-gate was 10/10 green and would have stayed green with every one of
# them deleted. DISCOVER them (glob), don't hand-declare them, so a future
# suite anywhere in the repo is covered with zero manual wiring step. Patch the
# class (every committed `self-test.sh`, wherever it lives), not the one site
# (scripts/test/) that happened to surface it, and not just the ones that
# happen to sit under a directory literally named `test/` (the earlier draft
# of this glob) — the same shape as check-hooks-registered's coverage of
# hooks, but here the check LIST itself is derived, not just diffed against
# disk.
#
# root is overridable so --self-test can prove discovery against a throwaway
# fixture tree instead of mutating any real directory in this repo.
def discover_self_tests(root = CUSTOM_DIR)
  # FNM_DOTMATCH (DND-422): without it `**/` never descends a dot-directory, so
  # a committed suite under e.g. `.auto-completions/` would silently never run.
  # The tracked filter below keeps `.git/` (and any shipwright lane inside it)
  # out, since `git ls-files` never lists it.
  candidates = Dir.glob(File.join(root, "**/self-test.sh"), File::FNM_DOTMATCH).map { |p| p.sub("#{root}/", "") }
  tracked = tracked_files(root)
  candidates = candidates.select { |p| tracked.include?(p) } if tracked
  candidates.sort
end

def self_test_checks(root = CUSTOM_DIR)
  discover_self_tests(root).map do |relpath|
    # The full relative path (minus the trailing filename) makes the label,
    # so distinct suites can never collide the way a leaf-basename-only label
    # would (e.g. two suites both living in a directory literally named `x`).
    ["self-test: #{relpath.sub(%r{/self-test\.sh\z}, '')}", [relpath]]
  end
end

# self_test_checks -> discover_self_tests -> tracked_files can raise
# GitTrackingError (see above) while this constant is evaluated at file load
# time, for EVERY invocation (including --list/--self-test), before the
# ARGV dispatch at the bottom of this file ever runs. Fall back to
# STATIC_CHECKS-only here so the file finishes loading; the SAME call is made
# again inside run_gate/run_list/run_self_test (they all call
# discover_self_tests(root) directly, not just through this constant), and
# THAT raise is caught by the rescue around the dispatch below, which reports
# it with a Fix: line instead of a bare Ruby backtrace.
# DND-404: runs LAST, after every discovered self-test — never merged into
# STATIC_CHECKS (which precedes self_test_checks below), or discovery order
# would put it before the suite it backstops.
# scripts/test/inbox-client-capture/self-test.sh starts real
# mock-athena-inbox-client.rb processes and reaps them by pid in its own
# trap; a trap cannot survive a SIGKILL of the suite (or of this gate
# process) itself. check-inbox-mock-orphans walks the mock's ancestor chain
# for a still-live self-test/gate launcher anywhere in it — proof of
# orphanhood that survives any kill of whatever started the mock (and a
# subreaper reparenting it to something other than PID 1), no marker or
# environment plumbing required — so it never depends on this process
# still being alive to run it; it just as usefully sweeps up whatever an
# EARLIER killed gate run left behind, which is the case that actually
# matters (see the script's own banner).
FINAL_CHECKS = [
  ["check-inbox-mock-orphans", %w[ai/bin/check-inbox-mock-orphans]],
].freeze

CHECKS =
  begin
    (STATIC_CHECKS + self_test_checks + FINAL_CHECKS).freeze
  rescue GitTrackingError
    STATIC_CHECKS + FINAL_CHECKS
  end

# The discovery CONTRACT is the exact filename `self-test.sh` — anything else
# (a suite named tests.sh, foo_test.sh, ...) is invisible to the glob with no
# count change to notice. discover_self_tests above is deliberately
# UNSCOPED (any `self-test.sh` anywhere is discovered), but this heuristic
# stays scoped to directories literally named `test/` — the established
# convention every real suite in this repo already follows — because widening
# it to "any misnamed .sh anywhere" would flag effectively every helper script
# in the repo, drowning the signal. So the two checks are intentionally
# asymmetric: discovery is unconditional, "did you probably mean this to be a
# suite" is a scoped heuristic. Flag it so a misnamed suite is at least visible
# instead of silently unrun (helper scripts a real self-test.sh `source`s or
# execs are expected to live in a test/ dir too, so this WARNS rather than
# fails the gate — it cannot tell a stray suite from a deliberate helper).
# Deliberately NOT filtered to executable files: a suite committed without its
# `+x` bit (invoked as `bash foo.sh`, say) is the exact case this exists to
# catch — filtering it out would leave the contract's most likely violation
# invisible to its own detector.
def stray_test_scripts(root = CUSTOM_DIR)
  candidates = Dir.glob(File.join(root, "**/test/**/*.sh"), File::FNM_DOTMATCH) # DND-422: dot-dirs too
                  .reject { |p| File.basename(p) == "self-test.sh" }
                  .map { |p| p.sub("#{root}/", "") }
  tracked = tracked_files(root)
  candidates = candidates.select { |p| tracked.include?(p) } if tracked
  candidates.sort
end

# Pure predicate so --self-test can exercise run_gate's zero-discovery
# decision directly, against a fixture root, instead of only asserting on
# discover_self_tests (which case 5 already covers) or having to run the
# whole gate to reach the branch.
def self_tests_found?(root = CUSTOM_DIR)
  !discover_self_tests(root).empty?
end

FAIL_TAIL_LINES = 20

# How many failure-bearing lines to surface from ANYWHERE in a check's output.
FAIL_GREP_LINES = 40

# A blind tail cannot name the case that failed. A suite that prints one line
# per case emits its `FAIL` line where the case ran and then keeps printing
# passing cases, so with 119 cases the last 20 lines are 20 OTHER cases' `ok`
# lines plus a "118 passed, 1 failed" total. That is a failure report that omits
# the failure: the reader learns something broke and is shown only things that
# worked, which is this repo's "Guard/error messages are written for the LLM"
# convention violated at the one moment the gate exists for. Measured 2026-09-21
# (shipwright 08:00Z): scripts/test/athena-shipwright failed twice under the
# gate and passed 5/5 standalone; the gate's own output could not name the case,
# so the intermittent failure could not be diagnosed at all.
#
# So: pull the failure-bearing lines out of the WHOLE output, then still print
# the tail (which carries the suite's own total and Fix: line). Matching is
# deliberately broad and case-sensitive on the loud spellings our suites use —
# a false positive costs one extra printed line, a false negative costs the
# diagnosis.
FAIL_LINE_RE = /(^|\s)(FAIL|FAILED|not ok|ERROR|Error:)\b/.freeze

def failure_lines(out)
  out.to_s.lines.grep(FAIL_LINE_RE)
end

# ---------------------------------------------------------------------------
# CPU SECONDS PER CHECK (DND-1005)
#
# What is measured: the user+system CPU of the check's process tree, taken
# from the kernel's child rusage (getrusage RUSAGE_CHILDREN) of a process
# whose ONLY child is the check. That figure includes the check and every
# descendant whose parent waited for it, recursively. It does not include a
# descendant that was orphaned (reparented, then reaped by someone else) or
# one the leak sweep had to kill: their CPU is charged to whoever reaped them.
#
# Why a shim: the gate's own child rusage (Process.times.cutime) is one
# process-wide counter. The pool runs several checks on threads at once, so
# a before/after delta around one check would also count every sibling check
# reaped in that window. Ruby exposes no wait4 rusage per child. So each
# check runs under CPU_SHIM, a few lines of Ruby exec'd with the gate's own
# interpreter (--disable=all: no gems, no RUBYOPT). The shim spawns the
# check's argv unchanged, waits for it, writes its child CPU to fd 3, and
# exits with the check's status (128+signal when the check was killed by
# one). The check keeps its argv, environment, working directory, stdin (an
# empty pipe), and stdout/stderr (the one captured pipe); fd 3 is
# close-on-exec in the shim, so the check never sees it. The shim adds one
# process between the gate and the check (the check's parent is the shim)
# and about 15 ms of startup per check (`time ruby --disable=all -e ...`:
# 0.015 s wall, 0.01 s user; measured once, 2026-09-29). The shim changes no signal
# disposition, so the check inherits what it did before. Its signal mask is
# empty either way: Ruby's spawn empties the mask in the child before exec,
# whichever thread spawns it and whatever that thread blocks (process.c,
# disable_child_handler_fork_child; self-test cases 15b and 15c). The shim's command
# line carries the check's argv, so a tool matching processes by argument
# sees one extra match per running check; the shim never outlives its
# check, so it is never an orphan of its own. A cpu figure the
# shim did not report (the shim was killed, or failed to start) is nil,
# printed as n/a and recorded as null: never a 0.
CPU_SHIM = <<~'SHIM'
  report = IO.for_fd(3)
  report.close_on_exec = true
  begin
    pid = Process.spawn([ARGV[0], ARGV[0]], *ARGV.drop(1))
  rescue SystemCallError => e
    $stdout.write("harness-gate: cannot execute #{ARGV[0]}: #{e.class}: #{e.message}\n")
    exit 127
  end
  _pid, status = Process.wait2(pid)
  t = Process.times
  report.write(format("%.6f\n", t.cutime + t.cstime))
  report.close
  exit(status.exitstatus || (128 + status.termsig.to_i))
SHIM

# The checks running right now, by label, with the reap tag each runs under.
# run_one registers a check when it starts and removes it when it returns
# normally; a check whose run_one was cut short by an interrupt stays, so the
# interrupt report can still name it (see INTERRUPTED RUNS). `abort!` stops
# the pool from starting another check.
class RunningChecks
  Entry = Struct.new(:label, :argv, :started, :tag)

  def initialize
    @lock = Mutex.new
    @entries = {}
    @aborted = false
  end

  # false (and nothing registered) once aborted: no check starts after the
  # interrupt report has taken its snapshot.
  def start(label, argv, tag)
    @lock.synchronize do
      next false if @aborted

      @entries[label] = Entry.new(label, argv, ReapTags.monotonic, tag)
      true
    end
  end

  def finish(label)
    @lock.synchronize { @entries.delete(label) }
  end

  # Stops every later start and returns what is running, in one step.
  def abort!
    @lock.synchronize do
      @aborted = true
      @entries.values.sort_by(&:started)
    end
  end

  def aborted?
    @lock.synchronize { @aborted }
  end
end

# Spawns the check under CPU_SHIM and captures its combined output.
# Returns [ok?, output, cpu_s or nil]. Reads the output to EOF, then reaps,
# as Open3.capture2e does. When anything cuts this short (an interrupt, or
# the thread being killed at exit), the shim is KILLed and reaped here, so
# nothing waits on a check that will never finish; the caller's leak sweep
# then kills the rest of the check's tree.
def spawn_under_cpu_shim(argv, chdir:, env:, aborted: -> { false })
  pipes = []
  pid = nil
  reaped = false
  begin
    out_r, out_w = IO.pipe.tap { |p| pipes.concat(p) }
    in_r, in_w = IO.pipe.tap { |p| pipes.concat(p) }
    cpu_r, cpu_w = IO.pipe.tap { |p| pipes.concat(p) }
    # A spawned shim is never untracked: no interrupt lands between the
    # spawn and the assignment.
    Thread.handle_interrupt(Object => :never) do
      pid = Process.spawn(env, RbConfig.ruby, "--disable=all", "-e", CPU_SHIM, "--", *argv,
                          chdir: chdir, in: in_r, out: out_w, err: out_w, 3 => cpu_w)
    end
    # An interrupt report that ran between this check's registration and its
    # spawn could not kill it, so it is killed here.
    Process.kill("KILL", pid) if aborted.call
    [in_r, in_w, out_w, cpu_w].each(&:close)
    out = out_r.read
    status = nil
    # An interrupt may cut the wait short (then the ensure kills and reaps the
    # shim), but never land after the reap and before `reaped` is set: that
    # would KILL and wait on a pid that may already belong to someone else.
    Thread.handle_interrupt(Object => :on_blocking) do
      _pid, status = Process.wait2(pid)
      reaped = true
    end
    raw = cpu_r.read_nonblock(64, exception: false)
    cpu = raw.is_a?(String) && raw.match?(/\A\d+\.\d+\n\z/) ? raw.to_f : nil
    [status.success?, out, cpu]
  ensure
    unless reaped || pid.nil?
      begin
        Process.kill("KILL", pid)
      rescue Errno::ESRCH
        nil
      end
      begin
        Process.wait(pid)
      rescue Errno::ECHILD
        nil
      end
    end
    pipes.each { |io| io.close unless io.closed? }
  end
end

# Run one check with stdin CLOSED (a check that reads stdin must never inherit
# the caller's terminal or a pipe — that is the false-green path). env is
# merged into the check's environment (a nil value unsets the variable).
# Returns [ok?, combined_output, cpu_s]; cpu_s is nil when it could not be
# measured (see CPU SECONDS PER CHECK). `running`, when given, registers the
# check under `label` while it runs (RunningChecks).
#
# DND-818: every check also runs under its own reap tag (ai/lib/reap_tags.rb).
# Once it has exited, anything still carrying the tag after the grace period
# is killed and the check FAILS, naming each process. The sweep is in an
# `ensure`, so it also runs when this gate is interrupted mid-check; then it
# kills at once (no grace), because the check did not exit on its own.
#
# DND-1316: every check also runs with a scratch-HOME sentinel first on PATH
# (SCRATCH-HOME SENTINEL above). A logged violation FAILS the check, with the
# sentinel's report appended; a gate HOME the sentinel cannot anchor fails it
# unrun.
def run_one(argv, chdir: CUSTOM_DIR, env: {}, label: nil, running: nil)
  tag = ReapTags.new_tag("gate-check")
  name = label || argv.join(" ")
  return [false, "harness-gate: not started — the gate was interrupted", nil] if running && !running.start(name, argv, tag)

  ok = false
  out = nil
  cpu = nil
  scan_failure = nil
  returned = false
  sentinel = nil
  unmeasured = nil
  begin
    # DND-1316: see SCRATCH-HOME SENTINEL. A HOME that cannot anchor the
    # comparison is a failed check (could not measure), never a clean one.
    path = env.key?("PATH") ? env["PATH"].to_s : ENV.fetch("PATH", "")
    sentinel = ScratchHomeSentinel.create(path: path, real_home: ENV.fetch("HOME", ""))
    spawn_env = env.merge("PATH" => ScratchHomeSentinel.path_with(sentinel, path))
                   .merge(ReapTags.env_with(tag, env.fetch(ReapTags::VAR, ENV[ReapTags::VAR])))
    ok, out, cpu = spawn_under_cpu_shim(argv, chdir: chdir, env: spawn_env,
                                        aborted: -> { running&.aborted? })
    returned = true
  rescue ScratchHomeSentinel::SetupError => e
    out = "harness-gate: FAIL — `#{argv.join(' ')}` was not run: the scratch-HOME sentinel could not be set " \
          "up: #{e.message}.\n  Fix: run the gate with HOME set to your real, absolute home directory."
    returned = true
  rescue Errno::ENOENT, Errno::EACCES => e
    out = "harness-gate: cannot execute #{argv.first}: #{e.class}: #{e.message}"
    returned = true
  ensure
    begin
      leaked = ReapTags.reap(tag, grace: returned ? ReapTags::DEFAULT_GRACE_S : 0)
    rescue ReapTags::ScanError => e
      # DND-1016: the sweep could not look, so "nothing leaked" is unknown.
      # What it did find was still killed (e.killed), and is reported too.
      scan_failure = "\nharness-gate: FAIL — the leak sweep after `#{argv.join(' ')}` could not look: #{e.message}\n"
      leaked = e.killed
    end
    # Read after the reap, so nothing the check left running can still log.
    # A sentinel the check deleted is "could not measure", never clean.
    hits = []
    begin
      hits = ScratchHomeSentinel.violations(sentinel) if sentinel
    rescue ScratchHomeSentinel::MeasureError => e
      unmeasured = "harness-gate: FAIL — `#{argv.join(' ')}` could not be judged for scratch-HOME " \
                   "shims (DND-1316): #{e.message}.\n  Fix: the check must leave the first PATH " \
                   "directory it was given (the gate's sentinel) in place; do not delete it."
    ensure
      ScratchHomeSentinel.remove(sentinel)
    end
  end
  running&.finish(name)
  unless hits.empty?
    ok = false
    out = "#{out}\n#{ScratchHomeSentinel.report(hits, ENV.fetch('HOME', ''))}"
  end
  if unmeasured
    ok = false
    out = "#{out}\n#{unmeasured}"
  end
  return [false, "#{out}#{scan_failure}#{leaked.empty? ? '' : leak_report(argv, leaked)}", cpu] if scan_failure
  return [ok, out, cpu] if leaked.empty?

  [false, "#{out}#{leak_report(argv, leaked)}", cpu]
end

def leak_report(argv, leaked)
  lines = ["harness-gate: FAIL — `#{argv.join(' ')}` exited but left #{leaked.size} process(es) " \
           "running #{ReapTags::DEFAULT_GRACE_S.to_i}s later (each now killed by pid):"]
  leaked.each { |(pid, cmd)| lines << "  pid=#{pid} #{cmd}" }
  lines << "  Fix: the check started these and did not reap them on its exit path. Track every " \
           "process it starts, or source scripts/test/lib/suite-reaper.bash and call " \
           "suite_reaper_begin + suite_reap_tagged (DND-818)."
  "\n#{lines.join("\n")}\n"
end

# ---------------------------------------------------------------------------
# THE LANDED REF, READ ONCE PER RUN (DND-735)
#
# check-guard-messages, check-tool-risk and check-bin-help read their bar from
# origin's main (ai/lib/landed.rb), and so do the suites that run them live
# (forge-preflight, harness-eval case 07, athena-inbox-poll F-12, each check's
# own live-tree case). Each compared the local ref with its own
# `git ls-remote` at its own moment. The gate takes 11-15 minutes; on
# 2026-09-26 main moved about every 15, so most runs straddled a push and went
# red on every one of those checks at once, with "the local landed ref
# disagrees with origin", for a reason unrelated to the change.
#
# So the gate reads origin's main ONCE, here, and hands the answer to every
# check (Landed::PIN_SHA_ENV, keyed to this repository by
# Landed::PIN_REPO_ENV). Every check then measures the same commit: origin's
# main as of the gate start. The guarantee is unchanged: a local ref that is
# not that commit (or a later one fetched from origin) still fails, and each
# check still asks origin and requires the pin to be proven on origin's main
# (fetching origin's objects, never a ref, when they are not here yet), so a
# hand-set pin cannot name a commit that never landed. It can name an older
# landed one: that residual is in ai/lib/landed.rb -> "ANYONE CAN SET AN
# ENVIRONMENT VARIABLE". A move during the run is reported once, as a NOTE
# naming both SHAs.
#
# The gate never passes on a pin it inherited: it always sets both variables,
# or clears both when origin cannot be read (each check then reads origin
# itself and fails as could-not-measure, as before).

# [env, probes]: env holds both pin variables (both nil when origin could not
# be read); probes is nil on success, else what was asked and what each gave.
def landed_pin_env(root = CUSTOM_DIR)
  [Landed.pin(root), nil]
rescue Landed::Unreadable => e
  [{ Landed::PIN_SHA_ENV => nil, Landed::PIN_REPO_ENV => nil }, e.probes]
end

# The line the gate prints about its pin.
def landed_pin_line(env, probes)
  sha = env[Landed::PIN_SHA_ENV]
  return "harness-gate: landed ref pinned: origin main @ #{sha[0, 12]} (`#{Landed::LS_REMOTE_PROBE}`, " \
         "read once); every landed-ref check measures against it" if sha

  "harness-gate: NOTE — could not pin the landed ref; each landed-ref check reads origin " \
    "itself and fails as could-not-measure. Probed: " +
    probes.to_a.map { |ref, outcome| "#{ref} -> #{outcome}" }.join("; ")
end

# nil when origin's main is still the pin; else a NOTE naming the move. Read
# at the end of the run, for the reader: it never changes the verdict.
def landed_moved_note(root, env)
  sha = env[Landed::PIN_SHA_ENV]
  return nil unless sha

  now = Landed.remote_tip(root, [])
  return nil if now == sha

  "harness-gate: NOTE — origin main moved during this run: #{sha[0, 12]} -> #{now[0, 12]}. " \
    "Every landed-ref check measured against #{sha[0, 12]}, origin's main at gate start. " \
    "Fix: to gate against the current main, `git fetch origin`, rebase onto #{now[0, 12]}, " \
    "and re-run."
rescue Landed::Unreadable => e
  "harness-gate: NOTE — could not re-read origin main after the run " \
    "(#{e.probes.last&.join(' -> ')}); every landed-ref check measured against #{sha[0, 12]}, " \
    "origin's main at gate start."
end

# ---------------------------------------------------------------------------
# ORIGIN FRESHNESS, CHECKED BEFORE ANY CHECK RUNS (DND-945)
#
# The landed-ref checks (check-guard-messages, check-tool-risk, check-bin-help)
# compare the local refs/remotes/origin/main against origin (ai/lib/landed.rb),
# and each one independently discovers a stale local ref as a Landed::Mismatch
# -- but only when THAT check happens to run, which can be 10+ minutes into a
# ~15 min gate. DND-876 measured exactly this: a stale local origin/main
# failed 7 checks at the END of a run; `git fetch` and a re-run of the SAME
# head passed 96/96. The fetch was always the fix; the gate just made it
# expensive to discover.
#
# So the gate checks freshness FIRST, reusing the SAME live read
# landed_pin_env already performs (no second network round trip -- see
# ai/lib/landed.rb -> "ONE READ PER GATE RUN"). Three outcomes, printed as
# TEXTUALLY DISTINCT lines on purpose (CLAUDE.md -> "A failed lookup must
# never look like an empty one" -- "found fresh" and "could not look" must
# never read the same):
#   - the pin could not be read at all (no network, no origin remote -- a
#     fixture/CI/sandbox environment): NOT a failure. Each landed-ref check
#     already degrades to its own could-not-measure report, so this says so
#     and CONTINUES rather than blocking a network-less run.
#   - the pin WAS read and the local ref already IS it: fresh, continue.
#   - the pin WAS read and the local ref is anything else (behind it, or
#     missing): `git fetch origin` was never run here, and every landed-ref
#     check would hit the same Mismatch this preflight now catches in
#     seconds. Fails fast, with a distinct exit code and a Fix:. Never
#     auto-fetches: a fetch mutates refs another process may be reading.
#
# NOT exit 3: elsewhere in this repo (check-hooks-registered,
# check-inbox-registry) exit 3 means "could not measure the landed bar" --
# environment-safe, not necessarily actionable. This is the opposite: origin
# WAS read, and it gave a definite, actionable answer (stale). Reusing 3 here
# would read to a script or reader who knows that convention as "nothing to
# do", exactly the confusion CLAUDE.md -> "A failed lookup must never look
# like an empty one" warns about. So this is its own, unused code.
ORIGIN_STALE_EXIT = 6

# [:fresh, sha] | [:stale, local_sha_or_nil, remote_sha] | [:unknown, reason].
# pin_env/pin_probes are exactly what landed_pin_env(root) returned -- passed
# in rather than re-read, so this never performs its own network call.
def origin_freshness(root, pin_env, pin_probes)
  remote = pin_env[Landed::PIN_SHA_ENV]
  unless remote
    reason = pin_probes.to_a.map { |ref, outcome| "#{ref} -> #{outcome}" }.join("; ")
    return [:unknown, reason]
  end

  local, ok = Landed.git_read(root, "rev-parse", "--verify", "--quiet", "#{Landed::REF}^{commit}")
  local = local.strip
  return [:fresh, remote] if ok && local == remote

  [:stale, (ok && !local.empty? ? local : nil), remote]
end

# Prints the outcome of origin_freshness. Returns true (proceed) or false
# (the gate must stop, with ORIGIN_STALE_EXIT).
def report_origin_freshness(result)
  status, a, b = result
  case status
  when :fresh
    puts "harness-gate: origin freshness OK — local #{Landed::REF} matches origin's " \
         "#{Landed::REMOTE_REF} (#{a[0, 12]})."
    true
  when :unknown
    puts "harness-gate: NOTE — could not verify origin freshness: #{a}. Proceeding " \
         "without a freshness preflight — any landed-ref check that needs origin will " \
         "read it itself and report could-not-measure if it also can't."
    true
  when :stale
    warn "harness-gate: FAILED — local #{Landed::REF} is stale " \
         "(#{a ? a[0, 12] : 'no local ref'}); origin's #{Landed::REMOTE_REF} is #{b[0, 12]}."
    warn "  Fix: run `git fetch origin`, then re-run ai/bin/harness-gate. Every " \
         "landed-ref check (check-guard-messages, check-tool-risk, check-bin-help, and " \
         "any suite that runs them live) compares the local #{Landed::REF} against " \
         "origin, and a stale local ref fails each of them with this same root cause " \
         "deep into the run — this preflight catches it in seconds instead. It never " \
         "auto-fetches: a fetch mutates refs another process may be reading."
    false
  else
    raise "origin_freshness returned an unrecognised status #{status.inspect}"
  end
end

# Runs the block with ENV temporarily merged with env (nil unsets); restores
# every key afterwards.
def with_env(env)
  saved = env.keys.to_h { |k| [k, ENV[k]] }
  env.each { |k, v| v.nil? ? ENV.delete(k) : ENV[k] = v }
  yield
ensure
  saved&.each { |k, v| v.nil? ? ENV.delete(k) : ENV[k] = v }
end

# ---------------------------------------------------------------------------
# PARALLEL EXECUTION (lead time)
#
# The gate ran its ~100 checks one after another: 13.4 min median, at 0.48
# CPU-seconds per second, because the slow suites mostly wait on their own
# 1-6 s timeouts. Measured 2026-09-27
# (ai-artifacts/coordination/2026-09-27-gate-timing-parallelism.md). The checks
# are already hermetic: three gates in three worktrees run concurrently every
# day. So the gate runs them on a bounded worker pool. The set of checks, each
# check's argv and environment, and "one red check fails the gate" are
# unchanged. Only the schedule changes.
#
# Three ordering edges survive parallelism:
# - PRE_POOL checks run before the pool starts. check-inotify-headroom measures
#   the machine's live inotify instances; run beside suites that hold instances,
#   it would measure its siblings.
# - CHAINS run in one worker, in order. check-agent-size reads the rendered
#   agent files, so it follows build-agents --check.
# - FINAL_CHECKS run after the pool drains (check-inbox-mock-orphans backstops
#   every suite that starts mock clients).
PRE_POOL_LABELS = ["check-inotify-headroom"].freeze
CHAINS = [["build-agents --check", "check-agent-size"]].freeze

# Results are keyed by label, and every ordering edge above is matched by
# label. So a duplicate label would let one check's result overwrite
# another's, and a renamed check would silently drop its edge. Both are
# refused before anything runs. Returns one message per problem; [] is sound.
def schedule_errors(checks)
  labels = checks.map(&:first)
  dups = labels.tally.select { |_, n| n > 1 }.keys
  errors = dups.map { |l| "label #{l.inspect} is declared #{labels.count(l)} times" }
  edge_labels = PRE_POOL_LABELS + CHAINS.flatten + FINAL_CHECKS.map(&:first)
  errors + (edge_labels - labels).map { |l| "ordering edge names #{l.inspect}, which no declared check has" }
end

# Workers: `--jobs N` (flag), else HARNESS_GATE_JOBS, else half the cores,
# capped at 8. At 8 workers the measured makespan equals the longest suite
# (~124 s), so more buys nothing. test-slot still caps how many gates run at
# once; this is per gate. test-slot weighs a gate by this count (DND-1006)
# and restates this default to do so: change both together. The flag and the variable share one validation: a
# positive integer, anything else raises. When the flag is given the
# variable is not read, so it cannot override or fail the flag.
JOBS_FORMAT = /\A[1-9]\d*\z/.freeze

def gate_jobs(env = ENV, cores: Etc.nprocessors, flag: nil)
  unless flag.nil?
    raise ArgumentError, "--jobs #{flag.inspect} is not a positive integer" unless flag.to_s.match?(JOBS_FORMAT)

    return flag.to_i
  end
  raw = env["HARNESS_GATE_JOBS"]
  return [[cores / 2, 1].max, 8].min if raw.nil? || raw.empty?
  raise ArgumentError, "HARNESS_GATE_JOBS=#{raw.inspect} is not a positive integer" unless raw.match?(JOBS_FORMAT)

  raw.to_i
end

# gate_jobs for the command line: the worker count, or nil after printing a
# usage error with a Fix: (the caller exits 2).
def resolve_gate_jobs(flag, env = ENV)
  gate_jobs(env, flag: flag)
rescue ArgumentError => e
  warn "harness-gate: usage error — #{e.message}."
  warn "  Fix: pass `--jobs N` or set HARNESS_GATE_JOBS to a positive integer (the worker " \
       "count; --jobs wins over the variable), or give neither for the default (half the " \
       "cores, at most 8). `--jobs 1` runs the checks one at a time."
  nil
end

# Per-check timings, one JSON line per check per run, so a slow gate can be
# explained from records (Cody, 2026-09-27: "our tooling should always have
# observability baked in"). The same file orders the next run longest-first.
def timings_path(env = ENV)
  base = env["XDG_STATE_HOME"].to_s.empty? ? File.join(Dir.home, ".local/state") : env["XDG_STATE_HOME"]
  File.join(base, "athena/harness-gate/timings.jsonl")
end

# label -> last recorded wall_s. Unreadable or absent -> {} (every check is
# then "unknown" and scheduled first, the safe order for a long unknown).
def last_durations(path)
  return {} unless File.readable?(path)

  File.foreach(path).each_with_object({}) do |line, h|
    rec = JSON.parse(line) rescue next
    h[rec["label"]] = rec["wall_s"].to_f if rec.is_a?(Hash) && rec["label"]
  end
end

# ~100 rows per run; keep about a week of runs, so the file (read in full on
# every run) stays near 2 MB instead of growing without bound.
TIMINGS_MAX_ROWS = 60_000
TIMINGS_KEEP_ROWS = 40_000

def record_timings(path, rows)
  FileUtils.mkdir_p(File.dirname(path))
  File.open(path, "a") { |f| rows.each { |r| f.puts(JSON.generate(r)) } }
  lines = File.readlines(path)
  if lines.size > TIMINGS_MAX_ROWS
    tmp = "#{path}.#{Process.pid}.tmp"
    File.write(tmp, lines.last(TIMINGS_KEEP_ROWS).join)
    File.rename(tmp, path)
  end
  nil
rescue SystemCallError => e
  warn "harness-gate: NOTE — could not record per-check timings to #{path} (#{e.class}: #{e.message}); " \
       "the verdict is unaffected. Fix: make #{File.dirname(path)} writable."
  nil
end

# Split checks into [pre, pooled_units, final]. A unit is an array of [label,
# argv] run in order by one worker. Every check lands in exactly one place.
def gate_units(checks)
  final_labels = FINAL_CHECKS.map(&:first)
  pre = checks.select { |(l, _)| PRE_POOL_LABELS.include?(l) }
  final = checks.select { |(l, _)| final_labels.include?(l) }
  rest = checks.reject { |(l, _)| PRE_POOL_LABELS.include?(l) || final_labels.include?(l) }
  by_label = rest.to_h { |c| [c.first, c] }
  chained = CHAINS.flatten
  units = CHAINS.map { |chain| chain.filter_map { |l| by_label[l] } }.reject(&:empty?)
  units += rest.reject { |(l, _)| chained.include?(l) }.map { |c| [c] }
  [pre, units, final]
end

# The environment one check runs in: the pinned gate env, plus the adjustment
# its CHECKS entry names in an optional third element. Only
# :stash_fixture_optout exists (DND-775); any other value is a declaration
# error, refused rather than silently run in the plain env.
def check_env(pin_env, opt)
  return pin_env if opt.nil?
  return pin_env.merge(stash_fixture_optout_env) if opt == :stash_fixture_optout

  raise ArgumentError, "harness-gate: unknown check option #{opt.inspect}. " \
        "Fix: a CHECKS entry's third element is nil or :stash_fixture_optout."
end

# Runs units on `jobs` threads, longest-first by `durations` (unknown first).
# Yields each finished check as [label, argv, ok, out, wall_s, cpu_s,
# started_at], started_at being the check's wall-clock start (a Time).
# `running` (RunningChecks) sees every check while it runs; once it is
# aborted, no worker starts another check.
def run_pool(units, jobs:, durations:, chdir:, env:, running: RunningChecks.new)
  cost = ->(u) { u.sum { |(l, _)| durations.fetch(l, Float::INFINITY) } }
  queue = Queue.new
  units.sort_by { |u| -cost.call(u) }.each { |u| queue << u }
  jobs.times { queue << :done }
  lock = Mutex.new
  Array.new([jobs, 1].max) do
    Thread.new do
      while (unit = queue.pop) != :done
        unit.each do |(label, argv, opt)|
          break if running.aborted?

          started_at = Time.now
          t0 = Process.clock_gettime(Process::CLOCK_MONOTONIC)
          ok, out, cpu = run_one(argv, chdir: chdir, env: check_env(env, opt), label: label, running: running)
          wall = Process.clock_gettime(Process::CLOCK_MONOTONIC) - t0
          lock.synchronize { yield [label, argv, ok, out, wall, cpu, started_at] }
        end
        break if running.aborted?
      end
    end
  end.each(&:join)
end

# ---------------------------------------------------------------------------
# INTERRUPTED RUNS (DND-1005)
#
# The gate sets no per-check timeout: a limit that fails a slow check would
# flip a verdict with machine speed. So a check that hangs holds the gate
# until something outside stops it: a Ctrl-C, or test-slot's `timeout`
# sending SIGTERM. Then the gate must say WHICH check it was waiting on, or
# a hang reads as "the gate is slow". On any signal (SIGINT, SIGTERM,
# SIGHUP) during the checks, run_checks prints INTERRUPTED with every check
# still running, by label, with how long it ran and its argv; stops the pool
# from starting another; kills each still-running check's process tree by
# its reap tag; and re-raises, so the gate dies by that signal (exit 130 for
# SIGINT, 143 for SIGTERM). Nothing is recorded to timings.jsonl for an
# interrupted run.
def report_interrupted(signal, running, finished, total, elapsed, err)
  still = running.abort!
  begin
    now = ReapTags.monotonic
    failed = finished.reject { |_, r| r[1] }.keys
    err.puts "harness-gate: INTERRUPTED by #{signal} after #{elapsed.round(1)}s — " \
             "#{still.size} check(s) still running:"
    still.each do |e|
      err.puts "  - #{e.label} (running #{(now - e.started).round(1)}s): #{e.argv.join(' ')}"
    end
    err.puts "  #{finished.size}/#{total} check(s) finished before the signal" \
             "#{failed.empty? ? '' : " (FAIL: #{failed.join(', ')})"}; " \
             "#{total - finished.size - still.size} not started or not yet recorded."
    err.puts "  Fix: a check named above as still running is what the gate was waiting on. " \
             "Run it alone from the gated tree (`cd <tree> && <argv above>`) and find what it " \
             "blocks on; the gate has no per-check timeout, so a hang shows up only here."
  rescue IOError, SystemCallError
    nil # stderr is gone (SIGHUP closed the tty, or its reader exited); still kill below
  ensure
    still.each do |e|
      ReapTags.reap(e.tag, grace: 0)
    rescue ReapTags::ScanError => x
      begin
        err.puts "  NOTE — could not confirm #{e.label}'s processes are gone: #{x.message}"
      rescue IOError, SystemCallError
        nil
      end
    end
  end
end

# The gate's check loop (DND-735). Reads the landed-ref pin ONCE from root's
# origin, prints it, then runs every check in chdir with that pin in its
# environment. The pin always replaces whatever the caller exported
# (landed_pin_env sets both variables, or clears both), so a check never
# measures an inherited pin. Checks run on a bounded pool (see PARALLEL
# EXECUTION); results print in DECLARED order, each with its wall and CPU
# seconds, so the output stays stable and diffable. root/chdir exist for
# --self-test case 12b: a fixture repo drives this exact loop. `pin`, when
# given, is a pre-computed [pin_env, pin_probes]: run_gate's origin-freshness
# preflight (DND-945) already read it, so this does not read origin a second
# time; nil (every other caller) reads it here. Returns [pin_env, failures],
# failures being [label, argv, output] per failed check, in declared order.
# An entry's optional third element names an environment adjustment
# (check_env); the only one is :stash_fixture_optout. A signal during the
# checks is reported on `err` and re-raised (INTERRUPTED RUNS).
def run_checks(checks, root: CUSTOM_DIR, chdir: CUSTOM_DIR, io: $stdout, jobs: gate_jobs,
               timings: timings_path, pin: nil, err: $stderr)
  dups = checks.map(&:first).tally.select { |_, n| n > 1 }.keys
  raise ArgumentError, "run_checks: duplicate check label(s) #{dups.inspect}" unless dups.empty?

  pin_env, pin_probes = pin || landed_pin_env(root)
  io.puts landed_pin_line(pin_env, pin_probes)

  # GATE TELEMETRY: the checks write their own telemetry into a scratch store,
  # never the machine's (see gate_check_telemetry_dir).
  tel_scratch = gate_check_telemetry_dir
  run_env = tel_scratch ? pin_env.merge("ATHENA_TELEMETRY_DIR" => File.join(tel_scratch, "store")) : pin_env
  run_id = SecureRandom.hex(6)
  started_at = Time.now
  started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  results = {}
  running = RunningChecks.new
  run_serial = lambda do |list|
    list.each do |(label, argv, opt)|
      at = Time.now
      t0 = Process.clock_gettime(Process::CLOCK_MONOTONIC)
      ok, out, cpu = run_one(argv, chdir: chdir, env: check_env(run_env, opt), label: label, running: running)
      results[label] = [argv, ok, out, Process.clock_gettime(Process::CLOCK_MONOTONIC) - t0, cpu, at]
    end
  end
  pre, units, final = gate_units(checks)
  begin
    run_serial.call(pre)
    run_pool(units, jobs: jobs, durations: last_durations(timings), chdir: chdir, env: run_env,
                    running: running) do |label, argv, ok, out, wall, cpu, at|
      results[label] = [argv, ok, out, wall, cpu, at]
    end
    run_serial.call(final)
  rescue SignalException => e
    # results.dup is taken without the pool's lock. A worker may add one
    # more result just after; the report is then one count behind, which is
    # why it says "not started or not yet recorded" and never "never ran".
    # The signal is re-raised whatever the report does: a report that fails
    # must never turn "died by SIGTERM" into exit 1.
    finished = results.dup
    elapsed = Process.clock_gettime(Process::CLOCK_MONOTONIC) - started
    begin
      report_interrupted("SIG#{Signal.signame(e.signo) || e.signo}", running,
                         finished, checks.size, elapsed, err)
    rescue StandardError
      nil
    end
    emit_gate_telemetry(run_id: run_id, started_at: started_at, elapsed: elapsed, jobs: jobs, total: checks.size,
                        results: finished, failed: finished.count { |_, r| !r[1] }, chdir: chdir, interrupted: true)
    raise e
  end
  elapsed = Process.clock_gettime(Process::CLOCK_MONOTONIC) - started

  failures = []
  checks.each do |(label, argv)|
    _argv, ok, out, wall, cpu = results.fetch(label) do
      [argv, false, "harness-gate: check never ran (scheduler fault)", 0.0, nil]
    end
    io.printf("%-28s %s %7.1fs wall %s cpu\n", label, ok ? "PASS" : "FAIL", wall,
              cpu ? format("%6.1fs", cpu) : "    n/a")
    failures << [label, argv, out] unless ok
  end

  serial = results.values.sum { |r| r[3] }
  cpus = results.values.map { |r| r[4] }
  cpu_total = cpus.compact.empty? ? "n/a" : "#{cpus.compact.sum.round(1)}s"
  cpu_note = cpus.include?(nil) ? " (#{cpus.count(nil)} not measured)" : ""
  slowest = results.sort_by { |_, r| -r[3] }.first(3).map { |l, r| "#{l} #{r[3].round}s" }.join(", ")
  io.puts "harness-gate: #{checks.size} checks in #{elapsed.round(1)}s wall on #{jobs} worker(s) " \
          "(serial sum #{serial.round(1)}s, cpu #{cpu_total}#{cpu_note}); " \
          "slowest: #{slowest}; timings: #{timings}"
  head = `git -C #{chdir.shellescape} rev-parse HEAD 2>/dev/null`.strip
  at = Time.now.utc.strftime("%Y-%m-%dT%H:%M:%SZ")
  record_timings(timings, results.map do |label, (_a, ok, _o, wall, cpu)|
    { "at" => at, "tree" => chdir, "head" => head, "label" => label, "wall_s" => wall.round(2),
      "cpu_s" => cpu&.round(3), "ok" => ok, "jobs" => jobs }
  end)
  emit_gate_telemetry(run_id: run_id, started_at: started_at, elapsed: elapsed, jobs: jobs, total: checks.size,
                      results: results, failed: failures.size, chdir: chdir, interrupted: false)
  [pin_env, failures]
ensure
  FileUtils.rm_rf(tel_scratch) if tel_scratch
end

# ---------------------------------------------------------------------------
# GATE TELEMETRY (DND-1474)
#
# Each run writes, through the one telemetry writer (ai/lib/athena_telemetry.rb,
# contract ai/contracts/athena-telemetry.md), one `harness_gate.check` per
# finished check (at = its start, duration_s = its wall_s) and then one
# `harness_gate.run` (at = the run start, duration_s = the run wall, head = the
# gated HEAD, unit = the gated tree's branch). Both share a random run_id. They
# are written after the checks finish, so telemetry is never on a check's
# critical path, and on the interrupted path too (interrupted: true, the
# checks that finished). timings.jsonl is unchanged: it is the scheduler's
# input, this is the lead-time ledger's.
#
# Fails open: the writer never raises, and anything else that goes wrong here
# is swallowed, so the gate's verdict, exit code and stdout never change.
#
# The CHECKS write into a per-run scratch store (ATHENA_TELEMETRY_DIR, removed
# after the run), not the machine's: a check is a test, and the events its
# fixtures emit (a fixture harness-gate run, a test-slot wait in a throwaway
# pool, a stub critic round) are not lead-time evidence. Only the gate's own
# events reach the real store. One exception: if the scratch directory cannot
# be created, the checks run with the environment the gate was given, so their
# events land wherever that points (the machine's store, by default). The
# three emitters' own suites also point their fixtures at a temp store, so
# this matters only for a suite that does not.
def gate_check_telemetry_dir
  Dir.mktmpdir("harness-gate-telemetry-")
rescue SystemCallError
  nil
end

def emit_gate_telemetry(run_id:, started_at:, elapsed:, jobs:, total:, results:, failed:, chdir:, interrupted:)
  return unless defined?(AthenaTelemetry)

  results.each do |label, (_argv, ok, _out, wall, cpu, at)|
    attrs = { "run_id" => run_id, "label" => label.to_s[0, 120], "ok" => ok ? true : false }
    attrs["cpu_s"] = cpu.to_f if cpu
    AthenaTelemetry.emit("harness_gate.check", at: at, duration_s: wall, attrs: attrs, repo_dir: chdir)
  end
  AthenaTelemetry.emit("harness_gate.run", at: started_at, duration_s: elapsed, repo_dir: chdir,
                                           attrs: { "run_id" => run_id, "jobs" => jobs, "checks" => total,
                                                    "failed" => failed, "ok" => !interrupted && failed.zero?,
                                                    "interrupted" => interrupted })
  nil
rescue StandardError
  nil
end

# STASH FIXTURE OPT-OUT (DND-775). Agent sessions carry the agent-stash
# reference-transaction hook (GIT_CONFIG_COUNT/KEY_n/VALUE_n + GIT_TRACE2) and
# the PATH git wrapper (ATHENA_AGENT_BIN, prepended by the CLAUDE_ENV_FILE
# script ai/agent-env/session-env.sh, DND-1080). Both
# refuse every stash-list write. The legacy git-stash-guard suite seeds its
# fixture repos (under mktemp -d, never a real repo) with real stash entries,
# so in an activated session it would be refused before it tests anything.
# This environment drops both layers for that one suite: GIT_CONFIG_COUNT and
# GIT_TRACE2 unset (the GIT_CONFIG_KEY_n/VALUE_n left behind are inert without
# a count), and every PATH entry whose `git` is the wrapper removed. It is the
# opt-out the gh-athena and glab-athena suites take in their own sandboxes
# (DND-775 condition b). It adds no way to write a real stash list: an agent
# can already unset its own environment (the documented residual).
AGENT_GIT_WRAPPER_MARK = "git (agent wrapper)"

def stash_fixture_optout_env(path = ENV.fetch("PATH", ""), agent_bin = ENV["ATHENA_AGENT_BIN"])
  keep = path.split(":").reject do |d|
    next true if agent_bin && !agent_bin.empty? && File.expand_path(d) == File.expand_path(agent_bin)

    g = File.join(d, "git")
    File.file?(g) && File.read(g, 4096).to_s.include?(AGENT_GIT_WRAPPER_MARK)
  rescue SystemCallError
    false
  end
  { "GIT_CONFIG_COUNT" => nil, "GIT_TRACE2" => nil, "ATHENA_AGENT_BIN" => nil,
    "ATHENA_AGENT_GIT_SEEN" => nil, "PATH" => keep.join(":") }
end

def missing_executables
  CHECKS.reject { |(_, argv)| File.executable?(File.join(CUSTOM_DIR, argv.first)) }
end

# The false-green trap: a hook's own .sh invoked with --self-test.
def false_green_entries
  CHECKS.select do |(_, argv)|
    argv.first.start_with?("ai/hooks/") &&
      !argv.first.end_with?(".self-test.sh")
  end
end

# root/dry_run exist for --self-test: a fixture root can drive this exact
# decision logic (not just the discover_self_tests/self_tests_found? predicates
# case 5/6b already cover) without the run actually mutating anything, and
# dry_run stops before executing the real CHECKS list so testing the
# zero-discovery/stray-suite branches against a fixture never spends the time
# (or risk) of re-running the whole real gate as a side effect.
def run_gate(root: CUSTOM_DIR, dry_run: false, jobs: nil)
  # `root` only ever governs the discovery reporting below (found/self_tests_
  # found?/stray_test_scripts) — missing_executables and the CHECKS execution
  # loop past `return 0 if dry_run` always use the real CUSTOM_DIR/CHECKS,
  # never `root`. A non-default root with dry_run: false would therefore
  # report on one tree and execute another with no failure — make that
  # misuse impossible to construct rather than merely undocumented.
  raise ArgumentError, "run_gate: root: only supported together with dry_run: true" \
    if root != CUSTOM_DIR && !dry_run

  # RECURSION GUARD. ai/bin/check-bin-help probes every bin with `--help`, and
  # harness-gate is the one bin whose pre-fix fall-through would have re-entered
  # the very gate doing the probing. The probe sets this variable, so a gate run
  # started from inside it is refused structurally rather than merely bounded by
  # the probe's timeout. One other setter: --self-test case 14b sets it on the
  # bad --jobs / HARNESS_GATE_JOBS runs it drives, so a value that wrongly got
  # past validation is refused here instead of starting a real gate run.
  if ENV["HARNESS_BIN_HELP_PROBE"]
    warn "harness-gate: REFUSED — started from inside a check-bin-help --help probe."
    warn "  Fix: this means `harness-gate --help` fell through to running the gate instead of printing usage and exiting 0. Restore the --help branch at the bottom of ai/bin/harness-gate; do not unset HARNESS_BIN_HELP_PROBE to get past this."
    return 1
  end

  # Attribution, unconditionally. A PASS that does not name its tree cannot be
  # audited after the fact — see "WHICH TREE AM I GATING?" above.
  puts "harness-gate: gating #{root}"

  # The tree's identity, read BEFORE anything below measures it (DND-896).
  # The report re-reads it and refuses to name a tree the checks did not see;
  # see "ATTRIBUTION FOR THE OK/FAILED SUMMARY LINES" above. A dry run never
  # reports a result, so it takes none.
  unless dry_run
    pre = gate_start_snapshot(root)
    return 1 unless pre
  end

  found = discover_self_tests(root)
  puts "self-tests discovered: #{found.size}"

  # A DROP TO ZERO is exactly the failure mode this ticket exists to close —
  # this repo has committed self-test.sh suites in every checkout (they are
  # source, not environment-dependent config), so finding none means the glob
  # or root resolution broke, not that there is legitimately nothing to run.
  # Fail loud instead of a silently-shorter PASS.
  unless self_tests_found?(root)
    warn "harness-gate: FAILED — discovered ZERO **/self-test.sh, but this " \
         "repo has committed suites."
    warn "  Fix: this means discover_self_tests (ai/bin/harness-gate) or " \
         "CUSTOM_DIR resolution is broken, or every suite was moved/renamed " \
         "without updating the glob — a real gap, not something to " \
         "suppress. Restore the suites or the glob before committing."
    return 1
  end

  strays = stray_test_scripts(root)
  unless strays.empty?
    warn "harness-gate: NOTE — .sh file(s) under a test/ directory not named " \
         "self-test.sh, so NOT discovered/run: #{strays.join(', ')}"
    warn "  Fix: if any of these is meant to be a self-test entry point, " \
         "rename it to self-test.sh (the only name harness-gate discovers), " \
         "and make sure it is executable; if it's a helper another " \
         "self-test.sh sources/execs, no action needed."
  end

  return 0 if dry_run

  # WRONG-TREE REFUSAL. Only reached on a real run (a fixture dry_run never
  # gets here), and only fires for same-repo-different-worktree — see
  # "WHICH TREE AM I GATING?" above for what is deliberately allowed.
  if (mismatch = foreign_gate_tree)
    cwd_root, gate_root = mismatch
    warn "harness-gate: REFUSED — you are in #{cwd_root} but this binary gates #{gate_root}."
    warn "  Fix: run the gate belonging to the tree you are about to commit in — " \
         "`cd #{cwd_root} && ./ai/bin/harness-gate`. Every check resolves its " \
         "inputs beside THIS script (check-inbox-registry reads the " \
         "registry.json next to it, discovery globs that tree), so the result " \
         "you just asked for would describe #{gate_root}, not your work. Do " \
         "not work around this by copying the result across — gate the tree " \
         "you are committing."
    return 1
  end

  # ORIGIN FRESHNESS (DND-945). Before any check runs — see "ORIGIN FRESHNESS,
  # CHECKED BEFORE ANY CHECK RUNS" above. Reads the pin ONCE here; the same
  # pin is handed to run_checks below so it is never re-read.
  #
  # Ordered AFTER the tree snapshot (`pre`, DND-896) on purpose. The snapshot
  # must come before the first read of the tree (discovery), or the report
  # could name a tree the early steps never saw. This preflight reads only
  # refs/remotes/origin/main and origin itself, never HEAD or the working
  # tree, and the `git fetch` its Fix: asks for leaves the snapshot's
  # fingerprint unchanged. So it can sit here, after the cheap local
  # refusals and before the checks, without widening what `pre` covers. A
  # tree that cannot be identified also fails at the snapshot, before this
  # makes a network call.
  pin_env, pin_probes = landed_pin_env(root)
  return ORIGIN_STALE_EXIT unless report_origin_freshness(origin_freshness(root, pin_env, pin_probes))

  # INLINE --self-test COVERAGE (DND-507): the check LIST itself must include
  # every inline suite a first-party tool defines. A gap here means the run
  # below would report PASS over a suite it never ran, so it fails first, like
  # the zero-discovery guard above.
  return 1 unless run_inline_self_test_coverage(CUSTOM_DIR).zero?

  missing = missing_executables
  unless missing.empty?
    warn "harness-gate: FAILED — declared check(s) missing or not executable:"
    missing.each { |(label, argv)| warn "  - #{label} (#{argv.first})" }
    warn "  Fix: restore the script and `chmod +x` it. For a STATIC_CHECKS " \
         "entry you can also remove it from CHECKS in ai/bin/harness-gate (and " \
         "from the gate list in ai/agents/athena-shipwright.md.in) instead, if " \
         "the check no longer applies. A discovered **/self-test.sh " \
         "entry is NOT removable from CHECKS by hand (it is derived from " \
         "disk) — `chmod +x` it. Do NOT delete it to make this pass: with " \
         "only a handful of self-test suites on disk today, deleting one " \
         "just risks trading this failure for the zero-discovery failure above."
    return 1
  end

  # The dispatch validated --jobs / HARNESS_GATE_JOBS before anything ran and
  # passes the count; a caller that passes none gets the same validation here.
  jobs ||= resolve_gate_jobs(nil)
  return 2 unless jobs

  unless (errs = schedule_errors(CHECKS)).empty?
    warn "harness-gate: FAILED — the check schedule is unsound: #{errs.join('; ')}."
    warn "  Fix: give every check in CHECKS a unique label, and keep PRE_POOL_LABELS, " \
         "CHAINS and FINAL_CHECKS naming labels that exist in CHECKS (update them in " \
         "the same change that renames a check)."
    return 1
  end
  run_attributed_checks(CHECKS, pre, jobs: jobs, pin: [pin_env, pin_probes])
end

# Runs `checks` through the gate's own loop and reports the result against
# `pre`, the snapshot run_gate took before anything measured the tree.
# Everything run_gate does from run_checks to its return, extracted so
# --self-test case 7f can drive it against a fixture repo with stub checks.
# run_opts go to run_checks unchanged: run_gate passes jobs: and pin: (its
# origin-freshness read, DND-945, so origin is read once per run).
def run_attributed_checks(checks, pre, root: CUSTOM_DIR, chdir: CUSTOM_DIR, **run_opts)
  pin_env, failures = run_checks(checks, root: root, chdir: chdir, **run_opts)

  moved = landed_moved_note(root, pin_env)
  puts moved if moved

  report_check_results(failures, checks.size, pre: pre, root: root)
end

# The tail of a real (non-dry-run) run_gate invocation: report OK/FAILED for
# whatever checks just ran, plus the full per-check failure detail. `pre` is
# the snapshot taken before the checks ran; the tree is re-read here and the
# result is attributed only if it is still that tree (verified_attribution).
# Otherwise it FAILS with a Fix: -- a passing run is never reported OK for a
# tree it may not have measured, and a failing run still prints every
# per-check detail below, since that output is real whichever tree it
# describes. Exit 0 only for an attributed pass.
def report_check_results(failures, total, pre:, root: CUSTOM_DIR)
  attribution, problem = verified_attribution(pre, root)

  if failures.empty?
    if attribution
      puts gate_ok_message(total, total, attribution)
      return 0
    end
    warn ""
    warn "harness-gate: FAILED — #{total}/#{total} checks passed, but #{problem[0]}."
    warn "#{problem[1]} Every check already ran and passed; this failure is about " \
         "which tree they passed for."
    return 1
  end

  warn ""
  if attribution
    warn gate_failed_header(failures.size, total, attribution)
  else
    warn "harness-gate: FAILED — #{failures.size} of #{total} check(s) did not pass, " \
         "and #{problem[0]}:"
    warn "#{problem[1]} The per-check failures below are still real output and follow."
  end
  failures.each do |(label, argv, out)|
    warn ""
    warn "--- #{label} (#{argv.join(' ')}) ---"
    tail = out.to_s.lines.last(FAIL_TAIL_LINES)
    hits = failure_lines(out) - tail
    unless hits.empty?
      warn "  failure lines (from the full output, not just the tail):"
      hits.first(FAIL_GREP_LINES).each { |l| warn "    #{l.chomp}" }
      if hits.size > FAIL_GREP_LINES
        warn "    ... #{hits.size - FAIL_GREP_LINES} more failure line(s) elided; " \
             "re-run the check directly for all of them"
      end
      warn "  last #{tail.size} line(s):"
    end
    tail.each { |l| warn "  #{l.chomp}" }
  end
  warn ""
  warn "  Fix: repair each failing check above, or revert the harness edit that " \
       "broke it (`git restore <files>`), then re-run ai/bin/harness-gate. Do " \
       "NOT commit while this is red — a red gate means the harness fails its " \
       "own checks. If you edited a template or block, run `ai/bin/build-agents` " \
       "first so the rendered .md files are regenerated."
  1
end

def run_list
  puts "harness-gate: listing for #{CUSTOM_DIR}"
  CHECKS.each { |(label, argv)| printf("%-28s %s\n", label, argv.join(" ")) }
  found = discover_self_tests
  puts "harness-gate: #{CHECKS.size} declared check(s) " \
       "(#{found.size} of them discovered under **/self-test.sh)"
  0
end

# Every ai/hooks/*.self-test.sh on disk, relative to root. FNM_DOTMATCH
# (DND-422): a dot-prefixed hook suite must not escape the declared-check audit.
def hook_self_tests_on_disk(root = CUSTOM_DIR)
  Dir.glob(File.join(root, "ai/hooks/*.self-test.sh"), File::FNM_DOTMATCH)
     .map { |p| p.sub("#{root}/", "") }.sort
end

require "rbconfig"
require_relative "../lib/strict_argv"

# Every argument must be a declared flag (DND-526). A typo of --list or
# --self-test used to fall through to the full gate run.
CLI_SPEC = { "--self-test" => :switch, "--list" => :switch, "--jobs" => :value, "--group" => :value }.freeze

# -> [opts, nil] on success, [nil, reason] on a usage error. --jobs's value
# is checked by gate_jobs (the same rule as HARNESS_GATE_JOBS), not here.
def parse_cli(argv)
  opts = StrictArgv.parse(argv, CLI_SPEC)
  return [nil, "--self-test and --list are separate modes; pass one"] if opts["--self-test"] && opts["--list"]
  return [nil, "--jobs applies only to a gate run, not to --self-test or --list"] if opts["--jobs"] &&
                                                                                    (opts["--self-test"] || opts["--list"])
  if opts.key?("--group")
    return [nil, "--group applies only to --self-test"] unless opts["--self-test"]
    unless HARNESS_GATE_SELF_TEST_GROUPS.include?(opts["--group"])
      return [nil, "--group #{opts['--group'].inspect} is not a self-test group " \
                   "(one of: #{HARNESS_GATE_SELF_TEST_GROUPS.join(', ')})"]
    end
  end

  [opts, nil]
rescue StrictArgv::UsageError => e
  [nil, e.message]
end

def gate_mode(opts)
  return :self_test if opts["--self-test"]
  return :list if opts["--list"]

  :gate
end

# --self-test case 14b (DND-1005): `--jobs N` and HARNESS_GATE_JOBS share one
# rule, the flag wins, and a bad value from either is exit 2 with a Fix:
# before any check runs. Returns true when every assertion holds.
def self_test_jobs_flag
  good = true
  fail_with = lambda do |msg|
    warn "self-test: FAIL — case 14b (--jobs): #{msg}. Fix: keep gate_jobs/resolve_gate_jobs " \
         "validating --jobs like HARNESS_GATE_JOBS, --jobs winning, and the dispatch exiting 2 before run_gate."
    good = false
  end
  {
    [{ "HARNESS_GATE_JOBS" => "3" }, "5"] => 5,
    [{}, "2"] => 2,
    [{ "HARNESS_GATE_JOBS" => "x" }, "4"] => 4,
    [{ "HARNESS_GATE_JOBS" => "3" }, nil] => 3,
  }.each do |(env, flag), want|
    got = gate_jobs(env, cores: 16, flag: flag)
    fail_with.call("gate_jobs(#{env.inspect}, flag: #{flag.inspect}) = #{got}, want #{want}") unless got == want
  end
  %w[0 x 2.5 07].each do |bad|
    gate_jobs({ "HARNESS_GATE_JOBS" => "3" }, cores: 16, flag: bad)
    fail_with.call("--jobs #{bad} was accepted")
  rescue ArgumentError => e
    fail_with.call("--jobs #{bad} was refused without naming --jobs (#{e.message})") unless e.message.include?("--jobs")
  end
  %w[07].each do |bad|
    gate_jobs({ "HARNESS_GATE_JOBS" => bad }, cores: 16)
    fail_with.call("HARNESS_GATE_JOBS=#{bad} was accepted")
  rescue ArgumentError
    nil
  end

  cli, reason = parse_cli(%w[--jobs 3])
  fail_with.call("parse_cli(--jobs 3) refused it (#{reason})") unless cli && cli["--jobs"] == "3" && gate_mode(cli) == :gate
  [%w[--jobs], %w[--jobs 3 --self-test], %w[--list --jobs 3], %w[--jobs 3 --jobs 4]].each do |argv|
    _c, why = parse_cli(argv)
    fail_with.call("parse_cli(#{argv.inspect}) was accepted") if why.nil?
  end

  # End to end, through the real dispatch. HARNESS_BIN_HELP_PROBE makes a
  # run that got past validation refuse at once (exit 1) instead of gating,
  # so a regression here can never start a real gate run.
  gate = File.join(CUSTOM_DIR, "ai/bin/harness-gate")
  [
    [{ "HARNESS_GATE_JOBS" => nil }, %w[--jobs 0], "--jobs"],
    [{ "HARNESS_GATE_JOBS" => "0" }, [], "HARNESS_GATE_JOBS"],
    [{ "HARNESS_GATE_JOBS" => "4" }, %w[--jobs x], "--jobs"],
  ].each do |env, argv, names|
    out, status = Open3.capture2e(env.merge("HARNESS_BIN_HELP_PROBE" => "1"), RbConfig.ruby, gate, *argv,
                                  chdir: CUSTOM_DIR, stdin_data: "")
    next if status.exitstatus == 2 && out.include?(names) && out.include?("Fix:")

    why = out.include?("REFUSED") ? " — exit 1 with REFUSED means validation let the bad value through to run_gate" : ""
    fail_with.call("#{env.compact.map { |k, v| "#{k}=#{v} " }.join}harness-gate #{argv.join(' ')} exited " \
                   "#{status.exitstatus}, want 2 naming #{names} with a Fix:#{why} (#{out.inspect})")
  end
  good
end

# Case 15c's fixture (DND-1339): runs the block on a new thread that first
# blocks every signal (pthread_sigmask through Fiddle; Ruby has no API for a
# thread's mask). Returns { out: <the block's value>, thread_blk: <that
# thread's SigBlk hex just before the block ran>, error: <why the fixture
# could not run, or nil> }. The thread's mask is put back before it ends. A
# fixture that could not block its signals reports an error, never a pass.
def spawn_from_blocked_thread
  require "fiddle"
  libc = Fiddle.dlopen(nil)
  fill = Fiddle::Function.new(libc["sigfillset"], [Fiddle::TYPE_VOIDP], Fiddle::TYPE_INT)
  sigmask = Fiddle::Function.new(libc["pthread_sigmask"],
                                 [Fiddle::TYPE_INT, Fiddle::TYPE_VOIDP, Fiddle::TYPE_VOIDP], Fiddle::TYPE_INT)
  sig_block = 0 # SIG_BLOCK on Linux
  sig_setmask = 2 # SIG_SETMASK on Linux
  Thread.new do
    Thread.current.report_on_exception = false # .value re-raises it; rescued below
    all = Fiddle::Pointer.malloc(128, Fiddle::RUBY_FREE) # sizeof(sigset_t) on glibc
    old = Fiddle::Pointer.malloc(128, Fiddle::RUBY_FREE)
    fill.call(all)
    rc = sigmask.call(sig_block, all, old)
    next({ out: nil, thread_blk: nil, error: "pthread_sigmask returned #{rc}" }) unless rc.zero?

    # The block runs with SIGVTALRM blocked too, so Ruby cannot interrupt it
    # mid-call; the probe it runs is short.
    begin
      native = File.readlink("/proc/thread-self")
      thread_blk = File.read("/proc/thread-self/status")[/^SigBlk:\s*(\h+)$/, 1]
      out = yield
      # Under M:N threads the Ruby thread could move to another native
      # thread, and then the spawn did not come from the blocked one. (The
      # mask itself cannot be re-read to tell: Ruby's vfork spawn leaves the
      # spawning thread's mask empty afterwards.)
      now = File.readlink("/proc/thread-self")
      moved = now == native ? nil : "the Ruby thread moved from native thread #{native} to #{now}"
      { out: out, thread_blk: thread_blk, error: moved }
    ensure
      sigmask.call(sig_setmask, old, nil)
    end
  end.value
rescue LoadError, StandardError => e
  { out: nil, thread_blk: nil, error: "#{e.class}: #{e.message}" }
end

# Case 15's probe: a check that prints the SigBlk and SigIgn lines of its own
# /proc status, then the numbers of its open fds. `hook` runs once per status
# line, after the line is in $l and before the probe looks at it; only case
# 15d's fixture passes one.
#
# It never forks (DND-1339): a forked reader reads the SHELL's mask at a
# racing instant instead of the one the check started with. Seen as SigBlk
# 0x10000 (bash blocks SIGCHLD while it waits) and fffffffffffbfeff (bash
# inside glibc's _Fork, which blocks every signal around clone(); bits 32
# and 33 are glibc's own signals, which no public sigprocmask call can block).
# A pipe or $(...) here would bring the fork back.
#
# It reads its status as ONE snapshot and parses it from memory (DND-1399).
# A /proc status file is rendered again on every seek, and bash's `read`
# seeks back after each line of a seekable file, to the byte after the
# newline it stopped at. So a per-line `while read ... done < status` loop
# read each line from a new rendering, at an offset taken from the old one.
# A field above SigBlk whose width changed in between shifted every later
# line: SigQ counts the pending signals of every process of this user, and
# 10 -> 9 turned the next line into "igBlk:\t...", which matched nothing.
# `read -d ''` reads to EOF in one call, sequentially, so it sees a single
# rendering. It is bash's (dash has no -d), so the probe names bash.
def status_probe(hook: ":")
  script = <<~'SH'
    IFS= read -r -d '' s < /proc/$$/status
    set -f; IFS=$'\n'
    for l in $s; do
      HOOK
      case $l in SigBlk:*|SigIgn:*) echo "$l" ;; esac
    done
    set +f; IFS=$' \t\n'
    for f in /proc/$$/fd/*; do echo "${f##*/}"; done
  SH
  ["bash", "-c", script.sub("HOOK") { hook }] # block form: a `\` in hook is literal
end

# The pending-signal count in this process's own status ("SigQ: <count>/<limit>").
# It counts the queued signals of every process of this user, so it reads the
# same from any of them. A status with no SigQ line raises: it is not a 0.
def own_sigq
  File.read("/proc/self/status")[%r{^SigQ:[ \t]*(\d+)/}, 1]&.to_i or
    raise "could not read SigQ from /proc/self/status"
end

# Case 15d's fixture (DND-1399): raises this user's SigQ by two digits while
# status_probe runs, and drops it back to its base at the moment the probe
# has taken its SigPnd line, the line just above ShdPnd and SigBlk. So the
# count loses at least one digit mid-read, deterministically: no load, no
# timing. It queues 10**(digits of the base + 1) signals, so a base that moves
# by a few while the case runs still ends shorter than it started.
#
# How: a stopped bash with a handler for SIGRTMIN holds the queued real-time
# signals (a stopped process dequeues nothing, and real-time signals queue one
# entry each). The probe's hook writes the go FIFO and waits on the done FIFO;
# this side then KILLs and reaps the holder, which frees its queue, and only
# then answers. Both FIFOs are opened read-write here first, so neither open
# blocks, and a probe that never reaches its hook cannot hang the case.
# __libc_current_sigrtmin is glibc's: elsewhere the fixture reports an error
# (15d fails as "could not measure"), which is not a regression of the probe.
#
# Returns { out: <the probe's output>, before: <SigQ before>, after: <SigQ
# after the drop>, error: <why the fixture could not arrange the drop, or nil> }.
def probe_under_sigq_drop(dir)
  require "fiddle"
  rtmin = Fiddle::Function.new(Fiddle.dlopen(nil)["__libc_current_sigrtmin"], [], Fiddle::TYPE_INT).call
  go = File.join(dir, "sigq-go.fifo")
  done = File.join(dir, "sigq-done.fifo")
  [go, done].each { |f| File.mkfifo(f) }
  go_io = File.open(go, File::RDWR)
  done_io = File.open(done, File::RDWR)
  done_io.sync = true # the answer must reach the FIFO now, not at close
  holder = Process.spawn("bash", "-c", "trap : RTMIN; kill -STOP $$; exit 0", in: File::NULL)
  _pid, st = Process.wait2(holder, Process::WUNTRACED)
  unless st.stopped?
    holder = nil
    return { out: nil, before: nil, after: nil, error: "the signal holder did not stop (#{st.inspect})" }
  end

  queued = 10**(own_sigq.to_s.length + 1)
  queued.times { Process.kill(rtmin, holder) }
  before = own_sigq
  dropper = Thread.new do
    Thread.current.report_on_exception = false # .value re-raises it; rescued below
    begin
      go_io.gets
      Process.kill("KILL", holder)
      Process.wait(holder)
      holder = nil
      own_sigq
    ensure
      # Always answer, so the probe never waits forever on the done FIFO.
      done_io.write("ok\n")
    end
  end
  hook = "case $l in SigPnd:*) echo go > #{go.shellescape}; read -r _ < #{done.shellescape} ;; esac"
  out, = Open3.capture2e(*status_probe(hook: hook), chdir: dir, stdin_data: "")
  go_io.close # a dropper still waiting for go (the probe never got there) stops here
  after = begin
    dropper.value
  rescue IOError
    nil
  end
  error = if after.nil?
            "the probe never reached its SigPnd hook"
          elsif after.to_s.length >= before.to_s.length
            "SigQ did not lose a digit (#{before} -> #{after}, #{queued} signals queued and freed)"
          end
  { out: out, before: before, after: after, error: error }
rescue LoadError, StandardError => e
  { out: nil, before: nil, after: nil, error: "#{e.class}: #{e.message}" }
ensure
  # The dropper is done (or stopped by closing go) before the holder is
  # judged, so the two never both kill and reap it.
  go_io.close if go_io && !go_io.closed?
  begin
    dropper&.join
  rescue StandardError
    nil
  end
  if holder
    begin
      Process.kill("KILL", holder)
      Process.wait(holder)
    rescue Errno::ESRCH, Errno::ECHILD
      nil
    end
  end
  [go_io, done_io].each { |io| io.close if io && !io.closed? }
end

# --self-test case 15 (DND-1005): cpu_s is the check's OWN process tree, not a
# share of the gate's. Two checks run at once. "idle" blocks on a FIFO and
# burns next to nothing. In the other worker, "ruby-self" (a normal Ruby
# process, which reports its own CPU clock) runs to completion and is reaped,
# and only then does "release" write the FIFO that lets "idle" finish. So
# "ruby-self" is reaped inside idle's window: an implementation that took a
# delta of the gate's process-wide child CPU around each check would charge
# ruby-self's CPU to idle. The assertions compare CPU with CPU, never with a
# wall-clock limit, and nothing here generates load (DND-1222).
def self_test_cpu_attribution
  good = true
  Dir.mktmpdir("harness-gate-cpu") do |dir|
    fifo = File.join(dir, "release.fifo")
    up = File.join(dir, "idle-up.fifo")
    File.mkfifo(fifo)
    File.mkfifo(up)
    self_cpu = File.join(dir, "ruby-self.cpu")
    idle = File.join(dir, "idle.sh")
    # idle announces itself on idle-up before blocking, and ruby-self waits
    # for that before it measures and exits, so ruby-self is always reaped
    # inside idle's window. `timeout` only bounds a broken fixture; it never
    # decides the verdict.
    File.write(idle, "#!/bin/sh\necho up > #{up.shellescape}\nexec timeout 120 cat #{fifo.shellescape} >/dev/null\n")
    ruby_self = File.join(dir, "ruby-self.rb")
    File.write(ruby_self, "#!#{RbConfig.ruby}\nFile.read(#{up.inspect})\n" \
                          "File.write(ARGV[0], Process.clock_gettime(Process::CLOCK_PROCESS_CPUTIME_ID).to_s)\n")
    release = File.join(dir, "release.sh")
    File.write(release, "#!/bin/sh\necho go > #{fifo.shellescape}\n")
    [idle, ruby_self, release].each { |p| FileUtils.chmod(0o755, p) }

    got = {}
    units = [[["ruby-self", [ruby_self, self_cpu]], ["release", [release]]], [["idle", [idle]]]]
    run_pool(units, jobs: 2, durations: {}, chdir: dir, env: {}) do |label, _argv, ok, out, wall, cpu|
      got[label] = { ok: ok, out: out, wall: wall, cpu: cpu }
    end
    own = File.exist?(self_cpu) ? File.read(self_cpu).to_f : nil
    idle_cpu = got.dig("idle", :cpu)
    ruby_cpu = got.dig("ruby-self", :cpu)
    checks = {
      "all three fixture checks passed (#{got.transform_values { |v| v[:ok] }.inspect})" =>
        got.size == 3 && got.values.all? { |v| v[:ok] },
      "ruby-self reported its own CPU (#{own.inspect})" => own&.positive?,
      "every check has a measured cpu_s (#{got.transform_values { |v| v[:cpu] }.inspect})" =>
        got.size == 3 && got.values.all? { |v| v[:cpu].is_a?(Float) },
      "ruby-self's cpu_s #{ruby_cpu.inspect} covers the CPU it measured itself (#{own.inspect})" =>
        ruby_cpu && own && ruby_cpu + 0.001 >= own,
      "idle's cpu_s #{idle_cpu.inspect} is below ruby-self's own CPU #{own.inspect}, though ruby-self " \
      "was reaped while idle ran (a shared process-wide delta would charge it to idle)" =>
        idle_cpu && own && idle_cpu < own,
    }
    # 15b. The shim is invisible to the check: the same signal mask and
    #     ignored set, and the same open file descriptors (fd 3 closed), as
    #     a check the gate spawns directly. And that mask is empty: Ruby's
    #     spawn gives every child an empty mask (see CPU SECONDS PER CHECK),
    #     so a check can always be interrupted.
    #
    #     The probe prints the mask the check was started with, from one
    #     snapshot of its own status (status_probe: DND-1339, DND-1399).
    probe = status_probe
    direct, = Open3.capture2e(*probe, chdir: dir, stdin_data: "")
    _ok, shimmed, = spawn_under_cpu_shim(probe, chdir: dir, env: {})
    checks["a check sees the same signal state and fds under the shim as spawned directly " \
           "(direct #{direct.inspect}, shim #{shimmed.inspect})"] = !direct.empty? && direct == shimmed
    # 15c. The check's mask does not depend on the mask of the gate thread
    #     that spawns it (DND-1339): a pool thread with every signal blocked
    #     still starts a check with none blocked.
    from_blocked = spawn_from_blocked_thread { spawn_under_cpu_shim(probe, chdir: dir, env: {})[1] }
    { "directly" => direct, "under the shim" => shimmed,
      "under the shim from a thread with every signal blocked " \
      "(that thread's SigBlk #{from_blocked[:thread_blk].inspect})" => from_blocked[:out] }.each do |how, seen|
      blk = seen.to_s[/^SigBlk:[ \t]*(\h+)$/, 1]
      checks["a check spawned #{how} starts with no signal blocked (SigBlk #{blk.inspect})"] =
        !blk.nil? && blk.to_i(16).zero?
    end
    # The fixture must really have blocked SIGINT, SIGTERM and SIGCHLD (bit
    # n-1 is signal n), or 15c tested nothing; that failure has its own Fix.
    want_bits = (1 << 1) | (1 << 14) | (1 << 16)
    unless from_blocked[:error].nil? && (from_blocked[:thread_blk].to_s.to_i(16) & want_bits) == want_bits
      warn "self-test: FAIL — case 15c fixture: the spawning thread did not have SIGINT, SIGTERM and " \
           "SIGCHLD blocked (SigBlk #{from_blocked[:thread_blk].inspect}; #{from_blocked[:error] || 'no error'}). " \
           "Fix: repair spawn_from_blocked_thread (Fiddle must load, and pthread_sigmask must block every " \
           "signal on the thread that runs the spawn); never delete or skip case 15c."
      good = false
    end
    # 15d. The probe reads every line of its status whole, even when a field
    #     above SigBlk changes width while it reads (DND-1399): this user's
    #     SigQ loses at least one digit just after the probe's SigPnd line. A per-line `read` loop reads SigBlk as "igBlk:..." then.
    dropped = probe_under_sigq_drop(dir)
    if dropped[:error]
      warn "self-test: FAIL — case 15d fixture: could not drop SigQ by a digit mid-read " \
           "(#{dropped[:error]}). Fix: repair probe_under_sigq_drop (a stopped bash holding " \
           "queued SIGRTMIN, reaped when the probe's hook writes the go FIFO); never delete or skip case 15d."
      good = false
    else
      %w[SigBlk SigIgn].each do |field|
        checks["the probe read its #{field} line whole while SigQ went #{dropped[:before]} -> " \
               "#{dropped[:after]} mid-read (#{dropped[:out].inspect})"] =
          dropped[:out].match?(/^#{field}:[ \t]*\h+$/)
      end
    end
    checks.each do |what, ok|
      next if ok

      warn "self-test: FAIL — case 15 (cpu attribution): #{what}. Fix: measure each check's CPU " \
           "as the child rusage of its own CPU_SHIM (spawn_under_cpu_shim), never as a delta of the " \
           "gate's Process.times, which the pool's threads share; and keep the shim invisible to the " \
           "check (fd 3 close-on-exec, no signal handling of its own, an empty signal mask whichever " \
           "thread spawns it); the 15b probe must read its own status without forking, as one " \
           "snapshot (status_probe)."
      good = false
    end
  end
  good
end

# --self-test case 16 (DND-1005): a hanging check is reported BY NAME. A gate
# (run_checks, in a forked child, as the real gate runs it) has three checks
# on two workers: "quick-one" first (the recorded durations put it first),
# then "hang-one" and "hang-two", which each announce themselves on a FIFO
# and then block forever. The parent waits for both announcements (a barrier,
# never a sleep), which also proves quick-one has finished: hang-two could
# only start on quick-one's worker after it. Then SIGTERM, as test-slot's
# `timeout` sends. The gate must name exactly the two hanging checks, kill
# their processes, and re-raise SIGTERM (the fork maps that to exit 143). The 60 s waits only bound a broken
# gate; they never decide a verdict.
def self_test_hang_named
  good = true
  fail_with = lambda do |msg|
    warn "self-test: FAIL — case 16 (hang named): #{msg}. Fix: keep run_checks rescuing a signal, " \
         "naming every check RunningChecks still holds, killing their trees, and re-raising."
    good = false
  end
  Dir.mktmpdir("harness-gate-hang") do |dir|
    started = File.join(dir, "started.fifo")
    never = File.join(dir, "never.fifo")
    File.mkfifo(started)
    File.mkfifo(never)
    mk = lambda do |name, body|
      path = File.join(dir, "#{name}.sh")
      File.write(path, "#!/bin/sh\n#{body}\n")
      FileUtils.chmod(0o755, path)
      [path]
    end
    hang = lambda do |name|
      # `cat` opening a FIFO nobody ever writes blocks in open(2), at no CPU.
      mk.call(name, "echo $$ > #{dir.shellescape}/#{name}.pid\necho #{name} > #{started.shellescape}\n" \
                    "exec cat #{never.shellescape} >/dev/null")
    end
    fixture = [["quick-one", mk.call("quick-one", "exit 0")], ["hang-one", hang.call("hang-one")],
               ["hang-two", hang.call("hang-two")]]
    timings = File.join(dir, "timings.jsonl")
    File.write(timings, [["quick-one", 100], ["hang-one", 50], ["hang-two", 10]].map do |(l, s)|
      JSON.generate("label" => l, "wall_s" => s)
    end.join("\n") + "\n")
    out_path = File.join(dir, "gate.out")
    # O_RDWR: opening never blocks, and a reader that is also a writer never
    # sees EOF, so each announcement is one line to wait for.
    reader = File.open(started, File::RDWR)
    tel_store = File.join(dir, "telemetry")
    pid = fork do
      ENV["ATHENA_TELEMETRY_DIR"] = tel_store
      $stdout.reopen(out_path, "w")
      $stderr.reopen($stdout)
      $stdout.sync = true
      $stderr.sync = true
      code = begin
        run_checks(fixture, root: dir, chdir: dir, io: $stdout, err: $stderr, jobs: 2, timings: timings)
        0
      rescue SignalException => e
        128 + e.signo
      rescue Exception # any other way out is a failure code, never a pass
        1
      end
      $stdout.flush
      $stderr.flush
      exit!(code)
    end
    waiter = Process.detach(pid)
    begin
      seen = +""
      deadline = ReapTags.monotonic + 60
      while seen.lines.size < 2 && (left = deadline - ReapTags.monotonic).positive?
        next unless reader.wait_readable(left)

        chunk = reader.read_nonblock(4096, exception: false)
        seen << chunk if chunk.is_a?(String)
      end
      names = seen.lines.map(&:strip).sort
      fail_with.call("both hanging checks never announced themselves (#{names.inspect})") unless names == %w[hang-one hang-two]
      Process.kill("TERM", pid)
      status = waiter.join(60)&.value
      fail_with.call("the gate did not exit within 60 s of SIGTERM") if status.nil?
      out = File.exist?(out_path) ? File.read(out_path) : ""
      running = out.lines.grep(/\A  - /).map { |l| l[/\A  - (\S+)/, 1] }.sort
      fail_with.call("run_checks did not re-raise SIGTERM (status #{status.inspect}; the fork maps it to 143)") unless
        status&.exitstatus == 128 + 15
      fail_with.call("no INTERRUPTED line naming SIGTERM (#{out.inspect})") unless out.include?("INTERRUPTED by SIGTERM")
      fail_with.call("the still-running list is #{running.inspect}, want exactly [hang-one, hang-two]") unless
        running == %w[hang-one hang-two]
      fail_with.call("the report carries no Fix: (#{out.inspect})") unless out.include?("Fix:")
      # DND-1474: the interrupted run still writes its telemetry: one run
      # event with interrupted: true, and the check that finished.
      if defined?(AthenaTelemetry)
        evs = AthenaTelemetry.read(env: { "ATHENA_TELEMETRY_DIR" => tel_store }).events
        run = evs.find { |e| e["event"] == "harness_gate.run" }
        a = run ? run["attrs"] : {}
        fail_with.call("the interrupted run wrote no harness_gate.run with interrupted: true, ok: false, " \
                       "checks: 3 (#{evs.inspect})") unless a["interrupted"] == true && a["ok"] == false && a["checks"] == 3
        done = evs.select { |e| e["event"] == "harness_gate.check" }
        fail_with.call("the interrupted run's check events are #{done.map { |e| e.dig('attrs', 'label') }.inspect}, " \
                       "want [quick-one] under the run's run_id") unless
          done.map { |e| e.dig("attrs", "label") } == ["quick-one"] && done.first&.dig("attrs", "run_id") == a["run_id"]
      else
        fail_with.call("ai/lib/athena_telemetry.rb did not load, so the interrupted run's telemetry cannot be read")
      end
      %w[hang-one hang-two].each do |n|
        hp = File.read(File.join(dir, "#{n}.pid")).to_i rescue 0
        # Only the fixture's own `cat` counts, never a recycled pid.
        mine = hp.positive? && (File.binread("/proc/#{hp}/cmdline").include?(never) rescue false)
        state = mine ? (File.read("/proc/#{hp}/stat")[/\) (\S)/, 1] rescue nil) : nil
        fail_with.call("#{n}'s process #{hp} is still running (state #{state})") if hp.positive? && state && state != "Z"
      end
    ensure
      if waiter.alive?
        Process.kill("KILL", pid) rescue nil
        waiter.join(10)
      end
      # Only a process still running the fixture's `cat` (never a recycled pid).
      %w[hang-one hang-two].each do |n|
        hp = File.read(File.join(dir, "#{n}.pid")).to_i rescue 0
        mine = hp.positive? && (File.binread("/proc/#{hp}/cmdline").include?(never) rescue false)
        Process.kill("KILL", hp) if mine
      rescue Errno::ESRCH
        nil
      end
      reader.close
    end
  end
  good
end

# --self-test group delegate-<installer> (DND-1007): case 4b for ONE
# SELF_TEST_DELEGATES entry. The assertion is unchanged; the installer's run
# and the delegated suite's run now go at once instead of one after the
# other, and each entry is its own gate check.
#
# Case 4b's duplicated work (each delegated suite also runs as its own
# discovered check) is an OWNER decision raised by DND-1007, not taken here:
# a check that looks redundant is escalated to Cody (owner approval policy
# item 5). Nothing is dropped, skipped or deduplicated.
#
# 4b. A SELF_TEST_DELEGATES value must be the suite the installer ACTUALLY
#     execs, not merely some other path that happens to be covered — case 4
#     only checks "the named path is covered by something", so a delegate
#     entry pointing at a real-but-wrong suite would read as "installer
#     covered" while the installer's own suite silently goes unrun. That is
#     this ticket's exact class, one level up in its own bookkeeping.
#
#     A textual "does the installer's source mention this path?" check was
#     tried first and rejected: both real installers build their suite path
#     via variable interpolation / File.join (`"${SCRIPT_DIR}/test/…"`,
#     `File.join(repo_dir, "ai", "inbox", …)`), so the literal delegate
#     string never appears on the line that actually execs it — a substring
#     search only passed today because a Fix:/error message elsewhere
#     happens to spell the same path, which proves nothing about what the
#     installer runs. Verify BEHAVIOR instead: run `<installer> --self-test`
#     and the delegated suite directly, then assert the installer's captured
#     output contains the delegate's OWN verdict line (`VERDICT: PASS (N
#     cases…)`, unique per suite by case count/wording) — not just "both
#     happened to pass", which two unrelated always-green suites would also
#     satisfy, but "the installer's run really is this suite's run" (both
#     installers either `exec` the suite directly or `bash` it without
#     redirecting output, so its own verdict line passes straight through).
def self_test_delegate(script, delegate)
  ok = true
  script_path = File.join(CUSTOM_DIR, script)
  unless File.file?(script_path) && File.executable?(script_path)
    # A group that checked nothing must not read as a pass (core's case 4
    # flags the same gap; this group says so for itself).
    warn "self-test: FAIL — SELF_TEST_DELEGATES names #{script.inspect}, which is not an " \
         "executable file, so its delegation cannot be verified. Fix: restore the installer " \
         "or remove its SELF_TEST_DELEGATES entry."
    return false
  end

  runs = [[script, "--self-test"], [delegate]].map { |argv| Thread.new { run_one(argv) } }
  (installer_ok, installer_out), (delegate_ok, delegate_out) = runs.map(&:value)
  verdict = delegate_out.to_s.lines.find { |l| l =~ /^\s*VERDICT:/i }
  unless installer_ok && delegate_ok && verdict && installer_out.include?(verdict.strip)
    warn "self-test: FAIL — SELF_TEST_DELEGATES[#{script.inspect}] = " \
         "#{delegate.inspect}, but `#{script} --self-test`'s output does " \
         "not contain that suite's own verdict line (#{verdict.inspect}) — " \
         "the delegation is unverified, so the installer's real self-test " \
         "suite could be going unrun. (installer_ok=#{installer_ok}, " \
         "delegate_ok=#{delegate_ok}, installer output tail: " \
         "#{installer_out.to_s.lines.last(5).join.inspect})"
    ok = false
  end
  ok
end

# --self-test group reap (DND-1007 split): case 13 (DND-818), the per-check
# leak reap. Unchanged; it is its own group because it is the next-largest
# cost after case 4b (about 15 s alone, measured 2026-09-30).
def self_test_reap
  ok = true

  # 13 (DND-818). A check that leaves a process running FAILS, in the run that
  #    leaked it, naming the process -- and the process is gone afterwards.
  #    Before this, a leak was only ever caught by check-inbox-mock-orphans,
  #    by name (blind to anything not called mock-athena-inbox-client.rb) and
  #    after a 60s margin, so a leak in one gate run turned the NEXT gate run
  #    on the machine red. The leak is a grandchild whose parent exits first,
  #    so it is reparented: only the tag can still tie it to its check.
  Dir.mktmpdir("harness-gate-selftest-reap") do |dir|
    expect = lambda do |cond, msg|
      unless cond
        warn "self-test: FAIL — per-check reap (DND-818): #{msg}"
        ok = false
      end
    end
    pidfile = File.join(dir, "leak.pid")
    leaky = File.join(dir, "leaky.sh")
    File.write(leaky, "#!/bin/sh\nsh -c 'sleep 307 >/dev/null 2>&1 & echo $! >\"$0\"' \"$1\"\nexit 0\n")
    # brief.sh FIFO: leaves a child that is still alive when the check exits
    # and ends on its own once FIFO is written (DND-1356: an event, where it
    # used to be `sleep 1` against the 5 s grace, a race a slow host loses).
    brief = File.join(dir, "brief.sh")
    File.write(brief, "#!/bin/sh\n(read _x < \"$1\") >/dev/null 2>&1 &\nexit 0\n")
    [leaky, brief].each { |p| FileUtils.chmod(0o755, p) }
    # run_brief -> [ok, out, alive_at_sweep, grace_seen]. For this one call
    # the sweep records the grace run_one asked for and runs it as a hang cap
    # (600 s), and its FIRST scan that finds the child releases it, returning
    # the child as still alive. So the sweep's grace wait is what must see the
    # child go: a sweep that killed at once would find it and fail the check,
    # and a slow host only makes the wait longer, never the verdict different.
    brief_n = 0
    run_brief = lambda do
      brief_n += 1
      fifo = File.join(dir, "brief-#{brief_n}.fifo")
      File.mkfifo(fifo)
      seen = { alive: false, grace: nil }
      writer = nil
      real_reap = ReapTags.method(:reap)
      real_tp = ReapTags.method(:tagged_pids)
      ReapTags.define_singleton_method(:tagged_pids) do |*a, **k|
        found = real_tp.call(*a, **k)
        if !found.empty? && writer.nil?
          seen[:alive] = true
          writer = Thread.new { File.open(fifo, "w") { |f| f.write("go\n") } }
        end
        found
      end
      ReapTags.define_singleton_method(:reap) do |tag, grace: ReapTags::DEFAULT_GRACE_S, **kw|
        seen[:grace] = grace
        real_reap.call(tag, grace: grace.positive? ? 600 : grace, **kw)
      end
      begin
        r_ok, r_out = run_one([brief, fifo], chdir: dir)
      ensure
        ReapTags.define_singleton_method(:reap, real_reap)
        ReapTags.define_singleton_method(:tagged_pids, real_tp)
        if writer.nil?
          # The sweep never saw the child (a failing run). Release it anyway,
          # without blocking: with no reader the open is ENXIO, which is fine.
          File.open(fifo, File::WRONLY | File::NONBLOCK) { |f| f.write("go\n") } rescue nil
        elsif !writer.join(10)
          # The child never opened the FIFO: unblock the writer, never hang.
          File.open(fifo, File::RDONLY | File::NONBLOCK) { writer.join(10) } rescue nil
          writer.kill
        end
      end
      [r_ok, r_out, seen[:alive], seen[:grace]]
    end

    leak_ok, leak_out = run_one([leaky, pidfile], chdir: dir)
    leak_pid = File.exist?(pidfile) ? File.read(pidfile).strip.to_i : 0
    alive = leak_pid.positive? && begin
      Process.kill(0, leak_pid)
      true
    rescue Errno::ESRCH
      false
    end
    expect.call(!leak_ok, "a check that exited 0 but left `sleep 307` running was reported PASS")
    expect.call(leak_out.to_s.include?("left 1 process(es) running") && leak_out.to_s.include?("sleep 307") &&
                leak_out.to_s.include?("Fix:"),
                "the failure does not name the leaked process with a Fix: (#{leak_out.inspect})")
    expect.call(leak_pid.positive? && !alive, "the leaked process (pid #{leak_pid}) is still alive after the check")
    Process.kill("KILL", leak_pid) if alive

    # A child that finishes inside the grace period is not a leak.
    brief_ok, brief_out, brief_alive, brief_grace = run_brief.call
    expect.call(brief_grace == ReapTags::DEFAULT_GRACE_S,
                "a check that returned was swept with grace #{brief_grace.inspect}, not DEFAULT_GRACE_S")
    expect.call(brief_alive, "the brief child was already gone when the sweep began, so the grace was never exercised")
    expect.call(brief_ok, "a child that exits during the grace period was called a leak (#{brief_out.inspect})")

    # Another run's tagged process (a sibling gate) is never touched.
    other_tag = ReapTags.new_tag("selftest-sibling")
    sib = Process.spawn(ReapTags.env_with(other_tag), "sleep", "308", out: File::NULL, err: File::NULL)
    begin
      sib_ok, = run_brief.call
      sib_alive = begin
        Process.kill(0, sib)
        true
      rescue Errno::ESRCH
        false
      end
      expect.call(sib_ok && sib_alive, "a sibling run's tagged process was reaped by this check's sweep")
    ensure
      Process.kill("KILL", sib) rescue nil
      Process.wait(sib) rescue nil
    end

    # DND-1016: a tagged process caught inside execve is still found. Its
    # environ reads empty (or is cut short) mid-exec; the old scan read that
    # as untagged and missed this spinner in 11-15% of scans (22, 29 and 31 of
    # 200 in three runs), so a leak caught mid-exec by the sweep outlived it.
    spin = File.join(dir, "spin.sh")
    File.write(spin, "#!/bin/bash\nexec /bin/bash \"$0\"\n")
    FileUtils.chmod(0o755, spin)
    spin_tag = ReapTags.new_tag("selftest-exec-spinner")
    spinner = Process.spawn(ReapTags.env_with(spin_tag), spin, out: File::NULL, err: File::NULL)
    begin
      # Until its first exec the child is a fork of this gate, with this
      # gate's (untagged) environment: it does not carry the tag yet, so
      # scanning then would be measuring the spawn, not the exec window.
      spawned_by = ReapTags.monotonic + 5
      until (File.binread("/proc/#{spinner}/cmdline").include?(spin) rescue false) || ReapTags.monotonic > spawned_by
        sleep 0.01
      end
      misses = 200.times.count { !ReapTags.tagged_pids(spin_tag).include?(spinner) }
      expect.call(misses.zero?, "a tagged process that re-execs itself was missing from #{misses} of 200 scans " \
                                "(a mid-exec environ read counted as untagged)")
    ensure
      Process.kill("KILL", spinner) rescue nil
      Process.wait(spinner) rescue nil
    end

    # A process whose bounds never settle (0 0 on a fixture /proc) cannot be
    # told: the scan raises ScanError naming it, never returns "none left".
    fake = File.join(dir, "fakeproc", "4202")
    FileUtils.mkdir_p(fake)
    File.write(File.join(fake, "stat"), "4202 (fake) S#{' 0' * 18} 100#{' 0' * 27} 0 0 0\n")
    File.write(File.join(fake, "status"), "Name:\tfake\nUid:\t#{Process.uid}\t#{Process.uid}\t#{Process.uid}\t#{Process.uid}\n")
    File.write(File.join(fake, "environ"), "#{ReapTags::VAR}=#{spin_tag}\0")
    File.write(File.join(fake, "cmdline"), "fake\0")
    unknown_err = begin
      ReapTags.tagged_pids(spin_tag, proc_root: File.dirname(fake), since: 0, settle: 0.2)
      nil
    rescue ReapTags::ScanError => e
      e.message
    end
    expect.call(unknown_err.to_s.include?("pid=4202") && unknown_err.to_s.include?("UNKNOWN") &&
                unknown_err.to_s.include?("Fix:"),
                "a pid whose environment bounds never settle was not reported as UNKNOWN (#{unknown_err.inspect})")

    # ...and run_one turns a sweep that could not look into a FAILED check,
    # never "nothing leaked". The sweep is stubbed to raise for one call.
    real_reap = ReapTags.method(:reap)
    ReapTags.define_singleton_method(:reap) { |*_a, **_k| raise ReapTags::ScanError, "probe pid=4202 UNKNOWN. Fix: none" }
    begin
      blind_ok, blind_out = run_one(["true"], chdir: dir)
    ensure
      ReapTags.define_singleton_method(:reap, real_reap)
    end
    expect.call(!blind_ok && blind_out.to_s.include?("could not look") && blind_out.to_s.include?("pid=4202"),
                "a leak sweep that could not look was reported as a PASS (#{blind_ok.inspect}, #{blind_out.inspect})")

    # A PARTIAL scan (one pid never settles) still kills the matches it
    # confirmed, then raises with them in `killed`; dropping them would leave
    # the very orphan DND-1016 is about. tagged_pids is stubbed to report a
    # real tagged sleep plus an unknown.
    part_tag = ReapTags.new_tag("selftest-partial")
    part = Process.spawn(ReapTags.env_with(part_tag), "sleep", "311", out: File::NULL, err: File::NULL)
    real_tp = ReapTags.method(:tagged_pids)
    ReapTags.define_singleton_method(:tagged_pids) do |*_a, **_k|
      found = begin
        Process.kill(0, part)
        Process.waitpid(part, Process::WNOHANG) ? [] : [part]
      rescue Errno::ESRCH, Errno::ECHILD
        []
      end
      raise ReapTags::ScanError.new("pid=4203 UNKNOWN. Fix: none", found: found)
    end
    part_err = begin
      ReapTags.reap(part_tag, grace: 0)
      nil
    rescue ReapTags::ScanError => e
      e
    ensure
      ReapTags.define_singleton_method(:tagged_pids, real_tp)
    end
    part_dead = begin
      Process.waitpid(part, Process::WNOHANG) || !Process.kill(0, part)
    rescue Errno::ESRCH, Errno::ECHILD
      true
    end
    expect.call(part_err && part_err.killed.any? { |(p, _)| p == part } && part_dead,
                "a partial scan did not kill the tagged process it confirmed before failing " \
                "(error: #{part_err.inspect}, killed: #{part_err&.killed.inspect}, dead: #{part_dead.inspect})")
    unless part_dead
      Process.kill("KILL", part) rescue nil
      Process.wait(part) rescue nil
    end
  end
  ok
end

# --self-test group core (DND-1007 split): every case but 4b and 13
# (DND-818). Returns true when every assertion holds.
def self_test_core
  ok = true

  # 1. Every declared check exists and is executable.
  missing = missing_executables
  unless missing.empty?
    warn "self-test: FAIL — declared check(s) not executable: " \
         "#{missing.map { |(_, a)| a.first }.join(', ')}"
    ok = false
  end

  # 2. No hook is declared in the false-green form (`<hook>.sh --self-test`).
  traps = false_green_entries
  unless traps.empty?
    warn "self-test: FAIL — hook check(s) declared in the FALSE-GREEN form " \
         "(must be the dedicated .self-test.sh script): " \
         "#{traps.map { |(_, a)| a.join(' ') }.join(', ')}"
    ok = false
  end

  # 3. Every ai/hooks/*.self-test.sh on disk is actually declared (a new hook
  #    must not be able to ship untested by the gate).
  on_disk = hook_self_tests_on_disk
  declared = CHECKS.map { |(_, argv)| argv.first }
  undeclared = on_disk - declared
  unless undeclared.empty?
    warn "self-test: FAIL — hook self-test(s) on disk but not in CHECKS: " \
         "#{undeclared.join(', ')}"
    ok = false
  end

  # 3b. STATIC_CHECKS must never ALSO hand-declare a path that discovery
  #     already finds — that would run the same suite twice under two labels,
  #     silently, with no failure. SELF_TEST_DELEGATES documents each case
  #     that already had this collision fixed (ai/inbox/test/self-test.sh
  #     moved out of STATIC_CHECKS in favor of discovery); this assertion is
  #     what stops it from creeping back in on any FUTURE STATIC_CHECKS entry.
  overlap = STATIC_CHECKS.map { |(_, argv)| argv.first } & discover_self_tests
  unless overlap.empty?
    warn "self-test: FAIL — STATIC_CHECKS hand-declares #{overlap.join(', ')}, " \
         "which discover_self_tests ALSO finds — the suite would run twice " \
         "under two labels. Remove the STATIC_CHECKS entry and let discovery " \
         "cover it (add a SELF_TEST_DELEGATES entry if some installer's " \
         "--self-test also wraps it)."
    ok = false
  end

  # 4. Every scripts/setup-* installer that ADVERTISES a --self-test is either
  #    declared in CHECKS or delegates (SELF_TEST_DELEGATES) to a check that IS
  #    declared/discovered. Same class as (3): a committed self-test the gate
  #    never runs is a suite that cannot go red. DND-189 shipped 42 cases
  #    nothing invoked; setup-hooks' merge-safety cases had been equally unrun
  #    since the 2026-09-17 hook-clobber fix.
  installers = Dir.glob(File.join(CUSTOM_DIR, "scripts/setup-*"))
                  .select { |p| File.file?(p) && File.executable?(p) }
                  .select { |p| File.read(p).include?("--self-test") }
                  .map { |p| p.sub("#{CUSTOM_DIR}/", "") }.sort
  unrun = installers.reject do |script|
    declared.include?(script) ||
      declared.include?(SELF_TEST_DELEGATES[script])
  end
  unless unrun.empty?
    warn "self-test: FAIL — installer self-test(s) on disk but not run by the " \
         "gate: #{unrun.join(', ')}"
    ok = false
  end

  # Cases 5, 6, 6b and 6c below all plant a fixture suite under a
  # Dir.mktmpdir tree and assume it is NOT itself inside a git worktree — that
  # is what makes discover_self_tests(fixture_root) return exactly what was
  # planted. `Dir.mktmpdir` honours $TMPDIR, so if TMPDIR is ever pointed
  # inside a repo (a plausible CI/agent/sandbox setup), `tracked_files` would
  # treat the fixture as a real repo, the planted suite would look untracked,
  # and every one of those cases would report a FALSE red that blames
  # discovery for an environment property instead of a real bug. Verify the
  # assumption instead of stating it: probe once, and if it doesn't hold, skip
  # those specific cases with a clear NOTE rather than a false failure (6d and
  # 6e are unaffected — 6d creates its own real repo on purpose, 6e's `git` is
  # a PATH-shimmed fake that never touches the real filesystem check).
  fixtures_isolated =
    Dir.mktmpdir("harness-gate-selftest-probe") do |probe|
      _out, _err, probe_status = Open3.capture3("git", "-C", probe, "rev-parse", "--is-inside-work-tree")
      !probe_status.success?
    end
  unless fixtures_isolated
    warn "self-test: NOTE — skipping cases 5/6/6b/6c/7c/7d/7f/7g: Dir.mktmpdir resolves " \
         "inside a git worktree in this environment (check $TMPDIR), so the " \
         "tracked-file filter would treat every fixture there as a real repo " \
         "and produce false reds unrelated to this code. Not counted as a " \
         "failure."
  end

  # 5. Discovery itself actually discovers and actually runs — proven against a
  #    THROWAWAY fixture tree, never a real test/ directory, per the ticket's
  #    required case: "a deliberately failing stub suite under scripts/test/
  #    must turn the gate red, and removing it must turn it green again." (A
  #    plain "on-disk == declared" comparison here would be tautological, since
  #    CHECKS is built FROM discover_self_tests — this fixture instead
  #    exercises the actual discover -> run -> pass/fail behavior end to end.)
  if fixtures_isolated
  Dir.mktmpdir("harness-gate-selftest-scripts") do |fixture_root|
    suite_dir = File.join(fixture_root, "scripts/test/fixture-suite")
    FileUtils.mkdir_p(suite_dir)
    suite_path = File.join(suite_dir, "self-test.sh")

    # Nothing discovered yet -> zero dynamic checks, not a crash and not a
    # false PASS masquerading as "found nothing to run".
    if discover_self_tests(fixture_root) != []
      warn "self-test: FAIL — discover_self_tests found something in a " \
           "fixture tree that has no suite yet"
      ok = false
    end

    File.write(suite_path, "#!/bin/sh\necho 'fixture failing on purpose'\nexit 1\n")
    FileUtils.chmod(0o755, suite_path)

    found = discover_self_tests(fixture_root)
    unless found == ["scripts/test/fixture-suite/self-test.sh"]
      warn "self-test: FAIL — discover_self_tests did not find the fixture " \
           "suite (found: #{found.inspect})"
      ok = false
    end

    red_ok, red_out = run_one([found.first], chdir: fixture_root)
    if red_ok
      warn "self-test: FAIL — a deliberately failing self-test stub was " \
           "reported as PASS (the exact silent-success class this ticket " \
           "exists to fix)"
      ok = false
    end
    unless red_out.to_s.include?("fixture failing on purpose")
      warn "self-test: FAIL — the failing fixture suite's output was not captured"
      ok = false
    end

    File.write(suite_path, "#!/bin/sh\nexit 0\n")
    FileUtils.chmod(0o755, suite_path)
    green_ok, = run_one([found.first], chdir: fixture_root)
    unless green_ok
      warn "self-test: FAIL — fixing the fixture suite to exit 0 did not turn " \
           "it green"
      ok = false
    end

    FileUtils.rm_f(suite_path)
    unless discover_self_tests(fixture_root).empty?
      warn "self-test: FAIL — removing the fixture suite did not make " \
           "discovery report zero again"
      ok = false
    end
  end
  end

  # 6. Two suites that share a leaf directory name must not collide on label
  #    (self_test_checks must key off the full relative path, not a basename).
  if fixtures_isolated
  Dir.mktmpdir("harness-gate-selftest-labels") do |fixture_root|
    %w[groupA/test groupB/test].each do |rel|
      dir = File.join(fixture_root, rel)
      FileUtils.mkdir_p(dir)
      path = File.join(dir, "self-test.sh")
      File.write(path, "#!/bin/sh\nexit 0\n")
      FileUtils.chmod(0o755, path)
    end
    labels = self_test_checks(fixture_root).map(&:first)
    if labels.uniq.size != labels.size
      warn "self-test: FAIL — two distinct suites produced the same label: " \
           "#{labels.inspect}"
      ok = false
    end
  end
  end

  # 6-dot. DND-422: discovery must descend dot-directories. Without
  #    FNM_DOTMATCH `**/` skips them, so a committed suite (or a stray one, or a
  #    dot-prefixed hook suite) under e.g. `.auto-completions/` would silently
  #    never run and never be flagged.
  if fixtures_isolated
  Dir.mktmpdir("harness-gate-selftest-dotdir") do |fixture_root|
    { ".hidden/test/self-test.sh" => "#!/bin/sh\nexit 0\n",
      ".hidden/test/stray.sh" => "#!/bin/sh\nexit 0\n",
      "ai/hooks/.dotted.self-test.sh" => "#!/bin/sh\nexit 0\n" }.each do |rel, body|
      FileUtils.mkdir_p(File.dirname(File.join(fixture_root, rel)))
      File.write(File.join(fixture_root, rel), body)
    end
    unless discover_self_tests(fixture_root) == [".hidden/test/self-test.sh"]
      warn "self-test: FAIL — discover_self_tests missed a suite under a " \
           "dot-directory (found: #{discover_self_tests(fixture_root).inspect})"
      ok = false
    end
    unless stray_test_scripts(fixture_root) == [".hidden/test/stray.sh"]
      warn "self-test: FAIL — stray_test_scripts missed a stray under a " \
           "dot-directory (found: #{stray_test_scripts(fixture_root).inspect})"
      ok = false
    end
    unless hook_self_tests_on_disk(fixture_root) == ["ai/hooks/.dotted.self-test.sh"]
      warn "self-test: FAIL — hook_self_tests_on_disk missed a dot-prefixed hook " \
           "suite (found: #{hook_self_tests_on_disk(fixture_root).inspect})"
      ok = false
    end
  end
  end

  # 6b. run_gate's own guards, exercised as predicates/helpers against fixture
  #     roots — the zero-discovery hard-fail and the stray-suite-name warning
  #     each need their own case; nothing above reaches either branch.
  if fixtures_isolated
  Dir.mktmpdir("harness-gate-selftest-guards") do |fixture_root|
    # self_tests_found? must be false with nothing on disk, and true again
    # once a real self-test.sh exists.
    if self_tests_found?(fixture_root)
      warn "self-test: FAIL — self_tests_found? was true for a fixture root " \
           "with nothing on disk"
      ok = false
    end

    suite_dir = File.join(fixture_root, "scripts/test/only-suite")
    FileUtils.mkdir_p(suite_dir)
    suite_path = File.join(suite_dir, "self-test.sh")
    File.write(suite_path, "#!/bin/sh\nexit 0\n")
    FileUtils.chmod(0o755, suite_path)
    unless self_tests_found?(fixture_root)
      warn "self-test: FAIL — self_tests_found? was false for a fixture root " \
           "that has a real self-test.sh"
      ok = false
    end

    # stray_test_scripts must catch a misnamed suite EVEN WITHOUT the
    # executable bit (the case a suite is most likely to be committed in) and
    # must never flag the correctly-named self-test.sh sitting right next to it.
    stray_dir = File.join(fixture_root, "scripts/test/misnamed")
    FileUtils.mkdir_p(stray_dir)
    stray_path = File.join(stray_dir, "tests.sh")
    File.write(stray_path, "#!/bin/sh\nexit 0\n")
    FileUtils.chmod(0o644, stray_path) # deliberately NOT executable

    strays = stray_test_scripts(fixture_root)
    unless strays.include?("scripts/test/misnamed/tests.sh")
      warn "self-test: FAIL — stray_test_scripts did not flag a non-executable " \
           "misnamed suite (found: #{strays.inspect})"
      ok = false
    end
    if strays.include?("scripts/test/only-suite/self-test.sh")
      warn "self-test: FAIL — stray_test_scripts flagged a correctly-named " \
           "self-test.sh as stray"
      ok = false
    end
  end
  end

  # 6c. run_gate's OWN zero-discovery and stray-suite branches, not just the
  #     extracted predicates 6b already covers — a bug in the branch itself
  #     (e.g. the wrong predicate called, or a message with no Fix: line)
  #     would pass 6b and still slip through. dry_run: true stops run_gate
  #     before it would execute the real CHECKS list as a side effect.
  capture = lambda do |&block|
    old_out, old_err = $stdout, $stderr
    out, err = StringIO.new, StringIO.new
    $stdout, $stderr = out, err
    code = block.call
    [code, out.string, err.string]
  ensure
    $stdout, $stderr = old_out, old_err
  end

  if fixtures_isolated
  Dir.mktmpdir("harness-gate-selftest-rungate") do |fixture_root|
    code, _out, err = capture.call { run_gate(root: fixture_root, dry_run: true) }
    if code != 1
      warn "self-test: FAIL — run_gate(root: <empty fixture>) returned " \
           "#{code.inspect}, expected 1 (zero-discovery must hard-fail)"
      ok = false
    end
    unless err.include?("Fix:")
      warn "self-test: FAIL — run_gate's zero-discovery failure carried no " \
           "Fix: line"
      ok = false
    end

    suite_dir = File.join(fixture_root, "scripts/test/x")
    FileUtils.mkdir_p(suite_dir)
    File.write(File.join(suite_dir, "self-test.sh"), "#!/bin/sh\nexit 0\n")
    FileUtils.chmod(0o755, File.join(suite_dir, "self-test.sh"))
    File.write(File.join(suite_dir, "helper_tests.sh"), "#!/bin/sh\nexit 0\n")
    FileUtils.chmod(0o755, File.join(suite_dir, "helper_tests.sh"))

    code2, _out2, err2 = capture.call { run_gate(root: fixture_root, dry_run: true) }
    if code2 != 0
      warn "self-test: FAIL — run_gate(root: <fixture with a real suite>, " \
           "dry_run: true) returned #{code2.inspect}, expected 0"
      ok = false
    end
    unless err2.include?("helper_tests.sh") && err2.include?("Fix:")
      warn "self-test: FAIL — run_gate did not warn about the stray suite " \
           "with a Fix: line (stderr: #{err2.inspect})"
      ok = false
    end
  end
  end

  # 6d. discover_self_tests/stray_test_scripts must not promote an UNTRACKED
  #     file into the gate — a vendored/ignored tree that happens to contain a
  #     self-test.sh (this repo's own ai/skills/synced/ is exactly this shape)
  #     must never be silently executed or hard-fail the gate over its
  #     permissions. Needs a REAL git repo (tracked_files returns nil, and the
  #     filter is skipped, for a fixture root with no .git at all).
  Dir.mktmpdir("harness-gate-selftest-tracked") do |fixture_root|
    Open3.capture3("git", "-C", fixture_root, "init", "-q")
    Open3.capture3("git", "-C", fixture_root, "config", "user.email", "a@b.c")
    Open3.capture3("git", "-C", fixture_root, "config", "user.name", "test")

    tracked_dir = File.join(fixture_root, "scripts/test/tracked")
    FileUtils.mkdir_p(tracked_dir)
    tracked_path = File.join(tracked_dir, "self-test.sh")
    File.write(tracked_path, "#!/bin/sh\nexit 0\n")
    FileUtils.chmod(0o755, tracked_path)
    Open3.capture3("git", "-C", fixture_root, "add", "scripts/test/tracked/self-test.sh")
    Open3.capture3("git", "-C", fixture_root, "commit", "-q", "-m", "tracked suite")

    untracked_dir = File.join(fixture_root, "vendor/untracked")
    FileUtils.mkdir_p(untracked_dir)
    untracked_path = File.join(untracked_dir, "self-test.sh")
    File.write(untracked_path, "#!/bin/sh\nexit 0\n")
    FileUtils.chmod(0o755, untracked_path)
    # deliberately never `git add`ed — simulates a vendored/ignored tree.

    found_tracked = discover_self_tests(fixture_root)
    if found_tracked.include?("vendor/untracked/self-test.sh")
      warn "self-test: FAIL — discover_self_tests promoted an UNTRACKED " \
           "self-test.sh into the gate: #{found_tracked.inspect}"
      ok = false
    end
    unless found_tracked.include?("scripts/test/tracked/self-test.sh")
      warn "self-test: FAIL — discover_self_tests dropped a TRACKED " \
           "self-test.sh when a git repo is present: #{found_tracked.inspect}"
      ok = false
    end
  end

  # 6e. tracked_files must FAIL LOUD (GitTrackingError), never silently skip
  #     the filter, when root IS a confirmed git worktree but `git ls-files`
  #     itself errors — the ambiguity a prior version of this code collapsed
  #     (both "not a repo" and "repo, but git errored" returned nil, so a real
  #     git failure on the REAL repo would have silently let an
  #     untracked/vendored self-test.sh straight into the gate). Proven with a
  #     fake `git` on PATH that answers `rev-parse` normally but fails
  #     `ls-files`, so this exercises the exact branch, not just its shape.
  Dir.mktmpdir("harness-gate-selftest-git-fail") do |fixture_root|
    fake_bin = File.join(fixture_root, "fakebin")
    FileUtils.mkdir_p(fake_bin)
    fake_git = File.join(fake_bin, "git")
    File.write(fake_git, <<~SH)
      #!/bin/sh
      if [ "$3" = "rev-parse" ]; then exit 0; fi
      if [ "$3" = "ls-files" ]; then echo "boom: simulated git failure" >&2; exit 128; fi
      exit 1
    SH
    FileUtils.chmod(0o755, fake_git)

    old_path = ENV["PATH"]
    raised = nil
    begin
      ENV["PATH"] = "#{fake_bin}:#{old_path}"
      begin
        tracked_files(fixture_root)
        raised = false
      rescue GitTrackingError => e
        raised = true
        unless e.message.include?("ls-files") && e.message.include?("simulated git failure")
          warn "self-test: FAIL — GitTrackingError's message didn't carry the " \
               "underlying git error: #{e.message.inspect}"
          ok = false
        end
      end
    ensure
      ENV["PATH"] = old_path
    end
    unless raised
      warn "self-test: FAIL — tracked_files did not raise GitTrackingError " \
           "when a confirmed git worktree's ls-files failed (it must never " \
           "fail open into skipping the filter)"
      ok = false
    end

    # And the dispatch-level rescue turns that into a Fix:-carrying failure,
    # not a bare Ruby backtrace, end to end via a real subprocess.
    env = { "PATH" => "#{fake_bin}:#{old_path}" }
    out, status = Open3.capture2e(env, RbConfig.ruby, File.join(CUSTOM_DIR, "ai/bin/harness-gate"),
                                   "--list", chdir: CUSTOM_DIR, stdin_data: "")
    if status.success?
      warn "self-test: FAIL — harness-gate --list exited 0 despite a " \
           "simulated git ls-files failure"
      ok = false
    end
    unless out.include?("Fix:") && !out.include?(":in `")
      warn "self-test: FAIL — a git-failure exit did not carry a clean Fix: " \
           "message (looks like a raw, unhandled backtrace instead): " \
           "#{out.inspect}"
      ok = false
    end
  end

  # 7. Composition, end to end: invoke the REAL `harness-gate --list` as a
  #    subprocess against the real repo (safe — it only lists, never runs the
  #    checks) and assert every real discovered suite actually reaches
  #    `CHECKS` and its printed output. This is the non-tautological check
  #    case 5 can't be: case 5 proves discover_self_tests works in isolation,
  #    but nothing there would notice `CHECKS = (STATIC_CHECKS +
  #    self_test_checks).freeze` losing its `+ self_test_checks` term, since
  #    CHECKS and the fixture calls are otherwise independent of that line. A
  #    real subprocess exercises the actual composition.
  list_ok, list_out = run_one(%w[ai/bin/harness-gate --list])
  unless list_ok
    warn "self-test: FAIL — `harness-gate --list` itself exited non-zero"
    ok = false
  end
  real_suites = discover_self_tests
  real_suites.each do |relpath|
    name = relpath.sub(%r{/self-test\.sh\z}, "")
    unless list_out.include?("self-test: #{name}")
      warn "self-test: FAIL — `harness-gate --list` did not list the real " \
           "discovered suite #{relpath.inspect} (composition at CHECKS = " \
           "STATIC_CHECKS + self_test_checks may be broken)"
      ok = false
    end
  end
  unless list_out.include?("(#{real_suites.size} of them discovered under " \
                            "**/self-test.sh)")
    warn "self-test: FAIL — `harness-gate --list`'s discovered-count summary " \
         "does not match discover_self_tests"
    ok = false
  end

  # 7b. The wrong-tree guard: git_tree_identity + foreign_gate_tree, against
  #     REAL fixture repositories (a main checkout, a linked worktree of it,
  #     and an unrelated repo), because the whole defect class lives in git's
  #     own path-format behaviour and a hand-built fixture would just encode
  #     whatever this code already believes.
  Dir.mktmpdir("harness-gate-tree") do |dir|
    # -c core.excludesFile= : a global excludes file leaks into throwaway
    # repos on this machine and has silently emptied fixture repos before.
    mk = lambda do |path|
      FileUtils.mkdir_p(path)
      Open3.capture3("git", "-c", "init.defaultBranch=main", "init", "-q", path)
      File.write(File.join(path, "f"), "x")
      Open3.capture3("git", "-C", path, "add", "f")
      Open3.capture3({ "GIT_AUTHOR_NAME" => "t", "GIT_AUTHOR_EMAIL" => "t@t",
                       "GIT_COMMITTER_NAME" => "t", "GIT_COMMITTER_EMAIL" => "t@t" },
                     "git", "-C", path, "commit", "-qm", "init")
    end

    main_co = File.join(dir, "repo")
    other   = File.join(dir, "other")
    wt      = File.join(dir, "wt")
    sub     = File.join(main_co, "sub")
    plain   = File.join(dir, "plain")
    mk.call(main_co)
    mk.call(other)
    FileUtils.mkdir_p(sub)
    FileUtils.mkdir_p(plain)
    _o, e, st = Open3.capture3("git", "-C", main_co, "worktree", "add", "-q", "-b", "lane", wt)

    if !st.success? || !File.directory?(wt)
      warn "self-test: FAIL — could not build the worktree fixture: #{e.strip}"
      ok = false
    else
      # THE MISS CASE, and the reason this fixture is a real worktree: a main
      # checkout's --git-common-dir is the RELATIVE ".git". If the expansion in
      # git_tree_identity were dropped, main and its own worktree would compare
      # as different repositories and the next assertion would silently pass by
      # not firing. Assert the absoluteness directly too, so the miss is named
      # rather than inferred.
      id_main = git_tree_identity(main_co)
      id_wt   = git_tree_identity(wt)
      if id_main.nil? || id_wt.nil?
        warn "self-test: FAIL — git_tree_identity returned nil for a real git tree"
        ok = false
      else
        unless id_main[1].start_with?("/") && id_wt[1].start_with?("/")
          warn "self-test: FAIL — git_tree_identity returned a NON-ABSOLUTE repo " \
               "identity (#{id_main[1].inspect} / #{id_wt[1].inspect}) — the " \
               "cwd-relative --git-common-dir trap is back"
          ok = false
        end
        unless id_main[1] == id_wt[1]
          warn "self-test: FAIL — a main checkout and its own linked worktree did " \
               "NOT resolve to the same repo identity (#{id_main[1].inspect} vs " \
               "#{id_wt[1].inspect}); the guard can never fire"
          ok = false
        end
        if id_main[0] == id_wt[0]
          warn "self-test: FAIL — a main checkout and its worktree resolved to the " \
               "SAME worktree root; the guard would never fire"
          ok = false
        end
      end

      # Fires: same repo, different tree — in BOTH directions.
      [[wt, main_co], [main_co, wt]].each do |(from, gate)|
        if foreign_gate_tree(gate_root: gate, cwd: from).nil?
          warn "self-test: FAIL — foreign_gate_tree did NOT refuse gating #{gate} " \
               "from #{from} (same repo, different worktree)"
          ok = false
        end
      end

      # Does NOT fire: same tree, a subdirectory of it, an unrelated repo, a
      # non-repo directory, and an unresolvable path. Each of these is a
      # deliberate allow, not an oversight.
      {
        "same tree"          => [main_co, main_co],
        "subdirectory"       => [main_co, sub],
        "unrelated repo"     => [main_co, other],
        "not a repo at all"  => [main_co, plain],
        "nonexistent cwd"    => [main_co, File.join(dir, "nope")],
      }.each do |why, (gate, from)|
        unless foreign_gate_tree(gate_root: gate, cwd: from).nil?
          warn "self-test: FAIL — foreign_gate_tree wrongly refused (#{why}): " \
               "gate=#{gate} cwd=#{from}"
          ok = false
        end
      end

      # THE MISS, driven rather than inferred. The relative-".git" form comes
      # back only from a MAIN checkout, and the real main checkout is not
      # something a self-test may chdir into, so stub `git` to return it
      # unconditionally and assert the EXPANSION — that the identity comes
      # back as an absolute path under the tree git was asked about, and NOT
      # as ".git" resolved against whatever cwd the suite happened to run in.
      # With `File.expand_path(common, dir)` deleted, File.realpath(".git")
      # resolves against the caller's cwd, yields a different repo identity
      # than the worktree's, and the refusal above silently never fires — a
      # green suite guarding nothing.
      stub_dir = File.join(dir, "stubbin")
      FileUtils.mkdir_p(stub_dir)
      stub = File.join(stub_dir, "git")
      File.write(stub, <<~SH)
        #!/bin/sh
        for a in "$@"; do
          case "$a" in
            --show-toplevel)    echo "#{main_co}"; exit 0 ;;
            --git-common-dir)   echo ".git";       exit 0 ;;
          esac
        done
        exit 0
      SH
      FileUtils.chmod(0o755, stub)
      old_path = ENV["PATH"]
      begin
        ENV["PATH"] = "#{stub_dir}:#{old_path}"
        stubbed = git_tree_identity(main_co)
        want = File.realpath(File.join(main_co, ".git"))
        if stubbed.nil? || stubbed[1] != want
          warn "self-test: FAIL — a CWD-RELATIVE --git-common-dir resolved to " \
               "#{stubbed.inspect} instead of #{want.inspect}; the expansion in " \
               "git_tree_identity is gone, so a main checkout and its own " \
               "worktree compare as different repositories and the wrong-tree " \
               "refusal can never fire"
          ok = false
        end
      rescue TreeIdentityError => e
        warn "self-test: FAIL — a relative --git-common-dir raised instead of " \
             "being expanded against the directory git was asked about: #{e.message}"
        ok = false
      ensure
        ENV["PATH"] = old_path
      end
    end
  end

  # 7c (DND-896). The OK/FAILED summary lines name the gated tree and HEAD, so
  #    a report that quotes only that line can be attributed to a commit.
  #    Every git read here is guarded: a failure is a FAIL line, never an
  #    uncaught exception that ends the self-test early.
  real_attribution = begin
    gate_attribution(CUSTOM_DIR)
  rescue GateAttributionError => e
    warn "self-test: FAIL — gate_attribution(CUSTOM_DIR) raised on the real repo: #{e.message}"
    ok = false
    nil
  end
  real_head, _e, real_st = Open3.capture3("git", "-C", CUSTOM_DIR, "rev-parse", "HEAD")
  unless real_st.success?
    warn "self-test: FAIL — could not read the real repo's HEAD to compare " \
         "against gate_attribution"
    ok = false
  end
  real_head = real_head.strip
  if real_attribution
    unless real_attribution.include?(CUSTOM_DIR) && real_attribution.include?(real_head)
      warn "self-test: FAIL — gate_attribution(CUSTOM_DIR) is #{real_attribution.inspect}, " \
           "which does not name #{CUSTOM_DIR.inspect} and its real HEAD " \
           "#{real_head.inspect} (`git -C #{CUSTOM_DIR} rev-parse HEAD`)"
      ok = false
    end
    ok_line = gate_ok_message(3, 3, real_attribution)
    unless ok_line.start_with?("harness-gate: OK — 3/3 checks PASS; safe to commit.")
      warn "self-test: FAIL — gate_ok_message changed the byte-identical prefix " \
           "consumers may match on: #{ok_line.inspect}"
      ok = false
    end
    unless ok_line.end_with?(real_attribution)
      warn "self-test: FAIL — gate_ok_message did not append the attribution " \
           "suffix: #{ok_line.inspect}"
      ok = false
    end
    failed_line = gate_failed_header(2, 5, real_attribution)
    unless failed_line.start_with?("harness-gate: FAILED — 2 of 5 check(s) did not pass:") &&
           failed_line.end_with?(real_attribution)
      warn "self-test: FAIL — gate_failed_header did not carry the prefix + " \
           "attribution: #{failed_line.inspect}"
      ok = false
    end
  end

  # 7c/7d/7f fixtures below plant a NON-repo dir (not_a_repo) and fixture
  # repos, and rely on a non-repo staying a non-repo — same false-red
  # exposure as cases 5/6/6b/6c above if $TMPDIR resolves inside a real git
  # worktree (an ambient repo would make git_tree_identity(not_a_repo)
  # resolve to THAT enclosing repo instead of failing to resolve at all).
  # Gated the same way, for the same reason.
  if fixtures_isolated

  # THE MISS CASE: a root that resolves to no git tree at all must raise, not
  # silently produce a blank or wrong attribution — a wrongly computed root
  # must be impossible to pass off as a real one.
  Dir.mktmpdir("harness-gate-attribution-miss") do |not_a_repo|
    begin
      bogus = gate_attribution(not_a_repo)
      warn "self-test: FAIL — gate_attribution(<non-git dir>) returned " \
           "#{bogus.inspect} instead of raising GateAttributionError"
      ok = false
    rescue GateAttributionError
      nil
    end

    # ...and run_gate's start-of-run snapshot turns that into a FAILED line
    # with a Fix:, returning nil so run_gate stops before any check runs.
    code0, out0, err0 = capture.call { gate_start_snapshot(not_a_repo) }
    unless code0.nil? && out0.empty? && err0.include?("FAILED") && err0.include?("Fix:")
      warn "self-test: FAIL — gate_start_snapshot(<non-git dir>) did not refuse with " \
           "FAILED + Fix: (returned #{code0.inspect}, stdout #{out0.inspect}, " \
           "stderr #{err0.inspect})"
      ok = false
    end

    # 7d (critic-review round 1 and coordinator-train critic t32, DND-896).
    # An attribution failure at REPORT time must not kill the summary with a
    # bare backtrace, must not print OK, and must not swallow the per-check
    # failure report. Driven through report_check_results, the exact function
    # run_attributed_checks (and so run_gate) reports through, with a
    # fabricated failures list and a root that no longer resolves.
    pre = GateSnapshot.new(worktree_root: not_a_repo, sha: "a" * 40, dirty: false,
                           fingerprint: "fixture")
    fake_failures = [["fixture-check", %w[fixture-check --self-test], "boom\nFAIL: bad\nok\n"]]

    code3, out3, err3 = capture.call { report_check_results([], 3, pre: pre, root: not_a_repo) }
    if code3 != 1
      warn "self-test: FAIL — report_check_results([], 3) with an unattributable root " \
           "returned #{code3.inspect}, expected 1 (fail closed)"
      ok = false
    end
    unless out3.empty? && err3.include?("FAILED") && err3.include?("Fix:")
      warn "self-test: FAIL — report_check_results([], ...)'s attribution-failure " \
           "path did not degrade cleanly (stdout #{out3.inspect}, stderr #{err3.inspect})"
      ok = false
    end

    _code4, out4, err4 = capture.call do
      report_check_results(fake_failures, 5, pre: pre, root: not_a_repo)
    end
    unless out4.empty?
      warn "self-test: FAIL — report_check_results(<failures>, ...) printed to " \
           "stdout instead of stderr: #{out4.inspect}"
      ok = false
    end
    unless err4.include?("1 of 5 check(s) did not pass") && err4.include?("Fix:") &&
           err4.include?("--- fixture-check (fixture-check --self-test) ---") &&
           err4.include?("boom")
      warn "self-test: FAIL — report_check_results(<failures>, ...) lost the " \
           "per-check failure detail (label, argv, or output) when attribution " \
           "ALSO failed — the exact regression this test exists to catch " \
           "(stderr: #{err4.inspect})"
      ok = false
    end
  end

  # THE DIRTY FLAG: gate_attribution must say so when the tree has
  # uncommitted changes, and must NOT say so when it doesn't. NOTE: the
  # fixture's mktmpdir PREFIX must not itself contain the substring "dirty" —
  # it would appear inside the `[tree <path> @ <sha>]` attribution and produce
  # a false-positive match on the very check this test exists to make real.
  # The fixture commit carries its own identity and commit.gpgsign=false, and
  # its exit status is checked: a failed setup is a FAIL line, not a crash.
  Dir.mktmpdir("harness-gate-attribution-fixture") do |work_repo|
    wr_git = ["git", "-c", "commit.gpgsign=false", "-c", "user.name=t",
              "-c", "user.email=t@t", "-c", "init.defaultBranch=main"]
    File.write(File.join(work_repo, "f"), "x")
    setup = [%w[init -q], ["-C", work_repo, "add", "f"], ["-C", work_repo, "commit", "-qm", "init"]]
    setup[0] += [work_repo]
    failed_step = setup.find do |args|
      _o, _e, st = Open3.capture3(*wr_git, *args)
      !st.success?
    end
    if failed_step
      warn "self-test: FAIL — could not build the dirty-flag fixture repo " \
           "(`git #{failed_step.join(' ')}` failed)"
      ok = false
    else
      clean_attr = gate_attribution(work_repo)
      if clean_attr.include?(", dirty")
        warn "self-test: FAIL — gate_attribution flagged a clean tree as dirty: " \
             "#{clean_attr.inspect}"
        ok = false
      end

      File.write(File.join(work_repo, "untracked"), "y")
      dirty_attr = gate_attribution(work_repo)
      unless dirty_attr.include?(", dirty")
        warn "self-test: FAIL — gate_attribution did not flag an untracked file as " \
             "dirty: #{dirty_attr.inspect}"
        ok = false
      end
    end
  end


  # 7f (coordinator-train critic on b8a500b8, DND-896). The OK line must name
  #    the tree the checks RAN against, not the tree as it stands when the
  #    report is printed. The gate takes minutes and can run in a shared
  #    checkout, so HEAD can move or the tree can change while it runs. Driven
  #    through run_attributed_checks, the code run_gate delegates its check
  #    loop and report to, with a fixture repo and stub checks:
  #    - control: a check that changes nothing -> exit 0 and an OK line naming
  #      the fixture's HEAD (proves the negatives below are not vacuous);
  #    - a check that COMMITS mid-run -> non-zero, no OK line naming either
  #      SHA, and a Fix:;
  #    - a check that only writes an untracked file (HEAD unchanged) -> the
  #      same refusal, since the checked tree is not the reported tree.
  Dir.mktmpdir("harness-gate-attribution-midrun") do |dir|
    midrun_fail = lambda do |msg|
      warn "self-test: FAIL — mid-run attribution (7f): #{msg}"
      ok = false
    end
    # Hermetic enough to never crash on a global commit.gpgsign or a missing
    # identity: every commit here carries its own -c settings.
    fx_git = ["git", "-c", "commit.gpgsign=false", "-c", "user.name=t",
              "-c", "user.email=t@t", "-c", "init.defaultBranch=main"]
    fx = File.join(dir, "repo")
    _o, init_err, init_st = Open3.capture3(*fx_git, "init", "-q", fx)
    _o, base_err, base_st = Open3.capture3(*fx_git, "-C", fx, "commit", "-q",
                                           "--allow-empty", "-m", "base")
    head_of = lambda do
      out, _e, st = Open3.capture3("git", "-C", fx, "rev-parse", "HEAD")
      st.success? ? out.strip : nil
    end
    if !init_st.success? || !base_st.success?
      midrun_fail.call("could not build the fixture repo (init: #{init_err.inspect}, " \
                       "commit: #{base_err.inspect})")
    else
      stub = lambda do |name, body|
        path = File.join(dir, name)
        File.write(path, "#!/bin/sh\n#{body}\n")
        FileUtils.chmod(0o755, path)
        path
      end
      quoted_git = fx_git.map { |a| "'#{a}'" }.join(" ")
      noop = stub.call("noop.sh", "exit 0")
      committer = stub.call("commits.sh",
                            "exec #{quoted_git} -C '#{fx}' commit -q --allow-empty -m midrun")
      writer = stub.call("writes.sh", "echo y > '#{File.join(fx, 'appeared')}'")

      # Control.
      base_sha = head_of.call
      code, out, err = capture.call { run_attributed_checks([["noop", [noop]]], gate_snapshot(fx), root: fx, chdir: dir, jobs: 1, timings: File::NULL) }
      unless code.zero? && out.include?("harness-gate: OK") && out.include?("@ #{base_sha}]")
        midrun_fail.call("the control run (nothing changes mid-run) did not print OK naming " \
                         "#{base_sha.inspect} (code #{code.inspect}, stdout #{out.inspect}, " \
                         "stderr #{err.inspect})")
      end

      # HEAD moves mid-run.
      pre_sha = head_of.call
      code, out, err = capture.call { run_attributed_checks([["commits", [committer]]], gate_snapshot(fx), root: fx, chdir: dir, jobs: 1, timings: File::NULL) }
      post_sha = head_of.call
      if post_sha.nil? || post_sha == pre_sha
        midrun_fail.call("the committing stub did not move the fixture's HEAD " \
                         "(#{pre_sha.inspect} -> #{post_sha.inspect}); the case proves nothing")
      else
        midrun_fail.call("HEAD moved mid-run (#{pre_sha[0, 12]} -> #{post_sha[0, 12]}) and " \
                         "the gate still returned 0") if code.zero?
        ok_lines = out.lines.grep(/harness-gate: OK/)
        midrun_fail.call("HEAD moved mid-run and the gate still printed an OK line: " \
                         "#{ok_lines.inspect}") unless ok_lines.empty?
        unless err.include?("Fix:") && err.include?(pre_sha) && err.include?(post_sha)
          midrun_fail.call("the moved-HEAD refusal must name both SHAs and carry a Fix: " \
                           "(stderr #{err.inspect})")
        end
      end

      # The tree changes mid-run, HEAD does not.
      code, out, err = capture.call { run_attributed_checks([["writes", [writer]]], gate_snapshot(fx), root: fx, chdir: dir, jobs: 1, timings: File::NULL) }
      if code.zero? || !out.lines.grep(/harness-gate: OK/).empty? || !err.include?("Fix:")
        midrun_fail.call("the tree changed mid-run (an untracked file appeared) and the gate " \
                         "did not refuse with a Fix: (code #{code.inspect}, stdout " \
                         "#{out.inspect}, stderr #{err.inspect})")
      end
    end
  end

  # 7g (DND-896 review floor). gate_snapshot reads every untracked file's
  #    content and the index. Two edges of that read:
  #    - an untracked file the gate cannot read (a root-owned 0600 file a
  #      container left behind) must not escape as a bare Errno backtrace --
  #      at report time that would discard ~15 minutes of per-check detail;
  #    - an index-only change (the file stays `MM`, the working tree is
  #      unchanged) must still change the fingerprint, as its comment says.
  Dir.mktmpdir("harness-gate-attribution-edges") do |dir|
    edge_fail = lambda do |msg|
      warn "self-test: FAIL — snapshot edges (7g): #{msg}"
      ok = false
    end
    eg_git = ["git", "-c", "commit.gpgsign=false", "-c", "user.name=t",
              "-c", "user.email=t@t", "-c", "init.defaultBranch=main"]
    fx = File.join(dir, "repo")
    FileUtils.mkdir_p(fx)
    File.write(File.join(fx, "f"), "a")
    step_failed = [%W[init -q #{fx}], %W[-C #{fx} add f], %W[-C #{fx} commit -qm base]].find do |args|
      _o, _e, st = Open3.capture3(*eg_git, *args)
      !st.success?
    end
    if step_failed
      edge_fail.call("could not build the fixture repo (`git #{step_failed.join(' ')}` failed)")
    else
      secret = File.join(fx, "unreadable")
      File.write(secret, "s")
      FileUtils.chmod(0o000, secret)
      begin
        snap = gate_snapshot(fx)
        edge_fail.call("an unreadable untracked file must still be snapshotted as dirty " \
                       "(got #{snap.inspect})") unless snap.is_a?(GateSnapshot) && snap.dirty
      rescue StandardError => e
        edge_fail.call("an unreadable untracked file made gate_snapshot raise " \
                       "#{e.class}: #{e.message}")
      ensure
        FileUtils.chmod(0o600, secret)
        File.delete(secret)
      end

      stage = lambda do |content|
        File.write(File.join(fx, "f"), content)
        _o, _e, st = Open3.capture3(*eg_git, "-C", fx, "add", "f")
        st.success?
      end
      begin
        staged = stage.call("b")
        File.write(File.join(fx, "f"), "c")
        before = gate_snapshot(fx)
        staged &&= stage.call("d")
        File.write(File.join(fx, "f"), "c")
        after = gate_snapshot(fx)
        if !staged
          edge_fail.call("could not stage the index-only fixture change")
        elsif before.fingerprint == after.fingerprint
          edge_fail.call("an index-only change (staged b -> d, working tree 'c' both " \
                         "times) left the fingerprint unchanged")
        end
      rescue GateAttributionError => e
        edge_fail.call("gate_snapshot raised on the index-only fixture: #{e.message}")
      end
    end
  end
  end # fixtures_isolated (7c/7d/7f/7g)

  # 7e (coordinator-train critic t32, DND-896). Static composition check:
  # run_gate's OWN source must delegate its check loop and report to
  # run_attributed_checks, and that must report through
  # report_check_results — the wiring itself, not just the pieces in
  # isolation (cases 7d/7f drive those; this proves run_gate actually CALLS
  # them). A regression that reverted run_gate to call run_checks and the raw
  # gate_ok_message/gate_failed_header builders directly again would leave
  # every case-7c/7d/7f assertion green, since none of them invoke run_gate
  # itself — the same non-tautological-composition need as case 7's
  # `CHECKS = STATIC_CHECKS + self_test_checks` check.
  gate_source = File.read(__FILE__)
  run_gate_source = gate_source[/^def run_gate\b.*?^end$/m]
  attributed_source = gate_source[/^def run_attributed_checks\b.*?^end$/m]
  # DND-945 adds the freshness preflight's pin to the same hand-off: run_gate
  # passes it, and run_attributed_checks gives it to run_checks, so origin is
  # read once per run.
  unless run_gate_source&.include?("run_attributed_checks(CHECKS, pre, jobs: jobs, pin: [pin_env, pin_probes])") &&
         attributed_source&.include?("run_checks(checks, root: root, chdir: chdir, **run_opts)") &&
         attributed_source&.include?("report_check_results(failures, checks.size, pre: pre")
    warn "self-test: FAIL — run_gate no longer delegates its check loop and report " \
         "to run_attributed_checks(CHECKS, pre, pin: ...) -> run_checks(..., pin: pin) " \
         "and report_check_results(..., pre: pre); " \
         "the safe, attributed OK/FAILED reporting (cases 7d/7f) could be bypassed " \
         "with no test noticing"
    ok = false
  end
  # ...and the snapshot it hands over is taken BEFORE the first thing that
  # measures the tree (discovery), not somewhere later in the run: case 7f
  # proves a moved tree is refused relative to `pre`, which only means
  # "the tree the checks ran against" if `pre` really is read first.
  snap_at = run_gate_source&.index("pre = gate_start_snapshot(root)")
  discover_at = run_gate_source&.index("discover_self_tests(root)")
  unless snap_at && discover_at && snap_at < discover_at
    warn "self-test: FAIL — run_gate must take `pre = gate_start_snapshot(root)` " \
         "before discover_self_tests(root), the first read of the tree it gates " \
         "(snapshot at #{snap_at.inspect}, discovery at #{discover_at.inspect})"
    ok = false
  end

  # 8. run_one reports PASS/FAIL correctly and closes stdin.
  Dir.mktmpdir("harness-gate-selftest") do |dir|
    passing = File.join(dir, "pass.sh")
    failing = File.join(dir, "fail.sh")
    reads   = File.join(dir, "reads-stdin.sh")
    File.write(passing, "#!/bin/sh\nexit 0\n")
    File.write(failing, "#!/bin/sh\necho boom\nexit 1\n")
    # Exits 0 only if stdin is at EOF -- i.e. the runner closed it rather than
    # leaving the check blocked on a terminal.
    File.write(reads, "#!/bin/sh\nif cat >/dev/null; then exit 0; else exit 1; fi\n")
    [passing, failing, reads].each { |p| FileUtils.chmod(0o755, p) }

    good_ok, = run_one([passing], chdir: dir)
    unless good_ok
      warn "self-test: FAIL — a passing check was reported as FAIL"; ok = false
    end

    bad_ok, bad_out = run_one([failing], chdir: dir)
    if bad_ok
      warn "self-test: FAIL — a failing check was reported as PASS"; ok = false
    end
    unless bad_out.to_s.include?("boom")
      warn "self-test: FAIL — a failing check's output was not captured"; ok = false
    end

    stdin_ok, = run_one([reads], chdir: dir)
    unless stdin_ok
      warn "self-test: FAIL — run_one did not close stdin for the check"; ok = false
    end
  end

  # 8c. The scratch-HOME sentinel (DND-1316) fires through run_one. A fake asdf
  #     `shims/ruby` that dies unless HOME is the gate's is on the check's PATH.
  #     A suite that runs `ruby` through PATH under a scratch HOME, swallows the
  #     shim's exit 126 and exits 0 (DND-1203's vacuous pass) must FAIL with a
  #     Fix:; one that resolves the real binary under the real HOME first, then
  #     uses it under the scratch HOME, must pass.
  Dir.mktmpdir("harness-gate-sentinel-case") do |tmp|
    dir = File.realpath(tmp)
    shims = File.join(dir, "fake-asdf", "shims")
    FileUtils.mkdir_p(shims)
    File.write(File.join(shims, "ruby"),
               "#!/bin/bash\n[ \"$HOME\" = #{ENV.fetch('HOME', '').shellescape} ] || " \
               "{ echo 'No version is set for command ruby' >&2; exit 126; }\nexec #{RbConfig.ruby.shellescape} \"$@\"\n")
    flagged = File.join(dir, "flagged.sh")
    resolved = File.join(dir, "resolved.sh")
    File.write(flagged, "#!/bin/bash\nmkdir -p scratch\nHOME=\"$PWD/scratch\" ruby -e 0 || echo \"shim exit $?\"\nexit 0\n")
    File.write(resolved, "#!/bin/bash\nmkdir -p scratch\nR=\"$(ruby -e 'print RbConfig.ruby')\" || exit 1\n" \
                         "HOME=\"$PWD/scratch\" \"$R\" -e 'puts :booted'\n")
    [File.join(shims, "ruby"), flagged, resolved].each { |p| FileUtils.chmod(0o755, p) }
    env = { "PATH" => "#{shims}:#{ENV.fetch('PATH', '')}" }

    f_ok, f_out = run_one([flagged], chdir: dir, env: env)
    unless !f_ok && f_out.include?("shim exit 126") && f_out.include?("`ruby` with HOME=#{File.join(dir, 'scratch')}") &&
           f_out.include?("DND-1316") && f_out.include?("Fix:")
      warn "self-test: FAIL — case 8c: a suite that ran `ruby` through PATH under a scratch HOME was not " \
           "failed by the sentinel with a Fix: (ok=#{f_ok}): #{f_out.inspect}"
      ok = false
    end
    r_ok, r_out = run_one([resolved], chdir: dir, env: env)
    unless r_ok && r_out.include?("booted")
      warn "self-test: FAIL — case 8c: a suite that resolved the real ruby first was failed: #{r_out.inspect}"
      ok = false
    end

    # A gate HOME the sentinel cannot anchor: the check fails UNRUN, with a Fix:.
    marker = File.join(dir, "ran")
    touch = File.join(dir, "touch.sh")
    File.write(touch, "#!/bin/sh\n: > #{marker.shellescape}\n")
    FileUtils.chmod(0o755, touch)
    s_ok, s_out = with_env("HOME" => "relative-home") { run_one([touch], chdir: dir) }
    unless !s_ok && !File.exist?(marker) && s_out.include?("was not run") && s_out.include?("Fix:")
      warn "self-test: FAIL — case 8c: a relative gate HOME did not fail the check unrun with a Fix: " \
           "(ok=#{s_ok}, ran=#{File.exist?(marker)}): #{s_out.inspect}"
      ok = false
    end

    # A check that deletes its sentinel cannot read as clean.
    wipe = File.join(dir, "wipe.sh")
    File.write(wipe, "#!/bin/sh\nrm -rf \"${PATH%%:*}\"\nexit 0\n")
    FileUtils.chmod(0o755, wipe)
    w_ok, w_out = run_one([wipe], chdir: dir)
    unless !w_ok && w_out.include?("could not be judged") && w_out.include?("Fix:")
      warn "self-test: FAIL — case 8c: a check that deleted its sentinel was not failed as " \
           "could-not-measure (ok=#{w_ok}): #{w_out.inspect}"
      ok = false
    end
  end

  # 8b. stash_fixture_optout_env (DND-775) drops exactly the agent-stash layers:
  #     the injection's count and trace2, and every PATH entry whose `git` is
  #     the agent wrapper (by ATHENA_AGENT_BIN or by the wrapper's own text),
  #     keeping every other entry in order. And only the one declared suite
  #     gets it.
  Dir.mktmpdir("harness-gate-optout") do |dir|
    named   = File.join(dir, "agent-bin")
    unnamed = File.join(dir, "copy")
    plain   = File.join(dir, "plain")
    [named, unnamed, plain].each { |d| FileUtils.mkdir_p(d) }
    File.write(File.join(unnamed, "git"), "#!/bin/sh\n# git (agent wrapper) copy\n")
    File.write(File.join(plain, "git"), "#!/bin/sh\nexec /usr/bin/git \"$@\"\n")
    env = stash_fixture_optout_env([named, "/usr/bin", unnamed, plain, "/bin"].join(":"), named)
    want = { "GIT_CONFIG_COUNT" => nil, "GIT_TRACE2" => nil, "ATHENA_AGENT_BIN" => nil,
             "ATHENA_AGENT_GIT_SEEN" => nil, "PATH" => ["/usr/bin", plain, "/bin"].join(":") }
    unless env == want
      warn "self-test: FAIL — stash_fixture_optout_env gave #{env.inspect}, want #{want.inspect}"; ok = false
    end
  end
  optouts = CHECKS.select { |c| c[2] == :stash_fixture_optout }.map { |c| c[1].first }
  unless optouts == %w[ai/hooks/git-stash-guard.self-test.sh]
    warn "self-test: FAIL — the stash fixture opt-out must apply to the legacy git-stash-guard " \
         "suite alone; it applies to #{optouts.inspect}. Fix: a suite that needs real stash " \
         "entries seeds them with the injection unset inside its own sandbox (see " \
         "ai/test/agent-stash-guard/self-test.sh), it does not get a gate-wide opt-out."
    ok = false
  end

  # 9. The failure report NAMES the failing case even when a chatty suite has
  #    pushed it far beyond the tail. This is the whole point of failure_lines:
  #    a tail-only report of a 119-case suite shows 20 passing cases and a
  #    total, and the reader cannot act on it. Shaped like the real thing — one
  #    buried FAIL line, then well over FAIL_TAIL_LINES lines of `ok` after it.
  buried = (["  FAIL  the case that actually broke"] +
            Array.new(FAIL_TAIL_LINES + 10) { |i| "  ok    case #{i}" } +
            ["118 passed, 1 failed"]).join("\n")
  hits = failure_lines(buried)
  if hits.none? { |l| l.include?("the case that actually broke") }
    warn "self-test: FAIL — failure_lines did not surface a FAIL line buried " \
         "beyond the tail (the gate would report a failure while showing only " \
         "passing lines)"
    ok = false
  end
  # And it must NOT fire on a clean suite, or every green check would print a
  # "failure lines" block (noise that trains the reader to skim past a real one).
  clean = (Array.new(5) { |i| "  ok    case #{i}" } + ["119 passed, 0 failed"]).join("\n")
  unless failure_lines(clean).empty?
    warn "self-test: FAIL — failure_lines matched a clean suite's output " \
         "(#{failure_lines(clean).inspect})"
    ok = false
  end

  # 11 (DND-507). Inline --self-test coverage. A first-party executable that
  #    defines an inline --self-test nobody runs is a suite that cannot go red
  #    (six such tools passed only by inspection; one was red in every
  #    worktree). Driven against throwaway git repos with injected maps, via
  #    the same inline_self_test_coverage run_gate calls.
  Dir.mktmpdir("harness-gate-selftest-inline") do |dir|
    mk_repo = lambda do |name, files|
      root = File.join(dir, name)
      FileUtils.mkdir_p(root)
      Open3.capture3("git", "-c", "init.defaultBranch=main", "init", "-q", root)
      files.each do |rel, (body, mode)|
        path = File.join(root, rel)
        FileUtils.mkdir_p(File.dirname(path))
        File.write(path, body)
        FileUtils.chmod(mode || 0o755, path)
      end
      root
    end
    definer = "#!/bin/sh\ncase \"$1\" in --self-test) exit 0 ;; esac\n"
    cov = lambda do |root, checks: [], delegates: {}, covered_by: {}, exceptions: {}|
      inline_self_test_coverage(root: root, checks: checks, delegates: delegates,
                                covered_by: covered_by, exceptions: exceptions)
    end
    expect = lambda do |cond, msg|
      unless cond
        warn "self-test: FAIL — inline --self-test coverage: #{msg}"
        ok = false
      end
    end

    # 11a. THE REGRESSION: an undeclared inline --self-test is a gap, named.
    red = mk_repo.call("red", "ai/bin/fixture-tool" => [definer])
    r = cov.call(red)
    expect.call(r[:uncovered] == ["ai/bin/fixture-tool"],
                "an undeclared inline --self-test was not reported (uncovered: #{r[:uncovered].inspect})")
    code, _o, err = capture.call { report_inline_self_test_coverage(r) }
    expect.call(code == 1, "report returned #{code.inspect} for an uncovered tool, expected 1")
    expect.call(err.include?("ai/bin/fixture-tool") && err.include?("Fix:"),
                "the failure did not name the tool with a Fix: line (stderr: #{err.inspect})")

    # 11b. Each way of accounting for it clears the gap.
    r = cov.call(red, checks: [["t", %w[ai/bin/fixture-tool --self-test]]])
    expect.call(r[:uncovered].empty? && !failed_inline_coverage?(r), "a STATIC_CHECKS declaration did not cover the tool")
    r = cov.call(red, exceptions: { "ai/bin/fixture-tool" => "model-in-loop: calls claude, never gate-safe" })
    expect.call(r[:uncovered].empty? && !failed_inline_coverage?(r), "a reasoned exception did not cover the tool")
    # 11b2 (DND-1007). Distinct group argvs of one tool are one tool accounted
    #      once; the SAME argv declared twice runs one suite twice, an error.
    groups = [["g1", %w[ai/bin/fixture-tool --self-test --group a]],
              ["g2", %w[ai/bin/fixture-tool --self-test --group b]]]
    r = cov.call(red, checks: groups)
    expect.call(r[:uncovered].empty? && !failed_inline_coverage?(r),
                "two distinct --group declarations of one tool were refused (#{r.inspect})")
    r = cov.call(red, checks: [["t1", %w[ai/bin/fixture-tool --self-test]],
                               ["t2", %w[ai/bin/fixture-tool --self-test]]])
    expect.call(failed_inline_coverage?(r),
                "the same --self-test argv declared twice was not an error (#{r.inspect})")

    # 11c. Comment-only and near-miss mentions do not make a tool a definer;
    #      test suites are never candidates.
    quiet = mk_repo.call("quiet",
                         "ai/bin/commenter" => ["#!/bin/sh\n# see other --self-test\nexit 0\n"],
                         "ai/bin/near-miss" => ["#!/bin/sh\necho --self-tests --self-test-case\n"],
                         "ai/bin/real" => [definer],
                         "scripts/test/x/self-test.sh" => ["#!/bin/sh\nfoo --self-test\n"],
                         "ai/hooks/h.self-test.sh" => ["#!/bin/sh\nfoo --self-test\n"])
    r = cov.call(quiet)
    expect.call(r[:candidates] == ["ai/bin/real"],
                "candidates should be exactly the one definer, got #{r[:candidates].inspect}")

    # 11d. THE MISS: an empty discovery set, a non-git root, and a set with no
    #      definer at all are measurement failures, never a quiet pass.
    empty = mk_repo.call("empty", {})
    [["an empty discovery set", empty],
     ["a non-git root", File.join(dir, "nowhere")],
     ["zero definers", mk_repo.call("nodef", "ai/bin/plain" => ["#!/bin/sh\nexit 0\n"])]].each do |why, root|
      begin
        cov.call(root)
        expect.call(false, "#{why} did not raise FirstParty::MeasureError")
      rescue FirstParty::MeasureError
        nil
      end
    end
    code, _o, err = capture.call { run_inline_self_test_coverage(empty) }
    expect.call(code == 1 && err.include?("Fix:"),
                "an empty discovery set did not fail with a Fix: line (code #{code.inspect})")

    # 11e. Bookkeeping cannot rot: an entry whose file vanished (or no longer
    #      defines --self-test) is stale; a short reason is refused; a tool in
    #      two maps is refused; a covering check that is not in CHECKS is
    #      refused; an uncorroborated covered_by entry is refused.
    r = cov.call(red, exceptions: { "ai/bin/fixture-tool" => "model-in-loop: calls claude, never gate-safe",
                                    "ai/bin/gone" => "was a real tool with a real reason once" })
    expect.call(r[:stale] == ["ai/bin/gone"], "a vanished exception entry was not stale (#{r[:stale].inspect})")
    r = cov.call(red, exceptions: { "ai/bin/fixture-tool" => "slow" })
    expect.call(failed_inline_coverage?(r) && r[:errors].any? { |e| e.include?("reason") },
                "a too-short exception reason was accepted")
    r = cov.call(red, checks: [["t", %w[ai/bin/fixture-tool --self-test]]],
                      exceptions: { "ai/bin/fixture-tool" => "model-in-loop: calls claude, never gate-safe" })
    expect.call(r[:errors].any? { |e| e.include?("more than one") }, "a tool accounted for twice was accepted")

    pair = mk_repo.call("pair",
                        "ai/bin/execs" => ["#!/bin/sh\ncase \"$1\" in --self-test) exec \"$HERE/../test/execs/self-test.sh\" ;; esac\n"],
                        "ai/test/execs/self-test.sh" => ["#!/bin/sh\nexit 0\n"],
                        "ai/bin/driven" => [definer],
                        "ai/test/driven/self-test.sh" => ["#!/bin/sh\nexec \"$here/../../bin/driven\" --self-test\n"],
                        "ai/bin/liar" => [definer],
                        "ai/test/other/self-test.sh" => ["#!/bin/sh\nexit 0\n"])
    suites = [["s1", %w[ai/test/execs/self-test.sh]], ["s2", %w[ai/test/driven/self-test.sh]],
              ["s3", %w[ai/test/other/self-test.sh]]]
    r = cov.call(pair, checks: suites,
                       covered_by: { "ai/bin/execs" => "ai/test/execs/self-test.sh",
                                     "ai/bin/driven" => "ai/test/driven/self-test.sh",
                                     "ai/bin/liar" => "ai/test/other/self-test.sh" })
    expect.call(r[:uncorroborated] == ["ai/bin/liar"],
                "covered_by corroboration wrong: want only ai/bin/liar refused, got #{r[:uncorroborated].inspect}")
    r = cov.call(pair, checks: [],
                       covered_by: { "ai/bin/execs" => "ai/test/execs/self-test.sh" },
                       exceptions: { "ai/bin/driven" => "fixture: accounted elsewhere for this case",
                                     "ai/bin/liar" => "fixture: accounted elsewhere for this case" })
    expect.call(r[:errors].any? { |e| e.include?("not a check the gate runs") },
                "a covered_by entry pointing at a check the gate does not run was accepted")
  end

  # 11f. The REAL repo: the live maps account for every inline --self-test.
  #      (The gate enforces this too; asserting it here keeps --self-test red
  #      whenever a map entry goes stale.)
  begin
    live = inline_self_test_coverage(root: CUSTOM_DIR)
    if failed_inline_coverage?(live)
      warn "self-test: FAIL — the live repo has inline --self-test gaps; run ai/bin/harness-gate for the named list"
      ok = false
    end
  rescue FirstParty::MeasureError => e
    warn "self-test: FAIL — could not measure inline --self-test coverage of the live repo: #{e.message}"
    ok = false
  end

  # 12 (DND-735). The landed ref is read ONCE per gate run and handed to every
  #    check. Before this, each landed-ref check ran its own `git ls-remote`,
  #    so a push to origin mid-run reddened all of them. Driven against a
  #    fixture repo with a bare origin: the pin names origin's main and this
  #    repository, run_one hands it to the check, a pinned run survives origin
  #    moving, and the move is reported as its own named NOTE.
  Dir.mktmpdir("harness-gate-selftest-pin") do |dir|
    expect = lambda do |cond, msg|
      unless cond
        warn "self-test: FAIL — landed-ref pin (DND-735): #{msg}"
        ok = false
      end
    end
    git = lambda do |*args, chdir: dir|
      out, _e, st = Open3.capture3({ "GIT_AUTHOR_NAME" => "t", "GIT_AUTHOR_EMAIL" => "t@t",
                                     "GIT_COMMITTER_NAME" => "t", "GIT_COMMITTER_EMAIL" => "t@t" },
                                   "git", *args, chdir: chdir)
      [out.strip, st.success?]
    end
    origin = File.join(dir, "origin.git")
    root = File.join(dir, "repo")
    other = File.join(dir, "other")
    git.call("-c", "init.defaultBranch=main", "init", "-q", "--bare", origin)
    git.call("-c", "init.defaultBranch=main", "init", "-q", root)
    git.call("-C", root, "commit", "-q", "--allow-empty", "-m", "landed")
    git.call("-C", root, "remote", "add", "origin", origin)
    git.call("-C", root, "push", "-q", "origin", "HEAD:refs/heads/main")
    git.call("-C", root, "fetch", "-q", "origin")
    p_sha, = git.call("-C", root, "rev-parse", "HEAD")

    env, probes = landed_pin_env(root)
    expect.call(env[Landed::PIN_SHA_ENV] == p_sha && probes.nil?,
                "the pin is not origin's main (#{env.inspect}, probes #{probes.inspect})")
    expect.call(env[Landed::PIN_REPO_ENV] == File.realpath(File.join(root, ".git")),
                "the pin is not keyed to the repository's git common dir (#{env.inspect})")
    expect.call(landed_moved_note(root, env).nil?, "a NOTE was printed although origin did not move")

    # run_one hands the pin to the check.
    echo = File.join(dir, "echo-pin.sh")
    File.write(echo, "#!/bin/sh\necho \"pin=${#{Landed::PIN_SHA_ENV}}\"\n")
    FileUtils.chmod(0o755, echo)
    _ok, out = run_one([echo], chdir: dir, env: env)
    expect.call(out.include?("pin=#{p_sha}"), "run_one did not hand the pin to the check (#{out.inspect})")

    # 12b. The gate's OWN check loop (run_checks, the loop run_gate runs) hands
    #      every check the pin the gate read itself, never one it inherited.
    #      The caller exports a well-formed but wrong pin; the check records
    #      what it sees. Dropping `env: pin_env` from run_checks, or replacing
    #      its landed_pin_env read, leaves the check seeing the bogus pin.
    seen = File.join(dir, "seen-pin")
    record = File.join(dir, "record-pin.sh")
    File.write(record, "#!/bin/sh\nprintf 'sha=%s repo=%s\\n' " \
                       "\"${#{Landed::PIN_SHA_ENV}}\" \"${#{Landed::PIN_REPO_ENV}}\" > \"#{seen}\"\n")
    FileUtils.chmod(0o755, record)
    bogus = { Landed::PIN_SHA_ENV => "b" * 40, Landed::PIN_REPO_ENV => File.join(dir, "inherited.git") }
    loop_io = StringIO.new
    loop_env, loop_failures = with_env(bogus) do
      run_checks([["record-pin", [record]]], root: root, chdir: dir, io: loop_io,
                 timings: File.join(dir, "timings.jsonl"))
    end
    saw = File.exist?(seen) ? File.read(seen).strip : "(the check never ran)"
    want = "sha=#{p_sha} repo=#{File.realpath(File.join(root, '.git'))}"
    expect.call(saw == want,
                "a check run by the gate's loop saw #{saw.inspect}, not the gate's own pin #{want.inspect} " \
                "(the caller exported #{bogus.inspect})")
    expect.call(loop_env == env && loop_failures.empty? && loop_io.string.include?(p_sha[0, 12]),
                "run_checks did not return and print its own pin (#{loop_env.inspect}, " \
                "#{loop_failures.inspect}, #{loop_io.string.inspect})")

    # THE DEFECT: origin moves after the pin. A pinned check still measures P;
    # the gate names the move once.
    git.call("clone", "-q", "-b", "main", origin, other)
    git.call("-C", other, "commit", "-q", "--allow-empty", "-m", "elsewhere")
    git.call("-C", other, "push", "-q", "origin", "HEAD:refs/heads/main")
    q_sha, = git.call("-C", other, "rev-parse", "HEAD")
    pts_ok = begin
      with_env(env) { Landed.points(root) }
      true
    rescue Landed::Mismatch, Landed::Unreadable => e
      warn "  (pinned Landed.points raised #{e.class}: #{e.message})"
      false
    end
    expect.call(pts_ok, "a pinned landed-ref read failed after origin moved mid-run")
    note = landed_moved_note(root, env).to_s
    expect.call(note.include?(p_sha[0, 12]) && note.include?(q_sha[0, 12]) && note.include?("moved"),
                "the mid-run move was not named with both SHAs (#{note.inspect})")

    # An unreadable origin at gate start: the pin is CLEARED (never inherited),
    # and the probes say why.
    git.call("-C", root, "remote", "set-url", "origin", File.join(dir, "no-such.git"))
    env2, probes2 = with_env(env) { landed_pin_env(root) }
    expect.call(env2.key?(Landed::PIN_SHA_ENV) && env2[Landed::PIN_SHA_ENV].nil? &&
                env2.key?(Landed::PIN_REPO_ENV) && env2[Landed::PIN_REPO_ENV].nil? && probes2&.any?,
                "an unreadable origin did not clear the pin with probes (#{env2.inspect}, #{probes2.inspect})")

    # 12c. The same loop with origin unreadable: the inherited pin is CLEARED
    #      for the check, not passed through.
    File.delete(seen) if File.exist?(seen)
    with_env(bogus) do
      run_checks([["record-pin", [record]]], root: root, chdir: dir, io: StringIO.new,
                 timings: File.join(dir, "timings.jsonl"))
    end
    saw = File.exist?(seen) ? File.read(seen).strip : "(the check never ran)"
    expect.call(saw == "sha= repo=",
                "with origin unreadable, a check run by the gate's loop saw #{saw.inspect}; " \
                "the inherited pin must be cleared, not passed through")
  end

  # 13 (DND-945). Origin freshness is checked BEFORE any check runs, not
  #    discovered as a Landed::Mismatch by whichever landed-ref check happens
  #    to run 10+ minutes into the gate (DND-876: a stale local origin/main
  #    failed 7 checks at the END of a run; a fetch and re-run of the SAME
  #    head passed 96/96). Driven against fixture repos with a bare origin, no
  #    real network. Three outcomes, and they must print TEXTUALLY DISTINCT
  #    lines (CLAUDE.md -> "A failed lookup must never look like an empty
  #    one"): fresh, stale (fails fast with a Fix:), and unreadable (proceeds,
  #    never a silent pass-alike).
  Dir.mktmpdir("harness-gate-selftest-freshness") do |dir|
    expect = lambda do |cond, msg|
      unless cond
        warn "self-test: FAIL — origin freshness (DND-945): #{msg}"
        ok = false
      end
    end
    git = lambda do |*args, chdir: dir|
      out, _e, st = Open3.capture3({ "GIT_AUTHOR_NAME" => "t", "GIT_AUTHOR_EMAIL" => "t@t",
                                     "GIT_COMMITTER_NAME" => "t", "GIT_COMMITTER_EMAIL" => "t@t" },
                                   "git", *args, chdir: chdir)
      [out.strip, st.success?]
    end
    origin = File.join(dir, "origin.git")
    root = File.join(dir, "repo")
    other = File.join(dir, "other")
    git.call("-c", "init.defaultBranch=main", "init", "-q", "--bare", origin)
    git.call("-c", "init.defaultBranch=main", "init", "-q", root)
    git.call("-C", root, "commit", "-q", "--allow-empty", "-m", "landed")
    git.call("-C", root, "remote", "add", "origin", origin)
    git.call("-C", root, "push", "-q", "origin", "HEAD:refs/heads/main")
    git.call("-C", root, "fetch", "-q", "origin")
    a_sha, = git.call("-C", root, "rev-parse", "HEAD")

    # FRESH: local refs/remotes/origin/main already is what origin reports.
    env, probes = landed_pin_env(root)
    result = origin_freshness(root, env, probes)
    expect.call(result == [:fresh, a_sha], "expected [:fresh, #{a_sha.inspect}], got #{result.inspect}")
    code, out, err = capture.call { report_origin_freshness(result) }
    expect.call(code == true && out.include?("OK") && err.empty?,
                "fresh must print an OK line on stdout and proceed (code #{code.inspect}, " \
                "out #{out.inspect}, err #{err.inspect})")
    fresh_out = out

    # STALE: origin moves (another clone pushes) but root never fetches, so
    # its local refs/remotes/origin/main is now behind what ls-remote reports.
    git.call("clone", "-q", "-b", "main", origin, other)
    git.call("-C", other, "commit", "-q", "--allow-empty", "-m", "elsewhere")
    git.call("-C", other, "push", "-q", "origin", "HEAD:refs/heads/main")
    b_sha, = git.call("-C", other, "rev-parse", "HEAD")
    env2, probes2 = landed_pin_env(root)
    result2 = origin_freshness(root, env2, probes2)
    expect.call(result2 == [:stale, a_sha, b_sha], "expected [:stale, #{a_sha.inspect}, #{b_sha.inspect}], got #{result2.inspect}")
    code2, out2, err2 = capture.call { report_origin_freshness(result2) }
    expect.call(code2 == false, "a stale local ref must return false (do not proceed), got #{code2.inspect}")
    expect.call(out2.empty?, "a stale result must print nothing on stdout, got #{out2.inspect}")
    expect.call(err2.include?("stale") && err2.include?("Fix:") && err2.include?("git fetch origin"),
                "a stale result must FAIL with a Fix: naming `git fetch origin` (stderr #{err2.inspect})")
    expect.call(err2 != fresh_out && !err2.include?("OK"),
                "the stale FAIL line must be textually distinct from the fresh OK line")

    # UNREADABLE: origin cannot be reached at all (bad remote URL, never real
    # network) -> "could not verify", and it PROCEEDS rather than failing.
    git.call("-C", root, "remote", "set-url", "origin", File.join(dir, "no-such.git"))
    env3, probes3 = landed_pin_env(root)
    result3 = origin_freshness(root, env3, probes3)
    expect.call(result3[0] == :unknown && result3[1].to_s.length.positive?,
                "expected [:unknown, <non-empty reason>], got #{result3.inspect}")
    code3, out3, err3 = capture.call { report_origin_freshness(result3) }
    expect.call(code3 == true, "an unreadable origin must proceed (never fail CI/sandbox), got #{code3.inspect}")
    expect.call(err3.empty?, "an unreadable-origin result must never print to stderr (it is not a failure), got #{err3.inspect}")
    expect.call(out3.include?("could not verify origin freshness"),
                "an unreadable origin must say so on stdout (out #{out3.inspect})")
    expect.call(out3 != fresh_out && !out3.include?(" OK "),
                "the could-not-verify NOTE must be textually distinct from the fresh OK line " \
                "(out #{out3.inspect} vs fresh #{fresh_out.inspect})")

    # 13b (DND-945). THE REAL ENTRY PATH, not these helpers directly: a
    #     critic-review round on this Mission's earlier commit correctly
    #     rejected "call origin_freshness/report_origin_freshness by hand" as
    #     proof, because it never proves run_gate's OWN CLI dispatch actually
    #     wires the preflight in ahead of everything else. So this drives the
    #     REAL, unmodified `ai/bin/harness-gate` binary as a subprocess
    #     (`ruby <fixture>/ai/bin/harness-gate`, no flags -- the exact
    #     invocation a captain types) against a minimal fixture: just the
    #     currently-running script itself (copied via __FILE__, so this
    #     always tests whatever code is actually present) plus every file it
    #     require_relative's (transitively), and one dummy self-test.sh to clear
    #     the zero-discovery guard. That is enough, because the freshness
    #     preflight runs BEFORE inline-self-test-coverage/missing_executables/
    #     run_checks -- a stale (or fresh, or unreadable) verdict is reached
    #     without any of CHECKS' real files needing to exist.
    fixture = File.join(dir, "fixture")
    FileUtils.mkdir_p(File.join(fixture, "ai/bin"))
    FileUtils.mkdir_p(File.join(fixture, "ai/lib"))
    FileUtils.mkdir_p(File.join(fixture, "some/test"))
    FileUtils.cp(File.expand_path(__FILE__), File.join(fixture, "ai/bin/harness-gate"))
    FileUtils.chmod(0o755, File.join(fixture, "ai/bin/harness-gate"))
    # Every file the script require_relative's, followed transitively, read
    # from the sources themselves: a hand-kept list went stale the day
    # DND-818 added ai/lib/reap_tags.rb, and the fixture died on LoadError.
    lib_deps = []
    pending = [File.expand_path(__FILE__)]
    until pending.empty?
      src = pending.shift
      File.read(src).scan(/^\s*require_relative\s+["']([^"']+)["']/).flatten.each do |rel|
        dep = File.expand_path(rel.end_with?(".rb") ? rel : "#{rel}.rb", File.dirname(src))
        next if lib_deps.include?(dep)

        lib_deps << dep
        pending << dep
      end
    end
    expect.call(lib_deps.any? { |d| d.end_with?("/ai/lib/landed.rb") },
                "the require_relative scan found no ai/lib/landed.rb (found #{lib_deps.inspect}); " \
                "the fixture copy list is wrong")
    lib_deps.each do |dep|
      rel = dep.delete_prefix("#{CUSTOM_DIR}/")
      FileUtils.mkdir_p(File.dirname(File.join(fixture, rel)))
      FileUtils.cp(dep, File.join(fixture, rel))
    end
    File.write(File.join(fixture, "some/test/self-test.sh"), "#!/bin/sh\nexit 0\n")
    FileUtils.chmod(0o755, File.join(fixture, "some/test/self-test.sh"))
    git.call("-c", "init.defaultBranch=main", "init", "-q", fixture)
    git.call("-C", fixture, "add", "-A")
    git.call("-C", fixture, "commit", "-q", "-m", "fixture")

    f_origin = File.join(dir, "f-origin.git")
    f_other = File.join(dir, "f-other")
    git.call("-c", "init.defaultBranch=main", "init", "-q", "--bare", f_origin)
    git.call("-C", fixture, "remote", "add", "origin", f_origin)
    git.call("-C", fixture, "push", "-q", "origin", "HEAD:refs/heads/main")
    git.call("-C", fixture, "fetch", "-q", "origin")

    run_fixture = lambda { Open3.capture3(RbConfig.ruby, File.join(fixture, "ai/bin/harness-gate"), chdir: fixture) }

    # FRESH, through the real subprocess: must print the OK line and proceed
    # PAST the gate. It will fail LATER, for an unrelated and EXPECTED reason
    # in this minimal fixture (inline --self-test coverage has nothing real to
    # measure) -- the claim under test is only "did not stop at the gate".
    fout, = run_fixture.call
    expect.call(fout.include?("origin freshness OK"),
                "the real `ai/bin/harness-gate` subprocess (fresh) must print the OK line " \
                "(stdout #{fout.inspect})")
    # 13c (DND-945 x DND-896). The two pre-run steps compose in a fixed
    # order: the tree snapshot (`pre`) first, then this preflight. The
    # snapshot must precede every read of the tree; the preflight reads only
    # origin and refs/remotes/origin/main (see run_gate). Asserted on the
    # real binary's output, not its source.
    snap_line = fout.index("harness-gate: checks run against [tree ")
    fresh_line = fout.index("origin freshness OK")
    expect.call(snap_line && fresh_line && snap_line < fresh_line,
                "the real subprocess must print its tree snapshot (\"checks run against\") " \
                "BEFORE the origin-freshness line (stdout #{fout.inspect})")

    # STALE, through the real subprocess: advance f-origin from a second
    # clone, without ever fetching in `fixture` -- same shape as the unit
    # tests above, but this time run_gate's own CLI dispatch is what runs,
    # never origin_freshness/report_origin_freshness directly.
    git.call("clone", "-q", "-b", "main", f_origin, f_other)
    git.call("-C", f_other, "commit", "-q", "--allow-empty", "-m", "elsewhere")
    git.call("-C", f_other, "push", "-q", "origin", "HEAD:refs/heads/main")
    started = Time.now
    sout, serr, sstatus = run_fixture.call
    elapsed = Time.now - started
    expect.call(sstatus.exitstatus == ORIGIN_STALE_EXIT,
                "the real subprocess must exit ORIGIN_STALE_EXIT=#{ORIGIN_STALE_EXIT} on a stale " \
                "local origin/main, got #{sstatus.exitstatus} (stdout #{sout.inspect}, stderr #{serr.inspect})")
    expect.call(elapsed < 10,
                "the real subprocess must fail FAST (seconds, not minutes) on a stale local " \
                "origin/main -- took #{elapsed.round(2)}s")
    expect.call(serr.include?("FAILED") && serr.include?("stale") && serr.include?("Fix:") &&
                serr.include?("git fetch origin"),
                "the real subprocess's stderr must FAIL with a Fix: naming `git fetch origin` " \
                "(stderr #{serr.inspect})")
    expect.call(sout.include?("harness-gate: checks run against [tree "),
                "a stale result must still come AFTER the tree snapshot (13c's order); the " \
                "snapshot line is missing (stdout #{sout.inspect})")
    expect.call(!sout.include?("landed ref pinned"),
                "a stale result must return BEFORE run_checks's own pin-announcement line -- " \
                "it must never reach the check loop at all (stdout #{sout.inspect})")
  end

  # 10 (DND-404). check-inbox-mock-orphans's REAP invocation (FINAL_CHECKS)
  #    must stay the LAST entry in CHECKS — it backstops
  #    scripts/test/inbox-client-capture's self-test, so it must run after
  #    that suite (and after every other check). Nothing else enforces the
  #    concatenation order; a future refactor of the CHECKS assignment could
  #    silently move it earlier with no other symptom, so assert it directly.
  unless CHECKS.last == ["check-inbox-mock-orphans", %w[ai/bin/check-inbox-mock-orphans]]
    warn "self-test: FAIL — check-inbox-mock-orphans is not the LAST entry in " \
         "CHECKS (currently: #{CHECKS.last.inspect}). Fix: keep " \
         "`STATIC_CHECKS + self_test_checks + FINAL_CHECKS`, in that order, in " \
         "the CHECKS assignment — FINAL_CHECKS must be concatenated last."
    ok = false
  end

  # 12 (DND-526). Every argument must be a declared flag. A typo of --list or
  #    --self-test used to fall through to the full gate run. Black-box only
  #    beside --list (read-only and fast even on the old parser, which ran the
  #    listing); every other shape in-process, because the old parser would
  #    run the whole gate — or this self-test, recursively.
  [[%w[--list --bogus], "--bogus"], [%w[--list stray], "stray"]].each do |args, named|
    out, err, st = Open3.capture3(RbConfig.ruby, File.expand_path(__FILE__), *args, stdin_data: "")
    next if st.exitstatus == 2 && err.include?(named) && err.include?("Fix:") && out.empty?

    warn "self-test: FAIL — `harness-gate #{args.join(' ')}` must exit 2 naming #{named} with a Fix: " \
         "and print nothing on stdout (got exit #{st.exitstatus}, stderr #{err[0, 120].inspect})"
    ok = false
  end
  { %w[--lsit] => "--lsit", %w[--self-tset] => "--self-tset", %w[--list=1] => "--list=",
    %w[--list --list] => "--list", %w[--self-test --list] => "--list",
    %w[--list --self-test] => "--list" }.each do |args, named|
    _o, reason = parse_cli(args)
    next if reason.to_s.include?(named)

    warn "self-test: FAIL — parse_cli(#{args.inspect}) must be a usage error naming #{named}, got #{reason.inspect}"
    ok = false
  end
  { [] => :gate, %w[--list] => :list, %w[--self-test] => :self_test }.each do |args, want|
    o, reason = parse_cli(args)
    next if reason.nil? && gate_mode(o) == want

    warn "self-test: FAIL — parse_cli(#{args.inspect}) must accept and select #{want}, got #{reason.inspect}"
    ok = false
  end

  # 13 (lead time). The parallel loop keeps every guarantee of the serial one.
  #    A fixture drives run_checks on 4 workers:
  #    - every check runs, exactly once;
  #    - one red check fails the run and is reported, in declared order;
  #    - the pre-pool check sees no sibling running, the chained pair keeps its
  #      order, and the final check sees every other check done;
  #    - four checks ran at once: each waits at a barrier until all four have
  #      started, so none can finish unless all four were in flight together
  #      (proof it is parallel at all, whatever the machine's speed; DND-1007
  #      replaced four `sleep 1` checks timed against `elapsed < 3.0`);
  #    - each check's wall time is printed and recorded.
  #    And the barrier discriminates: run one check at a time, two barrier
  #    checks can never both have started, so both FAIL.
  # barrier_body(started, names, done_mark, polls) -- a check body that waits
  # until every one of `names` has a start mark, then marks itself done. The
  # poll count only caps a hang: a correct parallel run opens the barrier as
  # soon as the last check starts, and a serial run can never open it.
  barrier_body = lambda do |started_dir, names, done_mark, polls|
    all = names.map { |n| "[ -e #{File.join(started_dir, n).shellescape} ]" }.join(" && ")
    "i=0; until #{all}; do i=$((i + 1)); if [ \"$i\" -ge #{polls} ]; then " \
      "echo 'FAIL: barrier: not every check in #{names.join(' ')} started (the pool is not running them at once)'; " \
      "exit 1; fi; sleep 0.05; done; touch #{done_mark.shellescape}"
  end
  Dir.mktmpdir("harness-gate-par") do |dir|
    done = File.join(dir, "done")
    started = File.join(dir, "started")
    FileUtils.mkdir_p([done, started])
    mk = lambda do |name, body|
      path = File.join(dir, "#{name}.sh")
      File.write(path, "#!/bin/sh\ntouch #{started.shellescape}/#{name}\n#{body}\n")
      FileUtils.chmod(0o755, path)
      [path]
    end
    count = "ls #{done.shellescape} | wc -l | tr -d ' '"
    slow = %w[s1 s2 s3 s4]
    # 1200 polls of 0.05 s: a cap of a minute or more, only ever reached by a hang.
    fixture = [
      ["check-inotify-headroom", mk.call("pre", "sleep 0.3; ls #{started.shellescape} | grep -vx pre | wc -l | tr -d ' ' > #{dir}/pre-saw")],
      ["build-agents --check", mk.call("build", "sleep 0.3; touch #{dir}/built; touch #{done}/build")],
      ["check-agent-size", mk.call("size", "[ -f #{dir}/built ] || exit 1; touch #{done}/size")],
      *slow.each_with_index.map do |s, i|
        ["slow-#{i + 1}", mk.call(s, barrier_body.call(started, slow, File.join(done, s), 1200))]
      end,
      ["red-one", mk.call("red", "echo 'FAIL: fixture case'; touch #{done}/red; exit 1")],
      ["check-inbox-mock-orphans", mk.call("final", "echo $(#{count}) > #{dir}/final-saw")],
    ]
    io = StringIO.new
    timings = File.join(dir, "timings.jsonl")
    _env, failures = run_checks(fixture, root: dir, chdir: dir, io: io, jobs: 4, timings: timings)
    ran = Dir.children(done).sort
    want_ran = %w[build red s1 s2 s3 s4 size]
    lines = io.string.lines.grep(%r{\s(PASS|FAIL)\s+\d+\.\d+s wall\s+(\d+\.\d+s|n/a) cpu$}).map { |l| l.split.first }
    rows = File.exist?(timings) ? File.readlines(timings).map { |l| JSON.parse(l) } : []
    checks13 = {
      "every pooled check ran once (#{ran.inspect})" => ran == want_ran,
      "exactly the red check failed (#{failures.map(&:first).inspect})" => failures.map(&:first) == ["red-one"],
      "check-agent-size ran after build-agents --check" => failures.none? { |f| f.first == "check-agent-size" },
      "the pre-pool check saw no other check started" => File.read(File.join(dir, "pre-saw")).strip == "0",
      "the final check saw all #{want_ran.size} done" =>
        File.read(File.join(dir, "final-saw")).strip == want_ran.size.to_s,
      "all four barrier checks passed, so all four were in flight at once" =>
        (slow - ran).empty? && failures.none? { |f| f.first.start_with?("slow-") },
      "results printed in declared order with times (#{lines.inspect})" =>
        lines == fixture.map { |(l, _)| l.split.first },
      "one timing row per check (#{rows.size})" =>
        rows.map { |r| r["label"] }.sort == fixture.map(&:first).sort && rows.all? { |r| r["wall_s"].is_a?(Numeric) },
      "every timing row has a measured cpu_s (#{rows.map { |r| r['cpu_s'] }.inspect})" =>
        !rows.empty? && rows.all? { |r| r["cpu_s"].is_a?(Numeric) },
      "every result line carries a measured cpu figure" =>
        io.string.lines.grep(/\s(PASS|FAIL)\s+\d/).none? { |l| l.include?("n/a cpu") },
    }
    checks13.each do |what, good|
      next if good

      warn "self-test: FAIL — case 13 (parallel loop): #{what}. Fix: keep run_checks' pre-pool / " \
           "CHAINS / FINAL_CHECKS edges, declared-order output, and per-check timing rows."
      ok = false
    end
  end
  # The barrier's negative: one worker runs the two checks one after the
  # other, so the first can never see the second start. Its small poll cap
  # is safe HERE only because no amount of time lets a serial run pass.
  Dir.mktmpdir("harness-gate-par-serial") do |dir|
    started = File.join(dir, "started")
    FileUtils.mkdir_p(started)
    pair = %w[b1 b2]
    fixture = pair.map do |n|
      path = File.join(dir, "#{n}.sh")
      File.write(path, "#!/bin/sh\ntouch #{started.shellescape}/#{n}\n" \
                       "#{barrier_body.call(started, pair, File.join(dir, "#{n}.done"), 4)}\n")
      FileUtils.chmod(0o755, path)
      ["barrier-#{n}", [path]]
    end
    _env, failures = run_checks(fixture, root: dir, chdir: dir, io: StringIO.new, jobs: 1, timings: File::NULL)
    unless failures.map(&:first) == %w[barrier-b1] &&
           failures.first[2].to_s.include?("FAIL: barrier: not every check")
      warn "self-test: FAIL — case 13 (parallel loop): with one worker the first of two barrier checks " \
           "must FAIL at the barrier (the second starts only after it ends), got " \
           "#{failures.map { |f| [f[0], f[2].to_s[0, 80]] }.inspect}. Fix: the barrier fixture must pass " \
           "only when its checks overlap; restore barrier_body's wait on every start mark."
      ok = false
    end
  end

  # 13d (DND-1007). The gate's own suite runs as independent groups, and
  # every case runs in exactly one of them, once per gate:
  #   - HARNESS_GATE_SELF_TEST_GROUPS is core, reap, then one delegate group
  #     per SELF_TEST_DELEGATES entry, each named once;
  #   - CHECKS declares each group exactly once, and never the plain
  #     `--self-test` (which runs every group, so the cases would run twice);
  #   - case 4b's body lives only in self_test_delegate and case 13
  #     (DND-818)'s only in self_test_reap, never also in self_test_core;
  #   - --group is accepted for every group and refused for anything else.
  want_groups = %w[core reap] + SELF_TEST_DELEGATES.keys.map { |s| self_test_delegate_group(s) }
  gate_suites = CHECKS.select { |(_, argv)| argv.first == "ai/bin/harness-gate" }.map { |(_, argv)| argv.drop(1) }
  src = File.read(__FILE__)
  body = ->(name) { src[/^def #{name}\b.*?^end$/m].to_s }
  # Built, not written out, so these assertions do not match themselves.
  reap_mark = ["per-check reap", "(DND-818)"].join(" ")
  checks13d = {
    "the groups are core, reap and one per delegate, each once (#{HARNESS_GATE_SELF_TEST_GROUPS.inspect})" =>
      HARNESS_GATE_SELF_TEST_GROUPS == want_groups && want_groups.uniq == want_groups,
    "CHECKS runs each group once and never the plain --self-test (#{gate_suites.inspect})" =>
      gate_suites == want_groups.map { |g| ["--self-test", "--group", g] },
    "case 4b is only in self_test_delegate" =>
      body.call("self_test_delegate").include?("SELF_TEST_DELEGATES[#{'#'}{script.inspect}]") &&
      !body.call("self_test_core").include?("SELF_TEST_DELEGATES[#{'#'}{script.inspect}]"),
    "case 13 (DND-818) is only in self_test_reap" =>
      body.call("self_test_reap").include?(reap_mark) && !body.call("self_test_core").include?(reap_mark),
    "--group accepts every group" =>
      want_groups.all? { |g| parse_cli(["--self-test", "--group", g])[1].nil? },
    "--group refuses an unknown group and a --group without --self-test" =>
      parse_cli(%w[--self-test --group nope])[1].to_s.include?("nope") &&
      parse_cli(%w[--group core])[1].to_s.include?("--self-test"),
  }
  checks13d.each do |what, good|
    next if good

    warn "self-test: FAIL — case 13d (self-test groups): #{what}. Fix: keep HARNESS_GATE_SELF_TEST_GROUPS, " \
         "the STATIC_CHECKS entries built from it, and each case's body in exactly one group method."
    ok = false
  end

  # 13b. The schedule is keyed by label, so the real CHECKS must have unique
  #     labels and must name every label an ordering edge uses. A fixture with
  #     a duplicate and a renamed edge must be refused, and run_checks itself
  #     must refuse a duplicate rather than let one result overwrite another.
  unless (errs = schedule_errors(CHECKS)).empty?
    warn "self-test: FAIL — case 13b: the real CHECKS schedule is unsound: #{errs.join('; ')}"
    ok = false
  end
  bad_schedule = [["a", ["x"]], ["a", ["y"]], ["check-agent-size", ["z"]]]
  errs = schedule_errors(bad_schedule)
  unless errs.any? { |e| e.include?('"a" is declared 2 times') } &&
         errs.any? { |e| e.include?('"build-agents --check"') } &&
         errs.any? { |e| e.include?('"check-inotify-headroom"') }
    warn "self-test: FAIL — case 13b: schedule_errors missed a duplicate or a renamed edge: #{errs.inspect}"
    ok = false
  end
  begin
    run_checks(bad_schedule, root: Dir.tmpdir, chdir: Dir.tmpdir, io: StringIO.new, jobs: 1,
                             timings: File::NULL)
    warn "self-test: FAIL — case 13b: run_checks accepted a duplicate label"
    ok = false
  rescue ArgumentError
    nil
  end

  # 13c. A CHECKS entry's third element (DND-775's :stash_fixture_optout) is
  #     applied on every path the loop schedules a check on: the pre-pool
  #     serial run and the worker pool. The pool's units carry whole entries,
  #     so a runner that destructures only [label, argv] would silently run the
  #     legacy stash suite with the guard injected. An unknown option is
  #     refused, never run in the plain env.
  Dir.mktmpdir("harness-gate-opt") do |dir|
    mk = lambda do |name|
      path = File.join(dir, "#{name}.sh")
      File.write(path, "#!/bin/sh\necho \"${GIT_CONFIG_COUNT-unset}\" > #{dir.shellescape}/#{name}.saw\n")
      FileUtils.chmod(0o755, path)
      [path]
    end
    fixture = [
      ["check-inotify-headroom", mk.call("pre"), :stash_fixture_optout],
      ["pooled-optout", mk.call("pooled"), :stash_fixture_optout],
      ["pooled-plain", mk.call("plain")],
    ]
    with_env("GIT_CONFIG_COUNT" => "0") do
      run_checks(fixture, root: dir, chdir: dir, io: StringIO.new, jobs: 2, timings: File::NULL)
    end
    saw = %w[pre pooled plain].to_h { |n| [n, File.read(File.join(dir, "#{n}.saw")).strip] rescue [n, "missing"] }
    unless saw == { "pre" => "unset", "pooled" => "unset", "plain" => "0" }
      warn "self-test: FAIL — case 13c: the per-check env option was not applied on every scheduling " \
           "path (GIT_CONFIG_COUNT seen: #{saw.inspect}; want pre/pooled unset, plain 0). Fix: every " \
           "runner in run_checks passes the entry's third element through check_env."
      ok = false
    end
    begin
      check_env({}, :no_such_option)
      warn "self-test: FAIL — case 13c: check_env accepted an unknown option"
      ok = false
    rescue ArgumentError
      nil
    end
  end

  # 14. HARNESS_GATE_JOBS: a positive integer, or the default; anything else
  #     is refused (a typo must not silently run serial or unbounded).
  { { "HARNESS_GATE_JOBS" => "3" } => 3, {} => [[16 / 2, 1].max, 8].min }.each do |env, want|
    got = gate_jobs(env, cores: 16)
    next if got == want

    warn "self-test: FAIL — gate_jobs(#{env.inspect}) = #{got}, want #{want}"
    ok = false
  end
  %w[0 -1 x 2.5].each do |bad|
    gate_jobs({ "HARNESS_GATE_JOBS" => bad })
    warn "self-test: FAIL — HARNESS_GATE_JOBS=#{bad} was accepted; it must raise"
    ok = false
  rescue ArgumentError
    next
  end

  # 14b-16 (DND-1005): --jobs, per-check CPU attribution, and a hanging
  # check reported by name. Each is its own method, documented there.
  ok = false unless self_test_jobs_flag
  ok = false unless self_test_cpu_attribution
  ok = false unless self_test_hang_named
  # 17 (DND-1474): the gate's telemetry. Its own method, documented there.
  ok = false unless self_test_telemetry

  ok
end

# 17 (DND-1474). GATE TELEMETRY, against a fixture repo and temp stores only
# (never the machine's store). The QA Plan's harness-gate rows:
#   17a two passing checks -> one harness_gate.run (checks=2, failed=0,
#       ok=true) and two harness_gate.check sharing its run_id, with no write
#       failure (every event and attr registered);
#   17b one failing check -> ok=false, failed=1; run_checks' result unchanged;
#   17c the fixture's branch dnd-9001-x -> unit DND-9001, head = its HEAD;
#   17d an unwritable store -> the same failures and the same stdout (timing
#       digits aside) as a writable one; stderr has at most the writer's line;
#   17e the checks see a scratch ATHENA_TELEMETRY_DIR, never the caller's, and
#       it is gone after the run.
# The interrupted path (interrupted: true) is asserted in case 16.
def self_test_telemetry
  good = true
  fail_with = lambda do |msg|
    warn "self-test: FAIL — case 17 (telemetry, DND-1474): #{msg}. Fix: keep run_checks calling " \
         "emit_gate_telemetry after the checks, with the per-check start, run_id and counts (GATE TELEMETRY)."
    good = false
  end
  unless defined?(AthenaTelemetry)
    fail_with.call("ai/lib/athena_telemetry.rb did not load")
    return good
  end
  Dir.mktmpdir("harness-gate-telemetry-test") do |dir|
    repo = File.join(dir, "repo")
    git_env = { "GIT_AUTHOR_NAME" => "t", "GIT_AUTHOR_EMAIL" => "t@t", "GIT_COMMITTER_NAME" => "t",
                "GIT_COMMITTER_EMAIL" => "t@t", "GIT_CONFIG_GLOBAL" => File::NULL, "GIT_CONFIG_NOSYSTEM" => "1" }
    Open3.capture3(git_env, "git", "init", "-q", "-b", "dnd-9001-x", repo)
    Open3.capture3(git_env, "git", "-C", repo, "commit", "-q", "--allow-empty", "-m", "fixture")
    head = Open3.capture3("git", "-C", repo, "rev-parse", "HEAD")[0].strip
    mk = lambda do |name, body|
      path = File.join(dir, "#{name}.sh")
      File.write(path, "#!/bin/sh\n#{body}\n")
      FileUtils.chmod(0o755, path)
      [path]
    end
    pass_a = ["pass-a", mk.call("pass-a", "echo a")]
    pass_b = ["pass-b", mk.call("pass-b", "echo b")]
    fail_c = ["fail-c", mk.call("fail-c", "echo 'FAIL: c'; exit 1")]
    seen = File.join(dir, "seen-dir")
    peek = ["peek", mk.call("peek", "printf '%s' \"$ATHENA_TELEMETRY_DIR\" > #{seen.shellescape}")]
    gate = lambda do |checks, store|
      io = StringIO.new
      errio = StringIO.new
      prev_err = $stderr
      $stderr = errio
      AthenaTelemetry.reset_process_state!
      _env, failures = with_env("ATHENA_TELEMETRY_DIR" => store) do
        run_checks(checks, root: repo, chdir: repo, io: io, jobs: 2, timings: File.join(dir, "timings.jsonl"))
      end
      [failures, io.string, errio.string]
    ensure
      $stderr = prev_err
    end
    read = lambda do |store|
      r = AthenaTelemetry.read(env: { "ATHENA_TELEMETRY_DIR" => store })
      [r.events.select { |e| e["event"] == "harness_gate.run" }, r.events.select { |e| e["event"] == "harness_gate.check" },
       r.failures]
    end

    # 17a + 17c
    store = File.join(dir, "store-a")
    gate.call([pass_a, pass_b], store)
    runs, chks, drops = read.call(store)
    run = runs.first || {}
    a = run["attrs"] || {}
    fail_with.call("17a want one run event, got #{runs.size}") unless runs.size == 1
    fail_with.call("17a run attrs #{a.inspect}") unless a["checks"] == 2 && a["failed"] == 0 && a["ok"] == true &&
                                                        a["interrupted"] == false && a["jobs"] == 2 &&
                                                        a["run_id"].to_s.match?(/\A\h{12}\z/)
    fail_with.call("17a run duration_s #{run['duration_s'].inspect}") unless run["duration_s"].is_a?(Numeric)
    fail_with.call("17a check events #{chks.map { |e| e['attrs'] }.inspect}") unless
      chks.map { |e| e.dig("attrs", "label") }.sort == %w[pass-a pass-b] &&
      chks.all? { |e| e.dig("attrs", "run_id") == a["run_id"] && e.dig("attrs", "ok") == true && e["duration_s"].is_a?(Numeric) }
    fail_with.call("17a a check starts before its run (#{chks.map { |e| e['at'] }.inspect} vs #{run['at']})") unless
      chks.all? { |e| e["at"].to_s >= run["at"].to_s }
    fail_with.call("17a write failures #{drops.inspect}: an event or attr is not registered") unless drops == {}
    fail_with.call("17c unit #{run['unit'].inspect} (#{run['unit_source']}), want DND-9001 from the branch") unless
      run["unit"] == "DND-9001" && run["unit_source"] == "branch"
    fail_with.call("17c head #{run['head'].inspect}, want the gated HEAD #{head}") unless run["head"] == head

    # 17b
    store = File.join(dir, "store-b")
    failures, = gate.call([pass_a, fail_c], store)
    runs, chks, drops = read.call(store)
    a = runs.first&.fetch("attrs", {}) || {}
    fail_with.call("17b run attrs #{a.inspect}, want ok=false failed=1") unless runs.size == 1 && a["ok"] == false && a["failed"] == 1
    fail_with.call("17b fail-c's check event #{chks.inspect}") unless
      chks.find { |e| e.dig("attrs", "label") == "fail-c" }&.dig("attrs", "ok") == false
    fail_with.call("17b run_checks' failures changed (#{failures.map(&:first).inspect})") unless failures.map(&:first) == ["fail-c"]
    fail_with.call("17b write failures #{drops.inspect}") unless drops == {}

    # 17d
    blocked = File.join(dir, "blocked")
    FileUtils.mkdir_p(blocked)
    FileUtils.chmod(0o500, blocked)
    # Timing digits, and the slowest-first list (two millisecond checks tie in
    # any order), are not output the store can change.
    strip = ->(s) { s.gsub(/slowest: [^;]*;/, "slowest: ;").gsub(/\d/, "#") }
    w_fail, w_out, = gate.call([pass_a, fail_c], File.join(dir, "store-d"))
    u_fail, u_out, u_err = gate.call([pass_a, fail_c], File.join(blocked, "store"))
    FileUtils.chmod(0o700, blocked)
    fail_with.call("17d an unwritable store changed the failures") unless u_fail.map(&:first) == w_fail.map(&:first)
    fail_with.call("17d an unwritable store changed stdout:\n#{u_out}\n--- vs ---\n#{w_out}") unless
      strip.call(u_out).sub(/timings: \S+/, "") == strip.call(w_out).sub(/timings: \S+/, "")
    fail_with.call("17d stderr carries more than the writer's one line: #{u_err.inspect}") unless
      u_err.lines.reject { |l| l.start_with?("athena-telemetry:") }.empty? && u_err.lines.size <= 1
    fail_with.call("17d the unwritable store was written") if Dir.exist?(File.join(blocked, "store"))

    # 17e
    store = File.join(dir, "store-e")
    gate.call([peek], store)
    scratch = File.exist?(seen) ? File.read(seen) : ""
    fail_with.call("17e a check saw ATHENA_TELEMETRY_DIR=#{scratch.inspect}, want a scratch store, never #{store}") if
      scratch.empty? || scratch == store
    fail_with.call("17e the scratch store #{scratch} outlived the run") if !scratch.empty? && File.exist?(File.dirname(scratch))
  ensure
    FileUtils.chmod(0o700, File.join(dir, "blocked")) if Dir.exist?(File.join(dir, "blocked"))
  end
  good
end

# Runs one --self-test group, or every group in HARNESS_GATE_SELF_TEST_GROUPS
# order when `group` is nil (the plain `--self-test`). Returns the exit code.
def run_self_test(group = nil)
  groups = group ? [group] : HARNESS_GATE_SELF_TEST_GROUPS
  ok = true
  # DND-1474: the suite drives run_checks against fixtures, and run_checks
  # emits telemetry. Those events go to a temp store, never the machine's.
  tel_dir = Dir.mktmpdir("harness-gate-selftest-telemetry-")
  begin
    with_env("ATHENA_TELEMETRY_DIR" => File.join(tel_dir, "store")) do
      groups.each { |g| ok = false unless self_test_group(g) }
    end
  ensure
    FileUtils.rm_rf(tel_dir)
  end
  scope = group ? "group #{group}" : "all #{groups.size} groups"

  if ok
    puts "harness-gate: self-test OK (#{scope}; #{CHECKS.size} checks declared, " \
         "#{discover_self_tests.size} of them discovered self-test suites)"
    0
  else
    warn "harness-gate: self-test FAILED (#{scope})"
    warn "  Fix: repair CHECKS in ai/bin/harness-gate so every declared check is " \
         "executable and every hook is invoked via its dedicated .self-test.sh " \
         "script (never `<hook>.sh --self-test`, which is a false green); keep " \
         "every scripts/setup-* installer's --self-test declared or delegated " \
         "(SELF_TEST_DELEGATES); keep discover_self_tests/self_test_checks " \
         "finding every real **/self-test.sh, flipping a fixture " \
         "suite red/green, and labeling distinct suites uniquely; keep " \
         "self_tests_found?/stray_test_scripts correct against a fixture " \
         "root; keep run_one reporting the child's exit status with " \
         "stdin closed; keep run_one failing a check its scratch-HOME " \
         "sentinel caught (case 8c, ai/lib/scratch_home_sentinel.rb); and keep inline_self_test_coverage naming every " \
         "first-party tool whose inline --self-test the gate never runs (case " \
         "11: declare it in STATIC_CHECKS, map it in " \
         "INLINE_SELF_TEST_COVERED_BY, or except it with a real reason); and " \
         "keep parse_cli refusing every undeclared argument with exit 2 " \
         "(case 12, ai/lib/strict_argv.rb); and keep every self-test case in " \
         "exactly one --group, each group declared once in CHECKS (case 13d)."
    1
  end
end

# The group a --group name selects, run. Names come from
# HARNESS_GATE_SELF_TEST_GROUPS, which parse_cli has already checked.
def self_test_group(name)
  return self_test_core if name == "core"
  return self_test_reap if name == "reap"

  script = SELF_TEST_DELEGATES.keys.find { |s| self_test_delegate_group(s) == name }
  raise ArgumentError, "harness-gate: unknown --self-test group #{name.inspect}" unless script

  self_test_delegate(script, SELF_TEST_DELEGATES[script])
end

if ARGV.include?("--help") || ARGV.include?("-h")
  puts <<~TXT
    Usage:
      ai/bin/harness-gate              run every gate check in its verified-correct
                                       invocation form; prints PASS/FAIL per check
                                       and exits non-zero if any fails. First
                                       checks origin freshness (exit 6, before
                                       any check runs, if the local
                                       refs/remotes/origin/main is stale —
                                       `git fetch origin` and re-run; distinct
                                       from exit 3 elsewhere in this repo,
                                       which means "could not measure" —
                                       origin WAS read here)
      ai/bin/harness-gate --jobs N     the same, on N workers. --jobs wins over
                                       the HARNESS_GATE_JOBS variable; with
                                       neither, half the cores (1 to 8). Both
                                       must be a positive integer, else exit 2.
                                       --jobs 1 runs the checks one at a time.
                                       Each result line carries wall and CPU
                                       seconds; per-check timings are appended
                                       to $XDG_STATE_HOME/athena/harness-gate/
                                       timings.jsonl (schema: the script's
                                       header). A signal during the checks
                                       prints INTERRUPTED with every check
                                       still running, by name.
      ai/bin/harness-gate --list       list the checks without running them
      ai/bin/harness-gate --self-test  assert the declared check list stays correct
                                       and complete (no model); runs every group
      ai/bin/harness-gate --self-test --group NAME
                                       run one self-test group: core, reap, or
                                       delegate-<installer> (one per
                                       SELF_TEST_DELEGATES entry). The gate runs
                                       each group as its own check.
      ai/bin/harness-gate --help       this text

    Run the copy that belongs to the tree you are about to commit in —
    `cd <your worktree> && ./ai/bin/harness-gate`. Every check resolves its
    inputs beside this script, so another tree's copy measures that tree, not
    yours; the gate names the tree it gated and refuses a same-repo mismatch.
    Never commit a harness that fails its own gate.
  TXT
  exit 0
end

cli, reason = parse_cli(ARGV)
if reason
  warn "harness-gate: usage error — #{reason}."
  warn "  Fix: re-run with only the flags `ai/bin/harness-gate --help` lists: no " \
       "argument or `--jobs N` (run the gate), --list, or --self-test [--group NAME]. An unrecognised " \
       "argument is refused, not ignored: ignoring it would run a different " \
       "mode than the one you asked for."
  exit 2
end

mode = gate_mode(cli)
# The worker count is validated before anything runs, whether it came from
# --jobs or HARNESS_GATE_JOBS: a bad value is exit 2, never a gate run.
cli_jobs = mode == :gate ? resolve_gate_jobs(cli["--jobs"]) : nil
exit 2 if mode == :gate && cli_jobs.nil?

begin
  exit(
    case mode
    when :self_test then run_self_test(cli["--group"])
    when :list then run_list
    else run_gate(jobs: cli_jobs)
    end
  )
rescue TreeIdentityError => e
  # git handed back a repo identity that is malformed FOR ITS TYPE (a relative
  # path where the contract says absolute). Per CLAUDE.md -> "A failed lookup
  # must never look like an empty one", that is an error at the point of
  # production, not a no-match — but it must still reach the reader as a Fix:
  # message rather than a bare Ruby backtrace.
  warn "harness-gate: FAILED — could not establish which tree is being gated: #{e.message}"
  warn "  Fix: this is a git-resolution fault, not a harness-content failure — " \
       "the gate refuses to run rather than report PASS/FAIL about a tree it " \
       "cannot name. Check `git -C . rev-parse --path-format=absolute " \
       "--git-common-dir` works and that #{CUSTOM_DIR} is a readable git " \
       "worktree. Do NOT make this pass by dropping the absolute-path check in " \
       "git_tree_identity: a cwd-relative --git-common-dir is exactly what " \
       "makes a main checkout and its own worktree compare as different " \
       "repositories, which silently disables the wrong-tree refusal."
  exit 1
rescue GitTrackingError => e
  # A confirmed git worktree whose `ls-files` itself failed (never raised for
  # "this isn't a repo" — see tracked_files). Must never surface as a bare
  # Ruby backtrace.
  warn "harness-gate: FAILED — #{e.message}"
  warn "  Fix: ensure `git` is on PATH and #{CUSTOM_DIR} is a readable git " \
       "worktree (try `git -C #{CUSTOM_DIR} status`), then re-run " \
       "ai/bin/harness-gate. Discovery refuses to silently skip its " \
       "tracked-file filter here, since that could promote an " \
       "untracked/vendored self-test.sh into the blocking gate."
  exit 1
end
