# ---------------------------------------------------------------------------
# INLINE --self-test COVERAGE (DND-507)
#
# Discovery above covers every committed `self-test.sh`. It cannot see a suite
# that lives INSIDE a tool behind a `--self-test` flag, and those were declared
# by hand in STATIC_CHECKS -- so a tool nobody remembered to declare had a suite
# that could not go red. Measured at 35be30f: six ai/bin tools
# (check-generic-skills, check-hooks-registered, check-inbox-registry,
# harness-eval, harness-metrics, harness-signals) shipped one, none was run,
# and check-hooks-registered's was red in every worktree.
#
# So the gate now derives the list of tools that DEFINE an inline --self-test
# and fails, naming each, unless every one is accounted for exactly once:
#   - declared: a STATIC_CHECKS entry runs `<tool> --self-test`;
#   - delegated: SELF_TEST_DELEGATES (installers; the delegation is proven
#     behaviourally by --self-test case 4b);
#   - covered: INLINE_SELF_TEST_COVERED_BY names a check the gate already runs
#     that runs the same suite -- the tool execs a discovered suite, or a
#     discovered suite runs `<tool> --self-test`. Declaring the tool too would
#     run that suite twice under two labels;
#   - excepted: INLINE_SELF_TEST_EXCEPTIONS, with a real reason the suite is
#     not gate-safe (model-in-loop, live config, network).
# An entry in either map whose tool vanished, or no longer defines the flag,
# is STALE and fails too, so the exceptions cannot outlive their subject.
#
# WHICH FILES: the first-party executables of ai/lib/first_party.rb (the
# discovery DND-218 built for check-guard-messages), minus test suites.
#
# WHAT "DEFINES AN INLINE --self-test" MEANS, AND WHY THIS HEURISTIC. A tool is
# a definer when any NON-COMMENT line contains the token `--self-test` (not a
# prefix of a longer flag such as `--self-test-case`). Deliberately a token,
# not a list of dispatch shapes: the shapes in this repo alone include bash
# `--self-test)`, `[ "$1" = "--self-test" ]`, ruby `ARGV.include?`,
# `when "--self-test"`, `argv.include?`, and a `%w[--self-test ...]` flag
# table, and a pattern list is exactly the lookup that misses the next shape
# silently. The flag name is the contract: every harness tool spells its suite
# `--self-test`, and check-bin-help makes each ai/bin tool advertise its flags
# in --help, so a definer mentions the token in code. The errors are
# asymmetric on purpose. A false positive (a tool that only CALLS another's
# --self-test) costs one reasoned exception entry and is visible; a false
# negative would be a silent unrun suite, the defect this closes. Comment
# lines are excluded because comments cite other tools' suites. Residual, said
# out loud: a suite behind a differently named flag, or a definer whose only
# mention is inside a comment, is not seen.
INLINE_SELF_TEST_RE = /(?<![\w-])--self-test(?![\w-])/.freeze

# tool -> the check (argv[0] of a CHECKS entry) that already runs its suite.
# Corroborated in the gate: the tool's code names the suite's path (>= the
# basename plus its parent directory when the basename is the generic
# self-test.sh), or the suite's code names the tool together with --self-test.
INLINE_SELF_TEST_COVERED_BY = {
  # The tool's --self-test execs a discovered/declared suite.
  # fleet-control --self-test runs all six parts of its suite (DND-1007/DND-1361);
  # each part is discovered on its own. The map names one of them.
  "ai/bin/fleet-control"         => "ai/lib/fleet/test/control/domain/self-test.sh",
  "ai/bin/fleet-report"          => "ai/lib/fleet/test/self-test.sh",
  "ai/bin/fleet-resume"          => "ai/lib/fleet/test/resume/self-test.sh",
  "ai/bin/next-mission"          => "ai/lib/test/next-mission/self-test.sh",
  "ai/bin/test-slot"             => "ai/test/test-slot/self-test.sh",
  "ai/bin/telemetry-emit"        => "ai/test/telemetry/self-test.sh",
  "ai/hooks/fleet-drain-guard.sh"     => "ai/hooks/fleet-drain-guard.self-test.sh",
