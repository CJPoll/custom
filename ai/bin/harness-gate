# writer that cannot load leaves the gate exactly as it was (see GATE
# TELEMETRY below).
begin
  require_relative "../lib/athena_telemetry"
rescue ScriptError, StandardError
  nil
end

CUSTOM_DIR = File.expand_path("../..", __dir__)

# A `scripts/setup-*` installer whose own --self-test is ALREADY covered below
# under a different name — either a STATIC_CHECKS entry or a discovered
# **/self-test.sh (see below). Maps script -> the check that covers
# it, so run_self_test's "no committed self-test goes unrun" assertion stays
# true without running the same suite twice under two labels.
SELF_TEST_DELEGATES = {
  "scripts/setup-inbox-registry"       => "ai/inbox/test/self-test.sh",
  "scripts/setup-athena-inbox-client"  => "scripts/test/athena-inbox-client/self-test.sh",
  "scripts/setup-private-overlay"      => "scripts/test/setup-private-overlay/self-test.sh",
}.freeze

# The --self-test group that runs case 4b for one SELF_TEST_DELEGATES entry.
def self_test_delegate_group(script)
  "delegate-#{File.basename(script)}"
end

# SELF-TEST GROUPS (DND-1007). The gate's own suite was ONE check of about
# 185 s alone (measured 2026-09-30: case 4b 162 s, case 13/DND-818 15 s, every
# other case together about 8 s), so no worker count got a parallel gate
# under it. It now runs as independent groups, each its own gate check
# (`--self-test --group NAME`), and every case runs in exactly one of them:
#   core                   every case but 4b and 13 (DND-818)
#   reap                   case 13 (DND-818): the per-check leak reap
#   delegate-<installer>   case 4b for ONE SELF_TEST_DELEGATES entry
# A new delegate gets its own group automatically. `--self-test` with no
# --group still runs every group, in this order. Case 13d asserts the split.
HARNESS_GATE_SELF_TEST_GROUPS =
  (%w[core reap] + SELF_TEST_DELEGATES.keys.map { |s| self_test_delegate_group(s) }).freeze

