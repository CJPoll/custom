#!/usr/bin/env ruby
# frozen_string_literal: true

# harness-gate — run the whole shipwright gate in one shot, in the verified-
# correct invocation form for each check.
#
# Why this exists: the gate used to live ONLY as prose in
# ai/agents/athena-shipwright.md.in -> "The gate". Prose is not executable, so
# every run re-assembled the nine commands by hand, and a mis-assembly is
# dangerous in ONE specific direction: a check that silently does nothing still
# exits 0 and reads as PASS. That has already happened once — invoking a hook as
# `ai/hooks/<hook>.sh --self-test` ignores the flag and blocks on (or empties)
# stdin, a FALSE GREEN. The template now warns about it in prose; this script
# makes the correct form the only form, and its --self-test asserts the trap
# cannot creep back into the declared list.
#
# This runner is a convenience + a guard, NOT a new source of authority: the
# canonical, human-readable gate spec stays in the shipwright template. Keep the
# two in sync — add a check here AND there.
#
# Deliberately gem-free (stdlib only); run with bare `ruby`.
#
# Usage:
#   ai/bin/harness-gate              run every check; exit 1 if any fails
#   ai/bin/harness-gate --list       print the declared checks, run nothing
#   ai/bin/harness-gate --self-test  verify the runner's own logic
#
# Not in the list: harness-gate itself (it would recurse). Its --self-test is
# the relevant check when this file changes.

require "open3"
require "fileutils"
require "tmpdir"

CUSTOM_DIR = File.expand_path("../..", __dir__)

# Each entry: [label, argv]. argv[0] is repo-relative.
STATIC_CHECKS = [
  ["build-agents --check",      %w[ai/bin/build-agents --check]],
  ["safe-wait-guard self-test", %w[ai/hooks/safe-wait-guard.self-test.sh]],
  ["pronoun-guard self-test",   %w[ai/hooks/pronoun-guard.self-test.sh]],
  ["harness-event self-test",   %w[ai/hooks/harness-event.self-test.sh]],
  ["check-generic-skills",      %w[ai/bin/check-generic-skills]],
  ["check-hooks-registered",    %w[ai/bin/check-hooks-registered]],
  ["check-inbox-registry",      %w[ai/bin/check-inbox-registry]],
  ["inbox-registry self-test",  %w[ai/inbox/test/self-test.sh]],
  ["check-guard-messages",      %w[ai/bin/check-guard-messages]],
  ["harness-eval",              %w[ai/bin/harness-eval]],
  ["critic-review self-test",   %w[ai/bin/critic-review --self-test]],
  ["critic-eval self-test",     %w[ai/bin/critic-eval --self-test]],
  # setup-hooks' --self-test is INLINE in the installer (no dedicated
  # scripts/test/**/self-test.sh backs it), so it stays hand-declared here.
  ["setup-hooks self-test",     %w[scripts/setup-hooks --self-test]],
].freeze

# A `scripts/setup-*` installer whose own --self-test is ALREADY covered above
# under a different name — either a STATIC_CHECKS entry or a discovered
# scripts/test/**/self-test.sh (see below). Maps script -> the check that
# covers it, so run_self_test's "no committed self-test goes unrun" assertion
# stays true without running the same suite twice under two labels.
SELF_TEST_DELEGATES = {
  "scripts/setup-inbox-registry"       => "ai/inbox/test/self-test.sh",
  "scripts/setup-athena-inbox-client"  => "scripts/test/athena-inbox-client/self-test.sh",
}.freeze

# DND-209: scripts/ has real self-tests (e.g. scripts/test/athena-inbox-client/
# self-test.sh, 42 cases) that nothing ran automatically — harness-gate was
# 10/10 green and would have stayed green with every scripts/ suite deleted.
# DISCOVER them (glob), don't hand-declare them, so a future suite under
# scripts/test/ is covered with zero manual wiring step — the same shape as
# check-hooks-registered's coverage of hooks, but here the check LIST itself is
# derived, not just diffed against disk.
#
# root is overridable so --self-test can prove discovery against a throwaway
# fixture tree instead of mutating the real scripts/test/ directory.
def discover_scripts_self_tests(root = CUSTOM_DIR)
  Dir.glob(File.join(root, "scripts/test/**/self-test.sh"))
     .map { |p| p.sub("#{root}/", "") }
     .sort
end

def scripts_self_test_checks(root = CUSTOM_DIR)
  discover_scripts_self_tests(root).map do |relpath|
    # Full path segment between scripts/test/ and /self-test.sh, so two
    # suites that share a leaf directory name (a/x, b/x) get distinct labels
    # instead of colliding on File.basename alone.
    name = relpath.sub(%r{\Ascripts/test/}, "").sub(%r{/self-test\.sh\z}, "")
    ["scripts self-test: #{name}", [relpath]]
  end
end

CHECKS = (STATIC_CHECKS + scripts_self_test_checks).freeze

FAIL_TAIL_LINES = 20

# Run one check with stdin CLOSED (a check that reads stdin must never inherit
# the caller's terminal or a pipe — that is the false-green path).
# Returns [ok?, combined_output].
def run_one(argv, chdir: CUSTOM_DIR)
  out, status = Open3.capture2e(*argv, chdir: chdir, stdin_data: "")
  [status.success?, out]
rescue Errno::ENOENT, Errno::EACCES => e
  [false, "harness-gate: cannot execute #{argv.first}: #{e.class}: #{e.message}"]
end

def missing_executables
  CHECKS.reject { |(_, argv)| File.executable?(File.join(CUSTOM_DIR, argv.first)) }
end

# The false-green trap: a hook's own .sh invoked with --self-test.
def false_green_entries
  CHECKS.select do |(_, argv)|
    argv.first.start_with?("ai/hooks/") &&
      !argv.first.end_with?(".self-test.sh")
  end
end

def run_gate
  scripts_found = discover_scripts_self_tests
  puts "scripts/test self-tests discovered: #{scripts_found.size}" \
       "#{scripts_found.empty? ? ' (none on disk — verify the glob, not just the count)' : ''}"

  missing = missing_executables
  unless missing.empty?
    warn "harness-gate: FAILED — declared check(s) missing or not executable:"
    missing.each { |(label, argv)| warn "  - #{label} (#{argv.first})" }
    warn "  Fix: restore the script and `chmod +x` it. For a STATIC_CHECKS " \
         "entry you can also remove it from CHECKS in ai/bin/harness-gate (and " \
         "from the gate list in ai/agents/athena-shipwright.md.in); a " \
         "discovered scripts/test/**/self-test.sh entry is NOT removable from " \
         "CHECKS by hand (it is derived from disk) — either chmod +x it or " \
         "delete the file from scripts/test/."
    return 1
  end

  failures = []
  CHECKS.each do |(label, argv)|
    ok, out = run_one(argv)
    printf("%-28s %s\n", label, ok ? "PASS" : "FAIL")
    failures << [label, argv, out] unless ok
  end

  if failures.empty?
    puts "harness-gate: OK — #{CHECKS.size}/#{CHECKS.size} checks PASS; safe to commit."
    return 0
  end

  warn ""
  warn "harness-gate: FAILED — #{failures.size} of #{CHECKS.size} check(s) did not pass:"
  failures.each do |(label, argv, out)|
    warn ""
    warn "--- #{label} (#{argv.join(' ')}) ---"
    out.to_s.lines.last(FAIL_TAIL_LINES).each { |l| warn "  #{l.chomp}" }
  end
  warn ""
  warn "  Fix: repair each failing check above, or revert the harness edit that " \
       "broke it (`git restore <files>`), then re-run ai/bin/harness-gate. Do " \
       "NOT commit while this is red — a red gate means the harness fails its " \
       "own checks. If you edited a template or block, run `ai/bin/build-agents` " \
       "first so the rendered .md files are regenerated."
  1
end

def run_list
  CHECKS.each { |(label, argv)| printf("%-28s %s\n", label, argv.join(" ")) }
  scripts_found = discover_scripts_self_tests
  puts "harness-gate: #{CHECKS.size} declared check(s) " \
       "(#{scripts_found.size} of them discovered under scripts/test/**/self-test.sh)"
  0
end

def run_self_test
  ok = true

  # 1. Every declared check exists and is executable.
  missing = missing_executables
  unless missing.empty?
    warn "self-test: FAIL — declared check(s) not executable: " \
         "#{missing.map { |(_, a)| a.first }.join(', ')}"
    ok = false
  end

  # 2. No hook is declared in the false-green form (`<hook>.sh --self-test`).
  traps = false_green_entries
  unless traps.empty?
    warn "self-test: FAIL — hook check(s) declared in the FALSE-GREEN form " \
         "(must be the dedicated .self-test.sh script): " \
         "#{traps.map { |(_, a)| a.join(' ') }.join(', ')}"
    ok = false
  end

  # 3. Every ai/hooks/*.self-test.sh on disk is actually declared (a new hook
  #    must not be able to ship untested by the gate).
  on_disk = Dir.glob(File.join(CUSTOM_DIR, "ai/hooks/*.self-test.sh"))
               .map { |p| p.sub("#{CUSTOM_DIR}/", "") }.sort
  declared = CHECKS.map { |(_, argv)| argv.first }
  undeclared = on_disk - declared
  unless undeclared.empty?
    warn "self-test: FAIL — hook self-test(s) on disk but not in CHECKS: " \
         "#{undeclared.join(', ')}"
    ok = false
  end

  # 4. Every scripts/setup-* installer that ADVERTISES a --self-test is either
  #    declared in CHECKS or delegates (SELF_TEST_DELEGATES) to a check that IS
  #    declared/discovered. Same class as (3): a committed self-test the gate
  #    never runs is a suite that cannot go red. DND-189 shipped 42 cases
  #    nothing invoked; setup-hooks' merge-safety cases had been equally unrun
  #    since the 2026-09-17 hook-clobber fix.
  installers = Dir.glob(File.join(CUSTOM_DIR, "scripts/setup-*"))
                  .select { |p| File.file?(p) && File.executable?(p) }
                  .select { |p| File.read(p).include?("--self-test") }
                  .map { |p| p.sub("#{CUSTOM_DIR}/", "") }.sort
  unrun = installers.reject do |script|
    declared.include?(script) ||
      declared.include?(SELF_TEST_DELEGATES[script])
  end
  unless unrun.empty?
    warn "self-test: FAIL — installer self-test(s) on disk but not run by the " \
         "gate: #{unrun.join(', ')}"
    ok = false
  end

  # 5. Discovery itself actually discovers and actually runs — proven against a
  #    THROWAWAY fixture tree, never the real scripts/test/, per the ticket's
  #    required case: "a deliberately failing stub suite under scripts/test/
  #    must turn the gate red, and removing it must turn it green again." (A
  #    plain "on-disk == declared" comparison here would be tautological, since
  #    CHECKS is built FROM discover_scripts_self_tests — this fixture instead
  #    exercises the actual discover -> run -> pass/fail behavior end to end.)
  Dir.mktmpdir("harness-gate-selftest-scripts") do |fixture_root|
    suite_dir = File.join(fixture_root, "scripts/test/fixture-suite")
    FileUtils.mkdir_p(suite_dir)
    suite_path = File.join(suite_dir, "self-test.sh")

    # Nothing discovered yet -> zero dynamic checks, not a crash and not a
    # false PASS masquerading as "found nothing to run".
    if discover_scripts_self_tests(fixture_root) != []
      warn "self-test: FAIL — discover_scripts_self_tests found something in " \
           "a fixture tree that has no suite yet"
      ok = false
    end

    File.write(suite_path, "#!/bin/sh\necho 'fixture failing on purpose'\nexit 1\n")
    FileUtils.chmod(0o755, suite_path)

    found = discover_scripts_self_tests(fixture_root)
    unless found == ["scripts/test/fixture-suite/self-test.sh"]
      warn "self-test: FAIL — discover_scripts_self_tests did not find the " \
           "fixture suite (found: #{found.inspect})"
      ok = false
    end

    red_ok, red_out = run_one([found.first], chdir: fixture_root)
    if red_ok
      warn "self-test: FAIL — a deliberately failing scripts/test stub was " \
           "reported as PASS (the exact silent-success class this ticket " \
           "exists to fix)"
      ok = false
    end
    unless red_out.to_s.include?("fixture failing on purpose")
      warn "self-test: FAIL — the failing fixture suite's output was not captured"
      ok = false
    end

    File.write(suite_path, "#!/bin/sh\nexit 0\n")
    FileUtils.chmod(0o755, suite_path)
    green_ok, = run_one([found.first], chdir: fixture_root)
    unless green_ok
      warn "self-test: FAIL — fixing the fixture suite to exit 0 did not turn " \
           "it green"
      ok = false
    end

    FileUtils.rm_f(suite_path)
    unless discover_scripts_self_tests(fixture_root).empty?
      warn "self-test: FAIL — removing the fixture suite did not make " \
           "discovery report zero again"
      ok = false
    end
  end

  # 6. Two suites that share a leaf directory name must not collide on label
  #    (scripts_self_test_checks must key off the full a/x vs b/x segment).
  Dir.mktmpdir("harness-gate-selftest-labels") do |fixture_root|
    %w[groupA/x groupB/x].each do |rel|
      dir = File.join(fixture_root, "scripts/test", rel)
      FileUtils.mkdir_p(dir)
      path = File.join(dir, "self-test.sh")
      File.write(path, "#!/bin/sh\nexit 0\n")
      FileUtils.chmod(0o755, path)
    end
    labels = scripts_self_test_checks(fixture_root).map(&:first)
    if labels.uniq.size != labels.size
      warn "self-test: FAIL — two distinct scripts/test suites produced the " \
           "same label: #{labels.inspect}"
      ok = false
    end
  end

  # 7. run_one reports PASS/FAIL correctly and closes stdin.
  Dir.mktmpdir("harness-gate-selftest") do |dir|
    passing = File.join(dir, "pass.sh")
    failing = File.join(dir, "fail.sh")
    reads   = File.join(dir, "reads-stdin.sh")
    File.write(passing, "#!/bin/sh\nexit 0\n")
    File.write(failing, "#!/bin/sh\necho boom\nexit 1\n")
    # Exits 0 only if stdin is at EOF -- i.e. the runner closed it rather than
    # leaving the check blocked on a terminal.
    File.write(reads, "#!/bin/sh\nif cat >/dev/null; then exit 0; else exit 1; fi\n")
    [passing, failing, reads].each { |p| FileUtils.chmod(0o755, p) }

    good_ok, = run_one([passing], chdir: dir)
    unless good_ok
      warn "self-test: FAIL — a passing check was reported as FAIL"; ok = false
    end

    bad_ok, bad_out = run_one([failing], chdir: dir)
    if bad_ok
      warn "self-test: FAIL — a failing check was reported as PASS"; ok = false
    end
    unless bad_out.to_s.include?("boom")
      warn "self-test: FAIL — a failing check's output was not captured"; ok = false
    end

    stdin_ok, = run_one([reads], chdir: dir)
    unless stdin_ok
      warn "self-test: FAIL — run_one did not close stdin for the check"; ok = false
    end
  end

  if ok
    puts "harness-gate: self-test OK (#{CHECKS.size} checks declared, " \
         "#{discover_scripts_self_tests.size} of them discovered scripts/test suites)"
    0
  else
    warn "harness-gate: self-test FAILED"
    warn "  Fix: repair CHECKS in ai/bin/harness-gate so every declared check is " \
         "executable and every hook is invoked via its dedicated .self-test.sh " \
         "script (never `<hook>.sh --self-test`, which is a false green); keep " \
         "every scripts/setup-* installer's --self-test declared or delegated " \
         "(SELF_TEST_DELEGATES); keep discover_scripts_self_tests/" \
         "scripts_self_test_checks finding every real scripts/test/**/" \
         "self-test.sh, flipping a fixture suite red/green, and labeling " \
         "distinct suites uniquely; and keep run_one reporting the child's " \
         "exit status with stdin closed."
    1
  end
end

exit(
  if ARGV.include?("--self-test") then run_self_test
  elsif ARGV.include?("--list") then run_list
  else run_gate
  end
)
