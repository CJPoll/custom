# A `scripts/setup-*` installer whose own --self-test is ALREADY covered above
# under a different name — either a STATIC_CHECKS entry or a discovered
# **/self-test.sh (see below). Maps script -> the check that covers
# it, so run_self_test's "no committed self-test goes unrun" assertion stays
# true without running the same suite twice under two labels.
SELF_TEST_DELEGATES = {
  "scripts/setup-inbox-registry"       => "ai/inbox/test/self-test.sh",
  "scripts/setup-athena-inbox-client"  => "scripts/test/athena-inbox-client/self-test.sh",
}.freeze

# `git ls-files` under root, or nil if root isn't a git worktree (a --self-test
# fixture root, deliberately never a git repo). Used to keep discovery scoped
# to committed source: a raw Dir.glob would also pick up an untracked/ignored
# tree that happens to exist in this checkout — e.g. this repo's own
# `ai/skills/synced/` (".gitignore: vendored plugin skills; NOT harness
# source") — silently promoting vendored third-party code into the blocking
# gate, with a `Fix: chmod +x it` for code we don't own if it isn't executable.
# It would also make the check LIST itself a property of the checkout rather
# than the commit. When root has no git metadata (a fixture tmpdir), this
# returns nil and callers skip the filter, so the existing fixture-based
# --self-test cases are unaffected.
# Raised only when root IS a confirmed git worktree but `git ls-files` itself
# failed — never for "this isn't a repo" (see below). Left uncaught, this must
# never surface as a bare Ruby backtrace (CLAUDE.md -> "Guard/error messages
# are written for the LLM"); the top-level dispatch below rescues it into a
# Fix:-carrying message.
GitTrackingError = Class.new(StandardError)

def tracked_files(root)
  # Two DISTINCT questions, on purpose, so failure can never look like "not a
  # repo" (fail nil/skip-filter — the fixture-root case) when it is actually
  # "a repo git itself couldn't read" (fail LOUD — the ai/skills/synced/ case
  # this filter exists to guard, if it ever went wrong). Collapsing them was a
  # prior version's bug: both a fixture root AND a `git`/`.git` error returned
  # nil, so a genuine git failure on the REAL repo would have silently skipped
  # the filter and let an untracked/vendored self-test.sh straight into the
  # blocking gate — the exact failure this filter exists to prevent.
  _out, _err, probe = Open3.capture3("git", "-C", root, "rev-parse", "--is-inside-work-tree")
  return nil unless probe.success? # not a git worktree at all -> a fixture root; skip the filter

  out, err, status = Open3.capture3("git", "-C", root, "ls-files")
  raise GitTrackingError, "git -C #{root} ls-files failed: #{err.strip}" unless status.success?

  out.split("\n")
rescue Errno::ENOENT
  raise GitTrackingError, "git executable not found on PATH"
end

# ---------------------------------------------------------------------------
# WHICH TREE AM I GATING?
#
# Every check in CHECKS is resolved against CUSTOM_DIR, which is derived from
# __dir__ — the location of THIS FILE, not the caller's cwd. So
# `~/dev/custom/ai/bin/harness-gate`, run from a worktree, gates the MAIN
# CHECKOUT and reports PASS about code the caller is not committing. Nothing in
# the output said so: the gate printed per-check PASS and "38/38 ... safe to
# commit" without ever naming the tree it measured.
#
# Measured 2026-09-20 (run 2026-09-20-notif-platform, state.md "CORRECTED
# DIAGNOSIS"): an admiral gated the dnd-247 worktree with the main checkout's
# binary. check-inbox-registry compares the LIVE registry against the
# registry.json beside the script, so it compared MAIN's copy — the gate went
# RED, was diagnosed as live-registry "drift", and an operational revert was
# considered before the real cause (wrong tree) was found. A false GREEN in the
# same shape is the strictly worse half and leaves no symptom at all.
#
# This is CLAUDE.md -> "A failed lookup must never look like an empty one" at
# the level of a measurement: a gate run against the wrong tree is
# indistinguishable from a gate run against the right one. Two responses, in
# order of how much they cost:
#   1. ALWAYS name the tree in the output, so any PASS/FAIL can be attributed.
#   2. REFUSE when cwd is a DIFFERENT worktree OF THE SAME REPO — the one state
#      where the caller demonstrably has their own copy of every file and the
#      main-checkout path can only be a mistake.
# Deliberately NOT refused: a cwd outside any repo, or inside an UNRELATED repo
# (gating custom from elsewhere is a real thing to want), or a cwd that cannot
# be resolved at all. Fail open, per house style — but say so, never silently.
TreeIdentityError = Class.new(StandardError)

# [worktree_root, repo_identity] for `dir`, both absolute realpaths, or nil if
# `dir` is not inside a git worktree (fail-open: nothing to compare).
def git_tree_identity(dir)
  return nil unless File.directory?(dir.to_s)

  top, _e, st = Open3.capture3("git", "-C", dir, "rev-parse", "--show-toplevel")
  return nil unless st.success?

  common, _e2, st2 = Open3.capture3("git", "-C", dir, "rev-parse", "--git-common-dir")
  return nil unless st2.success?

  top = top.strip
  common = common.strip
  return nil if top.empty? || common.empty?

  # THE TRAP THIS REPO HAS HIT FOUR TIMES (DND-183/202/208, custom PR #6):
  # --git-common-dir is CWD-RELATIVE in a main checkout (literally ".git") and
  # absolute only in a linked worktree. Left unexpanded, a main checkout and
  # its own worktree yield ".git" vs "/abs/path/.git" — UNEQUAL — so the two
  # would be classified as different repositories and the guard below would
  # never fire. `git -C dir` makes the relative form relative to `dir`, so
  # expand against `dir` and NEVER against Dir.pwd. A value still not absolute
  # after expansion is a FAILED resolution, not a legitimate no-match.
  #
  # The EXPANSION is the live defence and is what --self-test case 7b drives
  # (with a stubbed git returning the relative form). The raise below is a
  # backstop only: File.expand_path always yields an absolute path today, so
  # it is unreachable until someone resolves this value a different way —
  # which is exactly when a silent relative path would come back.
  common = File.expand_path(common, dir)
  unless common.start_with?("/")
    raise TreeIdentityError,
          "git -C #{dir} rev-parse --git-common-dir gave #{common.inspect}, which is not an absolute path"
  end

  [File.realpath(top), File.realpath(common)]
rescue Errno::ENOENT, Errno::EACCES
  nil
end

# nil when there is nothing to refuse; otherwise the two tree roots, as
# [cwd_root, gate_root]. Pure (both inputs injected) so --self-test can drive
# it with fixture repos instead of the live checkout.
def foreign_gate_tree(gate_root: CUSTOM_DIR, cwd: Dir.pwd)
  here = git_tree_identity(cwd)
  gate = git_tree_identity(gate_root)
  return nil if here.nil? || gate.nil?   # cannot tell -> allow
  return nil if here[0] == gate[0]       # same worktree -> the normal case
  return nil if here[1] != gate[1]       # a genuinely different repo -> allow

  [here[0], gate[0]]
end

# DND-209: this repo has real self-tests (e.g. scripts/test/athena-inbox-client/
# self-test.sh, 42 cases; ai/skills/athena:inbox/test/self-test.sh;
# ai/skills/athena:slack/test/self-test.sh) that nothing ran automatically —
# harness-gate was 10/10 green and would have stayed green with every one of
# them deleted. DISCOVER them (glob), don't hand-declare them, so a future
# suite anywhere in the repo is covered with zero manual wiring step. Patch the
# class (every committed `self-test.sh`, wherever it lives), not the one site
# (scripts/test/) that happened to surface it, and not just the ones that
# happen to sit under a directory literally named `test/` (the earlier draft
# of this glob) — the same shape as check-hooks-registered's coverage of
# hooks, but here the check LIST itself is derived, not just diffed against
# disk.
#
# root is overridable so --self-test can prove discovery against a throwaway
# fixture tree instead of mutating any real directory in this repo.
def discover_self_tests(root = CUSTOM_DIR)
  # FNM_DOTMATCH (DND-422): without it `**/` never descends a dot-directory, so
  # a committed suite under e.g. `.auto-completions/` would silently never run.
  # The tracked filter below keeps `.git/` (and any shipwright lane inside it)
  # out, since `git ls-files` never lists it.
  candidates = Dir.glob(File.join(root, "**/self-test.sh"), File::FNM_DOTMATCH).map { |p| p.sub("#{root}/", "") }
  tracked = tracked_files(root)
  candidates = candidates.select { |p| tracked.include?(p) } if tracked
  candidates.sort
end

def self_test_checks(root = CUSTOM_DIR)
  discover_self_tests(root).map do |relpath|
    # The full relative path (minus the trailing filename) makes the label,
    # so distinct suites can never collide the way a leaf-basename-only label
    # would (e.g. two suites both living in a directory literally named `x`).
    ["self-test: #{relpath.sub(%r{/self-test\.sh\z}, '')}", [relpath]]
  end
end

# self_test_checks -> discover_self_tests -> tracked_files can raise
# GitTrackingError (see above) while this constant is evaluated at file load
# time, for EVERY invocation (including --list/--self-test), before the
# ARGV dispatch at the bottom of this file ever runs. Fall back to
# STATIC_CHECKS-only here so the file finishes loading; the SAME call is made
# again inside run_gate/run_list/run_self_test (they all call
# discover_self_tests(root) directly, not just through this constant), and
# THAT raise is caught by the rescue around the dispatch below, which reports
# it with a Fix: line instead of a bare Ruby backtrace.
# DND-404: runs LAST, after every discovered self-test — never merged into
# STATIC_CHECKS (which precedes self_test_checks below), or discovery order
# would put it before the suite it backstops.
# scripts/test/inbox-client-capture/self-test.sh starts real
# mock-athena-inbox-client.rb processes and reaps them by pid in its own
# trap; a trap cannot survive a SIGKILL of the suite (or of this gate
# process) itself. check-inbox-mock-orphans walks the mock's ancestor chain
# for a still-live self-test/gate launcher anywhere in it — proof of
# orphanhood that survives any kill of whatever started the mock (and a
# subreaper reparenting it to something other than PID 1), no marker or
# environment plumbing required — so it never depends on this process
# still being alive to run it; it just as usefully sweeps up whatever an
# EARLIER killed gate run left behind, which is the case that actually
# matters (see the script's own banner).
FINAL_CHECKS = [
  ["check-inbox-mock-orphans", %w[ai/bin/check-inbox-mock-orphans]],
].freeze

CHECKS =
  begin
    (STATIC_CHECKS + self_test_checks + FINAL_CHECKS).freeze
  rescue GitTrackingError
    STATIC_CHECKS + FINAL_CHECKS
  end

# The discovery CONTRACT is the exact filename `self-test.sh` — anything else
# (a suite named tests.sh, foo_test.sh, ...) is invisible to the glob with no
# count change to notice. discover_self_tests above is deliberately
# UNSCOPED (any `self-test.sh` anywhere is discovered), but this heuristic
# stays scoped to directories literally named `test/` — the established
# convention every real suite in this repo already follows — because widening
# it to "any misnamed .sh anywhere" would flag effectively every helper script
# in the repo, drowning the signal. So the two checks are intentionally
# asymmetric: discovery is unconditional, "did you probably mean this to be a
# suite" is a scoped heuristic. Flag it so a misnamed suite is at least visible
# instead of silently unrun (helper scripts a real self-test.sh `source`s or
# execs are expected to live in a test/ dir too, so this WARNS rather than
# fails the gate — it cannot tell a stray suite from a deliberate helper).
# Deliberately NOT filtered to executable files: a suite committed without its
# `+x` bit (invoked as `bash foo.sh`, say) is the exact case this exists to
# catch — filtering it out would leave the contract's most likely violation
# invisible to its own detector.
def stray_test_scripts(root = CUSTOM_DIR)
  candidates = Dir.glob(File.join(root, "**/test/**/*.sh"), File::FNM_DOTMATCH) # DND-422: dot-dirs too
                  .reject { |p| File.basename(p) == "self-test.sh" }
                  .map { |p| p.sub("#{root}/", "") }
  tracked = tracked_files(root)
  candidates = candidates.select { |p| tracked.include?(p) } if tracked
  candidates.sort
end

# Pure predicate so --self-test can exercise run_gate's zero-discovery
# decision directly, against a fixture root, instead of only asserting on
# discover_self_tests (which case 5 already covers) or having to run the
# whole gate to reach the branch.
def self_tests_found?(root = CUSTOM_DIR)
  !discover_self_tests(root).empty?
end

FAIL_TAIL_LINES = 20

# How many failure-bearing lines to surface from ANYWHERE in a check's output.
FAIL_GREP_LINES = 40

# A blind tail cannot name the case that failed. A suite that prints one line
# per case emits its `FAIL` line where the case ran and then keeps printing
# passing cases, so with 119 cases the last 20 lines are 20 OTHER cases' `ok`
# lines plus a "118 passed, 1 failed" total. That is a failure report that omits
# the failure: the reader learns something broke and is shown only things that
# worked, which is this repo's "Guard/error messages are written for the LLM"
# convention violated at the one moment the gate exists for. Measured 2026-09-21
# (shipwright 08:00Z): scripts/test/athena-shipwright failed twice under the
# gate and passed 5/5 standalone; the gate's own output could not name the case,
# so the intermittent failure could not be diagnosed at all.
#
# So: pull the failure-bearing lines out of the WHOLE output, then still print
# the tail (which carries the suite's own total and Fix: line). Matching is
# deliberately broad and case-sensitive on the loud spellings our suites use —
# a false positive costs one extra printed line, a false negative costs the
# diagnosis.
FAIL_LINE_RE = /(^|\s)(FAIL|FAILED|not ok|ERROR|Error:)\b/.freeze

def failure_lines(out)
  out.to_s.lines.grep(FAIL_LINE_RE)
end

# Run one check with stdin CLOSED (a check that reads stdin must never inherit
# the caller's terminal or a pipe — that is the false-green path).
# Returns [ok?, combined_output].
def run_one(argv, chdir: CUSTOM_DIR)
  out, status = Open3.capture2e(*argv, chdir: chdir, stdin_data: "")
  [status.success?, out]
rescue Errno::ENOENT, Errno::EACCES => e
  [false, "harness-gate: cannot execute #{argv.first}: #{e.class}: #{e.message}"]
end

def missing_executables
  CHECKS.reject { |(_, argv)| File.executable?(File.join(CUSTOM_DIR, argv.first)) }
end

# The false-green trap: a hook's own .sh invoked with --self-test.
def false_green_entries
  CHECKS.select do |(_, argv)|
    argv.first.start_with?("ai/hooks/") &&
      !argv.first.end_with?(".self-test.sh")
  end
end

# root/dry_run exist for --self-test: a fixture root can drive this exact
# decision logic (not just the discover_self_tests/self_tests_found? predicates
# case 5/6b already cover) without the run actually mutating anything, and
# dry_run stops before executing the real CHECKS list so testing the
# zero-discovery/stray-suite branches against a fixture never spends the time
# (or risk) of re-running the whole real gate as a side effect.
def run_gate(root: CUSTOM_DIR, dry_run: false)
  # `root` only ever governs the discovery reporting below (found/self_tests_
  # found?/stray_test_scripts) — missing_executables and the CHECKS execution
  # loop past `return 0 if dry_run` always use the real CUSTOM_DIR/CHECKS,
  # never `root`. A non-default root with dry_run: false would therefore
  # report on one tree and execute another with no failure — make that
  # misuse impossible to construct rather than merely undocumented.
  raise ArgumentError, "run_gate: root: only supported together with dry_run: true" \
    if root != CUSTOM_DIR && !dry_run

  # RECURSION GUARD. ai/bin/check-bin-help probes every bin with `--help`, and
  # harness-gate is the one bin whose pre-fix fall-through would have re-entered
  # the very gate doing the probing. The probe sets this variable, so a gate run
  # started from inside it is refused structurally rather than merely bounded by
  # the probe's timeout. Nothing else sets it.
  if ENV["HARNESS_BIN_HELP_PROBE"]
    warn "harness-gate: REFUSED — started from inside a check-bin-help --help probe."
    warn "  Fix: this means `harness-gate --help` fell through to running the gate instead of printing usage and exiting 0. Restore the --help branch at the bottom of ai/bin/harness-gate; do not unset HARNESS_BIN_HELP_PROBE to get past this."
    return 1
  end

  # Attribution, unconditionally. A PASS that does not name its tree cannot be
  # audited after the fact — see "WHICH TREE AM I GATING?" above.
  puts "harness-gate: gating #{root}"

  found = discover_self_tests(root)
  puts "self-tests discovered: #{found.size}"

  # A DROP TO ZERO is exactly the failure mode this ticket exists to close —
  # this repo has committed self-test.sh suites in every checkout (they are
  # source, not environment-dependent config), so finding none means the glob
  # or root resolution broke, not that there is legitimately nothing to run.
  # Fail loud instead of a silently-shorter PASS.
  unless self_tests_found?(root)
    warn "harness-gate: FAILED — discovered ZERO **/self-test.sh, but this " \
         "repo has committed suites."
    warn "  Fix: this means discover_self_tests (ai/bin/harness-gate) or " \
         "CUSTOM_DIR resolution is broken, or every suite was moved/renamed " \
         "without updating the glob — a real gap, not something to " \
         "suppress. Restore the suites or the glob before committing."
    return 1
  end

  strays = stray_test_scripts(root)
  unless strays.empty?
    warn "harness-gate: NOTE — .sh file(s) under a test/ directory not named " \
         "self-test.sh, so NOT discovered/run: #{strays.join(', ')}"
    warn "  Fix: if any of these is meant to be a self-test entry point, " \
         "rename it to self-test.sh (the only name harness-gate discovers), " \
         "and make sure it is executable; if it's a helper another " \
         "self-test.sh sources/execs, no action needed."
  end

  return 0 if dry_run

  # WRONG-TREE REFUSAL. Only reached on a real run (a fixture dry_run never
  # gets here), and only fires for same-repo-different-worktree — see
  # "WHICH TREE AM I GATING?" above for what is deliberately allowed.
  if (mismatch = foreign_gate_tree)
    cwd_root, gate_root = mismatch
    warn "harness-gate: REFUSED — you are in #{cwd_root} but this binary gates #{gate_root}."
    warn "  Fix: run the gate belonging to the tree you are about to commit in — " \
         "`cd #{cwd_root} && ./ai/bin/harness-gate`. Every check resolves its " \
         "inputs beside THIS script (check-inbox-registry reads the " \
         "registry.json next to it, discovery globs that tree), so the result " \
         "you just asked for would describe #{gate_root}, not your work. Do " \
         "not work around this by copying the result across — gate the tree " \
         "you are committing."
    return 1
  end

  missing = missing_executables
  unless missing.empty?
    warn "harness-gate: FAILED — declared check(s) missing or not executable:"
    missing.each { |(label, argv)| warn "  - #{label} (#{argv.first})" }
    warn "  Fix: restore the script and `chmod +x` it. For a STATIC_CHECKS " \
         "entry you can also remove it from CHECKS in ai/bin/harness-gate (and " \
         "from the gate list in ai/agents/athena-shipwright.md.in) instead, if " \
         "the check no longer applies. A discovered **/self-test.sh " \
         "entry is NOT removable from CHECKS by hand (it is derived from " \
         "disk) — `chmod +x` it. Do NOT delete it to make this pass: with " \
         "only a handful of self-test suites on disk today, deleting one " \
         "just risks trading this failure for the zero-discovery failure above."
    return 1
  end

  failures = []
  CHECKS.each do |(label, argv)|
    ok, out = run_one(argv)
    printf("%-28s %s\n", label, ok ? "PASS" : "FAIL")
    failures << [label, argv, out] unless ok
  end

  if failures.empty?
    puts "harness-gate: OK — #{CHECKS.size}/#{CHECKS.size} checks PASS; safe to commit."
    return 0
  end

  warn ""
  warn "harness-gate: FAILED — #{failures.size} of #{CHECKS.size} check(s) did not pass:"
  failures.each do |(label, argv, out)|
    warn ""
    warn "--- #{label} (#{argv.join(' ')}) ---"
    tail = out.to_s.lines.last(FAIL_TAIL_LINES)
    hits = failure_lines(out) - tail
    unless hits.empty?
      warn "  failure lines (from the full output, not just the tail):"
      hits.first(FAIL_GREP_LINES).each { |l| warn "    #{l.chomp}" }
      if hits.size > FAIL_GREP_LINES
        warn "    ... #{hits.size - FAIL_GREP_LINES} more failure line(s) elided; " \
             "re-run the check directly for all of them"
      end
      warn "  last #{tail.size} line(s):"
    end
    tail.each { |l| warn "  #{l.chomp}" }
  end
  warn ""
  warn "  Fix: repair each failing check above, or revert the harness edit that " \
       "broke it (`git restore <files>`), then re-run ai/bin/harness-gate. Do " \
       "NOT commit while this is red — a red gate means the harness fails its " \
       "own checks. If you edited a template or block, run `ai/bin/build-agents` " \
       "first so the rendered .md files are regenerated."
  1
end

def run_list
  puts "harness-gate: listing for #{CUSTOM_DIR}"
  CHECKS.each { |(label, argv)| printf("%-28s %s\n", label, argv.join(" ")) }
  found = discover_self_tests
  puts "harness-gate: #{CHECKS.size} declared check(s) " \
       "(#{found.size} of them discovered under **/self-test.sh)"
  0
end

# Every ai/hooks/*.self-test.sh on disk, relative to root. FNM_DOTMATCH
# (DND-422): a dot-prefixed hook suite must not escape the declared-check audit.
def hook_self_tests_on_disk(root = CUSTOM_DIR)
  Dir.glob(File.join(root, "ai/hooks/*.self-test.sh"), File::FNM_DOTMATCH)
     .map { |p| p.sub("#{root}/", "") }.sort
end

def run_self_test
  ok = true

  # 1. Every declared check exists and is executable.
  missing = missing_executables
  unless missing.empty?
    warn "self-test: FAIL — declared check(s) not executable: " \
         "#{missing.map { |(_, a)| a.first }.join(', ')}"
    ok = false
  end

  # 2. No hook is declared in the false-green form (`<hook>.sh --self-test`).
  traps = false_green_entries
  unless traps.empty?
    warn "self-test: FAIL — hook check(s) declared in the FALSE-GREEN form " \
         "(must be the dedicated .self-test.sh script): " \
         "#{traps.map { |(_, a)| a.join(' ') }.join(', ')}"
    ok = false
  end

  # 3. Every ai/hooks/*.self-test.sh on disk is actually declared (a new hook
  #    must not be able to ship untested by the gate).
  on_disk = hook_self_tests_on_disk
  declared = CHECKS.map { |(_, argv)| argv.first }
  undeclared = on_disk - declared
  unless undeclared.empty?
    warn "self-test: FAIL — hook self-test(s) on disk but not in CHECKS: " \
         "#{undeclared.join(', ')}"
    ok = false
  end

  # 3b. STATIC_CHECKS must never ALSO hand-declare a path that discovery
  #     already finds — that would run the same suite twice under two labels,
  #     silently, with no failure. SELF_TEST_DELEGATES documents each case
  #     that already had this collision fixed (ai/inbox/test/self-test.sh
  #     moved out of STATIC_CHECKS in favor of discovery); this assertion is
  #     what stops it from creeping back in on any FUTURE STATIC_CHECKS entry.
  overlap = STATIC_CHECKS.map { |(_, argv)| argv.first } & discover_self_tests
  unless overlap.empty?
    warn "self-test: FAIL — STATIC_CHECKS hand-declares #{overlap.join(', ')}, " \
         "which discover_self_tests ALSO finds — the suite would run twice " \
         "under two labels. Remove the STATIC_CHECKS entry and let discovery " \
         "cover it (add a SELF_TEST_DELEGATES entry if some installer's " \
         "--self-test also wraps it)."
    ok = false
  end

  # 4. Every scripts/setup-* installer that ADVERTISES a --self-test is either
  #    declared in CHECKS or delegates (SELF_TEST_DELEGATES) to a check that IS
  #    declared/discovered. Same class as (3): a committed self-test the gate
  #    never runs is a suite that cannot go red. DND-189 shipped 42 cases
  #    nothing invoked; setup-hooks' merge-safety cases had been equally unrun
  #    since the 2026-09-17 hook-clobber fix.
  installers = Dir.glob(File.join(CUSTOM_DIR, "scripts/setup-*"))
                  .select { |p| File.file?(p) && File.executable?(p) }
                  .select { |p| File.read(p).include?("--self-test") }
                  .map { |p| p.sub("#{CUSTOM_DIR}/", "") }.sort
  unrun = installers.reject do |script|
    declared.include?(script) ||
      declared.include?(SELF_TEST_DELEGATES[script])
  end
  unless unrun.empty?
    warn "self-test: FAIL — installer self-test(s) on disk but not run by the " \
         "gate: #{unrun.join(', ')}"
    ok = false
  end

  # 4b. A SELF_TEST_DELEGATES value must be the suite the installer ACTUALLY
  #     execs, not merely some other path that happens to be covered — case 4
  #     only checks "the named path is covered by something", so a delegate
  #     entry pointing at a real-but-wrong suite would read as "installer
  #     covered" while the installer's own suite silently goes unrun. That is
  #     this ticket's exact class, one level up in its own bookkeeping.
  #
  #     A textual "does the installer's source mention this path?" check was
  #     tried first and rejected: both real installers build their suite path
  #     via variable interpolation / File.join (`"${SCRIPT_DIR}/test/…"`,
  #     `File.join(repo_dir, "ai", "inbox", …)`), so the literal delegate
  #     string never appears on the line that actually execs it — a substring
  #     search only passed today because a Fix:/error message elsewhere
  #     happens to spell the same path, which proves nothing about what the
  #     installer runs. Verify BEHAVIOR instead: run `<installer> --self-test`
  #     and the delegated suite directly, then assert the installer's captured
  #     output contains the delegate's OWN verdict line (`VERDICT: PASS (N
  #     cases…)`, unique per suite by case count/wording) — not just "both
  #     happened to pass", which two unrelated always-green suites would also
  #     satisfy, but "the installer's run really is this suite's run" (both
  #     installers either `exec` the suite directly or `bash` it without
  #     redirecting output, so its own verdict line passes straight through).
  SELF_TEST_DELEGATES.each do |script, delegate|
    script_path = File.join(CUSTOM_DIR, script)
    next unless File.file?(script_path) && File.executable?(script_path) # case 4 flags this

    installer_ok, installer_out = run_one([script, "--self-test"])
    delegate_ok, delegate_out = run_one([delegate])
    verdict = delegate_out.to_s.lines.find { |l| l =~ /^\s*VERDICT:/i }
    unless installer_ok && delegate_ok && verdict && installer_out.include?(verdict.strip)
      warn "self-test: FAIL — SELF_TEST_DELEGATES[#{script.inspect}] = " \
           "#{delegate.inspect}, but `#{script} --self-test`'s output does " \
           "not contain that suite's own verdict line (#{verdict.inspect}) — " \
           "the delegation is unverified, so the installer's real self-test " \
           "suite could be going unrun. (installer_ok=#{installer_ok}, " \
           "delegate_ok=#{delegate_ok}, installer output tail: " \
           "#{installer_out.to_s.lines.last(5).join.inspect})"
      ok = false
    end
  end

  # Cases 5, 6, 6b and 6c below all plant a fixture suite under a
  # Dir.mktmpdir tree and assume it is NOT itself inside a git worktree — that
  # is what makes discover_self_tests(fixture_root) return exactly what was
  # planted. `Dir.mktmpdir` honours $TMPDIR, so if TMPDIR is ever pointed
  # inside a repo (a plausible CI/agent/sandbox setup), `tracked_files` would
  # treat the fixture as a real repo, the planted suite would look untracked,
  # and every one of those cases would report a FALSE red that blames
  # discovery for an environment property instead of a real bug. Verify the
  # assumption instead of stating it: probe once, and if it doesn't hold, skip
  # those specific cases with a clear NOTE rather than a false failure (6d and
  # 6e are unaffected — 6d creates its own real repo on purpose, 6e's `git` is
  # a PATH-shimmed fake that never touches the real filesystem check).
  fixtures_isolated =
    Dir.mktmpdir("harness-gate-selftest-probe") do |probe|
      _out, _err, probe_status = Open3.capture3("git", "-C", probe, "rev-parse", "--is-inside-work-tree")
      !probe_status.success?
    end
  unless fixtures_isolated
    warn "self-test: NOTE — skipping cases 5/6/6b/6c: Dir.mktmpdir resolves " \
         "inside a git worktree in this environment (check $TMPDIR), so the " \
         "tracked-file filter would treat every fixture there as a real repo " \
         "and produce false reds unrelated to this code. Not counted as a " \
         "failure."
  end

  # 5. Discovery itself actually discovers and actually runs — proven against a
  #    THROWAWAY fixture tree, never a real test/ directory, per the ticket's
  #    required case: "a deliberately failing stub suite under scripts/test/
  #    must turn the gate red, and removing it must turn it green again." (A
  #    plain "on-disk == declared" comparison here would be tautological, since
  #    CHECKS is built FROM discover_self_tests — this fixture instead
  #    exercises the actual discover -> run -> pass/fail behavior end to end.)
  if fixtures_isolated
  Dir.mktmpdir("harness-gate-selftest-scripts") do |fixture_root|
    suite_dir = File.join(fixture_root, "scripts/test/fixture-suite")
    FileUtils.mkdir_p(suite_dir)
    suite_path = File.join(suite_dir, "self-test.sh")

    # Nothing discovered yet -> zero dynamic checks, not a crash and not a
    # false PASS masquerading as "found nothing to run".
    if discover_self_tests(fixture_root) != []
      warn "self-test: FAIL — discover_self_tests found something in a " \
           "fixture tree that has no suite yet"
      ok = false
    end

    File.write(suite_path, "#!/bin/sh\necho 'fixture failing on purpose'\nexit 1\n")
    FileUtils.chmod(0o755, suite_path)

    found = discover_self_tests(fixture_root)
    unless found == ["scripts/test/fixture-suite/self-test.sh"]
      warn "self-test: FAIL — discover_self_tests did not find the fixture " \
           "suite (found: #{found.inspect})"
      ok = false
    end

    red_ok, red_out = run_one([found.first], chdir: fixture_root)
    if red_ok
      warn "self-test: FAIL — a deliberately failing self-test stub was " \
           "reported as PASS (the exact silent-success class this ticket " \
           "exists to fix)"
      ok = false
    end
    unless red_out.to_s.include?("fixture failing on purpose")
      warn "self-test: FAIL — the failing fixture suite's output was not captured"
      ok = false
    end

    File.write(suite_path, "#!/bin/sh\nexit 0\n")
    FileUtils.chmod(0o755, suite_path)
    green_ok, = run_one([found.first], chdir: fixture_root)
    unless green_ok
      warn "self-test: FAIL — fixing the fixture suite to exit 0 did not turn " \
           "it green"
      ok = false
    end

    FileUtils.rm_f(suite_path)
    unless discover_self_tests(fixture_root).empty?
      warn "self-test: FAIL — removing the fixture suite did not make " \
           "discovery report zero again"
      ok = false
    end
  end
  end

  # 6. Two suites that share a leaf directory name must not collide on label
  #    (self_test_checks must key off the full relative path, not a basename).
  if fixtures_isolated
  Dir.mktmpdir("harness-gate-selftest-labels") do |fixture_root|
    %w[groupA/test groupB/test].each do |rel|
      dir = File.join(fixture_root, rel)
      FileUtils.mkdir_p(dir)
      path = File.join(dir, "self-test.sh")
      File.write(path, "#!/bin/sh\nexit 0\n")
      FileUtils.chmod(0o755, path)
    end
    labels = self_test_checks(fixture_root).map(&:first)
    if labels.uniq.size != labels.size
      warn "self-test: FAIL — two distinct suites produced the same label: " \
           "#{labels.inspect}"
      ok = false
    end
  end
  end

  # 6-dot. DND-422: discovery must descend dot-directories. Without
  #    FNM_DOTMATCH `**/` skips them, so a committed suite (or a stray one, or a
  #    dot-prefixed hook suite) under e.g. `.auto-completions/` would silently
  #    never run and never be flagged.
  if fixtures_isolated
  Dir.mktmpdir("harness-gate-selftest-dotdir") do |fixture_root|
    { ".hidden/test/self-test.sh" => "#!/bin/sh\nexit 0\n",
      ".hidden/test/stray.sh" => "#!/bin/sh\nexit 0\n",
      "ai/hooks/.dotted.self-test.sh" => "#!/bin/sh\nexit 0\n" }.each do |rel, body|
      FileUtils.mkdir_p(File.dirname(File.join(fixture_root, rel)))
      File.write(File.join(fixture_root, rel), body)
    end
    unless discover_self_tests(fixture_root) == [".hidden/test/self-test.sh"]
      warn "self-test: FAIL — discover_self_tests missed a suite under a " \
           "dot-directory (found: #{discover_self_tests(fixture_root).inspect})"
      ok = false
    end
    unless stray_test_scripts(fixture_root) == [".hidden/test/stray.sh"]
      warn "self-test: FAIL — stray_test_scripts missed a stray under a " \
           "dot-directory (found: #{stray_test_scripts(fixture_root).inspect})"
      ok = false
    end
    unless hook_self_tests_on_disk(fixture_root) == ["ai/hooks/.dotted.self-test.sh"]
      warn "self-test: FAIL — hook_self_tests_on_disk missed a dot-prefixed hook " \
           "suite (found: #{hook_self_tests_on_disk(fixture_root).inspect})"
      ok = false
    end
  end
  end

  # 6b. run_gate's own guards, exercised as predicates/helpers against fixture
  #     roots — the zero-discovery hard-fail and the stray-suite-name warning
  #     each need their own case; nothing above reaches either branch.
  if fixtures_isolated
  Dir.mktmpdir("harness-gate-selftest-guards") do |fixture_root|
    # self_tests_found? must be false with nothing on disk, and true again
    # once a real self-test.sh exists.
    if self_tests_found?(fixture_root)
      warn "self-test: FAIL — self_tests_found? was true for a fixture root " \
           "with nothing on disk"
      ok = false
    end

    suite_dir = File.join(fixture_root, "scripts/test/only-suite")
    FileUtils.mkdir_p(suite_dir)
    suite_path = File.join(suite_dir, "self-test.sh")
    File.write(suite_path, "#!/bin/sh\nexit 0\n")
    FileUtils.chmod(0o755, suite_path)
    unless self_tests_found?(fixture_root)
      warn "self-test: FAIL — self_tests_found? was false for a fixture root " \
           "that has a real self-test.sh"
      ok = false
    end

    # stray_test_scripts must catch a misnamed suite EVEN WITHOUT the
    # executable bit (the case a suite is most likely to be committed in) and
    # must never flag the correctly-named self-test.sh sitting right next to it.
    stray_dir = File.join(fixture_root, "scripts/test/misnamed")
    FileUtils.mkdir_p(stray_dir)
    stray_path = File.join(stray_dir, "tests.sh")
    File.write(stray_path, "#!/bin/sh\nexit 0\n")
    FileUtils.chmod(0o644, stray_path) # deliberately NOT executable

    strays = stray_test_scripts(fixture_root)
    unless strays.include?("scripts/test/misnamed/tests.sh")
      warn "self-test: FAIL — stray_test_scripts did not flag a non-executable " \
           "misnamed suite (found: #{strays.inspect})"
      ok = false
    end
    if strays.include?("scripts/test/only-suite/self-test.sh")
      warn "self-test: FAIL — stray_test_scripts flagged a correctly-named " \
           "self-test.sh as stray"
      ok = false
    end
  end
  end

  # 6c. run_gate's OWN zero-discovery and stray-suite branches, not just the
  #     extracted predicates 6b already covers — a bug in the branch itself
  #     (e.g. the wrong predicate called, or a message with no Fix: line)
  #     would pass 6b and still slip through. dry_run: true stops run_gate
  #     before it would execute the real CHECKS list as a side effect.
  capture = lambda do |&block|
    old_out, old_err = $stdout, $stderr
    out, err = StringIO.new, StringIO.new
    $stdout, $stderr = out, err
    code = block.call
    [code, out.string, err.string]
  ensure
    $stdout, $stderr = old_out, old_err
  end

  if fixtures_isolated
  Dir.mktmpdir("harness-gate-selftest-rungate") do |fixture_root|
    code, _out, err = capture.call { run_gate(root: fixture_root, dry_run: true) }
    if code != 1
      warn "self-test: FAIL — run_gate(root: <empty fixture>) returned " \
           "#{code.inspect}, expected 1 (zero-discovery must hard-fail)"
      ok = false
    end
    unless err.include?("Fix:")
      warn "self-test: FAIL — run_gate's zero-discovery failure carried no " \
           "Fix: line"
      ok = false
    end

    suite_dir = File.join(fixture_root, "scripts/test/x")
    FileUtils.mkdir_p(suite_dir)
    File.write(File.join(suite_dir, "self-test.sh"), "#!/bin/sh\nexit 0\n")
    FileUtils.chmod(0o755, File.join(suite_dir, "self-test.sh"))
    File.write(File.join(suite_dir, "helper_tests.sh"), "#!/bin/sh\nexit 0\n")
    FileUtils.chmod(0o755, File.join(suite_dir, "helper_tests.sh"))

    code2, _out2, err2 = capture.call { run_gate(root: fixture_root, dry_run: true) }
    if code2 != 0
      warn "self-test: FAIL — run_gate(root: <fixture with a real suite>, " \
           "dry_run: true) returned #{code2.inspect}, expected 0"
      ok = false
    end
    unless err2.include?("helper_tests.sh") && err2.include?("Fix:")
      warn "self-test: FAIL — run_gate did not warn about the stray suite " \
           "with a Fix: line (stderr: #{err2.inspect})"
      ok = false
    end
  end
  end

  # 6d. discover_self_tests/stray_test_scripts must not promote an UNTRACKED
  #     file into the gate — a vendored/ignored tree that happens to contain a
  #     self-test.sh (this repo's own ai/skills/synced/ is exactly this shape)
  #     must never be silently executed or hard-fail the gate over its
  #     permissions. Needs a REAL git repo (tracked_files returns nil, and the
  #     filter is skipped, for a fixture root with no .git at all).
  Dir.mktmpdir("harness-gate-selftest-tracked") do |fixture_root|
    Open3.capture3("git", "-C", fixture_root, "init", "-q")
    Open3.capture3("git", "-C", fixture_root, "config", "user.email", "a@b.c")
    Open3.capture3("git", "-C", fixture_root, "config", "user.name", "test")

    tracked_dir = File.join(fixture_root, "scripts/test/tracked")
    FileUtils.mkdir_p(tracked_dir)
    tracked_path = File.join(tracked_dir, "self-test.sh")
    File.write(tracked_path, "#!/bin/sh\nexit 0\n")
    FileUtils.chmod(0o755, tracked_path)
    Open3.capture3("git", "-C", fixture_root, "add", "scripts/test/tracked/self-test.sh")
    Open3.capture3("git", "-C", fixture_root, "commit", "-q", "-m", "tracked suite")

    untracked_dir = File.join(fixture_root, "vendor/untracked")
    FileUtils.mkdir_p(untracked_dir)
    untracked_path = File.join(untracked_dir, "self-test.sh")
    File.write(untracked_path, "#!/bin/sh\nexit 0\n")
    FileUtils.chmod(0o755, untracked_path)
    # deliberately never `git add`ed — simulates a vendored/ignored tree.

    found_tracked = discover_self_tests(fixture_root)
    if found_tracked.include?("vendor/untracked/self-test.sh")
      warn "self-test: FAIL — discover_self_tests promoted an UNTRACKED " \
           "self-test.sh into the gate: #{found_tracked.inspect}"
      ok = false
    end
    unless found_tracked.include?("scripts/test/tracked/self-test.sh")
      warn "self-test: FAIL — discover_self_tests dropped a TRACKED " \
           "self-test.sh when a git repo is present: #{found_tracked.inspect}"
      ok = false
    end
  end

  # 6e. tracked_files must FAIL LOUD (GitTrackingError), never silently skip
  #     the filter, when root IS a confirmed git worktree but `git ls-files`
  #     itself errors — the ambiguity a prior version of this code collapsed
  #     (both "not a repo" and "repo, but git errored" returned nil, so a real
  #     git failure on the REAL repo would have silently let an
  #     untracked/vendored self-test.sh straight into the gate). Proven with a
  #     fake `git` on PATH that answers `rev-parse` normally but fails
  #     `ls-files`, so this exercises the exact branch, not just its shape.
  Dir.mktmpdir("harness-gate-selftest-git-fail") do |fixture_root|
    fake_bin = File.join(fixture_root, "fakebin")
    FileUtils.mkdir_p(fake_bin)
    fake_git = File.join(fake_bin, "git")
    File.write(fake_git, <<~SH)
      #!/bin/sh
      if [ "$3" = "rev-parse" ]; then exit 0; fi
      if [ "$3" = "ls-files" ]; then echo "boom: simulated git failure" >&2; exit 128; fi
      exit 1
    SH
    FileUtils.chmod(0o755, fake_git)

    old_path = ENV["PATH"]
    raised = nil
    begin
      ENV["PATH"] = "#{fake_bin}:#{old_path}"
      begin
        tracked_files(fixture_root)
        raised = false
      rescue GitTrackingError => e
        raised = true
        unless e.message.include?("ls-files") && e.message.include?("simulated git failure")
          warn "self-test: FAIL — GitTrackingError's message didn't carry the " \
               "underlying git error: #{e.message.inspect}"
          ok = false
        end
      end
    ensure
      ENV["PATH"] = old_path
    end
    unless raised
      warn "self-test: FAIL — tracked_files did not raise GitTrackingError " \
           "when a confirmed git worktree's ls-files failed (it must never " \
           "fail open into skipping the filter)"
      ok = false
    end

    # And the dispatch-level rescue turns that into a Fix:-carrying failure,
    # not a bare Ruby backtrace, end to end via a real subprocess.
    env = { "PATH" => "#{fake_bin}:#{old_path}" }
    out, status = Open3.capture2e(env, "ruby", File.join(CUSTOM_DIR, "ai/bin/harness-gate"),
                                   "--list", chdir: CUSTOM_DIR, stdin_data: "")
    if status.success?
      warn "self-test: FAIL — harness-gate --list exited 0 despite a " \
           "simulated git ls-files failure"
      ok = false
    end
    unless out.include?("Fix:") && !out.include?(":in `")
      warn "self-test: FAIL — a git-failure exit did not carry a clean Fix: " \
           "message (looks like a raw, unhandled backtrace instead): " \
           "#{out.inspect}"
      ok = false
    end
  end

  # 7. Composition, end to end: invoke the REAL `harness-gate --list` as a
  #    subprocess against the real repo (safe — it only lists, never runs the
  #    checks) and assert every real discovered suite actually reaches
  #    `CHECKS` and its printed output. This is the non-tautological check
  #    case 5 can't be: case 5 proves discover_self_tests works in isolation,
  #    but nothing there would notice `CHECKS = (STATIC_CHECKS +
  #    self_test_checks).freeze` losing its `+ self_test_checks` term, since
  #    CHECKS and the fixture calls are otherwise independent of that line. A
  #    real subprocess exercises the actual composition.
  list_ok, list_out = run_one(%w[ai/bin/harness-gate --list])
  unless list_ok
    warn "self-test: FAIL — `harness-gate --list` itself exited non-zero"
    ok = false
  end
  real_suites = discover_self_tests
  real_suites.each do |relpath|
    name = relpath.sub(%r{/self-test\.sh\z}, "")
    unless list_out.include?("self-test: #{name}")
      warn "self-test: FAIL — `harness-gate --list` did not list the real " \
           "discovered suite #{relpath.inspect} (composition at CHECKS = " \
           "STATIC_CHECKS + self_test_checks may be broken)"
      ok = false
    end
  end
  unless list_out.include?("(#{real_suites.size} of them discovered under " \
                            "**/self-test.sh)")
    warn "self-test: FAIL — `harness-gate --list`'s discovered-count summary " \
         "does not match discover_self_tests"
    ok = false
  end

  # 7b. The wrong-tree guard: git_tree_identity + foreign_gate_tree, against
  #     REAL fixture repositories (a main checkout, a linked worktree of it,
  #     and an unrelated repo), because the whole defect class lives in git's
  #     own path-format behaviour and a hand-built fixture would just encode
  #     whatever this code already believes.
  Dir.mktmpdir("harness-gate-tree") do |dir|
    # -c core.excludesFile= : a global excludes file leaks into throwaway
    # repos on this machine and has silently emptied fixture repos before.
    mk = lambda do |path|
      FileUtils.mkdir_p(path)
      Open3.capture3("git", "-c", "init.defaultBranch=main", "init", "-q", path)
      File.write(File.join(path, "f"), "x")
      Open3.capture3("git", "-C", path, "add", "f")
      Open3.capture3({ "GIT_AUTHOR_NAME" => "t", "GIT_AUTHOR_EMAIL" => "t@t",
                       "GIT_COMMITTER_NAME" => "t", "GIT_COMMITTER_EMAIL" => "t@t" },
                     "git", "-C", path, "commit", "-qm", "init")
    end

    main_co = File.join(dir, "repo")
    other   = File.join(dir, "other")
    wt      = File.join(dir, "wt")
    sub     = File.join(main_co, "sub")
    plain   = File.join(dir, "plain")
    mk.call(main_co)
    mk.call(other)
    FileUtils.mkdir_p(sub)
    FileUtils.mkdir_p(plain)
    _o, e, st = Open3.capture3("git", "-C", main_co, "worktree", "add", "-q", "-b", "lane", wt)

    if !st.success? || !File.directory?(wt)
      warn "self-test: FAIL — could not build the worktree fixture: #{e.strip}"
      ok = false
    else
      # THE MISS CASE, and the reason this fixture is a real worktree: a main
      # checkout's --git-common-dir is the RELATIVE ".git". If the expansion in
      # git_tree_identity were dropped, main and its own worktree would compare
      # as different repositories and the next assertion would silently pass by
      # not firing. Assert the absoluteness directly too, so the miss is named
      # rather than inferred.
      id_main = git_tree_identity(main_co)
      id_wt   = git_tree_identity(wt)
      if id_main.nil? || id_wt.nil?
        warn "self-test: FAIL — git_tree_identity returned nil for a real git tree"
        ok = false
      else
        unless id_main[1].start_with?("/") && id_wt[1].start_with?("/")
          warn "self-test: FAIL — git_tree_identity returned a NON-ABSOLUTE repo " \
               "identity (#{id_main[1].inspect} / #{id_wt[1].inspect}) — the " \
               "cwd-relative --git-common-dir trap is back"
          ok = false
        end
        unless id_main[1] == id_wt[1]
          warn "self-test: FAIL — a main checkout and its own linked worktree did " \
               "NOT resolve to the same repo identity (#{id_main[1].inspect} vs " \
               "#{id_wt[1].inspect}); the guard can never fire"
          ok = false
        end
        if id_main[0] == id_wt[0]
          warn "self-test: FAIL — a main checkout and its worktree resolved to the " \
               "SAME worktree root; the guard would never fire"
          ok = false
        end
      end

      # Fires: same repo, different tree — in BOTH directions.
      [[wt, main_co], [main_co, wt]].each do |(from, gate)|
        if foreign_gate_tree(gate_root: gate, cwd: from).nil?
          warn "self-test: FAIL — foreign_gate_tree did NOT refuse gating #{gate} " \
               "from #{from} (same repo, different worktree)"
          ok = false
        end
      end

      # Does NOT fire: same tree, a subdirectory of it, an unrelated repo, a
      # non-repo directory, and an unresolvable path. Each of these is a
      # deliberate allow, not an oversight.
      {
        "same tree"          => [main_co, main_co],
        "subdirectory"       => [main_co, sub],
        "unrelated repo"     => [main_co, other],
        "not a repo at all"  => [main_co, plain],
        "nonexistent cwd"    => [main_co, File.join(dir, "nope")],
      }.each do |why, (gate, from)|
        unless foreign_gate_tree(gate_root: gate, cwd: from).nil?
          warn "self-test: FAIL — foreign_gate_tree wrongly refused (#{why}): " \
               "gate=#{gate} cwd=#{from}"
          ok = false
        end
      end

      # THE MISS, driven rather than inferred. The relative-".git" form comes
      # back only from a MAIN checkout, and the real main checkout is not
      # something a self-test may chdir into, so stub `git` to return it
      # unconditionally and assert the EXPANSION — that the identity comes
      # back as an absolute path under the tree git was asked about, and NOT
      # as ".git" resolved against whatever cwd the suite happened to run in.
      # With `File.expand_path(common, dir)` deleted, File.realpath(".git")
      # resolves against the caller's cwd, yields a different repo identity
      # than the worktree's, and the refusal above silently never fires — a
      # green suite guarding nothing.
      stub_dir = File.join(dir, "stubbin")
      FileUtils.mkdir_p(stub_dir)
      stub = File.join(stub_dir, "git")
      File.write(stub, <<~SH)
        #!/bin/sh
        for a in "$@"; do
          case "$a" in
            --show-toplevel)    echo "#{main_co}"; exit 0 ;;
            --git-common-dir)   echo ".git";       exit 0 ;;
          esac
        done
        exit 0
      SH
      FileUtils.chmod(0o755, stub)
      old_path = ENV["PATH"]
      begin
        ENV["PATH"] = "#{stub_dir}:#{old_path}"
        stubbed = git_tree_identity(main_co)
        want = File.realpath(File.join(main_co, ".git"))
        if stubbed.nil? || stubbed[1] != want
          warn "self-test: FAIL — a CWD-RELATIVE --git-common-dir resolved to " \
               "#{stubbed.inspect} instead of #{want.inspect}; the expansion in " \
               "git_tree_identity is gone, so a main checkout and its own " \
               "worktree compare as different repositories and the wrong-tree " \
               "refusal can never fire"
          ok = false
        end
      rescue TreeIdentityError => e
        warn "self-test: FAIL — a relative --git-common-dir raised instead of " \
             "being expanded against the directory git was asked about: #{e.message}"
        ok = false
      ensure
        ENV["PATH"] = old_path
      end
    end
  end

  # 8. run_one reports PASS/FAIL correctly and closes stdin.
  Dir.mktmpdir("harness-gate-selftest") do |dir|
    passing = File.join(dir, "pass.sh")
    failing = File.join(dir, "fail.sh")
    reads   = File.join(dir, "reads-stdin.sh")
    File.write(passing, "#!/bin/sh\nexit 0\n")
    File.write(failing, "#!/bin/sh\necho boom\nexit 1\n")
    # Exits 0 only if stdin is at EOF -- i.e. the runner closed it rather than
    # leaving the check blocked on a terminal.
    File.write(reads, "#!/bin/sh\nif cat >/dev/null; then exit 0; else exit 1; fi\n")
    [passing, failing, reads].each { |p| FileUtils.chmod(0o755, p) }

    good_ok, = run_one([passing], chdir: dir)
    unless good_ok
      warn "self-test: FAIL — a passing check was reported as FAIL"; ok = false
    end

    bad_ok, bad_out = run_one([failing], chdir: dir)
    if bad_ok
      warn "self-test: FAIL — a failing check was reported as PASS"; ok = false
    end
    unless bad_out.to_s.include?("boom")
      warn "self-test: FAIL — a failing check's output was not captured"; ok = false
    end

    stdin_ok, = run_one([reads], chdir: dir)
    unless stdin_ok
      warn "self-test: FAIL — run_one did not close stdin for the check"; ok = false
    end
  end

  # 9. The failure report NAMES the failing case even when a chatty suite has
  #    pushed it far beyond the tail. This is the whole point of failure_lines:
  #    a tail-only report of a 119-case suite shows 20 passing cases and a
  #    total, and the reader cannot act on it. Shaped like the real thing — one
  #    buried FAIL line, then well over FAIL_TAIL_LINES lines of `ok` after it.
  buried = (["  FAIL  the case that actually broke"] +
            Array.new(FAIL_TAIL_LINES + 10) { |i| "  ok    case #{i}" } +
            ["118 passed, 1 failed"]).join("\n")
  hits = failure_lines(buried)
  if hits.none? { |l| l.include?("the case that actually broke") }
    warn "self-test: FAIL — failure_lines did not surface a FAIL line buried " \
         "beyond the tail (the gate would report a failure while showing only " \
         "passing lines)"
    ok = false
  end
  # And it must NOT fire on a clean suite, or every green check would print a
  # "failure lines" block (noise that trains the reader to skim past a real one).
  clean = (Array.new(5) { |i| "  ok    case #{i}" } + ["119 passed, 0 failed"]).join("\n")
  unless failure_lines(clean).empty?
    warn "self-test: FAIL — failure_lines matched a clean suite's output " \
         "(#{failure_lines(clean).inspect})"
    ok = false
  end

  # 10 (DND-404). check-inbox-mock-orphans's REAP invocation (FINAL_CHECKS)
  #    must stay the LAST entry in CHECKS — it backstops
  #    scripts/test/inbox-client-capture's self-test, so it must run after
  #    that suite (and after every other check). Nothing else enforces the
  #    concatenation order; a future refactor of the CHECKS assignment could
  #    silently move it earlier with no other symptom, so assert it directly.
  unless CHECKS.last == ["check-inbox-mock-orphans", %w[ai/bin/check-inbox-mock-orphans]]
    warn "self-test: FAIL — check-inbox-mock-orphans is not the LAST entry in " \
         "CHECKS (currently: #{CHECKS.last.inspect}). Fix: keep " \
         "`STATIC_CHECKS + self_test_checks + FINAL_CHECKS`, in that order, in " \
         "the CHECKS assignment — FINAL_CHECKS must be concatenated last."
    ok = false
  end

  if ok
    puts "harness-gate: self-test OK (#{CHECKS.size} checks declared, " \
         "#{discover_self_tests.size} of them discovered self-test suites)"
    0
  else
    warn "harness-gate: self-test FAILED"
    warn "  Fix: repair CHECKS in ai/bin/harness-gate so every declared check is " \
         "executable and every hook is invoked via its dedicated .self-test.sh " \
         "script (never `<hook>.sh --self-test`, which is a false green); keep " \
         "every scripts/setup-* installer's --self-test declared or delegated " \
         "(SELF_TEST_DELEGATES); keep discover_self_tests/self_test_checks " \
         "finding every real **/self-test.sh, flipping a fixture " \
         "suite red/green, and labeling distinct suites uniquely; keep " \
         "self_tests_found?/stray_test_scripts correct against a fixture " \
         "root; and keep run_one reporting the child's exit status with " \
         "stdin closed."
    1
  end
end

if ARGV.include?("--help") || ARGV.include?("-h")
  puts <<~TXT
    Usage:
      ai/bin/harness-gate              run every gate check in its verified-correct
                                       invocation form; prints PASS/FAIL per check
                                       and exits non-zero if any fails
      ai/bin/harness-gate --list       list the checks without running them
      ai/bin/harness-gate --self-test  assert the declared check list stays correct
                                       and complete (no model)
      ai/bin/harness-gate --help       this text

    Run the copy that belongs to the tree you are about to commit in —
    `cd <your worktree> && ./ai/bin/harness-gate`. Every check resolves its
    inputs beside this script, so another tree's copy measures that tree, not
    yours; the gate names the tree it gated and refuses a same-repo mismatch.
    Never commit a harness that fails its own gate.
  TXT
  exit 0
end

begin
  exit(
    if ARGV.include?("--self-test") then run_self_test
    elsif ARGV.include?("--list") then run_list
    else run_gate
    end
  )
rescue TreeIdentityError => e
  # git handed back a repo identity that is malformed FOR ITS TYPE (a relative
  # path where the contract says absolute). Per CLAUDE.md -> "A failed lookup
  # must never look like an empty one", that is an error at the point of
  # production, not a no-match — but it must still reach the reader as a Fix:
  # message rather than a bare Ruby backtrace.
  warn "harness-gate: FAILED — could not establish which tree is being gated: #{e.message}"
  warn "  Fix: this is a git-resolution fault, not a harness-content failure — " \
       "the gate refuses to run rather than report PASS/FAIL about a tree it " \
       "cannot name. Check `git -C . rev-parse --path-format=absolute " \
       "--git-common-dir` works and that #{CUSTOM_DIR} is a readable git " \
       "worktree. Do NOT make this pass by dropping the absolute-path check in " \
       "git_tree_identity: a cwd-relative --git-common-dir is exactly what " \
       "makes a main checkout and its own worktree compare as different " \
       "repositories, which silently disables the wrong-tree refusal."
  exit 1
rescue GitTrackingError => e
  # A confirmed git worktree whose `ls-files` itself failed (never raised for
  # "this isn't a repo" — see tracked_files). Must never surface as a bare
  # Ruby backtrace.
  warn "harness-gate: FAILED — #{e.message}"
  warn "  Fix: ensure `git` is on PATH and #{CUSTOM_DIR} is a readable git " \
       "worktree (try `git -C #{CUSTOM_DIR} status`), then re-run " \
       "ai/bin/harness-gate. Discovery refuses to silently skip its " \
       "tracked-file filter here, since that could promote an " \
       "untracked/vendored self-test.sh into the blocking gate."
  exit 1
end
