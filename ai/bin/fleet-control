#!/usr/bin/env bash
# fleet-control -- the one harness reader of a fleet session's control state
# (run or drain). FRAMEWORK: parse argv, hand off to the manager. Normative
# home: ai/contracts/athena-events.md -> *Fleet registry and session control*
# (DND-441 server, DND-443 this reader, the drain guard hook, and the admiral
# checkpoint; DND-484 the resume waiter and the foreign-line rule).

set -u

usage() {
  cat <<'EOF'
Usage: fleet-control <check|fetch|wait|own> [flags]

Read this Claude session's control state from the Athena server
(GET /api/v1/fleet/sessions/<id>/control; athena-events.md -> Reading control
state and the control cache).

Subcommands:
  check   Ask the server (bounded timeout). On an answer, cache it and print it.
          With no usable answer, recompute from the cached policy snapshot; with
          no usable cache, apply the owner's local rule. Prints ONE line:
            desired=<run|drain> reason=<r> until=<ISO time|unbounded> basis=<b>
          basis: server | recomputed:<cause>[,expired-cache] | local-rule:<cause>,<cause>
          Every basis but `server` also prints a WARNING line on stderr.
          Exit 0 = run, 3 = drain. Any other exit is an error: never read it as run.
  fetch   Ask the server and write the cache; nothing else.
          Exit 0 cached, 1 local configuration / cache unwritable,
          3 refused or session unregistered, 4 unreachable, 5 malformed answer.
  wait    The resume waiter (athena:fleet-drain -> Arming the resume waiter).
          Poll `check` every --interval seconds until the server says run, for
          at most --budget seconds. It reads no inbox file, lock or offset.
          Exit 0 ONLY on desired=run with basis=server (stdout: the check line;
          then run athena:fleet-drain -> Resume). A drain, and any recomputed or
          local-rule answer, keeps polling: a non-server run is never a resume.
          One stderr line per basis change, never one per poll.
          Exit 75 = budget elapsed: re-arm, this is not "all clear".
          Exit 2 (with Fix:) = session-unregistered, server-refused,
          server-unconfigured, invalid-cache-path, or a missing/unsafe session
          id or bad flag: re-arming will not help. Exit 1 = faulted.
  own     Is an inbox fleet.session.control_changed line addressed to this
          session? Prints `own` (exit 0) only when --line-session-id equals
          this session's id; anything else, including an empty, absent or
          unsafe id, prints `foreign` (exit 3): ack it, count it, act on nothing.

Flags (any order):
  --session-id S   top-level Claude session id (default: $CLAUDE_CODE_SESSION_ID)
  --cwd DIR        the session's directory, for the local rule's project
                   (default: the current directory)
  --now EPOCH      evaluate at this instant instead of the clock (check only;
                   for diagnosis and tests -- the drain guard never passes it)
  --interval S     wait: seconds between polls (default 60, env
                   FLEET_WAIT_INTERVAL_S; 1..3600)
  --budget S       wait: seconds before exit 75 (default: the athena:inbox
                   waiter's mode policy, lib/budget.sh -- 1800 interactive, 540
                   headless; below the mode's ceiling, which is refused, never
                   clamped). The budget, ceiling and mode go to stderr first.
  --line-session-id S  own: the line's payload claude_session_id
  --help           this text
  --self-test      run the fleet-control suite (fake server; never prod)

Causes (never shared): server-unconfigured, server-unreachable, server-refused,
session-unregistered, malformed-answer; expired-cache, no-cache,
malformed-cache, invalid-cache-path.

Cache: $XDG_STATE_HOME/athena/fleet/<session-id>.json (the answer + fetched_at).
The token is read from ~/.config/athena-inbox-client/config.json and fed to
curl on stdin, never argv. Environment (optional): ATHENA_INBOX_CLIENT_CONFIG,
FLEET_CLAUDE_JSON, ATHENA_INBOX_ROOT, XDG_STATE_HOME, FLEET_CONNECT_TIMEOUT_S
(default 3), FLEET_MAX_TIME_S (default 5).
EOF
}

SELF="$(realpath -- "${BASH_SOURCE[0]}")"
AI="$(cd -- "$(dirname -- "${SELF}")/.." && pwd -P)"
INBOX_LIB="${AI}/skills/athena:inbox/lib"

die_usage() {
  printf 'fleet-control: %s. Fix: %s\n' "$1" "${2:-run fleet-control --help for the subcommands and flags.}" >&2
  exit 2
}

for a in "$@"; do
  case "${a}" in
    -h|--help) usage; exit 0 ;;
    --self-test) exec "${AI}/lib/fleet/test/control/self-test.sh" ;;
  esac
done

for dep in jq curl date; do
  command -v "${dep}" >/dev/null 2>&1 || { printf 'fleet-control: %s is not on PATH, so control state cannot be read. Fix: install %s.\n' "${dep}" "${dep}" >&2; exit 1; }
done

# shellcheck source=../lib/fleet/domain.sh
. "${AI}/lib/fleet/domain.sh"
# shellcheck source=../lib/fleet/control-domain.sh
. "${AI}/lib/fleet/control-domain.sh"
# shellcheck disable=SC1091
for f in err names descriptor logchan maildir fence session fs lock inbox; do . "${INBOX_LIB}/${f}.sh"; done
# shellcheck source=../lib/fleet/effects.sh
. "${AI}/lib/fleet/effects.sh"
# shellcheck source=../lib/fleet/control-effects.sh
. "${AI}/lib/fleet/control-effects.sh"
# shellcheck source=../lib/fleet/manager.sh
. "${AI}/lib/fleet/manager.sh"
# shellcheck source=../lib/fleet/control-manager.sh
. "${AI}/lib/fleet/control-manager.sh"
# shellcheck source=../lib/fleet/control-wait.sh
. "${AI}/lib/fleet/control-wait.sh"
# shellcheck disable=SC1091
. "${INBOX_LIB}/budget.sh"

# The drain guard waits on this synchronously, so the read is short.
export FLEET_CONNECT_TIMEOUT_S="${FLEET_CONNECT_TIMEOUT_S:-3}"
export FLEET_MAX_TIME_S="${FLEET_MAX_TIME_S:-5}"

FLEET_POST_TMP=""
trap 'fleet_wait_reap; [ -n "${FLEET_POST_TMP}" ] && rm -rf -- "${FLEET_POST_TMP}"' EXIT
trap 'exit 143' TERM INT HUP

sub="" session_id="${CLAUDE_CODE_SESSION_ID:-}" cwd="${PWD}" now=""
interval="${FLEET_WAIT_INTERVAL_S:-60}" interval_given="" budget="" line_sid="" line_given=""

need_value() { [ "$#" -ge 2 ] && [ -n "$2" ] || die_usage "$1 needs a value"; }

while [ "$#" -gt 0 ]; do
  case "$1" in
    --session-id) need_value "$@"; session_id="$2"; shift 2 ;;
    --cwd)        need_value "$@"; cwd="$2"; shift 2 ;;
    --now)        need_value "$@"; now="$2"; shift 2 ;;
    --interval)   need_value "$@"; interval="$2"; interval_given=1; shift 2 ;;
    --budget)     need_value "$@"; budget="$2"; shift 2 ;;
    # A line's id may be empty or absent: both read as foreign, never an error.
    --line-session-id) [ "$#" -ge 2 ] || die_usage "$1 needs a value"; line_sid="$2"; line_given=1; shift 2 ;;
    -*)           die_usage "unknown flag $1" ;;
    *)
      [ -z "${sub}" ] || die_usage "unexpected argument $1 (subcommand already ${sub})"
      sub="$1"; shift ;;
  esac
done

[ -n "${sub}" ] || die_usage "no subcommand given"
case "${sub}" in check|fetch|wait|own) ;; *) die_usage "unknown subcommand ${sub@Q}" ;; esac
[ -n "${session_id}" ] || die_usage "no session id: --session-id is unset and so is \$CLAUDE_CODE_SESSION_ID" \
  "pass --session-id <top-level claude session id>, or run from inside a Claude Code session."
fleet_valid_id "${session_id}" || die_usage "session id ${session_id@Q} is not a valid id" \
  "pass the top-level session_id exactly as Claude Code gives it (letters, digits, . _ -)."
case "${cwd}" in /*) ;; *) die_usage "--cwd ${cwd@Q} is not absolute" "pass the session's absolute working directory." ;; esac
if [ -n "${now}" ]; then
  [ "${sub}" = "check" ] || die_usage "--now is for check only"
  [[ "${now}" =~ ^[0-9]{1,12}$ ]] || die_usage "--now ${now@Q} is not epoch seconds"
fi
[ "${sub}" = "wait" ] || [ -z "${interval_given}${budget}" ] || die_usage "--interval and --budget are for wait only"
[ "${sub}" = "own" ] || [ -z "${line_given}" ] || die_usage "--line-session-id is for own only"

case "${sub}" in
  check) fleet_control_check "${session_id}" "${cwd}" "${AI}" "${now}" ;;
  fetch) fleet_control_fetch "${session_id}" "${cwd}" "${AI}" "${now}" ;;
  own)
    fleet_control_line_is_own "${line_sid}" "${session_id}" && exit 0
    exit 3 ;;
  wait)
    # The trap lists the in-flight poll's process tree with pgrep before it
    # kills it; without pgrep an orphaned curl would outlive the waiter.
    command -v pgrep >/dev/null 2>&1 || { printf 'fleet-control: pgrep is not on PATH, so wait could not reap its in-flight request on exit. Fix: install procps (it provides pgrep).\n' >&2; exit 1; }
    [[ "${interval}" =~ ^[0-9]{1,4}$ ]] && [ "$((10#${interval}))" -ge 1 ] && [ "$((10#${interval}))" -le 3600 ] \
      || die_usage "--interval / FLEET_WAIT_INTERVAL_S ${interval@Q} is not a whole number of seconds from 1 to 3600" \
           "pass --interval <seconds> (default 60); a sub-second poll is the hammering the safe-wait rule forbids."
    interval=$((10#${interval}))
    budget_line="$(inbox_wait_budget "${CLAUDE_CODE_ENTRYPOINT:-}" "${CLAUDE_CODE_SESSION_ATTENDED:-}" \
      "${CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS:-}" "")" || exit 2
    IFS=$'\t' read -r b_mode b_default b_ceiling b_why <<<"${budget_line}"
    if [ -n "${budget}" ]; then
      [[ "${budget}" =~ ^[0-9]{1,9}$ ]] && [ "$((10#${budget}))" -ge 1 ] \
        || die_usage "--budget ${budget@Q} is not a positive whole number of seconds" \
             "pass --budget <seconds> below ${b_ceiling} (the ${b_mode}-mode ceiling), or omit it for the ${b_default}s default."
      [ "$((10#${budget}))" -lt "${b_ceiling}" ] \
        || die_usage "--budget ${budget}s is at or over the ${b_ceiling}s ceiling for this ${b_mode}-mode session (${b_why})" \
             "pass a budget below ${b_ceiling}. It is refused, not clamped: a headless waiter killed at the ceiling vanishes without a timeout, and the session waiting on it is never told."
      budget=$((10#${budget})); b_why="${b_why}; --budget override"
    else
      budget="${b_default}"
    fi
    printf 'fleet-control: wait: budget %ss, ceiling %ss, mode %s: %s; polling session %s every %ss.\n' \
      "${budget}" "${b_ceiling}" "${b_mode}" "${b_why}" "${session_id}" "${interval}" >&2
    fleet_control_wait "${session_id}" "${cwd}" "${AI}" "${interval}" "${budget}" ;;
esac
exit $?
