#!/usr/bin/ruby
# frozen_string_literal: true

# lead-time-phases -- the per-landing phase ledger and its rolling-window
# summary (DND-1477; design: ai/docs/lead-time-improver.md, Decisions 3-6).
#
#   --ingest   lists every landing since the repo's cursor (ai/bin/lead-time,
#              DND-1009), splits each into implement / verify / queue /
#              integrate / merge plus counters, appends new rows to the ledger
#              (idempotent on repo + landed commit + ticket), and moves the
#              cursor to the scan's scanned_through. Never on SCAN INCOMPLETE.
#              Receipts, verdicts and timings join on the GATED head: the
#              landed commit for a push (or the head a clean rebase came
#              from, else the ticket's one gated head: DND-1809), the PR
#              head (lead-time's
#              head_commit) for a squash merge (DND-1490). --rejoin backfills
#              merge rows ledgered without one; see --help.
#   --summary  median, p90 and sum per phase over the last N landings, the
#              biggest contributor (a phase, or tail when the window has a
#              measured nonzero tail; with its lever, harness or product:
#              DND-1532), and the quality guards.
#
# A phase it cannot measure is null with a reason, never 0. The repo list and
# modes resolve through ai/lib/lead_time_config_io.rb (ai/bin/lead-time-repos,
# DND-1526): the tracked ai/config/lead-time-repos.json, or this machine's
# override.
#
# Buckets: FRAMEWORK (argv, output) and MANAGER (Setup, Ingest, Summary) here; DOMAIN
# in ai/lib/lead_time_phases.rb; SIDE EFFECTS in ai/lib/lead_time_phases_io.rb.
#
# Test seams (tests only):
#   LEAD_TIME_STATE_DIR          the state dir (default: <main checkout>/ai-artifacts/lead-time)
#   LEAD_TIME_PHASES_LEAD_TIME   the lead-time executable (default ai/bin/lead-time)
#   ATHENA_LEADTIME_CONFIG       the config file (see ai/bin/lead-time-repos --help)
#   LEAD_TIME_PHASES_NOW         "now", RFC 3339 (the 14-day backfill start)
#   ATHENA_TELEMETRY_DIR         the telemetry store (DND-1473's own seam)
#   XDG_STATE_HOME               where harness-gate's timings.jsonl lives
#
# Exit: 0 ok; 1 a tool or state error (a config that could not be read
# included); 2 a usage or config refusal; 3 SCAN INCOMPLETE (nothing
# ingested, the cursor unchanged); 4 the --repo is configured but skipped on
# this machine.

require "json"
require "time"
require "open3"
require_relative "../lib/strict_argv"
require_relative "../lib/lead_time_phases"
require_relative "../lib/lead_time_phases_io"
require_relative "../lib/lead_time_config_io"

AI_DIR = File.expand_path("..", __dir__)
BACKFILL_DAYS = 14

HELP = <<~TXT
  Usage:
    ai/bin/lead-time-phases --ingest --repo NAME [--since WHEN [--rejoin]]
    ai/bin/lead-time-phases --summary --repo NAME [--window N] [--json]
    ai/bin/lead-time-phases --self-test

  Split every landing on a repo's main into phases and summarize them
  (DND-1477; ai/docs/lead-time-improver.md, Decisions 3-6).

  Standalone-PASS flow (a clean critic PASS stood before integration-gate):
    implement  dispatch stamp -> first harness_gate.run or gate.run for the ticket
    verify     first gate run -> last critic PASS before integration-gate
    queue      that PASS -> the integration_gate.run start
    integrate  the integration_gate.run's duration
    merge      integration end (receipt recorded_at as fallback) -> landing

  --with-critic flow (DND-1501): no PASS stood before the last successful
  integration_gate.run, the run is marked with_critic, and its critic judged
  a clean PASS inside it (the captain's own `integration-gate --with-critic`):
    implement  as above
    verify     first gate run -> that run's start (fix rounds, re-gates and
               earlier integration attempts included)
    integrate  that run's duration
    queue      that run's end -> the landing start
    merge      the landing start -> landing
  The landing start is the earliest, at or after the run's end, of the
  first merge.lock_wait (locked-merge) and the start of a timed
  merge.landed push (gh-athena: at = push start, duration_s = its wall).
  A push before DND-1501 was a point event, so those landings have no
  landing start: queue and merge are n/a with that reason. The custom ff
  landing's hand-held lock writes no merge.lock_wait (DND-1370), so its
  fetch and rebase under the lock read as queue.
  A standalone-PASS landing reads as before DND-1501. A with-critic
  landing does not: its old merge (run end -> landing) is now queue +
  merge. Rows are frozen at ingest, so a row ingested before DND-1501 keeps
  its old reading (no phase_flow), and verify, queue and merge are not
  comparable across that boundary; implement and integrate are.
  Each improve row records `phase_flow` (with_critic | standalone; none
  on a foreign row) and `phases.verify.gate_runs_s`: the gate-run wall
  (harness_gate.run or gate.run, each clipped to verify) inside verify, to
  split machine time from fix time. Concurrent runs each count, so it can
  exceed verify; critic time is not in it.

  Push landings (DND-1809). A push's commit is the gated head only when
  the admiral pushed that head unchanged. After a clean rebase onto a
  moved main it is not, so ingest finds the head that was gated, in this
  order: the landed commit itself (its integration receipt, or a
  successful integration_gate.run on it); the receipts' clean-rebase cover
  (ir_push_covered in ai/lib/integration-receipt.sh, onto the `before` of
  the push's merge.landed); the ticket's one successful run head, only when
  the cover could not judge (no pre-push main recorded, or the rule could
  not run), and named as not tree-checked. The first step that finds
  anything decides, and it must find exactly one head. Two candidates, or
  none, keeps the landed commit as the
  key: the row's gated_head_miss says what was searched (gated_head_search
  in full), and the n/a reasons carry it. A joined row records
  gated_head_source. Rows ingested before this are not re-derived.

  No gate before the final integration run (DND-1819). Verify is the
  captain's time between the first gate run and the final integration
  attempt. When the unit's first gate run is the one inside its final
  integration run, that window is empty: verify is a measured 0 that
  starts where it ends (the run's start in the with-critic flow, the PASS
  in the standalone flow, which then stands before the first gate run),
  and implement ends there too, so the phases still telescope. Each
  measured (or invalid) cell that reads that start carries a `basis`
  naming the shape; the row's gate_first anchor stays the real first gate
  run. A first gate in the run's own second already read verify 0 in the
  with-critic flow and is left as it was. Two neighbouring shapes are n/a
  with a reason naming them, never "invalid": a first gate run after a
  final run with no recorded end (inside cannot be told), and, standalone,
  a PASS before a first gate run that ran before the final run (the
  captain gated after the PASS, so no PASS ends verify). Residual: the
  first gate run is the first LOCAL one recorded for the unit, so a gate
  run that left no local event (another machine, a failed telemetry write,
  counted in write-failures) reads as none, and verify reads 0; the basis
  says so. Rows ingested before this are not re-derived.

  A phase whose anchor is missing is null with a reason; one whose anchors
  are out of order in any other way (a gate run before the dispatch stamp,
  a first gate run after the final run ended) is "invalid" with a reason.
  Never 0 for a missing input, never negative.

  Origin (DND-1531). Telemetry is machine-local, so --ingest records where
  each improve landing was worked:
    foreign    ticketed and stamped; the store is readable and its first
               ticket.dispatched (any unit) is at or before the stamp; and
               nothing local for it: no event of any kind (any repo), no
               integration receipt, critic verdict or harness-gate timings.
               Its five phases are null with "worked on another machine (no
               local events for <unit>)". Its forge totals are kept.
    local      any of that evidence found here.
    null       neither: `origin_na` says why (no store, no stamp,
               unticketed, a dispatch before the store recorded any). The
               row counts as before.
  --summary leaves foreign rows out of the phase stats and the biggest pick
  (tail included) and keeps them in the totals. It reports `foreign: N`
  beside the rows and names each foreign unit. N is null, never 0, when no
  row's origin was decided.

  Modes:
    --ingest       read the repo's cursor (none: a 14-day backfill), run
                   ai/bin/lead-time --since CURSOR --json --meta, join each
                   landing with telemetry, integration receipts, critic
                   verdicts and harness-gate timings, append new rows to
                   <state>/ledger.jsonl, and move the cursor to the scan's
                   scanned_through. On SCAN INCOMPLETE: nothing is ingested,
                   the cursor stays, exit 3.
    --summary      per phase over the last N landings (batches counted
                   once): n, n/a with the top reasons, median and p90
                   (nearest rank), summed time; the biggest contributor; the
                   critic BLOCK rate, gate red rate and reverts on main;
                   telemetry status and write-failures.
                   The biggest contributor is the phase with the largest
                   sum, or `tail` (landing -> deploy, from lead-time) when
                   the window has a measured nonzero tail and its sum is
                   larger (a tie goes to the phase). `lever` says where the
                   fix lands: `harness` for a phase, `product` (the repo's
                   own CI and deploy) for tail. With no measured nonzero
                   tail in the window, tail is never a candidate; --json
                   says why in biggest.tail_reason. A forge lead-time
                   could not read is SCAN INCOMPLETE, so it never reaches
                   the ledger as a 0.
                   unattributed (DND-1501): over the local rows with a
                   measured code_s, code minus the measured phases,
                   summed; n/a phases leave their time here, so an anchor
                   gap shows as a number. n_na counts rows with no code_s.
                   flows: the local rows per phase_flow (with_critic,
                   standalone, unrecorded = no phase_flow: ingested
                   before DND-1501, or a watch row).
                   Post-merge CI (DND-1614): the repo's idle_workflow
                   (ai/bin/lead-time-repos) also declares it for the tail.
                     a workflow file  CI declared: every 0 tail with no
                                      post-merge run found (end kind
                                      merge, or none recorded) is n/a
                                      with a reason naming the
                                      declaration, never a measured 0,
                                      even when no landing has a run.
                     "none"           no CI declared: a 0 tail is a
                                      measured 0. A nonzero tail stays
                                      measured, and the summary warns
                                      that N landing(s) have a run.
                     absent           inferred from the window: CI when
                                      a landing has a measured nonzero
                                      tail, then as for a workflow file;
                                      else as for "none", without the
                                      warning. The reason says it was
                                      inferred.
                   `lead` is not adjusted: it ends at the landing when no
                   run was found. --json carries tail_ci: {"source":
                   "declared"|"inferred", "value": true|false, and
                   "mismatch": N for a "none" repo with runs}.
    --self-test    run the domain and IO suites.

  Options:
    --repo NAME    a repo in this machine's lead-time repo list
                   (ai/bin/lead-time-repos)
    --since WHEN   with --ingest: scan from WHEN instead of the cursor
                   (YYYY-MM-DD or RFC 3339 with a zone). An explicit --since
                   run never moves the cursor.
    --rejoin       with --ingest and --since: the ledger is first-write-wins,
                   so a plain re-ingest never rewrites a row. This replaces
                   each merge landing ledgered with no gated head (before
                   DND-1490, or its PR head unread) with this scan's row, if
                   that row found the head and lost no measurement the
                   original has. The new row is a full recompute (phases,
                   counters, ingested_at). Every original is appended to
                   <state>/ledger-replaced.jsonl first; no other row changes.
                   It prints each rejoinable row it did not replace, by
                   cause. A rejoin moves past summaries: run it when no
                   experiment is pending, or judge that experiment
                   inconclusive.
    --window N     with --summary: the last N landings (default: the config's)
    --json         with --summary: JSON instead of the table
    --help         this text

  State: <main checkout>/ai-artifacts/lead-time/ (gitignored), or
  LEAD_TIME_STATE_DIR. A repo in `watch` mode gets lead/code/tail only; its
  phases are n/a by design.

  Exit: 0 ok; 1 tool or state error (a config that could not be read
  included); 2 usage or config refusal; 3 SCAN INCOMPLETE; 4 the --repo is
  configured but skipped on this machine (its checkout is missing; nothing
  is read or written).
TXT

SPEC = { "--ingest" => :switch, "--summary" => :switch, "--self-test" => :switch, "--repo" => :value,
         "--since" => :value, "--window" => :integer, "--json" => :switch, "--rejoin" => :switch }.freeze

def fail_with(code, what, fix)
  warn "lead-time-phases: #{what}"
  warn "Fix: #{fix}"
  code
end

def env_now(env)
  raw = env["LEAD_TIME_PHASES_NOW"].to_s
  raw.empty? ? Time.now.utc : Time.iso8601(raw).utc
end

# ── MANAGER: setup ──────────────────────────────────────────────────────────

# Resolves what both modes need: the config and the repo, --since, and the
# state dir. -> [Context, nil] or [nil, exit code] (having said why).
module Setup
  Context = Struct.new(:config, :repo, :since, :state, keyword_init: true)

  module_function

  def resolve(opts, env)
    config = LeadTimeConfigIO.resolve(env)
    repo = config.find(opts["--repo"])
    since = nil
    if opts["--since"]
      since, why = LeadTimePhasesIO::LeadTimeLib.parse_since(opts["--since"])
      return [nil, fail_with(2, "usage error: #{why}", "pass --since as YYYY-MM-DD or RFC 3339 with a zone")] unless since
    end
    state, why = state_dir(env)
    return [nil, fail_with(1, "cannot resolve the state dir: #{why}", "set LEAD_TIME_STATE_DIR, or run from a checkout of ~/dev/custom")] unless state

    [Context.new(config: config, repo: repo, since: since, state: state), nil]
  end

  # <main checkout>/ai-artifacts/lead-time, from this tool's own git common
  # dir, so a worktree's copy writes the one machine-wide state dir.
  def state_dir(env)
    dir = env["LEAD_TIME_STATE_DIR"].to_s
    return [dir, nil] unless dir.empty?

    common, why = LeadTimePhasesIO::Git.common_dir(AI_DIR)
    return [nil, why] unless common

    [File.join(File.dirname(common), "ai-artifacts", "lead-time"), nil]
  end
end

# ── MANAGER: ingest ─────────────────────────────────────────────────────────

module Ingest
  module_function

  def run(repo, since_opt, state, env, rejoin: false)
    io = LeadTimePhasesIO
    # A repo whose checkout is not on this machine never gets here: the
    # resolver skips it and Setup exits 4 (DND-1526).
    cursor = io::CursorStore.new(state, repo.name)
    since = since_opt
    unless since
      since, why = cursor.read
      return fail_with(1, "the cursor is unreadable: #{why}", "fix or remove #{cursor.path} (a removed cursor backfills #{BACKFILL_DAYS} days)") if why

      since ||= (env_now(env) - (BACKFILL_DAYS * 86_400)).utc.iso8601
    end

    bin = env["LEAD_TIME_PHASES_LEAD_TIME"].to_s
    bin = File.join(AI_DIR, "bin", "lead-time") if bin.empty?
    res = io::LeadTimeRunner.run(bin, repo.path, since, env.to_h)
    scan = check_scan(res, repo, since)
    return scan if scan

    ledger = io::LedgerStore.new(File.join(state, "ledger.jsonl"))
    prior, = ledger.read
    rows = build_rows(repo, res.rows, prior.select { |r| r["repo"] == repo.name }, env)
    added, present = ledger.append(rows)
    moved = since_opt ? "cursor unchanged (an explicit --since run never moves it)" : move_cursor(cursor, res.meta)
    puts "lead-time-phases: #{repo.name}: scanned since #{since}: #{res.rows.size} landing row(s), " \
         "#{added} new in the ledger, #{present} already there; #{moved}"
    puts rejoin_rows(ledger, rows, state, repo.name) if rejoin
    0
  end

  # --rejoin (DND-1490): the ledger is first-write-wins, so a plain re-ingest
  # never rewrites a row. This explicit mode replaces only the merge landings
  # ledgered with no gated head, with this scan's row that found it; each
  # original moves to ledger-replaced.jsonl. Every rejoinable row it did NOT
  # replace is counted by cause, so "nothing to do" never reads like a miss.
  def rejoin_rows(ledger, rows, state, repo)
    archive = File.join(state, "ledger-replaced.jsonl")
    outcomes = ledger.replace(LeadTimePhases::Ledger.rejoins(rows), archive, repo: repo)
    n = LeadTimePhases::Ledger::REJOIN_VERDICTS.to_h { |v| [v, outcomes.count { |o| o[0] == v }] }
    kept = n[:replace].positive? ? " (the originals are in #{archive})" : ""
    out = ["lead-time-phases: --rejoin: #{outcomes.size} merge landing row(s) had no gated head; " \
           "#{n[:replace]} rejoined on their PR head#{kept}"]
    out << "  #{n[:not_in_scan]} not in this scan: they landed before --since; pass an earlier --since" if n[:not_in_scan].positive?
    if n[:no_head].positive?
      why = outcomes.select { |o| o[0] == :no_head }.map { |o| o[2]["gated_head_na"] }.tally.max_by { |_, c| c }&.first
      out << "  #{n[:no_head]} scanned but still without a PR head (most often: #{why})"
    end
    if n[:would_lose].positive?
      out << "  #{n[:would_lose]} kept as ledgered: the fresh row lost a measurement the original has (telemetry pruned since)"
    end
    out.join("\n")
  end

  # -> nil when the scan is usable, else the exit code (having said why).
  def check_scan(res, repo, since)
    return fail_with(1, res.error, "check that ai/bin/lead-time is present and executable") if res.error
    if res.code.nil?
      $stderr.write(res.stderr)
      return fail_with(1, "ai/bin/lead-time was killed by signal #{res.signal} for #{repo.name}; nothing ingested",
                       "re-run; if a timeout killed it, scan a later --since in slices")
    end

    incomplete = res.code == 3 || (res.meta.is_a?(Hash) && res.meta["incomplete"] == true)
    if incomplete
      $stderr.write(res.stderr)
      return fail_with(3, "SCAN INCOMPLETE for #{repo.name} since #{since}: nothing ingested, the cursor is unchanged",
                       "restore the probe lead-time names above and re-run; never read this as an empty window")
    end
    unless res.code.zero?
      $stderr.write(res.stderr)
      return fail_with(1, "ai/bin/lead-time exited #{res.code} for #{repo.name}", "read its error above and re-run")
    end
    return fail_with(1, "ai/bin/lead-time wrote no readable --meta", "re-run; lead-time writes --meta on every window scan") unless res.meta.is_a?(Hash)
    return fail_with(1, "ai/bin/lead-time printed no JSON rows", "re-run; an empty window prints []") unless res.rows.is_a?(Array)

    nil
  end

  def build_rows(repo, raw_rows, prior, env)
    io = LeadTimePhasesIO
    now = env_now(env)
    landings = raw_rows.filter_map do |row|
      ticket, ticket_na = io::TicketFor.call(row)
      warn "lead-time-phases: #{repo.name}: ticket could not be read: #{ticket_na}" if ticket_na
      landing, why = LeadTimePhases::Landing.from_row(row, ticket: ticket, ticket_na: ticket_na)
      warn "lead-time-phases: #{repo.name}: not ledgered: #{why}" unless landing
      landing
    end
    landings = LeadTimePhases::Landing.with_bounds(landings, prior)
    if repo.mode == "watch"
      return landings.map { |l| LeadTimePhases::Ledger.watch_row(repo: repo.name, landing: l, ingested_at: now) }
    end

    improve_rows(repo, landings, now, env)
  end

  def improve_rows(repo, landings, now, env)
    io = LeadTimePhasesIO
    # Every kind, every repo: the origin check (DND-1531). The phase events
    # are the registered phase kinds written in this repo.
    all_events, = io::TelemetryReader.read_all(env)
    common, common_why = io::Git.common_dir(repo.path)
    no_common = LeadTimePhases::Source.could_not_look(common_why.to_s)
    events = LeadTimePhases.scope_events(LeadTimePhases.only_events(all_events, LeadTimePhases::EVENTS),
                                         common ? io::Git.repo_label(common) : repo.name)
    landings = landings.map { |l| join_push(l, events, common) }
    heads = landings.filter_map { |l| l["gated_head"] }.uniq
    timings, bad = io::TimingsReader.read(io::TimingsReader.path(env), heads)
    warn "lead-time-phases: #{bad} malformed harness-gate timings line(s) skipped" if bad.positive?
    landings.map do |l|
      receipt, verdicts = head_sources(l, common, no_common)
      timing = timing_source(l, timings)
      anchors = LeadTimePhases::Anchors.from(landing: l, events: events, receipt: receipt, verdicts: verdicts)
      counters = LeadTimePhases::Counters.compute(landing: l, events: events, timings: timing)
      gate_split = LeadTimePhases::Counters.verify_gate_runs(landing: l, events: events, anchors: anchors)
      evidence = LeadTimePhases::Origin.local_evidence(l, receipt: receipt, verdicts: verdicts, timings: timing)
      origin = LeadTimePhases::Origin.decide(landing: l, unit_events: all_events, evidence: evidence)
      LeadTimePhases::Ledger.improve_row(repo: repo.name, landing: l, anchors: anchors, counters: counters,
                                         telemetry_status: events.status, ingested_at: now, origin: origin,
                                         verify_gate_runs: gate_split)
    end
  end

  # A push landing's gated head (DND-1809): the landed commit, or the head a
  # clean rebase came from, found by LeadTimePhases::PushJoin from the
  # push's merge.landed `before` and the receipts' clean-rebase cover.
  def join_push(landing, events, common)
    return landing unless LeadTimePhases::Landing.landed_is_gated_head?(landing)

    io = LeadTimePhasesIO
    commit = landing["landed_commit"]
    before = LeadTimePhases::PushJoin.before_of(landing, events)
    cover = io::PushCover.read(common, commit, before)
    LeadTimePhases::PushJoin.resolve(landing, events: events, cover: cover,
                                              landed_receipt: io::ReceiptReader.read(common, commit))
  end

  # Receipts, verdicts and timings are keyed by the gated head: the landed
  # commit for a push (or the head it was rebased from, DND-1809), the PR
  # head for a merge (DND-1490). A landing with no
  # gated head could only miss, so it says why instead.
  def head_sources(landing, common, no_common)
    io = LeadTimePhasesIO
    head = landing["gated_head"]
    unless head
      why = LeadTimePhases::Source.could_not_look(landing["gated_head_na"])
      return [why, why]
    end
    return [no_common, no_common] unless common

    [io::ReceiptReader.read(common, head), io::VerdictReader.read(common, head)]
  end

  def timing_source(landing, timings)
    head = landing["gated_head"]
    return timings[head] if head

    LeadTimePhases::Source.could_not_look("timings are keyed by the gated head: #{landing['gated_head_na']}")
  end

  def move_cursor(cursor, meta)
    through = meta["scanned_through"]
    return "cursor unchanged (the window held no landing)" if through.nil?

    cursor.write(through)
    "cursor -> #{through}"
  end
end

# ── MANAGER: summary ────────────────────────────────────────────────────────

module Summary
  module_function

  def run(repo, window, as_json, state, env)
    io = LeadTimePhasesIO
    ledger = io::LedgerStore.new(File.join(state, "ledger.jsonl"))
    all, malformed = ledger.read
    mine = all.select { |r| r["repo"] == repo.name }
    deduped, folded = LeadTimePhases::Batch.dedupe(mine)
    rows = LeadTimePhases::Window.select(deduped, window)
    # The repo's declared post-merge CI (DND-1614): its idle_workflow, nil
    # when it declares none, so the window inference applies.
    report = LeadTimePhases::Stats.summarize(rows, idle_workflow: repo.idle_workflow, repo: repo.name).merge(
      "repo" => repo.name, "mode" => repo.mode, "window" => window, "ledger" => ledger.path,
      "ledger_exists" => ledger.exist?, "ledger_rows" => mine.size, "batch_folded" => folded, "malformed_lines" => malformed
    )
    report.merge!(improve_extras(repo, rows, env)) if repo.mode == "improve"
    report["phases_note"] = "phases are n/a by design in watch mode" if repo.mode == "watch"
    as_json ? puts(JSON.pretty_generate(report)) : print_report(report)
    0
  end

  def improve_extras(repo, rows, env)
    io = LeadTimePhasesIO
    times = rows.map { |r| LeadTimePhases::Util.time(r["landed_at"]) }.compact
    reverts = times.empty? ? nil : io::RevertCounter.count(repo.path, times.min.iso8601, times.max.iso8601)
    src, res = io::TelemetryReader.read(env)
    common, = io::Git.common_dir(repo.path)
    src = LeadTimePhases.scope_events(src, common ? io::Git.repo_label(common) : repo.name)
    { "guards" => LeadTimePhases::Guards.compute(rows, reverts: reverts),
      "telemetry" => telemetry_status(src, res, rows) }
  end

  # Phase events between the window's earliest dispatch (or landing) and its
  # last landing.
  def telemetry_status(src, res, rows)
    looked = !(src.could_not_look? && src.items.empty?)
    # With no store, or a counter it could not read, the count is unknown,
    # never 0.
    counter = res && res.status != :no_store ? res.failures : nil
    why = res&.failures_reason
    if counter&.key?("counter_corrupt")
      counter = nil
      why = "the write-failures counter is not a JSON object of counts"
    end
    out = { "status" => looked ? src.status.to_s : "could not look",
            "reason" => src.reason, "write_failures" => counter&.values&.sum,
            "write_failures_reason" => why,
            "write_failures_scope" => "cumulative since the counter was created",
            "malformed_lines" => res&.malformed }
    bounds = rows.flat_map { |r| [r["start"], r["landed_at"]] }.filter_map { |x| LeadTimePhases::Util.time(x) }
    if looked && !bounds.empty?
      lo, hi = bounds.minmax
      out["events_in_window"] = src.items.count { |e| (t = LeadTimePhases::Util.time(e["at"])) && t >= lo && t <= hi }
    end
    out
  end

  def fmt(s) = LeadTimePhases::Util.human(s)

  def print_report(r)
    foreign = r["foreign"].nil? ? "n/a" : r["foreign"]
    puts "lead-time-phases summary: repo=#{r['repo']} mode=#{r['mode']} window=#{r['window']} " \
         "(#{r['rows']} row(s) of #{r['ledger_rows']} in the ledger, foreign: #{foreign}; " \
         "#{r['batch_folded']} batch duplicate(s) folded)"
    puts "  #{r['malformed_lines']} malformed ledger line(s) skipped" if r["malformed_lines"].positive?
    unless r["ledger_exists"]
      puts "  no ledger at #{r['ledger']}: nothing has been ingested here (run --ingest --repo #{r['repo']})"
      return
    end
    if r["rows"].zero?
      puts "  the ledger has no landings for #{r['repo']} (run --ingest --repo #{r['repo']})"
      return
    end
    puts format("  %-10s %4s %4s %10s %10s %10s  %s", "", "n", "n/a", "median", "p90", "sum", "top n/a reasons")
    r["totals"].each { |name, s| puts line(name, s) }
    print_tail_mismatch(r["tail_ci"])
    if r["mode"] == "watch"
      puts "  phases: n/a by design (watch mode)"
    else
      print_origin(r)
      r["phases"].each { |name, s| puts line(name, s) }
      print_unattributed(r["unattributed"], r["flows"])
      b = r["biggest"]
      puts b["phase"] ? "  biggest contributor: #{b['phase']} (sum #{fmt(b['sum_s'])}; lever #{b['lever']})" : "  biggest contributor: none (#{b['reason']})"
      print_guards(r["guards"])
      print_telemetry(r["telemetry"])
    end
  end

  # Code time no phase holds, and which anchor map each row used (DND-1501).
  def print_unattributed(u, flows)
    of = u["n_na"].positive? ? " (#{u['n_na']} row(s) with no code time left out)" : ""
    puts "  unattributed: #{fmt(u['sum_s'])} of #{fmt(u['code_s'])} code time over #{u['n']} row(s)#{of}"
    puts "  flows: #{flows.map { |k, n| "#{k} #{n}" }.join(', ')}"
  end

  # Where the window's landings were worked (DND-1531). Foreign ones are
  # named; the phase lines below leave them out, the totals above do not.
  def print_origin(r)
    o = r["origin"]
    foreign = r["foreign"].nil? ? "n/a (no landing's origin decided)" : r["foreign"].to_s
    named = o["foreign_units"].empty? ? "" : " (#{o['foreign_units'].join(', ')}; out of the phase stats and biggest)"
    reasons = o["unknown_reasons"].map { |x| "#{x['reason']} (#{x['count']})" }.join("; ")
    unknown = o["unknown"].positive? ? "; #{o['unknown']} unknown: #{reasons}" : ""
    puts "  origin: #{o['local']} local; foreign: #{foreign}#{named}#{unknown}"
  end

  # A repo that declares no post-merge CI, with landings that have a run
  # (DND-1614): the tails stay measured, and the entry is named as wrong.
  def print_tail_mismatch(tail_ci)
    n = tail_ci && tail_ci["mismatch"]
    return unless n

    puts "  warning: idle_workflow none, but #{n} landing(s) in the window have a post-merge run: fix the repo's entry"
    puts "  Fix: set the repo's idle_workflow to its post-merge workflow file in this machine's lead-time config " \
         "(ai/bin/lead-time-repos says which file)"
  end

  def line(name, s)
    reasons = s["na_reasons"].map { |x| "#{x['reason']} (#{x['count']})" }.join("; ")
    format("  %-10s %4d %4d %10s %10s %10s  %s", name, s["n"], s["n_na"], fmt(s["median"]), fmt(s["p90"]), fmt(s["sum_s"]), reasons)
  end

  def print_guards(g)
    show = lambda do |x|
      next "n/a (#{x['reason']})" if x["value"].nil?

      x["of"] ? "#{(x['value'] * 100).round(1)}% of #{x['of']}" : x["value"].to_s
    end
    puts "  guards: critic BLOCK rate #{show.call(g['critic_block_rate'])}; gate red rate " \
         "#{show.call(g['gate_red_rate'])}; reverts on main #{show.call(g['reverts'])}"
  end

  def print_telemetry(t)
    status = t["status"] == "could not look" ? "could not look (#{t['reason']})" : t["status"]
    events = t.key?("events_in_window") ? "; #{t['events_in_window']} phase event(s) in the window" : ""
    wf = if t["write_failures"]
           "#{t['write_failures']} (#{t['write_failures_scope']})"
         else
           "unknown#{t['write_failures_reason'] ? " (#{t['write_failures_reason']})" : ''}"
         end
    bad = t["malformed_lines"].to_i.positive? ? "; #{t['malformed_lines']} malformed line(s) skipped" : ""
    puts "  telemetry: #{status}#{events}; write-failures #{wf}#{bad}"
  end
end

# ── FRAMEWORK ───────────────────────────────────────────────────────────────

def self_test
  suites = %w[phases_test.rb io_test.rb].map { |f| File.join(AI_DIR, "test", "lead-time-phases", f) }
  missing = suites.reject { |f| File.exist?(f) }
  return fail_with(1, "self-test suite missing: #{missing.join(', ')}", "restore ai/test/lead-time-phases/") unless missing.empty?

  suites.all? { |f| system("/usr/bin/ruby", f) } ? 0 : 1
end

def main(argv, env)
  opts = StrictArgv.parse(argv, SPEC)
  return self_test if opts["--self-test"]

  modes = %w[--ingest --summary].select { |m| opts[m] }
  return fail_with(2, "usage error: pass exactly one of --ingest or --summary", "see --help") unless modes.size == 1
  return fail_with(2, "usage error: --repo NAME is required", "pass --repo with a repo from ai/bin/lead-time-repos") unless opts["--repo"]
  return fail_with(2, "usage error: --since goes with --ingest", "drop --since, or use --ingest") if opts["--since"] && !opts["--ingest"]
  if opts["--rejoin"] && !(opts["--ingest"] && opts["--since"])
    return fail_with(2, "usage error: --rejoin goes with --ingest and an explicit --since",
                     "pass --ingest --since WHEN --rejoin, WHEN at or before the oldest landing to rejoin")
  end
  if (opts["--window"] || opts["--json"]) && !opts["--summary"]
    return fail_with(2, "usage error: --window and --json go with --summary", "drop them, or use --summary")
  end
  if opts["--window"] && !opts["--window"].positive?
    return fail_with(2, "usage error: --window must be a positive integer", "pass --window N with N >= 1")
  end

  ctx, code = Setup.resolve(opts, env)
  return code unless ctx

  if opts["--ingest"]
    Ingest.run(ctx.repo, ctx.since, ctx.state, env, rejoin: opts["--rejoin"])
  else
    Summary.run(ctx.repo, opts["--window"] || ctx.config.window, opts["--json"], ctx.state, env)
  end
rescue StrictArgv::UsageError => e
  fail_with(2, "usage error: #{e.message}", "see --help")
rescue LeadTimeConfig::Skipped => e
  fail_with(4, "#{e.message}; nothing read or written", e.fix)
rescue LeadTimeConfig::CouldNotLook => e
  fail_with(1, "could not look: #{e.message}", e.fix)
rescue LeadTimeConfig::Error => e
  fail_with(2, "config refused: #{e.message}", e.fix)
rescue LeadTimePhases::DeclarationError => e
  fail_with(1, "post-merge CI declaration refused: #{e.message}", e.fix)
rescue ArgumentError => e
  fail_with(2, "a time is malformed (#{e.message})", "LEAD_TIME_PHASES_NOW must be RFC 3339 with a zone")
rescue SystemCallError => e
  fail_with(1, "state I/O failed (#{e.message})", "make the state dir (#{env['LEAD_TIME_STATE_DIR'] || 'ai-artifacts/lead-time'}) a writable directory and re-run")
rescue StandardError => e
  fail_with(1, "internal error #{e.class}: #{e.message} (#{e.backtrace&.first})",
            "this is a lead-time-phases bug: file a DND ticket with this line; nothing past the failing step was written")
end

if $PROGRAM_NAME == __FILE__
  if ARGV.include?("--help") || ARGV.include?("-h")
    puts HELP
    exit 0
  end
  exit main(ARGV, ENV)
end
