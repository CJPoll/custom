#!/usr/bin/env ruby
# frozen_string_literal: true

# harness-metrics — parse Claude Code session-JSONL transcripts into harness
# metrics: which tools/skills fire, tool-failure rate, idle/stall gaps, and token
# usage (with dollar cost DERIVED from a price table when the model is known).
# Real signal for the learning-loop gaps (recurrence detection, graduation,
# variant selection) instead of anecdote.
#
# Read-only. Parses DEFENSIVELY: unknown/extra fields ignored, malformed lines
# skipped and counted, never crashes, fail-open. Verified JSONL schema (this
# harness, 2026-09): assistant records carry message.usage.{input_tokens,
# output_tokens, cache_creation_input_tokens, cache_read_input_tokens,
# output_tokens_details.thinking_tokens} and message.model; every record carries
# a `timestamp`; tool calls are content blocks type "tool_use" (name) and results
# type "tool_result" (is_error). There is NO dollar-cost field — cost is derived
# from tokens x a per-model price table (ai/telemetry/prices.json if present;
# absent -> tokens still reported, cost marked N/A).
#
# Deliberately gem-free (stdlib only); run with bare `ruby`.
#
# Usage:
#   ai/bin/harness-metrics [--dir DIR] [--session FILE] [--since ISO8601] [--json]
#   ai/bin/harness-metrics --self-test
#
# Default DIR: ~/.claude/projects. Default output: human summary to stdout AND a
# machine-readable ai/telemetry/metrics.json (for A4/A6). --json prints the JSON
# to stdout instead.

require "json"
require "fileutils"
require "time"

AI_DIR      = File.expand_path("..", __dir__)
OUT_JSON    = File.join(AI_DIR, "telemetry", "metrics.json")
PRICES_FILE = File.join(AI_DIR, "telemetry", "prices.json")
DEFAULT_DIR = File.expand_path("~/.claude/projects")
STALL_GAP_S = 300 # inter-record gap (s): floor for a plausible in-session stall
# Ceiling: a gap this long is a human closing/resuming the session, not an agent
# stall the harness could act on. Without it a 21-day session-resume gap was
# miscounted as a "stall" (observed 2026-09-17: gaps up to 1,807,179s). Gaps at
# or above the ceiling are reported separately as session_idle_gaps, not stalls.
STALL_GAP_CEILING_S = 14400 # 4h

# The corpus under ~/.claude/projects is append-only and never pruned, so every
# count derived from it is CUMULATIVE ALL-TIME: months of history, monotonically
# non-decreasing. A threshold applied to such a total can never clear once it has
# been crossed (measured: agent_stall_gaps sat at 48-49 and fired harness-signals
# on 31 consecutive hourly shipwright runs, each of which correctly declined to
# act). So alongside every all-time count, emit a WINDOWED count the caller can
# threshold against — a number that can go back down.
#
# 6h: six times the shipwright's hourly cadence, so five consecutive missed cron
# runs still cannot drop a gap through a seam, while a fixed cluster decays to
# zero within a working session rather than droning for weeks. Measured against
# the real 30-day agent-gap distribution (49 gaps, clustered: 16 on 08-23, 7 on
# 09-07, 6 on 08-26), a 6h window with the harness-signals >=2 bar would have
# fired on 8.9% of hourly runs; the 7d window that first suggested itself fires
# on 100% of them — i.e. it reproduces the bug this exists to fix.
RECENT_WINDOW_S = 6 * 3600

# One parse per record, reused for both gap math and recency. Returns nil for a
# missing or unparseable timestamp, which is then ignored for gap accounting (the
# previous record's time stays the comparison anchor).
def parse_ts(ts)
  return nil unless ts.is_a?(String)
  (Time.iso8601(ts) rescue (Time.parse(ts) rescue nil))
end

# Roll the harness-event.sh PostToolUse sink (A4) into the summary, if present.
# Complements the JSONL parse with real-time-emitted events.
EVENT_SINK = File.expand_path(File.join(AI_DIR, "..", "ai-artifacts", "telemetry", "events.jsonl"))
def read_event_sink
  path = ENV["HARNESS_EVENT_SINK"] || EVENT_SINK
  return { "present" => false } unless File.file?(path)
  total = 0
  errors = 0
  File.foreach(path) do |line|
    line = line.strip
    next if line.empty?
    total += 1
    begin
      errors += 1 if JSON.parse(line)["ok"] == false
    rescue StandardError
      # malformed sink line -> ignore
    end
  end
  { "present" => true, "events" => total, "error_events" => errors }
rescue StandardError
  { "present" => false }
end

def load_prices
  return {} unless File.file?(PRICES_FILE)
  JSON.parse(File.read(PRICES_FILE))
rescue StandardError
  {}
end

# A sub-ceiling gap that ENDS at a fresh user turn is idle-between-turns, not an
# in-session stall: the agent had finished its work and was waiting for the next
# instruction to arrive (a coordinator SendMessage, a new task, or an injected
# system notification). The harness cannot act on that wait, so it must not
# inflate agent_stall_gaps. A user-role record carrying tool_result blocks is
# mid-turn (the agent is blocked awaiting a tool it invoked) — that IS a stall
# candidate, so it is NOT a new turn. (Shipwright runs 18-19: 13 of 14
# agent-session gaps were exactly this — a persistent subagent sitting between a
# completed turn and the coordinator's next message; only 1 was within-turn.)
def new_user_turn?(o)
  m = o["message"]
  return false unless m.is_a?(Hash) && m["role"] == "user"
  c = m["content"]
  return true if c.is_a?(String)
  return c.none? { |b| b.is_a?(Hash) && b["type"] == "tool_result" } if c.is_a?(Array)
  true
end

# A within-turn gap whose PRECEDING record is the agent correctly BLOCKING on a
# bounded safe-wait command — the `timeout N tail --pid=<pid> -f /dev/null`
# pattern the CLAUDE.md Hard Rule and the ops:never-end-turn-waiting block
# MANDATE (rule 2: "block, don't spin") — is not a stall; it is the prescribed
# alternative to one. Counting it as an agent_stall_gap inverts the canary: it
# flags the exact behavior the harness requires. Detect it from the previous
# record (the assistant Bash tool_use that spawned the block). (Observed
# 2026-09-18, kg-mcp-auth captain a81c4b66 blocking on a spawned critic agent:
# a full-300s `timeout 300 tail --pid=$(pgrep -f …) -f /dev/null` was counted as
# a false stall — the shipwright's own tooling penalizing prescribed behavior.)
def safe_wait_block?(prev_o)
  return false unless prev_o.is_a?(Hash)
  m = prev_o["message"]
  return false unless m.is_a?(Hash)
  c = m["content"]
  return false unless c.is_a?(Array)
  c.any? do |b|
    b.is_a?(Hash) && b["type"] == "tool_use" && b["name"] == "Bash" &&
      (b["input"].is_a?(Hash) ? b["input"]["command"].to_s : "").match?(/tail\s+--pid/)
  end
end

# A within-turn gap that measures the wall-clock of a SYNCHRONOUS tool/command
# the agent invoked is tool-execution time, NOT agent idle: the agent cannot act
# while a synchronous Bash command runs (a full Docker `./bin/test` umbrella run,
# a synchronous `claude -p --agent athena-diff-critic` review-floor pass, a gated
# `git commit --amend`), because it is blocked in the harness awaiting the result
# it asked for. Counting these as agent_stall_gaps penalizes prescribed
# synchronous work; the genuine spin-loop/hang risk is guarded at the source by
# safe-wait-guard.sh + the CLAUDE.md Hard Rule, not by this diagnostic. Two
# transcript shapes carry a synchronous-execution gap, BOTH observed in the
# 2026-09-18 kg-mcp-auth captains:
#   (a) the CURRENT record is the tool's RETURN — a `tool_result` content block,
#       or a top-level `toolUseResult` key on a user record (ab00fa2c: a gated
#       `git commit --amend` (339s) and a synchronous diff-critic run (356s)).
#   (b) the PRECEDING record is a `queued_command` attachment — a queued
#       synchronous command whose ~600s execution lands as the gap to the next
#       system attachment (a42541d5: repeated queued test/critic commands near
#       the 10-min Bash ceiling). Attachment timestamps are system-injected, so a
#       gap bracketed by a queued command is command runtime, not agent idle.
# Generalizes the earlier `tail --pid` safe_wait_block? special case.
def synchronous_tool_gap?(prev_o, o)
  if o.is_a?(Hash)
    return true if o["toolUseResult"]
    m = o["message"]
    if m.is_a?(Hash) && m["content"].is_a?(Array)
      return true if m["content"].any? { |b| b.is_a?(Hash) && b["type"] == "tool_result" }
    end
  end
  if prev_o.is_a?(Hash) && prev_o["type"] == "attachment"
    a = prev_o["attachment"]
    return true if a.is_a?(Hash) && a["type"] == "queued_command"
  end
  false
end

# Fold one parsed JSONL record into the accumulator.
# `agent` marks records from an agent-session transcript (agent-*.jsonl) vs an
# interactive (UUID-named) session: an in-band gap in an interactive session is
# human think/idle time the shipwright can never act on, so only agent-session
# gaps feed the actionable `agent_stall_gaps` metric. (Shipwright runs 16-18:
# ~88% of in-band gaps were benign interactive idle, which made the total-count
# stall signal effectively always-on.) Runs 18-19 refined it further: even in an
# agent transcript, a gap ending at a fresh user turn (see new_user_turn?) is
# idle-between-turns, so only within-turn gaps feed agent_stall_gaps. Run 20
# refined it once more: a within-turn gap that is the wall-clock of a synchronous
# tool the agent invoked (see synchronous_tool_gap?) is tool runtime, not idle,
# so it is excluded too. Run 21 left WHICH gaps are counted untouched and fixed
# the SHAPE instead: each counted agent gap also lands in recent_agent_stall_gaps
# when it falls inside acc[:recent_cutoff] (see RECENT_WINDOW_S), so a caller has
# a count that can return to zero.
def fold(acc, o, prev_t, agent = false, prev_o = nil)
  t = parse_ts(o["timestamp"])
  if t
    recent = acc[:recent_cutoff] && t >= acc[:recent_cutoff]
    acc[:recent_records] += 1 if recent
    if prev_t
      gap = t - prev_t
      if gap >= STALL_GAP_CEILING_S
        acc[:session_idle_gaps] += 1 # human closed/resumed the session, not a stall
      elsif gap >= STALL_GAP_S
        acc[:stall_gaps] += 1
        if agent && !new_user_turn?(o) && !safe_wait_block?(prev_o) && !synchronous_tool_gap?(prev_o, o)
          acc[:agent_stall_gaps] += 1
          acc[:recent_agent_stall_gaps] += 1 if recent
        end
      end
    end
  end

  msg = o["message"].is_a?(Hash) ? o["message"] : nil
  if msg
    acc[:models][msg["model"]] += 1 if msg["model"]
    u = msg["usage"]
    if u.is_a?(Hash)
      acc[:tokens][:input]   += (u["input_tokens"] || 0)
      acc[:tokens][:output]  += (u["output_tokens"] || 0)
      acc[:tokens][:cache_read]  += (u["cache_read_input_tokens"] || 0)
      acc[:tokens][:cache_write] += (u["cache_creation_input_tokens"] || 0)
      det = u["output_tokens_details"]
      acc[:tokens][:thinking] += (det["thinking_tokens"] || 0) if det.is_a?(Hash)
      # per-model token tally for cost derivation
      m = msg["model"] || "unknown"
      acc[:by_model][m] ||= Hash.new(0)
      acc[:by_model][m][:input]  += (u["input_tokens"] || 0)
      acc[:by_model][m][:output] += (u["output_tokens"] || 0)
      acc[:by_model][m][:cache_read]  += (u["cache_read_input_tokens"] || 0)
      acc[:by_model][m][:cache_write] += (u["cache_creation_input_tokens"] || 0)
    end
    content = msg["content"]
    if content.is_a?(Array)
      content.each do |b|
        next unless b.is_a?(Hash)
        case b["type"]
        when "tool_use"
          name = b["name"] || "unknown"
          acc[:tools][name] += 1
          acc[:tool_calls] += 1
          if name == "Skill"
            skill = (b["input"] || {})["skill"] rescue nil
            acc[:skills][skill || "unknown"] += 1 if b["input"].is_a?(Hash)
          end
        when "tool_result"
          acc[:tool_results] += 1
          acc[:tool_errors] += 1 if b["is_error"]
        end
      end
    end
  end
  t || prev_t
end

# `cutoff` is a Time (or nil). Nil means "recency not computed" — the recent_*
# fields are then OMITTED from the report rather than emitted as 0, because a
# zero with no window behind it is indistinguishable from a healthy zero.
def parse_files(files, cutoff = nil)
  acc = {
    files: 0, records: 0, malformed: 0,
    tool_calls: 0, tool_results: 0, tool_errors: 0, stall_gaps: 0,
    agent_stall_gaps: 0, session_idle_gaps: 0,
    recent_cutoff: cutoff, recent_records: 0, recent_agent_stall_gaps: 0,
    tools: Hash.new(0), skills: Hash.new(0), models: Hash.new(0),
    tokens: Hash.new(0), by_model: {},
  }
  files.each do |f|
    acc[:files] += 1
    agent = File.basename(f).start_with?("agent-")
    prev_ts = nil
    prev_o = nil
    File.foreach(f) do |line|
      line = line.strip
      next if line.empty?
      begin
        o = JSON.parse(line)
      rescue StandardError
        acc[:malformed] += 1
        next
      end
      acc[:records] += 1
      prev_ts = fold(acc, o, prev_ts, agent, prev_o)
      prev_o = o
    end
  rescue StandardError
    # unreadable file -> skip, fail-open
    next
  end
  acc
end

def derive_cost(by_model, prices)
  known = 0.0
  unpriced = []
  by_model.each do |model, t|
    p = prices[model]
    if p.nil?
      unpriced << model unless model == "unknown"
      next
    end
    known += (t[:input].to_f      / 1_000_000) * (p["input_per_mtok"]      || 0)
    known += (t[:output].to_f     / 1_000_000) * (p["output_per_mtok"]     || 0)
    known += (t[:cache_read].to_f / 1_000_000) * (p["cache_read_per_mtok"] || 0)
    known += (t[:cache_write].to_f/ 1_000_000) * (p["cache_write_per_mtok"]|| 0)
  end
  { usd: known.round(4), priced: !prices.empty?, unpriced_models: unpriced.uniq }
end

def build_report(acc, prices)
  cost = derive_cost(acc[:by_model], prices)
  rate = acc[:tool_results].zero? ? 0.0 : (acc[:tool_errors].to_f / acc[:tool_results]).round(4)
  {
    "generated" => Time.now.utc.iso8601,
    "files" => acc[:files], "records" => acc[:records], "malformed_lines" => acc[:malformed],
    "tool_calls" => acc[:tool_calls], "tool_results" => acc[:tool_results],
    "tool_errors" => acc[:tool_errors], "tool_failure_rate" => rate,
    "stall_gaps" => acc[:stall_gaps], "agent_stall_gaps" => acc[:agent_stall_gaps],
    "stall_gap_threshold_s" => STALL_GAP_S,
    "stall_gap_ceiling_s" => STALL_GAP_CEILING_S, "session_idle_gaps" => acc[:session_idle_gaps],
  }.merge(recent_fields(acc)).merge({
    "tools" => acc[:tools], "skills" => acc[:skills], "models" => acc[:models],
    "tokens" => acc[:tokens].transform_keys(&:to_s),
    "cost" => cost.transform_keys(&:to_s),
  })
end

# Emitted only when a window was actually computed. `recent_records` is the
# observability counter that lets a reader tell "no gaps in the window" from
# "nothing was observed in the window" — a windowed zero over zero records is
# not a healthy harness, it is an unread corpus (CLAUDE.md -> "A failed lookup
# must never look like an empty one": make every miss observable).
def recent_fields(acc)
  return {} unless acc[:recent_cutoff]
  {
    "recent_window_s" => (Time.now.utc - acc[:recent_cutoff]).round,
    "recent_window_start" => acc[:recent_cutoff].utc.iso8601,
    "recent_agent_stall_gaps" => acc[:recent_agent_stall_gaps],
    "recent_records" => acc[:recent_records],
  }
end

def print_human(r)
  puts "harness-metrics: #{r['files']} file(s), #{r['records']} records " \
       "(#{r['malformed_lines']} malformed skipped)"
  puts "  tool calls: #{r['tool_calls']}  results: #{r['tool_results']}  " \
       "errors: #{r['tool_errors']}  failure-rate: #{r['tool_failure_rate']}"
  puts "  idle/stall gaps (#{r['stall_gap_threshold_s']}-#{r['stall_gap_ceiling_s']}s): #{r['stall_gaps']}" \
       " (agent-session: #{r['agent_stall_gaps']})" \
       "  (session-idle gaps >=#{r['stall_gap_ceiling_s']}s, excluded: #{r['session_idle_gaps']})"
  if r.key?("recent_agent_stall_gaps")
    puts "  in the last #{r['recent_window_s'] / 3600}h (since #{r['recent_window_start']}): " \
         "#{r['recent_agent_stall_gaps']} agent-session gap(s) over #{r['recent_records']} record(s)" \
         "  [agent-session counts above are ALL-TIME and never decrease]"
  else
    puts "  recency: NOT COMPUTED (no window) — the agent-session count above is all-time only"
  end
  tk = r["tokens"]
  puts "  tokens: in=#{tk['input']} out=#{tk['output']} cache_read=#{tk['cache_read']} " \
       "cache_write=#{tk['cache_write']} thinking=#{tk['thinking']}"
  c = r["cost"]
  if c["priced"]
    note = c["unpriced_models"].empty? ? "" : " (unpriced: #{c['unpriced_models'].join(', ')})"
    puts "  est. cost: $#{c['usd']}#{note}"
  else
    puts "  est. cost: N/A (Note: no ai/telemetry/prices.json — tokens reported, dollar cost not derived)"
  end
  ev = r["runtime_events"]
  if ev && ev["present"]
    puts "  runtime events (hook sink): #{ev['events']} (#{ev['error_events']} error)"
  end
  top = r["tools"].sort_by { |_, n| -n }.first(5)
  puts "  top tools: #{top.map { |k, v| "#{k}=#{v}" }.join(', ')}" unless top.empty?
end

def run(argv)
  json_out = argv.include?("--json")
  dir = (i = argv.index("--dir")) ? argv[i + 1] : DEFAULT_DIR
  session = (i = argv.index("--session")) ? argv[i + 1] : nil
  # Resolving the window is its own step with its own outcome: an unparseable
  # --since is an ERROR, never a silently-default window (which would report a
  # recency the caller did not ask for).
  cutoff = Time.now.utc - RECENT_WINDOW_S
  if (i = argv.index("--since"))
    cutoff = parse_ts(argv[i + 1])
    if cutoff.nil?
      warn "harness-metrics: --since #{argv[i + 1].inspect} is not an ISO8601 timestamp"
      warn "  Fix: pass e.g. --since 2026-09-20T08:00:00Z, or omit --since for the " \
           "default #{RECENT_WINDOW_S / 3600}h window."
      return 1
    end
  end

  files = session ? [session] : Dir.glob(File.join(dir, "**", "*.jsonl"))
  if files.empty?
    warn "harness-metrics: no sessions found under #{session || dir}"
    warn "  Note: nothing to report; this is not an error (fail-open)."
    puts(json_out ? JSON.pretty_generate("files" => 0, "records" => 0) : "no sessions")
    return 0
  end

  acc = parse_files(files, cutoff)
  report = build_report(acc, load_prices)
  report["runtime_events"] = read_event_sink

  FileUtils.mkdir_p(File.dirname(OUT_JSON))
  begin
    File.write(OUT_JSON, JSON.pretty_generate(report))
  rescue StandardError => e
    warn "harness-metrics: Note: could not write #{OUT_JSON} (#{e.message}); continuing."
  end

  if json_out
    puts JSON.pretty_generate(report)
  else
    print_human(report)
  end
  0
end

def run_self_test
  require "tmpdir"
  ok = true
  Dir.mktmpdir("harness-metrics-selftest-") do |dir|
    f = File.join(dir, "s.jsonl")
    lines = [
      { "type" => "user", "timestamp" => "2026-09-16T00:00:00.000Z" },
      { "type" => "assistant", "timestamp" => "2026-09-16T00:00:01.000Z",
        "message" => { "model" => "test-model", "usage" => {
          "input_tokens" => 10, "output_tokens" => 20,
          "cache_read_input_tokens" => 5, "cache_creation_input_tokens" => 7,
          "output_tokens_details" => { "thinking_tokens" => 3 } },
          "content" => [
            { "type" => "tool_use", "name" => "Bash" },
            { "type" => "tool_use", "name" => "Skill", "input" => { "skill" => "review" } } ] } },
      { "type" => "user", "timestamp" => "2026-09-16T00:00:02.000Z",
        "message" => { "content" => [
          { "type" => "tool_result", "is_error" => false },
          { "type" => "tool_result", "is_error" => true } ] } },
      # a 1h gap (< ceiling) -> one stall gap
      { "type" => "assistant", "timestamp" => "2026-09-16T01:00:00.000Z", "message" => {} },
      # a multi-day gap (>= ceiling) -> session-idle, NOT a stall
      { "type" => "assistant", "timestamp" => "2026-09-19T01:00:00.000Z", "message" => {} },
    ]
    File.write(f, lines.map { |l| JSON.generate(l) }.join("\n") + "\n" + "{ not json\n")

    # A second, agent-session transcript (agent-*.jsonl) with one sub-ceiling gap:
    # it must add to BOTH stall_gaps and agent_stall_gaps, while the interactive
    # file above adds only to stall_gaps.
    af = File.join(dir, "agent-selftest.jsonl")
    agent_lines = [
      { "type" => "assistant", "timestamp" => "2026-09-16T00:00:00.000Z", "message" => {} },
      # a 1h gap (< ceiling) -> one stall gap, attributed to the agent session
      { "type" => "assistant", "timestamp" => "2026-09-16T01:00:00.000Z", "message" => {} },
    ]
    File.write(af, agent_lines.map { |l| JSON.generate(l) }.join("\n") + "\n")

    # A third agent transcript whose sub-ceiling gap ENDS at a fresh user turn
    # (a coordinator SendMessage injected as a string user message). It must
    # count toward stall_gaps (total) but NOT agent_stall_gaps: idle-between-
    # turns is not an in-session stall (runs 18-19). Without the new_user_turn?
    # guard this would push agent_stall_gaps to 2.
    tf = File.join(dir, "agent-turnboundary.jsonl")
    turn_lines = [
      { "type" => "assistant", "timestamp" => "2026-09-16T00:00:00.000Z", "message" => {} },
      { "type" => "user", "timestamp" => "2026-09-16T01:00:00.000Z",
        "message" => { "role" => "user",
                       "content" => "The coordinator sent a message while you were working: do X" } },
    ]
    File.write(tf, turn_lines.map { |l| JSON.generate(l) }.join("\n") + "\n")

    # A fourth agent transcript whose sub-ceiling gap is PRECEDED by the agent
    # correctly blocking on a bounded safe-wait command (`timeout N tail --pid`,
    # the CLAUDE.md Hard Rule / ops:never-end-turn-waiting rule-2 pattern). It
    # must count toward stall_gaps (total) but NOT agent_stall_gaps — flagging
    # prescribed safe-wait behavior as a stall inverts the canary (observed
    # 2026-09-18, kg-mcp-auth captain a81c4b66 blocking on a spawned critic).
    sf = File.join(dir, "agent-safewait.jsonl")
    safe_lines = [
      { "type" => "assistant", "timestamp" => "2026-09-16T00:00:00.000Z",
        "message" => { "role" => "assistant", "content" => [
          { "type" => "tool_use", "name" => "Bash",
            "input" => { "command" => "timeout 300 tail --pid=$(pgrep -f foo | head -1) -f /dev/null" } } ] } },
      { "type" => "assistant", "timestamp" => "2026-09-16T01:00:00.000Z", "message" => {} },
    ]
    File.write(sf, safe_lines.map { |l| JSON.generate(l) }.join("\n") + "\n")

    # A fifth agent transcript whose sub-ceiling gap ENDS at the RETURN of a
    # synchronous tool the agent invoked (assistant tool_use -> user tool_result).
    # The gap is the tool's own execution time (a full Docker test run, a
    # synchronous `claude -p --agent` critic), not agent idle: it must count
    # toward stall_gaps (total) but NOT agent_stall_gaps (observed 2026-09-18,
    # kg-mcp-auth captain ab00fa2c). Without synchronous_tool_gap? this would push
    # agent_stall_gaps to 2.
    syncf = File.join(dir, "agent-synctool.jsonl")
    sync_lines = [
      { "type" => "assistant", "timestamp" => "2026-09-16T00:00:00.000Z",
        "message" => { "role" => "assistant", "content" => [
          { "type" => "tool_use", "name" => "Bash",
            "input" => { "command" => "./bin/test" } }] } },
      { "type" => "user", "timestamp" => "2026-09-16T01:00:00.000Z",
        "message" => { "role" => "user", "content" => [
          { "type" => "tool_result", "is_error" => false }] } },
    ]
    File.write(syncf, sync_lines.map { |l| JSON.generate(l) }.join("\n") + "\n")

    # A sixth agent transcript whose sub-ceiling gap is PRECEDED by a
    # `queued_command` attachment — a queued synchronous command whose runtime
    # lands as the gap to the next system attachment (observed 2026-09-18,
    # kg-mcp-auth captain a42541d5). Command runtime, not agent idle: count toward
    # stall_gaps (total) but NOT agent_stall_gaps.
    qcf = File.join(dir, "agent-queuedcmd.jsonl")
    qc_lines = [
      { "type" => "attachment", "timestamp" => "2026-09-16T00:00:00.000Z",
        "attachment" => { "type" => "queued_command" } },
      { "type" => "attachment", "timestamp" => "2026-09-16T01:00:00.000Z",
        "attachment" => { "type" => "total_tokens_reminder" } },
    ]
    File.write(qcf, qc_lines.map { |l| JSON.generate(l) }.join("\n") + "\n")

    fixtures = [f, af, tf, sf, syncf, qcf]
    acc = parse_files(fixtures)
    r = build_report(acc, { "test-model" => {
      "input_per_mtok" => 1.0, "output_per_mtok" => 2.0,
      "cache_read_per_mtok" => 0.1, "cache_write_per_mtok" => 0.5 } })

    checks = {
      "malformed counted"   => (r["malformed_lines"] == 1),
      "tool_calls == 4"     => (r["tool_calls"] == 4),
      "tool_errors == 1"    => (r["tool_errors"] == 1),
      "failure_rate == 0.3333 (1 err / 3 results)" => (r["tool_failure_rate"] == 0.3333),
      "skill fire counted"  => (r["skills"]["review"] == 1),
      "input tokens == 10"  => (r["tokens"]["input"] == 10),
      "thinking == 3"       => (r["tokens"]["thinking"] == 3),
      "stall gap == 6"        => (r["stall_gaps"] == 6),
      "agent stall gap == 1 (turn-boundary + safe-wait + sync-tool excluded)" => (r["agent_stall_gaps"] == 1),
      "session-idle == 1"     => (r["session_idle_gaps"] == 1),
      # Recency (run 21). The fixture's one countable agent gap ends at
      # 2026-09-16T01:00:00Z. A window that OPENS AFTER it must report zero —
      # this is the negative case that proves an old, long-fixed cluster stops
      # producing a signal — while a window that opens before it must report it.
      # A no-window parse must OMIT the recent_* fields entirely rather than
      # emit a zero the caller would read as healthy.
      "no cutoff omits recent fields" => (!r.key?("recent_agent_stall_gaps") &&
                                          !r.key?("recent_window_s")),
      "old gaps only -> recent == 0, all-time preserved" => (
        rw = build_report(parse_files(fixtures, Time.parse("2026-09-19T00:00:00Z")), {})
        rw["recent_agent_stall_gaps"].zero? && rw["agent_stall_gaps"] == 1),
      "recent gap -> recent == 1" => (
        rr = build_report(parse_files(fixtures, Time.parse("2026-09-16T00:30:00Z")), {})
        rr["recent_agent_stall_gaps"] == 1),
      "recent_records counts only in-window records" => (
        rw2 = build_report(parse_files(fixtures, Time.parse("2026-09-19T00:00:00Z")), {})
        rw2["recent_records"] == 1 && rw2["records"] > rw2["recent_records"]),
      "window fields describe the window searched" => (
        rw3 = build_report(parse_files(fixtures, Time.parse("2026-09-19T00:00:00Z")), {})
        rw3["recent_window_start"] == "2026-09-19T00:00:00Z" && rw3["recent_window_s"].positive?),
      "parse_ts rejects a non-timestamp" => (parse_ts("not-a-time").nil? && parse_ts(nil).nil? &&
                                             !parse_ts("2026-09-20T08:00:00Z").nil?),
      # safe_wait_block? edge cases: a preceding Bash `tail --pid` block is a
      # prescribed safe-wait (excluded from agent stalls); a plain Bash command
      # or a nil/non-Bash prior record is not.
      "safe-wait block detected"    =>
        safe_wait_block?({ "message" => { "role" => "assistant", "content" =>
          [{ "type" => "tool_use", "name" => "Bash",
             "input" => { "command" => "timeout 300 tail --pid=1234 -f /dev/null" } }] } }),
      "plain bash is not safe-wait"  =>
        !safe_wait_block?({ "message" => { "role" => "assistant", "content" =>
          [{ "type" => "tool_use", "name" => "Bash",
             "input" => { "command" => "mix test" } }] } }),
      "nil prior is not safe-wait"   => !safe_wait_block?(nil),
      # synchronous_tool_gap? edge cases: a gap ending at a tool_result return
      # (message-content block or top-level toolUseResult key) or preceded by a
      # queued_command attachment is synchronous tool-execution time, not idle; a
      # plain assistant->assistant gap is not.
      "tool_result return is sync-tool gap" =>
        synchronous_tool_gap?({ "type" => "assistant" },
          { "type" => "user", "message" => { "content" => [{ "type" => "tool_result" }] } }),
      "toolUseResult key is sync-tool gap" =>
        synchronous_tool_gap?({ "type" => "assistant" },
          { "type" => "user", "toolUseResult" => {}, "message" => { "content" => "done" } }),
      "queued_command prior is sync-tool gap" =>
        synchronous_tool_gap?(
          { "type" => "attachment", "attachment" => { "type" => "queued_command" } },
          { "type" => "attachment", "attachment" => { "type" => "total_tokens_reminder" } }),
      "plain assistant gap is not sync-tool" =>
        !synchronous_tool_gap?({ "type" => "assistant", "message" => {} },
          { "type" => "assistant", "message" => {} }),
      "nil prior tolerated by sync-tool" =>
        !synchronous_tool_gap?(nil, { "type" => "assistant", "message" => {} }),
      # cost = 10/1e6*1 + 20/1e6*2 + 5/1e6*0.1 + 7/1e6*0.5 = 0.0000000535
      "cost derived"        => (r["cost"]["usd"] >= 0.0 && r["cost"]["priced"] == true),
      # new_user_turn? edge cases: string user msg is a fresh turn; a user record
      # of tool_result blocks is mid-turn (a stall candidate), not a new turn;
      # an assistant record is never a new turn.
      "string user is new turn"  =>
        new_user_turn?({ "message" => { "role" => "user", "content" => "hi" } }),
      "tool_result is mid-turn"  =>
        !new_user_turn?({ "message" => { "role" => "user",
                                         "content" => [{ "type" => "tool_result" }] } }),
      "assistant is not new turn" =>
        !new_user_turn?({ "message" => { "role" => "assistant", "content" => [] } }),
    }
    checks.each do |name, pass|
      next if pass
      warn "self-test: FAIL — #{name}"
      ok = false
    end
  end
  if ok
    puts "harness-metrics: self-test OK"
    0
  else
    warn "harness-metrics: self-test FAILED"
    warn "  Fix: a metric no longer matches the synthetic fixture — align the parser " \
         "with the verified JSONL schema (message.usage.*, content[].tool_use/tool_result)."
    1
  end
end

exit(ARGV.include?("--self-test") ? run_self_test : run(ARGV))
