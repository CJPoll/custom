#!/usr/bin/env ruby
# frozen_string_literal: true

# variant-eval — a MEASUREMENT INSTRUMENT for harness variants (DND-174 / C3,
# REDUCED SCOPE per the architect verdict). Given a candidate git ref and a
# baseline ref, it measures the candidate against the existing eval corpus and
# emits a PROPOSAL: a scorecard delta plus one of KEEP / REVERT / INCONCLUSIVE.
#
# It is a selector/measurer over git refs. It is NOT a self-modifier and has NO
# merge/commit/push/adopt/--update-baseline code path. Its ONLY output is a
# proposal (stdout and/or a file). A KEEP verdict is a recommendation that
# "requires gate-green + explicit human adoption" — the human, not this tool,
# adopts a variant by choosing to merge it. "Revert" is a no-op: the tool never
# writes to the harness, so declining a variant is simply the human not merging.
#
# WHY REDUCED SCOPE (do NOT force the full ADAS/Darwin-Gödel measured-adoption
# loop here): the existing eval "scorecard" (ai/bin/harness-eval,
# ai/bin/admiral-eval) is a set of per-case BINARY pass/fail verdicts, NOT a
# numeric score, and a "delta" is a pass-set diff (true->false = regressed,
# false->true = fixed). There is NO noise band in code — admiral-eval uses
# K-sample majority and hands 2/3->1/3 sampling-noise to a human re-run, and the
# committed baseline already carries a 2/3 case. So a fully-automatic
# measured-improvement verdict over the model signal is not yet trustworthy. Per
# epic Decision 5 the speculative measured-adoption core is DEFERRED; this builds
# the deterministic + inconclusive-by-default reduced scope. See
# ai/docs/variant-eval.md.
#
# BOUNDARY WITH THE SHIPWRIGHT CRON LOOP (load-bearing): variant-eval is
# human-gated, proposal-only, and triggered by a HANDED variant ref. It must NOT
# wrap measurement in an auto-adopt loop — that would collide with the
# shipwright's autonomy and violate C3's human-gate AC. It reuses
# admiral-eval/harness-eval as its selector; it does NOT invent a second corpus
# and it is NOT a second autonomous committer.
#
# Runs entirely within git history: for each of {baseline, variant} it creates a
# short-lived `git worktree add --detach` (NEVER checks out in place), runs the
# corpus there, collects the per-case result set, and tears the worktree down.
#
# Corpora:
#   deterministic (default) — the exact / no-model portion:
#       * ai/bin/harness-eval per-case pass-set (from its scorecard.json)
#       * every admiral-eval T1 hook-stdin case (mode=hook-stdin)
#     Delta = EXACT pass-set diff (regressed / fixed / new), no sampling, no band.
#   full — additionally the admiral-eval T2 model-in-loop cases, characterized:
#     run baseline ref N times for per-case counts k_base/N, variant N times for
#     k_var/N, and classify each case with the DND-225 noise-threshold rule
#     (ai/lib/eval_score.rb, measured in ai/docs/eval-noise-band.md):
#     regression iff the Newcombe 95% interval for p_var - p_base lies below 0
#     OR p_base - p_var > Δ_noise (the DND-174 pilot envelope); improvement iff
#     the interval lies above 0 AND p_var - p_base > Δ_noise; otherwise
#     INCONCLUSIVE. A case measured on one side only is n/a (new) or fails
#     closed (missing) — never scored against a coerced 0.
#     Each side evaluates ITS OWN rendered admiral (admiral-eval --agent-file
#     <wt>/ai/agents/athena-admiral.md; see t2_argv), never the main checkout's
#     copy that ~/.claude/agents resolves. A T2 A/B delta is comparable only
#     when both refs are at or after 35be30f (DND-503), with each side's
#     subject sha recorded in the proposal.
#
# Before any delta the variant ref is run through the standing gate
# (ai/bin/harness-gate: harness-eval + check-* guards + every --self-test). A red
# gate short-circuits to BLOCKED with a Fix: line, BEFORE scoring
# (never-commit-a-broken-harness).
#
# Verdict:
#   variant gate red                                  -> BLOCKED (short-circuit)
#   a side's corpus ran but did not MEASURE           -> UNMEASURED (DND-504;
#     admiral-eval failed/crashed/parsed 0 T2 cases/its model calls failed, or
#     harness-eval did not rewrite its scorecard). Never KEEP/REVERT: "could not
#     measure" must not read as "found nothing".
#   ANY deterministic regression OR any T2 regression -> REVERT
#   zero regressions AND >=1 strict improvement        -> KEEP (pending human gate)
#   zero regressions, no improvement clears envelope   -> INCONCLUSIVE
#
# Deliberately gem-free (stdlib only); run with bare `ruby`.
#
# Usage:
#   ai/bin/variant-eval --variant <ref> [--baseline <ref>] [--corpus deterministic|full]
#                       [--runs N] [--out <file>] [--json <file>]
#   ai/bin/variant-eval --self-test    verify the runner's own logic (NO model, NO git)
#
# The model-in-loop `variant-eval --variant … --corpus full` stays OUT of the
# gate (like admiral-eval --run / critic-eval --run). Only --self-test is
# gate-wired.

require "digest"
require "json"
require "open3"
require "fileutils"
require "tmpdir"
require "time"
require "rbconfig"
require_relative "../lib/strict_argv"

AI_DIR              = File.expand_path("..", __dir__)
require File.join(AI_DIR, "lib", "eval_score")
ADMIRAL_FIXTURES    = File.join("ai", "eval", "admiral-fixtures")
SCORECARD_REL       = File.join("ai", "eval", "scorecard.json")
# The rendered admiral each side's T2 run evaluates (DND-503): the worktree's
# OWN render, passed to admiral-eval via --agent-file.
ADMIRAL_AGENT_REL   = File.join("ai", "agents", "athena-admiral.md")

DEFAULT_BASELINE    = "origin/main"
DEFAULT_RUNS        = 10        # T2 characterization depth for the pilot
# The pilot envelope and its float tolerance live in ai/lib/eval_score.rb
# (DND-225), the one home of the noise-threshold rule; these names are kept so
# the proposal text and the self-test read unchanged.
DELTA_NOISE         = EvalScore::PILOT_ENVELOPE   # |p_base - p_var| must exceed this
ENVELOPE_EPS        = EvalScore::ENVELOPE_EPS

KEEP_LABEL = "KEEP — pending human gate (requires gate-green + explicit human adoption; variant-eval NEVER adopts)"

# The canonical verdict set (mirrors the `verdict` function's five branches
# and render_proposal's `case res[:verdict]`/`if ... :blocked` handling).
# --help builds its verdict list from this constant, and the self-test checks
# both --help against it AND this constant against the symbols the self-test's
# own verdict(...) calls actually produce (va/vb/vc/ve/vu below) — so a sixth
# verdict branch exercised by a new self-test case, but not added here, fails
# loudly instead of silently drifting out of --help (DND-506). It does NOT by
# itself prove `verdict` has no unexercised branch; that still needs a case.
VERDICT_LABELS = {
  keep: "KEEP",
  revert: "REVERT",
  inconclusive: "INCONCLUSIVE",
  blocked: "BLOCKED",
  unmeasured: "UNMEASURED"
}.freeze

# Command strings that would constitute a mutation/adoption action. No proposal
# output may contain any of these (self-test (d)); no command the tool runs may
# match one (command_allowed?).
MUTATION_COMMAND_STRINGS = [
  "git merge", "git commit", "git push", "git rebase", "git reset",
  "gh pr merge", "gh merge", "glab mr merge", "--update-baseline"
].freeze

# ---------------------------------------------------------------------------
# STRUCTURAL CONTAINMENT (guard — this is a security-relevant, self-modifying-
# adjacent tool; it must be provable it CANNOT mutate the live harness).
#
# Every external command is funneled through `capture`, which refuses any argv
# that is not read-only. The self-test asserts (i) command_allowed? rejects each
# mutation family, and (ii) the SOURCE routes ALL execution through this single
# guarded call site (no backticks, %x, system(, IO.popen, spawn(, exec(, and
# exactly one Open3.capture3( in the whole file).
# ---------------------------------------------------------------------------
class MutationAttempt < StandardError; end

# DND-504: a side's corpus RAN but produced no trustworthy measurement. It is a
# RuntimeError so every "must raise" check that predates it still holds. The
# message names the side and carries a Fix:; measure turns it into the
# UNMEASURED verdict rather than a KEEP/REVERT built from what did get measured.
class Unmeasured < RuntimeError
  attr_reader :side, :part

  def initialize(side, part, message)
    @side = side
    @part = part
    super(message)
  end
end

FORGE_CLIS = %w[gh glab gh-athena glab-athena].freeze
# git subcommands that only READ or manage a scratch worktree (never mutate
# harness content or history). Anything else under git (merge/commit/push/
# rebase/reset/checkout/branch/tag/update-ref/...) is denied.
GIT_ALLOWED_SUBCMDS = %w[
  worktree rev-parse cat-file show log status diff ls-files rev-list merge-base --version
].freeze

# The first positional token after `git` (its subcommand), skipping global
# option flags and the value of -C / -c. Mirrors admiral-eval's sandbox git
# parser: iterate a snapshot, never shift.
def git_subcommand(argv)
  skip = false
  argv.drop(1).each do |a|
    if skip
      skip = false
      next
    end
    case a
    when "-C", "-c" then skip = true
    when /\A-/ then next
    else return a
    end
  end
  nil
end

def command_allowed?(argv)
  return false if argv.nil? || argv.empty?

  prog = File.basename(argv[0].to_s)
  return false if FORGE_CLIS.include?(prog)     # never touch the forge
  return false if argv.include?("--update-baseline") # never re-baseline a corpus
  if prog == "git"
    return GIT_ALLOWED_SUBCMDS.include?(git_subcommand(argv))
  end

  true
end

# The ONE guarded execution primitive. Refuses a forbidden argv rather than
# running it. Returns [stdout, stderr, Process::Status].
def capture(argv, chdir: nil, stdin_data: "", env: nil)
  unless command_allowed?(argv)
    raise MutationAttempt,
          "variant-eval refused a non-read-only command: #{argv.inspect}. " \
          "Fix: variant-eval is a measurement instrument — it must NEVER merge, " \
          "commit, push, or re-baseline. Route only read-only/worktree commands " \
          "through the single guarded exec primitive."
  end
  opts = { stdin_data: stdin_data }
  opts[:chdir] = chdir if chdir
  cmd = env ? [env, *argv] : argv
  Open3.capture3(*cmd, **opts)
end

# ---------------------------------------------------------------------------
# PURE SCORING (all exercised synthetically by --self-test; no model, no git).
# ---------------------------------------------------------------------------

# EXACT pass-set diff — identical semantics to harness-eval/admiral-eval
# diff_baseline. Sets are { case_name => bool }.
def deterministic_diff(base_set, var_set)
  regressed = base_set.select { |name, was| was && var_set[name] == false }.keys
  fixed     = base_set.select { |name, was| !was && var_set[name] == true }.keys
  new_cases = var_set.keys - base_set.keys
  { regressed: regressed.sort, fixed: fixed.sort, new: new_cases.sort }
end

# The DND-174 pilot envelope rule, alone (now EvalScore.pilot_flip):
#   :regressed  iff p_base - p_var > envelope
#   :improved   iff p_var - p_base > envelope
#   :inconclusive otherwise (any flip WITHIN the envelope)
# T2 rows no longer use it alone: t2_rows applies EvalScore.classify, which
# ORs it with the statistical rule for regressions and ANDs it for improvements.
def classify_flip(p_base, p_var, envelope = DELTA_NOISE)
  EvalScore.pilot_flip(p_base, p_var, envelope)
end

# Pure verdict from gate status + the set of regressions and improvements.
#   gate red                              -> :blocked
#   a side not measured (DND-504)         -> :unmeasured (outranks KEEP/REVERT)
#   any regression                        -> :revert
#   zero regressions, >=1 improvement     -> :keep
#   zero regressions, no improvement      -> :inconclusive
def verdict(gate_ok:, regressions:, improvements:, unmeasured: nil)
  return :blocked unless gate_ok
  return :unmeasured if unmeasured
  return :revert if regressions.any?
  return :keep   if improvements.any?

  :inconclusive
end

# ---------------------------------------------------------------------------
# PROPOSAL RENDERING — the tool's only output. Proposal-only, human-gated.
# ---------------------------------------------------------------------------
def render_proposal(res)
  lines = []
  lines << "=== variant-eval PROPOSAL (measurement instrument; human-gated; proposal-only) ==="
  lines << "variant:  #{res[:variant]}"
  lines << "baseline: #{res[:baseline]}"
  lines << "corpus:   #{res[:corpus]}"
  lines << "gate (variant): #{res[:gate_ok] ? 'GREEN' : 'RED'}"
  lines << ""

  if res[:verdict] == :blocked
    lines << "VERDICT: BLOCKED — the variant's standing gate is RED; not scored."
    lines << "  (never-commit-a-broken-harness: a variant that fails the gate is not a candidate.)"
    lines << "  Fix: run `ai/bin/harness-gate` on the variant ref, make every check PASS, then re-run variant-eval."
    (res[:gate_detail] || []).each { |l| lines << "    #{l}" }
    return lines.join("\n") + "\n"
  end

  un = res[:unmeasured]
  lines << "deterministic corpus (exact pass-set diff):"
  if (d = res[:deterministic])
    lines << "  regressed (pass->fail): #{d[:regressed].empty? ? 'none' : d[:regressed].join(', ')}"
    lines << "  fixed (fail->pass):     #{d[:fixed].empty?     ? 'none' : d[:fixed].join(', ')}"
    lines << "  new cases:              #{d[:new].empty?       ? 'none' : d[:new].join(', ')}"
  else
    why = un ? " — the #{un[:side]} side's #{un[:part]} run could not be measured (see VERDICT)" : ""
    lines << "  NOT MEASURED#{why}."
  end
  if res[:corpus] == "full"
    lines << ""
    lines << "T2 corpus (pass-rate, Wilson 95%; regression = Newcombe interval excludes 0 OR " \
             "|Δp| > #{DELTA_NOISE}; improvement = both):"
    if (subj = res[:t2_subjects])
      b = subj[:base]
      v = subj[:var]
      lines << "  subject (baseline): #{b['lines']} lines sha #{b['sha256'][0, 12]}"
      lines << "  subject (variant):  #{v['lines']} lines sha #{v['sha256'][0, 12]}"
      if b["sha256"] == v["sha256"]
        lines << "  T2 subjects IDENTICAL: the variant does not change the rendered admiral, so any T2 flip " \
                 "below is sampling noise by construction."
      end
    end
    lines << "  A/B comparability: only when both refs are at or after 35be30f (DND-503), with each side's " \
             "subject sha recorded; an unrecorded side is n/a."
    if un && res[:t2].nil?
      lines << "  T2 NOT MEASURED — the #{un[:side]} side's #{un[:part]} run could not be measured (see VERDICT)."
    elsif (res[:t2] || []).empty?
      lines << "  (no T2 cases evaluated)"
    else
      res[:t2].each do |c|
        lines << format("  %-34s base=%s var=%s -> %s", c[:name], EvalScore.format_score(c[:base]),
                        EvalScore.format_score(c[:var]), c[:flip].to_s.upcase)
      end
    end
  end

  lines << ""
  case res[:verdict]
  when :unmeasured
    lines << "VERDICT: UNMEASURED — the #{un[:side]} side's #{un[:part]} corpus ran but was NOT measured; " \
             "not scored. This is \"could not measure\", not \"no regressions found\"."
    lines << "  side: #{un[:side]}  corpus: #{un[:part]}"
    lines << "  #{un[:reason]}"
    lines << "  Fix: make the #{un[:side]} ref's #{un[:part]} run complete (see the reason above), then re-run " \
             "variant-eval. No KEEP/REVERT is proposed from a partial measurement." \
      unless un[:reason].to_s.include?("Fix:")
  when :revert
    lines << "VERDICT: REVERT — the variant regresses a known case; never trade a known regression for an unproven gain."
    lines << "  regressions: #{res[:regressions].join(', ')}"
    lines << "  Fix: do NOT adopt this variant. Restore the regressed behavior on the variant ref (keep every " \
             "guard the baseline caught), then re-run variant-eval; adoption stays a human decision."
  when :keep
    lines << "VERDICT: #{KEEP_LABEL}"
    lines << "  improvements: #{res[:improvements].join(', ')}"
    lines << "  This is a PROPOSAL only. variant-eval performs NO merge/commit/push/adopt. A human adopts the " \
             "variant by merging it AFTER the standing gate is green."
  when :inconclusive
    lines << "VERDICT: INCONCLUSIVE — no improvement claim. Zero regressions, but no case improves beyond the noise band."
    lines << "  (A T2 flip whose Newcombe 95% interval includes 0, or within Δ_noise=#{DELTA_NOISE}, is sampling " \
             "noise, not a measured delta. See ai/docs/eval-noise-band.md.)"
  end

  lines.join("\n") + "\n"
end

# ---------------------------------------------------------------------------
# MACHINE-READABLE PROPOSAL (DND-527) — schema v1, for block-optimize (DND-528).
# Built from the SAME res hash render_proposal reads, so text and JSON cannot
# disagree; the self-test reads the text back and checks that on every fixture.
# "Not measured" is null; "measured and found nothing" is []. A consumer must
# never be able to read a missing measurement as an empty one.
# ---------------------------------------------------------------------------
JSON_SCHEMA_ID = "variant-eval/proposal@1"

# Verdicts under which no complete regressions/improvements set exists.
UNSCORED_VERDICTS = %i[blocked unmeasured].freeze

def proposal_json(res)
  json_safe(proposal_hash(res))
end

# gate_detail and the unmeasured reason carry raw tool output, which may not be
# valid UTF-8; JSON generation raises on that. Every string is re-read as UTF-8
# with invalid bytes replaced (U+FFFD), so the proposal always serializes.
REPLACEMENT_CHAR = [0xFFFD].pack("U")

def json_safe(obj)
  case obj
  when Hash then obj.to_h { |k, v| [json_safe(k), json_safe(v)] }
  when Array then obj.map { |v| json_safe(v) }
  when String then obj.dup.force_encoding(Encoding::UTF_8).scrub(REPLACEMENT_CHAR)
  else obj
  end
end

def proposal_hash(res)
  verdict = res.fetch(:verdict)
  scored = !UNSCORED_VERDICTS.include?(verdict)
  full = res[:corpus] == "full"
  un = res[:unmeasured]
  det = res[:deterministic]
  subj = res[:t2_subjects]
  {
    "schema" => JSON_SCHEMA_ID,
    "variant" => res[:variant],
    "variant_sha" => res[:variant_sha],
    "baseline" => res[:baseline],
    "baseline_sha" => res[:baseline_sha],
    "corpus" => res[:corpus],
    "runs" => full ? res[:runs] : nil,
    "gate_ok" => res.fetch(:gate_ok),
    "gate_detail" => verdict == :blocked ? Array(res[:gate_detail]) : nil,
    "verdict" => verdict.to_s,
    "unmeasured" => un && { "side" => un[:side].to_s, "part" => un[:part].to_s, "reason" => un[:reason].to_s },
    "deterministic" => det && { "regressed" => det[:regressed], "fixed" => det[:fixed], "new" => det[:new] },
    "t2_subjects" => full && subj ? { "base" => subject_json(subj[:base]), "var" => subject_json(subj[:var]) } : nil,
    "t2" => full && res[:t2] ? res[:t2].map { |row| t2_row_json(row) } : nil,
    "regressions" => scored ? res.fetch(:regressions) : nil,
    "improvements" => scored ? res.fetch(:improvements) : nil
  }
end

def subject_json(subject)
  { "lines" => subject["lines"], "sha256" => subject["sha256"] }
end

def t2_row_json(row)
  side = ->(score) { score && { "k" => score[:k], "n" => score[:n] } }
  { "name" => row[:name], "base" => side.(row[:base]), "var" => side.(row[:var]), "flip" => row[:flip].to_s }
end

# Write data as JSON to path atomically: a temp file in the SAME directory,
# fsynced, then renamed over path. A reader sees the old path state or the
# whole new file, never a partial one. -> nil on success, else a reason; the
# temp file is removed on failure.
def write_json_atomic(path, data)
  body = JSON.pretty_generate(data) + "\n" # before any file exists: a generation error leaves nothing
  dir = File.dirname(File.expand_path(path))
  tmp = File.join(dir, ".#{File.basename(path)}.tmp-#{Process.pid}-#{format('%08x', rand(2**32))}")
  File.open(tmp, File::WRONLY | File::CREAT | File::EXCL, 0o644) do |f|
    f.write(body)
    f.flush
    f.fsync
  end
  File.rename(tmp, path)
  nil
rescue SystemCallError, IOError, JSON::JSONError, EncodingError => e
  begin
    File.delete(tmp) if tmp && File.exist?(tmp)
  rescue SystemCallError
    nil
  end
  "#{e.class}: #{e.message}"
end

# Why an output file path (--out or --json) cannot be written, or nil. Checked
# BEFORE measuring, so a full run (~50 model calls) cannot end with nowhere to
# write.
def output_path_problem(flag, path)
  full = File.expand_path(path)
  return "#{flag} #{path} is a directory" if File.directory?(full)

  dir = File.dirname(full)
  return "#{flag} #{path}: directory #{dir} does not exist" unless File.directory?(dir)
  return "#{flag} #{path}: directory #{dir} is not writable" unless File.writable?(dir)

  nil
end

# The file a path names once every symlink is followed (the directory's, and
# the file's own when it exists). Used to tell whether two paths are one file.
def canonical_path(path)
  full = File.join(File.realpath(File.dirname(File.expand_path(path))), File.basename(path))
  File.exist?(full) ? File.realpath(full) : full
end

def variant_eval_proposal?(path)
  data = JSON.parse(File.read(path))
  data.is_a?(Hash) && data["schema"].to_s.start_with?("variant-eval/proposal@")
rescue JSON::ParserError, SystemCallError, EncodingError
  false
end

# The --json pre-flight. Beyond output_path_problem it refuses the --out file
# (even through a symlink), a symlink, and any existing file that is not an
# earlier variant-eval proposal (a typo must never delete a real file). An
# earlier proposal is removed: a run that later dies without a proposal then
# leaves NO JSON, which a consumer reads as not measured, never as that
# earlier run's verdict. -> nil when usable, else a reason.
def prepare_json_path(path, out_file)
  why = output_path_problem("--json", path)
  return why if why

  full = File.expand_path(path)
  return "--json #{path} is a symlink; name the real file" if File.symlink?(full)
  if out_file && output_path_problem("--out", out_file).nil? && canonical_path(out_file) == canonical_path(full)
    return "--json #{path} is the same file as --out #{out_file}"
  end
  return nil unless File.exist?(full)
  unless variant_eval_proposal?(full)
    return "--json #{path} already exists and is not a variant-eval proposal; refusing to replace it"
  end

  File.delete(full)
  nil
rescue SystemCallError => e
  "--json #{path}: #{e.class}: #{e.message}"
end

# ---------------------------------------------------------------------------
# IMPURE MEASUREMENT — worktree add / run corpus / collect / tear down.
# Exercised only by a real --variant run; NEVER by --self-test.
# ---------------------------------------------------------------------------

# Create a detached scratch worktree for `ref` and yield its path; remove it
# after. Never checks out in place.
def with_worktree(ref)
  Dir.mktmpdir("variant-eval-wt-") do |parent|
    wt = File.join(parent, "tree")
    _o, err, st = capture(["git", "worktree", "add", "--detach", wt, ref])
    raise "git worktree add failed for #{ref.inspect}: #{err.strip}" unless st.success?

    begin
      yield wt
    ensure
      _ro, rerr, rst = capture(["git", "worktree", "remove", "--force", wt])
      unless rst.success?
        warn "variant-eval: Note: could not remove scratch worktree #{wt}: #{rerr.strip}. " \
             "Fix: run `git worktree prune` once the path is gone."
      end
    end
  end
end

# Run the standing gate in a worktree. Returns [ok, detail_lines].
def run_gate(wt)
  out, err, st = capture(["ai/bin/harness-gate"], chdir: wt)
  detail = (out.to_s + err.to_s).lines.map(&:chomp).last(12)
  [st.success?, detail]
end

# Collect the deterministic per-case pass-set in a worktree:
#   he:<name> from harness-eval's scorecard.json
#   ae:<name> for every admiral-eval T1 hook-stdin fixture
def collect_deterministic(wt, side)
  set = {}

  # harness-eval writes ai/eval/scorecard.json with per-case {name, pass}.
  # That file is COMMITTED, so a run that did not rewrite it (a crash, exit 2,
  # no fixtures) leaves the ref's stale copy behind, which would read as this
  # run's measurement (DND-504). Exit 1 is harness-eval's own "a case failed /
  # regressed" verdict and IS a measurement.
  started = Time.at(Time.now.to_i).utc
  _o, err, st = capture(["ai/bin/harness-eval"], chdir: wt)
  why = harness_eval_problem(File.join(wt, SCORECARD_REL), st, started)
  if why
    raise Unmeasured.new(side, "deterministic",
                         "the #{side} side's harness-eval did not measure: #{why}#{stderr_tail(err)}. " \
                         "Fix: run `ai/bin/harness-eval` in the #{side} ref and make it complete and write " \
                         "#{SCORECARD_REL}, then re-run variant-eval.")
  end
  JSON.parse(File.read(File.join(wt, SCORECARD_REL)))["cases"]
      .each { |c| set["he:#{c['name']}"] = (c["pass"] == true) }

  # admiral-eval T1 hook-stdin cases (mode=hook-stdin), run via the same isolated
  # -HOME hook primitive harness-eval/admiral-eval use.
  Dir.glob(File.join(wt, ADMIRAL_FIXTURES, "*")).sort.each do |dir|
    meta_path = File.join(dir, "meta")
    next unless File.file?(meta_path)

    meta = parse_meta(meta_path)
    next unless meta["mode"] == "hook-stdin"

    got = hook_verdict(wt, meta["guard"], File.join(dir, meta["input"].to_s))
    # :error (missing / signaled hook) never passes either expectation — the
    # admiral-eval hook_pass? rule: a dead guard is not a clean one.
    set["ae:#{File.basename(dir)}"] = (got == :fires && meta["expect"] == "fires") ||
                                      (got == :clean && meta["expect"] == "clean")
  end

  set
end

# Why a harness-eval run is not a measurement, or nil when it is.
def harness_eval_problem(scorecard, st, started)
  return "it #{exit_phrase(st)}" unless st&.exited? && [0, 1].include?(st.exitstatus)
  return "it wrote no #{SCORECARD_REL}" unless File.file?(scorecard)

  data = JSON.parse(File.read(scorecard))
  generated = Time.parse(data["generated"].to_s).utc
  if generated < started
    return "#{SCORECARD_REL} was not rewritten by this run (generated #{data['generated']}, run started " \
           "#{started.iso8601}) — it is the ref's committed copy, not a measurement"
  end
  return "#{SCORECARD_REL} lists 0 cases" if Array(data["cases"]).empty?

  nil
rescue JSON::ParserError, ArgumentError, TypeError => e
  "#{SCORECARD_REL} is unreadable (#{e.class}: #{e.message[0, 120]})"
end

def exit_phrase(st)
  return "did not report a status" unless st
  return "was killed by signal #{st.termsig}" if st.signaled?

  "exited #{st.exitstatus}"
end

def stderr_tail(err)
  tail = err.to_s.lines.map(&:strip).reject(&:empty?).last(2)
  tail.empty? ? "" : " (stderr: #{tail.join(' | ')[0, 240]})"
end

def parse_meta(path)
  meta = {}
  File.foreach(path) do |line|
    line = line.strip
    next if line.empty? || line.start_with?("#")

    k, _, v = line.partition("=")
    meta[k.strip] = v.strip
  end
  meta
end

# Pipe the fixture JSON into the worktree's ai/hooks/<guard>.sh under an isolated
# HOME (so per-invocation hook dedup state is fresh every run). Three states, as
# admiral-eval's hook_verdict_at: :fires (ran, emitted a PreToolUse deny),
# :clean (ran, no deny), :error (missing / not executable / unreadable input /
# signaled). :error is never :clean — a dead guard must not pass expect=clean.
def hook_verdict(wt, guard, input_path)
  hook = File.join(wt, "ai", "hooks", "#{guard}.sh")
  return :error unless File.executable?(hook) && File.file?(input_path)

  input = File.read(input_path)
  Dir.mktmpdir("variant-eval-home-") do |home|
    out, _err, st = capture([hook], chdir: wt, stdin_data: input, env: { "HOME" => home })
    return :error unless st&.exited?

    out.include?('"permissionDecision":"deny"') ? :fires : :clean
  end
end

# The T2 argv for one side. --agent-file names THIS worktree's rendered admiral
# (DND-503): a bare `admiral-eval --run` would let `claude --agent` resolve the
# admiral from ~/.claude/agents — the MAIN checkout — for both sides, so the
# T2 delta would compare one subject against itself.
def t2_argv(wt, runs)
  ["ai/bin/admiral-eval", "--run", "--runs", runs.to_s, "--agent-file", File.join(wt, ADMIRAL_AGENT_REL)]
end

# Fingerprint of the render a side's T2 run evaluates. A missing render raises:
# it must never read as "a subject with no T2 cases".
def t2_subject(wt)
  path = File.join(wt, ADMIRAL_AGENT_REL)
  unless File.file?(path)
    raise "no rendered admiral at #{path}. Fix: the ref must carry #{ADMIRAL_AGENT_REL} " \
          "(render it with ai/bin/build-agents and commit it) before --corpus full can evaluate it."
  end

  body = File.read(path)
  { "file" => path, "lines" => body.lines.size, "sha256" => Digest::SHA256.hexdigest(body) }
end

# admiral-eval prints `subject: <file> N lines sha <12 hex> (loaded inline via
# --agents ...)` before any case runs. Require that line, with the sha of the
# render t2_subject fingerprinted, before scoring a side. Without it the
# proposal could print a fingerprint for a render that never ran: a ref from
# before DND-503 ignores --agent-file and evaluates the main checkout's admiral.
T2_SUBJECT_LINE = /^subject: .* sha ([0-9a-f]{12}) \(loaded inline via --agents/.freeze

def confirm_t2_subject!(out, expected, side)
  m = out.to_s.match(T2_SUBJECT_LINE)
  want = expected["sha256"][0, 12]
  return if m && m[1] == want

  got = m ? "sha #{m[1]}" : "no `subject:` line"
  raise Unmeasured.new side, "T2", "the #{side} T2 run did not confirm it evaluated #{expected['file']} (sha #{want}); its " \
        "admiral-eval reported #{got}. Fix: the #{side} ref's ai/bin/admiral-eval must support " \
        "--agent-file (DND-503) — use a ref at or after that change, or run --corpus deterministic; " \
        "if the admiral-eval run failed, run `#{t2_argv('<wt>', 1).join(' ')}` in that ref to see why."
end

# admiral-eval's closing line once every case has been scored.
T2_SUMMARY_LINE = %r{^admiral-eval: (\d+)/(\d+) cases pass}.freeze
# admiral-eval's stderr line for one model call that never answered.
T2_INVOCATION_FAILED = /^\s*! admiral invocation failed/.freeze
# T1 rows in admiral-eval's output carry this mode; every other mode is T2.
T1_MODE = "hook-stdin"

# Characterize the T2 model-in-loop cases in a worktree by running
# admiral-eval --run --runs N --agent-file <wt's render> and parsing its
# per-case rate column. Returns { case_name => EvalScore::Counts } (DND-225:
# counts, not fractions, so the noise-threshold rule can size each interval).
#
# A run that did not MEASURE raises Unmeasured (DND-504) instead of returning
# {} — which rendered as "(no T2 cases evaluated)" and let the deterministic
# set alone print KEEP. admiral-eval exits 1 on its own baseline regression, so
# exit 1 is a measurement when the run COMPLETED: its closing summary is
# present and agrees with the rows, at least one T2 row parsed, and no model
# call failed (a failed call scores as a FAIL sample, so p would be the auth
# outage, not the admiral).
def collect_t2_counts(wt, runs, subject, side)
  out, err, st = capture(t2_argv(wt, runs), chdir: wt)
  unless st&.exited? && [0, 1].include?(st.exitstatus)
    raise_t2_unmeasured(side, "admiral-eval #{exit_phrase(st)}#{stderr_tail(err)}")
  end
  confirm_t2_subject!(out, subject, side)

  rows = parse_t2_rows(out)
  problem = t2_run_problem(out, err, rows)
  raise_t2_unmeasured(side, "#{problem} (admiral-eval #{exit_phrase(st)})") if problem

  # DND-513: positive classification — a row counts as T2 only when it carries
  # a recognized, non-T1 mode. This excludes admiral-eval's [hook-stdin] (T1)
  # rows, which are already scored by the `ae:` deterministic corpus; folding
  # them in here double-counted a T1 flip as a T2 regression/improvement. A row
  # matching neither shape (no mode captured at all) never reaches this line —
  # t2_run_problem raises on it above, so it is surfaced, not silently dropped.
  rows.select { |r| r[:mode] && r[:mode] != T1_MODE }.to_h { |r| [r[:name], r[:counts]] }
end

# Every "PASS|FAIL <name> <passes>/<samples> [<mode>] ..." row. A row with 0
# samples (an invalid case config) has fraction nil: it was never sampled.
def parse_t2_rows(out)
  out.to_s.each_line.filter_map do |line|
    m = line.match(%r{\A(?:PASS|FAIL)\s+(\S+)\s+(\d+)/(\d+)\b(?:\s+\[([^\]]+)\])?})
    next unless m

    samples = m[3].to_i
    counts = samples.positive? ? EvalScore.counts(m[2].to_i, samples) : nil
    { name: m[1], fraction: counts && counts.k.to_f / counts.n, counts: counts, mode: m[4] }
  end
end

# Why a run that exited 0/1 is still not a T2 measurement, or nil.
def t2_run_problem(out, err, rows)
  summary = out.to_s.match(T2_SUMMARY_LINE)
  return "no closing `admiral-eval: P/T cases pass` summary — the run stopped before scoring every case" \
    unless summary
  if summary[2].to_i != rows.size
    return "its summary counts #{summary[2]} case(s) but #{rows.size} row(s) parsed"
  end

  unsampled = rows.select { |r| r[:fraction].nil? }.map { |r| r[:name] }
  return "#{unsampled.size} case(s) scored 0/0, never sampled: #{unsampled.join(', ')}" if unsampled.any?

  # DND-513: a row with no [mode] tag matches neither the T1 (hook-stdin) nor
  # the T2 (model-in-loop) shape. Surface it rather than let it silently fall
  # out of both the T1 count and collect_t2_counts' T2 hash.
  unmoded = rows.reject { |r| r[:mode] }.map { |r| r[:name] }
  return "#{unmoded.size} case(s) had no [mode] tag, matching neither T1 nor T2: #{unmoded.join(', ')}" \
    if unmoded.any?

  failed = err.to_s.each_line.select { |l| l.match?(T2_INVOCATION_FAILED) }
  if failed.any?
    return "#{failed.size} model invocation(s) failed — the model never answered those samples, so their " \
           "FAILs measure the invocation (auth, quota, network), not the admiral (first: " \
           "#{failed.first.strip[0, 200]})"
  end
  t2 = rows.count { |r| r[:mode] && r[:mode] != T1_MODE }
  return "0 T2 cases parsed (#{rows.size} T1 row(s) only)" if t2.zero?

  nil
end

def raise_t2_unmeasured(side, why)
  raise Unmeasured.new(side, "T2",
                       "the #{side} side's T2 run did not measure: #{why}. Fix: run " \
                       "`#{t2_argv('<wt>', 1).join(' ')}` in the #{side} ref to see why (model auth, a crash, " \
                       "no T2 fixtures), fix it, and re-run; or use --corpus deterministic, which claims no T2.")
end

# Pure: per-case T2 rows + the regressions/improvements they contribute, under
# the DND-225 noise-threshold rule (EvalScore.classify): regression = Newcombe
# interval excludes 0 OR the pilot envelope; improvement = both; a side that
# was not measured is n/a (:new) or fails closed (:missing), never a 0.
def t2_rows(base_counts, var_counts)
  rows = []
  regressions = []
  improvements = []
  (base_counts.keys | var_counts.keys).sort.each do |name|
    base = base_counts[name]
    var = var_counts[name]
    flip = EvalScore.classify(base, var)
    rows << { name: name, base: EvalScore.case_score(base), var: EvalScore.case_score(var), flip: flip }
    regressions << "t2:#{name}"  if EvalScore.regression?(flip)
    improvements << "t2:#{name}" if flip == :improved
  end
  { rows: rows, regressions: regressions, improvements: improvements }
end

def measure(variant:, baseline:, corpus:, runs:, out_file:, json_file: nil)
  # DND-527: each ref is resolved to a commit ONCE, and that sha is what gets
  # checked out and recorded, so the proposal names exactly what was measured.
  res = { variant: variant, variant_sha: resolve_commit(variant), baseline: baseline,
          baseline_sha: resolve_commit(baseline), corpus: corpus, runs: runs }
  measure_sides(res, variant: res[:variant_sha], baseline: res[:baseline_sha], corpus: corpus, runs: runs)
  emit(res, out_file, json_file)
rescue Unmeasured => e
  # A side ran but did not measure. What WAS measured stays in res and is
  # rendered; the verdict is UNMEASURED, never KEEP/REVERT (DND-504).
  res[:unmeasured] = { side: e.side, part: e.part, reason: e.message }
  res[:verdict] = verdict(gate_ok: res.fetch(:gate_ok, true), regressions: [], improvements: [],
                          unmeasured: res[:unmeasured])
  emit(res, out_file, json_file)
end

# The full commit sha a ref names, via the guarded capture (rev-parse is
# read-only). A ref that names no commit raises with a Fix:, before any worktree.
def resolve_commit(ref)
  out, err, st = capture(["git", "rev-parse", "--verify", "--quiet", "--end-of-options", "#{ref}^{commit}"])
  sha = out.to_s.strip
  return sha if st.success? && sha.match?(/\A[0-9a-f]{40,64}\z/)

  raise "#{ref.inspect} does not name a commit#{stderr_tail(err)}. Fix: pass a branch, tag or sha that " \
        "`git rev-parse --verify --end-of-options '#{ref}^{commit}'` resolves (fetch it first if it is a " \
        "remote ref)."
end

# Fill res with the gate result, the deterministic diff and (for --corpus full)
# the T2 characterization. Raises Unmeasured when a side ran but did not measure.
def measure_sides(res, variant:, baseline:, corpus:, runs:)
  with_worktree(variant) do |var_wt|
    # Gate short-circuit BEFORE any delta (never-commit-a-broken-harness).
    gate_ok, gate_detail = run_gate(var_wt)
    res[:gate_ok] = gate_ok
    unless gate_ok
      res[:verdict] = :blocked
      res[:gate_detail] = gate_detail
      return
    end

    var_det = collect_deterministic(var_wt, "variant")

    with_worktree(baseline) do |base_wt|
      base_det = collect_deterministic(base_wt, "baseline")
      diff = deterministic_diff(base_det, var_det)
      res[:deterministic] = diff

      regressions = diff[:regressed].dup
      improvements = diff[:fixed].dup
      t2 = []

      if corpus == "full"
        res[:t2_subjects] = { base: t2_subject(base_wt), var: t2_subject(var_wt) }
        t2_out = t2_rows(collect_t2_counts(base_wt, runs, res[:t2_subjects][:base], "baseline"),
                         collect_t2_counts(var_wt, runs, res[:t2_subjects][:var], "variant"))
        t2 = t2_out[:rows]
        regressions.concat(t2_out[:regressions])
        improvements.concat(t2_out[:improvements])
      end

      res[:t2] = t2
      res[:regressions] = regressions
      res[:improvements] = improvements
      res[:verdict] = verdict(gate_ok: true, regressions: regressions, improvements: improvements)
    end
  end
end

# Exit code when the proposal was computed but an output file (--out or
# --json) could not be written. The proposal is still printed; a consumer that
# finds no JSON must treat the run as not measured.
OUTPUT_WRITE_FAILED_EXIT = 3

def emit(res, out_file, json_file = nil)
  text = render_proposal(res)
  puts text
  failed = false
  if out_file
    begin
      File.write(out_file, text)
      puts "variant-eval: proposal written to #{out_file}"
    rescue SystemCallError, IOError => e
      warn "variant-eval: FAILED — could not write the proposal to --out #{out_file}: #{e.class}: #{e.message}."
      warn "  Fix: pass --out a path in an existing, writable directory, then re-run. The proposal is printed above."
      failed = true
    end
  end
  if json_file
    why = write_json_atomic(json_file, proposal_json(res))
    if why
      warn "variant-eval: FAILED — could not write the JSON proposal to #{json_file}: #{why}."
      warn "  Fix: pass --json a path in an existing, writable directory, then re-run. No JSON was left at " \
           "#{json_file}; a consumer must read that as not measured."
      failed = true
    else
      puts "variant-eval: JSON proposal (#{JSON_SCHEMA_ID}) written to #{json_file}"
    end
  end
  failed ? OUTPUT_WRITE_FAILED_EXIT : verdict_exit_code(res[:verdict])
end

# A "do not adopt" or "not measured" verdict exits non-zero for CLI callers; the
# tool is not a gate, so this exit code never affects harness-gate.
def verdict_exit_code(verdict)
  %i[revert blocked unmeasured].include?(verdict) ? 1 : 0
end

# ---------------------------------------------------------------------------
# --self-test — NO model, NO git. Synthetic pass-sets + stub argv only.
# ---------------------------------------------------------------------------
def self_test
  ok = true
  fail = ->(msg) { warn "self-test: FAIL — #{msg}"; ok = false }
  # DND-527: every res fixture below that render_proposal reads is also fed to
  # proposal_json, so text and JSON are checked against the SAME hash.
  json_fixtures = {}

  # (a) a true->false deterministic flip -> REVERT
  diff_a = deterministic_diff({ "c1" => true }, { "c1" => false })
  fail.("a pass->fail must be regressed: #{diff_a.inspect}") unless diff_a[:regressed] == ["c1"]
  va = verdict(gate_ok: true, regressions: diff_a[:regressed], improvements: diff_a[:fixed])
  fail.("deterministic regression must verdict REVERT (got #{va})") unless va == :revert

  # (b) strictly-better zero-regression set -> KEEP (pending gate)
  diff_b = deterministic_diff({ "c1" => false, "c2" => true }, { "c1" => true, "c2" => true })
  fail.("a fail->pass must be fixed: #{diff_b.inspect}") unless diff_b[:fixed] == ["c1"]
  fail.("a strictly-better set must have no regression") unless diff_b[:regressed].empty?
  vb = verdict(gate_ok: true, regressions: diff_b[:regressed], improvements: diff_b[:fixed])
  fail.("zero-regression + improvement must verdict KEEP (got #{vb})") unless vb == :keep

  # (c) within-envelope flip (p_base=0.6, p_var=0.6, the AE-02 shape) -> INCONCLUSIVE
  fail.("equal fractions must be INCONCLUSIVE") unless classify_flip(0.6, 0.6) == :inconclusive
  fail.("a small flip within Δ_noise must be INCONCLUSIVE") unless classify_flip(0.6, 0.5) == :inconclusive
  fail.("a within-envelope flip must NOT be regressed") if classify_flip(0.6, 0.5) == :regressed
  fail.("a within-envelope flip must NOT be improved") if classify_flip(0.5, 0.6) == :improved
  # boundaries: a flip of EXACTLY Δ_noise is NOT beyond the envelope -> inconclusive.
  # Exercise BOTH the exactly-0.3 float pair AND the reachable N=10 fractions whose
  # difference float-rounds ABOVE 0.3 (9/10 vs 6/10 -> 0.30000000000000004); a
  # naive `> envelope` would misclassify these as regressed/improved.
  fail.("a flip of exactly Δ_noise must be INCONCLUSIVE") unless classify_flip(0.6, 0.3) == :inconclusive
  fail.("9/10 vs 6/10 (float 0.3000…4) must be INCONCLUSIVE, not regressed") \
    unless classify_flip(0.9, 0.6) == :inconclusive
  fail.("6/10 vs 9/10 (float 0.3000…4) must be INCONCLUSIVE, not improved") \
    unless classify_flip(0.6, 0.9) == :inconclusive
  fail.("8/10 vs 5/10 (exactly Δ_noise) must be INCONCLUSIVE") unless classify_flip(0.8, 0.5) == :inconclusive
  # a flip that genuinely clears the envelope
  fail.("a 1.0->0.6 flip (0.4 > Δ_noise) must be regressed") unless classify_flip(1.0, 0.6) == :regressed
  fail.("a 0.6->1.0 flip (0.4 > Δ_noise) must be improved") unless classify_flip(0.6, 1.0) == :improved
  fail.("a 1.0->0.0 flip must be regressed") unless classify_flip(1.0, 0.0) == :regressed
  fail.("a 0.0->1.0 flip must be improved") unless classify_flip(0.0, 1.0) == :improved
  # a within-envelope T2 flip contributes INCONCLUSIVE: no regression/improvement
  vc = verdict(gate_ok: true, regressions: [], improvements: [])
  fail.("no regression + no improvement must verdict INCONCLUSIVE (got #{vc})") unless vc == :inconclusive

  # (g) DND-225 regression: a T2 case present only in the variant has no
  # baseline measurement. It is n/a (:new), never scored against a coerced 0.0
  # (which made any new case an "improvement" and could alone yield a KEEP).
  c = EvalScore::Counts
  new_only = t2_rows({}, { "AE-new" => c.new(10, 10) })
  fail.("a variant-only T2 case must NOT be an improvement (got #{new_only[:improvements].inspect})") \
    unless new_only[:improvements].empty?
  fail.("a variant-only T2 case must classify :new (n/a)") \
    unless new_only[:rows].map { |r| r[:flip] } == [:new]
  # A case measured on the baseline but absent from the variant fails CLOSED.
  gone = t2_rows({ "AE-gone" => c.new(10, 10) }, {})
  fail.("a T2 case missing from the variant must count as a regression") \
    unless gone[:regressions] == ["t2:AE-gone"]
  # (i) the statistical rule is wired: a drop the pilot envelope misses but the
  # Newcombe interval excludes 0 on is a regression (never less sensitive) ...
  stat_reg = t2_rows({ "a" => c.new(30, 30) }, { "a" => c.new(24, 30) })
  fail.("30/30 -> 24/30 must be a T2 regression via the statistical rule") \
    unless stat_reg[:regressions] == ["t2:a"]
  # ... and an improvement needs BOTH rules (a KEEP only gets harder).
  hard_keep = t2_rows({ "a" => c.new(5, 10) }, { "a" => c.new(9, 10) })
  fail.("5/10 -> 9/10 must NOT be an improvement (interval includes 0)") unless hard_keep[:improvements].empty?
  # (j) the full-corpus proposal renders an unmeasured side as n/a (never 0.00)
  # and states that A/B comparability is blocked on DND-503.
  full_res = {
    variant: "cand", baseline: "origin/main", corpus: "full", runs: 10, gate_ok: true, verdict: :inconclusive,
    deterministic: { regressed: [], fixed: [], new: [] }, t2: new_only[:rows],
    regressions: [], improvements: []
  }
  json_fixtures[:full_new_only] = full_res
  full_out = render_proposal(full_res)
  fail.("a variant-only T2 row must render base=n/a") unless full_out.include?("base=n/a")
  fail.("a variant-only T2 row must not render a 0.00 base") if full_out.include?("base=0.00")
  fail.("the full proposal must state when an A/B delta is comparable (DND-503, 35be30f)") \
    unless full_out.include?("at or after 35be30f (DND-503)")

  # (d) no KEEP output contains an adopt/commit/merge COMMAND token
  keep_res = {
    variant: "cand", baseline: "origin/main", corpus: "deterministic", gate_ok: true,
    verdict: :keep, deterministic: { regressed: [], fixed: ["c1"], new: [] },
    regressions: [], improvements: ["c1"]
  }
  json_fixtures[:keep] = keep_res
  keep_out = render_proposal(keep_res)
  fail.("a KEEP proposal must carry the human-gate label") \
    unless keep_out.include?("requires gate-green + explicit human adoption")
  MUTATION_COMMAND_STRINGS.each do |tok|
    fail.("a KEEP proposal must NOT contain the mutation command #{tok.inspect}") if keep_out.include?(tok)
  end

  # (e) a variant whose gate fails -> BLOCKED before scoring
  ve = verdict(gate_ok: false, regressions: ["anything"], improvements: ["anything"])
  fail.("a red gate must verdict BLOCKED regardless of delta (got #{ve})") unless ve == :blocked
  blocked_res = {
    variant: "cand", baseline: "origin/main", corpus: "deterministic",
    gate_ok: false, verdict: :blocked, gate_detail: ["some check FAILED"]
  }
  json_fixtures[:blocked] = blocked_res
  blocked_out = render_proposal(blocked_res)
  fail.("a BLOCKED proposal must say it was not scored") unless blocked_out.include?("not scored")

  # (f) every failure/deny path carries Fix:
  fail.("BLOCKED proposal must carry a Fix: line") unless blocked_out.include?("Fix:")
  revert_res = {
    variant: "cand", baseline: "origin/main", corpus: "deterministic", gate_ok: true,
    verdict: :revert, deterministic: { regressed: ["c1"], fixed: [], new: [] },
    regressions: ["c1"], improvements: []
  }
  json_fixtures[:revert] = revert_res
  revert_out = render_proposal(revert_res)
  fail.("REVERT proposal must carry a Fix: line") unless revert_out.include?("Fix:")

  # (g) DND-503: each side's T2 run evaluates ITS OWN worktree's rendered
  # admiral. A bare `admiral-eval --run` resolves the agent from ~/.claude/agents
  # (the MAIN checkout), so baseline and variant would score one subject twice
  # and the T2 delta could only ever show noise.
  Dir.mktmpdir("variant-eval-subject-") do |d|
    base_wt = File.join(d, "base")
    var_wt  = File.join(d, "var")
    same_wt = File.join(d, "same")
    [base_wt, var_wt, same_wt].each { |w| FileUtils.mkdir_p(File.join(w, "ai", "agents")) }
    front = "---\nname: athena-admiral\ndescription: x\nmodel: opus\n---\n\n"
    File.write(File.join(base_wt, ADMIRAL_AGENT_REL), front + "baseline prose\n")
    File.write(File.join(var_wt, ADMIRAL_AGENT_REL), front + "variant prose\n")
    File.write(File.join(same_wt, ADMIRAL_AGENT_REL), front + "baseline prose\n")

    argv_b = t2_argv(base_wt, 10)
    argv_v = t2_argv(var_wt, 10)
    agent_file = ->(argv) { (i = argv.index("--agent-file")) ? argv[i + 1] : nil }
    fail.("T2 argv must pass --agent-file for the baseline") \
      unless agent_file.(argv_b) == File.join(base_wt, ADMIRAL_AGENT_REL)
    fail.("T2 argv must pass --agent-file for the variant") \
      unless agent_file.(argv_v) == File.join(var_wt, ADMIRAL_AGENT_REL)
    fail.("baseline and variant T2 argv must differ in their subject") if argv_b == argv_v
    fail.("T2 argv must stay allowed by the containment guard") unless command_allowed?(argv_v)

    sb = t2_subject(base_wt)
    sv = t2_subject(var_wt)
    fail.("a variant whose render differs must fingerprint differently from baseline") \
      if sb["sha256"] == sv["sha256"]
    fail.("an identical render must fingerprint identically") unless t2_subject(same_wt)["sha256"] == sb["sha256"]

    # A worktree with no admiral render must raise with a Fix:, never read as a
    # subject with no T2 cases.
    begin
      t2_subject(File.join(d, "no-such-wt"))
      fail.("a missing render must raise")
    rescue RuntimeError => e
      fail.("a missing render must carry a Fix:") unless e.message.include?("Fix:")
    end

    # The proposal names both T2 subjects, and says so when they are identical.
    t2_res = {
      variant: "cand", baseline: "origin/main", corpus: "full", gate_ok: true, verdict: :inconclusive,
      deterministic: { regressed: [], fixed: [], new: [] }, t2: [], regressions: [], improvements: [],
      t2_subjects: { base: sb, var: sb }
    }
    same_out = render_proposal(t2_res)
    fail.("a full proposal must name the T2 subjects") unless same_out.include?(sb["sha256"][0, 12])
    fail.("identical T2 subjects must be called out") unless same_out.include?("IDENTICAL")
    json_fixtures[:full_same_subject] = t2_res
    diff_out = render_proposal(t2_res.merge(t2_subjects: { base: sb, var: sv }))
    # A full-corpus REVERT with T2 rows on both sides and differing subjects:
    # regressions and improvements drawn from both corpora.
    t2_mixed = t2_rows({ "AE-01" => c.new(10, 10), "AE-02" => c.new(0, 10), "AE-03" => c.new(5, 10) },
                       { "AE-01" => c.new(2, 10), "AE-02" => c.new(10, 10), "AE-03" => c.new(6, 10) })
    json_fixtures[:full_revert_mixed] = t2_res.merge(
      runs: 10, verdict: :revert, t2_subjects: { base: sb, var: sv }, t2: t2_mixed[:rows],
      deterministic: { regressed: ["he:x"], fixed: ["ae:y"], new: ["he:z"] },
      regressions: ["he:x"] + t2_mixed[:regressions], improvements: ["ae:y"] + t2_mixed[:improvements]
    )
    fail.("differing T2 subjects must not be called identical") if diff_out.include?("IDENTICAL")

    # The side's admiral-eval must CONFIRM it evaluated that render. A ref from
    # before DND-503 has an admiral-eval that silently ignores --agent-file and
    # runs the main checkout's admiral, while t2_subject still fingerprints the
    # worktree's render: the proposal would certify a subject that never ran.
    line = "subject: ai/agents/athena-admiral.md 5 lines sha #{sv['sha256'][0, 12]} " \
           "(loaded inline via --agents as athena-admiral-eval-subject)\n"
    begin
      confirm_t2_subject!("PASS AE-01 3/3 [next-action] ok\n" + line, sv, "variant")
    rescue RuntimeError => e
      fail.("a matching subject line must confirm the subject (raised: #{e.message})")
    end
    {
      "no subject line (a pre-DND-503 admiral-eval)" => "PASS AE-01 3/3 [next-action] ok\n",
      "a different subject sha" => line.sub(sv["sha256"][0, 12], sb["sha256"][0, 12])
    }.each do |label, out|
      begin
        confirm_t2_subject!(out, sv, "variant")
        fail.("#{label}: an unconfirmed T2 subject must raise, never score")
      rescue RuntimeError => e
        fail.("#{label}: the refusal must carry a Fix:") unless e.message.include?("Fix:")
      end
    end
    fail.("collect_t2_counts must confirm the evaluated subject") \
      unless File.read(__FILE__)[/^def collect_t2_counts.*?^end$/m].to_s.include?("confirm_t2_subject!(")

    # The measurement path must actually USE t2_argv: a correct t2_argv that the
    # runner bypasses would leave both sides on the main checkout's admiral.
    runner = File.read(__FILE__)[/^def collect_t2_counts.*?^end$/m].to_s
    fail.("collect_t2_counts must run admiral-eval via capture(t2_argv(...))") \
      unless runner.include?("capture(t2_argv(wt, runs)")
  end

  # (h) DND-504: a side whose admiral-eval ran but did not MEASURE must never
  # read as "no T2 cases". Each stub prints the confirmed subject line first, so
  # confirm_t2_subject! alone cannot catch it. Every such run must raise
  # Unmeasured naming the side and the exit/count, with a Fix:.
  Dir.mktmpdir("variant-eval-t2-unmeasured-") do |d|
    front = "---\nname: athena-admiral\ndescription: x\nmodel: opus\n---\n\n"
    row_t2 = "PASS AE-01-confirm-before-done 3/3 [next-action] ok"
    row_t1 = "PASS AE-13a-forge-auth-deny 1/1 [hook-stdin] ok"
    summary2 = "admiral-eval: 2/2 cases pass (runs/T2 case = 3)"
    stubs = {
      "exit 2 after the subject line" =>
        [["echo \"$SUBJECT\"", "exit 2"], /exit(ed)? 2/],
      "a crash after the subject line (exit 1, no summary)" =>
        [["echo \"$SUBJECT\"", "echo 'boom' >&2", "exit 1"], /summary/],
      "a signaled run" =>
        [["echo \"$SUBJECT\"", "kill -9 $$"], /signal/],
      "zero T2 cases parsed (only a T1 row)" =>
        [["echo \"$SUBJECT\"", "echo '#{row_t1}'", "echo 'admiral-eval: 1/1 cases pass (runs/T2 case = 3)'",
          "exit 0"], /0 T2 case/],
      "exit 2 after complete-looking output" =>
        [["echo \"$SUBJECT\"", "echo '#{row_t2}'", "echo '#{row_t1}'", "echo '#{summary2}'", "exit 2"],
         /exited 2/],
      "the summary disagrees with the parsed rows" =>
        [["echo \"$SUBJECT\"", "echo '#{row_t2}'", "echo 'admiral-eval: 1/3 cases pass (runs/T2 case = 3)'",
          "exit 0"], /summary counts 3/],
      "a T2 case scored 0/0 (never sampled)" =>
        [["echo \"$SUBJECT\"", "echo '#{row_t2}'", "echo 'FAIL AE-02-bad-config 0/0 [next-action] invalid'",
          "echo 'admiral-eval: 1/2 cases pass (runs/T2 case = 3)'", "exit 1"], /0\/0/],
      "model invocations failed (auth)" =>
        [["echo \"$SUBJECT\"", "echo '  ! admiral invocation failed (exit 1): not logged in' >&2",
          "echo 'FAIL AE-01-confirm-before-done 0/3 [next-action] no output'", "echo '#{row_t1}'",
          "echo 'admiral-eval: 1/2 cases pass (runs/T2 case = 3)'", "exit 1"], /invocation/],
      # DND-513: a row with NO [mode] tag matches neither the T1 (hook-stdin)
      # nor the T2 (model-in-loop) shape. It must be surfaced, never silently
      # folded into either bucket or dropped from the row count.
      "a row with no [mode] tag (matches neither T1 nor T2 shape)" =>
        [["echo \"$SUBJECT\"", "echo 'PASS AE-99-no-mode 1/1 ok'",
          "echo 'admiral-eval: 1/1 cases pass (runs/T2 case = 3)'", "exit 0"], /no \[mode\]/]
    }
    stubs.each_with_index do |(label, (body, want)), i|
      wt = File.join(d, "wt#{i}")
      FileUtils.mkdir_p(File.join(wt, "ai", "agents"))
      FileUtils.mkdir_p(File.join(wt, "ai", "bin"))
      File.write(File.join(wt, ADMIRAL_AGENT_REL), front + "prose #{i}\n")
      subj = t2_subject(wt)
      line = "subject: ai/agents/athena-admiral.md #{subj['lines']} lines sha #{subj['sha256'][0, 12]} " \
             "(loaded inline via --agents as athena-admiral-eval-subject)"
      stub = File.join(wt, "ai", "bin", "admiral-eval")
      File.write(stub, "#!/bin/sh\nSUBJECT='#{line}'\n#{body.join("\n")}\n")
      File.chmod(0o755, stub)
      begin
        got = collect_t2_counts(wt, 3, subj, "variant")
        fail.("#{label}: an unmeasured T2 run must raise, never read as T2 fractions (got #{got.inspect})")
      rescue StandardError => e
        if !defined?(Unmeasured) || !e.is_a?(Unmeasured)
          fail.("#{label}: must raise Unmeasured (got #{e.class}: #{e.message[0, 160]})")
        else
          fail.("#{label}: the refusal must name the side") unless e.message.include?("variant")
          fail.("#{label}: the refusal must say why (#{want.inspect}): #{e.message[0, 200]}") \
            unless e.message.match?(want)
          fail.("#{label}: the refusal must carry a Fix:") unless e.message.include?("Fix:")
        end
      end
    end

    # A completed run (exit 1 is admiral-eval's own regression verdict, with
    # its closing summary and no failed invocations) IS a measurement.
    wt = File.join(d, "measured")
    FileUtils.mkdir_p(File.join(wt, "ai", "agents"))
    FileUtils.mkdir_p(File.join(wt, "ai", "bin"))
    File.write(File.join(wt, ADMIRAL_AGENT_REL), front + "measured\n")
    subj = t2_subject(wt)
    line = "subject: ai/agents/athena-admiral.md #{subj['lines']} lines sha #{subj['sha256'][0, 12]} " \
           "(loaded inline via --agents as athena-admiral-eval-subject)"
    stub = File.join(wt, "ai", "bin", "admiral-eval")
    File.write(stub, "#!/bin/sh\necho '#{line}'\necho '#{row_t2}'\necho '#{row_t1}'\necho '#{summary2}'\nexit 1\n")
    File.chmod(0o755, stub)
    begin
      got = collect_t2_counts(wt, 3, subj, "baseline")
      fail.("a completed run must yield its T2 counts (got #{got.inspect})") \
        unless got["AE-01-confirm-before-done"] == EvalScore::Counts.new(3, 3)
      # DND-513: a T1 [hook-stdin] row (already scored by the `ae:` deterministic
      # set) must never ALSO land in the T2 counts hash — that double-counts a T1
      # flip as a T2 regression/improvement.
      fail.("a T1 [hook-stdin] row must not be counted as a T2 case (got #{got.inspect})") \
        if got.key?("AE-13a-forge-auth-deny")
      # DND-527 J5: nor may it reach the JSON proposal's t2 rows.
      t2_json = proposal_json({
        variant: "cand", baseline: "origin/main", corpus: "full", runs: 3, gate_ok: true,
        verdict: :inconclusive, deterministic: { regressed: [], fixed: [], new: [] },
        t2: t2_rows(got, got)[:rows], regressions: [], improvements: []
      })["t2"]
      t2_names = Array(t2_json).map { |r| r["name"] }
      fail.("J5: the JSON t2 rows must carry the T2 case (got #{t2_names.inspect})") \
        unless t2_names.include?("AE-01-confirm-before-done")
      fail.("J5: a T1 [hook-stdin] row must never reach the JSON t2 rows (got #{t2_names.inspect})") \
        if t2_names.include?("AE-13a-forge-auth-deny")
    rescue StandardError => e
      fail.("a completed admiral-eval run (exit 1 = its regression verdict) must be a measurement, not " \
            "raise #{e.class}: #{e.message[0, 200]}")
    end
  end

  # (i) DND-504: an unmeasured side is its own verdict. It outranks KEEP and
  # REVERT (a measurement that did not happen cannot license either), renders
  # "could not measure" distinct from "found nothing", and carries a Fix:.
  begin
    vu = verdict(gate_ok: true, regressions: ["c1"], improvements: ["c2"], unmeasured: "variant T2")
    fail.("an unmeasured side must verdict UNMEASURED, never KEEP/REVERT (got #{vu})") unless vu == :unmeasured
    fail.("a red gate still short-circuits BLOCKED ahead of UNMEASURED") \
      unless verdict(gate_ok: false, regressions: [], improvements: [], unmeasured: "x") == :blocked
    fail.("a measured run must not be UNMEASURED") \
      if verdict(gate_ok: true, regressions: [], improvements: ["c2"], unmeasured: nil) == :unmeasured
  rescue ArgumentError => e
    fail.("verdict must accept unmeasured: (#{e.message})")
  end
  un_res = {
    variant: "cand", baseline: "origin/main", corpus: "full", runs: 10, gate_ok: true, verdict: :unmeasured,
    deterministic: { regressed: [], fixed: ["c1"], new: [] }, regressions: [], improvements: ["c1"],
    unmeasured: { side: "variant", part: "T2", reason: "admiral-eval exited 2. Fix: run it" }
  }
  json_fixtures[:unmeasured_t2] = un_res
  un_out = render_proposal(un_res)
  fail.("an UNMEASURED proposal must say UNMEASURED") unless un_out.include?("VERDICT: UNMEASURED")
  fail.("an UNMEASURED proposal must name the side") unless un_out.include?("variant")
  fail.("an UNMEASURED proposal must carry a Fix:") unless un_out.include?("Fix:")
  fail.("an UNMEASURED proposal must not read as 'no T2 cases evaluated'") \
    if un_out.include?("no T2 cases evaluated")
  fail.("an UNMEASURED proposal must not carry KEEP") if un_out.include?("KEEP")
  begin
    det_un_res = {
      variant: "cand", baseline: "origin/main", corpus: "full", runs: 10, gate_ok: true, verdict: :unmeasured,
      unmeasured: { side: "baseline", part: "deterministic", reason: "harness-eval exited 2. Fix: run it" }
    }
    json_fixtures[:unmeasured_deterministic] = det_un_res
    det_un_out = render_proposal(det_un_res)
  fail.("an unmeasured deterministic side must render NOT MEASURED, never 'regressed: none'") \
    if det_un_out.include?("none") || !det_un_out.include?("NOT MEASURED")
  fail.("an UNMEASURED verdict must exit non-zero") if verdict_exit_code(:unmeasured).zero?
  rescue NoMethodError => e
    fail.("the verdict->exit mapping must be a function (#{e.message[0, 80]})")
  end

  # (j) DND-504 sweep: the deterministic half drops statuses too. A
  # harness-eval that did not rewrite the scorecard (crash, exit 2) leaves the
  # COMMITTED ai/eval/scorecard.json behind, which would read as this ref's
  # measurement. And a T1 hook that is missing or signaled must never pass an
  # expect=clean case (admiral-eval's :error rule).
  Dir.mktmpdir("variant-eval-det-unmeasured-") do |d|
    stale = JSON.generate("generated" => "2000-01-01T00:00:00Z", "cases" => [{ "name" => "x", "pass" => true }])
    {
      "harness-eval exits 2 leaving a stale scorecard" => ["exit 2", stale],
      "harness-eval exits 0 without rewriting the scorecard" => ["exit 0", stale],
      "harness-eval writes a fresh scorecard, then exits 2" =>
        ["printf '{\"generated\":\"%s\",\"cases\":[{\"name\":\"x\",\"pass\":true}]}' " \
         "\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" > ai/eval/scorecard.json\nexit 2", stale]
    }.each_with_index do |(label, (body, card)), i|
      wt = File.join(d, "wt#{i}")
      FileUtils.mkdir_p(File.join(wt, "ai", "bin"))
      FileUtils.mkdir_p(File.join(wt, "ai", "eval"))
      File.write(File.join(wt, SCORECARD_REL), card)
      File.write(File.join(wt, "ai", "bin", "harness-eval"), "#!/bin/sh\n#{body}\n")
      File.chmod(0o755, File.join(wt, "ai", "bin", "harness-eval"))
      begin
        got = collect_deterministic(wt, "baseline")
        fail.("#{label}: must raise, never read a stale scorecard as a measurement (got #{got.inspect})")
      rescue StandardError => e
        if !defined?(Unmeasured) || !e.is_a?(Unmeasured)
          fail.("#{label}: must raise Unmeasured (got #{e.class}: #{e.message[0, 160]})")
        else
          fail.("#{label}: the refusal must name the side and carry a Fix:") \
            unless e.message.include?("baseline") && e.message.include?("Fix:")
        end
      end
    end

    # A fresh scorecard plus a T1 fixture whose hook is missing (expect=clean)
    # and one whose hook is signaled: both must score FAIL, never PASS.
    wt = File.join(d, "hooks")
    FileUtils.mkdir_p(File.join(wt, "ai", "bin"))
    FileUtils.mkdir_p(File.join(wt, "ai", "hooks"))
    he = File.join(wt, "ai", "bin", "harness-eval")
    File.write(he, "#!/bin/sh\nmkdir -p ai/eval\nprintf '{\"generated\":\"%s\",\"cases\":[{\"name\":\"h\"," \
                   "\"pass\":true}]}' \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" > ai/eval/scorecard.json\n")
    File.chmod(0o755, he)
    killed = File.join(wt, "ai", "hooks", "killed.sh")
    File.write(killed, "#!/bin/sh\nkill -9 $$\n")
    File.chmod(0o755, killed)
    { "AE-90-missing" => "absent", "AE-91-killed" => "killed" }.each do |name, guard|
      fx = File.join(wt, ADMIRAL_FIXTURES, name)
      FileUtils.mkdir_p(fx)
      File.write(File.join(fx, "meta"), "mode = hook-stdin\nguard = #{guard}\ninput = input.json\nexpect = clean\n")
      File.write(File.join(fx, "input.json"), "{}\n")
    end
    begin
      set = collect_deterministic(wt, "variant")
      fail.("a fresh scorecard must be read (got #{set.inspect})") unless set["he:h"] == true
      fail.("a missing T1 hook must never pass an expect=clean case") unless set["ae:AE-90-missing"] == false
      fail.("a signaled T1 hook must never pass an expect=clean case") unless set["ae:AE-91-killed"] == false
    rescue StandardError => e
      fail.("a fresh scorecard + T1 hooks must be measured, not raise #{e.class}: #{e.message[0, 200]}")
    end
  end

  # -- DND-527: the machine-readable proposal (--json) ---------------------
  json_fixtures[:deterministic_inconclusive] = {
    variant: "cand", baseline: "origin/main", corpus: "deterministic", gate_ok: true, verdict: :inconclusive,
    deterministic: { regressed: [], fixed: [], new: [] }, t2: [], regressions: [], improvements: []
  }
  # What the TEXT proposal claims, read back out of the rendered text: the
  # verdict, the deterministic lines, and each T2 row's flip. J4 compares these
  # with the JSON so the two outputs cannot disagree.
  text_claims = lambda do |text|
    det = {}
    { "regressed" => /^  regressed \(pass->fail\): (.*)$/, "fixed" => /^  fixed \(fail->pass\): +(.*)$/,
      "new" => /^  new cases: +(.*)$/ }.each do |key, re|
      m = text.match(re)
      det[key] = m && (m[1] == "none" ? [] : m[1].split(", "))
    end
    t2 = text.scan(/^  (\S+)\s+base=.* -> (\w+)$/).map { |name, flip| [name, flip.downcase] }
    { verdict: text[/^VERDICT: (\w+)/, 1], det: det, t2: t2,
      regressions: text[/^  regressions: (.*)$/, 1]&.split(", "),
      improvements: text[/^  improvements: (.*)$/, 1]&.split(", ") }
  end
  schema_keys = %w[schema variant variant_sha baseline baseline_sha corpus runs gate_ok gate_detail verdict
                   unmeasured deterministic t2_subjects t2 regressions improvements]
  flips = %w[regressed improved inconclusive new missing n_a]
  seen_verdicts = []
  json_fixtures.each do |label, res|
    j = JSON.parse(JSON.generate(proposal_json(res)))
    text = render_proposal(res)
    claims = text_claims.(text)
    seen_verdicts << j["verdict"]
    # J1: every verdict path emits schema v1 with the verdict res carries.
    fail.("J1 #{label}: keys must be exactly schema v1 #{schema_keys.inspect} (got #{j.keys.inspect})") \
      unless j.keys == schema_keys
    fail.("J1 #{label}: schema must be #{JSON_SCHEMA_ID}") unless j["schema"] == JSON_SCHEMA_ID
    fail.("J1 #{label}: verdict must be #{res[:verdict]} (got #{j['verdict'].inspect})") \
      unless j["verdict"] == res[:verdict].to_s
    fail.("J4 #{label}: text VERDICT #{claims[:verdict].inspect} must equal the JSON verdict #{j['verdict']}") \
      unless claims[:verdict] == VERDICT_LABELS[j["verdict"].to_sym]
    measured = !%w[blocked unmeasured].include?(j["verdict"])
    # J2: not measured is null, measured-and-empty is [] — never confused.
    if measured
      fail.("J2 #{label}: a measured verdict must carry regressions/improvements arrays") \
        unless j["regressions"].is_a?(Array) && j["improvements"].is_a?(Array)
      fail.("J2 #{label}: a measured verdict must carry the deterministic diff") unless j["deterministic"].is_a?(Hash)
      fail.("J2 #{label}: a measured verdict must carry unmeasured: null") unless j["unmeasured"].nil?
    else
      fail.("J2 #{label}: a #{j['verdict']} verdict must carry regressions: null, never [] " \
            "(got #{j['regressions'].inspect})") unless j["regressions"].nil?
      fail.("J2 #{label}: a #{j['verdict']} verdict must carry improvements: null, never [] " \
            "(got #{j['improvements'].inspect})") unless j["improvements"].nil?
    end
    if j["verdict"] == "unmeasured"
      un = j["unmeasured"]
      fail.("J2 #{label}: unmeasured must name side, part and reason (got #{un.inspect})") \
        unless un.is_a?(Hash) && un.keys == %w[side part reason] && un.values.all? { |v| v.is_a?(String) }
      fail.("J2 #{label}: an unmeasured T2 must be t2: null, never [] (got #{j['t2'].inspect})") \
        if un["part"] == "T2" && !j["t2"].nil?
      fail.("J2 #{label}: an unmeasured deterministic side must be deterministic: null") \
        if un["part"] == "deterministic" && !j["deterministic"].nil?
    end
    if j["verdict"] == "blocked"
      fail.("J1 #{label}: BLOCKED must carry gate_ok false and its gate_detail lines") \
        unless j["gate_ok"] == false && j["gate_detail"] == res[:gate_detail]
    else
      fail.("J1 #{label}: gate_detail must be null unless BLOCKED") unless j["gate_detail"].nil?
    end
    # J3: the deterministic corpus claims no T2 at all.
    if j["corpus"] == "deterministic"
      fail.("J3 #{label}: --corpus deterministic must be t2: null (got #{j['t2'].inspect})") unless j["t2"].nil?
      fail.("J3 #{label}: --corpus deterministic must be t2_subjects: null") unless j["t2_subjects"].nil?
      fail.("J3 #{label}: --corpus deterministic must be runs: null") unless j["runs"].nil?
    else
      fail.("J1 #{label}: --corpus full must carry runs") unless j["runs"] == res[:runs]
      fail.("J2 #{label}: a measured full corpus must carry a t2 array") if measured && !j["t2"].is_a?(Array)
    end
    Array(j["t2"]).each do |row|
      fail.("J1 #{label}: a t2 row must be {name, base, var, flip} (got #{row.inspect})") \
        unless row.keys == %w[name base var flip]
      fail.("J1 #{label}: t2 flip #{row['flip'].inspect} is not an EvalScore.classify symbol") \
        unless flips.include?(row["flip"])
      %w[base var].each do |side|
        s = row[side]
        next if s.nil?

        fail.("J1 #{label}: a t2 #{side} must be null or {k, n} integers (got #{s.inspect})") \
          unless s.keys == %w[k n] && s.values.all? { |v| v.is_a?(Integer) }
      end
    end
    if (subj = j["t2_subjects"])
      %w[base var].each do |side|
        fail.("J1 #{label}: t2_subjects.#{side} must be {lines, sha256} (got #{subj[side].inspect})") \
          unless subj[side].is_a?(Hash) && subj[side].keys == %w[lines sha256]
      end
    end
    # J4: text and JSON agree on the verdict, the regressions and the improvements.
    if claims[:det].values.all?
      fail.("J4 #{label}: the JSON deterministic diff must equal the text's (#{claims[:det].inspect} vs " \
            "#{j['deterministic'].inspect})") unless j["deterministic"] == claims[:det]
    elsif !j["deterministic"].nil?
      fail.("J4 #{label}: the text says NOT MEASURED but the JSON carries a deterministic diff")
    end
    fail.("J4 #{label}: the JSON t2 flips must equal the text's T2 rows") \
      unless Array(j["t2"]).map { |r| [r["name"], r["flip"]] } == claims[:t2]
    next unless measured

    text_regs = claims[:det]["regressed"] +
                claims[:t2].select { |_n, f| %w[regressed missing].include?(f) }.map { |n, _f| "t2:#{n}" }
    text_imps = claims[:det]["fixed"] + claims[:t2].select { |_n, f| f == "improved" }.map { |n, _f| "t2:#{n}" }
    fail.("J4 #{label}: regressions differ (text #{text_regs.sort.inspect}, JSON #{j['regressions'].sort.inspect})") \
      unless text_regs.sort == j["regressions"].sort
    fail.("J4 #{label}: improvements differ (text #{text_imps.sort.inspect}, JSON " \
          "#{j['improvements'].sort.inspect})") unless text_imps.sort == j["improvements"].sort
    fail.("J4 #{label}: the text's REVERT regressions line must equal the JSON's") \
      if claims[:regressions] && claims[:regressions].sort != j["regressions"].sort
    fail.("J4 #{label}: the text's KEEP improvements line must equal the JSON's") \
      if claims[:improvements] && claims[:improvements].sort != j["improvements"].sort
  end
  fail.("J1: the JSON fixtures must cover every verdict (#{VERDICT_LABELS.keys.inspect}); covered " \
        "#{seen_verdicts.uniq.sort.inspect}") unless seen_verdicts.uniq.sort == VERDICT_LABELS.keys.map(&:to_s).sort

  # J6: the write is atomic, a failed write leaves nothing at PATH, and emit
  # turns a failed write into a non-zero exit with a Fix:.
  Dir.mktmpdir("variant-eval-json-") do |d|
    good = File.join(d, "proposal.json")
    werr = write_json_atomic(good, proposal_json(keep_res))
    fail.("J6: a write to a writable dir must succeed (got #{werr.inspect})") unless werr.nil?
    fail.("J6: the written file must parse to proposal_json(res)") \
      unless File.file?(good) && JSON.parse(File.read(good)) == JSON.parse(JSON.generate(proposal_json(keep_res)))
    fail.("J6: an atomic write must leave no temp file behind (#{Dir.children(d).inspect})") \
      unless Dir.children(d) == ["proposal.json"]

    # Review round 1: gate_detail and the unmeasured reason are raw tool output
    # and may hold invalid UTF-8. JSON generation must not raise on it (it did:
    # JSON::GeneratorError escaped emit, left a temp file, and exited 1 with a
    # wrong-ref Fix:). proposal_json scrubs every string; write_json_atomic
    # turns any generation error into a returned reason with no temp file.
    bad_bytes = "gate \xFF line".dup.force_encoding("UTF-8")
    bad_res = blocked_res.merge(gate_detail: [bad_bytes])
    begin
      JSON.generate(proposal_json(bad_res))
    rescue StandardError => e
      fail.("J6: invalid UTF-8 in gate_detail must still generate JSON (raised #{e.class})")
    end
    bad_dir = File.join(d, "bad")
    FileUtils.mkdir_p(bad_dir)
    begin
      why = write_json_atomic(File.join(bad_dir, "p.json"), { "x" => bad_bytes })
      fail.("J6: an ungeneratable payload must be a returned failure") if why.nil?
    rescue StandardError => e
      fail.("J6: write_json_atomic must return a reason, not raise #{e.class}")
    end
    fail.("J6: a failed generation must leave nothing in the dir (#{Dir.children(bad_dir).inspect})") \
      unless Dir.children(bad_dir).empty?

    missing = File.join(d, "no-such-dir", "proposal.json")
    fail.("J6: a write into a missing dir must fail") if write_json_atomic(missing, {}).nil?
    fail.("J6: a failed write must leave no file at PATH") if File.exist?(missing)
    if Process.uid != 0
      ro = File.join(d, "ro")
      FileUtils.mkdir_p(ro)
      File.chmod(0o555, ro)
      fail.("J6: a write into an unwritable dir must fail") if write_json_atomic(File.join(ro, "p.json"), {}).nil?
      fail.("J6: a failed write must leave nothing in the dir (#{Dir.children(ro).inspect})") \
        unless Dir.children(ro).empty?
      File.chmod(0o755, ro)
    end

    require "stringio"
    run_emit = lambda do |res, json_path|
      saved = [$stdout, $stderr]
      $stdout = StringIO.new
      $stderr = StringIO.new
      code = emit(res, nil, json_path)
      [code, $stdout.string, $stderr.string]
    ensure
      $stdout, $stderr = saved
    end
    code, _o, err = run_emit.(keep_res, missing)
    fail.("J6: emit must exit non-zero when the JSON write fails (got #{code})") if code.to_i.zero?
    fail.("J6: a failed JSON write must carry a Fix: on stderr (#{err.inspect})") unless err.include?("Fix:")
    fail.("J6: a failed JSON write must name the path") unless err.include?(missing)
    code, = run_emit.(revert_res, File.join(d, "revert.json"))
    fail.("J6: a written REVERT must keep its exit 1 (got #{code})") unless code == 1
    fail.("J6: emit must write the REVERT JSON") \
      unless JSON.parse(File.read(File.join(d, "revert.json")))["verdict"] == "revert"

    # The --json target is checked BEFORE any measurement (a ~50-model-call run
    # must not end in an unwritable path), and a stale file from an earlier run
    # is removed, so a run that dies later leaves NO proposal rather than an old one.
    stale = File.join(d, "stale.json")
    File.write(stale, JSON.generate("schema" => JSON_SCHEMA_ID, "verdict" => "keep"))
    fail.("J6: a writable --json path must be accepted") unless prepare_json_path(stale, nil).nil?
    fail.("J6: a stale --json file must be removed before measuring") if File.exist?(stale)
    # Review round 1: only an earlier PROPOSAL is removed. Any other file at
    # the path (a typo naming a real file) is refused and left untouched.
    precious = File.join(d, "precious.txt")
    File.write(precious, "not a proposal\n")
    fail.("J6: a --json path holding a non-proposal file must be refused") if prepare_json_path(precious, nil).nil?
    fail.("J6: a non-proposal file at --json must never be deleted") unless File.file?(precious)
    # Review round 1: --out and --json must not name one file through a symlink.
    real = File.join(d, "real")
    FileUtils.mkdir_p(real)
    File.symlink(real, File.join(d, "link"))
    { "a missing dir" => [missing, nil], "a directory" => [d, nil],
      "the --out path" => [File.join(d, "same"), File.join(d, "same")],
      "the --out path via a symlinked dir" => [File.join(d, "link", "x"), File.join(real, "x")] }
      .each do |what, (jp, op)|
      why = prepare_json_path(jp, op)
      fail.("J6: a --json path that is #{what} must be refused before measuring") if why.nil?
    end
    # Review round 1: --out is checked before measuring too, and a failed
    # --out write is reported with a Fix: and exit 3, not the wrong-ref rescue.
    fail.("J6: an --out path in a missing dir must be refused before measuring") \
      if output_path_problem("--out", missing).nil?
    code, _o, err = begin
      saved = [$stdout, $stderr]
      $stdout = StringIO.new
      $stderr = StringIO.new
      [emit(keep_res, missing, File.join(d, "with-bad-out.json")), $stdout.string, $stderr.string]
    rescue StandardError => e
      [nil, "", "raised #{e.class}"]
    ensure
      $stdout, $stderr = saved
    end
    fail.("J6: a failed --out write must exit #{OUTPUT_WRITE_FAILED_EXIT} (got #{code.inspect}; #{err[0, 120]})") \
      unless code == OUTPUT_WRITE_FAILED_EXIT
    fail.("J6: a failed --out write must carry a Fix:") unless err.include?("Fix:")
    fail.("J6: a failed --out write must not stop the JSON write") unless File.file?(File.join(d, "with-bad-out.json"))
    runner_src = File.read(__FILE__)[/^def run_measurement.*?^end$/m].to_s
    prep_at = runner_src.index("prepare_json_path(")
    measure_at = runner_src.index("measure(")
    fail.("J6: run_measurement must check the --json path before measure(...)") \
      unless prep_at && measure_at && prep_at < measure_at
  end

  # J8: --help documents --json (the CLI_SPEC loop below also requires it).
  fail.("J8: --help must document --json") unless help_text.include?("--json")

  # -- STRUCTURAL CONTAINMENT: command_allowed? rejects every mutation family --
  fail.("worktree add must be allowed") unless command_allowed?(%w[git worktree add --detach /tmp/x origin/main])
  fail.("worktree remove must be allowed") unless command_allowed?(%w[git worktree remove --force /tmp/x])
  fail.("git rev-parse must be allowed") unless command_allowed?(%w[git rev-parse --git-common-dir])
  fail.("harness-eval must be allowed") unless command_allowed?(%w[ai/bin/harness-eval])
  fail.("admiral-eval --run must be allowed") unless command_allowed?(%w[ai/bin/admiral-eval --run --runs 3])
  fail.("git merge must be DENIED") if command_allowed?(%w[git merge origin/main])
  fail.("git commit must be DENIED") if command_allowed?(%w[git commit -m x])
  fail.("git push must be DENIED") if command_allowed?(%w[git push origin main])
  fail.("git -C … push must be DENIED (option skipping)") if command_allowed?(%w[git -C /repo push origin main])
  fail.("git rebase must be DENIED") if command_allowed?(%w[git rebase origin/main])
  fail.("git reset must be DENIED") if command_allowed?(%w[git reset --hard origin/main])
  fail.("git checkout must be DENIED") if command_allowed?(%w[git checkout main])
  fail.("gh pr merge must be DENIED") if command_allowed?(%w[gh pr merge 1])
  fail.("glab mr merge must be DENIED") if command_allowed?(%w[glab mr merge 1])
  fail.("gh-athena merge must be DENIED") if command_allowed?(%w[gh-athena pr merge 1])
  fail.("--update-baseline must be DENIED anywhere in argv") if command_allowed?(%w[ai/bin/admiral-eval --run --update-baseline])

  # capture() must REFUSE a forbidden argv rather than run it.
  begin
    capture(%w[git push origin main])
    fail.("capture must raise MutationAttempt on a forbidden command")
  rescue MutationAttempt
    # expected
  rescue StandardError => e
    fail.("capture raised the wrong error class: #{e.class}")
  end

  # -- DND-505: the CLI refuses an argument it does not recognise ----------
  # Black-box through the real CLI, via the guarded capture. No argv here names
  # --variant, so even a parser that ignores unknown flags stops at "no
  # --variant" (exit 2) and this block can never start a measurement.
  [
    [%w[--corpus-full], "--corpus-full"], # a flag this tool never had
    [%w[--baseline], "--baseline"],       # value flag with no value
    [%w[--rnus 5], "--rnus"],             # typo'd flag
    [%w[--json], "--json"]                # J7 (DND-527): --json with no value
  ].each do |args, named|
    _out, err, st = capture([RbConfig.ruby, File.expand_path(__FILE__), *args])
    fail.("`variant-eval #{args.join(' ')}` must exit 2 (usage), got #{st.exitstatus}") unless st.exitstatus == 2
    fail.("`variant-eval #{args.join(' ')}` must name #{named} on stderr: #{err.inspect}") unless err.include?(named)
    fail.("`variant-eval #{args.join(' ')}` must carry a Fix: line") unless err.include?("Fix:")
  end
  out, _err, st = capture([RbConfig.ruby, File.expand_path(__FILE__), "--help", "--bogus"])
  fail.("--help must still win over any other argument (stdout Usage, exit 0)") \
    unless st.exitstatus.zero? && out.include?("Usage:")

  # DND-506: --help must match the parser and the verdict set, not a
  # hand-written description of them — checked against the real values
  # (CLI_SPEC, DEFAULT_BASELINE, DEFAULT_RUNS, VERDICT_LABELS) so a future
  # change to any of those, without a matching --help update, fails here
  # instead of silently desyncing.
  htxt = help_text
  fail.("--help and the spawned `--help --bogus` output must be the same text") unless out == htxt
  CLI_SPEC.each_key do |flag|
    fail.("--help must document #{flag} (CLI_SPEC)") unless htxt.include?(flag)
  end
  fail.("--help must state the real --baseline default (#{DEFAULT_BASELINE})") \
    unless htxt.include?(DEFAULT_BASELINE)
  fail.("--help must state the real --runs default (#{DEFAULT_RUNS})") unless htxt.include?(DEFAULT_RUNS.to_s)
  fail.("--help must state the --runs range (1-99)") unless htxt.include?("1-99")
  fail.("--help must document --corpus's accepted values (deterministic|full), not a path") \
    unless htxt.include?("deterministic") && htxt.include?("full") && !htxt.include?("eval corpus directory")
  VERDICT_LABELS.each_value do |label|
    fail.("--help must list the #{label} verdict (VERDICT_LABELS)") unless htxt.include?(label)
  end
  fail.("--help must state the DND-505 exit-2-on-bad-argument rule") \
    unless htxt.include?("exits 2") && htxt.include?("refused")
  # Tie VERDICT_LABELS to the symbols `verdict` actually produced above (va =
  # REVERT, vb = KEEP, vc = INCONCLUSIVE, ve = BLOCKED, vu = UNMEASURED): a
  # verdict branch exercised here that VERDICT_LABELS doesn't name would leave
  # --help silently short one entry.
  exercised = [va, vb, vc, ve, vu].uniq.sort
  fail.("VERDICT_LABELS #{VERDICT_LABELS.keys.sort.inspect} must match the verdicts self-test's own verdict(...) " \
        "calls produced #{exercised.inspect}") unless exercised == VERDICT_LABELS.keys.sort

  # In-process: the parser behind main, including the cases that carry
  # --variant (unsafe to run black-box on a parser that ignores flags).
  _o, reason = parse_cli(%w[--variant v --corpus-full])
  fail.("--variant v --corpus-full must be a usage error naming --corpus-full") \
    unless reason.to_s.include?("--corpus-full")
  _o, reason = parse_cli(%w[--variant v --baseline])
  fail.("a valueless --baseline must be a usage error, never the default baseline") \
    unless reason.to_s.include?("--baseline")
  _o, reason = parse_cli(%w[--variant])
  fail.("a valueless --variant must be a usage error naming --variant") unless reason.to_s.include?("--variant")
  _o, reason = parse_cli(%w[--variant v --runs lots])
  fail.("a non-integer --runs must be a usage error") unless reason.to_s.include?("integer")
  _o, reason = parse_cli(%w[--self-test --variant v])
  fail.("a measurement option with --self-test must be a usage error") unless reason.to_s.include?("--variant")
  fwd = %w[--variant v --baseline b --corpus full --runs 5 --out o.md]
  rev = %w[--out o.md --runs 5 --corpus full --baseline b --variant v]
  o1, r1 = parse_cli(fwd)
  o2, r2 = parse_cli(rev)
  fail.("well-formed options must parse (got #{r1.inspect} / #{r2.inspect})") unless r1.nil? && r2.nil?
  fail.("flag order must not matter: #{o1.inspect} vs #{o2.inspect}") unless o1 == o2
  fail.("--runs must parse as an Integer") unless o1 && o1["--runs"] == 5
  _o, reason = parse_cli(%w[--self-test])
  fail.("--self-test alone must parse, got #{reason.inspect}") unless reason.nil?

  # -- SOURCE containment: all execution is funneled through the ONE guarded
  # exec call site. This is the "grep its own source for a mutation path"
  # assertion (mirrors admiral-eval's containment self-test). A naive substring
  # grep false-matches its own comments/Fix: prose, so we LEX with Ripper and
  # inspect only real code tokens: comment text is :on_comment and string bodies
  # are :on_tstring_content, so a mention in prose is excluded automatically. A
  # genuine backtick/%x command literal is an :on_backtick token; a genuine call
  # to system/spawn/exec/popen is an :on_ident.
  require "ripper"
  toks = Ripper.lex(File.read(__FILE__))
  code_idents = toks.select { |t| t[1] == :on_ident }.map { |t| t[2] }
  backtick_toks = toks.select { |t| t[1] == :on_backtick }

  fail.("source must contain no backtick/%x command literal (route through the guarded exec primitive)") \
    unless backtick_toks.empty?
  %w[system spawn exec popen].each do |prim|
    n = code_idents.count(prim)
    fail.("source must not call #{prim} as code (found #{n}) — route through the guarded exec primitive") \
      unless n.zero?
  end
  # The one permitted exec primitive is Open3.capture3, called exactly once
  # (inside the guarded wrapper). `capture3` is an :on_ident only at a real call.
  exec_calls = code_idents.count("capture3")
  fail.("source must invoke the exec library exactly once (the guarded site), found #{exec_calls}") \
    unless exec_calls == 1

  # DND-505: every first-party lib this process has loaded runs in-process, so
  # it is held to the same rule: no exec primitive of any kind (the one guarded
  # call site stays in this file). The set is read from $LOADED_FEATURES, the
  # files actually loaded, so any require form is covered (require_relative,
  # `require File.join(AI_DIR, "lib", ...)`). A lexer over require call sites
  # would miss whichever form it did not parse.
  lib_dir = File.join(AI_DIR, "lib") + File::SEPARATOR
  libs = $LOADED_FEATURES.select { |f| f.start_with?(lib_dir) }
  libs.each do |lib|
    ltoks = Ripper.lex(File.read(lib))
    lids = ltoks.select { |t| t[1] == :on_ident }.map { |t| t[2] }
    fail.("#{lib} must contain no backtick/%x command literal") if ltoks.any? { |t| t[1] == :on_backtick }
    %w[system spawn exec popen capture3 capture2 capture2e popen3].each do |prim|
      fail.("#{lib} must not call #{prim} (variant-eval's one exec site is its guarded capture)") \
        if lids.include?(prim)
    end
  end
  # The loaded set must be non-empty and name the libs this file requires: an
  # empty or wrongly-rooted set would make the loop above check nothing.
  %w[strict_argv.rb eval_score.rb].each do |want|
    fail.("containment must lex #{lib_dir}#{want}, but it is not in the loaded set #{libs.inspect}") \
      unless libs.include?(File.join(AI_DIR, "lib", want))
  end

  if ok
    puts "variant-eval: self-test OK"
    0
  else
    warn "variant-eval: self-test FAILED"
    warn "  Fix: the diff/classify/verdict/render logic or the structural containment is broken. A " \
         "deterministic pass->fail must verdict REVERT; a within-envelope flip must be INCONCLUSIVE (never " \
         "regressed/improved); a red gate must verdict BLOCKED before scoring; a side that ran but did not " \
         "measure (admiral-eval failed / 0 T2 cases / failed model calls, or a stale scorecard) must verdict " \
         "UNMEASURED, never KEEP/REVERT; no KEEP proposal may contain a " \
         "mutation command; command_allowed? must deny every merge/commit/push/forge/--update-baseline argv; " \
         "all execution must go through the single guarded `capture`; and each side's T2 run must pass " \
         "admiral-eval --agent-file <its worktree>/#{ADMIRAL_AGENT_REL}. An unknown flag or a value flag with no " \
         "value must exit 2 naming it, and every loaded ai/lib file must hold no exec primitive (DND-505)."
    1
  end
end

# ---------------------------------------------------------------------------
# DND-505: every argument must be one this tool declares. The old ad-hoc
# `ARGV.index` lookup ignored anything else, so `--corpus-full` measured the
# deterministic corpus and a valueless `--baseline` compared against the default.
CLI_SPEC = {
  "--self-test" => :switch,
  "--variant" => :value,
  "--baseline" => :value,
  "--corpus" => :value,
  "--runs" => :integer,
  "--out" => :value,
  "--json" => :value
}.freeze

# DND-506: built from CLI_SPEC/DEFAULT_BASELINE/DEFAULT_RUNS/VERDICT_LABELS —
# the same values the parser and verdict logic actually use — rather than a
# free-hand description that can silently stop matching them. The self-test
# asserts this text against those same constants.
def help_text
  <<~TXT
    Usage:
      ai/bin/variant-eval --variant REF [OPTIONS]   score a candidate harness ref
                                                    against a baseline over the eval
                                                    corpus; emits one of
                                                    #{VERDICT_LABELS.values.join(' / ')}
      ai/bin/variant-eval --self-test               deterministic suite (no model)
      ai/bin/variant-eval --help                    this text

    Options:
      --variant REF                 candidate harness ref to score (required)
      --baseline REF                ref to compare against (default: #{DEFAULT_BASELINE})
      --corpus deterministic|full   which eval corpus to run (default: deterministic;
                                     full adds model-in-loop T2 characterization,
                                     which stays OUT of harness-gate)
      --runs N                      samples per case, 1-99 (default: #{DEFAULT_RUNS})
      --out PATH                    write the scorecard here
      --json PATH                   also write the proposal as JSON (schema
                                     #{JSON_SCHEMA_ID}), atomically; a stale
                                     file at PATH is removed before measuring,
                                     and a failed write exits #{OUTPUT_WRITE_FAILED_EXIT}

    An unrecognised argument, a flag given twice, or a value flag with no value
    (or `--flag=value`) exits 2 and names the offending flag on stderr — it is
    refused, never ignored (DND-505).

    PROPOSAL-ONLY and human-gated by design: this tool has no merge/commit/push/
    adopt path, and a KEEP verdict is never license to adopt a variant
    automatically. Never wrap it in an auto-adopt loop.
  TXT
end

# -> [opts, nil] on a well-formed argv, else [nil, reason naming the argument].
def parse_cli(argv)
  opts = StrictArgv.parse(argv, CLI_SPEC)
  if opts["--self-test"]
    other = opts.keys.find { |f| f != "--self-test" }
    return [nil, "#{other} does not apply to --self-test"] if other
  end
  [opts, nil]
rescue StrictArgv::UsageError => e
  [nil, e.message]
end

# Dispatch for everything but --help (answered first, below). A malformed argv
# never reaches self_test or measure.
def main(argv)
  opts, reason = parse_cli(argv)
  if reason
    warn "variant-eval: usage error — #{reason}."
    warn "  Fix: re-run with only the flags `ai/bin/variant-eval --help` lists, each value flag followed by " \
         "its value. An unrecognised argument is refused, not ignored: ignoring it would measure a " \
         "different corpus or baseline than the one you asked for."
    return 2
  end
  opts["--self-test"] ? self_test : run_measurement(opts)
end

def run_measurement(opts)
  variant = opts["--variant"]
  unless variant
    warn "variant-eval: FAILED — no --variant <ref> given."
    warn "  Fix: pass the candidate ref, e.g. `ai/bin/variant-eval --variant my-branch`."
    return 2
  end

  corpus = opts.fetch("--corpus", "deterministic")
  unless %w[deterministic full].include?(corpus)
    warn "variant-eval: FAILED — invalid --corpus #{corpus.inspect}."
    warn "  Fix: use --corpus deterministic (default) or --corpus full (adds model-in-loop T2)."
    return 2
  end

  json_file = opts["--json"]
  why = opts["--out"] && output_path_problem("--out", opts["--out"])
  why ||= json_file && prepare_json_path(json_file, opts["--out"])
  if why
    warn "variant-eval: FAILED — #{why}."
    warn "  Fix: pass --out/--json file paths in an existing, writable directory; --json must be a new file or " \
         "an earlier variant-eval proposal, and not the --out file. Both are checked before measuring so a " \
         "long run cannot end with nowhere to write."
    return 2
  end

  measure(
    variant: variant,
    baseline: opts.fetch("--baseline", DEFAULT_BASELINE),
    corpus: corpus,
    runs: opts.fetch("--runs", DEFAULT_RUNS).clamp(1, 99),
    out_file: opts["--out"],
    json_file: json_file
  )
rescue MutationAttempt => e
  warn "variant-eval: FAILED — #{e.message}"
  1
rescue StandardError => e
  warn "variant-eval: FAILED — #{e.message}"
  warn "  Fix: check that --variant and --baseline are valid git refs and that `git worktree add` can " \
       "create scratch trees for them."
  1
end

if ARGV.include?("--help") || ARGV.include?("-h")
  puts help_text
  exit 0
end
exit main(ARGV)
