#!/usr/bin/ruby
# frozen_string_literal: true

# lead-time — derive a fleet ticket's LEAD TIME from durable artifacts only.
#
# Lead time = interval from when a captain STARTS working a ticket to when that
# ticket is FULLY DEPLOYED (or, for a ticket that does not deploy, when its
# post-merge pipeline completes; or, for a repo with no CI at all, the landing:
# the forge merge, or the push that put a CLOSED PR's change on the base).
#
# The END is recovered on demand from git + the forge's CI, which retain
# history independently of any agent. The START is the one captured value: the
# ticket's first move to In Progress, stamped in Notion at dispatch (DND-1318).
# See ai/docs/lead-time-tracking.md for the design and the rejected markers.
#
# CROSS-FORGE: the repo's `origin` remote selects the backend —
#   github.com -> gh   (gen_saas, custom)
#   gitlab.com -> glab (walt_ui)
# Nothing about a specific repo is hardcoded; deploy detection is per-ticket.
#
# Markers:
#   START = captain dispatch: the ticket's first move to In Progress (owner
#           decision, Cody, 2026-09-30), read from the date that
#           scripts/mark-in-progress stamps: DND Tickets' "In Progress at" for
#           a DND ticket, or for a work ticket the work tracker's property
#           named in the private overlay (DND-1341; ai/lib/dispatch_trackers.rb).
#           The ticket is named by the PR's branch, else its title. No stamp,
#           no ticket, a ticket in neither tracker, or no overlay on this
#           machine -> "could not measure" with the reason; never a fallback
#           to a commit date (reported apart, as first_commit).
#   END   = 3-tier, matching Cody's definition exactly:
#           (1) DEPLOY completed  -> the deploy step's completion time
#                 github: completion of the deploy workflow run for the merge sha
#                 gitlab: max finished_at over successful `deploy`-stage jobs
#           (2) else POST-MERGE PIPELINE completed -> its completion time
#                 (a ticket that ran CI on main but shipped no deploy job)
#           (3) else LANDING time (no post-merge CI at all, e.g. ~/dev/custom):
#                 the forge merge, or for a GitHub PR CLOSED without a merge,
#                 the push that put its change on the base (DND-1317; see
#                 ai/docs/lead-time-tracking.md -> A CLOSED PR's landing)
#   A request whose landing cannot be decided prints "could not measure" with
#   the reason (via=unmeasured); one closed without landing prints via=closed.
#
# Deliberately gem-free (stdlib only); run with bare `ruby`.
#
# Usage:
#   lead-time --repo DIR --pr N [--json]      # --pr / --mr are synonyms
#   lead-time --repo DIR --since WHEN [--slow MIN] [--json] [--meta FILE]
#   lead-time --self-test                     # pure logic, no network
#
# A window scan lists every LANDING on the base branch (DND-1009): forge
# merges, CLOSED PRs landed by a push, and on GitHub every direct push with no
# PR, read from the branch's activity log, one row per ticket its commit
# subjects name.
#
# Exit: 0 ok, 1 usage/tool error, 2 a requested PR/MR is missing or an
# unreadable --since, 3 SCAN INCOMPLETE.

require "time"
require "json"
require "open3"
require "uri"
require_relative "../lib/next_mission_notion"
require_relative "../lib/dispatch_trackers"
require_relative "../lib/dispatch_trackers_overlay"

# Which workflow/stage counts as "the deploy" (overridable, not hardcoded to a
# repo). GitHub: workflow name matches this regex. GitLab: job stage equals the
# gitlab value.
DEPLOY_NAME_RE   = Regexp.new(ENV.fetch("LEAD_TIME_DEPLOY_RE", "deploy"), Regexp::IGNORECASE)
DEPLOY_GL_STAGE  = ENV.fetch("LEAD_TIME_DEPLOY_STAGE", "deploy")

# ---------------------------------------------------------------------------
# Pure core (self-tested; no network, no git)
# ---------------------------------------------------------------------------

module LeadTime
  module_function

  # The earliest commit (reported as first_commit; never the START). nil if none.
  def pick_start(commit_iso_times)
    times = commit_iso_times.compact.map { |t| Time.iso8601(t) }
    times.min
  end

  # 3-tier END rule (forge-independent). Each argument is an ISO string or nil.
  def pick_end(deploy_at:, pipeline_at:, merged_at:)
    if present?(deploy_at)
      [Time.iso8601(deploy_at), :deploy]
    elsif present?(pipeline_at)
      [Time.iso8601(pipeline_at), :pipeline]
    elsif present?(merged_at)
      [Time.iso8601(merged_at), :merge]
    else
      [nil, :open]
    end
  end

  def present?(v)
    v && !v.to_s.empty?
  end

  # Latest finished_at among the given iso strings, as an ISO string (ignoring
  # blanks). nil if none. Returns a string so it composes with pick_end.
  def latest(iso_times)
    ts = iso_times.compact.reject { |t| t.to_s.empty? }.map { |t| Time.iso8601(t) }
    ts.max&.utc&.iso8601
  end

  # Whole-number, human-scaled duration; the two most-significant non-zero units.
  def duration_human(seconds)
    return "n/a" if seconds.nil?
    return "0s" if seconds <= 0

    s = seconds.to_i
    d = s / 86_400; s -= d * 86_400
    h = s / 3_600;  s -= h * 3_600
    m = s / 60;     s -= m * 60
    parts = []
    parts << "#{d}d" if d.positive?
    parts << "#{h}h" if h.positive?
    parts << "#{m}m" if m.positive?
    parts << "#{s}s" if s.positive?
    parts.first(2).join(" ")
  end

  # Full computation from already-gathered facts. Returns a result Hash.
  #
  # Lead time splits into two phases with DIFFERENT improvement levers, so the
  # result reports both so an improver can target the right one:
  #   code = start -> merge   (development + review; a HARNESS/process lever)
  #   tail = merge -> end      (CI + deploy; a PIPELINE-EFFICIENCY lever, which
  #                             must never be sped up by weakening a check)
  #
  # closed: the request was closed and its change is NOT on the base branch —
  #   it never landed, so it has no end (distinct from :open).
  # unmeasured: a reason string when the landing could not be decided; the row
  #   then has no end and says why, rather than reading as open or closed.
  #
  # start_at: the measured START, the ticket's move to In Progress (DND-1318),
  #   named by start_source; nil with start_unmeasured saying why. It is never
  #   replaced by a commit date: first_commit_times only fill `first_commit`,
  #   reported beside it for reference.
  def compute(start_at:, deploy_at:, pipeline_at:, merged_at:, start_source: nil, start_unmeasured: nil,
              first_commit_times: [], closed: false, unmeasured: nil)
    start = present?(start_at) ? Time.iso8601(start_at) : nil
    finish, end_kind = pick_end(deploy_at: deploy_at, pipeline_at: pipeline_at,
                                merged_at: merged_at)
    if unmeasured
      finish, end_kind = [nil, :unmeasured]
    elsif closed && finish.nil?
      end_kind = :closed
    end
    # A landed request with no start has no lead; say why rather than print a
    # bare n/a.
    unmeasured ||= "start: #{start_unmeasured || 'no start was given'}" if start.nil? && finish
    merged = present?(merged_at) ? Time.iso8601(merged_at) : nil
    # A start after the landing is not a lead: a stamp made after the work
    # landed (a later re-dispatch, a mistaken backfill) would read negative,
    # and --slow would drop it as fast.
    if start && merged && start > merged
      unmeasured ||= "start: #{start_source || 'the start'} (#{start.utc.iso8601}) is after the landing " \
                     "(#{merged.utc.iso8601})"
      start = nil
    end
    secs      = (start && finish) ? (finish - start).to_i : nil
    code_secs = (start && merged) ? (merged - start).to_i : nil
    tail_secs = (merged && finish) ? [(finish - merged).to_i, 0].max : nil
    {
      start: start&.utc&.iso8601,
      start_source: start ? start_source : nil,
      first_commit: pick_start(first_commit_times)&.utc&.iso8601,
      merged: merged&.utc&.iso8601,
      end: finish&.utc&.iso8601,
      end_kind: end_kind,
      lead_seconds: secs,
      lead_human: duration_human(secs),
      code_seconds: code_secs,
      code_human: duration_human(code_secs),
      tail_seconds: tail_secs,
      tail_human: duration_human(tail_secs),
      unmeasured_reason: unmeasured,
    }
  end

  # Did a closed-but-unmerged request's change land on the base branch?
  # (DND-1317: ~/dev/custom lands by a fast-forward push of the gated,
  # rebased head, so GitHub shows the PR CLOSED, never MERGED.)
  #
  #   pr_only:      [{pid:, subject:}] the request's non-merge commits that are
  #                 not on the base tip
  #   combined_pid: patch-id of the request's whole diff from its merge-base
  #                 (nil when that diff is empty)
  #   main:         [{sha:, pid:, subject:}] the base's non-merge commits that
  #                 are not in the request, newest first
  #
  # -> {status: :landed, sha:}  every commit's patch is on main (a rebase), or
  #                             the whole diff is one main commit (a squash);
  #                             sha is the newest main commit that carries it
  #    {status: :unknown, reason:}  some but not all commits' patches are on
  #                             main, or a main commit shares a subject with
  #                             one of the request's commits but not its patch
  #                             (a conflict-resolved or edited landing)
  #    {status: :not_landed}    nothing of it is on main
  def classify_landing(pr_only:, combined_pid:, main:)
    by_pid = {}
    main.each { |m| by_pid[m[:pid]] ||= m[:sha] if m[:pid] }
    order = main.each_with_index.to_h { |m, i| [m[:sha], i] }
    found = pr_only.map { |c| by_pid[c[:pid]] }
    if !pr_only.empty? && found.none?(&:nil?)
      return { status: :landed, sha: found.min_by { |s| order[s] } }
    end
    return { status: :landed, sha: by_pid[combined_pid] } if combined_pid && by_pid[combined_pid]
    # No commit of its own and no diff to match: nothing here can say whether
    # it landed, so it is not "closed".
    if pr_only.empty?
      return { status: :unknown, reason: "it has no commit of its own off the base branch to match" }
    end

    hits = found.compact.size
    if hits.positive?
      return { status: :unknown,
               reason: "#{hits} of #{pr_only.size} of its commits are on the base branch by patch-id" }
    end
    subjects = main.map { |m| m[:subject] }
    clash = pr_only.map { |c| c[:subject] }.find { |s| subjects.include?(s) }
    if clash
      return { status: :unknown,
               reason: "a commit titled '#{clash}' is on the base branch with a different patch" }
    end

    { status: :not_landed }
  end

  # The push that put `sha` on the base branch. pushes: [{at:, after:}] oldest
  # first; contains: ->(sha, after) -> true | false | nil (nil = could not
  # read that push's commit). -> [iso, nil] or [nil, reason]. A push that could
  # not be read BEFORE the one found makes the time unprovable, so it is a
  # reason, not a silent later answer.
  def landing_push(sha, pushes, contains)
    unread = nil
    pushes.each do |p|
      case contains.call(sha, p[:after])
      when true
        return [nil, "the push at #{unread} could not be read, so the landing time is unprovable"] if unread

        return [p[:at], nil]
      when nil then unread ||= p[:at]
      end
    end
    [nil, "no push in the base branch's activity log carried #{sha[0, 12]}"]
  end

  # A ticket reference: 2-10 letters, a hyphen, a number (DND-1318, dnd-1318).
  TICKET_REF_RE = /(?<![A-Za-z0-9])([A-Za-z]{2,10})-(\d{1,7})(?![0-9])/.freeze

  # Which ticket a request works: the ticket its branch names, else the one
  # its title names, counting only `prefixes` (the trackers that record a
  # start: DND, and the work tracker's prefix when the overlay gives it,
  # DND-1341). -> ["DND-1318", nil] or [nil, reason]. Ordinary words shaped
  # like a ticket (resync-404, utf-8, ruby-34) are not one. Two different
  # tickets in one place are not a guess. With no such ticket anywhere, the
  # reason names any other ref it saw, and it is never a silent fallback to
  # some other start.
  def ticket_ref(branch:, title:, prefixes: ["DND"])
    names = prefixes.join(" or ")
    places = [["branch", branch], ["title", title]]
    places.each do |where, text|
      refs = refs_in(text).select { |r| prefixes.include?(r.split("-", 2).first) }
      return [refs.first, nil] if refs.size == 1
      return [nil, "its #{where} names several #{names} tickets (#{refs.join(', ')})"] if refs.size > 1
    end
    others = places.flat_map { |_w, t| refs_in(t) }.uniq
    return [nil, "it names no #{names} ticket (only #{others.join(', ')})"] unless others.empty?

    [nil, "neither its branch nor its title names a ticket, so no In Progress time can be read"]
  end

  def refs_in(text)
    text.to_s.scan(TICKET_REF_RE).map { |p, n| "#{p.upcase}-#{n}" }.uniq
  end

  # An In Progress stamp must carry its zone: Notion returns a start with no
  # offset when the date has a time_zone set, and Time.iso8601 would read that
  # as this machine's local time.
  ZONED_RE = /(Z|[+-]\d\d:?\d\d)\z/.freeze

  DATE_ONLY_RE = /\A(\d{4})-(\d{2})-(\d{2})\z/.freeze
  SINCE_FORMS = "YYYY-MM-DD (00:00:00Z that day) or RFC 3339 with a zone (2026-09-30T22:00:00Z)"

  # --since WHEN (DND-1009). -> [utc_iso, nil] or [nil, reason]. A date alone
  # is 00:00:00Z that day. A time must carry its zone: without one, Ruby reads
  # it as this machine's local time. An impossible date is refused rather than
  # rolled over into the next month.
  def parse_since(text)
    s = text.to_s
    if (m = DATE_ONLY_RE.match(s))
      t = Time.utc(m[1].to_i, m[2].to_i, m[3].to_i)
      return [t.iso8601, nil] if t.strftime("%Y-%m-%d") == s
    elsif s.include?("T") && s.match?(ZONED_RE)
      return [Time.iso8601(s).utc.iso8601, nil]
    end
    [nil, "--since #{s.inspect} is not a date or time; it takes #{SINCE_FORMS}"]
  rescue ArgumentError
    [nil, "--since #{s.inspect} is not a date or time; it takes #{SINCE_FORMS}"]
  end

  NO_TICKET = "no ticket in the pushed commits' subjects"

  # The landing rows the base branch's own activity log adds beyond the PR
  # rows (DND-1009): a direct push with no PR, a force push, and a PR merge
  # that no listed PR claims. Pure: the commits are already read.
  #
  #   pushes:   [{at:, type:, before:, after:, commits:}] where type is
  #             "push", "force_push" or "pr_merge", and commits is the push's
  #             first-parent range newest first, [{sha:, subject:, authored:}],
  #             or nil when it could not be read (a push only)
  #   covered:  the shas the PR rows already landed (landed_commit, merge
  #             commit); a push carrying one of them IS that PR's landing
  #   prefixes: the tracker prefixes a ticket ref may carry
  #
  # -> one skeleton per ticket a push names: {at:, landed_commit:, commits:,
  #    ticket:, title:, first_commit_times:, unmeasured:, start_unmeasured:}.
  #    unmeasured says why the landing itself cannot be measured;
  #    start_unmeasured says why it has no start (no ticket named).
  def build_push_rows(pushes:, covered:, prefixes:)
    cov = covered.compact.to_h { |s| [s, true] }
    pushes.sort_by { |p| p[:at] }.flat_map do |p|
      base = { at: p[:at], landed_commit: p[:after], commits: [], ticket: nil, title: nil,
               first_commit_times: [], unmeasured: nil, start_unmeasured: nil }
      case p[:type]
      when "force_push" then [base.merge(unmeasured: "force push to base")]
      when "pr_merge"
        cov[p[:after]] ? [] : [base.merge(unmeasured: "a PR merge (#{p[:after].to_s[0, 12]}) that no listed PR claims")]
      else push_skeletons(p, base, cov, prefixes)
      end
    end
  end

  def push_skeletons(push, base, cov, prefixes)
    commits = push[:commits]
    return [base.merge(unmeasured: "the pushed commits could not be read (see SCAN INCOMPLETE)")] if commits.nil?

    shas = commits.map { |c| c[:sha] }
    return [] if cov[push[:after]] || shas.any? { |s| cov[s] }
    return [base.merge(unmeasured: "the push carried no commit")] if commits.empty?

    base = base.merge(commits: shas)
    oldest_first = commits.reverse
    named = oldest_first.flat_map do |c|
      refs_in(c[:subject]).select { |r| prefixes.include?(r.split("-", 2).first) }.map { |r| [r, c] }
    end
    if named.empty?
      others = oldest_first.flat_map { |c| refs_in(c[:subject]) }.uniq
      why = others.empty? ? NO_TICKET : "#{NO_TICKET} (it names only #{others.join(', ')})"
      return [base.merge(title: commits.first[:subject], start_unmeasured: why,
                         first_commit_times: commits.map { |c| c[:authored] })]
    end

    named.group_by(&:first).map do |ref, pairs|
      base.merge(ticket: ref, title: pairs.first[1][:subject],
                 first_commit_times: pairs.map { |_r, c| c[:authored] })
    end
  end

  # The cursor a caller stores between window scans (DND-1009), computed from
  # every landing row BEFORE --slow, so a window with no slow row still moves
  # it. rows: the window's landing rows (each has closed_at, the time the
  # window is keyed on: a PR's close, a push's time). kept: how many rows the
  # caller printed. failures: ProbeFailures.list ({at:} is the landing a
  # failure belongs to, nil when it belongs to none).
  #
  # scanned_through on a complete scan is the newest landing; on an incomplete
  # one it is the newest landing strictly before the first failed one, and nil
  # when any failure belongs to no landing (the whole window is in doubt). An
  # empty window has none: nothing was scanned through.
  def scan_meta(rows:, kept:, failures:)
    keys = rows.map { |r| r[:closed_at] }.compact
    landings = rows.map { |r| r[:pr] ? "pr:#{r[:pr]}" : "#{r[:closed_at]}:#{r[:landed_commit]}" }.uniq.size
    through = if failures.empty?
                keys.max_by { |k| Time.iso8601(k) }
              elsif failures.none? { |f| f[:at].nil? }
                first = failures.map { |f| Time.iso8601(f[:at]) }.min
                keys.select { |k| Time.iso8601(k) < first }.max_by { |k| Time.iso8601(k) }
              end
    { scanned_through: through && Time.iso8601(through).utc.iso8601, landings: landings, kept: kept,
      incomplete: !failures.empty? }
  end
end

# ---------------------------------------------------------------------------
# Impure shell — forge backends (not exercised by --self-test)
# ---------------------------------------------------------------------------

# Every forge probe that fails is RECORDED, not just warned about. A probe that
# could not run and a repo with genuinely nothing to report both yield an empty
# row set, and `[]` on stdout with exit 0 makes them indistinguishable to the
# caller — the `ai/CLAUDE.md` class *A failed lookup must never look like an
# empty one*, and its corollary *a bar that cannot be MEASURED is a failure, not
# a pass with a note*. Measured 2026-09-21: an hourly shipwright cron with no
# `gh` token got HTTP 401 on every repo and wrote "0 outliers across all three
# repos" into its durable journal, a dozen runs deep, having measured nothing.
module ProbeFailures
  class << self
    def list
      @list ||= []
    end

    def reset!
      @list = []
    end

    # at: the landing (its window time) the failed probe belongs to, when one
    # is known; nil means the failure puts the whole window in doubt.
    def record(cmd, detail, at: nil)
      list << { cmd: cmd, detail: detail.to_s.strip, at: at }
      nil
    end

    # A mark to pass to tag_from: failures recorded after it can be tied to
    # one landing once its time is known.
    def mark
      list.size
    end

    # Ties every failure since `mark` that names no landing to the landing at
    # `at`. A nil `at` leaves them window-wide.
    def tag_from(mark, at)
      return unless at

      list[mark..].each { |f| f[:at] ||= at }
    end

    def any?
      !list.empty?
    end
  end
end

def run_json(cmd, dir)
  printable = "#{cmd.first} #{cmd[1..].join(' ')}"
  out, err, st = Open3.capture3(*cmd, chdir: dir)
  unless st.success?
    warn "lead-time: #{printable} failed: #{err.strip}"
    warn "Fix: run against a repo whose forge you can read (`gh auth status` / `glab auth status`)."
    return ProbeFailures.record(printable, err)
  end
  JSON.parse(out)
rescue JSON::ParserError => e
  warn "lead-time: could not parse #{cmd.first} output: #{e.message}"
  ProbeFailures.record(printable, "unparseable output: #{e.message}")
end

# The candidate PR/MR list is capped. A window holding more requests than the cap
# comes back as exactly the cap, and the overflow is dropped with exit 0, so a
# full page is recorded as a failed probe (the scan reports INCOMPLETE), never
# read as the whole window. GitLab's API caps a page at 100.
MERGED_PAGE_CAP = 1000
GITLAB_PAGE_CAP = 100

def note_saturated(printable, count, cap = MERGED_PAGE_CAP)
  return if count < cap

  ProbeFailures.record(printable, "window saturated: #{count} requests returned at a " \
                                  "cap of #{cap}; requests beyond it would be silently dropped")
end

def origin_url(dir)
  out, _err, st = Open3.capture3("git", "-C", dir, "remote", "get-url", "origin")
  st.success? ? out.strip : ""
end

def detect_forge(dir)
  url = origin_url(dir)
  return :github if url.include?("github.com")
  return :gitlab if url.include?("gitlab.com") || url.include?("gitlab")

  nil
end

# ---- GitHub (gh) ----------------------------------------------------------

class GitHubForge
  def initialize(dir)
    @dir = dir
  end

  def name
    "github (gh)"
  end

  # The candidate landings in the window: every PR CLOSED at or after `since`,
  # merged or not. A PR landed by a fast-forward push of its rebased head shows
  # CLOSED, never MERGED (DND-1317), so a merged-only list silently dropped most
  # ~/dev/custom landings. Whether a closed PR landed, and when, is decided per
  # PR by #facts; a landing precedes the close.
  #
  # The server-side filter is updated:>=, never closed:>=. Closing a PR updates
  # it, so updated:>= is a superset of the window, and closedAt is filtered
  # here. Measured 2026-09-30 on CJPoll/custom: `closed:>=2026-09-29` omitted
  # PRs #127, #125, #123, #122 and #119, all closed that day and unmerged, while
  # `updated:>=2026-09-29` and an unfiltered list both returned them.
  def landing_candidates_since(since_iso)
    since = Time.iso8601(since_iso)
    prs = run_json(["gh", "pr", "list", "--state", "closed", "--search", "updated:>=#{since_iso}",
                    "--limit", MERGED_PAGE_CAP.to_s, "--json", "number,mergedAt,closedAt,state"], @dir) || []
    note_saturated("gh pr list --state closed --search updated:>=#{since_iso}", prs.size)
    prs.select { |p| p["closedAt"] && Time.iso8601(p["closedAt"]) >= since }
       .sort_by { |p| p["closedAt"] }.map { |p| p["number"] }
  end

  def facts(id)
    d = run_json(["gh", "pr", "view", id.to_s, "--json",
                  "number,title,state,mergedAt,closedAt,headRefName,headRefOid,baseRefName," \
                  "commits,mergeCommit"], @dir)
    return nil unless d

    merged_at = d["mergedAt"]
    merge_sha = d.dig("mergeCommit", "oid")
    landed_via = merged_at ? "merge" : nil
    closed = false
    unmeasured = nil
    if merged_at.nil? && d["state"] == "CLOSED"
      land = landing(d["number"], d["headRefOid"], d["baseRefName"])
      case land[:status]
      when :landed
        merged_at, merge_sha, landed_via = land[:at], land[:sha], "push"
      when :not_landed then closed = true
      else unmeasured = land[:reason]
      end
    end
    deploy_at, pipeline_at = ci_ends(merge_sha)
    {
      number: d["number"], title: d["title"], branch: d["headRefName"],
      merged_at: merged_at, merge_sha: merge_sha, landed_via: landed_via,
      closed: closed, unmeasured: unmeasured, closed_at: d["closedAt"],
      # Author AND committer date: a rebase resets only the committer date.
      commit_times: (d["commits"] || []).flat_map { |c| [c["authoredDate"], c["committedDate"]] },
      deploy_at: deploy_at, pipeline_at: pipeline_at,
    }
  end

  # ---- landing of a CLOSED, unmerged PR (DND-1317) -------------------------
  #
  # Judged by the PR's CHANGE being on the base branch (its head reachable, or
  # its commits' patch-ids, or its whole diff's patch-id), and timed by the
  # push that put it there, from the repository activity log. Every lookup that
  # cannot run is a recorded probe failure (the scan then reports INCOMPLETE),
  # and a lookup that runs but cannot decide is :unknown with a reason. Neither
  # ever reads as open. -> {status:, sha:, at:, reason:}
  def landing(number, head, base)
    unless head && base
      return { status: :unknown, reason: "the forge gave no head commit or base branch for this PR" }
    end

    pushes = base_pushes(base)
    return { status: :unknown, reason: "landing probe failed (see SCAN INCOMPLETE)" } unless pushes
    if pushes.empty?
      return { status: :unknown, reason: "the activity log for #{base} lists no pushes" }
    end

    tip = pushes.last[:after]
    unless have_commits?([tip, head]) ||
           (git_ok("fetch", "--quiet", "--no-write-fetch-head", "origin",
                   "refs/heads/#{base}", "refs/pull/#{number}/head") && have_commits?([tip, head]))
      ProbeFailures.record("git fetch origin #{base} pull/#{number}/head",
                           "commit #{tip[0, 12]} or #{head[0, 12]} is not readable after a fetch")
      return { status: :unknown, reason: "landing probe failed (see SCAN INCOMPLETE)" }
    end

    verdict = classify(head, tip)
    return verdict unless verdict[:status] == :landed

    at, reason = LeadTime.landing_push(verdict[:sha], pushes_since(pushes, verdict[:sha]),
                                       ->(sha, after) { ancestor?(sha, after) })
    return { status: :unknown, reason: reason } unless at

    verdict.merge(at: at)
  end

  # ---- every landing on the base branch, PR or not (DND-1009) --------------
  #
  # A landing is an entry in the default branch's activity log. This reads the
  # same log the closed-PR path above reads (base_pushes), keeps the entries in
  # the window that land or rewrite the branch (push, force_push, pr_merge),
  # and reads each push's first-parent commits. -> [{at:, type:, before:,
  # after:, commits:}] oldest first, or nil when the branch or its log cannot
  # be read (a window-wide failed probe). A push whose commits cannot be read
  # carries commits: nil, and its failed probe is tied to that push's time.
  LANDING_TYPES = %w[push force_push pr_merge].freeze
  ZERO_SHA_RE = /\A0+\z/.freeze

  def landing_pushes_since(since_iso)
    base = default_branch or return nil
    entries = base_pushes(base)
    unless entries
      return ProbeFailures.record("gh api activity #{base}", "the activity log for #{base} could not be read")
    end

    since = Time.iso8601(since_iso)
    window = entries.select { |p| LANDING_TYPES.include?(p[:type]) && Time.iso8601(p[:at]) >= since }
    fetch_base(base, window)
    window.map { |p| p.merge(commits: p[:type] == "push" ? pushed_commits(p) : nil) }
  end

  def default_branch
    return @default_branch if defined?(@default_branch)

    d = run_json(["gh", "repo", "view", "--json", "defaultBranchRef"], @dir)
    name = d && d.dig("defaultBranchRef", "name")
    if d && name.to_s.empty?
      ProbeFailures.record("gh repo view --json defaultBranchRef", "the forge named no default branch")
    end
    @default_branch = name.to_s.empty? ? nil : name
  end

  private

  # One fetch of the base when a pushed commit is not in this checkout yet. A
  # commit still missing after it is a per-push failed probe (pushed_commits).
  def fetch_base(base, window)
    shas = window.select { |p| p[:type] == "push" }
                 .flat_map { |p| [p[:before], p[:after]] }.compact.reject { |s| s.match?(ZERO_SHA_RE) }.uniq
    return if shas.empty? || have_commits?(shas)

    git_status("fetch", "--quiet", "--no-write-fetch-head", "origin", "refs/heads/#{base}")
  end

  # [{sha:, subject:, authored:}] newest first for before..after along the
  # first parent; nil on a git failure, never an empty range. A push that
  # created the branch (before all zeros) carries its after commit alone.
  def pushed_commits(push)
    mark = ProbeFailures.mark
    range = push[:before].to_s.match?(ZERO_SHA_RE) ? ["-1", push[:after]] : ["#{push[:before]}..#{push[:after]}"]
    out = git_ok("log", "--first-parent", "--format=%H%x09%aI%x09%s", *range)
    ProbeFailures.tag_from(mark, push[:at])
    return nil unless out

    out.lines.map do |l|
      sha, authored, subject = l.chomp.split("\t", 3)
      { sha: sha, subject: subject.to_s, authored: authored }
    end
  end

  def classify(head, tip)
    return { status: :landed, sha: head } if ancestor?(head, tip)

    pr_only = commit_patches(["--no-merges", head, "^#{tip}"])
    main = commit_patches(["--no-merges", tip, "^#{head}"])
    base = git_ok("merge-base", head, tip)
    diff = base && git_ok(*PATCH_CONFIG, "diff", *PATCH_FLAGS, base.strip, head)
    combined_ids = diff && patch_ids(diff)
    unless pr_only && main && combined_ids
      return { status: :unknown, reason: "landing probe failed (see SCAN INCOMPLETE)" }
    end

    LeadTime.classify_landing(pr_only: pr_only, combined_pid: combined_ids.first&.first, main: main)
  end

  # A patch-id reads the patch text, so user config must not change it: no
  # colour, no external diff or textconv, and the default a/ b/ prefixes.
  PATCH_CONFIG = ["-c", "diff.noprefix=false", "-c", "color.ui=never"].freeze
  PATCH_FLAGS = ["--no-color", "--no-ext-diff", "--no-textconv"].freeze

  # [{sha:, pid:, subject:}] for a rev range, newest first; nil on a git failure.
  def commit_patches(range)
    subjects = git_ok("log", "--format=%H%x09%s", *range) or return nil
    patches = git_ok(*PATCH_CONFIG, "log", "-p", *PATCH_FLAGS, "--format=commit %H", *range) or return nil
    ids = patch_ids(patches) or return nil
    pid_of = ids.to_h { |pid, sha| [sha, pid] }
    subjects.lines.map do |l|
      sha, subject = l.chomp.split("\t", 2)
      { sha: sha, pid: pid_of[sha], subject: subject.to_s }
    end
  end

  # [[patch_id, sha], ...] for a stream of patches; nil when patch-id failed,
  # which must never read as "no patches".
  def patch_ids(text)
    out = git_ok("patch-id", "--stable", stdin: text) or return nil
    out.lines.map(&:split)
  end

  # The pushes to refs/heads/<base>, oldest first, cached per base.
  def base_pushes(base)
    @pushes ||= {}
    return @pushes[base] if @pushes.key?(base)

    pages = run_json(["gh", "api", "--paginate", "--slurp",
                      "repos/{owner}/{repo}/activity?ref=refs/heads/#{base}&per_page=100"], @dir)
    # A branch deletion's `after` is all zeros; it carries no commit and must
    # never become the tip.
    @pushes[base] = pages && pages.flatten.select { |a| a["after"] && a["timestamp"] && a["after"] !~ /\A0+\z/ }
                                    .map do |a|
                                      { at: a["timestamp"], after: a["after"], before: a["before"],
                                        type: a["activity_type"] }
                                    end
                                    .sort_by { |p| p[:at] }
  end

  # A push cannot precede the commit it carries. Starting from an hour before
  # the commit's committer date (slack for clock skew) keeps the ancestry
  # checks few without skipping the push that landed it. An unreadable date
  # only widens the search to every push, so it is not a failed probe.
  def pushes_since(pushes, sha)
    out, _e, st = Open3.capture3("git", "-C", @dir, "show", "-s", "--format=%cI", sha)
    return pushes unless st.success?

    floor = Time.iso8601(out.strip) - 3600
    pushes.select { |p| Time.iso8601(p[:at]) >= floor }
  end

  def have_commits?(shas)
    shas.all? { |s| git_status("cat-file", "-e", "#{s}^{commit}") == 0 }
  end

  # true / false, or nil when either commit cannot be read.
  def ancestor?(a, b)
    case git_status("merge-base", "--is-ancestor", a, b)
    when 0 then true
    when 1 then false
    end
  end

  def git_status(*args)
    _o, _e, st = Open3.capture3("git", "-C", @dir, *args)
    st.exitstatus
  end

  def git_ok(*args, stdin: nil)
    out, err, st = Open3.capture3("git", "-C", @dir, *args, stdin_data: stdin.to_s)
    return out if st.success?

    ProbeFailures.record("git #{args.first(3).join(' ')}", err)
  end

  public

  # Returns [deploy_completed_at, pipeline_completed_at] for the merge sha.
  # A completed run whose workflow name matches the deploy regex and concluded
  # success -> deploy end; any other successful completed run -> pipeline end.
  # The query is scoped to the merge sha (`--commit`). A repo-wide recent-runs
  # list is both slow per PR and bounded in time, so an older merge's deploy
  # would silently read as "no deploy".
  def ci_ends(merge_sha)
    return [nil, nil] unless merge_sha

    runs = run_json(["gh", "run", "list", "--commit", merge_sha, "--limit", "100",
                     "--json", "headSha,updatedAt,conclusion,status,name"], @dir) || []
    mine = runs.select { |r| r["headSha"] == merge_sha && r["status"] == "completed" && r["conclusion"] == "success" }
    deploy = mine.select { |r| r["name"].to_s.match?(DEPLOY_NAME_RE) }
    other  = mine.reject { |r| r["name"].to_s.match?(DEPLOY_NAME_RE) }
    [LeadTime.latest(deploy.map { |r| r["updatedAt"] }),
     LeadTime.latest(other.map { |r| r["updatedAt"] })]
  end
end

# ---- GitLab (glab) --------------------------------------------------------

class GitLabForge
  def initialize(dir)
    @dir = dir
    @proj = project_path(dir)
  end

  def name
    "gitlab (glab)"
  end

  def project_path(dir)
    # git@gitlab.com:group/sub/repo.git  OR  https://gitlab.com/group/repo.git
    url = origin_url(dir)
    path = url.sub(%r{^git@[^:]+:}, "").sub(%r{^https?://[^/]+/}, "").sub(/\.git$/, "")
    path.split("/").map { |seg| URI.encode_www_form_component(seg) }.join("%2F")
  end

  def api(path)
    run_json(["glab", "api", path], @dir)
  end

  def landing_candidates_since(since_iso)
    since = Time.iso8601(since_iso)
    # A merge at or after `since` was updated at or after it, so updated_after
    # is a server-side superset of the window; saturation then means truncation.
    after = URI.encode_www_form_component(since_iso)
    mrs = api("projects/#{@proj}/merge_requests?state=merged&order_by=updated_at" \
              "&updated_after=#{after}&per_page=#{GITLAB_PAGE_CAP}") || []
    note_saturated("glab api merge_requests?updated_after=#{since_iso}", mrs.size, GITLAB_PAGE_CAP)
    mrs.select { |m| m["merged_at"] && Time.iso8601(m["merged_at"]) >= since }
       .sort_by { |m| m["merged_at"] }.map { |m| m["iid"] }
  end

  def facts(id)
    d = api("projects/#{@proj}/merge_requests/#{id}")
    return nil unless d

    commits = api("projects/#{@proj}/merge_requests/#{id}/commits") || []
    merge_sha = d["merge_commit_sha"] || d["squash_commit_sha"] || d["sha"]
    deploy_at, pipeline_at = ci_ends(d)
    # A closed, unmerged MR may still have landed by a push; that is only
    # detected on GitHub (DND-1317), so here it says so instead of reading open.
    unmeasured = if d["state"] == "closed" && d["merged_at"].nil?
                   "closed without a merge; landing by push is only detected on GitHub"
                 end
    {
      number: d["iid"], title: d["title"], branch: d["source_branch"],
      merged_at: d["merged_at"], merge_sha: merge_sha,
      landed_via: d["merged_at"] ? "merge" : nil, unmeasured: unmeasured,
      closed_at: d["merged_at"] || d["closed_at"],
      # authored_date survives a rebase; created_at is the committer date.
      commit_times: commits.flat_map { |c| [c["authored_date"], c["committed_date"], c["created_at"]] },
      deploy_at: deploy_at, pipeline_at: pipeline_at,
    }
  end

  # Find the post-merge pipeline on the default branch for the merge and read
  # its deploy-stage job completions.
  def ci_ends(mr)
    shas = [mr["merge_commit_sha"], mr["squash_commit_sha"], mr["sha"]].compact.uniq
    pipeline = nil
    shas.each do |sha|
      ps = api("projects/#{@proj}/pipelines?sha=#{sha}")
      pipeline = ps&.first
      break if pipeline
    end
    return [nil, nil] unless pipeline

    jobs = api("projects/#{@proj}/pipelines/#{pipeline['id']}/jobs?per_page=100") || []
    succeeded = jobs.select { |j| j["status"] == "success" }
    deploy_jobs = succeeded.select { |j| j["stage"] == DEPLOY_GL_STAGE }
    deploy_at   = LeadTime.latest(deploy_jobs.map { |j| j["finished_at"] })
    pipeline_at = LeadTime.latest(succeeded.map { |j| j["finished_at"] })
    [deploy_at, pipeline_at]
  end
end

# ---- the START: a ticket's move to In Progress (DND-1318, DND-1341) --------
#
# Owner decision (Cody, 2026-09-30): lead time = captain dispatch, the ticket's
# move to In Progress, -> landed on main. The Notion API keeps no history of a
# property, so the move is recorded as it happens: a date property, stamped
# once, at the first move to In Progress, by
# ai/skills/athena:ticket-management/scripts/mark-in-progress. This reads it.
# Which database and property hold it is the ticket's tracker
# (ai/lib/dispatch_trackers.rb): DND Tickets for a DND ticket, the work
# tracker (its values from the private overlay) for a work ticket.
#
# lookup(ref) -> [iso, nil] or [nil, reason]. A ticket that is not in the
# database, has no stamp, or cannot be named is a per-row reason. A read that
# cannot run (no token, an HTTP failure) is a failed probe, so the run ends
# SCAN INCOMPLETE: "could not look" never reads as "has no start".
class NotionStart
  PROPERTY = DispatchTrackers::DND.property

  attr_reader :tracker

  def initialize(transport, missing_reason: nil, tracker: DispatchTrackers::DND)
    @transport = transport
    @missing_reason = missing_reason
    @tracker = tracker
    @cache = {}
  end

  def source(ref)
    "#{ref} #{@tracker.property}"
  end

  # Which ticket a request works, among this tracker's tickets only.
  def ref_for(branch:, title:)
    LeadTime.ticket_ref(branch: branch, title: title, prefixes: [@tracker.prefix])
  end

  # The ticket prefixes a direct push's subjects may name.
  def ref_prefixes(_texts)
    [@tracker.prefix]
  end

  def lookup(ref)
    @cache[ref] ||= read(ref)
  end

  private

  def read(ref)
    prefix, number = ref.split("-", 2)
    unless prefix == @tracker.prefix
      return [nil, "#{ref} is not a #{@tracker.prefix} ticket; " \
                   "only #{@tracker.label} records '#{@tracker.property}' here"]
    end
    unless @transport
      ProbeFailures.record("notion #{@tracker.label} query #{ref}", @missing_reason)
      return [nil, "#{ref}: Notion could not be read (see SCAN INCOMPLETE)"]
    end

    page = query(Integer(number, 10))
    return [nil, "there is no #{ref} in #{@tracker.label}"] unless page

    stamp(ref, page)
  rescue NextMissionNotion::ReadError => e
    ProbeFailures.record("notion #{@tracker.label} query #{ref}", e.message)
    [nil, "#{ref}: Notion could not be read (see SCAN INCOMPLETE)"]
  end

  def query(number)
    body = { "filter" => { "property" => "ID", "unique_id" => { "equals" => number } }, "page_size" => 2 }
    res = @transport.call(:post, "/v1/data_sources/#{@tracker.data_source}/query", body)
    (res["results"] || []).first
  end

  def stamp(ref, page)
    prop = @tracker.property
    label = @tracker.label
    props = page["properties"] || {}
    return [nil, "#{label} has no '#{prop}' property"] unless props.key?(prop)
    unless props.dig(prop, "type") == "date"
      return [nil, "the '#{prop}' property in #{label} is a #{props.dig(prop, 'type').inspect} property, not a date"]
    end

    start = props.dig(prop, "date", "start")
    unless start
      return [nil, "#{ref} has no '#{prop}' date (dispatched before the stamp existed, " \
                   "or moved to In Progress without mark-in-progress)"]
    end
    return [nil, "#{ref}'s '#{prop}' is a date with no time (#{start})"] unless start.include?("T")
    unless start.match?(LeadTime::ZONED_RE)
      return [nil, "#{ref}'s '#{prop}' has no UTC offset (#{start}); it cannot be placed in time"]
    end

    [Time.iso8601(start).utc.iso8601, nil]
  rescue ArgumentError
    [nil, "#{ref}'s '#{prop}' is not a time (#{start})"]
  end
end

# The START across both trackers (DND-1341). dnd: a NotionStart over DND
# Tickets. work: -> [NotionStart or nil, DispatchTrackers::Resolution], called
# at most once, and only for a request that names a ticket-shaped ref other
# than a DND one (a work ticket, or a word like utf-8), so a request naming only
# DND tickets, or nothing ticket-shaped, never reads the overlay.
#
# A request naming no DND ticket while the work tracker cannot be resolved
# says why in its row, carrying the overlay's line. An ABSENT overlay is that
# machine's state (the work tracker is unavailable there), so it is a per-row
# reason only; a PRESENT overlay that cannot give the tracker (a missing key,
# a malformed value) is also a failed probe, so the scan ends SCAN INCOMPLETE.
class TicketStarts
  def initialize(dnd:, work:)
    @dnd = dnd
    @work_source = work
    @work = nil
    @fault_recorded = false
  end

  def ref_for(branch:, title:)
    others = (LeadTime.refs_in(branch) + LeadTime.refs_in(title)).reject { |r| r.start_with?("#{@dnd.tracker.prefix}-") }
    return @dnd.ref_for(branch: branch, title: title) if others.empty?

    work_start, res = work
    if work_start
      return LeadTime.ticket_ref(branch: branch, title: title,
                                 prefixes: [@dnd.tracker.prefix, work_start.tracker.prefix])
    end

    ref, why = @dnd.ref_for(branch: branch, title: title)
    return [ref, why] if ref

    if res.fault && !@fault_recorded
      ProbeFailures.record("private-overlay work tracker", res.reason)
      @fault_recorded = true
    end
    [nil, "#{why}; the work tracker is unavailable: #{res.reason}"]
  end

  # The ticket prefixes a direct push's subjects may name (DND-1009): DND, and
  # the work tracker's only when a subject names a non-DND ref and the overlay
  # gives the tracker. A present overlay that cannot give it is a failed probe,
  # as in ref_for; the push row then names the refs it could not place.
  def ref_prefixes(texts)
    dnd = @dnd.tracker.prefix
    others = texts.flat_map { |t| LeadTime.refs_in(t) }.reject { |r| r.start_with?("#{dnd}-") }
    return [dnd] if others.empty?

    work_start, res = work
    return [dnd, work_start.tracker.prefix] if work_start

    if res.fault && !@fault_recorded
      ProbeFailures.record("private-overlay work tracker", res.reason)
      @fault_recorded = true
    end
    [dnd]
  end

  def lookup(ref)
    source_for(ref).lookup(ref)
  end

  def source(ref)
    source_for(ref).source(ref)
  end

  private

  def work
    @work ||= @work_source.call
  end

  def source_for(ref)
    work_start, = ref.start_with?("#{@dnd.tracker.prefix}-") ? nil : work
    work_start && ref.start_with?("#{work_start.tracker.prefix}-") ? work_start : @dnd
  end
end

# A NotionStart over a tracker, reading its token in-process. A missing or
# empty token is carried as the reason every lookup's probe failure names.
def notion_start_for(tracker)
  file = tracker.token_file
  token = File.exist?(file) ? File.read(file).strip : ""
  return NotionStart.new(NextMissionNotion::HttpTransport.new(token), tracker: tracker) unless token.empty?

  NotionStart.new(nil, tracker: tracker,
                       missing_reason: "no Notion token for #{tracker.label} at #{file}. " \
                                       "Fix: place that integration token there (owner-gated).")
end

# The real start source: DND Tickets, plus the work tracker read from the
# private overlay when a request names a non-DND ticket.
def notion_start
  work = lambda do
    res = DispatchTrackers::Overlay.work
    [res.tracker && notion_start_for(res.tracker), res]
  end
  TicketStarts.new(dnd: notion_start_for(DispatchTrackers::DND), work: work)
end

def forge_for(dir)
  case detect_forge(dir)
  when :github then GitHubForge.new(dir)
  when :gitlab then GitLabForge.new(dir)
  end
end

# starts: the START source (NotionStart, or a test double answering lookup
# and source). A closed-unlanded request has no lead, so it is never looked up.
def analyze(forge, id, starts)
  f = forge.facts(id)
  return nil unless f

  start_at = start_why = source = nil
  unless f[:closed]
    ref, start_why = starts.ref_for(branch: f[:branch], title: f[:title])
    if ref
      start_at, start_why = starts.lookup(ref)
      source = starts.source(ref)
    end
  end
  LeadTime.compute(start_at: start_at, start_source: source, start_unmeasured: start_why,
                   first_commit_times: f[:commit_times], deploy_at: f[:deploy_at],
                   pipeline_at: f[:pipeline_at], merged_at: f[:merged_at],
                   closed: f[:closed], unmeasured: f[:unmeasured])
          .merge(pr: f[:number], title: f[:title], branch: f[:branch],
                 landed_via: f[:landed_via], landed_commit: f[:landed_via] == "push" ? f[:merge_sha] : nil,
                 merge_commit: f[:landed_via] == "merge" ? f[:merge_sha] : nil, closed_at: f[:closed_at])
end

# One direct-push landing row from a LeadTime.build_push_rows skeleton: its
# ticket's start, the CI on its pushed commit, and the landing time. A row
# carrying a reason the landing cannot be measured (a force push, an
# unreadable range) reads no start and no CI.
def push_row(forge, sk, starts)
  start_at = source = nil
  why = sk[:start_unmeasured]
  if sk[:ticket] && !sk[:unmeasured]
    start_at, why = starts.lookup(sk[:ticket])
    source = starts.source(sk[:ticket])
  end
  deploy_at, pipeline_at = sk[:unmeasured] ? [nil, nil] : forge.ci_ends(sk[:landed_commit])
  LeadTime.compute(start_at: start_at, start_source: source, start_unmeasured: why,
                   first_commit_times: sk[:first_commit_times], deploy_at: deploy_at,
                   pipeline_at: pipeline_at, merged_at: sk[:at], unmeasured: sk[:unmeasured])
          .merge(pr: nil, ticket: sk[:ticket], title: sk[:title], branch: nil, landed_via: "push",
                 landed_commit: sk[:landed_commit], commits: sk[:commits], closed_at: sk[:at])
end

# The direct-push landings in the window (DND-1009), deduped against the PR
# rows. A forge with no push reader (GitLab) adds none, and says so.
def push_rows(forge, since, pr_rows, starts)
  unless forge.respond_to?(:landing_pushes_since)
    warn "lead-time: #{forge.name} lists merge requests only; direct pushes to the base branch are not read here"
    return []
  end
  pushes = forge.landing_pushes_since(since) or return []

  covered = pr_rows.flat_map { |r| [r[:landed_commit], r[:merge_commit]] }
  subjects = pushes.flat_map { |p| (p[:commits] || []).map { |c| c[:subject] } }
  LeadTime.build_push_rows(pushes: pushes, covered: covered, prefixes: starts.ref_prefixes(subjects)).map do |sk|
    mark = ProbeFailures.mark
    row = push_row(forge, sk, starts)
    ProbeFailures.tag_from(mark, sk[:at])
    row
  end
end

# Every landing in the window: the PR rows, then the direct pushes. Each
# row's failed probes are tied to its window time, so --meta can stop its
# cursor before the first one. -> [rows oldest first, closed-unlanded count]
def scan_window(forge, since, starts)
  pr_rows = forge.landing_candidates_since(since).filter_map do |n|
    mark = ProbeFailures.mark
    row = analyze(forge, n, starts)
    ProbeFailures.tag_from(mark, row && row[:closed_at])
    row
  end
  rows, closed_n = select_window(pr_rows, since)
  rows += push_rows(forge, since, pr_rows, starts)
  [rows.sort_by { |r| Time.iso8601(r[:closed_at]) }, closed_n]
end

def write_meta(file, meta)
  File.write(file, "#{JSON.pretty_generate(meta)}\n")
  true
rescue SystemCallError => e
  warn "lead-time: could not write --meta #{file}: #{e.message}"
  warn "Fix: pass --meta a path in a directory that exists and that you can write."
  false
end

# A window scan's rows. The window is by CLOSE time (`closed_at`), not landing
# time: a push lands a PR seconds to minutes before its close, so a scan that
# ticks in between cannot list it yet, and the next scan must keep it even
# though it landed before `since`. A closed-unlanded PR is not a landing.
# -> [kept rows, count of closed-unlanded]. A could-not-measure row is KEPT.
def select_window(rows, since_iso)
  since = Time.iso8601(since_iso)
  closed = rows.count { |r| r[:end_kind] == :closed }
  kept = rows.reject do |r|
    r[:end_kind] == :closed || r[:end_kind] == :open ||
      (r[:closed_at] && Time.iso8601(r[:closed_at]) < since)
  end
  [kept, closed]
end

# --slow N: the rows with lead >= N minutes, slowest first, then every
# could-not-measure row (lead_seconds null, unmeasured_reason set).
def slow_filter(rows, slow_min)
  threshold = slow_min * 60
  rows.select { |r| r[:unmeasured_reason] || (r[:lead_seconds] && r[:lead_seconds] >= threshold) }
      .each { |r| r[:slow_threshold_min] = slow_min }
      .sort_by { |r| r[:lead_seconds] ? -r[:lead_seconds] : 1 }
end

# ---------------------------------------------------------------------------
# --self-test (pure logic only)
# ---------------------------------------------------------------------------

def self_test
  failures = []
  check = lambda do |name, got, want|
    failures << "#{name}: got #{got.inspect}, want #{want.inspect}" unless got == want
  end

  # duration_human
  check.call("dur 47m", LeadTime.duration_human(47 * 60), "47m")
  check.call("dur 2h14m", LeadTime.duration_human(2 * 3600 + 14 * 60), "2h 14m")
  check.call("dur 3d5h", LeadTime.duration_human(3 * 86_400 + 5 * 3600 + 9 * 60), "3d 5h")
  check.call("dur 18s", LeadTime.duration_human(18), "18s")
  check.call("dur 0", LeadTime.duration_human(0), "0s")
  check.call("dur neg", LeadTime.duration_human(-5), "0s")
  check.call("dur nil", LeadTime.duration_human(nil), "n/a")
  check.call("dur 5m0s->5m", LeadTime.duration_human(5 * 60), "5m")

  # pick_start / latest
  check.call("start earliest",
             LeadTime.pick_start(["2026-09-19T05:00:00Z", "2026-09-19T04:42:00Z",
                                  "2026-09-19T04:55:00Z"]).utc.iso8601,
             "2026-09-19T04:42:00Z")
  check.call("start empty", LeadTime.pick_start([]), nil)
  check.call("latest max",
             LeadTime.latest(["2026-09-19T06:55:25Z", "2026-09-19T06:58:17Z", nil, ""]),
             "2026-09-19T06:58:17Z")
  check.call("latest none", LeadTime.latest([nil, ""]), nil)

  # pick_end 3-tier
  e, k = LeadTime.pick_end(deploy_at: "2026-09-19T06:06:39Z",
                           pipeline_at: "2026-09-19T05:55:00Z",
                           merged_at: "2026-09-19T05:46:40Z")
  check.call("end deploy time", e.utc.iso8601, "2026-09-19T06:06:39Z")
  check.call("end deploy kind", k, :deploy)

  e2, k2 = LeadTime.pick_end(deploy_at: nil, pipeline_at: "2026-09-19T05:55:00Z",
                             merged_at: "2026-09-19T05:46:40Z")
  check.call("end pipeline time", e2.utc.iso8601, "2026-09-19T05:55:00Z")
  check.call("end pipeline kind", k2, :pipeline)

  e3, k3 = LeadTime.pick_end(deploy_at: nil, pipeline_at: nil,
                             merged_at: "2026-09-19T05:41:21Z")
  check.call("end merge time", e3.utc.iso8601, "2026-09-19T05:41:21Z")
  check.call("end merge kind", k3, :merge)

  e4, k4 = LeadTime.pick_end(deploy_at: "", pipeline_at: "", merged_at: nil)
  check.call("end open", e4, nil)
  check.call("end open kind", k4, :open)

  # compute end-to-end: custom PR14 shape (no CI -> merge)
  r = LeadTime.compute(
    start_at: "2026-09-19T04:42:59Z", start_source: "DND-185 In Progress at",
    first_commit_times: ["2026-09-19T05:00:00Z", "2026-09-19T05:35:44Z"],
    deploy_at: nil, pipeline_at: nil, merged_at: "2026-09-19T05:41:21Z")
  check.call("compute start is start_at, not the first commit", r[:start], "2026-09-19T04:42:59Z")
  check.call("compute first_commit is reported beside it", r[:first_commit], "2026-09-19T05:00:00Z")
  check.call("compute pr14 seconds", r[:lead_seconds], 3502)
  check.call("compute pr14 human", r[:lead_human], "58m 22s")
  check.call("compute pr14 kind", r[:end_kind], :merge)
  check.call("compute pr14 code", r[:code_seconds], 3502)  # start->merge
  check.call("compute pr14 tail", r[:tail_seconds], 0)     # merge->end (=merge)

  # compute deploy shape (gitlab walt_ui MR1188: 05:05:41Z -> 06:58:17Z)
  r2 = LeadTime.compute(
    start_at: "2026-09-19T05:05:41Z",
    deploy_at: "2026-09-19T06:58:17Z", pipeline_at: "2026-09-19T07:07:37Z",
    merged_at: "2026-09-19T06:47:40Z")
  check.call("compute deploy kind", r2[:end_kind], :deploy)
  check.call("compute deploy seconds", r2[:lead_seconds], 6756) # 05:05:41 -> 06:58:17
  check.call("compute deploy code", r2[:code_seconds], 6119)    # start -> merge
  check.call("compute deploy tail", r2[:tail_seconds], 637)     # merge -> deploy

  # ProbeFailures — the "could not look" vs "looked, found nothing" accounting.
  # Asserted on the MISS side deliberately: a suite that only ever exercises a
  # healthy probe proves nothing about this class.
  ProbeFailures.reset!
  check.call("probes clean initially", ProbeFailures.any?, false)
  check.call("record returns nil (so callers still see no data)",
             ProbeFailures.record("gh pr list", "HTTP 401: Requires authentication"), nil)
  check.call("failed probe is observable", ProbeFailures.any?, true)
  check.call("failed probe names the command",
             ProbeFailures.list.first.to_h[:cmd], "gh pr list")
  check.call("failed probe keeps the reason",
             ProbeFailures.list.first.to_h[:detail], "HTTP 401: Requires authentication")
  ProbeFailures.record("glab api projects/1/merge_requests", "403")
  check.call("probes accumulate", ProbeFailures.list.size, 2)
  ProbeFailures.reset!
  check.call("reset clears", ProbeFailures.any?, false)

  # GitHubForge#ci_ends must ask for the runs OF THE MERGE SHA, not scan a
  # repo-wide `gh run list --limit 300` once per PR. The repo-wide list (a) cost
  # ~7.8s per PR on gen_saas, so a 100-PR window took ~840s and the shipwright's
  # bounded scan timed out three runs running; and (b) reached back only to
  # 2026-09-23T18:23Z, so an older merge's deploy silently read as "no deploy"
  # and its tail as 0s. The stub serves the merge sha's run ONLY to a query
  # scoped to that sha, the way the forge does.
  gh = GitHubForge.new(".")
  seen = []
  gh.define_singleton_method(:run_json) do |cmd, _dir|
    seen << cmd
    i = cmd.index("--commit")
    next [] unless i && cmd[i + 1] == "old1"

    [{ "headSha" => "old1", "status" => "completed", "conclusion" => "success",
       "name" => "Post-Merge Deploy", "updatedAt" => "2026-09-22T02:00:00Z" },
     { "headSha" => "old1", "status" => "completed", "conclusion" => "success",
       "name" => "CI", "updatedAt" => "2026-09-22T01:50:00Z" }]
  end
  check.call("deploy of a merge outside any recent-runs window resolves",
             gh.ci_ends("old1"), ["2026-09-22T02:00:00Z", "2026-09-22T01:50:00Z"])
  check.call("run query is scoped to the merge sha",
             seen.all? { |c| c.include?("--commit") }, true)

  # landing_candidates_since must never silently drop merges. The merged-PR list is capped
  # (--limit / per_page); a window holding more merges than the cap returned
  # exactly the cap, and the rest vanished with exit 0. Measured 2026-09-26 on
  # gen_saas: 122 merges since the held cursor, `--limit 100` returned 100.
  # A saturated page must mark the scan INCOMPLETE, and the query must filter
  # by the window server-side so saturation means truncation.
  ProbeFailures.reset!
  since = "2026-09-22T00:00:00Z"
  gh_sat = GitHubForge.new(".")
  gh_cmds = []
  gh_sat.define_singleton_method(:run_json) do |cmd, _dir|
    gh_cmds << cmd
    lim = cmd[cmd.index("--limit") + 1].to_i
    Array.new(lim) { |n| { "number" => n + 1, "mergedAt" => "2026-09-25T00:00:00Z" } }
  end
  gh_sat.landing_candidates_since(since)
  check.call("gh closed list filters the window server-side",
             gh_cmds.first.include?("updated:>=#{since}"), true)
  check.call("gh saturated merged list marks the scan incomplete", ProbeFailures.any?, true)

  ProbeFailures.reset!
  gh_ok = GitHubForge.new(".")
  gh_ok.define_singleton_method(:run_json) do |_cmd, _dir|
    [{ "number" => 7, "mergedAt" => "2026-09-25T00:00:00Z", "closedAt" => "2026-09-25T00:00:00Z" }]
  end
  check.call("gh unsaturated merged list returns its merges", gh_ok.landing_candidates_since(since), [7])
  check.call("gh unsaturated merged list is a clean probe", ProbeFailures.any?, false)

  gl_sat = GitLabForge.allocate
  gl_sat.instance_variable_set(:@proj, "g%2Fr")
  gl_paths = []
  gl_sat.define_singleton_method(:api) do |path|
    gl_paths << path
    per = path[/per_page=(\d+)/, 1].to_i
    Array.new(per) { |n| { "iid" => n + 1, "merged_at" => "2026-09-25T00:00:00Z" } }
  end
  gl_sat.landing_candidates_since(since)
  check.call("gitlab merged list filters the window server-side",
             gl_paths.first.include?("updated_after="), true)
  check.call("gitlab saturated merged list marks the scan incomplete", ProbeFailures.any?, true)
  ProbeFailures.reset!

  # START must survive a rebase. A rebase (and every land here rebases onto
  # origin/main first) rewrites each commit's COMMITTER date to the rebase
  # time and keeps its AUTHOR date. Keyed on the committer date, START moved
  # to the last rebase and the ticket read short. Measured 2026-09-27:
  # custom PR #90 (DND-978) first authored 06:58:52Z, rebased 22:50:12Z,
  # merged 23:43:13Z, read 53m instead of 16h44m, so it never crossed
  # --slow 90; gen_saas PR #478 read 5h1m instead of 9h43m.
  gh_rb = GitHubForge.new(".")
  gh_rb.define_singleton_method(:run_json) do |cmd, _dir|
    next [] if cmd[1] == "run"

    { "number" => 90, "title" => "t", "headRefName" => "b",
      "mergedAt" => "2026-09-27T23:43:13Z", "mergeCommit" => { "oid" => "m90" },
      "commits" => [
        { "authoredDate" => "2026-09-27T06:58:52Z", "committedDate" => "2026-09-27T22:50:12Z" },
        { "authoredDate" => "2026-09-27T23:06:17Z", "committedDate" => "2026-09-27T23:06:17Z" },
      ] }
  end
  f_rb = gh_rb.facts(90)
  check.call("gh start survives a rebase (author date, not committer date)",
             LeadTime.pick_start(f_rb[:commit_times])&.utc&.iso8601, "2026-09-27T06:58:52Z")

  gl_rb = GitLabForge.allocate
  gl_rb.instance_variable_set(:@proj, "g%2Fr")
  gl_rb.define_singleton_method(:ci_ends) { |_mr| [nil, nil] }
  gl_rb.define_singleton_method(:api) do |path|
    if path.end_with?("/commits")
      [{ "authored_date" => "2026-09-27T06:58:52.000-00:00",
         "committed_date" => "2026-09-27T22:50:12.000-00:00",
         "created_at" => "2026-09-27T22:50:12.000-00:00" }]
    else
      { "iid" => 9, "title" => "t", "source_branch" => "b",
        "merged_at" => "2026-09-27T23:43:13Z", "merge_commit_sha" => "m9" }
    end
  end
  f_gl = gl_rb.facts(9)
  check.call("gitlab start survives a rebase (authored_date, not created_at)",
             LeadTime.pick_start(f_gl[:commit_times])&.utc&.iso8601, "2026-09-27T06:58:52Z")

  if failures.empty?
    puts "lead-time --self-test: PASS (pure-logic assertions)"
    0
  else
    warn "lead-time --self-test: FAIL"
    failures.each { |f| warn "  - #{f}" }
    warn "Fix: reconcile module LeadTime with the expected marker/date math above."
    1
  end
end

# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def usage
  warn <<~USAGE
    lead-time — derive a fleet ticket's lead time from git + the forge's CI.

      lead-time --repo DIR --pr N [--json]     # --mr is a synonym for --pr
      lead-time --repo DIR --since WHEN [--slow MIN] [--json] [--meta FILE]
      lead-time --self-test

    Fix: pass --self-test, or --repo with either --pr/--mr or --since, each
    value flag followed by its value (--slow takes whole minutes; --since
    takes YYYY-MM-DD or a zoned RFC 3339 time; --meta needs --since). Only
    the flags `ai/bin/lead-time --help` lists are accepted.
  USAGE
  1
end

def print_row(r)
  kind = { deploy: "deploy", pipeline: "pipeline", merge: "merge", open: "open", closed: "closed",
           unmeasured: "unmeasured" }[r[:end_kind]] || r[:end_kind].to_s
  # A landing by push has no forge merge; name it as a push (DND-1009).
  kind = "push" if kind == "merge" && r[:landed_via] == "push"
  printf("%-6s  lead=%-9s (code %-8s + tail %-8s)  via=%-8s %s%s%s\n",
         r[:pr] ? "##{r[:pr]}" : "push", r[:lead_human], r[:code_human], r[:tail_human], kind,
         (r[:title] || "")[0, 46],
         r[:unmeasured_reason] ? "  [could not measure: #{r[:unmeasured_reason]}]" : "",
         r[:landed_via] == "push" ? "  [landed by push #{r[:landed_commit].to_s[0, 8]}]" : "")
  puts "        start=#{r[:start_source]} #{r[:start]}" if r[:start_source]
end

require_relative "../lib/strict_argv"

# Every argument must be a declared flag, and a value flag must have a value
# (DND-526). The old loop read a valueless or non-integer `--slow` as nil and
# silently dropped the outlier filter.
CLI_SPEC = { "--self-test" => :switch, "--json" => :switch, "--repo" => :value,
             "--pr" => :value, "--mr" => :value, "--since" => :value,
             "--slow" => :integer, "--meta" => :value }.freeze

# -> [opts, nil] on success, [nil, reason] on a usage error.
def parse_cli(argv)
  opts = StrictArgv.parse(argv, CLI_SPEC)
  if opts["--self-test"] && opts.size > 1
    return [nil, "--self-test takes no other flag (got #{(opts.keys - ['--self-test']).join(', ')})"]
  end
  return [nil, "--pr and --mr are synonyms; pass one"] if opts.key?("--pr") && opts.key?("--mr")
  if (opts.key?("--pr") || opts.key?("--mr")) && opts.key?("--since")
    return [nil, "--since scans a window and --pr/--mr reads one request; pass one"]
  end
  return [nil, "--meta reports a window scan; pass it with --since"] if opts.key?("--meta") && !opts.key?("--since")

  [opts, nil]
rescue StrictArgv::UsageError => e
  [nil, e.message]
end

# The scan (the manager). forge and starts are injected so a test drives it
# with fixtures; the CLI passes the real ones. -> the exit code.
def run_scan(repo:, since:, slow_min:, as_json:, meta_file:, forge:, starts:, id: nil)
  rows = []
  if id
    rows = [analyze(forge, id, starts)].compact
    if rows.empty?
      warn "lead-time: #{id} not found or unreadable in #{repo}"
      warn "Fix: check the PR/MR number and that the forge CLI can read this repo."
      return 2
    end
  else
    rows, closed_n = scan_window(forge, since, starts)
    warn "lead-time: #{closed_n} closed request(s) in the window never landed; not counted" if closed_n.positive?
  end
  landings = rows

  # A row whose landing could not be decided has no lead, so --slow would drop
  # it with the fast rows. Name each one, so "not an outlier" and "could not
  # measure" never read the same.
  rows.select { |r| r[:unmeasured_reason] }.each do |r|
    warn "lead-time: #{r[:pr] ? "##{r[:pr]}" : "push #{r[:landed_commit].to_s[0, 8]}"} could not be measured: " \
         "#{r[:unmeasured_reason]}"
  end

  # --slow N: keep only tickets whose lead time is >= N minutes (the feedback
  # loop's outlier filter), plus every could-not-measure row: it cannot be
  # shown fast, so dropping it would read as "not an outlier". Those rows keep
  # lead_seconds null and carry unmeasured_reason; they sort last.
  rows = slow_filter(rows, slow_min) if slow_min

  # --meta: the caller's cursor, from every landing BEFORE --slow (DND-1009),
  # written on an incomplete scan too, marked incomplete. It carries no rows.
  if meta_file
    meta = LeadTime.scan_meta(rows: landings, kept: rows.size, failures: ProbeFailures.list)
    return 1 unless write_meta(meta_file, meta)
  end

  # A scan that could not read the forge is NOT a scan. Refuse to emit a result
  # at all — an empty (or partial) row set here means "could not look", and the
  # caller must not be able to read it as "looked, found nothing".
  if ProbeFailures.any?
    warn "lead-time: SCAN INCOMPLETE — #{ProbeFailures.list.size} probe(s) (forge, git or Notion) " \
         "failed against #{repo}. This is NOT a measurement and MUST NOT be " \
         "recorded as \"0 outliers\" or as a clean scan:"
    ProbeFailures.list.each { |f| warn "  - #{f[:cmd]}: #{f[:detail].lines.first.to_s.strip}" }
    warn "Fix: restore forge auth for this repo and re-run (`gh auth status` / " \
         "`glab auth status`; a cron or other headless session often has no token " \
         "even though an interactive one does). For a \"window saturated\" probe, " \
         "re-run with a later --since and scan the window in slices. For a " \
         "\"notion\" probe, check the token that probe names (DND Tickets: " \
         "#{DispatchTrackers::DND.token_file}; the work tracker: #{DispatchTrackers::WORK_TOKEN_FILE}) " \
         "and Notion's status, then re-run. For a \"private-overlay\" probe, correct the key it " \
         "names in the private overlay. Until it " \
         "re-runs clean, report the scan as UNAVAILABLE, not as zero outliers."
    return 3
  end

  if as_json
    puts JSON.pretty_generate(rows)
  else
    unmeasured_n = rows.count { |r| r[:unmeasured_reason] }
    counts = slow_min ? "  slow>=#{slow_min}m: #{rows.size - unmeasured_n}  could not measure: #{unmeasured_n}" : ""
    warn "repo=#{repo}  forge=#{forge.name}#{counts}"
    rows.each { |r| print_row(r) }
  end
  0
end

def main(argv)
  opts, reason = parse_cli(argv)
  if reason
    warn "lead-time: usage error — #{reason}."
    return usage
  end
  return self_test if opts["--self-test"]

  repo = opts["--repo"]
  id = opts["--pr"] || opts["--mr"]
  since = opts["--since"]

  return usage unless repo && (id || since)

  # DND-1009: a --since that is not a date or a zoned time is refused here, at
  # argv time, before the repo or the forge is touched. It used to reach the
  # forge scan and raise a raw Time.xmlschema backtrace.
  if since
    since, why = LeadTime.parse_since(since)
    unless since
      warn "lead-time: usage error — #{why}."
      warn "Fix: pass --since as #{LeadTime::SINCE_FORMS}."
      return 2
    end
  end

  unless File.exist?(File.join(repo, ".git"))
    warn "lead-time: #{repo} is not a git worktree/checkout"
    warn "Fix: pass --repo pointing at a git checkout (e.g. ~/dev/custom, ~/dev/gen_saas, ~/dev/walt_ui)."
    return 1
  end

  forge = forge_for(repo)
  unless forge
    warn "lead-time: could not detect a supported forge from #{repo}'s origin remote"
    warn "Fix: this tool supports github.com (gh) and gitlab.com (glab) origins."
    return 1
  end

  run_scan(repo: repo, since: since, id: id, slow_min: opts["--slow"], as_json: opts.fetch("--json", false),
           meta_file: opts["--meta"], forge: forge, starts: notion_start)
end

if $PROGRAM_NAME == __FILE__
  # Inside the entry guard, so requiring this file never exits on someone
  # else's ARGV.
  if ARGV.include?("--help") || ARGV.include?("-h")
    puts <<~TXT
      Usage:
        ai/bin/lead-time --repo PATH (--pr N | --mr N | --since WHEN) [OPTIONS]

      Derive each ticket's lead time: captain dispatch (the ticket's dispatch
      date, stamped by mark-in-progress: DND Tickets' "In Progress at", or for
      a work ticket the work tracker's property named in the private overlay)
      -> fully deployed (git plus the forge's CI). It splits into `code`
      (start->landing, a harness/process lever) and `tail` (landing->deploy, a
      pipeline-efficiency lever). A row whose start or landing cannot be read
      says "could not measure" and why. Reads the notion-personal token for a
      DND start and the notion-work token for a work start.

      Options:
        --repo PATH    git checkout to scan (e.g. ~/dev/custom, ~/dev/gen_saas)
        --pr N/--mr N  one pull/merge request by number
        --since WHEN   scan every landing at or after WHEN: requests closed
                       then that landed (merged, or on GitHub closed and
                       landed by a push), and on GitHub every direct push to
                       the default branch with no PR, one row per ticket its
                       commit subjects name. WHEN is YYYY-MM-DD (00:00:00Z that
                       day) or RFC 3339 with a zone; anything else exits 2.
        --slow MIN     only report tickets slower than MIN minutes
        --json         emit JSON instead of the human table
        --meta FILE    with --since: write {scanned_through, landings, kept,
                       incomplete} to FILE. scanned_through is the newest
                       landing scanned, before --slow, so a cursor moves even
                       when no row is slow; on SCAN INCOMPLETE it stops before
                       the first landing a probe failed on (null if none).
        --help         this text

      Exit: 0 ok; 1 usage or tool error; 2 a requested PR/MR is missing, or
      --since is not a date or zoned time; 3 SCAN INCOMPLETE.
    TXT
    exit 0
  end
  exit main(ARGV)
end
