#!/usr/bin/env bash
#
# gh-athena — run `gh` (or an authenticated `git`) as the Athena GitHub App
# identity (athena-harness[bot]) instead of the repo owner. The GitHub mirror of
# `glab-athena`: writes (PRs, comments, merges, pushes) are attributed to the
# agent, not the owner, so the audit trail shows Athena.
#
# Auth uses NO personal access token. It signs a short-lived JWT with the App's
# private key, mints an installation access token (valid ~1h), and runs `gh`
# with GH_TOKEN set to it. The key is read from disk at call time, never passed
# in argv; the minted token is cached mode-0600 and re-minted when it expires.
#
# Config (create these once — see the athena GitHub App setup):
#   ~/.claude/github-athena-app-id    the App's numeric App ID
#   ~/.claude/github-athena-key.pem   the App's private key (chmod 600)
#
# Usage — exactly like `gh`, plus a `git` passthrough:
#   gh-athena pr create ...           # opens the PR as athena-harness[bot]
#   gh-athena pr merge ... / pr comment ... / api ...
#   gh-athena git push origin HEAD    # pushes over HTTPS authed as the app
#                                     # (see "The git passthrough" below)
#   gh-athena --check                 # verify config + mint a token + print the bot slug
#
# Reads may use plain `gh`; use gh-athena for anything that should be attributed
# to Athena. Pass this rule to athena-captains for PR creation and review replies.

set -euo pipefail

APP_ID_FILE="${GH_ATHENA_APP_ID_FILE:-$HOME/.claude/github-athena-app-id}"
KEY="${GH_ATHENA_KEY:-$HOME/.claude/github-athena-key.pem}"
CACHE="${GH_ATHENA_TOKEN_CACHE:-$HOME/.claude/.github-athena-token}"

die() { echo "gh-athena: $*" >&2; exit 3; }

command -v gh      >/dev/null 2>&1 || die "gh not found. Fix: install the GitHub CLI (\`gh\`)."
command -v openssl >/dev/null 2>&1 || die "openssl not found. Fix: install openssl."
command -v curl    >/dev/null 2>&1 || die "curl not found. Fix: install curl."
command -v jq      >/dev/null 2>&1 || die "jq not found. Fix: install jq."
[ -r "$APP_ID_FILE" ] || die "missing App ID at $APP_ID_FILE. Fix: echo <app-id> > $APP_ID_FILE"
[ -r "$KEY" ]         || die "missing private key at $KEY. Fix: place the GitHub App private key there and \`chmod 600\` it."

# DND-725: token checks and CLI isolation shared with glab-athena.
# shellcheck source=../lib/forge-cli-isolation.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/forge-cli-isolation.sh" \
  || die "cannot load ai/lib/forge-cli-isolation.sh. Fix: run gh-athena from a full ~/dev/custom checkout (ai/bin and ai/lib side by side)."

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

mint_token() {
  local app_id now iat exp header payload sig jwt inst_id resp tok exp_at exp_epoch
  app_id="$(cat "$APP_ID_FILE")"
  now=$(date +%s); iat=$((now - 60)); exp=$((now + 540))   # <=10min per GitHub
  header="$(printf '%s' '{"alg":"RS256","typ":"JWT"}' | b64url)"
  payload="$(printf '%s' "{\"iat\":$iat,\"exp\":$exp,\"iss\":\"$app_id\"}" | b64url)"
  sig="$(printf '%s' "$header.$payload" | openssl dgst -sha256 -sign "$KEY" -binary | b64url)" \
    || die "JWT signing failed — is $KEY a valid RSA private key?"
  jwt="$header.$payload.$sig"

  inst_id="$(curl -sS -H "Authorization: Bearer $jwt" -H "Accept: application/vnd.github+json" \
    https://api.github.com/app/installations | jq -r '.[0].id')" \
    || die "could not reach the GitHub API to list installations."
  [ -n "$inst_id" ] && [ "$inst_id" != "null" ] \
    || die "the App has no installation. Fix: install the athena GitHub App on your account/repos."

  resp="$(curl -sS -X POST -H "Authorization: Bearer $jwt" -H "Accept: application/vnd.github+json" \
    https://api.github.com/app/installations/"$inst_id"/access_tokens)"
  tok="$(printf '%s' "$resp" | jq -r '.token')"
  exp_at="$(printf '%s' "$resp" | jq -r '.expires_at')"
  [ "$tok" != "null" ] && fci_token_ok "$tok" \
    || die "installation token mint failed: $(printf '%s' "$resp" | jq -r '.message // "unknown error"')"

  exp_epoch="$(date -d "$exp_at" +%s 2>/dev/null || echo $((now + 3000)))"
  ( umask 077; printf '%s\t%s\n' "$tok" "$exp_epoch" > "$CACHE" )
  printf '%s' "$tok"
}

get_token() {
  if [ -r "$CACHE" ]; then
    local line tok exp
    line="$(cat "$CACHE")"; tok="${line%%$'\t'*}"; exp="${line##*$'\t'}"
    # A cached value that is not one token (empty, whitespace, a control
    # character) is ignored and re-minted, never handed to gh (DND-725).
    if fci_token_ok "$tok" && [ "$tok" != "$exp" ] \
       && grep -Eq '^[0-9]+$' <<<"$exp" \
       && [ "$exp" -gt "$(( $(date +%s) + 300 ))" ]; then
      printf '%s' "$tok"; return
    fi
  fi
  mint_token
}

# use_app_token : mint/read the App token, refuse one that is not a token, and
# set up gh so the owner's login is unreachable: every inherited GITHUB_* and
# GH_ENTERPRISE_TOKEN is scrubbed (GH_REPO and other non-identity GH_* are
# kept), GH_CONFIG_DIR is a fresh empty dir removed on exit, and GH_TOKEN /
# GH_HOST are ours. An empty GH_TOKEN would otherwise fall through to
# GITHUB_TOKEN and then to the owner's hosts.yml (measured; DND-725). gh must
# then run as a child, never exec, so the config dir is cleaned up.
use_app_token() {
  local tok
  tok="$(get_token)" || exit $?
  fci_require_token 3 gh-athena 'athena-harness[bot]' "the App token (cache $CACHE)" "$tok"
  fci_scrub_env '^GITHUB_|^(GH_TOKEN|GH_ENTERPRISE_TOKEN|GH_HOST|GH_CONFIG_DIR)$'
  fci_isolate gh-athena GH_CONFIG_DIR
  export GH_TOKEN="$tok" GH_HOST=github.com
}

if [ "${1:-}" = "--check" ]; then
  use_app_token
  # /app requires the JWT, not the installation token; confirm identity via the
  # installation instead (the token acting on a repo is the real proof).
  who="$(gh api /installation/repositories -q '.repositories[0].full_name' 2>/dev/null || true)"
  [ -n "$who" ] || die "token minted but could not reach installation repositories."
  echo "gh-athena: OK — authenticated as the App; installation reaches e.g. $who."
  exit 0
fi

# ---- The git passthrough (DND-389) -----------------------------------------
# `gh-athena git <args>` runs git authenticated as the App for ONE command, over
# HTTPS only: the SSH form git@github.com: is rewritten, every owner credential
# source is removed, and a network op that would still reach github.com over
# SSH or another non-HTTPS transport is REFUSED (exit 3, Fix:). The mechanism,
# its coverage and its named residuals live in ai/lib/forge-git-passthrough.sh,
# shared with `glab-athena git` (DND-393). The App token goes to git as an
# x-access-token basic-auth extraheader through the environment config channel,
# never on argv.
#
# Test seam: GH_ATHENA_GIT_DRY_RUN=1 prints the resolved URLs and the git argv
# (token redacted) instead of exec'ing git.

if [ "${1:-}" = "git" ]; then
  shift
  # shellcheck source=../lib/forge-git-passthrough.sh
  . "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/forge-git-passthrough.sh" \
    || die "cannot load ai/lib/forge-git-passthrough.sh. Fix: run gh-athena from a full ~/dev/custom checkout (ai/bin and ai/lib side by side)."
  FG_TOOL=gh-athena FG_HOST=github.com FG_BOT='athena-harness[bot]'
  FG_DRY_RUN="${GH_ATHENA_GIT_DRY_RUN:-}"
  fg_refuse_non_https "$@"
  TOKEN="$(get_token)"   # an assignment, so a mint failure stops here (set -e)
  fci_require_token 3 gh-athena 'athena-harness[bot]' "the App token (cache $CACHE)" "$TOKEN"
  fg_git_exec x-access-token "$TOKEN" "$@"
fi

# ---- The merge guard (DND-609) ---------------------------------------------
# `pr merge --auto` is REFUSED unless the PR's base branch has a READABLE,
# non-empty required-checks set (on a free private repo it has none, and --auto
# merges immediately). A non-auto `pr merge` is REFUSED unless it pins the head
# with --match-head-commit <sha> and every check on that head is green. A
# `gh api` call that merges (REST …/pulls/<n>/merge, …/merges, …/merge-upstream;
# GraphQL mergePullRequest / enablePullRequestAutoMerge / enqueuePullRequest /
# mergeBranch) is REFUSED outright, with no reads (DND-728). So is a `gh api`
# write that creates or moves a ref on any branch (REST …/git/refs, …/contents/…,
# …/branches/<b>/rename, …/pulls/<n>/update-branch; GraphQL createCommitOnBranch,
# createRef, updateRef, updateRefs and siblings), DND-741: branches move only by
# `gh-athena git push`. The mechanism, its coverage, the scope decision and the
# named residuals live in ai/lib/gh-merge-guard.sh.
#
# Test seam: GH_ATHENA_MERGE_DRY_RUN=1 runs the guard (reads only) and then
# prints the command instead of exec'ing gh, for ANY command.

# Isolation comes first so the guard's own gh reads run as the App, with the
# same (empty) alias set the final gh sees.
use_app_token
# shellcheck source=../lib/gh-merge-guard.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/gh-merge-guard.sh" \
  || die "cannot load ai/lib/gh-merge-guard.sh. Fix: run gh-athena from a full ~/dev/custom checkout (ai/bin and ai/lib side by side)."
GMG_TOOL=gh-athena
gmg_guard "$@"
if [ -n "${GH_ATHENA_MERGE_DRY_RUN:-}" ]; then
  printf 'gh-athena: dry-run: would exec gh %s\n' "$*"
  exit 0
fi
# A child, not exec: fci_isolate's trap removes the config dir when gh exits.
rc=0
gh "$@" || rc=$?
exit "$rc"
