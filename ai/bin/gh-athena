#!/usr/bin/env bash
#
# gh-athena — run `gh` (or an authenticated `git`) as the Athena GitHub App
# identity (athena-harness[bot]) instead of the repo owner. The GitHub mirror of
# `glab-athena`: writes (PRs, comments, merges, pushes) are attributed to the
# agent, not the owner, so the audit trail shows Athena.
#
# Auth uses NO personal access token. It signs a short-lived JWT with the App's
# private key, mints an installation access token (valid ~1h), and runs `gh`
# with GH_TOKEN set to it. The key is read from disk at call time, never passed
# in argv; the minted token is cached mode-0600 and re-minted when it expires.
#
# Config (create these once — see the athena GitHub App setup):
#   ~/.claude/github-athena-app-id    the App's numeric App ID
#   ~/.claude/github-athena-key.pem   the App's private key (chmod 600)
#
# Usage — exactly like `gh`, plus a `git` passthrough:
#   gh-athena pr create ...           # opens the PR as athena-harness[bot]
#   gh-athena pr merge ... / pr comment ... / api ...
#   gh-athena git push origin HEAD    # pushes over HTTPS authed as the app
#                                     # (see "The git passthrough" below)
#   gh-athena --check                 # verify config + mint a token + print the bot slug
#
# Reads may use plain `gh`; use gh-athena for anything that should be attributed
# to Athena. Pass this rule to athena-captains for PR creation and review replies.

set -euo pipefail

APP_ID_FILE="${GH_ATHENA_APP_ID_FILE:-$HOME/.claude/github-athena-app-id}"
KEY="${GH_ATHENA_KEY:-$HOME/.claude/github-athena-key.pem}"
CACHE="${GH_ATHENA_TOKEN_CACHE:-$HOME/.claude/.github-athena-token}"

die() { echo "gh-athena: $*" >&2; exit 3; }

command -v gh      >/dev/null 2>&1 || die "gh not found. Fix: install the GitHub CLI (\`gh\`)."
command -v openssl >/dev/null 2>&1 || die "openssl not found. Fix: install openssl."
command -v curl    >/dev/null 2>&1 || die "curl not found. Fix: install curl."
command -v jq      >/dev/null 2>&1 || die "jq not found. Fix: install jq."
[ -r "$APP_ID_FILE" ] || die "missing App ID at $APP_ID_FILE. Fix: echo <app-id> > $APP_ID_FILE"
[ -r "$KEY" ]         || die "missing private key at $KEY. Fix: place the GitHub App private key there and \`chmod 600\` it."

b64url() { openssl base64 -A | tr '+/' '-_' | tr -d '='; }

mint_token() {
  local app_id now iat exp header payload sig jwt inst_id resp tok exp_at exp_epoch
  app_id="$(cat "$APP_ID_FILE")"
  now=$(date +%s); iat=$((now - 60)); exp=$((now + 540))   # <=10min per GitHub
  header="$(printf '%s' '{"alg":"RS256","typ":"JWT"}' | b64url)"
  payload="$(printf '%s' "{\"iat\":$iat,\"exp\":$exp,\"iss\":\"$app_id\"}" | b64url)"
  sig="$(printf '%s' "$header.$payload" | openssl dgst -sha256 -sign "$KEY" -binary | b64url)" \
    || die "JWT signing failed — is $KEY a valid RSA private key?"
  jwt="$header.$payload.$sig"

  inst_id="$(curl -sS -H "Authorization: Bearer $jwt" -H "Accept: application/vnd.github+json" \
    https://api.github.com/app/installations | jq -r '.[0].id')" \
    || die "could not reach the GitHub API to list installations."
  [ -n "$inst_id" ] && [ "$inst_id" != "null" ] \
    || die "the App has no installation. Fix: install the athena GitHub App on your account/repos."

  resp="$(curl -sS -X POST -H "Authorization: Bearer $jwt" -H "Accept: application/vnd.github+json" \
    https://api.github.com/app/installations/"$inst_id"/access_tokens)"
  tok="$(printf '%s' "$resp" | jq -r '.token')"
  exp_at="$(printf '%s' "$resp" | jq -r '.expires_at')"
  [ -n "$tok" ] && [ "$tok" != "null" ] \
    || die "installation token mint failed: $(printf '%s' "$resp" | jq -r '.message // "unknown error"')"

  exp_epoch="$(date -d "$exp_at" +%s 2>/dev/null || echo $((now + 3000)))"
  ( umask 077; printf '%s\t%s\n' "$tok" "$exp_epoch" > "$CACHE" )
  printf '%s' "$tok"
}

get_token() {
  if [ -r "$CACHE" ]; then
    local line tok exp
    line="$(cat "$CACHE")"; tok="${line%%$'\t'*}"; exp="${line##*$'\t'}"
    if [ -n "$tok" ] && [ "$tok" != "$exp" ] \
       && grep -Eq '^[0-9]+$' <<<"$exp" \
       && [ "$exp" -gt "$(( $(date +%s) + 300 ))" ]; then
      printf '%s' "$tok"; return
    fi
  fi
  mint_token
}

if [ "${1:-}" = "--check" ]; then
  tok="$(get_token)"
  slug="$(GH_TOKEN="$tok" gh api /app -q .slug 2>/dev/null || true)"
  # /app requires the JWT, not the installation token; confirm identity via the
  # installation instead (the token acting on a repo is the real proof).
  who="$(GH_TOKEN="$tok" gh api /installation/repositories -q '.repositories[0].full_name' 2>/dev/null || true)"
  [ -n "$who" ] || die "token minted but could not reach installation repositories."
  echo "gh-athena: OK — authenticated as the App; installation reaches e.g. $who."
  exit 0
fi

# ---- The git passthrough (DND-389) -----------------------------------------
# `gh-athena git <args>` runs git authenticated as the App for ONE command. The
# App token only reaches git over HTTPS (an http.https://github.com/.extraheader),
# so everything else about the command must keep the owner's identity OUT:
#
#   * url.https://github.com/.insteadOf=git@github.com:  — an SSH-form remote
#     (the default a `git clone git@github.com:...` leaves) is rewritten to HTTPS,
#     so the plain `gh-athena git push origin HEAD` is correct by default. Without
#     it the push goes over SSH with the OWNER's key and GitHub records CJPoll.
#   * credential.helper= (empty resets the list, URL-scoped helpers included),
#     core.askPass= , GIT_ASKPASS/SSH_ASKPASS unset, GIT_TERMINAL_PROMPT=0 — no
#     fallback source of the owner's credentials; a bot-auth failure FAILS.
#   * git_refuse_non_https: before exec, for the network subcommands it knows —
#     push, fetch, pull, ls-remote, clone, remote update, submodule, subtree
#     push/pull/add, and git aliases that expand to them — every URL the command
#     would reach is resolved (rewrite applied, pushurl and pushInsteadOf
#     included, submodule URLs when it recurses) and the command is REFUSED if
#     any still reaches github.com over SSH or another non-HTTPS transport
#     (ssh://, git://, http://, a pushurl override, an insteadOf that forces
#     SSH). A shell alias (`!...`) and a push that recurses into submodules are
#     refused outright. A refusal is exit 3 with a Fix: line.
#
# Test seam: GH_ATHENA_GIT_DRY_RUN=1 runs the resolution and refusal, then prints
# the resolved URLs and the git argv (token redacted) instead of exec'ing git.
# Residual (NOT checked; each still runs): an ~/.ssh/config Host alias for
# github.com (`myalias:owner/repo`); ext:: transports; `clone
# --recurse-submodules` (the submodule URLs are unknown until the clone lands);
# git-lfs transfers; third-party `git-<name>` subcommands; any subcommand not
# named above.

GH_HTTPS_REWRITE='url.https://github.com/.insteadOf=git@github.com:'

# url_host_scheme <url> -> "<scheme> <host>" (lowercased); empty for a local path.
url_host_scheme() {
  local url="$1" scheme rest hostport host
  case "$url" in
    /*|./*|../*|\~*|file://*) return 0 ;;
    *://*)
      scheme="${url%%://*}"; rest="${url#*://}"; hostport="${rest%%/*}"
      host="${hostport##*@}"; host="${host%%:*}" ;;
    *:*)
      # scp-like [user@]host:path — only when no '/' precedes the first ':'.
      hostport="${url%%:*}"
      case "$hostport" in */*) return 0 ;; esac
      scheme=ssh; host="${hostport##*@}" ;;
    *) return 0 ;;
  esac
  printf '%s %s' "$(tr 'A-Z' 'a-z' <<<"$scheme")" "$(tr 'A-Z' 'a-z' <<<"$host")"
}

# reaches_github_insecurely <url> : true when <url> targets github.com (or a
# subdomain) over anything but https.
reaches_github_insecurely() {
  local sh scheme host
  sh="$(url_host_scheme "$1")"
  [ -n "$sh" ] || return 1
  scheme="${sh%% *}"; host="${sh#* }"
  case "$host" in github.com|*.github.com) ;; *) return 1 ;; esac
  [ "$scheme" != "https" ]
}

git_refuse() {
  # $1 subcommand, $2 what (remote name or literal), $3 resolved url
  cat >&2 <<EOF
gh-athena: REFUSING \`git $1\`: '$2' resolves to $3, which reaches github.com over SSH or another non-HTTPS transport.
  The App token only authenticates HTTPS, so this would run as the machine OWNER (CJPoll), not athena-harness[bot].
  Fix: push to the HTTPS URL instead — \`~/dev/custom/ai/bin/gh-athena git $1 https://github.com/<owner>/<repo>.git <refspec>\` — or point the remote at https://github.com/<owner>/<repo>.git or git@github.com:<owner>/<repo>.git (the wrapper rewrites that form); drop any ssh:// pushurl override or global insteadOf/pushInsteadOf that forces SSH. Do not work around this with a plain \`git push\` or the owner's credentials; if it cannot be done as Athena, escalate to your admiral with the command + error and wait (athena:github -> "When a forge write can't be done as Athena").
EOF
  exit 3
}

git_refuse_shell_alias() {
  cat >&2 <<EOF
gh-athena: REFUSING \`git $1\`: it is a shell alias ('$2'), which can run any command, so gh-athena cannot check which remote it reaches or which identity it pushes as.
  Fix: run the underlying git command directly through the wrapper — \`~/dev/custom/ai/bin/gh-athena git <the expanded command>\`. If it cannot be done as Athena, do not work around this; escalate to your admiral with the command + error and wait (athena:github -> "When a forge write can't be done as Athena").
EOF
  exit 3
}

git_refuse_unchecked() {
  cat >&2 <<EOF
gh-athena: REFUSING \`git $1\`: $2, so it could reach github.com as the machine OWNER (CJPoll) unchecked.
  Fix: push the superproject and each submodule separately, each through \`~/dev/custom/ai/bin/gh-athena git -C <repo> push …\` (drop --recurse-submodules / push.recurseSubmodules). If it cannot be done as Athena, do not work around this; escalate to your admiral with the command + error and wait (athena:github -> "When a forge write can't be done as Athena").
EOF
  exit 3
}

# git_refuse_non_https <git args...> : resolve every URL the network op would
# reach and refuse on the first one that goes to github.com over non-HTTPS.
# Sets RESOLVED_URLS (newline-separated) for the dry-run report.
RESOLVED_URLS=""
git_refuse_non_https() {
  local -a glob=()
  while [ $# -gt 0 ]; do
    case "$1" in
      -C|-c|--git-dir|--work-tree|--namespace|--config-env|--super-prefix)
        [ $# -ge 2 ] || return 0; glob+=("$1" "$2"); shift 2 ;;
      -*) glob+=("$1"); shift ;;
      *) break ;;
    esac
  done
  [ $# -gt 0 ] || return 0
  local sub="$1" mode depth=0 alias_val; shift

  G() { git "${glob[@]}" -c "$GH_HTTPS_REWRITE" "$@"; }

  # Expand git aliases (`alias.p=push`) the way git would, so an alias cannot
  # carry a network op past the check. A shell alias (`!...`) can run anything,
  # so it is refused outright rather than guessed at.
  while [ "$depth" -lt 10 ]; do
    case "$sub" in push|fetch|pull|ls-remote|clone|remote|submodule|subtree) break ;; esac
    alias_val="$(G config --get "alias.$sub" 2>/dev/null || true)"
    [ -n "$alias_val" ] || break
    case "$alias_val" in
      '!'*) git_refuse_shell_alias "$sub" "$alias_val" ;;
    esac
    local -a ex=(); read -ra ex <<<"$alias_val"
    sub="${ex[0]}"; set -- "${ex[@]:1}" "$@"
    depth=$((depth + 1))
  done

  local recurse=0 a0
  for a0 in "$@"; do
    case "$a0" in --recurse-submodules|--recurse-submodules=yes|--recurse-submodules=on-demand|--recurse-submodules=only) recurse=1 ;; esac
  done
  case "$sub" in
    push)
      mode=push
      # A recursive push pushes each submodule through ITS OWN remote config,
      # which this check does not inspect: refuse rather than half-check.
      case "$(G config --get push.recurseSubmodules 2>/dev/null || true)" in on-demand|only) recurse=1 ;; esac
      [ "$recurse" = 1 ] && git_refuse_unchecked push "--recurse-submodules pushes each submodule through its own remote, which gh-athena does not inspect" ;;
    fetch|pull|ls-remote|clone) mode=fetch ;;
    remote) [ "${1:-}" = update ] || return 0; mode=fetch ;;
    submodule) mode=fetch; recurse=1 ;;
    subtree)
      case "${1:-}" in
        push) mode=push ;;
        pull|add) mode=fetch ;;
        *) return 0 ;;
      esac
      shift ;;
    *) return 0 ;;
  esac

  local -a remotes=()
  mapfile -t remotes < <(G remote 2>/dev/null || true)
  is_remote() { local r; for r in "${remotes[@]}"; do [ "$r" = "$1" ] && return 0; done; return 1; }

  # Walk the subcommand's args: options that take a separate value are skipped
  # with it; the first remaining positional is the repository. Independently,
  # EVERY token that names a configured remote or mentions github.com is also
  # checked, so a mis-parsed option value can only add a check, never drop one.
  local -a targets=() ; local positional="" all=0 has_repo=0 a takes_value
  if [ "$sub" = submodule ]; then
    # Every submodule URL (config after `submodule init`, and .gitmodules).
    # Relative URLs (./ ../) resolve against the superproject's remote, which
    # the default-remote check below covers.
    local top m
    top="$(G rev-parse --show-toplevel 2>/dev/null || true)"
    while read -r _ m; do
      case "$m" in ./*|../*|'') ;; *) targets+=("$m") ;; esac
    done < <({ G config --get-regexp '^submodule\..*\.url$' 2>/dev/null
               [ -n "$top" ] && [ -f "$top/.gitmodules" ] \
                 && G config -f "$top/.gitmodules" --get-regexp '^submodule\..*\.url$' 2>/dev/null; } || true)
    set --   # submodule's own args name paths, not repositories
  fi
  if [ "$mode" = push ]; then
    takes_value='^(-o|--push-option|--receive-pack|--exec|--repo|-P|--prefix|-m|--message)$'
  else
    takes_value='^(-P|--prefix|-m|--message|-o|--upload-pack|-j|--jobs|--depth|--deepen|--shallow-since|--shallow-exclude|--refmap|--server-option|--negotiation-tip|-s|--strategy|-X|--strategy-option|--origin|-b|--branch|-u|--reference|--reference-if-able|--separate-git-dir|-c|--config|--template|--filter|--bundle-uri|--ref-format)$'
  fi
  local dd=0
  while [ $# -gt 0 ]; do
    a="$1"; shift
    if [ "$dd" = 0 ]; then
      case "$a" in
        --) dd=1; continue ;;
        --all|--multiple) [ "$mode" = fetch ] && all=1 ;;
        --repo=*) has_repo=1; targets+=("${a#--repo=}") ;;
      esac
      if [[ "$a" =~ $takes_value ]]; then
        [ "$a" = --repo ] && [ $# -gt 0 ] && { has_repo=1; targets+=("$1"); }
        [ $# -gt 0 ] && { is_remote "$1" || [[ "$1" == *github.com* ]]; } && targets+=("$1")
        [ $# -gt 0 ] && shift
        continue
      fi
      case "$a" in -*) continue ;; esac
    fi
    if [ -z "$positional" ]; then positional="$a"; targets+=("$a")
    elif is_remote "$a" || [[ "$a" == *github.com* ]]; then targets+=("$a"); fi
  done
  [ "$sub" = remote ] && all=1
  [ "$all" = 1 ] && targets+=("${remotes[@]}")
  # fetch/pull --recurse-submodules (or the config that implies it) also
  # fetches every submodule: check their URLs too.
  if [ "$mode" = fetch ] && [ "$sub" != submodule ] && [ "$sub" != clone ]; then
    case "$(G config --get fetch.recurseSubmodules 2>/dev/null || true)$(G config --get submodule.recurse 2>/dev/null || true)" in
      *true*|*yes*|*on-demand*) recurse=1 ;;
    esac
    if [ "$recurse" = 1 ]; then
      local _k m2
      while read -r _k m2; do
        case "$m2" in ./*|../*|'') ;; *) targets+=("$m2") ;; esac
      done < <(G config --get-regexp '^submodule\..*\.url$' 2>/dev/null || true)
    fi
  fi

  if [ -z "$positional" ] && [ "$all" = 0 ] && [ "$has_repo" = 0 ] && [ "$sub" != clone ] && [ "$sub" != subtree ]; then
    # Default remote, as git resolves it: pushRemote / pushDefault (push only),
    # then branch.<cur>.remote, then origin.
    local cur def=""
    cur="$(G symbolic-ref -q --short HEAD 2>/dev/null || true)"
    if [ "$mode" = push ]; then
      [ -n "$cur" ] && def="$(G config --get "branch.$cur.pushRemote" 2>/dev/null || true)"
      [ -n "$def" ] || def="$(G config --get remote.pushDefault 2>/dev/null || true)"
    fi
    [ -n "$def" ] || { [ -n "$cur" ] && def="$(G config --get "branch.$cur.remote" 2>/dev/null || true)"; }
    [ -n "$def" ] || def=origin
    targets+=("$def")
  fi

  local t u ; local -a urls
  for t in "${targets[@]}"; do
    urls=()
    if is_remote "$t"; then
      if [ "$mode" = push ]; then mapfile -t urls < <(G remote get-url --push --all "$t" 2>/dev/null || true)
      else mapfile -t urls < <(G remote get-url --all "$t" 2>/dev/null || true); fi
    else
      # A URL literal (or an unknown name: git treats it as a URL). Apply
      # pushInsteadOf (push only, longest prefix wins), else insteadOf.
      local rewritten="" best=0 key base prefix
      if [ "$mode" = push ]; then
        while read -r key prefix; do
          base="${key#url.}"; base="${base%.pushinsteadof}"
          if [ -n "$prefix" ] && [[ "$t" == "$prefix"* ]] && [ "${#prefix}" -gt "$best" ]; then
            best="${#prefix}"; rewritten="$base${t#"$prefix"}"
          fi
        done < <(G config --get-regexp '^url\..*\.pushinsteadof$' 2>/dev/null || true)
      fi
      [ -n "$rewritten" ] || rewritten="$(G ls-remote --get-url "$t" 2>/dev/null || printf '%s' "$t")"
      urls=("$rewritten")
    fi
    for u in "${urls[@]}"; do
      [ -n "$u" ] || continue
      RESOLVED_URLS+="$u"$'\n'
      reaches_github_insecurely "$u" && git_refuse "$sub" "$t" "$u"
    done
  done
  return 0
}

if [ "${1:-}" = "git" ]; then
  shift
  git_refuse_non_https "$@"
  TOKEN="$(get_token)"
  # HTTPS git authenticated as the app: x-access-token:<token> basic auth.
  AUTH="AUTHORIZATION: basic $(printf 'x-access-token:%s' "$TOKEN" | openssl base64 -A)"
  set -- -c credential.helper= -c core.askPass= -c "$GH_HTTPS_REWRITE" \
    -c "http.https://github.com/.extraheader=$AUTH" "$@"
  if [ "${GH_ATHENA_GIT_DRY_RUN:-}" = 1 ]; then
    printf '%s' "$RESOLVED_URLS" | sed 's/^/gh-athena: dry-run: url /'
    printf 'gh-athena: dry-run: exec git'
    for a in "$@"; do
      case "$a" in http.https://github.com/.extraheader=*) a="http.https://github.com/.extraheader=AUTHORIZATION: basic <x-access-token:REDACTED>" ;; esac
      printf ' [%s]' "$a"
    done
    printf '\n'
    exit 0
  fi
  exec env -u GIT_ASKPASS -u SSH_ASKPASS GIT_TERMINAL_PROMPT=0 git "$@"
fi

TOKEN="$(get_token)"
exec env GH_TOKEN="$TOKEN" GH_HOST=github.com gh "$@"
