#!/usr/bin/env bash
# integration-gate -- the stable ai/bin entry point for
# ai/skills/athena:merge-boarding/scripts/integration-gate.
#
# The real script lives beside the skill that owns its procedure. But admirals,
# captains, critic-review's Fix: text and test-slot all call it by bare name,
# and a brief that wrote `~/dev/custom/ai/bin/integration-gate` got exit 127
# ("No such file or directory") four times across two fleet runs: dnd-405, dnd-487
# (2026-09-22-harness-gensaas-api), DND-558 and the DND-804 admiral
# (2026-09-24-harness-epics-ab). DND-752.
#
# This is a shim, not a symlink: the real script finds test-slot through its
# own checkout's git common dir and critic-review beside its own BASH_SOURCE,
# so it must run from its own path. It forwards argv and stdin unchanged,
# `--help` included.
#
# Which copy judges (DND-1796): in ~/dev/custom gating ~/dev/custom, the real
# script reads the integration TARGET's ai/ tree out of git and re-executes the
# target's copy of itself, so the gate, its libs, blast-radius, its manifest,
# the owner verifiers and critic-review are the target's, whichever checkout
# this shim is in. That step runs in the copy started, so name THIS path in the
# main checkout, ~/dev/custom/ai/bin/integration-gate, in a brief: it is landed
# code, while a worktree's copy is whatever its branch holds.
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REAL="${HERE}/../skills/athena:merge-boarding/scripts/integration-gate"

if [ ! -x "${REAL}" ]; then
  echo "integration-gate: the real script is missing or not executable: ${REAL}" >&2
  echo "Fix: run ~/dev/custom/ai/bin/integration-gate (the main checkout's shim, landed code), or call ~/dev/custom/ai/skills/athena:merge-boarding/scripts/integration-gate directly." >&2
  exit 127
fi

exec "${REAL}" "$@"
