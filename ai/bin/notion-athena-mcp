#!/bin/sh
# Launch Notion's official MCP server as the "Athena" integration.
# Reads the token at launch so it never sits in ~/.claude.json or argv.
#
# The server version is PINNED (DND-1543): an unpinned `npx -y` takes whatever
# is newest, and the 2.5.x line once dropped the Notion-Version header (DND-1449)
# with no diff here and no test run. To bump on purpose:
#   1. Edit NOTION_MCP_SERVER_VERSION below to the new exact x.y.z.
#   2. Run: bash ai/test/notion-athena-mcp/self-test.sh  (must pass).
#   3. Check the new server still sends Notion-Version on create-a-comment, or
#      that the DND-1449 shim still covers it. Commit the bump on its own.
NOTION_MCP_SERVER_VERSION="2.5.2"
set -eu
TOKEN_FILE="${NOTION_ATHENA_TOKEN_FILE:-$HOME/.claude/notion-api-token}"
[ -r "$TOKEN_FILE" ] || {
  echo "notion-athena-mcp: token file $TOKEN_FILE missing/unreadable" >&2
  echo "Fix: this is owner-gated -- ask the owner to place the Athena integration token there (or set NOTION_ATHENA_TOKEN_FILE); never mint or rotate one yourself" >&2
  exit 1
}
NOTION_TOKEN="$(tr -d '[:space:]' < "$TOKEN_FILE")"
export NOTION_TOKEN

# node/npx here are asdf shims. When Claude Code launches this MCP server there
# is no .tool-versions in scope, so the shim aborts with "No version is set" and
# the server dies at startup — surfaced as CONNECTION_CLOSED. If nothing has
# selected a Node, pin the newest asdf-installed nodejs so the shim resolves.
# An inherited ASDF_NODEJS_VERSION or a .tool-versions in scope still wins.
if [ -z "${ASDF_NODEJS_VERSION:-}" ] && ! npx -v >/dev/null 2>&1; then
  _nodedir="${ASDF_DATA_DIR:-$HOME/.asdf}/installs/nodejs"
  if [ -d "$_nodedir" ]; then
    _ver="$(for _d in "$_nodedir"/*/; do [ -d "$_d" ] && basename "$_d"; done | sort -V | tail -n1)"
    [ -n "$_ver" ] && export ASDF_NODEJS_VERSION="$_ver"
  fi
fi

# DND-1449: server 2.5.x sends Notion-Version only on the page-markdown tools,
# so create-a-comment fails 400 missing_version. Preload a shim that adds the
# spec's default version to any Notion request that carries none. A missing
# shim must fail loud: a silent skip is the bug coming back.
SHIM="$(cd "$(dirname "$0")" && pwd)/../lib/notion-version-shim.cjs"
[ -r "$SHIM" ] || {
  echo "notion-athena-mcp: $SHIM missing/unreadable" >&2
  echo "Fix: restore ai/lib/notion-version-shim.cjs from version control; without it every comment call fails 400 missing_version (DND-1449)" >&2
  exit 1
}
export NODE_OPTIONS="--require $SHIM${NODE_OPTIONS:+ $NODE_OPTIONS}"

exec npx -y "@notionhq/notion-mcp-server@${NOTION_MCP_SERVER_VERSION}"
