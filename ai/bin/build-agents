#!/usr/bin/env ruby
# frozen_string_literal: true

# build-agents — expand shared blocks into the athena-* agent definitions.
#
# Source of truth:
#   ai/agents/athena-<Name>.md.in   — per-agent template (own content + @include lines)
#   ai/blocks/**/*.md               — shared blocks (each fact in exactly one place)
#   ai/blocks/routing.yml           — which agent MUST carry which block / preloaded skill
#
# Output:
#   ai/agents/athena-<Name>.md      — GENERATED; do not hand-edit
#
# Deliberately gem-free (stdlib yaml/set only) and run with bare `ruby`, so it
# never touches a Bundler environment.
#
# Usage:
#   ai/bin/build-agents            build + lint into ai/agents/
#   ai/bin/build-agents --install  also copy generated defs to ~/.claude/agents/
#   ai/bin/build-agents --check    lint + verify ai/agents/ is up to date (writes nothing)

require "yaml"
require "set"
require "fileutils"

AI_DIR      = File.expand_path("..", __dir__)
BLOCKS_DIR  = File.join(AI_DIR, "blocks")
AGENTS_DIR  = File.join(AI_DIR, "agents")
ROUTING     = File.join(BLOCKS_DIR, "routing.yml")
INSTALL_DIR = File.expand_path("~/.claude/agents")

INCLUDE_RE = /^@include[ \t]+(\S+)[ \t]*$/.freeze

# Checked BEFORE anything else: the default action REWRITES every
# ai/agents/*.md, so a fall-through here is a silent mutation of the harness.
if ARGV.include?("--help") || ARGV.include?("-h")
  puts <<~TXT
    Usage:
      ai/bin/build-agents            build + lint the agent definitions into
                                     ai/agents/ (REWRITES the generated .md files)
      ai/bin/build-agents --install  also copy generated defs to ~/.claude/agents/
      ai/bin/build-agents --check    lint + verify ai/agents/ is up to date
                                     (writes nothing)
      ai/bin/build-agents --help     this text

    Edit the .md.in templates and ai/blocks/**, never a generated .md.
  TXT
  exit 0
end

require_relative "../lib/strict_argv"

# Parsed BEFORE any read or write, for the same reason --help is: an argument
# this tool does not recognise must never fall through to the rewriting
# default (DND-526). Every argument must be a declared flag.
CLI_SPEC = { "--install" => :switch, "--check" => :switch }.freeze

# -> [opts, nil] on success, [nil, reason] on a usage error.
def parse_cli(argv)
  opts = StrictArgv.parse(argv, CLI_SPEC)
  if opts["--check"] && opts["--install"]
    return [nil, "--check writes nothing and --install writes ~/.claude/agents; pass one"]
  end

  [opts, nil]
rescue StrictArgv::UsageError => e
  [nil, e.message]
end

cli, reason = parse_cli(ARGV)
if reason
  warn "build-agents: usage error — #{reason}."
  warn "  Fix: re-run with only the flags `ai/bin/build-agents --help` lists: no " \
       "argument (build), --check (verify, writes nothing), or --install. An " \
       "unrecognised argument is refused, not ignored: ignoring it would run " \
       "the default, which REWRITES ai/agents/*.md."
  exit 2
end
install = cli.fetch("--install", false)
check   = cli.fetch("--check", false)

errors = []
def die(errors)
  warn "build-agents: FAILED"
  errors.each { |e| warn "  - #{e}" }
  warn "  Fix: edit the offending ai/agents/*.md.in template or ai/blocks/** " \
       "(and ai/agents/routing.yml if it is a routing error), then rerun " \
       "ai/bin/build-agents to regenerate the .md files."
  exit 1
end

# ---- load routing manifest --------------------------------------------------
manifest = YAML.safe_load(File.read(ROUTING))
block_consumers = manifest.fetch("blocks", {})   # "arch/5-bucket" => ["Architect", ...]
skill_consumers = manifest.fetch("skills", {}) || {}

# name => "ai/agents/athena-<name>.md.in"
template_path = ->(name) { File.join(AGENTS_DIR, "athena-#{name}.md.in") }

# ---- read every template, capturing frontmatter, body, and its @includes ----
templates = {} # name => {fm_raw:, fm:, body:, includes:[]}
Dir[File.join(AGENTS_DIR, "athena-*.md.in")].sort.each do |path|
  name = File.basename(path).sub(/\Aathena-/, "").sub(/\.md\.in\z/, "")
  raw  = File.read(path)
  m = raw.match(/\A---\n(.*?)\n---\n(.*)\z/m)
  unless m
    errors << "#{File.basename(path)}: missing or malformed YAML frontmatter"
    next
  end
  fm_raw, body = m[1], m[2]
  fm = begin
    YAML.safe_load(fm_raw) || {}
  rescue Psych::SyntaxError => e
    errors << "#{File.basename(path)}: frontmatter is not valid YAML (#{e.message})"
    {}
  end
  includes = body.scan(INCLUDE_RE).flatten
  templates[name] = { path: path, fm_raw: fm_raw, fm: fm, body: body, includes: includes }
end

die(errors) unless errors.empty?
die(["no templates found in #{AGENTS_DIR} (expected athena-*.md.in)"]) if templates.empty?

# ---- lint: includes resolve, routing is honored exactly ---------------------
block_files = Dir[File.join(BLOCKS_DIR, "**", "*.md")]
              .map { |p| p.sub("#{BLOCKS_DIR}/", "").sub(/\.md\z/, "") }
              .to_set

# dangling @includes + duplicate @includes within a template
templates.each do |name, t|
  t[:includes].each do |blk|
    errors << "#{name}: @include #{blk} — no such block (ai/blocks/#{blk}.md)" unless block_files.include?(blk)
  end
  dups = t[:includes].group_by(&:itself).select { |_, v| v.size > 1 }.keys
  dups.each { |blk| errors << "#{name}: @include #{blk} appears more than once" }
end

# routing: required vs actual includes
actual = Hash.new { |h, k| h[k] = Set.new }
templates.each { |name, t| t[:includes].each { |blk| actual[name] << blk } }

block_consumers.each do |blk, agents|
  errors << "routing.yml: block '#{blk}' has no block file (ai/blocks/#{blk}.md)" unless block_files.include?(blk)
  Array(agents).each do |agent|
    unless templates.key?(agent)
      errors << "routing.yml: block '#{blk}' lists unknown agent '#{agent}' (no #{File.basename(template_path.call(agent))})"
      next
    end
    errors << "#{agent}: routing.yml requires @include #{blk}, but the template does not include it" unless actual[agent].include?(blk)
  end
end

# no template may include a block it is not listed for
expected = Hash.new { |h, k| h[k] = Set.new }
block_consumers.each { |blk, agents| Array(agents).each { |a| expected[a] << blk } }
templates.each do |name, _t|
  (actual[name] - expected[name]).each do |blk|
    errors << "#{name}: @include #{blk} is not authorized by routing.yml (add it there, or remove the include)"
  end
end

# orphan blocks: a block file no manifest entry consumes
(block_files - block_consumers.keys.to_set).each do |blk|
  errors << "orphan block ai/blocks/#{blk}.md — nothing in routing.yml consumes it"
end

# preloaded-skill coverage (no-op until skills: is populated)
skill_consumers.each do |skill, agents|
  Array(agents).each do |agent|
    next unless templates.key?(agent)
    listed = Array(templates[agent][:fm]["skills"])
    errors << "#{agent}: routing.yml requires preloaded skill '#{skill}' in its skills: frontmatter" unless listed.include?(skill)
  end
end

die(errors) unless errors.empty?

# ---- expand + write ---------------------------------------------------------
def warning(name)
  <<~HTML.chomp
    <!-- GENERATED by ai/bin/build-agents — DO NOT EDIT.
         Edit the template ai/agents/athena-#{name}.md.in or the shared blocks in
         ai/blocks/**, then re-run ai/bin/build-agents. -->
  HTML
end

stale = []
templates.each do |name, t|
  expanded = t[:body].gsub(INCLUDE_RE) { File.read(File.join(BLOCKS_DIR, "#{Regexp.last_match(1)}.md")).chomp }
  out = "---\n#{t[:fm_raw]}\n---\n\n#{warning(name)}\n\n#{expanded.sub(/\A\n+/, '')}"
  out += "\n" unless out.end_with?("\n")

  dest = File.join(AGENTS_DIR, "athena-#{name}.md")
  current = File.exist?(dest) ? File.read(dest) : nil
  if current == out
    puts "  = athena-#{name}.md (up to date)"
  elsif check
    stale << "athena-#{name}.md is out of date — run ai/bin/build-agents"
  else
    File.write(dest, out)
    puts "  ✓ wrote athena-#{name}.md"
  end
end

die(stale) unless stale.empty?

# ---- install ----------------------------------------------------------------
if install
  FileUtils.mkdir_p(INSTALL_DIR)
  templates.each_key do |name|
    src  = File.join(AGENTS_DIR, "athena-#{name}.md")
    dest = File.join(INSTALL_DIR, "athena-#{name}.md")
    # The install target is hardlinked to the source here (same device+inode),
    # so a copy would be onto itself — FileUtils.cp raises "same file". When
    # they already resolve to the same file the install is a no-op: the build
    # that just rewrote src also updated dest. Only copy when they differ.
    if File.identical?(src, dest)
      puts "  = athena-#{name}.md already installed (same file)"
    else
      FileUtils.cp(src, dest)
      puts "  → installed athena-#{name}.md to #{INSTALL_DIR}"
    end
  end
end

puts "build-agents: OK (#{templates.size} agents, #{block_files.size} blocks)"
