#!/usr/bin/ruby
# frozen_string_literal: true

# lead-time-repos -- the one resolver for the lead-time repo list (DND-1526).
# Prints which repos this machine's lead-time loop works, in which mode, from
# which file, and which configured repos it skipped because their checkout is
# not on this machine.
#
# Buckets: FRAMEWORK (argv, output) here; MANAGER and SIDE EFFECTS in
# ai/lib/lead_time_config_io.rb; DOMAIN in ai/lib/lead_time_config.rb.
# Read-only: it writes nothing.

require "json"
require_relative "../lib/strict_argv"
require_relative "../lib/lead_time_config"
require_relative "../lib/lead_time_config_io"

AI_DIR = File.expand_path("..", __dir__)

HELP = <<~TXT
  Usage:
    ai/bin/lead-time-repos [--json]
    ai/bin/lead-time-repos --repo-path NAME
    ai/bin/lead-time-repos --self-test

  Resolve the lead-time repo list for THIS machine (DND-1526). Every reader
  of the list (lead-time-phases, the skill's experiment script, the cron
  runner and setup-leadtime-cron) resolves through the same rules.

  Where the list comes from:
    1. ATHENA_LEADTIME_CONFIG, when set (even empty): authoritative. It must
       be an absolute path to a valid file; anything else is an error.
    2. Else ${XDG_CONFIG_HOME:-$HOME/.config}/athena/lead-time-repos.json,
       the machine-local override. Absent: the tracked
       ai/config/lead-time-repos.json (source=default). Present: it replaces
       the tracked file whole (source=override); there is no merge. It must
       be a regular file owned by you and not group/other-writable.

  Schema: {"repos":[{"name","path","mode":"improve|watch",
  "product_epic"?,"idle_workflow"?}], "window":N, "improvement_epic":"..."}.
  A repo with no product_epic files product tickets on improvement_epic.
  idle_workflow (DND-1540) is the post-merge workflow file a product-repo
  landing must find idle (locked-merge --require-idle-workflow), or "none";
  ai/bin/leadtime-product lands nothing in a repo that does not declare it.

  Presence: a configured path that does not exist is SKIPPED, named with its
  reason, and counted. A path that exists but is not the top of a git
  checkout, or whose main checkout's basename is not the repo's name (the
  telemetry label), is an error. Zero repos left is an error.

  Output: one line per repo and one per skip; --json prints
  {"source","path","window","improvement_epic","repos":[{name,path,mode,
  product_epic,product_epic_source,idle_workflow}],"skipped":[{name,path,reason}],
  "considered"}.

  --repo-path NAME prints one CHANGE repo's path (DND-1528): the repo a
  change landed in, which need not be a measured repo (experiment record
  --change-repo). In order:
    1. NAME configured and present: its configured path;
    2. NAME is the runner's own repo (the repo this tool runs from): its
       main checkout, from `git rev-parse --git-common-dir`, so the harness
       repo resolves on a machine that does not configure it. Never a
       hardcoded path;
    3. otherwise refused, exit 2 with Fix: (configured but skipped here, or
       neither configured nor the runner's own). Exit 3 when the runner's
       own repo could not be looked at and NAME is not configured.
  It needs no measured repo checked out, but a refused config refuses it.

  Options:
    --json            JSON instead of the table
    --repo-path NAME  print NAME's path as a change repo (above), and nothing else
    --self-test       run the domain suite (ai/test/lead-time-repos/config_test.rb)
    --help            this text

  Exit: 0 ok; 1 internal error; 2 the config or a repo path is refused, or
  --repo-path NAME cannot be resolved; 3 could not look (a file it could not
  read, git that could not run); 4 no configured repo is checked out on this
  machine (never for --repo-path).
TXT

SPEC = { "--json" => :switch, "--repo-path" => :value, "--self-test" => :switch }.freeze

def fail_with(code, what, fix)
  warn "lead-time-repos: #{what}"
  warn "Fix: #{fix}"
  code
end

def table(res)
  lines = ["lead-time-repos: source=#{res.source} path=#{res.path} window=#{res.window} improvement_epic=#{res.improvement_epic}"]
  width = (res.repos.map(&:name) + res.skipped.map(&:name)).map(&:size).max
  res.repos.each do |r|
    epic = r.product_epic_source == "repo" ? r.product_epic : "#{r.product_epic} (improvement_epic)"
    lines << "  repo     #{r.name.ljust(width)}  #{r.mode.ljust(7)}  #{r.path}  product_epic=#{epic}"
  end
  res.skipped.each { |s| lines << "  skipped  #{s.name.ljust(width)}  #{s.reason}" }
  lines << "lead-time-repos: #{res.considered} considered, #{res.repos.size} resolved, #{res.skipped.size} skipped"
  lines.join("\n")
end

def self_test
  suite = File.join(AI_DIR, "test", "lead-time-repos", "config_test.rb")
  return fail_with(1, "self-test suite missing: #{suite}", "restore ai/test/lead-time-repos/") unless File.exist?(suite)

  system("/usr/bin/ruby", suite) ? 0 : 1
end

# --repo-path NAME: one line, the path. The config is resolved in full (a
# refused config refuses this too), but no measured repo need be present.
def repo_path(env, opts)
  return fail_with(2, "usage error: --repo-path prints one path; it takes no --json", "drop --json") if opts["--json"]

  puts LeadTimeConfigIO.repo_path(LeadTimeConfigIO.resolve(env), opts["--repo-path"])
  0
end

def main(argv, env)
  opts = StrictArgv.parse(argv, SPEC)
  return self_test if opts["--self-test"]
  return repo_path(env, opts) if opts.key?("--repo-path")

  res = LeadTimeConfigIO.resolve(env).require_any!
  puts(opts["--json"] ? JSON.generate(res.to_h) : table(res))
  0
rescue StrictArgv::UsageError => e
  fail_with(2, "usage error: #{e.message}", "see --help")
rescue LeadTimeConfig::Unresolved => e
  fail_with(2, "cannot resolve the repo: #{e.message}", e.fix)
rescue LeadTimeConfig::NoRepos => e
  fail_with(4, e.message, e.fix)
rescue LeadTimeConfig::CouldNotLook => e
  fail_with(3, "could not look: #{e.message}", e.fix)
rescue LeadTimeConfig::Error => e
  fail_with(2, "config refused: #{e.message}", e.fix)
rescue StandardError => e
  fail_with(1, "internal error #{e.class}: #{e.message} (#{e.backtrace&.first})",
            "this is a lead-time-repos bug: file a DND ticket with this line")
end

if $PROGRAM_NAME == __FILE__
  if ARGV.include?("--help") || ARGV.include?("-h")
    puts HELP
    exit 0
  end
  exit main(ARGV, ENV)
end
