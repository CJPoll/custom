#!/usr/bin/env ruby
# frozen_string_literal: true
#
# check-pipefail-grep -- no tracked shell file in this repo that runs under
# `set -o pipefail` may feed `grep -q` through a PIPE.
#
# WHY THIS EXISTS (DND-365 found it, DND-371 swept it)
#
#   set -o pipefail
#   printf '%s' "$out" | grep -q PAT
#
# grep -q exits at its FIRST match. If the writer still has output to send, its
# next write hits a closed pipe, it dies of SIGPIPE, and under pipefail the
# pipeline's status is 141 -- not 0. So a check that MATCHED reads as a miss:
#
#   * a positive check (`if ... | grep -q X`) goes FALSE RED, intermittently,
#     under load (reproduced 2/30 standalone with a delayed writer);
#   * a NEGATED check (`! ... | grep -q X`) goes FALSE GREEN -- a guard that
#     cannot fire. That is the dangerous half.
#
# It reached production, not only tests: inbox-client-capture's retention
# check read a SIGPIPE'd match as "unreferenced", so a capture an unread
# harness-alert pointed at could be pruned (DND-365/367).
#
# The fix is a here-string, which has no second process to kill:
#
#   grep -q PAT <<<"$out"
#   grep -q PAT <<<"$(some command)"
#
# WHAT IS FLAGGED
#
#   A `|` or `|&` (not `||`) outside quotes, whose right-hand command is
#   `grep` with -q / --quiet / --silent among its options, in a tracked shell
#   file (see WHICH FILES) that EITHER sets pipefail itself (`set -o
#   pipefail`, `set -euo pipefail`, zsh `setopt pipe_fail`, ...) OR is
#   `source`d / `.`-included by a file that does (scripts/wt-lib/*.sh inherits
#   scripts/wt's pipefail).
#
# WHICH FILES (DND-509)
#
#   Every path `git ls-files --cached` lists for the repo -- committed or
#   staged, anywhere in the tree -- that is a regular file (not a symlink) and
#   is shell by what it IS, never by where it lives:
#     * extension .sh / .bash / .zsh / .ksh, or .confd (an OpenRC conf.d file,
#       sourced by its runscript);
#     * a shebang naming sh, bash, zsh, ksh, dash or openrc-run;
#     * a zsh function file: first line `#compdef` or `#autoload` (the
#       .auto-completions/ completions);
#     * a shell startup file by name: .bashrc, .bash_profile, .profile,
#       .zshrc, .zshenv, ... including suffixed variants (.zshrc.functions);
#     * an executable text file with NO shebang -- execvp's ENOEXEC fallback
#       runs it with /bin/sh (git-custom/git-amend).
#   There is no list of roots. Until DND-509 there was one (`ai scripts`), and
#   git-custom/, system-files/, hypr/ and .auto-completions/ were never read.
#   An UNTRACKED file is not scanned until it is staged: an owner's work in
#   progress is not yet first-party code, and staging is when a pre-commit gate
#   needs to see it. (ai/lib/first_party.rb's discover() also admits untracked
#   files, but only executables and lib/ code; its git_ls is reused here.)
#
# WHAT IS NOT FLAGGED (each has a --self-test case)
#
#   * a here-string, or `grep -q PAT file`       -- no pipe
#   * a pipe in a file with no pipefail           -- status is grep's own
#   * `a || grep -q X file`                       -- `||` is not a pipe
#   * comment lines and trailing `# ...` comments
#   * text inside single/double quotes (a message that MENTIONS the pattern);
#     `$( ... )` inside double quotes IS code and IS scanned
#   * heredoc bodies (a fixture script a test writes out)
#
# Deliberately NOT flagged: `grep -m1` / `grep -l` fed by a pipe. They exit
# early too, but they are used for their OUTPUT, and where their status is
# consumed at all it is behind `|| true`. Widening to them would flag sites
# whose status nobody reads. Named here so the omission is a decision.
#
# THERE IS NO SUPPRESSION MARKER, on purpose: an inline "ignore this line"
# comment is writable by the same diff it would excuse. Convert the site.
#
# A FILE THAT CANNOT BE READ -- or whose heredoc never closes, so its tail was
# skipped as data -- IS A FAILURE, NOT A PASS: "found nothing" and "could not
# look" must never print the same line. So is a discovery that git cannot
# answer (COULD NOT LOOK) and one that answers with no tracked file, no shell
# file, or no pipefail file (FOUND NOTHING): this repo has all three, so an
# empty set means the scan is broken, not that the repo is clean.
#
# KNOWN LIMITS (documented, not hidden):
#   * Quoting is tracked per line. A quoted string spanning lines (a long
#     `bash -c '...'`) resets at each newline, so a pipe inside its later lines
#     is scanned as code (a false positive, fixed by rewording) and a real pipe
#     after an odd quote on the same line could be missed.
#   * Pipefail inheritance is ONE level: a file `source`d by a pipefail file is
#     held to the rule; a lib sourced only by such a lib is not.
#
# Deliberately gem-free (stdlib only); run with bare `ruby`.

require "open3"
require "tmpdir"
require "fileutils"
require "tempfile"

require_relative "../lib/first_party"

REPO = File.expand_path("../..", __dir__)

USAGE = <<~TXT.freeze
  Usage:
    ai/bin/check-pipefail-grep              fail (listing file:line) on any
                                            `... | grep -q` in any tracked shell
                                            file in the repo that runs under
                                            `set -o pipefail`
    ai/bin/check-pipefail-grep --self-test  deterministic, hermetic suite
                                            (fixtures only; includes a live
                                            reproduction of the 141)
    ai/bin/check-pipefail-grep --help       this text

  Exit 0 = no such pipe. Exit 1 = at least one (each named), a file that
  could not be read, or a discovery that could not run or found nothing.
TXT

FIX_TEXT = "Fix: replace the pipe with a here-string -- `grep -q PAT <<<\"$var\"` " \
           "or `grep -q PAT <<<\"$(cmd)\"` -- keeping every grep flag (-x/-F/-E, " \
           "`--` before a pattern starting with `-`) and any `!` negation exactly. " \
           "Under pipefail, grep -q exits at its first match, the writer takes " \
           "SIGPIPE, and the pipeline returns 141: a positive check goes falsely " \
           "red, a negated one falsely green. There is no suppression marker; " \
           "convert the site."

# ---------------------------------------------------------------------------
# File classification

SHELL_SHEBANG = %r{\A#!\s*\S*(?:/|\s)(?:env\s+)?(?:(?:ba|z|k|da)?sh|openrc-run)\b}.freeze
SHELL_EXT = /\.(?:sh|bash|zsh|ksh|confd)\z/.freeze
ZSH_FUNCTION_HEADER = /\A#(?:compdef|autoload)\b/.freeze
SHELL_RC_NAME = /\A\.(?:bashrc|bash_profile|bash_login|bash_logout|profile|
                     zshrc|zshenv|zprofile|zlogin|zlogout)(?:\..+)?\z/x.freeze

# The WHICH FILES rule in the header. `executable` is the file's mode bit.
def shell_file?(path, text, executable = false)
  return true if path =~ SHELL_EXT || File.basename(path) =~ SHELL_RC_NAME

  first = text.lines.first.to_s
  return true if first =~ SHELL_SHEBANG || first =~ ZSH_FUNCTION_HEADER

  # No shebang: execvp falls back to /bin/sh. A NUL byte means a binary.
  executable && !first.start_with?("#!") && !text.include?("\0") && !text.empty?
end

# `set -o pipefail`, `set -euo pipefail`, `set -eu -o pipefail`, and friends,
# on a non-comment line. `set +o pipefail` (turning it OFF) does not match.
PIPEFAIL_RE = /^\s*set\s+(?:(?:[-+]o\s+[a-z]+|[-+][A-Za-z]+)\s+)*-[A-Za-z]*o\s+pipefail\b/.freeze
# zsh spells the option any case, underscores ignored: `setopt pipe_fail`,
# `setopt PIPEFAIL`, `setopt err_exit pipe_fail`. `setopt no_pipe_fail` is OFF.
ZSH_PIPEFAIL_RE = /^\s*setopt\s+(?:[A-Za-z_]+\s+)*pipe_*fail\b/i.freeze

def sets_pipefail?(text)
  text.each_line.any? { |l| l =~ PIPEFAIL_RE || l =~ ZSH_PIPEFAIL_RE }
end

# Basenames a file pulls in with `source X` / `. X` -- the target inherits the
# includer's shell options. Matched by basename because includes are written
# through variables ("${LIB_DIR}/worktree.sh"); over-inclusion only means a
# lib is held to the pipefail rule, which is the safe direction.
SOURCE_RE = /^\s*(?:source|\.)\s+["']?([^\s"';]+)/.freeze

def sourced_basenames(text)
  text.each_line.filter_map do |l|
    m = l.match(SOURCE_RE)
    m && File.basename(m[1].delete("\"'"))
  end
end

# ---------------------------------------------------------------------------
# Line scanning

GREP_ARG_SHORT = "efmABCdD" # short options that take an argument

# True when the command text starting right after a pipe is `grep` with a
# quiet flag among its options.
def quiet_grep?(rest)
  toks = rest.strip.split(/\s+/)
  return false unless toks.first == "grep"

  i = 1
  while i < toks.size
    t = toks[i]
    break unless t.start_with?("-")
    break if t == "--" || t == "-"

    if t.start_with?("--")
      return true if %w[--quiet --silent].include?(t)

      i += 1 if %w[--regexp --file --max-count --context --before-context
                   --after-context --directories --devices].include?(t)
    else
      t[1..].each_char.with_index do |c, idx|
        return true if c == "q"
        next unless GREP_ARG_SHORT.include?(c)

        i += 1 if idx == t.size - 2 # argument is the next token
        break
      end
    end
    i += 1
  end
  false
end

HEREDOC_AT = /\A<<(-?)\s*(['"]?)([A-Za-z_][A-Za-z0-9_]*)\2/.freeze

# One line, scanned in CODE context only. Returns [pipes, heredocs]:
#   pipes    -- offsets of unquoted pipes (the command follows each offset)
#   heredocs -- [[strip_tabs?, delimiter], ...] for each `<<WORD` / `<<-WORD`
#               opened in code (never one inside quotes or a comment, which
#               would otherwise swallow the rest of the file as "data")
# Quote-aware on a single line: '...' and "..." are text, except that `$( ... )`
# inside double quotes opens a new code context. A `#` at a word start in code
# ends the line.
def scan_line(line)
  stack = [:code] # :code, :dq, :sq, :subst (a $( ... ) code context)
  pipes = []
  heredocs = []
  i = 0
  prev = nil
  while i < line.size
    c = line[i]
    top = stack.last
    case top
    when :sq
      stack.pop if c == "'"
    when :dq
      if c == "\\"
        i += 1
      elsif c == '"'
        stack.pop
      elsif c == "$" && line[i + 1] == "("
        stack.push(:subst)
        i += 1
      end
    else # :code or :subst
      if c == "\\"
        i += 1
      elsif c == "'"
        stack.push(:sq)
      elsif c == '"'
        stack.push(:dq)
      elsif c == "#" && (prev.nil? || prev =~ /\s/ || prev == ";")
        break
      elsif c == "$" && line[i + 1] == "("
        stack.push(:subst)
        i += 1
      elsif c == "<" && line[i + 1] == "<"
        if line[i + 2] == "<"
          i += 2 # a here-STRING, not a heredoc
        elsif (m = line[i..].match(HEREDOC_AT))
          heredocs << [m[1] == "-", m[3]]
          i += m[0].size - 1
        else
          i += 1
        end
      elsif c == "(" && top == :subst
        stack.push(:subst)
      elsif c == ")" && top == :subst
        stack.pop
      elsif c == "|"
        if line[i + 1] == "|"
          i += 1 # `||` is a list operator, not a pipe
        elsif line[i + 1] == "&"
          i += 1 # `|&` IS a pipe (stdout+stderr); the command follows the `&`
          pipes << i
        else
          pipes << i
        end
      end
    end
    prev = c
    i += 1
  end
  [pipes, heredocs]
end

# [hits, unterminated] for a file's text. hits is [[lineno, line], ...];
# unterminated is the delimiter of a heredoc still open at end of file (nil
# when every heredoc closed). An open heredoc means every line after it was
# skipped as data, so the caller must treat it as "could not scan", never as
# clean.
def scan_text(text)
  hits = []
  open_docs = [] # [[strip_tabs?, delimiter], ...] still to be closed, in order
  pending_pipe = false # previous code line ended in a bare `|`
  text.each_line.with_index(1) do |raw, n|
    line = raw.chomp
    unless open_docs.empty?
      strip, word = open_docs.first
      body = strip ? line.sub(/\A\t+/, "") : line
      open_docs.shift if body == word
      next
    end
    next if line =~ /\A\s*#/

    pipes, heredocs = scan_line(line)
    hit = pending_pipe && quiet_grep?(line)
    hit ||= pipes.any? { |p| quiet_grep?(line[(p + 1)..]) }
    hits << [n, line] if hit

    stripped = line.rstrip.sub(/\\\z/, "").rstrip
    pending_pipe = !pipes.empty? && pipes.last == stripped.size - 1

    # A heredoc opened in code starts a body that is data (a fixture script a
    # test writes out), up to its delimiter line.
    open_docs.concat(heredocs)
  end
  [hits, open_docs.first&.last]
end

def offending_lines(text)
  scan_text(text).first
end

# ---------------------------------------------------------------------------
# Repository scan

# Every tracked path in the repo (WHICH FILES). Raises FirstParty::MeasureError
# when git cannot answer -- COULD NOT LOOK, never an empty list.
def candidate_files(root)
  FirstParty.git_ls(root, "--cached")
end

# => { findings: [[rel, lineno, line]], unreadable: [[rel, why]],
#      tracked: Integer, shell: Integer, pipefail: Integer }
def scan(root)
  shells = {}
  unreadable = []
  tracked = candidate_files(root)
  tracked.sort.each do |rel|
    path = File.join(root, rel)
    next if File.symlink?(path) || !File.file?(path)

    begin
      text = File.read(path, encoding: "UTF-8")
      text = text.scrub unless text.valid_encoding?
    rescue SystemCallError, IOError => e
      unreadable << [rel, e.message]
      next
    end
    shells[rel] = text if shell_file?(rel, text, File.executable?(path))
  end

  direct = shells.select { |_r, t| sets_pipefail?(t) }
  inherited_names = direct.values.flat_map { |t| sourced_basenames(t) }.uniq
  pipefail = shells.select do |rel, _t|
    direct.key?(rel) || inherited_names.include?(File.basename(rel))
  end

  findings = []
  pipefail.sort.each do |rel, text|
    hits, open_doc = scan_text(text)
    hits.each { |(n, line)| findings << [rel, n, line] }
    unreadable << [rel, "heredoc <<#{open_doc} never closes; the rest of the file was not scanned"] if open_doc
  end
  { findings: findings, unreadable: unreadable, tracked: tracked.size,
    shell: shells.size, pipefail: pipefail.size }
end

def run_check(root = REPO)
  begin
    r = scan(root)
  rescue FirstParty::MeasureError => e
    warn "check-pipefail-grep: FAILED -- COULD NOT LOOK: git could not list the " \
         "tracked files under #{root}: #{e.message}"
    warn "  Fix: run from inside the repo's git checkout with `git` on PATH " \
         "(`git -C #{root} ls-files --cached` must succeed); an unanswered " \
         "discovery is not a clean scan."
    return 1
  end
  unless r[:unreadable].empty?
    warn "check-pipefail-grep: FAILED -- could not read or fully scan " \
         "#{r[:unreadable].size} file(s); a file never read is not a file found clean:"
    r[:unreadable].each { |(rel, why)| warn "  - #{rel}: #{why}" }
    warn "  Fix: make each file readable (permissions, a broken checkout); for an " \
         "unclosed heredoc, close it with its delimiter on a line of its own (or, " \
         "if the scanner misread a `<<WORD` as a heredoc, repair scan_line in " \
         "ai/bin/check-pipefail-grep) and re-run."
    return 1
  end
  if r[:tracked].zero? || r[:shell].zero? || r[:pipefail].zero?
    warn "check-pipefail-grep: FAILED -- FOUND NOTHING: git lists #{r[:tracked]} " \
         "tracked file(s) under #{root}, #{r[:shell]} of them shell, " \
         "#{r[:pipefail]} under pipefail; this repo has all three, so the scan " \
         "itself is broken."
    warn "  Fix: check candidate_files/shell_file?/PIPEFAIL_RE in " \
         "ai/bin/check-pipefail-grep (and that #{root} is the repo root); do " \
         "not treat zero as clean."
    return 1
  end
  if r[:findings].empty?
    puts "check-pipefail-grep: OK -- #{r[:tracked]} tracked file(s), " \
         "#{r[:shell]} shell file(s) scanned, #{r[:pipefail]} under pipefail, " \
         "0 `| grep -q` pipes."
    return 0
  end

  warn "check-pipefail-grep: FAILED -- #{r[:findings].size} `... | grep -q` pipe(s) " \
       "in file(s) running under `set -o pipefail`:"
  r[:findings].each { |(rel, n, line)| warn "  #{rel}:#{n}: #{line.strip}" }
  warn "  #{FIX_TEXT}"
  1
end

# ---------------------------------------------------------------------------
# Self-test

def run_self_test
  ok = true
  fail_case = lambda do |name, detail|
    warn "self-test: FAIL -- #{name}: #{detail}"
    ok = false
  end

  line_cases = [
    # [name, text, expected_hit_line_numbers]
    ["classic printf pipe flagged", "printf '%s' \"$out\" | grep -q PAT\n", [1]],
    ["negated pipe flagged", "if ! printf '%s' \"$out\" | grep -q PAT; then :; fi\n", [1]],
    ["echo pipe with -qxF flagged", "echo \"$x\" | grep -qxF -- \"$y\"\n", [1]],
    ["-Eq cluster flagged", "cmd | grep -Eq 'a|b'\n", [1]],
    ["--quiet flagged", "cmd | grep --quiet x\n", [1]],
    ["command producer flagged", "if git status --porcelain | grep -q x; then :; fi\n", [1]],
    ["$( ) inside double quotes flagged", "v=\"$(cmd | grep -q x && echo y)\"\n", [1]],
    ["pipe at end of line, grep on next flagged", "cmd |\n  grep -q x\n", [2]],
    ["pipe then backslash, grep on next flagged", "cmd | \\\n  grep -q x\n", [2]],
    ["here-string not flagged", "grep -q PAT <<<\"$out\"\n", []],
    ["here-string of $( ) not flagged", "grep -q PAT <<<\"$(cmd | sort)\"\n", []],
    ["grep on a file not flagged", "grep -q PAT \"$f\"\n", []],
    ["|| grep not flagged", "a || grep -q x \"$f\"\n", []],
    ["|& grep flagged", "cmd |& grep -q x\n", [1]],
    ["pipe to grep without -q not flagged", "cmd | grep x | wc -l\n", []],
    ["-e q is a pattern, not -q", "cmd | grep -e q\n", []],
    ["comment line not flagged", "# never write printf | grep -q x\n", []],
    ["trailing comment not flagged", "grep -q x \"$f\" # not printf | grep -q\n", []],
    ["single-quoted text not flagged", "ok 'never a printf | grep -q pipe'\n", []],
    ["double-quoted text not flagged", "ok \"never a printf | grep -q pipe\"\n", []],
    ["quoted <<'EOF' is not a heredoc", "check \"cat <<'EOF' | x\"\ncmd | grep -q x\n", [2]],
    ["commented <<EOF is not a heredoc", "grep -q x \"$f\"  # see <<EOF\ncmd | grep -q x\n", [2]],
    ["<<- heredoc closes on a tab-indented delimiter", "cat <<-EOF\n\tprintf x | grep -q x\n\tEOF\ncmd | grep -q x\n", [4]],
    ["heredoc body not flagged", "cat >f <<'EOF'\nprintf x | grep -q x\nEOF\ngrep -q x f\n", []],
    ["line after heredoc still scanned", "cat >f <<EOF\nhi\nEOF\ncmd | grep -q x\n", [4]],
  ]
  line_cases.each do |(name, text, want)|
    got = offending_lines(text).map(&:first)
    fail_case.call(name, "want lines #{want.inspect}, got #{got.inspect}") unless got == want
  end

  pf_cases = [
    ["set -euo pipefail", true], ["set -o pipefail", true], ["  set -uo pipefail", true],
    ["set -eu -o pipefail", true], ["set +o pipefail", false], ["# set -o pipefail", false],
    ["set -e", false], ["set -o errexit -o pipefail", true],
    ["set -e -o nounset -o pipefail", true],
    ["setopt pipe_fail", true], ["setopt PIPEFAIL", true], ["  setopt err_exit pipe_fail", true],
    ["setopt no_pipe_fail", false], ["unsetopt pipe_fail", false], ["# setopt pipefail", false],
  ]
  pf_cases.each do |(line, want)|
    got = sets_pipefail?("#{line}\n")
    fail_case.call("pipefail detection #{line.inspect}", "want #{want}, got #{got}") unless got == want
  end

  dir = Dir.mktmpdir("check-pipefail-grep-selftest-")
  begin
    FileUtils.mkdir_p(File.join(dir, "ai", "lib"))
    FileUtils.mkdir_p(File.join(dir, "scripts"))
    w = ->(rel, body) { File.write(File.join(dir, rel), body) }
    w.call("scripts/pf.sh", "#!/usr/bin/env bash\nset -euo pipefail\nsource \"$D/inc.sh\"\n" \
                            "printf '%s' \"$o\" | grep -q x\n")
    w.call("scripts/nopf.sh", "#!/usr/bin/env bash\nset -eu\nprintf '%s' \"$o\" | grep -q x\n")
    w.call("ai/lib/inc.sh", "f() { cmd | grep -q y; }\n")
    w.call("ai/lib/other.sh", "g() { cmd | grep -q y; }\n")
    w.call("scripts/clean", "#!/bin/bash\nset -o pipefail\ngrep -q x <<<\"$o\"\n")
    w.call("scripts/notes.md", "set -o pipefail\nprintf x | grep -q x\n")
    stage_fixture(dir)
    r = scan(dir)
    got = r[:findings].map { |(rel, n, _)| "#{rel}:#{n}" }.sort
    want = ["ai/lib/inc.sh:1", "scripts/pf.sh:4"]
    unless got == want
      fail_case.call("tree scan (direct + inherited pipefail; no-pipefail, clean, " \
                     "unsourced lib and non-shell ignored)", "want #{want}, got #{got}")
    end
    if run_check_quiet(dir) != 1
      fail_case.call("run_check on a dirty fixture tree", "did not exit 1")
    end
    FileUtils.rm_f(File.join(dir, "scripts/pf.sh"))
    FileUtils.rm_f(File.join(dir, "ai/lib/inc.sh"))
    stage_fixture(dir)
    if run_check_quiet(dir) != 0
      fail_case.call("run_check on a clean fixture tree", "did not exit 0")
    end
    w.call("scripts/open.sh", "#!/bin/bash\nset -o pipefail\ncat <<EOF\nnever closed\n")
    stage_fixture(dir)
    if run_check_quiet(dir) != 1
      fail_case.call("an unclosed heredoc", "read as clean instead of 'could not scan'")
    end
    FileUtils.rm_f(File.join(dir, "scripts/open.sh"))
    FileUtils.rm_f(File.join(dir, "scripts/clean"))
    stage_fixture(dir)
    if run_check_quiet(dir) != 1
      fail_case.call("zero pipefail files", "read as clean instead of a broken scan")
    end

    # The live reproduction. A writer that emits the match first and then keeps
    # writing ~3MB -- far more than a pipe buffer plus grep's read buffer, so
    # this is deterministic, not timing-dependent: grep -q exits on the match,
    # a later write takes SIGPIPE, and under
    # pipefail the pipeline reports 141 although the pattern DID match. The
    # fixture must (a) actually produce that 141 here and (b) be flagged.
    repro = File.join(dir, "scripts", "repro.sh")
    File.write(repro, <<~'SH')
      #!/usr/bin/env bash
      set -o pipefail
      writer() { echo MATCH; seq 1 500000; }
      writer | grep -q MATCH
      echo "rc=$?"
      out="$(writer)"
      grep -q MATCH <<<"$out"
      echo "herestring_rc=$?"
    SH
    File.chmod(0o755, repro)
    out, _st = Open3.capture2e("bash", repro)
    unless out.include?("rc=141") && out.include?("herestring_rc=0")
      fail_case.call("141 reproduction", "expected rc=141 (pipe) and herestring_rc=0, got #{out.inspect} " \
                     "(an rc=1 here means SIGPIPE is IGNORED in this environment, so " \
                     "the writer got EPIPE instead; run the gate with SIGPIPE at default)")
    end
    unless offending_lines(File.read(repro)).map(&:first) == [4]
      fail_case.call("141 reproduction is flagged", "the reproducing pipe (line 4) was not flagged")
    end
  ensure
    FileUtils.rm_rf(dir)
  end

  # DND-509: the scan set is every TRACKED file in the repo, classified as shell
  # by what it is -- never a hand-kept list of roots. A pattern under
  # git-custom/, hypr/, system-files/ or .auto-completions/ was never read.
  wide = Dir.mktmpdir("check-pipefail-grep-wide-")
  begin
    pf_pipe = "set -o pipefail\nprintf '%s' \"$o\" | grep -q x\n"
    files = {
      "git-custom/git-pf" => ["#! /usr/bin/env bash\n#{pf_pipe}", 0o755],
      "hypr/scripts/pf.sh" => ["#{pf_pipe}", 0o644],
      "system-files/svc.initd" => ["#!/sbin/openrc-run\n#{pf_pipe}", 0o755],
      "git-custom/git-bare" => [pf_pipe, 0o755], # no shebang: execvp runs it with /bin/sh
      ".auto-completions/_tool" => ["#compdef tool\n#{pf_pipe}", 0o644],
      "dotfiles/.zshrc" => ["setopt PIPE_FAIL\nprintf x | grep -q x\n", 0o644],
      "git-custom/git-ruby" => ["#!/usr/bin/env ruby\n#{pf_pipe}", 0o755],
      "hypr/notes.txt" => [pf_pipe, 0o644],
      # Clean, and inside the old roots: the pre-DND-509 scan saw only this file
      # and printed OK while every hit above sat outside `ai scripts`.
      "scripts/ok.sh" => ["#!/usr/bin/env bash\nset -o pipefail\ngrep -q x <<<\"$o\"\n", 0o755],
    }
    files.each do |rel, (body, mode)|
      FileUtils.mkdir_p(File.dirname(File.join(wide, rel)))
      File.write(File.join(wide, rel), body)
      File.chmod(mode, File.join(wide, rel))
    end
    stage_fixture(wide)
    # Written AFTER staging: untracked, like the owner's work in progress. It is
    # not first-party code until it is staged, so it is never read.
    FileUtils.mkdir_p(File.join(wide, "ai/skills/wip"))
    File.write(File.join(wide, "ai/skills/wip/draft.sh"), "#!/bin/bash\n#{pf_pipe}")
    got = scan(wide)[:findings].map { |(rel, n, _)| "#{rel}:#{n}" }.sort
    want = [".auto-completions/_tool:3", "dotfiles/.zshrc:2", "git-custom/git-bare:2",
            "git-custom/git-pf:3", "hypr/scripts/pf.sh:2", "system-files/svc.initd:3"]
    unless got == want
      fail_case.call("repo-wide tracked scan (extension, shebang incl. openrc-run, " \
                     "#compdef, rc-file name, shebang-less executable, setopt; ruby, " \
                     "text and untracked ignored)", "want #{want}, got #{got}")
    end
    code, err = run_check_captured(wide)
    unless code == 1 && err.include?("hypr/scripts/pf.sh:2")
      fail_case.call("run_check flags a pipe under hypr/", "exit #{code}, stderr #{err.inspect}")
    end
  ensure
    FileUtils.rm_rf(wide)
  end

  # "Found nothing" and "could not look" both FAIL, and never print the same line.
  empty = Dir.mktmpdir("check-pipefail-grep-empty-")
  begin
    stage_fixture(empty) # a repo with nothing tracked
    code, err = run_check_captured(empty)
    unless code == 1 && err.include?("FOUND NOTHING") && !err.include?("COULD NOT LOOK")
      fail_case.call("empty discovery set", "want exit 1 + FOUND NOTHING, got #{code} #{err.inspect}")
    end
    FileUtils.rm_rf(File.join(empty, ".git")) # no repo: git cannot be asked
    code, err = run_check_captured(empty)
    unless code == 1 && err.include?("COULD NOT LOOK") && !err.include?("FOUND NOTHING")
      fail_case.call("discovery that cannot run", "want exit 1 + COULD NOT LOOK, got #{code} #{err.inspect}")
    end
  ensure
    FileUtils.rm_rf(empty)
  end

  if ok
    puts "check-pipefail-grep: self-test OK (#{line_cases.size + pf_cases.size + 11} cases)"
    0
  else
    warn "check-pipefail-grep: self-test FAILED"
    warn "  Fix: the scanner in ai/bin/check-pipefail-grep no longer classifies " \
         "the cases above correctly; repair it (do not weaken a case)."
    1
  end
end

# `git init` + stage everything: a fixture's files are TRACKED (staged counts),
# exactly as the scan asks git for them. No commit, so no identity is needed.
def stage_fixture(dir)
  [%w[init -q], %w[add -A]].each do |args|
    _o, e, st = Open3.capture3("git", "-c", "init.defaultBranch=main", "-C", dir, *args)
    raise "self-test fixture: git #{args.join(' ')} failed in #{dir}: #{e.strip}" unless st.success?
  end
end

# [exit code, stderr text] of run_check against a fixture root.
def run_check_captured(root)
  saved = $stderr.dup
  saved_out = $stdout.dup
  Tempfile.create("check-pipefail-grep-err-") do |tmp|
    $stderr.reopen(tmp)
    $stdout.reopen(File::NULL, "w")
    code = run_check(root)
    $stderr.flush
    return [code, File.read(tmp.path)]
  end
ensure
  $stderr.reopen(saved)
  $stdout.reopen(saved_out)
end

def run_check_quiet(root)
  saved = $stderr.dup
  saved_out = $stdout.dup
  File.open(File::NULL, "w") do |null|
    $stderr.reopen(null)
    $stdout.reopen(null)
    return run_check(root)
  end
ensure
  $stderr.reopen(saved)
  $stdout.reopen(saved_out)
end

if ARGV.include?("--help") || ARGV.include?("-h")
  puts USAGE
  exit 0
end
exit(ARGV.include?("--self-test") ? run_self_test : run_check)
