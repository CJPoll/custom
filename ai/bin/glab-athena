#!/usr/bin/env bash
# Run glab (or curl via `glab-athena api ...`) AS the Athena GitLab bot for the
# project's namespace. Token read at call time from a 600 file; never in argv
# or config. Use for writes that should be attributed to Athena (MR
# create/comment/approve, merge-train boarding, merges). Reads may keep using
# the owner's OAuth glab. Every merge path is judged by the merge guard first
# (DND-742, "The merge guard" below).
#
# Which bot (DND-1936): gitlab.com hosts a work group with its own bot and the
# personal athena-ai-harness group with another (athena-ai-harness-bot, a group
# service account), so the bot follows the project's (host, top-level
# namespace), never a default. The key comes from -R/--repo,
# else an `api projects/<g>%2F<p>/…` endpoint, else the cwd checkout's origin;
# for `git`, from the one forge URL the command reaches. The map is
# ai/config/forge-identities.json (public: the personal entries) plus the private
# overlay's gitlab .identities (work entries); ai/lib/forge-identity.sh reads
# it. A namespace with no entry, a malformed key, an unreadable map half or a
# bot not named yet is REFUSED with a Fix:, exit 3 (1 for `refresh`); so is a
# token file that does not exist on this machine, its Fix: naming the path
# (exit 1, 3 for `git`). Nothing falls back to the owner's login or to the
# other bot.
#
# Owner-run repair: `glab-athena refresh [-R <namespace>/<project>]` renews the
# token of the bot for that project's namespace, by the entry's `refresh`:
#   * group_service_account (a group bot: the work group's, or
#     athena-ai-harness-bot): rotates a live token, else mints a fresh PAT
#     for the group service account with the OWNER's plain `glab` (Cody's
#     OAuth session, group owner), so it works even when the current bot
#     token is expired/revoked (chicken-and-egg). The group is the entry's
#     namespace for a public entry, the overlay's gitlab .group for a work one;
#   * self_rotate (a bot that is an ordinary user; no tracked entry uses it,
#     kept for one that does): rotates the bot's own live PAT
#     (personal_access_tokens/self/rotate). A dead token cannot rotate itself:
#     the owner then creates a new one in the browser, as the bot.
# `refresh` is OWNER-GATED. Agents never run it: the `glab-athena refresh` deny
# in ai/hooks/forge-auth-guard.sh blocks it in every Claude Code session, so
# only the owner runs it, in their own terminal. An agent that finds the token
# expired escalates to its admiral.
#
# Git passthrough (DND-393): `glab-athena git <args>` runs git as the
# namespace's bot for ONE command, over HTTPS only — see "The git passthrough"
# below.
#
# Test seams: GITLAB_ATHENA_TOKEN_FILE replaces the RESOLVED identity's token
# file (the identity is still resolved and refused the same way);
# ATHENA_FORGE_IDENTITIES_FILE / ATHENA_PRIVATE_ROOT name fixture map halves.
set -eu

# `glab-athena --help` (alone) answers the wrapper's own help on stdout and does
# nothing else: no identity, no token, no glab. Any other argv, `mr --help`
# included, is forwarded to glab as before.
if [ "$#" = 1 ] && { [ "$1" = --help ] || [ "$1" = -h ]; }; then
	cat <<'EOF'
glab-athena -- run glab as the Athena GitLab bot of the project's namespace

Usage:
  glab-athena <glab args...>        glab, as the bot for the project's (host,
                                    top-level namespace): from -R/--repo, an
                                    `api projects/<ns>%2F<p>/...` endpoint, or
                                    the checkout's origin
  glab-athena git <git args...>     git for ONE command, as the bot of the
                                    forge URL it reaches, over HTTPS only
  glab-athena refresh [-R <ns>/<p>] renew that bot's token (OWNER-run only)
  glab-athena --help                this text (stdout, exit 0, nothing else)

The bot map: ai/config/forge-identities.json plus the private overlay's
gitlab .identities (ai/lib/forge-identity.sh). A namespace with no bot, a key
this cannot read (an id, a graphql query, an ambiguous remote) or an empty
token is refused with a Fix:. ~/dev/custom/ai/bin/forge-identity check lists
what each checkout resolves to. For glab's own help, run plain `glab --help`
(a read). Skill: athena:gitlab.
EOF
	exit 0
fi

GA_DIR="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
FID_LIB="$GA_DIR/../lib/forge-identity.sh"
[ -r "$FID_LIB" ] || {
	echo "glab-athena: REFUSING: cannot load $FID_LIB, so which bot acts on this project is unknown." >&2
	echo "  Fix: run glab-athena from a full ~/dev/custom checkout (ai/bin and ai/lib side by side)." >&2
	exit 3
}
# shellcheck source=../lib/forge-identity.sh
. "$FID_LIB"

# ga_refuse_identity <rc> <what> : print the identity refusal, exit <rc>.
ga_refuse_identity() {
	echo "glab-athena: REFUSING $2: $FID_STATE: ${FID_WHY%.}." >&2
	echo "  Fix: $FID_FIX" >&2
	exit "$1"
}

# ga_refuse_missing_token_file <rc> <what> <token file> : a token file that
# does not exist is its own refusal, its Fix: naming the path. The owner
# creates it once per machine; nothing here creates, guesses or replaces it.
ga_refuse_missing_token_file() {
	[ -e "$3" ] && return 0
	# A directory this user cannot search, anywhere on the path, hides an
	# existing file from -e too. Walk up to the deepest ancestor that is
	# visible: if it is a directory it cannot search, that is COULD NOT LOOK,
	# named; otherwise the next component really is missing.
	local d
	d="$(dirname -- "$3")"
	while [ "$d" != / ] && [ "$d" != . ] && [ ! -e "$d" ]; do d="$(dirname -- "$d")"; done
	if [ -d "$d" ] && [ ! -x "$d" ]; then
		echo "glab-athena: REFUSING $2: COULD NOT LOOK: the directory $d cannot be searched by this user, so whether the $FID_BOT token file $3 (for $FID_HOST/$FID_NS) exists is unknown." >&2
		echo "  Fix: the owner makes $d searchable for this user (or moves the token file to a path it can reach) and keeps $3 at mode 600; agents do not change it. $FID_ESCALATE" >&2
		exit "$1"
	fi
	echo "glab-athena: REFUSING $2: the $FID_BOT token file $3 (for $FID_HOST/$FID_NS) does not exist on this machine, so nothing can run as $FID_BOT." >&2
	echo "  Fix: the owner creates $3 on this machine (mode 600, one line: $FID_BOT's token; ai/secrets/registry.json says how). Agents never create it and never run \`glab-athena refresh\` or \`glab auth\`. $FID_ESCALATE" >&2
	exit "$1"
}

# --- refresh subcommand: intercepted before exec so it never reaches glab ----
if [ "${1:-}" = refresh ]; then
	shift
	fid_resolve_glab_args "$@" || ga_refuse_identity 1 "\`refresh\`; nothing was minted"
	SA_USERNAME="$FID_BOT"
	SA_HOST="$FID_HOST"
	TOKEN_FILE="${GITLAB_ATHENA_TOKEN_FILE:-$FID_TOKEN_FILE}"
	SA_TOKEN_NAME=glab-athena
	# GitLab caps PAT lifetime at 1 year; stay just under.
	EXPIRES_AT="$(date -d "+364 days" +%F)"
	# Secrets are piped straight from each API response into the token file under
	# a tight umask; never echoed to stdout/argv. Only non-secret metadata prints.
	umask 077

	# ga_verify_whoami : the token file now authenticates as the active bot.
	ga_verify_whoami() {
		local tok who
		tok="$(tr -d '[:space:]' < "$TOKEN_FILE")"
		who="$(GITLAB_TOKEN="$tok" GITLAB_HOST="$SA_HOST" GLAB_NO_PROMPT=1 glab api user)" || who=""
		echo "glab-athena refresh: whoami ->"
		printf '%s' "$who" | jq '{username, state}' 2>/dev/null || true
		printf '%s' "$who" | jq -e --arg u "$SA_USERNAME" '.username==$u and .state=="active"' >/dev/null 2>&1 || {
			echo "glab-athena refresh: verification FAILED (the token does not resolve to an active $SA_USERNAME on $SA_HOST)" >&2
			echo "Fix: check the token file $TOKEN_FILE holds $SA_USERNAME's token; if not, create one as $SA_USERNAME and write it there." >&2
			exit 1
		}
	}

	case "$FID_REFRESH" in
	self_rotate)
		# A self_rotate bot is an ordinary user: only its own live token can
		# rotate it. No owner session can mint for it.
		CUR_TOKEN=""
		[ -r "$TOKEN_FILE" ] && CUR_TOKEN="$(tr -d '[:space:]' < "$TOKEN_FILE" 2>/dev/null || true)"
		if [ -z "$CUR_TOKEN" ] || ! GITLAB_TOKEN="$CUR_TOKEN" GITLAB_HOST="$SA_HOST" GLAB_NO_PROMPT=1 \
			glab api user >/dev/null 2>&1; then
			echo "glab-athena refresh: the $SA_USERNAME token in $TOKEN_FILE is missing or no longer authenticates on $SA_HOST, so it cannot rotate itself; nothing was minted." >&2
			echo "Fix: log in to https://$SA_HOST as $SA_USERNAME, create a PAT at https://$SA_HOST/-/user_settings/personal_access_tokens (scopes api, read_repository, write_repository; expiry at most 365 days), and write it with \`(umask 077; cat > $TOKEN_FILE)\`." >&2
			exit 1
		fi
		RESP="$(GITLAB_TOKEN="$CUR_TOKEN" GITLAB_HOST="$SA_HOST" GLAB_NO_PROMPT=1 \
			glab api --method POST "personal_access_tokens/self/rotate?expires_at=$EXPIRES_AT" 2>/dev/null)" || RESP=""
		printf '%s' "$RESP" | jq -e 'has("token")' >/dev/null 2>&1 || {
			echo "glab-athena refresh: self-rotate of the $SA_USERNAME token failed; the old token is unchanged:" >&2
			printf '%s\n' "$RESP" | jq -c '{message, error}' >&2 2>/dev/null || echo "(no JSON response)" >&2
			echo "Fix: check the token has the api scope, or create a new one as $SA_USERNAME in the browser (see the Fix above)." >&2
			exit 1
		}
		printf '%s' "$RESP" | jq -r '.token' > "$TOKEN_FILE"
		chmod 600 "$TOKEN_FILE"
		echo "glab-athena refresh: rotated the $SA_USERNAME token (self-rotate)."
		printf '%s' "$RESP" | jq '{id, name, scopes, active, expires_at}'
		ga_verify_whoami
		echo "glab-athena refresh: OK."
		exit 0
		;;
	group_service_account) ;;
	*)
		echo "glab-athena refresh: the identity for $FID_HOST/$FID_NS has refresh '$FID_REFRESH', which this tool cannot run; nothing was minted." >&2
		echo "Fix: set refresh to self_rotate or group_service_account in its map entry." >&2
		exit 1
		;;
	esac

	# Resolve group + service-account ids dynamically (owner OAuth glab, not the
	# Athena token) so a renamed/renumbered account doesn't brick the script.
	# The group's name is a work value: it is read from the private overlay
	# (overlay/gitlab.json .group), never written here (DND-1668, contract
	# athena-private-overlay.md -> Consumer obligation). A failed read is
	# reported with the resolver's own Fix: and nothing is guessed.
	# A public entry's group (the personal athena-ai-harness group) is no work
	# value: it is the entry's own top-level namespace, and the overlay is not
	# read for it.
	PO_BIN="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/private-overlay"
	if [ "$FID_SOURCE" = public ]; then
		GROUP_NAME="$FID_NS"
	else GROUP_NAME="$("$PO_BIN" get gitlab .group)"; fi || {
		echo "glab-athena refresh: the work GitLab group name is not readable from the private overlay (gitlab .group); nothing was minted." >&2
		echo "Fix: follow the resolver's Fix: above; if the key is simply missing, add {\"group\": \"<work GitLab group path>\"} to overlay/gitlab.json in the private overlay. Then run refresh again." >&2
		exit 1
	}
	# The service account lives in the group the identity was resolved for;
	# a .group naming another group would mint in the wrong place.
	[ "${GROUP_NAME%%/*}" = "$FID_NS" ] || {
		echo "glab-athena refresh: the overlay's gitlab .group names a different group than the namespace being refreshed ($FID_HOST/$FID_NS); nothing was minted." >&2
		echo "Fix: refresh with -R <project in the group gitlab .group names>, or correct gitlab .group in the private overlay." >&2
		exit 1
	}
	GROUP_ID="$(glab api "groups/$GROUP_NAME" | jq -r '.id')"
	[ -n "$GROUP_ID" ] && [ "$GROUP_ID" != null ] || {
		echo "glab-athena refresh: could not resolve the group id for $GROUP_NAME (is the owner glab logged in?)" >&2
		exit 1
	}
	SA_ID="$(glab api "groups/$GROUP_ID/service_accounts" \
		| jq -r --arg u "$SA_USERNAME" '.[] | select(.username==$u) | .id' | head -n1)"
	[ -n "$SA_ID" ] && [ "$SA_ID" != null ] || {
		echo "glab-athena refresh: no service account named $SA_USERNAME in group $GROUP_ID" >&2
		exit 1
	}

	NEW_ID=""
	minted=""

	# --- fast path: rotate the current token if it still authenticates ---------
	if [ -r "$TOKEN_FILE" ]; then
		CUR_TOKEN="$(tr -d '[:space:]' < "$TOKEN_FILE" 2>/dev/null || true)"
		if [ -n "${CUR_TOKEN:-}" ] \
			&& GITLAB_TOKEN="$CUR_TOKEN" GITLAB_HOST="$SA_HOST" GLAB_NO_PROMPT=1 \
				glab api user >/dev/null 2>&1; then
			if RESP="$(GITLAB_TOKEN="$CUR_TOKEN" GITLAB_HOST="$SA_HOST" GLAB_NO_PROMPT=1 \
				glab api --method POST "personal_access_tokens/self/rotate?expires_at=$EXPIRES_AT" 2>/dev/null)" \
				&& printf '%s' "$RESP" | jq -e 'has("token")' >/dev/null 2>&1; then
				printf '%s' "$RESP" | jq -r '.token' > "$TOKEN_FILE"
				chmod 600 "$TOKEN_FILE"
				NEW_ID="$(printf '%s' "$RESP" | jq -r '.id')"
				echo "glab-athena refresh: rotated existing token (fast path)."
				printf '%s' "$RESP" | jq '{id, name, scopes, active, expires_at}'
				minted=1
			fi
		fi
	fi

	# --- reliable path: owner-mint a fresh PAT for the service account ---------
	if [ -z "$minted" ]; then
		RESP="$(glab api --method POST \
			"groups/$GROUP_ID/service_accounts/$SA_ID/personal_access_tokens?name=$SA_TOKEN_NAME&scopes[]=api&expires_at=$EXPIRES_AT")"
		printf '%s' "$RESP" | jq -e 'has("token")' >/dev/null 2>&1 || {
			echo "glab-athena refresh: mint failed:" >&2
			printf '%s\n' "$RESP" | jq -c '{message, error}' >&2 2>/dev/null || printf '%s\n' "$RESP" >&2
			exit 1
		}
		printf '%s' "$RESP" | jq -r '.token' > "$TOKEN_FILE"
		chmod 600 "$TOKEN_FILE"
		NEW_ID="$(printf '%s' "$RESP" | jq -r '.id')"
		echo "glab-athena refresh: minted a fresh token for $SA_USERNAME."
		printf '%s' "$RESP" | jq '{id, name, scopes, active, expires_at}'
	fi

	# --- verify via the wrapper's own auth path --------------------------------
	ga_verify_whoami

	# --- tidy: best-effort revoke older glab-athena PATs to avoid pile-up ------
	if [ -n "${NEW_ID:-}" ] && [ "$NEW_ID" != null ]; then
		OLD_IDS="$(glab api "groups/$GROUP_ID/service_accounts/$SA_ID/personal_access_tokens" 2>/dev/null \
			| jq -r --arg n "$SA_TOKEN_NAME" --argjson keep "$NEW_ID" \
				'.[] | select(.name==$n and .active==true and .id!=$keep) | .id' 2>/dev/null || true)"
		for id in $OLD_IDS; do
			if glab api --method DELETE \
				"groups/$GROUP_ID/service_accounts/$SA_ID/personal_access_tokens/$id" >/dev/null 2>&1; then
				echo "glab-athena refresh: revoked older token id $id"
			fi
		done
	fi

	echo "glab-athena refresh: OK."
	exit 0

fi

# ---- The git passthrough (DND-393) ------------------------------------------
# `glab-athena git <args>` runs git authenticated as the namespace's bot for ONE
# command. No git or glab config change, no auth subcommand:
#   * url.athena-forge::https://gitlab.com/.insteadOf=git@gitlab.com: (and
#     =https://gitlab.com/) send both forms to the route's transport;
#   * credential.helper= / core.askPass= / GIT_ASKPASS, SSH_ASKPASS unset /
#     GIT_TERMINAL_PROMPT=0 keep every owner credential source out;
#   * the bot's PAT, read at call time from the token file of the identity
#     that owns the ONE forge URL the command reaches (DND-1936), as an
#     `oauth2:<PAT>` basic-auth header, reaches only the route's transport
#     (git-remote-athena-forge) through a one-shot pipe — never on argv, in a
#     URL, a config file or git's environment (DND-1868);
#   * a network op that would still reach gitlab.com over SSH or another
#     non-HTTPS transport (ssh://, a pushurl override, an insteadOf forcing SSH)
#     is REFUSED, exit 3 with a Fix:, and so is a URL on any host but
#     gitlab.com, github.com included (DND-2000).
# The mechanism, its coverage and its named residuals are shared with
# `gh-athena git` and live in ai/lib/forge-git-passthrough.sh.
#
# Test seam: GLAB_ATHENA_GIT_DRY_RUN=1 prints the resolved URLs and the git argv
# (token redacted) instead of exec'ing git.
if [ "${1:-}" = git ]; then
	shift
	LIB="$GA_DIR/../lib/forge-git-passthrough.sh"
	[ -r "$LIB" ] || {
		echo "glab-athena: cannot load $LIB. Fix: run glab-athena from a full ~/dev/custom checkout (ai/bin and ai/lib side by side)." >&2
		exit 3
	}
	# shellcheck source=../lib/forge-git-passthrough.sh
	. "$LIB"
	FG_TOOL=glab-athena FG_HOST=gitlab.com
	# A push that moves the remote's default branch is recorded as merge.landed,
	# exactly as gh-athena records it (DND-1939; the lib's "Landing telemetry"
	# section). The repo key is the checkout's, so it does not change when
	# origin moves from github.com to gitlab.com. Fails open.
	FG_LANDING_TELEMETRY=1
	# For messages before the URL is known: the bot of this checkout's origin
	# when it resolves. The credential itself is chosen by ga_git_cred below,
	# from the URL the command actually reaches.
	FG_BOT="the Athena bot for the remote's namespace"
	if ga_origin="$(git remote get-url origin 2>/dev/null)" && fid_resolve_url "$ga_origin" 2>/dev/null; then
		FG_BOT="$FID_BOT"
	fi
	# Pinned, never inherited: the caller's environment cannot turn off the
	# refusal of another forge's host (DND-2000).
	FG_ROUTE_ONLY=1
	FG_DRY_RUN="${GLAB_ATHENA_GIT_DRY_RUN:-}"
	fg_refuse_non_https "$@"

	# ga_git_cred <https url> : FG_CRED_TOKEN and FG_BOT for <url>'s project, or
	# exit 3 with a Fix:. Called by fg_git_exec only for a command granted a
	# credential, so a local command needs no identity.
	ga_git_cred() {
		local tf t=""
		fid_resolve_url "$1" || ga_refuse_identity 3 "\`git\` to $1"
		FG_BOT="$FID_BOT"
		tf="${GITLAB_ATHENA_TOKEN_FILE:-$FID_TOKEN_FILE}"
		ga_refuse_missing_token_file 3 "\`git\` to $1" "$tf"
		if [ -r "$tf" ]; then t="$(tr -d '[:space:]' < "$tf" 2>/dev/null)" || t=""; fi
		[ -n "$t" ] || {
			echo "glab-athena: REFUSING \`git\`: the $FID_BOT token file $tf (for $FID_HOST/$FID_NS) is missing, unreadable or empty, so the push cannot run as Athena." >&2
			echo "  Fix: do not run \`glab-athena refresh\` or any \`glab auth\` yourself (owner-gated), and do not fall back to a plain \`git push\`; $FG_ESCALATE" >&2
			exit 3
		}
		FG_CRED_TOKEN="$t"
	}
	FG_CRED_RESOLVER=ga_git_cred
	fg_git_exec oauth2 "" "$@"
fi

# --- normal path: run glab as the namespace's bot -----------------------------
# DND-1936: which bot first. A refusal here runs nothing.
fid_resolve_glab_args "$@" || ga_refuse_identity 3 "this glab command; nothing ran"
GA_BOT="$FID_BOT" GA_HOST="$FID_HOST"
TOKEN_FILE="${GITLAB_ATHENA_TOKEN_FILE:-$FID_TOKEN_FILE}"
ga_refuse_missing_token_file 1 "this glab command; nothing ran" "$TOKEN_FILE"
# DND-725: a readable file is not enough. An empty or whitespace-only token file
# (or GITLAB_ATHENA_TOKEN_FILE pointing at one) used to export GITLAB_TOKEN="",
# and glab then answered as the OWNER from its own config and keyring. Now the
# token must be a real token, and glab runs with a fresh empty config dir and no
# inherited identity/host variables, so the owner's login is unreachable even if
# a token check were ever wrong. Mechanism and measurements:
# ai/lib/forge-cli-isolation.sh.
FCI_LIB="$GA_DIR/../lib/forge-cli-isolation.sh"
[ -r "$FCI_LIB" ] || {
	echo "glab-athena: REFUSING: cannot load $FCI_LIB, so glab cannot be isolated from the owner's login." >&2
	echo "  Fix: run glab-athena from a full ~/dev/custom checkout (ai/bin and ai/lib side by side)." >&2
	exit 3
}
# shellcheck source=../lib/forge-cli-isolation.sh
. "$FCI_LIB"
TOKEN=""
if [ -r "$TOKEN_FILE" ]; then TOKEN="$(tr -d '[:space:]' < "$TOKEN_FILE" 2>/dev/null)" || TOKEN=""; fi
# Read before the scrub below, which removes every GLAB_* variable.
MERGE_DRY_RUN="${GLAB_ATHENA_MERGE_DRY_RUN:-}"
LANDING_TRIES="${GLAB_ATHENA_LANDING_TRIES:-}" LANDING_SLEEP="${GLAB_ATHENA_LANDING_SLEEP:-}"
fci_require_token 1 glab-athena "$GA_BOT" "token file $TOKEN_FILE" "$TOKEN"
# Every GITLAB_*/GLAB_*/GL_* variable (token sources, GITLAB_URI/GITLAB_API_HOST
# host overrides, GLAB_CONFIG_DIR, CI autologin), plus OAUTH_TOKEN and
# CI_JOB_TOKEN. Only the values set below reach glab.
fci_scrub_env '^(GITLAB_|GLAB_|GL_)|^(OAUTH_TOKEN|CI_JOB_TOKEN)$'
fci_isolate glab-athena GLAB_CONFIG_DIR
export GITLAB_TOKEN="$TOKEN" GITLAB_HOST="$GA_HOST" GLAB_NO_PROMPT=1 GLAB_CHECK_UPDATE=false
unset TOKEN

# ---- The merge guard (DND-742) ---------------------------------------------
# Every merge path must pin the MR's exact head SHA, and the MR's head pipeline
# must have PASSED on that head: `mr merge`/`mr accept` need --sha <head>;
# merge-train boarding (`api -X POST projects/<p>/merge_trains/merge_requests/
# <iid>`) needs -f sha=<head>. Both also need integration-gate's sealed receipt
# for that head, read from the checkout the wrapper runs in (DND-1845).
# Both also refuse a deferred merge (`mr merge` needs --auto-merge=false) and
# a RED target tip unless the head is a red-main fix; API ref writes are
# refused outright (DND-1941).
# A REST PUT …/merge_requests/<iid>/merge and the
# GraphQL mergeRequestAccept are REFUSED outright, and so is `mcp serve`. The
# mechanism, its measurements and its named residuals live in
# ai/lib/glab-merge-guard.sh. The GitHub counterpart is gh-athena's (DND-609).
#
# Test seam: GLAB_ATHENA_MERGE_DRY_RUN=1 runs the guard (reads only) and then
# prints the command instead of running glab, for ANY command.
#
# After isolation, so the guard's own glab reads run as the same bot.
GLMG_LIB="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/glab-merge-guard.sh"
[ -r "$GLMG_LIB" ] || {
	echo "glab-athena: REFUSING: cannot load $GLMG_LIB, so no merge can be judged." >&2
	echo "  Fix: run glab-athena from a full ~/dev/custom checkout (ai/bin and ai/lib side by side)." >&2
	exit 3
}
# shellcheck source=../lib/glab-merge-guard.sh
. "$GLMG_LIB"
glmg_guard "$@"
if [ -n "$MERGE_DRY_RUN" ]; then
	printf 'glab-athena: dry-run: would exec glab %s\n' "$*"
	exit 0
fi

# ---- The outbound scan (DND-1938) ------------------------------------------
# MR, issue, note, release and api text bound for a project that reads PUBLIC
# or INTERNAL is scanned for work-domain values before glab runs; a hit is
# refused, and an unreadable visibility refuses (COULD NOT LOOK). A file or
# stdin value is handed to glab as the scanned private copy. The rules are
# gh-athena's (ai/lib/outbound-text-scan.sh); the glab parse, targets and
# residuals: ai/lib/glab-outbound-scan.sh. After isolation, so the visibility
# reads run as Athena. After the merge guard, so its refusals stay its own
# (it reads no stdin and sends nothing), and after its dry-run seam, which sends
# nothing either.
GLOS_LIB="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/glab-outbound-scan.sh"
[ -r "$GLOS_LIB" ] || {
	echo "glab-athena: REFUSING: cannot load $GLOS_LIB, so no text can be scanned." >&2
	echo "  Fix: run glab-athena from a full ~/dev/custom checkout (ai/bin and ai/lib side by side)." >&2
	exit 3
}
# shellcheck source=../lib/glab-outbound-scan.sh
. "$GLOS_LIB"
glos_guard "$@"
set -- "${GLOS_ARGV[@]}"

# ---- The landing record (DND-1939) ------------------------------------------
# An `mr merge` / `mr accept` the guard let through is recorded as one
# merge.landed (via=mr) once confirm-merged sees the MR merged; anything else
# records nothing. Mechanism, outcomes and residuals: ai/lib/glab-landing.sh.
# Fails open: glab's exit code and output are unchanged.
#
# Test seams: GLAB_ATHENA_LANDING_TRIES / GLAB_ATHENA_LANDING_SLEEP replace
# the confirm reads' count (default 6) and spacing in seconds (default 10).
GLL_LIB="$GA_DIR/../lib/glab-landing.sh"
# shellcheck source=../lib/glab-landing.sh
if ! . "$GLL_LIB" 2>/dev/null; then
	gll_record_mr_landing() {
		[ -n "$GLMG_LAND_IID" ] || return 0
		echo "glab-athena: no merge.landed recorded for !$GLMG_LAND_IID: cannot load $GLL_LIB." >&2
		echo "  Fix: run glab-athena from a full ~/dev/custom checkout (ai/bin and ai/lib side by side)." >&2
	}
fi
[[ "$LANDING_TRIES" =~ ^[1-9][0-9]?$ ]] && GLL_TRIES="$LANDING_TRIES"
[[ "$LANDING_SLEEP" =~ ^[0-9]{1,3}$ ]] && GLL_SLEEP="$LANDING_SLEEP"

# A child, not exec: fci_isolate's trap removes the config dir when glab exits.
rc=0
glab "$@" || rc=$?
gll_record_mr_landing "$rc" || true
exit "$rc"
