#!/usr/bin/env bash
#
# push-actor-check — after an agent push, confirm the forge recorded it as
# Athena, re-reading for a bounded window because the events API lags.
#
# athena:github / athena:gitlab -> "Pushing as Athena" end with an actor check:
# the push must show up as athena-harness[bot] (GitHub activity API) or
# athena-amby (GitLab events API). Those APIs can lag a push by several seconds,
# so one read that finds "no event for your ref and SHA" is not yet a failure
# (DND-397; measured on the DND-393 live probe). This re-reads for up to
# --window seconds (default 20), SLEEPING --interval seconds between reads
# (default 4, minimum 1) — bounded, never a spin (~/.claude/CLAUDE.md -> the
# safe-wait rule).
#
# Reads only, on PLAIN gh/glab — the reads-stay-on-plain-CLI convention. It
# never pushes, never mints a token, never touches auth.
#
# Exit codes — the bad outcomes are distinct, because a failed read must
# never look like an empty one (~/dev/custom/CLAUDE.md):
#   0  the event for <branch> at <sha> has the Athena actor
#   1  the event exists and the actor is NOT Athena (final; not re-read)
#   2  usage / prerequisite error (bad args, not a repo, remote on neither forge)
#   3  no read succeeded in the window: cannot tell who pushed
#   4  reads succeeded but no event for <branch> at <sha> appeared in the window
#   5  repo/branch resolution failed: <branch> is not on the resolved remote, or
#      <sha> is not that branch's remote head — the wrong-cwd/wrong-repo case
#      (DND-451). Distinct from 4: this never touches the events API at all.
#
# The repo/remote key is resolved as its OWN step (DND-451), before any events
# read: --repo DIR (default: cwd, like confirm-merged) picks the repo, --remote
# picks the remote inside it, and the tool then asserts <branch> exists on that
# remote and <sha> is its head via `git ls-remote`. Running this from the wrong
# checkout (e.g. the admin's own repo instead of the one just pushed) used to
# resolve `origin` to an unrelated project and report "no event found" — a
# push-attribution failure — instead of "wrong repo". That is exactly "a
# failed lookup must never look like an empty one" pointed at this tool's own
# remote key.
#
# Test seams (self-test only): PUSH_ACTOR_CHECK_GH / PUSH_ACTOR_CHECK_GLAB name
# a stub gh / glab; PUSH_ACTOR_CHECK_GIT names a stub git used only for the
# ls-remote resolution check. Self-test: ai/test/push-actor-check/self-test.sh.

set -uo pipefail

usage() {
  cat <<'EOF'
Usage: push-actor-check [--repo DIR] [--remote NAME] [--sha SHA] [--window SECS] [--interval SECS] <branch>

Run inside the repo you pushed from, or pass --repo DIR (default: cwd, like
confirm-merged) if it isn't the current directory. Confirms the forge recorded
the push of <branch> at <sha> (default: HEAD) as Athena: athena-harness[bot] on
github.com, athena-amby on gitlab.com. The forge is read from the push URL of
--remote (default: origin) inside --repo.

Before reading any event, it asserts <branch> exists on that remote and <sha>
is its remote head (`git ls-remote`). A mismatch means the wrong repo/cwd was
resolved, not a missing push event, and fails loudly (exit 5) rather than
reporting "no event found".

The events API lags, so an absent event is re-read every --interval seconds
(default 4, min 1) for up to --window seconds (default 20, max 300) before it
counts as a failure.

Exit: 0 Athena · 1 another actor · 2 usage · 3 could not read · 4 no event in window · 5 wrong repo/branch/sha
EOF
}

die_usage() { printf 'push-actor-check: %s\nFix: %s\n' "$1" "$2" >&2; exit 2; }

REMOTE=origin SHA="" WINDOW=20 INTERVAL=4 BRANCH="" REPO="."
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --repo) REPO=${2:-}; shift 2 || die_usage "--repo needs a value" "pass --repo <path to the repo you pushed from>" ;;
    --remote) REMOTE=${2:-}; shift 2 || die_usage "--remote needs a value" "pass --remote <name>" ;;
    --sha) SHA=${2:-}; shift 2 || die_usage "--sha needs a value" "pass --sha <40-hex sha>" ;;
    --window) WINDOW=${2:-}; shift 2 || die_usage "--window needs a value" "pass --window <seconds>" ;;
    --interval) INTERVAL=${2:-}; shift 2 || die_usage "--interval needs a value" "pass --interval <seconds>" ;;
    -*) die_usage "unknown option '$1'" "see push-actor-check --help" ;;
    *) [ -z "${BRANCH}" ] || die_usage "more than one branch given" "pass exactly one <branch>"; BRANCH=$1; shift ;;
  esac
done

[ -n "${BRANCH}" ] || die_usage "no branch given" "pass the branch you pushed: push-actor-check <branch>"
BRANCH=${BRANCH#refs/heads/}
case "${WINDOW}" in ''|*[!0-9]*) die_usage "--window '${WINDOW}' is not a whole number" "pass --window 0..300" ;; esac
case "${INTERVAL}" in ''|*[!0-9]*) die_usage "--interval '${INTERVAL}' is not a whole number" "pass --interval 1..60" ;; esac
WINDOW=$((10#${WINDOW})) INTERVAL=$((10#${INTERVAL}))   # `08` is decimal, not a bad octal
[ "${WINDOW}" -le 300 ] || die_usage "--window ${WINDOW} exceeds the 300s cap" "pass --window 300 or less"
[ "${INTERVAL}" -ge 1 ] && [ "${INTERVAL}" -le 60 ] || die_usage "--interval ${INTERVAL} is outside 1..60 (below 1 would spin)" "pass --interval 1..60"
command -v jq >/dev/null 2>&1 || die_usage "jq is required" "install jq"

[ -n "${REPO}" ] || die_usage "--repo needs a value" "pass --repo <path to the repo you pushed from>"
[ -d "${REPO}" ] || die_usage "--repo '${REPO}' is not a directory" "point --repo at the repo you pushed from"
git -C "${REPO}" rev-parse --git-dir >/dev/null 2>&1 || die_usage "'${REPO}' is not inside a git repository" "cd into the repo you pushed from, or pass --repo <path to it>"
if [ -z "${SHA}" ]; then
  SHA=$(git -C "${REPO}" rev-parse HEAD 2>/dev/null) || die_usage "cannot resolve HEAD in '${REPO}'" "pass --sha <the pushed sha>"
fi
grep -Eqx '[0-9a-f]{40}' <<<"${SHA}" || die_usage "--sha '${SHA}' is not a full 40-hex sha" "pass the full sha: git rev-parse <ref>"

URL=$(git -C "${REPO}" remote get-url --push "${REMOTE}" 2>/dev/null) || die_usage "no remote '${REMOTE}' in '${REPO}'" "pass --remote <name> for the remote you pushed to, or --repo <path> if '${REPO}' isn't the repo you pushed ${BRANCH} from"

# host + path from https://host/p, ssh://user@host[:port]/p, or user@host:p.
case "${URL}" in
  *://*) HP=${URL#*://}; HOST=${HP%%/*}; HOST=${HOST##*@}; HOST=${HOST%%:*}; PATH_=${HP#*/} ;;
  *:*)   HOST=${URL%%:*}; HOST=${HOST##*@}; PATH_=${URL#*:} ;;
  *)     HOST=""; PATH_="" ;;
esac
HOST=$(printf '%s' "${HOST}" | tr 'A-Z' 'a-z')
PATH_=${PATH_#/}; PATH_=${PATH_%/}; PATH_=${PATH_%.git}

GH_BIN=${PUSH_ACTOR_CHECK_GH:-gh}
GLAB_BIN=${PUSH_ACTOR_CHECK_GLAB:-glab}

case "${HOST}" in
  github.com)
    FORGE=github; EXPECT='athena-harness[bot]'
    ENC_B=$(jq -rn --arg b "refs/heads/${BRANCH}" '$b | @uri')
    read_events() { "${GH_BIN}" api "repos/${PATH_}/activity?ref=${ENC_B}&per_page=30"; }
    ACTOR_JQ='if type != "array" then error("not an array") else
      first(.[] | select(.ref == ("refs/heads/" + $b) and .after == $s) | .actor.login) // "" end' ;;
  gitlab.com)
    FORGE=gitlab; EXPECT='athena-amby'
    ENC=$(printf '%s' "${PATH_}" | sed 's#/#%2F#g')
    read_events() { "${GLAB_BIN}" api "projects/${ENC}/events?action=pushed&per_page=50"; }
    ACTOR_JQ='if type != "array" then error("not an array") else
      first(.[] | select(.push_data.ref == $b and .push_data.commit_to == $s) | .author.username) // "" end' ;;
  *)
    die_usage "remote '${REMOTE}' (host '${HOST:-unparsed}') is on neither github.com nor gitlab.com" \
      "run this only for a push to github.com or gitlab.com; pass --remote for the right remote" ;;
esac

# ---- repo/branch resolution check (DND-451) --------------------------------
# Its own step, run BEFORE any events read: assert <branch> actually exists on
# the resolved remote and <sha> is its remote head. A wrong --repo/cwd resolves
# a real but unrelated remote (e.g. an unrelated github.com project) — without
# this check that reads as "no event found" (exit 4), a push-attribution
# failure, rather than "wrong repo" (exit 5). The two must stay textually and
# exit-code distinct.
die_resolve() { printf 'push-actor-check: %s\nFix: %s\n' "$1" "$2" >&2; exit 5; }
RESOLVE_FIX="push-actor-check resolved remote '${REMOTE}' to ${URL} from repo '${REPO}' (cwd unless --repo was given). If that is not the repo you pushed ${BRANCH} from, pass --repo <path> or cd there first."

GIT_BIN=${PUSH_ACTOR_CHECK_GIT:-git}
LS_ERRF=$(mktemp) || die_usage "mktemp failed" "check TMPDIR is writable"
LSOUT=$("${GIT_BIN}" -C "${REPO}" ls-remote "${REMOTE}" "refs/heads/${BRANCH}" 2>"${LS_ERRF}")
LSRC=$?
LSERR=$(tr '\n' ' ' < "${LS_ERRF}" | cut -c1-300)
rm -f "${LS_ERRF}"

if [ "${LSRC}" -eq 0 ] && [ -z "${LSOUT}" ]; then
  die_resolve "branch '${BRANCH}' not on remote '${REMOTE}' (${URL})" "${RESOLVE_FIX}"
elif [ "${LSRC}" -ne 0 ]; then
  die_resolve "could not verify '${BRANCH}' on remote '${REMOTE}' (${URL}): ${LSERR:-git ls-remote exited ${LSRC}}" \
    "${RESOLVE_FIX} If the remote is reachable, this is a transient read error — retry."
fi

REMOTE_HEAD=$(printf '%s' "${LSOUT}" | head -1 | cut -f1)
if [ "${REMOTE_HEAD}" != "${SHA}" ]; then
  die_resolve "sha '${SHA}' is not the head of '${BRANCH}' on remote '${REMOTE}' (${URL}); remote head is '${REMOTE_HEAD}'" "${RESOLVE_FIX}"
fi

ERRF=$(mktemp) || die_usage "mktemp failed" "check TMPDIR is writable"
trap 'rm -f "${ERRF}"' EXIT
START=$(date +%s)
MAX_READS=$(( WINDOW / INTERVAL + 2 ))
READS=0 OK_READS=0 LAST_ERR=""
while :; do
  READS=$((READS + 1))
  # stderr apart from stdout, so a CLI warning cannot corrupt the JSON.
  if RAW=$(read_events 2>"${ERRF}") && ACTOR=$(printf '%s' "${RAW}" | jq -r --arg b "${BRANCH}" --arg s "${SHA}" "${ACTOR_JQ}" 2>/dev/null); then
    OK_READS=$((OK_READS + 1))
    if [ -n "${ACTOR}" ]; then
      if [ "${ACTOR}" = "${EXPECT}" ]; then
        printf 'push-actor-check: %s %s %s pushed by %s (read %d)\n' "${FORGE}" "${BRANCH}" "${SHA}" "${ACTOR}" "${READS}"
        exit 0
      fi
      printf 'push-actor-check: %s %s %s was pushed by %s, not %s.\nFix: this push did not go out as Athena. Stop and escalate to your admiral with the push command, this output and the intent (athena:github -> "When a forge write can'"'"'t be done as Athena"). Do not re-push as the owner.\n' \
        "${FORGE}" "${BRANCH}" "${SHA}" "${ACTOR}" "${EXPECT}" >&2
      exit 1
    fi
  else
    LAST_ERR=$(cat "${ERRF}" - <<<"${RAW:-}" | tr '\n' ' ' | cut -c1-300)
  fi
  NOW=$(date +%s)
  if [ $((NOW - START)) -ge "${WINDOW}" ] || [ "${READS}" -ge "${MAX_READS}" ]; then break; fi
  sleep "${INTERVAL}"
done

if [ "${OK_READS}" -eq 0 ]; then
  printf 'push-actor-check: could not read the %s events API in %d read(s) over %ds; cannot tell who pushed %s %s. Last error: %s\nFix: check the read works by hand (plain gh/glab, e.g. `%s`); if it is an auth error, escalate to your admiral — never run a login/refresh. This is NOT evidence the push was or was not Athena.\n' \
    "${FORGE}" "${READS}" "${WINDOW}" "${BRANCH}" "${SHA}" "${LAST_ERR:-none}" \
    "$([ "${FORGE}" = github ] && echo "gh api repos/${PATH_}/activity?per_page=3" || echo "glab api projects/${ENC}/events?action=pushed&per_page=5")" >&2
  exit 3
fi
printf 'push-actor-check: no event for %s %s on %s after %d read(s) over %ds.\nFix: confirm the push succeeded and the sha is the one pushed (git ls-remote %s refs/heads/%s). If it did, re-run with a longer --window; if the event never appears, treat the push as not verified as Athena and escalate to your admiral.\n' \
  "${BRANCH}" "${SHA}" "${FORGE}" "${READS}" "${WINDOW}" "${REMOTE}" "${BRANCH}" >&2
exit 4
