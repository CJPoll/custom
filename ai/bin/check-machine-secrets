#!/usr/bin/ruby
# frozen_string_literal: true

# check-machine-secrets -- is every per-machine secret on this machine kept per
# the practice? (DND-845). Contract: ai/contracts/athena-machine-secrets.md.
#
# Four probes, each naming the state it fires in:
#   (a) live env         a secret in THIS process's env (the caller's, so a
#                        session's); names read from ENV.keys, never `env`
#   (b) static config    an assignment of a secret in a shell init file,
#                        settings.json env, or a ~/.claude.json MCP server
#   (c) declared files   each registry entry (public + landed + overlay):
#                        a regular file, owned by you, 0600/0400
#   (d) plaintext        a credential value in an ai-artifacts/ tree, and
#                        core dumps under ~/dev (path and size only)
#
# THE ONE PROPERTY: output never contains a value. Every line names a
# variable, a path, a mode, a size or a count.
#
# Its own bar (the env allowlist, and the registry for probe (c)) is read as
# LANDED on origin/main via ai/lib/landed.rb, so a branch cannot excuse itself.
#
# Bucket placement: Manager + Framework. Side effects are
# ai/lib/machine_secrets_host.rb; rules are ai/lib/machine_secrets.rb.
# Tests: ai/test/machine-secrets/self-test.sh.
#
# ROLLOUT: not in harness-gate, and its hook (ai/hooks/secret-env-warn.sh) not
# registered, until the migration's final step (contract -> Rollout).

require_relative "../lib/strict_argv"
require_relative "../lib/machine_secrets_host"

HELP = <<~HELP
  check-machine-secrets -- check this machine's per-machine secrets (DND-845)

  Usage:
    check-machine-secrets                 run probes a, b, c and d
    check-machine-secrets --probe a,c     run only the probes named
    check-machine-secrets --probe a --brief
                                          one line per reported env name, nothing
                                          when clean (the SessionStart hook's form)
    check-machine-secrets --help          this text (stdout, exit 0, no side effects)

  Probes:
    a  live env: a credential NAME or VALUE in this process's environment
    b  static config: a secret assigned in a shell init file, ~/.claude/settings.json
       env, or a ~/.claude.json MCP server (env, headers, args, url). Records each
       export it sees in $XDG_STATE_HOME/athena/machine-secrets/exports.json
    c  declared files: every entry of ai/secrets/registry.json (working tree and
       as landed) and the private overlay's overlay/secrets.json
    d  persistent plaintext: credential values under the ai-artifacts/ trees of
       this repo and every inbox-registry repo; core dumps under ~/dev

  Exit codes:
    0  clean (PENDING RESTART and "not provisioned here" lines are informational)
    1  a finding
    2  usage error
    3  could not measure (a finding wins the exit code; both are printed)

  Output never contains a secret value. Contract:
  ai/contracts/athena-machine-secrets.md
HELP

PROBES = %w[a b c d].freeze
FIX_EXPORT = "move %<name>s's value to a 0600 file (ai/contracts/athena-machine-secrets.md -> " \
             "Adding a secret), load it with with-secret or a _FILE path, delete the export at " \
             "%<where>s, then restart the terminal and every Claude session started from it."

# Collects lines and the three outcome counts.
class Report
  attr_reader :lines, :findings, :unmeasured

  def initialize
    @lines = []
    @findings = 0
    @unmeasured = 0
  end

  def say(line) = @lines << line

  def finding(line, fix)
    @findings += 1
    @lines << "  FAIL  #{line}"
    @lines << "        Fix: #{fix}"
  end

  def unmeasured!(line, fix)
    @unmeasured += 1
    @lines << "  COULD NOT MEASURE  #{line}"
    @lines << "        Fix: #{fix}"
  end

  # One line, fix inline: the SessionStart hook's form.
  def brief(kind, line, fix)
    @findings += 1 if kind == :finding
    @unmeasured += 1 if kind == :unmeasured
    @lines << (fix ? "secret-env-warn: #{line.strip} Fix: #{fix}" : "secret-env-warn: #{line.strip}")
  end

  def absorb(other)
    @lines.concat(other.lines)
    @findings += other.findings
    @unmeasured += other.unmeasured
  end

  def exit_code
    return 1 if @findings.positive?
    return 3 if @unmeasured.positive?

    0
  end
end

# The landed bar, read once. -> { honoured:, working:, landed_registries: } plus,
# when it could not be read, landed_cause: (the failed step) and landed_fix:.
def load_bar(report)
  working = MachineSecrets.parse_allowlist(MachineSecretsHost.working_file(MachineSecretsHost::ALLOWLIST_REL),
                                           MachineSecretsHost::ALLOWLIST_REL)
  begin
    landed = MachineSecretsHost.landed
    honoured = MachineSecrets.effective_allowlist(working, landed[:allowlists])
    note = landed[:allowlists].empty? ? "not landed yet, so no entry is honoured" : "honoured as landed (#{Landed.describe(landed[:points])})"
    report.say("allowlist: #{note}")
    { honoured: honoured, working: working, landed_registries: landed[:registries] }
  rescue Landed::Unreadable => e
    report.say("allowlist: the landed bar could not be read, so no entry is honoured:")
    Landed.unreadable_lines("env allowlist", e.probes).each { |l| report.say(l) }
    cause, fix = unreadable_cause(e.probes)
    { honoured: nil, working: working, landed_registries: nil, landed_cause: cause, landed_fix: fix }
  rescue Landed::Mismatch => e
    report.say("allowlist: the landed bar could not be read, so no entry is honoured:")
    Landed.mismatch_lines(e.local, e.remote, e.source).each { |l| report.say(l) }
    cause = "local #{Landed::REF} #{e.local.to_s[0, 12]} is not origin's main #{e.remote.to_s[0, 12]} " \
            "(#{e.source}): origin moved since the last fetch, or the local ref was moved by hand"
    { honoured: nil, working: working, landed_registries: nil, landed_cause: cause,
      landed_fix: "git fetch origin, then re-run ai/bin/check-machine-secrets" }
  end
end

# The failed step of an Unreadable landed read (the last probe) and the Fix
# for THAT step. A Fix that names a different cause sends the reader to repair
# the wrong thing (a stale ref once read as "make origin reachable").
def unreadable_cause(probes)
  step, outcome = probes.last
  cause = "#{step} -> #{outcome}"
  fix = case step
        when Landed::LS_REMOTE_PROBE, Landed::FETCH_PROBE
          "make origin reachable (network, remote URL, credentials), then re-run ai/bin/check-machine-secrets; it never falls back to the local ref"
        when Landed::REF
          "git fetch origin main, then re-run ai/bin/check-machine-secrets"
        when "history depth"
          "git fetch --unshallow, then re-run ai/bin/check-machine-secrets"
        when Landed::PIN_PROBE
          "unset #{Landed::PIN_SHA_ENV} and #{Landed::PIN_REPO_ENV} (harness-gate sets them itself), then re-run"
        else
          "repair the failed step named here (the allowlist lines above list every probe and its Fix), then re-run"
        end
  [cause, fix]
end

def still_assigned?(name, file)
  return false unless File.file?(file)

  # Judge presence with nothing excused: the question is whether the file
  # still assigns the name at all.
  MachineSecretsHost.scan_static(file, nil).any? { |_loc, n| n == name }
rescue MachineSecrets::Malformed, SystemCallError
  true
end

def probe_a(report, bar, brief)
  hits = MachineSecrets.env_hits(ENV.to_h, bar[:honoured], bar[:working], MachineSecretsHost.path_exists_fn)
  records, rec_err = MachineSecretsHost.read_exports
  start, start_note = MachineSecretsHost.session_start
  counts = Hash.new(0)
  body = []
  hits.each do |hit|
    why = hit.reason == :name ? "its name is a credential name" : "its value has a credential prefix"
    if hit.status == :unverified
      counts[:unverified] += 1
      body << [:unmeasured, "#{hit.name}: #{why}; only the working tree's allowlist excuses it, and the landed one " \
                            "could not be read (#{bar[:landed_cause]})",
               bar[:landed_fix]]
      next
    end
    mine = rec_err ? [] : records.select { |r| r["name"] == hit.name }
    verdict, detail = MachineSecrets.restart_verdict(
      mine, ->(f) { still_assigned?(hit.name, f) }, ->(f) { MachineSecretsHost.mtime_l(f) }, start,
      ->(f) { MachineSecretsHost.tilde(f) }
    )
    if verdict == :pending
      counts[:pending] += 1
      body << [:say, "  PENDING RESTART  #{hit.name}: its export at #{MachineSecretsHost.tilde(detail['file'])}:#{detail['line']} " \
                     "was removed after this session started (#{start_note}); restart the terminal and this session"]
    else
      counts[:finding] += 1
      where = mine.empty? ? "the file that exports it (probe b names it)" : mine.map { |r| "#{MachineSecretsHost.tilde(r['file'])}:#{r['line']}" }.join(", ")
      detail = "#{detail}; exports record unreadable: #{rec_err}" if rec_err
      body << [:finding, "#{hit.name} is in this process's env: #{why} (#{detail})", format(FIX_EXPORT, name: hit.name, where: where)]
    end
  end
  if brief
    body.each { |kind, line, fix| report.brief(kind, line, fix) }
    return
  end
  report.say("[a] live env: #{ENV.size} variable(s) read by name: #{counts[:finding]} finding(s), " \
             "#{counts[:pending]} pending restart, #{counts[:unverified]} unverified")
  body.each do |kind, line, fix|
    case kind
    when :say then report.say(line)
    when :finding then report.finding(line, fix)
    else report.unmeasured!(line, fix)
    end
  end
end

def probe_b(report, bar)
  files = MachineSecretsHost.shell_init_files + MachineSecretsHost.json_files
  seen = []
  body = Report.new
  files.each do |file|
    shown = MachineSecretsHost.tilde(file)
    hits = begin
      MachineSecretsHost.scan_static(file, bar[:honoured])
    rescue MachineSecrets::Malformed, SystemCallError => e
      body.unmeasured!("#{shown} could not be scanned (#{e.message.sub(file, shown)})", "repair or make readable #{shown}, then re-run")
      next
    end
    hits.each do |loc, name|
      seen << [name, file, loc]
      body.finding("#{shown}:#{loc} #{name}", format(FIX_EXPORT, name: name, where: "#{shown}:#{loc}"))
    end
    mode = begin
      File.stat(file).mode & 0o777
    rescue SystemCallError => e
      body.unmeasured!("#{shown}'s mode could not be read (#{e.class.name.split('::').last})", "re-run; if the file is gone, its findings above are stale")
      next
    end
    if !hits.empty? && (mode & 0o044) != 0
      body.finding(format("%s is mode %04o (group- or world-readable) and holds a finding", shown, mode), "chmod 600 #{shown}")
    end
  end
  err = seen.empty? ? nil : MachineSecretsHost.record_exports(seen)
  body.unmeasured!("the exports record was not written: #{err}", "make the state directory writable and re-run") if err
  report.say("[b] static config: #{files.size} file(s) scanned: #{body.findings} finding(s)")
  report.absorb(body)
rescue MachineSecrets::Malformed => e
  report.unmeasured!("[b] static config: #{e.message}", "run with HOME set to your absolute home directory")
end

def check_one(report, name, path, counts)
  res = MachineSecretsHost.check_secret_file(path)
  case res[:state]
  when :ok then report.say("  ok    #{name} #{res[:shown]}")
  when :absent
    counts[:absent] += 1
    report.say("  not provisioned here: #{name} (#{res[:shown]})")
  else
    counts[:bad] += 1
    report.finding("#{name} #{res[:shown]}: #{res[:problem]}", res[:fix] || "replace #{res[:shown]} with a regular 0600 file owned by you")
  end
end

def probe_c(report, bar)
  working = MachineSecrets.parse_registry(MachineSecretsHost.working_file(MachineSecretsHost::REGISTRY_REL),
                                          MachineSecretsHost::REGISTRY_REL)
  overlay, overlay_state = MachineSecretsHost.overlay_registry
  landed = bar[:landed_registries]
  entries = MachineSecrets.union(working, *Array(landed), *Array(overlay))
  public_names = (working + Array(landed).flatten).map(&:name)
  clash = (public_names & Array(overlay).map(&:name)).uniq
  clash.each do |n|
    report.unmeasured!("#{n} is declared in both the public registry and the overlay's; a name is unique across the two",
                       "rename or remove one of the two entries (ai/contracts/athena-machine-secrets.md -> The registry)")
  end
  overlay_note = case overlay_state
                 when :absent then "overlay absent"
                 when :present then "overlay #{overlay.size}"
                 else "overlay MALFORMED"
                 end
  landed_note = landed.nil? ? "landed UNREADABLE" : "landed #{landed.sum(&:size)} across #{landed.size} point(s)"
  report.say("[c] declared files: #{entries.size} entr(ies) (working #{working.size}, #{landed_note}, #{overlay_note})")
  unless overlay_state.is_a?(Symbol)
    report.unmeasured!("the overlay's secrets are not checked: #{overlay_state}", "repair the private overlay (ai/bin/private-overlay status names the problem)")
  end
  if landed.nil?
    report.unmeasured!("the landed registry could not be read (#{bar[:landed_cause]}), so only the working tree's and the " \
                       "overlay's entries are checked", bar[:landed_fix])
  end
  counts = Hash.new(0)
  home = MachineSecretsHost.home
  entries.each do |e|
    begin
      path = MachineSecrets.expand(e.path, home)
    rescue MachineSecrets::Malformed => err
      report.unmeasured!("#{e.name}: #{err.message}", "run with HOME set to your absolute home directory")
      next
    end
    check_one(report, e.name, path, counts)
    next unless e.copies

    pattern = MachineSecrets.expand(e.copies, home)
    matches = MachineSecretsHost.glob(pattern)
    before = counts[:bad]
    matches.each do |m|
      res = MachineSecretsHost.check_secret_file(m)
      next if res[:state] == :ok

      counts[:bad] += 1
      report.finding("#{e.name} copy #{res[:shown]}: #{res[:problem] || 'vanished while checked'}",
                     res[:fix] || "make #{res[:shown]} a symlink to the primary, or install -m 600 it")
    end
    report.say("  copies #{e.name} #{e.copies}: #{matches.size} matched, #{counts[:bad] - before} violator(s)")
  end
rescue MachineSecrets::Malformed => e
  report.unmeasured!("[c] declared files: registry #{e.message}", "repair the registry named above (schema: ai/contracts/athena-machine-secrets.md -> The registry)")
rescue SystemCallError => e
  report.unmeasured!("[c] declared files: the registry could not be read (#{e.class.name.split('::').last})", "restore ai/secrets/registry.json")
end

def probe_d(report)
  roots, notes = MachineSecretsHost.scan_roots
  dirs = roots.flat_map { |r| MachineSecretsHost.artifact_dirs(r) }
  scanned = 0
  skipped = 0
  unreadable = []
  hits = []
  dirs.each do |d|
    skipped += MachineSecretsHost.walk(d) do |path, _st|
      scanned += 1
      got = MachineSecretsHost.file_has_credential?(path)
      unreadable << path if got.nil?
      hits << path if got
    end
  end
  report.say("[d] persistent plaintext: roots #{roots.map { |r| MachineSecretsHost.tilde(r) }.join(', ')}")
  notes.each { |n| report.say("  #{n}") }
  report.say("  ai-artifacts dir(s): #{dirs.empty? ? '(none)' : dirs.map { |d| MachineSecretsHost.tilde(d) }.join(', ')}")
  report.say("  #{scanned} file(s) scanned, #{skipped} dir(s) skipped (#{MachineSecretsHost::SKIP_DIRS.join(', ')}), #{hits.size} finding(s)")
  hits.each do |p|
    report.finding(MachineSecretsHost.tilde(p), "delete #{MachineSecretsHost.tilde(p)}, or redact the value in it; if the value was ever readable elsewhere, rotate it (Rotating a secret).")
  end
  unreadable.each { |p| report.unmeasured!("#{MachineSecretsHost.tilde(p)} could not be read", "make it readable, then re-run") }

  dev = File.join(MachineSecretsHost.home.to_s, "dev")
  cores = []
  cskipped = File.directory?(dev) ? MachineSecretsHost.walk(dev) { |p, st| cores << [p, st.size] if MachineSecretsHost.core_dump?(p, st) } : 0
  report.say("  core dumps under #{MachineSecretsHost.tilde(dev)}: #{cores.size} found (#{cskipped} dir(s) skipped)")
  cores.each do |p, size|
    report.finding("core dump #{MachineSecretsHost.tilde(p)} (#{size} bytes)",
                   "delete #{MachineSecretsHost.tilde(p)} (a core dump holds the process env); rotate any secret that was in that process's env.")
  end
rescue MachineSecrets::Malformed => e
  report.unmeasured!("[d] persistent plaintext: #{e.message}", "run from a checkout of the custom repo with ai/inbox/registry.json intact")
end

def main(argv)
  if argv.include?("--help") || argv.include?("-h")
    puts HELP
    return 0
  end
  opts = StrictArgv.parse(argv, { "--probe" => :value, "--brief" => :switch })
  probes = (opts["--probe"] || PROBES.join(",")).split(",").map(&:strip)
  bad = probes - PROBES
  raise StrictArgv::UsageError, "unknown probe(s) #{bad.join(',')} (want a subset of a,b,c,d)" unless bad.empty? && !probes.empty?

  brief = opts["--brief"]
  raise StrictArgv::UsageError, "--brief needs --probe a alone" if brief && probes != ["a"]

  report = Report.new
  bar = load_bar(brief ? Report.new : report)
  probe_a(report, bar, brief) if probes.include?("a")
  probe_b(report, bar) if probes.include?("b")
  probe_c(report, bar) if probes.include?("c")
  probe_d(report) if probes.include?("d")
  unless brief
    verdict = { 0 => "CLEAN", 1 => "FINDINGS", 3 => "COULD NOT MEASURE" }[report.exit_code]
    report.say("check-machine-secrets: #{verdict} (#{report.findings} finding(s), #{report.unmeasured} could-not-measure; probes #{probes.join(',')})")
  end
  puts report.lines
  report.exit_code
rescue StrictArgv::UsageError => e
  warn "check-machine-secrets: #{e.message}"
  warn "Fix: see check-machine-secrets --help; e.g. check-machine-secrets --probe a,b"
  2
rescue MachineSecrets::Malformed => e
  puts "check-machine-secrets: COULD NOT MEASURE: #{e.message}"
  puts "Fix: restore the named file from origin/main (git checkout origin/main -- <file>) or repair it per ai/contracts/athena-machine-secrets.md"
  3
end

exit main(ARGV)
