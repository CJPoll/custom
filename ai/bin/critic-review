#!/usr/bin/env ruby
# frozen_string_literal: true

# critic-review — run the standing read-only judge (athena-diff-critic) over the
# current change as a BLOCKING review step, and decide pass / block / fail-open.
#
# Promoted from advisory to blocking on 2026-09-16 after `critic-eval --run`
# cleared the trust bar (recall=1.0, precision=1.0 over 5 labeled fixtures; see
# ai/eval/critic-baseline.json).
#
# Decision semantics (the load-bearing part):
#   - critic reports FINDINGS -> BLOCK (exit 2): real issues must be addressed
#     before the change ships.
#   - critic reports "FINDINGS: none" -> PASS (exit 0).
#   - critic INFRA error (no `claude`, non-zero exit, or no FINDINGS trailer) ->
#     FAIL-OPEN (exit 0) with a LOUD Fix: note. A critic crash / model-call
#     failure must NEVER wedge an autonomous merge; it is surfaced, not silently
#     passed and not hard-blocked.
#
# The critic is READ-ONLY (as built): it inspects and reports, never edits.
#
# Model-in-loop: invoking the critic requires `claude`, so this is NOT part of
# the deterministic gate. Its --self-test (the decision + FINDINGS parser) IS
# deterministic and gate-safe.
#
# Verdict receipts (the load-bearing addition, 2026-09-20). Every completed run
# records its outcome at $GIT_DIR/critic-verdicts/<head-sha>.json, and marks
# <head-sha>.running for the duration. This exists so that a judge that NEVER
# RAN, FAIL-OPENED, or HAD NOT FINISHED YET is distinguishable from one that
# PASSED -- three states that were all "exit 0, nothing recorded" and therefore
# all read as a pass at the admiral's merge gate. Measured on
# 2026-09-19-slack-gensaas: DND-194 merged while the judge was still running
# (factual error landed on main, recovered by PR #41); DND-212's judge
# fail-opened twice and was caught only by the admiral's discretion.
# `integration-gate` reads these; see athena:merge-boarding -> "The merge bar".
#
# Usage: see the USAGE constant below, or run `ai/bin/critic-review --help`.
# It is stated once, there, so the text a caller is shown cannot drift from the
# text a reader of this header believes.
#
# Testing hook: CRITIC_REVIEW_STUB=<file> uses that file as the critic output
# instead of invoking `claude` (used by --self-test; also handy for a dry run).

require "open3"
require "json"
require "fileutils"
require "time"

AI_DIR = File.expand_path("..", __dir__)
require File.join(AI_DIR, "lib", "critic_prompt")

CRITIC = "athena-diff-critic"

USAGE = <<~TXT.freeze
  Usage:
    ai/bin/critic-review [--base BRANCH]   review HEAD's diff vs BRANCH (default
                                           origin/HEAD or main); exit 0 pass /
                                           2 block / 0 fail-open(loud). Invokes
                                           the model -- slow, and records a
                                           per-SHA verdict receipt.
    ai/bin/critic-review --verdict-for SHA read the RECORDED verdict for SHA;
                                           exit 0 pass / 2 block / 3 no green
                                           verdict (none / running / fail-open /
                                           stale-tree / malformed -- each named)
    ai/bin/critic-review --self-test       verify the decision, parser, and the
                                           receipt writer+reader (no model)
    ai/bin/critic-review --help            this text (never invokes the model)

  Testing hook: CRITIC_REVIEW_STUB=<file> uses that file as the critic output
  instead of invoking `claude` (used by --self-test; also handy for a dry run).

  Exit 64 means the ARGUMENTS were wrong; it is never a verdict.
TXT

# Flags this tool actually accepts. An argument outside these tables is REFUSED
# (exit 64), never ignored.
#
# It used to be ignored, and that is the defect this table exists to close: the
# dispatcher fell through to `run(ARGV)` for anything it did not recognise, so a
# typo'd flag -- or `--help`, which this tool did not implement -- silently
# started a full model-in-loop review of HEAD instead of erroring. Measured
# 2026-09-20 (DND-246/H-2): `--help` hung long enough that the captain's brief
# had to carry "do NOT run `ai/bin/critic-review --help` (hangs)" as prose, and
# the captain dutifully recorded not running it. A harness that documents a
# hang is a harness that has not fixed one. Confirmed by this shipwright:
# `timeout 10 ai/bin/critic-review --help </dev/null` exited 124.
#
# This is the CLI-argument instance of ~/dev/custom/CLAUDE.md -> "A failed
# lookup must never look like an empty one": an unrecognised key must not
# resolve to the most expensive default action and report nothing about it.
VALUE_FLAGS = %w[--base --verdict-for].freeze
BOOL_FLAGS  = %w[--self-test --help -h].freeze

# -> nil when argv is well-formed, else a one-line reason.
#
# A value-taking flag's value must be present and must not itself look like a
# flag, so `--verdict-for` with a forgotten SHA is an error rather than a
# lookup of the empty string.
def usage_error(argv)
  i = 0
  while i < argv.length
    arg = argv[i]
    if VALUE_FLAGS.include?(arg)
      nxt = argv[i + 1]
      return "#{arg} requires a value." if nxt.nil? || nxt.start_with?("-")
      i += 2
    elsif BOOL_FLAGS.include?(arg)
      i += 1
    else
      return "unrecognised argument #{arg.inspect}."
    end
  end
  nil
end

def parse_findings(text)
  line = text.to_s.lines.reverse.find { |l| l =~ /^\s*FINDINGS:/i }
  return [nil, false] unless line # no trailer -> not a valid critic result
  body = line.sub(/^\s*FINDINGS:/i, "").strip
  return [[], true] if body.empty? || body.casecmp?("none")
  [body.split(",").map { |s| s.strip.downcase }.reject(&:empty?), true]
end

# decide -> [action, exit_code]
#   action: "pass" | "block" | "fail-open"
def decide(findings, trailer_ok, invoke_ok)
  return ["fail-open", 0] unless invoke_ok && trailer_ok
  return ["pass", 0] if findings.empty?
  ["block", 2]
end

VERDICT_SCHEMA = 1

# Resolving the receipt directory is its OWN step with its OWN outcome.
# `git rev-parse --git-path` returns a CWD-RELATIVE path in a main checkout and
# an absolute one only in a worktree (CLAUDE.md -> "A failed lookup must never
# look like an empty one" -- the DND-183/DND-202 instance). It is expanded
# against the repo root HERE, at the point of capture, and never re-resolved.
# Unresolvable is nil (an error to the caller), never a silent empty.
def verdict_dir
  root, _e, s1 = Open3.capture3("git", "rev-parse", "--show-toplevel")
  raw,  _e2, s2 = Open3.capture3("git", "rev-parse", "--git-path", "critic-verdicts")
  return nil unless s1.success? && s2.success?
  return nil if root.strip.empty? || raw.strip.empty?
  File.expand_path(raw.strip, root.strip)
end

def head_sha
  out, _e, st = Open3.capture3("git", "rev-parse", "--verify", "HEAD^{commit}")
  (st.success? && out.strip =~ /\A[0-9a-f]{40}\z/) ? out.strip : nil
end

def tree_dirty?
  out, _e, st = Open3.capture3("git", "status", "--porcelain")
  !st.success? || !out.strip.empty?
end

def mark_running(sha)
  dir = verdict_dir
  return unless dir && sha
  FileUtils.mkdir_p(dir)
  File.write(File.join(dir, "#{sha}.running"), Time.now.utc.iso8601)
end

# The critic's REPORT BODY, persisted beside the verdict.
#
# The receipt records the finding CATEGORIES (`findings`), which is all the
# admiral's merge gate needs. The body -- the actual text saying what is wrong
# -- was printed to stderr and kept nowhere. A caller who captured that stderr
# through `| tail -N`, `| head -N`, or a truncating tool therefore destroyed the
# only copy, and the sole recovery was another full model-in-loop run.
#
# Measured on 2026-09-20-notif-platform, three times in ONE run: two truncated
# captures caught by the recorded-verdict check, and one -- state.md, "ONE
# finding captured (my bg cmd truncated stdout via tail -20) ... CORRECTNESS
# finding body LOST to truncation" -- where the body was gone for good. The run
# coined a rule for it ("never trust a tail-truncated critic read"), and a prior
# run had already recorded the same class in memory. A rule telling agents not
# to truncate does not survive contact with a background command; a file does.
#
# Returns the path written, or nil. nil is reported by the caller, never
# silently swallowed -- a report that was not recorded must not read like one
# that was.
def write_report(sha, text)
  dir = verdict_dir
  return nil unless dir && sha
  path = File.join(dir, "#{sha}.report.txt")
  FileUtils.mkdir_p(dir)
  File.write(path, text.to_s)
  path
rescue StandardError
  nil
end

# The pointer is printed LAST, deliberately.
#
# `tail -N` keeps the END of a stream and `head -N` keeps the START, so no
# single position survives both. The END is the one that survives the form
# actually measured hurting us (every one of the three instances above was a
# `tail`), and it is also what a terminal leaves on screen. A caller who sees
# only the last line still learns where the whole report is.
def warn_report_pointer(path, sha)
  if path
    warn ""
    warn "critic-review: FULL REPORT RECORDED AT #{path}"
    warn "  Fix: read that file (`cat #{path}`) rather than re-running the judge — if the output"
    warn "  above reached you truncated (a pipe through tail/head, a capture bound, a background"
    warn "  command), the file is the complete body and re-running costs another model round."
  else
    warn ""
    warn "critic-review: NOTE the report body was NOT recorded to disk#{sha ? '' : ' (no resolvable HEAD)'}."
    warn "  Fix: the text above is the ONLY copy — capture it whole now, without piping through"
    warn "  tail/head. Then run the judge from the Mission's worktree so the next round records a report."
  end
end

def write_verdict(sha, base, action, findings, dirty)
  dir = verdict_dir
  unless dir && sha
    warn "critic-review: NOTE no verdict receipt written (not inside a resolvable git work tree)."
    warn "  Fix: run the judge from the Mission's worktree, or the admiral's integration-gate will see no verdict for this head and refuse the merge."
    return false
  end
  FileUtils.mkdir_p(dir)
  File.write(File.join(dir, "#{sha}.json"), JSON.generate(
    "schema" => VERDICT_SCHEMA, "tool" => "critic-review", "sha" => sha,
    "base" => base.to_s, "verdict" => action, "findings" => findings,
    "dirty" => dirty, "at" => Time.now.utc.iso8601
  ))
  FileUtils.rm_f(File.join(dir, "#{sha}.running"))
  true
end

# Reader. THE ONE PLACE the rules live -- integration-gate calls this rather
# than parsing the JSON itself, so there is never a second copy of the
# semantics that could drift from the writer's.
#   0 = recorded PASS for exactly this sha, on a clean tree
#   2 = recorded BLOCK
#   3 = no green verdict; the REASON is always named on stderr
def verdict_for(sha)
  unless sha.to_s =~ /\A[0-9a-f]{7,40}\z/
    warn "critic-review: --verdict-for needs a commit SHA (got #{sha.inspect})."
    warn "  Fix: pass the 40-char SHA of the head you intend to merge, e.g. --verdict-for $(git rev-parse HEAD)."
    return 3
  end
  dir = verdict_dir
  unless dir
    warn "critic-review: cannot resolve the verdict directory (not inside a git work tree)."
    warn "  Fix: run this from the Mission's worktree. An unresolvable verdict store is an ERROR, never a pass."
    return 3
  end
  full = Dir.glob(File.join(dir, "#{sha}*.json")).first
  unless full
    if (run = Dir.glob(File.join(dir, "#{sha}*.running")).first)
      warn "critic-review: NO VERDICT for #{sha} — a judge run is IN PROGRESS (started #{File.read(run).strip})."
      warn "  Fix: wait for that run to finish, then re-read. Do NOT merge while the judge is still running (DND-194 landed a factual error on main exactly this way). If the run is a corpse, re-run ai/bin/critic-review in this worktree."
      return 3
    end
    warn "critic-review: NO VERDICT for #{sha} — the standing judge has NOT run on this head."
    warn "  Fix: run ~/dev/custom/ai/bin/critic-review in this worktree to produce a verdict for #{sha}. A verdict recorded for a DIFFERENT commit does not count; 'no verdict' is not a pass."
    return 3
  end
  data = begin
    JSON.parse(File.read(full))
  rescue StandardError => e
    warn "critic-review: verdict receipt for #{sha} is unreadable (#{e.message})."
    warn "  Fix: delete #{full} and re-run ai/bin/critic-review. A corrupt receipt is an error, never a pass."
    return 3
  end
  if data["dirty"]
    warn "critic-review: the verdict for #{sha} was recorded against a DIRTY working tree — it did not judge what you are about to merge."
    warn "  Fix: commit or discard the working-tree changes, then re-run ai/bin/critic-review so the verdict matches the head being merged."
    return 3
  end
  case data["verdict"]
  when "pass"
    puts "critic-review: VERDICT PASS for #{sha} (recorded #{data['at']}, base #{data['base']})."
    0
  when "block"
    warn "critic-review: VERDICT BLOCK for #{sha} — findings: #{Array(data['findings']).join(', ')}"
    warn "  Fix: the standing judge found issues on this head. Have them addressed and re-run ai/bin/critic-review before merging."
    2
  when "fail-open"
    warn "critic-review: NO VERDICT for #{sha} — the judge FAILED OPEN (infra/model error) at #{data['at']}; it did not look at this diff."
    warn "  Fix: re-run ai/bin/critic-review in this worktree. If it fails open again the model is unreachable — HOLD this one MR and move to the next Mission, or take the named escape hatch (integration-gate --critic-override '<reason>'). A fail-open is not a pass."
    3
  else
    warn "critic-review: verdict receipt for #{sha} records an unknown verdict #{data['verdict'].inspect}."
    warn "  Fix: delete #{full} and re-run ai/bin/critic-review."
    3
  end
end

# The round at which the per-cluster rungs stop being the bound and a kind-3
# finding routes to the ARTIFACT-scope decision instead (athena:critic-convergence
# -> "After the escalation"). Both measured loops that RESOLVED took eight rounds,
# so a ceiling at or below 8 is a false positive costing a needless descope; the
# loop that did NOT resolve was at round 13 when its admiral had to invent the
# closure pass unaided. This is NOT the cluster trigger -- that stays at one
# kind-3 with no round threshold.
ARTIFACT_CEILING_ROUND = 12

# How many judge rounds this worktree has recorded, and which SHAs they were.
# The receipt dir is per-worktree (`git rev-parse --git-path` resolves against
# the worktree's own $GIT_DIR) and a worktree is ONE unit of work (repo
# CLAUDE.md -> "Agents work in worktrees"), so every receipt in it belongs to
# this change.
#
# Counted from the DIRECTORY, deliberately NOT from `git rev-list base..HEAD`:
# a rebase rewrites the round SHAs and orphans every earlier receipt, so an
# ancestry-based count would silently read LOW -- a wrongly-computed key
# indistinguishable from a legitimately empty one (ai/CLAUDE.md -> "A failed
# lookup must never look like an empty one"). DND-232 rebased twice mid-loop.
#
# Returns [count, shas] or nil. nil is an ERROR the caller must say out loud,
# never a silent "round 1".
def rounds_recorded
  dir = verdict_dir
  return nil unless dir && Dir.exist?(dir)
  shas = Dir.glob(File.join(dir, "*.json")).map { |p| File.basename(p, ".json") }.sort
  [shas.size, shas]
end

# Printed on a BLOCK only. This adds OUTPUT to a path that already exits 2 --
# it can never block something that did not already block, and never unblocks
# anything. Deliberate: a gate that went red on round count would create
# pressure toward exactly the override this discipline forbids.
def warn_round_notice(sha)
  rounds = rounds_recorded
  if rounds.nil?
    warn "  NOTE: ROUND NUMBER UNKNOWN — the verdict store could not be resolved, so this may not be round 1."
    warn "  Fix: re-run from the Mission's worktree so rounds are counted. If this is round 2+, apply the `athena:critic-convergence` skill before patching."
    return
  end
  n, shas = rounds
  return if n < 2
  prior = (shas - [sha]).map { |s| s[0, 7] }.join(", ")
  warn ""
  warn "  ROUND #{n} on this change (#{n - 1} earlier judge verdict(s) here: #{prior})."
  warn "  Fix: BEFORE patching these findings one at a time, run the convergence check in the"
  warn "  `athena:critic-convergence` skill. If ANY finding above exists only because of an"
  warn "  earlier round's own fix AND is a contradiction / unsatisfiability / unreachability"
  warn "  (not a stale name or citation), stop per-finding patching and run a CLUSTER ROUND."
  warn "  Two independent EIGHT-round loops (2026-09-19 athena:inbox, 2026-09-20 DND-232) were"
  warn "  exactly this, caught five rounds late. Round count is NEVER a reason to override the"
  warn "  judge, defer a finding, or merge with findings open."
  return if n < ARTIFACT_CEILING_ROUND
  warn ""
  warn "  ARTIFACT CEILING — round #{n} is at or past #{ARTIFACT_CEILING_ROUND}. The cluster rungs are per-cluster, so a"
  warn "  large artifact otherwise buys one trip up the ladder per cluster and never stops."
  warn "  Fix: a kind-3 finding at this round no longer buys a cluster round, whatever rung its"
  warn "  own cluster is on — route it to the ARTIFACT-scope decision in `athena:critic-convergence`"
  warn "  -> `After the escalation`: land the coherent core (no kind-3) with the row-per-open-question"
  warn "  table and file the rest, or PARK. The core still lands only on FINDINGS: none."
end

# The change's commit messages, oldest first, for the judge's commit-msg input.
#
# `base..HEAD` is the same commit set as the diff's `base...HEAD` (both are
# "on HEAD, not on base"). An empty string means there really are no commits
# (e.g. a diff of uncommitted work); nil means the log could NOT be read, which
# is said out loud here and reaches the judge as "NOT SUPPLIED" -- never as an
# empty log, which would read as "no fix was claimed".
def commit_log(base)
  out, err, st = Open3.capture3("git", "log", "--reverse", "--format=commit %H%n%B", "#{base}..HEAD")
  return out if st.success?

  warn "critic-review: NOTE could not read the commit messages for #{base}..HEAD (#{err.strip})."
  warn "  Fix: pass a --base that resolves in this repo. Until then the judge cannot see a bug-fix claim or its evidence."
  nil
end

def critic_output(base)
  stub = ENV["CRITIC_REVIEW_STUB"]
  return [File.read(stub), true] if stub && File.file?(stub)

  return ["", false] unless system("command -v claude >/dev/null 2>&1")
  diff, _e, dst = Open3.capture3("git", "diff", "#{base}...HEAD")
  diff = Open3.capture3("git", "diff", base)[0] if !dst.success? || diff.strip.empty?
  prompt = CriticPrompt.build(diff: diff, commit_messages: commit_log(base))
  out, _err, st = Open3.capture3("claude", "-p", "--agent", CRITIC, stdin_data: prompt)
  [out, st.success?]
rescue StandardError => e
  [+"error: #{e.message}", false]
end

def default_base
  out, _e, st = Open3.capture3("git", "symbolic-ref", "refs/remotes/origin/HEAD")
  return out.strip.sub(%r{^refs/remotes/}, "") if st.success? && !out.strip.empty?
  "main"
end

def run(argv)
  base = (i = argv.index("--base")) ? argv[i + 1] : default_base
  sha = head_sha
  dirty = tree_dirty?
  mark_running(sha)
  raw, invoke_ok = critic_output(base)
  findings, trailer_ok = parse_findings(raw)
  action, code = decide(findings || [], trailer_ok, invoke_ok)
  write_verdict(sha, base, action, findings || [], dirty)

  case action
  when "pass"
    puts "critic-review: PASS — athena-diff-critic reported no findings on the diff vs #{base}."
  when "block"
    warn "critic-review: BLOCKED — athena-diff-critic found: #{findings.join(', ')}"
    # PRINT THE BODY, NOT A GREP OF IT.
    #
    # This was `raw.lines.grep(/^\s*-\s*\[/)`, which printed NOTHING whenever
    # the critic formatted a finding any other way -- a numbered list, a
    # "**MUST-FIX**" heading, a table. The caller was then told the judge had
    # found things in three categories and shown none of them. Measured on
    # DND-184: three consecutive BLOCKED runs whose findings were dropped
    # here, and the work could only continue by invoking the critic by hand.
    #
    # A filter that silently discards the only content that matters, and
    # reports success at doing so, is the defect class this judge exists to
    # catch, sitting in the judge's own runner.
    #
    # Everything above the FINDINGS trailer is the report, printed whole. The
    # trailer is dropped because the line above already names the categories.
    body = raw.to_s.lines
    trailer = body.rindex { |l| l =~ /^\s*FINDINGS:/i }
    body = body[0...trailer] if trailer
    text = body.join.strip
    warn(text.empty? ? "  (the critic returned a verdict with no body -- re-run to see it)" : text)
    warn "  Fix: address each finding above (or, if a finding is wrong, say why in the MR) before this change ships."
    warn_round_notice(sha)
    # The WHOLE raw output, trailer included -- this file is the archival copy,
    # not a second rendering of what was just printed.
    warn_report_pointer(write_report(sha, raw), sha)
  when "fail-open"
    warn "critic-review: FAIL-OPEN — the critic did not return a usable verdict (infra/model error); NOT blocking."
    warn "  Fix: re-run ai/bin/critic-review once `claude` is reachable; a human should eyeball this diff since the judge did not run."
    # A fail-open's raw output is the diagnosis (a model error, a partial answer,
    # a missing trailer) and is just as destroyable by a truncating capture.
    # Empty raw is its OWN state: there is no body to point at, and saying so is
    # not the same as pointing at a file that would be empty.
    if raw.to_s.strip.empty?
      warn "  NOTE the critic produced NO output at all, so there is no report to record."
    else
      warn_report_pointer(write_report(sha, raw), sha)
    end
  end
  code
end

# Capture $stderr around a block, returning [result, stderr_text].
def capture_err
  require "stringio"
  prev = $stderr
  $stderr = StringIO.new
  res = yield
  [res, $stderr.string]
ensure
  $stderr = prev
end

def capture_out
  require "stringio"
  prev = $stdout
  $stdout = StringIO.new
  res = yield
  [res, $stdout.string]
ensure
  $stdout = prev
end

# The receipt half of the suite. It runs inside a REAL throwaway git repo,
# because the writer/reader resolve their store through git -- running it in
# the live repo would both pollute $GIT_DIR and test the wrong tree.
#
# Every case here is a MISS case except the first: the whole point of the
# receipt is that "never ran" / "still running" / "fail-open" / "stale SHA"
# stop being indistinguishable from PASS, so a suite that only proved the
# PASS path would prove nothing about the defect this exists to catch.
def run_receipt_self_test
  require "tmpdir"
  ok = true
  stubs = Dir.mktmpdir("critic-review-stubs-")
  clean_out = File.join(stubs, "c"); File.write(clean_out, "looks good\nFINDINGS: none\n")
  findings_out = File.join(stubs, "f"); File.write(findings_out, "- [access-control] x.ex:1 — no authz\nFINDINGS: access-control\n")
  broken_out = File.join(stubs, "b"); File.write(broken_out, "the model crashed, no trailer here\n")

  # (8) unresolvable store: outside any git work tree, a missing store is an
  # ERROR (3), never a pass. This is the case that would otherwise exit 0.
  Dir.mktmpdir("critic-review-nogit-") do |nogit|
    Dir.chdir(nogit) do
      code, err = capture_err { verdict_for("a" * 40) }
      ok &&= (code == 3)
      ok &&= err.include?("Fix:")
    end
  end

  Dir.mktmpdir("critic-review-repo-") do |repo|
    Dir.chdir(repo) do
      sh = ->(*a) { system(*a, out: File::NULL, err: File::NULL) }
      sh.call("git", "init", "-q", ".")
      sh.call("git", "config", "user.email", "t@example.invalid")
      sh.call("git", "config", "user.name", "t")
      File.write("a.txt", "one\n")
      sh.call("git", "add", "-A")
      sh.call("git", "-c", "commit.gpgsign=false", "commit", "-qm", "one")
      parent = head_sha
      File.write("a.txt", "two\n")
      sh.call("git", "add", "-A")
      sh.call("git", "-c", "commit.gpgsign=false", "commit", "-qm", "two")
      sha = head_sha
      ok &&= (!sha.nil? && sha != parent)
      dir = verdict_dir
      ok &&= !dir.nil?

      # (2) never ran -> 3, and it must NOT read as a pass.
      code, err = capture_err { verdict_for(sha) }
      ok &&= (code == 3)
      ok &&= err.match?(/NOT run/)
      ok &&= err.include?("Fix:")

      # (4) still running (the DND-194 state) -> 3, named DISTINCTLY from (2).
      FileUtils.mkdir_p(dir)
      File.write(File.join(dir, "#{sha}.running"), Time.now.utc.iso8601)
      code, err = capture_err { verdict_for(sha) }
      ok &&= (code == 3)
      ok &&= err.match?(/IN PROGRESS/)
      ok &&= err.include?("Fix:")
      FileUtils.rm_f(File.join(dir, "#{sha}.running"))

      # (1) hit + (10) the running marker is cleared by a completed run.
      ENV["CRITIC_REVIEW_STUB"] = clean_out
      _r, _e = capture_err { run(["--base", "main"]) }
      ok &&= File.file?(File.join(dir, "#{sha}.json"))
      ok &&= !File.exist?(File.join(dir, "#{sha}.running"))
      code, _err = capture_err { verdict_for(sha) }
      ok &&= (code == 0)

      # (5) stale SHA: the PASS above belongs to `sha`, not to `parent`.
      code, err = capture_err { verdict_for(parent) }
      ok &&= (code == 3)
      ok &&= err.include?("Fix:")

      # (3) THE DND-212 REGRESSION: a fail-open still exits 0 for the captain
      # (never wedge the fleet) but records NO green verdict for the admiral.
      FileUtils.rm_f(File.join(dir, "#{sha}.json"))
      ENV["CRITIC_REVIEW_STUB"] = broken_out
      rc, _e = capture_err { run(["--base", "main"]) }
      ok &&= (rc == 0)
      code, err = capture_err { verdict_for(sha) }
      ok &&= (code == 3)
      ok &&= err.match?(/FAILED OPEN/)
      ok &&= err.include?("Fix:")

      # (9) block -> the receipt records it and the reader returns 2.
      ENV["CRITIC_REVIEW_STUB"] = findings_out
      rc, _e = capture_err { run(["--base", "main"]) }
      ok &&= (rc == 2)
      code, err = capture_err { verdict_for(sha) }
      ok &&= (code == 2)
      ok &&= err.include?("Fix:")

      # (15-19) THE REPORT BODY SURVIVES A TRUNCATED READ.
      #
      # The defect: the receipt kept the finding CATEGORIES and threw the body
      # away, so `critic-review | tail -N` destroyed the only copy of the text
      # saying what was wrong. Three instances in the 2026-09-20 notif-platform
      # run, one of them unrecoverable. These cases test the property, not the
      # wording: a file exists, it holds the body, and a reader who keeps only
      # the END of the stream still learns where it is.
      report = File.join(dir, "#{sha}.report.txt")
      FileUtils.rm_f(report)
      ENV["CRITIC_REVIEW_STUB"] = findings_out
      rc, err = capture_err { run(["--base", "main"]) }
      ok &&= (rc == 2)
      # (15) recorded, and WHOLE -- the trailer too, since this is the archival
      # copy and not a re-render of what was printed.
      ok &&= File.file?(report)
      ok &&= File.read(report) == File.read(findings_out)
      # (16) it holds the very text a truncated read loses: the finding body.
      ok &&= File.read(report).include?("no authz")
      # (17) THE TRUNCATION-SURVIVAL PROPERTY. `tail` keeps the end, so the
      # pointer must be at the end. A regression that moves it anywhere else
      # (e.g. before warn_round_notice) leaves the feature working and the
      # REASON for it broken -- which is exactly how this would rot back.
      tail = err.lines.map(&:strip).reject(&:empty?).last(4).join("\n")
      ok &&= tail.include?(report)
      ok &&= tail.include?("Fix:")

      # (18) a fail-open's diagnosis is just as destroyable, so it is recorded
      # too -- the missing-trailer output IS the thing a human must read.
      FileUtils.rm_f(report)
      ENV["CRITIC_REVIEW_STUB"] = broken_out
      _rc, err = capture_err { run(["--base", "main"]) }
      ok &&= File.file?(report)
      ok &&= File.read(report).include?("the model crashed")
      ok &&= err.include?(report)

      # (19) EMPTY raw is its OWN state. Pointing at a file that would be empty
      # is a claimed mechanism that cannot fire; say there is nothing instead.
      empty_out = File.join(stubs, "e"); File.write(empty_out, "   \n")
      FileUtils.rm_f(report)
      ENV["CRITIC_REVIEW_STUB"] = empty_out
      _rc, err = capture_err { run(["--base", "main"]) }
      ok &&= !File.exist?(report)
      ok &&= err.match?(/NO output at all/)
      ok &&= !err.include?("FULL REPORT RECORDED AT")

      ENV["CRITIC_REVIEW_STUB"] = findings_out

      # (7) malformed receipt is an ERROR, not a pass.
      File.write(File.join(dir, "#{sha}.json"), "{not json")
      code, err = capture_err { verdict_for(sha) }
      ok &&= (code == 3)
      ok &&= err.include?("Fix:")

      # (6) a verdict recorded against a DIRTY tree did not judge what is
      # about to merge.
      File.write(File.join(dir, "#{sha}.json"), JSON.generate(
        "schema" => VERDICT_SCHEMA, "sha" => sha, "base" => "main",
        "verdict" => "pass", "findings" => [], "dirty" => true,
        "at" => Time.now.utc.iso8601
      ))
      code, err = capture_err { verdict_for(sha) }
      ok &&= (code == 3)
      ok &&= err.include?("Fix:")

      # A non-SHA argument is rejected rather than globbed into a match.
      code, err = capture_err { verdict_for("") }
      ok &&= (code == 3)
      ok &&= err.include?("Fix:")

      ENV.delete("CRITIC_REVIEW_STUB")
    end
  end

  # (11-14) ROUND COUNTING -- the convergence signal (athena:critic-convergence).
  # Its own repo: the cases above rewrite one SHA's receipt repeatedly, which
  # would make the count here meaningless.
  #
  # The notice is stderr on an already-exit-2 path, so none of this can change
  # whether the judge blocks; what is under test is that the ROUND NUMBER is
  # right, and that an unresolvable store says so instead of reading as round 1.
  Dir.mktmpdir("critic-review-rounds-") do |repo|
    Dir.chdir(repo) do
      sh = ->(*a) { system(*a, out: File::NULL, err: File::NULL) }
      sh.call("git", "init", "-q", ".")
      sh.call("git", "config", "user.email", "t@example.invalid")
      sh.call("git", "config", "user.name", "t")
      commit = lambda do |body|
        File.write("a.txt", body)
        sh.call("git", "add", "-A")
        sh.call("git", "-c", "commit.gpgsign=false", "commit", "-qm", body)
        head_sha
      end
      first = commit.call("one")

      # (11) no store yet -> nil, and the caller says ROUND NUMBER UNKNOWN with
      # a Fix:. It must NEVER silently read as round 1.
      ok &&= rounds_recorded.nil?
      _r, err = capture_err { warn_round_notice(first) }
      ok &&= err.include?("ROUND NUMBER UNKNOWN")
      ok &&= err.include?("Fix:")
      ok &&= !err.match?(/ROUND 1\b/)

      ENV["CRITIC_REVIEW_STUB"] = findings_out

      # (12) round 1 BLOCK records a receipt but prints NO round notice --
      # a converging first pass must not be nagged.
      rc, err = capture_err { run(["--base", "main"]) }
      ok &&= (rc == 2)
      ok &&= (rounds_recorded&.first == 1)
      ok &&= !err.include?("ROUND")
      ok &&= !err.include?("critic-convergence")

      # (13) round 2 BLOCK DOES print it, names the round, routes to the skill,
      # and lists the PRIOR sha while EXCLUDING the current head.
      second = commit.call("two")
      rc, err = capture_err { run(["--base", "main"]) }
      ok &&= (rc == 2)
      ok &&= (rounds_recorded&.first == 2)
      ok &&= err.include?("ROUND 2 on this change")
      ok &&= err.include?("athena:critic-convergence")
      ok &&= err.include?("CLUSTER ROUND")
      # These two are claims about the ROUND NOTICE -- "it lists the prior
      # SHAs and not the head you are on" -- so they are asserted against the
      # notice, not against all of stderr. The report pointer that follows it
      # names the current head inside a file path, legitimately and by design;
      # reading the whole stream would fail on that and say "the notice named
      # the current head", which is not what happened.
      notice = err.split("FULL REPORT RECORDED AT").first.to_s
      ok &&= notice.include?(first[0, 7])       # the earlier round is named
      ok &&= !notice.include?(second[0, 7])     # the current head is not
      ok &&= err.match?(/NEVER a reason to override/)

      # (13b) BELOW THE ARTIFACT CEILING the notice must NOT mention it -- a
      # per-cluster loop that is still working is never told to descope. (The
      # at-ceiling half is case 15, in its own repo, because driving the count
      # up here would break case 14's expectation of exactly 2.)
      ok &&= !err.include?("ARTIFACT CEILING")

      # (14) THE REBASE CASE. A rebase rewrites the round SHAs and orphans every
      # earlier receipt, so an ancestry-based count would read LOW and silently
      # under-report the round -- the failed-lookup class. Counting from the
      # DIRECTORY survives it: move HEAD off both recorded commits entirely and
      # the count must still be 2.
      commit.call("three")
      sh.call("git", "-c", "commit.gpgsign=false", "reset", "-q", "--hard", first)
      ok &&= (rounds_recorded&.first == 2)

      ENV.delete("CRITIC_REVIEW_STUB")
    end
  end

  # (15) THE ARTIFACT CEILING, at and one short of the boundary. Its OWN repo:
  # driving the round count to 12 inside the case-11-14 repo would break case
  # 14's expectation of exactly 2.
  #
  # What is under test is the BOUNDARY, not "some large number fires" -- the
  # ceiling's whole justification is that it sits ABOVE the two loops that
  # RESOLVED at eight rounds, so a ceiling that crept down to 8 would start
  # ordering needless descopes and nothing else would notice.
  Dir.mktmpdir("critic-review-ceiling-") do |repo|
    Dir.chdir(repo) do
      sh = ->(*a) { system(*a, out: File::NULL, err: File::NULL) }
      sh.call("git", "init", "-q", ".")
      sh.call("git", "config", "user.email", "t@example.invalid")
      sh.call("git", "config", "user.name", "t")
      commit = lambda do |body|
        File.write("a.txt", body)
        sh.call("git", "add", "-A")
        sh.call("git", "-c", "commit.gpgsign=false", "commit", "-qm", body)
        head_sha
      end
      commit.call("base")
      ENV["CRITIC_REVIEW_STUB"] = findings_out

      ok &&= (ARTIFACT_CEILING_ROUND > 8)   # above BOTH loops that resolved

      # Each commit body MUST be unique: commit.call writes it to a.txt, so a
      # repeated body is an empty commit git refuses -- HEAD would not move, no
      # new receipt would be recorded, and the count would never advance. The
      # iteration bound is belt-and-braces so a future regression FAILS the
      # suite instead of hanging it (repo CLAUDE.md -> the safe-wait pattern:
      # every loop carries a max-iteration bound).
      n = 0
      while (rounds_recorded&.first || 0) < ARTIFACT_CEILING_ROUND - 1
        n += 1
        break if n > ARTIFACT_CEILING_ROUND + 5
        commit.call("round-#{n}")
        capture_err { run(["--base", "main"]) }
      end

      # One SHORT of the ceiling: silent about it.
      ok &&= (rounds_recorded&.first == ARTIFACT_CEILING_ROUND - 1)
      _rc, err = capture_err { warn_round_notice(head_sha) }
      ok &&= err.include?("ROUND #{ARTIFACT_CEILING_ROUND - 1} on this change")
      ok &&= !err.include?("ARTIFACT CEILING")

      # AT the ceiling: names it, routes to the artifact-scope decision, and
      # still exits 2. The notice is stderr on an already-blocking path, so it
      # must never change whether the judge blocks.
      commit.call("at-ceiling")
      rc, err = capture_err { run(["--base", "main"]) }
      ok &&= (rc == 2)
      ok &&= (rounds_recorded&.first == ARTIFACT_CEILING_ROUND)
      ok &&= err.include?("ARTIFACT CEILING")
      ok &&= err.include?("Fix:")
      ok &&= err.include?("PARK")
      ok &&= err.include?("FINDINGS: none")
      # The ceiling paragraph ITSELF routes to a SCOPE decision and offers no
      # merge path -- scoped to the text after the marker, because the generic
      # notice above it legitimately contains "merge with findings open" in the
      # course of FORBIDDING it.
      ceiling_text = err.split("ARTIFACT CEILING", 2).last.to_s
      ok &&= !ceiling_text.match?(/--critic-override|known-open|merge with findings/i)
      ok &&= ceiling_text.match?(/ARTIFACT-scope decision/i)

      ENV.delete("CRITIC_REVIEW_STUB")
    end
  end

  FileUtils.remove_entry(stubs)
  ok
end

def run_self_test
  require "tmpdir"
  ok = true
  Dir.mktmpdir("critic-review-selftest-") do |d|
    findings_out = File.join(d, "f"); File.write(findings_out, "- [access-control] x.ex:1 — no authz\nFINDINGS: access-control\n")
    clean_out    = File.join(d, "c"); File.write(clean_out, "looks good\nFINDINGS: none\n")
    broken_out   = File.join(d, "b"); File.write(broken_out, "the model crashed, no trailer here\n")

    # parser
    ok &&= (parse_findings(File.read(findings_out)) == [["access-control"], true])
    ok &&= (parse_findings(File.read(clean_out)) == [[], true])
    ok &&= (parse_findings(File.read(broken_out)) == [nil, false])

    # PROMPT BUILDER -- ONE COPY, asserted rather than assumed.
    #
    # critic-eval's recall/precision numbers are the stated reason this critic
    # is trusted as a BLOCKING step, and they only describe the shipping judge
    # while both bins send it the same prompt. Built separately the two were
    # byte-identical and free to drift silently: an edit to the shipping prompt
    # that missed the eval would leave the eval scoring a prompt nobody runs,
    # still printing a number and still reading as PASS.
    #
    # So this asserts the SHAPE and then the SINGLE COPY -- that neither bin
    # carries its own inlined instruction string. A comment saying "keep these
    # in sync" is exactly the guard that cannot fire.
    built = CriticPrompt.build(diff: "DIFFBODY")
    ok &&= built.start_with?(CriticPrompt::INSTRUCTION)
    ok &&= built.include?("```diff\nDIFFBODY\n```")
    ok &&= built.rindex("DIFFBODY") > built.rindex(CriticPrompt::INSTRUCTION) # varying part LAST (cache prefix)

    # BUG-FIX REGRESSION EVIDENCE (DND-400). The rule lives in ai/CLAUDE.md ->
    # "TDD Workflow"; the enforceable half rides in the prompt, because the
    # judge can only rule on a fix claim it can SEE, and the claim lives in the
    # commit messages. So assert all three parts, each as a separate outcome:
    #   - the addendum sits in the STABLE prefix, ahead of every varying part;
    #   - supplied commit messages land between the addendum and the diff;
    #   - a MISSING input (nil) and an EMPTY one ("") print different markers --
    #     "no commits" must never read the same as "nobody passed the commits".
    with_msgs = CriticPrompt.build(diff: "DIFFBODY", commit_messages: "fix: MSGBODY")
    ok &&= with_msgs.include?(CriticPrompt::BUG_FIX_RULE)
    ok &&= with_msgs.index(CriticPrompt::BUG_FIX_RULE) < with_msgs.index("MSGBODY")
    ok &&= with_msgs.index("MSGBODY") < with_msgs.index("DIFFBODY")
    ok &&= built.include?(CriticPrompt::BUG_FIX_RULE)
    ok &&= built.include?(CriticPrompt::COMMITS_NOT_SUPPLIED)
    none = CriticPrompt.build(diff: "DIFFBODY", commit_messages: "")
    ok &&= none.include?(CriticPrompt::COMMITS_NONE)
    ok &&= !none.include?(CriticPrompt::COMMITS_NOT_SUPPLIED)
    ok &&= !with_msgs.include?(CriticPrompt::COMMITS_NOT_SUPPLIED) && !with_msgs.include?(CriticPrompt::COMMITS_NONE)
    # The addendum names its own normative home, so a reader of a finding can
    # find the rule it enforces (cite by section name, never restate a second copy).
    ok &&= CriticPrompt::BUG_FIX_RULE.include?("TDD Workflow")
    ok &&= CriticPrompt::SUPPORTED_TOKENS.include?("commit-msg")
    # Pasted test output often carries its own ``` fence. The commits block must
    # use a LONGER fence, or that paste closes the block early and the judge
    # reads the rest of the evidence as loose prompt text.
    fenced = CriticPrompt.build(diff: "D", commit_messages: "fix: x\n```\nFAILOUT\n```\nafter")
    ok &&= fenced.include?("````text\nfix: x\n```\nFAILOUT\n```\nafter\n````")

    %w[critic-review critic-eval].each do |bin|
      path = File.join(__dir__, bin)
      # A missing source is an ERROR, never a quietly-skipped case: a check that
      # cannot find what it checks must not report the same thing as a clean one.
      unless File.file?(path)
        warn "critic-review --self-test: cannot read #{path} to verify the single-copy prompt property."
        warn "  Fix: run --self-test from a checkout that contains ai/bin/#{bin}; do not treat this as a pass."
        ok = false
        next
      end
      src = File.read(path)
      ok &&= src.include?("CriticPrompt.build")              # uses the shared builder
      ok &&= !src.include?("\"#{CriticPrompt::INSTRUCTION}") # and does NOT inline its own
    end

    # THE SHIPPING CALLER PASSES EVERY SUPPORTED INPUT.
    #
    # One copy of the builder is not enough on its own. A new input could be
    # added to CriticPrompt and wired ONLY into critic-eval -- the eval would
    # then feed the judge a prompt shape no shipping caller ever produces,
    # still print recall/precision, and still read as PASS, while describing a
    # judge nobody runs. That is the same divergence the single-copy property
    # exists to prevent, arriving through the parameter list instead of through
    # a second inlined string.
    #
    # STATED LIMIT: this proves the KEYWORD appears at the shipping call site,
    # not that a non-empty value flows through it. It catches forgotten wiring,
    # which is the measured failure mode; it does not catch an input wired to
    # something empty.
    ship = File.read(File.join(__dir__, "critic-review")) rescue nil
    body = ship && ship[/^def critic_output\b.*?(?=^def |\z)/m]
    start = body && body.index("CriticPrompt.build(")
    if start.nil?
      warn "critic-review --self-test: could not locate the CriticPrompt.build call inside critic_output."
      warn "  Fix: keep the shipping prompt built by CriticPrompt.build inside critic_output; do not treat"
      warn "  an unreadable or restructured call site as a pass — a check that cannot find what it checks"
      warn "  must not report the same thing as a clean one."
      ok = false
    else
      # Balanced-paren scan rather than a line/`[^)]*` match, so a future
      # multi-line or nested-call argument list cannot truncate the text and
      # report a missing keyword that is actually present.
      depth = 0
      call = nil
      body[start..].each_char.with_index do |c, i|
        depth += 1 if c == "("
        if c == ")"
          depth -= 1
          (call = body[start, i + 1]) && break if depth.zero?
        end
      end
      CriticPrompt::SUPPORTED_INPUTS.each do |key|
        next if call && call.include?("#{key}:")
        warn "critic-review --self-test: the shipping prompt call omits `#{key}:`, which is in CriticPrompt::SUPPORTED_INPUTS."
        warn "  Fix: pass #{key}: in critic_output's CriticPrompt.build call, or drop it from CriticPrompt::INPUTS."
        warn "  An input only critic-eval passes leaves the eval scoring a prompt the shipping judge never sees."
        ok = false
      end
    end

    # decision matrix
    ok &&= (decide(["access-control"], true, true) == ["block", 2])
    ok &&= (decide([], true, true) == ["pass", 0])
    ok &&= (decide([], false, true) == ["fail-open", 0])   # no trailer -> fail-open
    ok &&= (decide([], true, false) == ["fail-open", 0])   # invoke failed -> fail-open

    # ARGUMENT HANDLING -- the model-free dispatch paths.
    #
    # These assert the CHEAP outcome, which is the whole point: every case here
    # must return WITHOUT invoking `claude`. CRITIC_REVIEW_STUB is deliberately
    # unset for them, so if any case ever fell through to run() again it would
    # try to spawn the model (and, in this live repo, write a verdict receipt)
    # rather than quietly passing.
    ok &&= usage_error([]).nil?                             # bare -> review HEAD
    ok &&= usage_error(["--base", "main"]).nil?
    ok &&= usage_error(["--verdict-for", "deadbeef"]).nil?
    ok &&= usage_error(["--self-test"]).nil?
    ok &&= !usage_error(["--help"])                         # documented, accepted
    ok &&= !usage_error(["--bogus"]).nil?                   # typo'd flag refused
    ok &&= !usage_error(["abc123"]).nil?                    # bare SHA is NOT --verdict-for
    ok &&= !usage_error(["--verdict-for"]).nil?             # value missing
    ok &&= !usage_error(["--base"]).nil?
    ok &&= !usage_error(["--base", "--verdict-for"]).nil?   # value that is a flag

    # --help prints usage, exits 0, invokes nothing.
    rc, shown = capture_out { main(["--help"]) }
    ok &&= (rc == 0)
    ok &&= shown.include?("--verdict-for")
    ok &&= shown.include?("--self-test")

    # An unrecognised argument is REFUSED (64), not silently reviewed. 64 is
    # neither 0 (pass) nor 2 (block) nor 3 (no green verdict), so a usage error
    # can never be mistaken for a verdict by integration-gate.
    rc, shown = capture_err { capture_out { main(["--bogus"]) }[0] }
    ok &&= (rc == 64)
    ok &&= shown.include?("Fix:")
    ok &&= shown.include?("--bogus")
    ok &&= (capture_err { capture_out { main(["--verdict-for"]) }[0] }[0] == 64)

    # end-to-end via stub. These run inside a THROWAWAY git repo: run() now
    # writes a verdict receipt into $GIT_DIR, and doing that in the live repo
    # would both pollute it and record a stub verdict against a real head.
    Dir.mktmpdir("critic-review-e2e-") do |repo|
      Dir.chdir(repo) do
        sh = ->(*a) { system(*a, out: File::NULL, err: File::NULL) }
        sh.call("git", "init", "-q", ".")
        sh.call("git", "config", "user.email", "t@example.invalid")
        sh.call("git", "config", "user.name", "t")
        File.write("a.txt", "one\n")
        sh.call("git", "add", "-A")
        sh.call("git", "-c", "commit.gpgsign=false", "commit", "-qm", "one")

        ENV["CRITIC_REVIEW_STUB"] = findings_out
        ok &&= (capture_err { run(["--base", "main"]) }[0] == 2)
        ENV["CRITIC_REVIEW_STUB"] = clean_out
        ok &&= (capture_err { run(["--base", "main"]) }[0] == 0)
        ENV["CRITIC_REVIEW_STUB"] = broken_out
        ok &&= (capture_err { run(["--base", "main"]) }[0] == 0) # fail-open, not block

        # THE BODY REACHES THE CALLER even when it is not a "- [cat]" bullet
        # list. A blocked run that shows no findings is unactionable, and the
        # previous grep produced exactly that for any other format.
        odd_out = File.join(d, "o")
        File.write(odd_out, "**MUST-FIX**\n1. foo.sh:12 drops the status\nFINDINGS: correctness\n")
        ENV["CRITIC_REVIEW_STUB"] = odd_out
        rc, shown = capture_err { run(["--base", "main"]) }
        ok &&= (rc == 2)
        ok &&= shown.include?("foo.sh:12 drops the status")
        ok &&= !shown.include?("FINDINGS: correctness")   # the trailer is not echoed
        ENV.delete("CRITIC_REVIEW_STUB")

        # COMMIT LOG -- the judge's commit-msg input, three outcomes kept apart:
        # commits present, none (""), and an unreadable log (nil, said on stderr).
        first = `git rev-parse HEAD`.strip
        File.write("a.txt", "two\n")
        sh.call("git", "-c", "commit.gpgsign=false", "commit", "-qam", "fix: two")
        ok &&= commit_log(first).to_s.include?("fix: two")
        ok &&= (commit_log("HEAD") == "")
        rc_nil, said = capture_err { commit_log("no-such-ref-dnd400").inspect }
        ok &&= (rc_nil == "nil") && said.include?("Fix:") && said.include?("no-such-ref-dnd400")
      end
    end
  end
  ok &&= run_receipt_self_test
  if ok
    puts "critic-review: self-test OK"
    0
  else
    warn "critic-review: self-test FAILED"
    warn "  Fix: keep the semantics exact — findings BLOCK (exit 2), none PASSES, any infra/no-trailer error FAILS OPEN (exit 0, loud) for the CAPTAIN, and records a receipt so --verdict-for tells the ADMIRAL apart: pass=0, block=2, and none/running/fail-open/stale-SHA/dirty/malformed=3. A state that cannot be verified is never a pass."
    1
  end
end

# Dispatch is a FUNCTION returning an exit code, not a bare `if` at the bottom,
# so --help and the argument-refusal path are reachable from the self-test. A
# guard nothing can test is a guard nothing keeps.
def main(argv)
  if (err = usage_error(argv))
    warn "critic-review: #{err}"
    warn USAGE
    warn "  Fix: re-run using one of the forms above. An unrecognised argument is refused, not ignored: ignoring it would fall through to a full model-in-loop review of HEAD (slow, and it records a verdict receipt) when you asked for something else."
    return 64
  end

  # --help is checked BEFORE --self-test and --verdict-for so it is always the
  # cheap, model-free answer, whatever else is on the line.
  if argv.include?("--help") || argv.include?("-h")
    puts USAGE
    return 0
  end

  return run_self_test if argv.include?("--self-test")

  if (idx = argv.index("--verdict-for"))
    return verdict_for(argv[idx + 1].to_s)
  end

  run(argv)
end

exit main(ARGV)
