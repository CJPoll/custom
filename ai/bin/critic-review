#!/usr/bin/ruby
# frozen_string_literal: true

# critic-review — run the standing read-only judge (athena-diff-critic) over the
# current change as a BLOCKING review step, and decide pass / block / fail-open.
#
# Promoted from advisory to blocking on 2026-09-16 after `critic-eval --run`
# cleared the trust bar (recall=1.0, precision=1.0 over 5 labeled fixtures; see
# ai/eval/critic-baseline.json).
#
# Decision semantics (the load-bearing part):
#   - critic reports FINDINGS -> BLOCK (exit 2): real issues must be addressed
#     before the change ships.
#   - critic reports "FINDINGS: none" -> PASS (exit 0).
#   - critic INFRA error (no `claude`, non-zero exit, or no FINDINGS trailer) ->
#     FAIL-OPEN (exit 0) with a LOUD Fix: note. A critic crash / model-call
#     failure must NEVER wedge an autonomous merge; it is surfaced, not silently
#     passed and not hard-blocked.
#
# The critic is READ-ONLY (as built): it inspects and reports, never edits.
#
# Model-in-loop: invoking the critic requires `claude`, so this is NOT part of
# the deterministic gate. Its --self-test (the decision + FINDINGS parser) IS
# deterministic and gate-safe.
#
# Verdict receipts (the load-bearing addition, 2026-09-20). Every completed run
# records its outcome at $GIT_DIR/critic-verdicts/<head-sha>.json, and marks
# <head-sha>.running for the duration. This exists so that a judge that NEVER
# RAN, FAIL-OPENED, or HAD NOT FINISHED YET is distinguishable from one that
# PASSED -- three states that were all "exit 0, nothing recorded" and therefore
# all read as a pass at the admiral's merge gate. Measured on
# 2026-09-19-slack-gensaas: DND-194 merged while the judge was still running
# (factual error landed on main, recovered by PR #41); DND-212's judge
# fail-opened twice and was caught only by the admiral's discretion.
# `integration-gate` reads these; see athena:merge-boarding -> "The merge bar".
#
# Receipts are WRITTEN per checkout but READ from every checkout of the repo
# (keyed on the realpath of the git common dir), so a verdict recorded in a
# worktree is found from the main checkout too -- see "The READ side" below
# (DND-457).
#
# Carry (DND-986, owner-approved P4). A review run on a head with NO receipt in
# any checkout first looks for a PASS recorded on an IDENTICAL change -- same
# patch-id, same patch bytes, same commit messages, same prompt and critic
# definition -- and, finding one with no BLOCK on the same change in any
# checkout of the repo, carries it. What the carry MEANS is the owner's rule
# (round 3): "If a rebase doesn't change the branch itself and the last critic
# review for the branch passed, the critic's job should only be to see if the
# changes from the rebase cause a problem." -- Cody, 2026-09-27. So the carried
# PASS covers the branch's own diff, and the judge then reviews ONLY the
# upstream delta the rebase brought in (an INTERACTION review); the head is
# PASS only if that passes. With nothing new upstream the carried PASS stands
# with no model call. Every doubt runs a FULL review. Only the writer carries;
# the reader (--verdict-for) still needs a receipt for exactly the SHA it is
# given. See "Carry (DND-986): side effects" below and ai/lib/critic_carry.rb.
#
# Usage: see the USAGE constant below, or run `ai/bin/critic-review --help`.
# It is stated once, there, so the text a caller is shown cannot drift from the
# text a reader of this header believes.
#
# Testing hook: CRITIC_REVIEW_STUB=<file> uses that file as the critic output
# instead of invoking `claude` (used by --self-test; also handy for a dry run).

require "open3"
require "json"
require "fileutils"
require "time"

AI_DIR = File.expand_path("..", __dir__)
require File.join(AI_DIR, "lib", "critic_prompt")
require File.join(AI_DIR, "lib", "critic_carry")

CRITIC = "athena-diff-critic"

USAGE = <<~TXT.freeze
  Usage:
    ai/bin/critic-review [--base BRANCH] [--no-carry]
                                           review HEAD's diff vs BRANCH (default
                                           origin/HEAD or main); exit 0 pass /
                                           2 block / 0 fail-open(loud). Invokes
                                           the model -- slow, and records a
                                           per-SHA verdict receipt. First, a
                                           head with NO receipt carries a PASS
                                           recorded on an IDENTICAL change
                                           (same patch bytes, commit messages,
                                           prompt and agent definition; no
                                           BLOCK on it anywhere) and reviews
                                           ONLY the upstream delta the rebase
                                           brought in: PASS (CARRIED +
                                           INTERACTION), or PASS (CARRIED) with
                                           no model call when nothing came in
                                           (DND-986). --no-carry skips that and
                                           always runs a full review.
    ai/bin/critic-review --verdict-for SHA read the RECORDED verdict for SHA;
                                           exit 0 pass / 2 block / 3 no green
                                           verdict (none / running / fail-open /
                                           stale-tree / malformed / conflicting
                                           / could-not-look -- each named).
                                           Searches every checkout (main and
                                           worktrees) of the current repo.
    ai/bin/critic-review --verdict-for SHA --covering REF
                                           as above, and a PASS counts only if
                                           the diff it judged covers REF..SHA:
                                           its recorded merge base must be REF
                                           or an ancestor of it. A PASS judged
                                           against a narrower base (a stacked
                                           parent not on REF) is exit 3. A
                                           legacy schema-1 receipt records no
                                           merge base and is not checked.
    ai/bin/critic-review --self-test       verify the decision, parser, and the
                                           receipt writer+reader (no model)
    ai/bin/critic-review --help            this text (never invokes the model)

  Testing hook: CRITIC_REVIEW_STUB=<file> uses that file as the critic output
  instead of invoking `claude` (used by --self-test; also handy for a dry run).

  Exit 64 means the ARGUMENTS were wrong; it is never a verdict.
TXT

# Flags this tool actually accepts. An argument outside these tables is REFUSED
# (exit 64), never ignored.
#
# It used to be ignored, and that is the defect this table exists to close: the
# dispatcher fell through to `run(ARGV)` for anything it did not recognise, so a
# typo'd flag -- or `--help`, which this tool did not implement -- silently
# started a full model-in-loop review of HEAD instead of erroring. Measured
# 2026-09-20 (DND-246/H-2): `--help` hung long enough that the captain's brief
# had to carry "do NOT run `ai/bin/critic-review --help` (hangs)" as prose, and
# the captain dutifully recorded not running it. A harness that documents a
# hang is a harness that has not fixed one. Confirmed by this shipwright:
# `timeout 10 ai/bin/critic-review --help </dev/null` exited 124.
#
# This is the CLI-argument instance of ~/dev/custom/CLAUDE.md -> "A failed
# lookup must never look like an empty one": an unrecognised key must not
# resolve to the most expensive default action and report nothing about it.
VALUE_FLAGS = %w[--base --verdict-for --covering].freeze
BOOL_FLAGS  = %w[--self-test --help -h --no-carry].freeze

# -> nil when argv is well-formed, else a one-line reason.
#
# A value-taking flag's value must be present and must not itself look like a
# flag, so `--verdict-for` with a forgotten SHA is an error rather than a
# lookup of the empty string.
def usage_error(argv)
  i = 0
  while i < argv.length
    arg = argv[i]
    if VALUE_FLAGS.include?(arg)
      nxt = argv[i + 1]
      return "#{arg} requires a value." if nxt.nil? || nxt.start_with?("-")
      i += 2
    elsif BOOL_FLAGS.include?(arg)
      i += 1
    else
      return "unrecognised argument #{arg.inspect}."
    end
  end
  # --no-carry only means something on a review run. Silently ignoring it
  # beside --verdict-for (which never carries) or --self-test would read as
  # honoured, so the combination is refused.
  if argv.include?("--no-carry") && (argv.include?("--verdict-for") || argv.include?("--self-test"))
    return "--no-carry applies only to a review run, not to --verdict-for or --self-test."
  end
  if argv.include?("--covering") && !argv.include?("--verdict-for")
    return "--covering applies only to --verdict-for."
  end
  nil
end

def parse_findings(text)
  line = text.to_s.lines.reverse.find { |l| l =~ /^\s*FINDINGS:/i }
  return [nil, false] unless line # no trailer -> not a valid critic result
  body = line.sub(/^\s*FINDINGS:/i, "").strip
  return [[], true] if body.empty? || body.casecmp?("none")
  [body.split(",").map { |s| s.strip.downcase }.reject(&:empty?), true]
end

# decide -> [action, exit_code]
#   action: "pass" | "block" | "fail-open"
def decide(findings, trailer_ok, invoke_ok)
  return ["fail-open", 0] unless invoke_ok && trailer_ok
  return ["pass", 0] if findings.empty?
  ["block", 2]
end

VERDICT_SCHEMA = 2

# Resolving the receipt directory is its OWN step with its OWN outcome.
# `git rev-parse --git-path` returns a CWD-RELATIVE path in a main checkout and
# an absolute one only in a worktree (CLAUDE.md -> "A failed lookup must never
# look like an empty one" -- the DND-183/DND-202 instance). It is expanded
# against the repo root HERE, at the point of capture, and never re-resolved.
# Unresolvable is nil (an error to the caller), never a silent empty.
def verdict_dir
  root, _e, s1 = Open3.capture3("git", "rev-parse", "--show-toplevel")
  raw,  _e2, s2 = Open3.capture3("git", "rev-parse", "--git-path", "critic-verdicts")
  return nil unless s1.success? && s2.success?
  return nil if root.strip.empty? || raw.strip.empty?
  File.expand_path(raw.strip, root.strip)
end

def head_sha
  out, _e, st = Open3.capture3("git", "rev-parse", "--verify", "HEAD^{commit}")
  (st.success? && out.strip =~ /\A[0-9a-f]{40}\z/) ? out.strip : nil
end

def tree_dirty?
  out, _e, st = Open3.capture3("git", "status", "--porcelain")
  !st.success? || !out.strip.empty?
end

# -> the judge's start Time. The caller hands it to write_verdict, so the
# receipt keeps started_at and duration_s (DND-1006). Before that the start was
# only in <sha>.running, which a completed run deletes, so no run recorded how
# long it took.
def mark_running(sha)
  started = Time.now.utc
  dir = verdict_dir
  return started unless dir && sha
  FileUtils.mkdir_p(dir)
  File.write(File.join(dir, "#{sha}.running"), started.iso8601)
  started
end

# The critic's REPORT BODY, persisted beside the verdict.
#
# The receipt records the finding CATEGORIES (`findings`), which is all the
# admiral's merge gate needs. The body -- the actual text saying what is wrong
# -- was printed to stderr and kept nowhere. A caller who captured that stderr
# through `| tail -N`, `| head -N`, or a truncating tool therefore destroyed the
# only copy, and the sole recovery was another full model-in-loop run.
#
# Measured on 2026-09-20-notif-platform, three times in ONE run: two truncated
# captures caught by the recorded-verdict check, and one -- state.md, "ONE
# finding captured (my bg cmd truncated stdout via tail -20) ... CORRECTNESS
# finding body LOST to truncation" -- where the body was gone for good. The run
# coined a rule for it ("never trust a tail-truncated critic read"), and a prior
# run had already recorded the same class in memory. A rule telling agents not
# to truncate does not survive contact with a background command; a file does.
#
# Returns the path written, or nil. nil is reported by the caller, never
# silently swallowed -- a report that was not recorded must not read like one
# that was.
# The ONE place the report's name is built, so the writer (write_report) and
# the remover (retire_report) can never key on different paths.
def report_path(dir, sha)
  File.join(dir, "#{sha}.report.txt")
end

def write_report(sha, text)
  dir = verdict_dir
  return nil unless dir && sha
  path = report_path(dir, sha)
  FileUtils.mkdir_p(dir)
  File.write(path, text.to_s)
  path
rescue StandardError
  nil
end

# The pointer is printed LAST, deliberately.
#
# `tail -N` keeps the END of a stream and `head -N` keeps the START, so no
# single position survives both. The END is the one that survives the form
# actually measured hurting us (every one of the three instances above was a
# `tail`), and it is also what a terminal leaves on screen. A caller who sees
# only the last line still learns where the whole report is.
def warn_report_pointer(path, sha)
  if path
    warn ""
    warn "critic-review: FULL REPORT RECORDED AT #{path}"
    warn "  Fix: read that file (`cat #{path}`) rather than re-running the judge — if the output"
    warn "  above reached you truncated (a pipe through tail/head, a capture bound, a background"
    warn "  command), the file is the complete body and re-running costs another model round."
  else
    warn ""
    warn "critic-review: NOTE the report body was NOT recorded to disk#{sha ? '' : ' (no resolvable HEAD)'}."
    warn "  Fix: the text above is the ONLY copy — capture it whole now, without piping through"
    warn "  tail/head. Then run the judge from the Mission's worktree so the next round records a report."
  end
end

# Schema 2 (DND-986) adds the carry keys to every receipt: merge_base,
# patch_id, diff_digest, msgs_digest, judge_digest (each null when it could not
# be computed; a receipt with a null key is never a carry source), plus
# carried_from (the ORIGINALLY judged SHA, for a carried PASS) and
# carried_receipt (the receipt it matched). The reader treats schema 1 and 2
# alike; only the carry lookup needs the keys.
#
# -> the receipt path written, or false.
#
# exclusive: true (the carried write) never replaces a receipt: the carry
# decided "HEAD has no receipt", and a verdict that appeared since (a judge run
# in another shell) must win. It writes a temp file and hard-links it into
# place, which fails if the name exists -- the check and the write are one step.
#
# interaction: { range: "<from>..<to>", verdict: } (round 3) records the
# interaction review that decided a carried head: upstream_range and
# interaction are null on every other receipt.
#
# started_at: the Time mark_running returned (DND-1006). The receipt records
# it and duration_s (seconds from it to "at"); both are null when no judge ran
# (a carried PASS with nothing upstream).
def write_verdict(sha, base, action, findings, dirty, keys: nil, carried: nil, exclusive: false, interaction: nil,
                  started_at: nil)
  dir = verdict_dir
  unless dir && sha
    warn "critic-review: NOTE no verdict receipt written (not inside a resolvable git work tree)."
    warn "  Fix: run the judge from the Mission's worktree, or the admiral's integration-gate will see no verdict for this head and refuse the merge."
    return false
  end
  FileUtils.mkdir_p(dir)
  path = File.join(dir, "#{sha}.json")
  key_fields = CriticCarry::HEAD_KEYS.to_h { |k| [k, keys && CriticCarry.key_ok?(keys[k]) ? keys[k] : nil] }
  now = Time.now.utc
  body = JSON.generate(
    { "schema" => VERDICT_SCHEMA, "tool" => "critic-review", "sha" => sha,
      "base" => base.to_s, "verdict" => action, "findings" => findings,
      "dirty" => dirty, "at" => now.iso8601,
      "started_at" => started_at&.utc&.iso8601,
      "duration_s" => started_at && (now - started_at).round(3) }
      .merge(key_fields)
      .merge("carried_from" => carried&.fetch(:root), "carried_receipt" => carried&.fetch(:receipt))
      .merge("upstream_range" => interaction&.fetch(:range), "interaction" => interaction&.fetch(:verdict))
  )
  if exclusive
    tmp = File.join(dir, ".#{sha}.json.tmp.#{Process.pid}")
    begin
      File.write(tmp, body)
      File.link(tmp, path)
    rescue SystemCallError => e
      warn "critic-review: NOTE the carried receipt was not written to #{path} (#{e.message})."
      warn "  Fix: nothing to do by hand -- a receipt that appeared meanwhile is kept, and the judge runs instead."
      return false
    ensure
      FileUtils.rm_f(tmp)
    end
    retire_report(dir, sha)
    return path
  end
  File.write(path, body)
  FileUtils.rm_f(File.join(dir, "#{sha}.running"))
  retire_report(dir, sha)
  path
end

# A new receipt retires the previous run's report for the same SHA (DND-907).
#
# The report body is written only on BLOCK and on a FAIL-OPEN with output. A
# PASS -- judged, carried, or interaction -- and an empty-raw FAIL-OPEN write
# none. So without this, a re-run on the same SHA left the LAST run's body in
# place: measured on a75a777 (DND-880, 2026-09-27), a session-limit fail-open's
# report sat beside a `verdict: pass` receipt, and the "FULL REPORT" pointer a
# reader had followed now contradicted the recorded verdict.
#
# Every completion path writes its receipt through write_verdict BEFORE it
# writes a report, so retiring here -- the one funnel -- makes "a report exists"
# mean "this receipt's run wrote it". A refused exclusive write never reaches
# this, so at that step the receipt that won keeps its report; the full review
# the same invocation then falls back to writes a new receipt and retires it.
#
# Two runs on ONE sha at once can still interleave: A's retire can land after
# B wrote its receipt and report, deleting B's fresh body; and, as before this
# retire existed, A's report can land after B's receipt. Each window is the gap
# between two statements, no lock covers them, and the receipt stays the
# verdict in every order.
#
# FileUtils.rm_f is silent on every failure, "already gone" and "permission
# denied" alike, so the outcome is read back from the filesystem, and a report
# that survived is said out loud rather than left to contradict the receipt.
def retire_report(dir, sha)
  report = report_path(dir, sha)
  FileUtils.rm_f(report)
  return unless File.exist?(report)

  warn "critic-review: NOTE a previous run's report could not be removed: #{report}."
  warn "  Fix: delete it by hand (`rm -rf #{report}`); until then it describes an EARLIER run than the receipt #{sha}.json beside it, and the receipt is the verdict."
end

# --- The READ side: every checkout of the repo (DND-457) ---------------------
#
# The WRITER keys receipts per worktree ($GIT_DIR/critic-verdicts, above), and
# that stays: round counting (rounds_recorded) depends on "every receipt in this
# dir belongs to this change". The READER used to look only in its OWN $GIT_DIR,
# so from the main checkout a PASS recorded in a worktree matched nothing and
# was reported as "the standing judge has NOT run on this head" -- a fact the
# reader could not know. Measured 2026-09-24: DND-429's head read PASS from its
# worktree and NO VERDICT from ~/dev/custom. That is ~/.claude/CLAUDE.md -> "A
# failed lookup must never look like an empty one".
#
# So the reader keys on what every checkout of a repo SHARES -- the realpath of
# its git COMMON dir -- and searches every per-checkout store under it:
#   <common>/critic-verdicts                  (the main checkout's $GIT_DIR)
#   <common>/worktrees/<id>/critic-verdicts   (each linked worktree's $GIT_DIR)
# No receipt moves, so every receipt already on disk is found as-is: there is
# nothing to migrate. (A receipt inside a REMOVED worktree went with it --
# `git worktree remove` deletes <common>/worktrees/<id>. That was true before
# this change and the miss message says so.)

# The repo's git common dir, ABSOLUTE, resolved at the point of capture.
# Plain `--git-common-dir` is CWD-RELATIVE in a main checkout (".git"), which is
# the DND-183/DND-202 instance of this class; --path-format=absolute removes it.
# -> [path, nil] or [nil, reason]
def git_common_dir
  out, err, st = Open3.capture3("git", "rev-parse", "--path-format=absolute", "--git-common-dir")
  return [nil, "git rev-parse --git-common-dir failed (#{err.strip.empty? ? 'not inside a git repository' : err.strip})"] unless st.success?
  [out.strip, nil]
end

# Every CANDIDATE store under a common dir, realpath'd. The key is validated
# for its TYPE first: a relative, empty, or non-directory common dir is an
# ERROR here, never an empty candidate list -- a wrongly computed key and a key
# that correctly matches nothing must not read the same.
# -> [candidates, nil] or [nil, reason]
def verdict_stores(common)
  c = common.to_s
  return [nil, "the git common dir is empty"] if c.strip.empty?
  return [nil, "the git common dir #{c.inspect} is not absolute (a cwd-relative key matches nothing from any other directory)"] unless c.start_with?("/")
  return [nil, "the git common dir #{c} is not a directory"] unless File.directory?(c)
  real = File.realpath(c)
  wt = File.join(real, "worktrees")
  if File.directory?(wt) && !(File.readable?(wt) && File.executable?(wt))
    return [nil, "#{wt} exists but cannot be listed"]
  end
  # One candidate per checkout's $GIT_DIR, whether or not its store exists
  # yet: a checkout that has never run the judge is still a place we looked.
  gitdirs = Dir.glob(File.join(wt, "*")).select { |d| File.directory?(d) }.sort
  [[File.join(real, "critic-verdicts")] + gitdirs.map { |d| File.join(d, "critic-verdicts") }, nil]
end

# The writer's store for THIS checkout, normalised exactly as verdict_stores
# normalises its candidates (realpath of the $GIT_DIR it hangs off), so the two
# sides of the comparison provably went through the same function.
def own_store
  dir = verdict_dir
  return nil unless dir && File.directory?(File.dirname(dir))
  File.join(File.realpath(File.dirname(dir)), File.basename(dir))
end

# Does a PASS receipt's judged diff cover <target>..<sha>? The judged diff is
# merge_base..sha, so it covers the target when merge_base IS the target or an
# ancestor of it (an older main is a superset review). A merge_base off the
# target -- a stacked parent branch -- leaves that parent's own commits
# unjudged, though the integrated diff contains them. Measured 2026-09-29
# (gen_saas DND-1185): a `--base <parent>` PASS was reused by integration-gate
# against origin/main and printed INTEGRATION OK, while a whole-stack run of the
# same judge had found real gaps in the parent commits.
#
# -> nil when covered (or the receipt is legacy schema 1, which records no
# merge base and was never checked), else [3, :err, lines].
def coverage_refusal(sha, data, full, covering)
  mb = data["merge_base"]
  return nil if mb.nil? && data["schema"].to_i < 2
  unless mb.to_s.match?(CriticCarry::SHA40)
    return [3, :err, ["critic-review: the PASS for #{sha} records no usable merge_base (#{mb.inspect}), so it cannot show it judged everything since #{covering}.",
                      "  Fix: re-run ~/dev/custom/ai/bin/critic-review --base <target> at #{sha} in the Mission's worktree. A PASS that cannot name what it judged does not cover the target."]]
  end
  _o, _e, st = Open3.capture3("git", "merge-base", "--is-ancestor", mb, covering)
  return nil if st.success?
  [3, :err, ["critic-review: the PASS for #{sha} does not cover #{covering}: it judged #{mb[0, 12]}..#{sha[0, 12]} (base #{data['base']}; receipt #{full}), and #{mb[0, 12]} is not #{covering[0, 12]} or an ancestor of it, so commits in the integrated diff were never judged.",
             "  Fix: run ~/dev/custom/ai/bin/critic-review --base <target> at #{sha} in the Mission's worktree (integration-gate --with-critic does this for you). A PASS judged against a stacked parent covers only that branch's own commits."]]
end

# Judge ONE receipt. Pure: returns [code, stream, lines] and prints nothing,
# so several stores' receipts can be compared before anything is said.
# covering: nil, or a resolved 40-hex SHA a PASS must cover (coverage_refusal).
def judge_receipt(sha, full, covering = nil)
  data = begin
    JSON.parse(File.read(full))
  rescue StandardError => e
    return [3, :err, ["critic-review: verdict receipt for #{sha} is unreadable (#{e.message}).",
                      "  Fix: delete #{full} and re-run ai/bin/critic-review. A corrupt receipt is an error, never a pass."]]
  end
  if data["dirty"]
    return [3, :err, ["critic-review: the verdict for #{sha} was recorded against a DIRTY working tree — it did not judge what you are about to merge.",
                      "  Fix: commit or discard the working-tree changes, then re-run ai/bin/critic-review so the verdict matches the head being merged."]]
  end
  carried = data["carried_from"]
  unless carried.nil? || carried.to_s.match?(CriticCarry::SHA40)
    return [3, :err, ["critic-review: verdict receipt for #{sha} names a malformed carried_from #{carried.inspect}.",
                      "  Fix: delete #{full} and re-run ai/bin/critic-review. A carried PASS that cannot name the commit the judge actually passed is never a pass."]]
  end
  upstream = data["upstream_range"]
  if upstream && carried.nil?
    return [3, :err, ["critic-review: verdict receipt for #{sha} names an upstream_range #{upstream.inspect} but no carried_from.",
                      "  Fix: delete #{full} and re-run ai/bin/critic-review. An interaction review only ever follows a carry; a receipt claiming one without its source is malformed, never a pass."]]
  end
  if upstream && data["interaction"] != data["verdict"]
    return [3, :err, ["critic-review: verdict receipt for #{sha} records verdict #{data['verdict'].inspect} but interaction #{data['interaction'].inspect}.",
                      "  Fix: delete #{full} and re-run ai/bin/critic-review. A head's verdict after a carry IS its interaction review's verdict; a receipt where they differ is malformed, never a pass."]]
  end
  unless upstream.nil? || upstream.to_s.match?(/\A[0-9a-f]{40}\.\.[0-9a-f]{40}\z/)
    return [3, :err, ["critic-review: verdict receipt for #{sha} names a malformed upstream_range #{upstream.inspect}.",
                      "  Fix: delete #{full} and re-run ai/bin/critic-review. An interaction verdict that cannot name the upstream delta it reviewed is never a pass."]]
  end
  case data["verdict"]
  when "pass"
    if covering && (refusal = coverage_refusal(sha, data, full, covering))
      return refusal
    end
    # The bracketed tokens are the machine-readable contract integration-gate
    # reads (DND-986); the prose around them may change, the tokens may not.
    token = carried ? " [critic-carried-from=#{carried}]" : ""
    token += " [critic-upstream=#{upstream}]" if upstream
    [0, :out, ["critic-review: VERDICT PASS for #{sha} (recorded #{data['at']}, base #{data['base']}; receipt #{full}).#{token}"]]
  when "block"
    what = upstream ? " (interaction review of the upstream delta #{upstream})" : ""
    [2, :err, ["critic-review: VERDICT BLOCK for #{sha}#{what} — findings: #{Array(data['findings']).join(', ')}",
               "  Fix: the standing judge found issues on this head. Have them addressed and re-run ai/bin/critic-review before merging."]]
  when "fail-open"
    [3, :err, ["critic-review: NO VERDICT for #{sha} — the judge FAILED OPEN (infra/model error) at #{data['at']}; it did not look at this diff.",
               "  Fix: re-run ai/bin/critic-review in this worktree. If it fails open again the model is unreachable — HOLD this one MR and move to the next Mission, or take the named escape hatch (integration-gate --critic-override '<reason>'). A fail-open is not a pass."]]
  else
    [3, :err, ["critic-review: verdict receipt for #{sha} records an unknown verdict #{data['verdict'].inspect}.",
               "  Fix: delete #{full} and re-run ai/bin/critic-review."]]
  end
end

def say(stream, lines)
  lines.each { |l| stream == :out ? puts(l) : warn(l) }
end

# Reader. THE ONE PLACE the rules live -- integration-gate calls this rather
# than parsing the JSON itself, so there is never a second copy of the
# semantics that could drift from the writer's.
#   0 = recorded PASS for exactly this sha, on a clean tree
#   2 = recorded BLOCK
#   3 = no green verdict; the REASON is always named on stderr
#
# Precedence: this checkout's own receipt wins (it is the one this checkout's
# own runs overwrite). Otherwise every other store is read; receipts that
# DISAGREE are an error naming each one, never a pick.
def verdict_for(sha, covering_ref = nil)
  unless sha.to_s =~ /\A[0-9a-f]{7,40}\z/
    warn "critic-review: --verdict-for needs a commit SHA (got #{sha.inspect})."
    warn "  Fix: pass the 40-char SHA of the head you intend to merge, e.g. --verdict-for $(git rev-parse HEAD)."
    return 3
  end
  # Resolving the coverage key is its own step: a ref that does not resolve is
  # an ERROR, never "nothing to check" (ai/CLAUDE.md -> "A failed lookup must
  # never look like an empty one").
  covering = nil
  if covering_ref
    out, _e, st = Open3.capture3("git", "rev-parse", "--verify", "-q", "#{covering_ref}^{commit}")
    covering = out.strip
    unless st.success? && covering.match?(CriticCarry::SHA40)
      warn "critic-review: COULD NOT LOOK — --covering #{covering_ref.inspect} does not resolve to a commit here."
      warn "  Fix: pass a ref or SHA this checkout has (fetch it first), e.g. --covering origin/main. An unresolvable target is an ERROR, never a pass."
      return 3
    end
  end
  common, why = git_common_dir
  stores, why = verdict_stores(common) unless why
  if why
    warn "critic-review: COULD NOT LOOK for a verdict for #{sha} — #{why}."
    warn "  Fix: run this from inside a checkout (main or worktree) of the repo that holds the commit. An unresolvable verdict store is an ERROR, never a pass, and it says nothing about whether the judge ran."
    return 3
  end
  own = own_store
  if own && !stores.include?(own)
    warn "critic-review: COULD NOT LOOK reliably — this checkout writes receipts to #{own}, which is not among the #{stores.size} store(s) the reader derives from #{File.realpath(common)}."
    warn "  Fix: the writer and reader key the store differently (a git layout this tool does not model, e.g. GIT_DIR/GIT_COMMON_DIR overrides). Unset those overrides and re-run; do not read this as 'no verdict'."
    return 3
  end
  unreadable = stores.select { |d| File.exist?(d) && !(File.readable?(d) && File.executable?(d)) }
  unless unreadable.empty?
    warn "critic-review: COULD NOT LOOK in #{unreadable.join(', ')} (exists but cannot be listed)."
    warn "  Fix: restore read+search permission on #{unreadable.first}. An unreadable store is an ERROR, never a pass."
    return 3
  end

  existing = stores.select { |d| File.directory?(d) }
  ordered = ([own] & existing) + (existing - [own])
  hits = ordered.flat_map { |d| Dir.glob(File.join(d, "#{sha}*.json")).sort }
  considered = existing.sum { |d| Dir.glob(File.join(d, "*.json")).size }

  full_shas = hits.map { |p| File.basename(p, ".json") }.uniq
  if full_shas.size > 1
    warn "critic-review: AMBIGUOUS SHA #{sha} — it prefixes receipts for #{full_shas.size} different commits (#{full_shas.join(', ')})."
    warn "  Fix: pass the full 40-char SHA, e.g. --verdict-for $(git rev-parse <ref>)."
    return 3
  end

  if hits.empty?
    if (run_marker = ordered.flat_map { |d| Dir.glob(File.join(d, "#{sha}*.running")) }.first)
      warn "critic-review: NO VERDICT for #{sha} — a judge run is IN PROGRESS (started #{File.read(run_marker).strip}; marker #{run_marker})."
      warn "  Fix: wait for that run to finish, then re-read. Do NOT merge while the judge is still running (DND-194 landed a factual error on main exactly this way). If the run is a corpse, re-run ai/bin/critic-review in the worktree that owns that marker."
      return 3
    end
    warn "critic-review: NO VERDICT for #{sha} — no receipt recorded for it in any checkout of this repo."
    warn "  Searched key: git common dir #{File.realpath(common)}; #{existing.size} of #{stores.size} candidate store(s) exist; #{considered} receipt(s) considered, 0 match #{sha}."
    existing.each { |d| warn "    searched: #{d}" }
    warn "  Fix: run ~/dev/custom/ai/bin/critic-review in the Mission's worktree (at #{sha}) to record a verdict. A verdict for a DIFFERENT commit does not count, and a receipt in a worktree that has since been REMOVED went with it; 'no verdict' is not a pass."
    return 3
  end

  own_hit = own && hits.find { |p| File.dirname(p) == own }
  if own_hit
    code, stream, lines = judge_receipt(sha, own_hit, covering)
    say(stream, lines)
    return code
  end

  judged = hits.map { |p| [p, *judge_receipt(sha, p, covering)] }
  codes = judged.map { |j| j[1] }
  if codes.uniq.size > 1
    # A recorded BLOCK anywhere keeps its exit 2, so integration-gate's
    # --critic-override (which covers only the ABSENCE of a verdict) can never
    # merge past it by way of a conflict.
    code = codes.include?(2) ? 2 : 3
    warn "critic-review: CONFLICTING verdicts for #{sha} across checkouts of this repo — not choosing between them#{code == 2 ? '; one of them is a recorded BLOCK' : ''}."
    judged.each { |p, c, _s, l| warn "    exit #{c} from #{p}: #{l.first}" }
    warn "  Fix: re-run ~/dev/custom/ai/bin/critic-review at #{sha} in the Mission's worktree; its own receipt then takes precedence there. Conflicting receipts are never a pass."
    return code
  end
  _p, code, stream, lines = judged.first
  say(stream, lines)
  code
end

# The round at which the per-cluster rungs stop being the bound and a kind-3
# finding routes to the ARTIFACT-scope decision instead (athena:critic-convergence
# -> "After the escalation"). Both measured loops that RESOLVED took eight rounds,
# so a ceiling at or below 8 is a false positive costing a needless descope; the
# loop that did NOT resolve was at round 13 when its admiral had to invent the
# closure pass unaided. This is NOT the cluster trigger -- that stays at one
# kind-3 with no round threshold.
ARTIFACT_CEILING_ROUND = 12

# How many judge rounds this worktree has recorded, and which SHAs they were.
# The receipt dir is per-worktree (`git rev-parse --git-path` resolves against
# the worktree's own $GIT_DIR) and a worktree is ONE unit of work (repo
# CLAUDE.md -> "Agents work in worktrees"), so every receipt in it belongs to
# this change.
#
# Counted from the DIRECTORY, deliberately NOT from `git rev-list base..HEAD`:
# a rebase rewrites the round SHAs and orphans every earlier receipt, so an
# ancestry-based count would silently read LOW -- a wrongly-computed key
# indistinguishable from a legitimately empty one (ai/CLAUDE.md -> "A failed
# lookup must never look like an empty one"). DND-232 rebased twice mid-loop.
#
# Returns [count, shas] or nil. nil is an ERROR the caller must say out loud,
# never a silent "round 1".
#
# A PURE carry (DND-986) is not a round: no judge looked. An interaction
# review (round 3) is one -- a model gave a verdict. Only a receipt that parses,
# names a carried_from and records no interaction is excluded; an unreadable
# one still counts, so a corrupt file can never make the count read low.
def rounds_recorded
  dir = verdict_dir
  return nil unless dir && Dir.exist?(dir)
  carried = lambda do |p|
    r = JSON.parse(File.read(p))
    !r["carried_from"].nil? && r["interaction"].nil?
  rescue StandardError
    false
  end
  shas = Dir.glob(File.join(dir, "*.json")).reject { |p| carried.call(p) }
            .map { |p| File.basename(p, ".json") }.sort
  [shas.size, shas]
end

# Printed on a BLOCK only. This adds OUTPUT to a path that already exits 2 --
# it can never block something that did not already block, and never unblocks
# anything. Deliberate: a gate that went red on round count would create
# pressure toward exactly the override this discipline forbids.
def warn_round_notice(sha)
  rounds = rounds_recorded
  if rounds.nil?
    warn "  NOTE: ROUND NUMBER UNKNOWN — the verdict store could not be resolved, so this may not be round 1."
    warn "  Fix: re-run from the Mission's worktree so rounds are counted. If this is round 2+, apply the `athena:critic-convergence` skill before patching."
    return
  end
  n, shas = rounds
  return if n < 2
  prior = (shas - [sha]).map { |s| s[0, 7] }.join(", ")
  warn ""
  warn "  ROUND #{n} on this change (#{n - 1} earlier judge verdict(s) here: #{prior})."
  warn "  Fix: BEFORE patching these findings one at a time, run the convergence check in the"
  warn "  `athena:critic-convergence` skill. If ANY finding above exists only because of an"
  warn "  earlier round's own fix AND is a contradiction / unsatisfiability / unreachability"
  warn "  (not a stale name or citation), stop per-finding patching and run a CLUSTER ROUND."
  warn "  Two independent EIGHT-round loops (2026-09-19 athena:inbox, 2026-09-20 DND-232) were"
  warn "  exactly this, caught five rounds late. Round count is NEVER a reason to override the"
  warn "  judge, defer a finding, or merge with findings open."
  return if n < ARTIFACT_CEILING_ROUND
  warn ""
  warn "  ARTIFACT CEILING — round #{n} is at or past #{ARTIFACT_CEILING_ROUND}. The cluster rungs are per-cluster, so a"
  warn "  large artifact otherwise buys one trip up the ladder per cluster and never stops."
  warn "  Fix: a kind-3 finding at this round no longer buys a cluster round, whatever rung its"
  warn "  own cluster is on — route it to the ARTIFACT-scope decision in `athena:critic-convergence`"
  warn "  -> `After the escalation`: land the coherent core (no kind-3) with the row-per-open-question"
  warn "  table and file the rest, or PARK. The core still lands only on FINDINGS: none."
end

# The change's commit messages, oldest first, for the judge's commit-msg input.
#
# `base..HEAD` is the same commit set as the diff's `base...HEAD` (both are
# "on HEAD, not on base"). An empty string means there really are no commits
# (e.g. a diff of uncommitted work); nil means the log could NOT be read, which
# is said out loud here and reaches the judge as "NOT SUPPLIED" -- never as an
# empty log, which would read as "no fix was claimed".
#
# `head` defaults to HEAD; run() passes the head SHA it resolved once, so the
# judge's input, the receipt's key and the carry keys all describe ONE commit
# even if HEAD moves while the model is thinking.
def commit_log(base, head = "HEAD")
  out, err, st = Open3.capture3("git", "log", "--reverse", "--format=commit %H%n%B", "#{base}..#{head}")
  return out if st.success?

  warn "critic-review: NOTE could not read the commit messages for #{base}..#{head} (#{err.strip})."
  warn "  Fix: pass a --base that resolves in this repo. Until then the judge cannot see a bug-fix claim or its evidence."
  nil
end

# The patch fed to the judge, HERMETIC against the caller's own git config.
# Left unpinned, a user's `diff.external` silently swaps in an external diff
# tool (a different, possibly non-unified format the judge was never designed
# to read), `color.diff=always` forces ANSI escape codes into the patch even
# with no terminal attached (`always` means always, unlike the default
# `auto`), and `diff.noprefix` drops the `a/`/`b/` path prefixes CriticPrompt's
# fencing and any path-based reasoning assume. None of these raise -- the diff
# still "succeeds", just as a different diff -- so pin every one of them
# explicitly rather than trusting git's ambient config. Kept apart from
# `critic_output` so self-test can exercise it directly, under a hermetic
# config that FORCES the failure mode, without invoking `claude`.
DIFF_FLAGS = ["--no-ext-diff", "--no-color", "--src-prefix=a/", "--dst-prefix=b/"].freeze

# The hermetic three-dot diff alone -> [text, usable]. usable is false when git
# failed or the diff is empty; the carry keys are only ever computed from a
# usable three-dot diff, never from the fallback below.
def three_dot_diff(base, head = "HEAD")
  diff, _e, st = Open3.capture3("git", "diff", *DIFF_FLAGS, "#{base}...#{head}")
  [diff, st.success? && !diff.strip.empty?]
end

def diff_for(base, head = "HEAD")
  diff, usable = three_dot_diff(base, head)
  diff = Open3.capture3("git", "diff", *DIFF_FLAGS, base)[0] unless usable
  diff
end

# The judge's input is built by the caller (run), so the carry keys can be
# computed from the very same text. Kept as critic_output's own call so the
# single-copy prompt checks in --self-test still find it here.
def critic_output(diff, log)
  judge_call(CriticPrompt.build(diff: diff, commit_messages: log), :full)
end

# ONE judge invocation. kind is :full or :interaction (DND-986 round 3).
# Testing hooks: CRITIC_REVIEW_STUB answers a :full call and
# CRITIC_REVIEW_STUB_INTERACTION an :interaction call (falling back to
# CRITIC_REVIEW_STUB); CRITIC_REVIEW_PROMPT_LOG=<file> appends each prompt
# under a "=== PROMPT <kind>" line, so a self-test can assert which review ran.
def judge_call(prompt, kind)
  log = ENV["CRITIC_REVIEW_PROMPT_LOG"]
  if log && !log.empty?
    begin
      File.open(log, "a") { |f| f.write("=== PROMPT #{kind}\n#{prompt}\n") }
    rescue StandardError => e
      warn "critic-review: NOTE CRITIC_REVIEW_PROMPT_LOG=#{log} could not be written (#{e.message}); the judge still runs."
      warn "  Fix: unset CRITIC_REVIEW_PROMPT_LOG (a self-test hook) or point it at a writable file."
    end
  end
  stub = kind == :interaction ? (ENV["CRITIC_REVIEW_STUB_INTERACTION"] || ENV["CRITIC_REVIEW_STUB"]) : ENV["CRITIC_REVIEW_STUB"]
  # A SET stub is always the answer, never the live model: a FIFO (not
  # File.file?) or a mistyped path used to fall through to `claude -p` inside
  # the blocking gate (run_stub_self_test says why that mattered).
  if stub && !stub.empty?
    begin
      return [File.read(stub), true]
    rescue SystemCallError, IOError => e
      warn "critic-review: CRITIC_REVIEW_STUB=#{stub} is set but could not be read (#{e.message}); failing open instead of calling the live model."
      warn "  Fix: point CRITIC_REVIEW_STUB (a self-test hook) at a readable file or FIFO, or unset it to run the real judge."
      return ["", false]
    end
  end

  return ["", false] unless system("command -v claude >/dev/null 2>&1")
  out, _err, st = Open3.capture3("claude", "-p", "--agent", CRITIC, stdin_data: prompt)
  [out, st.success?]
rescue StandardError => e
  [+"error: #{e.message}", false]
end

# --- Carry (DND-986): side effects -----------------------------------------
#
# The decision is CriticCarry.decide (ai/lib/critic_carry.rb, pure). What
# lives here is only what needs git or the filesystem: the head's keys, the
# receipts to compare against, and the recompute that makes a source with
# wrongly recorded keys fail closed.

# `git patch-id --stable` over a diff text -> 40-hex or nil (git failed, or the
# diff was empty and git printed nothing).
def patch_id_for(diff_text)
  return nil if diff_text.to_s.strip.empty?
  out, _e, st = Open3.capture3("git", "patch-id", "--stable", stdin_data: diff_text)
  id = out.split.first
  st.success? && id.to_s.match?(CriticCarry::SHA40) ? id : nil
end

def merge_base_of(base, head)
  out, _e, st = Open3.capture3("git", "merge-base", base, head)
  st.success? && out.strip.match?(CriticCarry::SHA40) ? out.strip : nil
end

# Commit bodies of range, oldest first -> [bodies] or nil. `-z` NUL-terminates
# each body, so the final element after split is the terminator's empty tail.
def commit_bodies(range)
  out, _e, st = Open3.capture3("git", "log", "-z", "--reverse", "--format=%B", range)
  return nil unless st.success?
  parts = out.split("\0", -1)
  parts.pop if parts.last == ""
  parts
end

# The two file locations this harness installs the critic definition in: the
# project's .claude/agents (first) and the user's ~/.claude/agents. Digesting
# both means a wrong guess at the CLI's precedence only makes carry MORE
# conservative. Other sources the CLI supports (plugins, managed settings,
# --agents) are not used to install this critic and are deliberately out of
# scope; that residual is stated, not claimed closed.
#
# Each is framed by its ROLE ("project" / "user"), never by its absolute path:
# the project path differs per checkout, and a path-keyed digest made keys
# from two checkouts of one repo never match -- so a BLOCK recorded in another
# worktree could never veto (DND-986 review round; M10 in --self-test).
# -> [[role, bytes_or_nil], ...] or nil when a file exists but cannot be read
# (never read as ABSENT).
def critic_agent_defs
  top, _e, st = Open3.capture3("git", "rev-parse", "--show-toplevel")
  return nil unless st.success? && !top.strip.empty?
  roles = [["project", File.join(top.strip, ".claude", "agents", "#{CRITIC}.md")],
           ["user", File.join(Dir.home, ".claude", "agents", "#{CRITIC}.md")]]
  roles.map do |role, p|
    next [role, nil] unless File.exist?(p)
    return nil unless File.file?(p) && File.readable?(p)
    [role, File.binread(p)]
  end
rescue StandardError
  nil
end

# The head's five carry keys, computed from the SAME diff text the judge is
# shown. -> [keys, nil] or [keys_with_nils, reason] where reason is the first
# key that could not be computed, worded for the NOT ATTEMPTED line.
def head_carry_keys(base, sha, diff_text = nil)
  keys = CriticCarry::HEAD_KEYS.to_h { |k| [k, nil] }
  diff_text, usable = three_dot_diff(base, sha) if diff_text.nil?
  return [keys, "three-dot diff empty or failed"] if usable == false || diff_text.to_s.strip.empty?
  keys["merge_base"] = merge_base_of(base, sha)
  return [keys, "merge-base of #{base} and HEAD could not be computed"] unless keys["merge_base"]
  keys["patch_id"] = patch_id_for(diff_text)
  return [keys, "patch-id could not be computed"] unless keys["patch_id"]
  keys["diff_digest"] = CriticCarry.diff_digest(diff_text)
  bodies = commit_bodies("#{base}..#{sha}")
  return [keys, "commit log unreadable"] unless bodies
  keys["msgs_digest"] = CriticCarry.msgs_digest(bodies)
  defs = critic_agent_defs
  return [keys, "agent definition unreadable"] unless defs
  keys["judge_digest"] = CriticCarry.judge_digest(CriticPrompt.build(diff: "", commit_messages: ""), defs)
  [keys, nil]
end

# D8: recompute a same-key PASS source from the object store. A receipt whose
# recorded keys do not reproduce from its own commits fails closed.
# -> [true, nil] or [false, reason]
def revalidate_source(r)
  sha = r["sha"].to_s
  mb = r["merge_base"].to_s
  present = ->(c) { Open3.capture3("git", "cat-file", "-e", "#{c}^{commit}")[2].success? }
  return [false, "source commit missing"] unless sha.match?(CriticCarry::SHA40) && present.call(sha)
  return [false, "source commit missing (its merge-base #{mb[0, 12]})"] unless mb.match?(CriticCarry::SHA40) && present.call(mb)
  diff, _e, st = Open3.capture3("git", "diff", *DIFF_FLAGS, mb, sha)
  return [false, "recompute mismatch (git diff failed)"] unless st.success?
  return [false, "recompute mismatch (patch_id)"] unless patch_id_for(diff) == r["patch_id"]
  return [false, "recompute mismatch (diff_digest)"] unless CriticCarry.diff_digest(diff) == r["diff_digest"]
  bodies = commit_bodies("#{mb}..#{sha}")
  return [false, "recompute mismatch (msgs_digest)"] unless bodies && CriticCarry.msgs_digest(bodies) == r["msgs_digest"]
  [true, nil]
end

# An UNKEYED BLOCK -- schema 1 (written before carry keys existed), an
# unknown schema, or schema 2 with a null veto key (a key could not be computed
# when it was judged, though the judge still saw the real diff) -- on the SAME
# PATCH must still veto. Its patch is recomputed from its commit against its
# recorded merge-base, else its merge-base with the current base.
# -> :same, :different, :landed, or a String naming why it could not be
# recomputed. The String is doubt, and CriticCarry.decide fails closed on it.
#
# :landed -- no recorded merge-base, and the commit is already an ancestor of
# the HEAD's merge-base. Its merge-base with the base is then itself, so the
# recompute is an empty diff that says nothing about the patch it was judged
# on; but a commit in the head's base is upstream of the head's diff, never in
# it. Before this, each such receipt stopped every carry in the repo for good
# (measured 2026-09-28: 8 in ~/dev/custom's stores; M30). A receipt WITH a
# recorded merge-base is always recomputed from it, so an empty recorded patch
# (a judge shown uncommitted work) stays doubt.
def unkeyed_block_state(r, base, head_patch_id, head_merge_base = nil)
  sha = r["sha"].to_s
  return "its sha #{sha.inspect} is not a 40-hex commit" unless sha.match?(CriticCarry::SHA40)
  return "its commit #{sha[0, 12]} is gone from this object store" unless
    Open3.capture3("git", "cat-file", "-e", "#{sha}^{commit}")[2].success?
  recorded = r["merge_base"].to_s.match?(CriticCarry::SHA40)
  # Only a CLEAN receipt (dirty == false exactly): a dirty run whose three-dot
  # diff was empty showed the judge UNCOMMITTED work, which never landed and
  # might be this very change (M30b). A missing flag is doubt too.
  if !recorded && r["dirty"] == false && head_merge_base.to_s.match?(CriticCarry::SHA40) &&
     Open3.capture3("git", "merge-base", "--is-ancestor", sha, head_merge_base)[2].success?
    return :landed
  end
  mb = recorded ? r["merge_base"] : merge_base_of(base, sha)
  return "its merge-base with #{base} could not be computed" unless mb
  diff, _e, st = Open3.capture3("git", "diff", *DIFF_FLAGS, mb, sha)
  return "git diff #{mb[0, 12]} #{sha[0, 12]} failed" unless st.success?
  pid = patch_id_for(diff)
  return "its patch-id could not be computed" unless pid
  pid == head_patch_id ? :same : :different
end

# Resolve every store the READER searches, via the reader's own functions, so
# the writer never carries from a store set the reader would not agree on.
# -> [existing_stores, candidate_count, nil] or [nil, nil, reason]
def carry_stores
  common, why = git_common_dir
  stores, why = verdict_stores(common) unless why
  return [nil, nil, why] if why
  own = own_store
  return [nil, nil, "this checkout's store is not among the reader's #{stores.size} store(s)"] unless own && stores.include?(own)
  bad = stores.find { |d| File.exist?(d) && !(File.readable?(d) && File.executable?(d)) }
  return [nil, nil, "#{bad} exists but cannot be listed"] if bad
  existing = stores.select { |d| File.directory?(d) }
  [([own] & existing) + (existing - [own]), stores.size, nil]
end

# The verdict (or "running") HEAD already has in any store, else nil.
def existing_head_state(stores, sha)
  stores.each do |d|
    path = File.join(d, "#{sha}.json")
    next unless File.exist?(path)
    begin
      return (JSON.parse(File.read(path))["verdict"] || "unknown").to_s
    rescue StandardError
      return "unreadable"
    end
  end
  stores.any? { |d| File.exist?(File.join(d, "#{sha}.running")) } ? "running" : nil
end

def short12(sha) = sha.to_s[0, 12]

def carry_not_attempted(reason)
  warn "critic-review: CARRY NOT ATTEMPTED — #{reason}; running the judge."
  nil
end

# The carry step. -> 0 when a PASS was carried with nothing new upstream
# (receipt written, nothing else to do); a Hash, the interaction plan, on a hit
# whose base moved forward (see carry_hit); else nil, and the caller runs a
# FULL review. Every path prints exactly one of the distinct outcome lines
# (PASS (CARRIED) / CARRY HIT / CARRY MISS / CARRY REFUSED / CARRY NOT ATTEMPTED).
def attempt_carry(base, sha, dirty, keys, key_reason)
  return carry_not_attempted("no resolvable HEAD commit") unless sha
  stores, candidate_stores, why = carry_stores
  return carry_not_attempted("verdict store could not be resolved: #{why}") if why
  if (state = existing_head_state(stores, sha))
    return carry_not_attempted("HEAD already has a receipt (#{state})")
  end
  return carry_not_attempted("dirty tree") if dirty
  return carry_not_attempted(key_reason) if key_reason

  candidates = stores.flat_map { |d| Dir.glob(File.join(d, "*.json")).sort }.map do |path|
    r = begin
      JSON.parse(File.read(path))
    rescue StandardError
      nil
    end
    { receipt: r, path: path, validated: false, invalid_reason: nil }
  end
  candidates.each do |c|
    r = c[:receipt]
    next unless r.is_a?(Hash)
    if r["verdict"] == "block" && !CriticCarry.keyed_block?(r)
      c[:unkeyed_block] = unkeyed_block_state(r, base, keys["patch_id"], keys["merge_base"])
    end
    next unless r["schema"] == 2 && r["verdict"] == "pass"
    next unless CriticCarry::MATCH_KEYS.all? { |k| r[k] == keys[k] }
    c[:validated], c[:invalid_reason] = revalidate_source(r)
  end

  dec = CriticCarry.decide(keys, candidates)
  landed = dec.report ? Array(dec.report[:landed_blocks]) : []
  unless landed.empty?
    warn "critic-review: NOTE #{landed.size} BLOCK receipt(s) with no usable carry keys are on commits already in this head's base " \
         "(#{short12(keys['merge_base'])}); their change is upstream of this diff, so they were not treated as this change:"
    landed.each { |p| warn "  set aside: #{p}" }
  end
  case dec.outcome
  when :not_attempted
    carry_not_attempted(dec.reason)
  when :refused
    warn "critic-review: CARRY REFUSED — receipt #{dec.candidate[:path]} records a BLOCK on this identical change; running the judge."
    nil
  when :miss
    rep = dec.report
    warn "critic-review: CARRY MISS — no usable PASS for patch-id #{short12(keys['patch_id'])} (base #{base}, merge-base #{short12(keys['merge_base'])}); " \
         "#{rep[:considered]} receipt(s) in #{stores.size} of #{candidate_stores} candidate store(s) considered, #{rep[:share_patch_id]} share the patch-id."
    CriticCarry.miss_lines(rep).each { |l| warn l }
    warn "Running the judge."
    nil
  when :carry
    carry_hit(base, sha, keys, dec)
  end
end

# A carry HIT (DND-986 round 3, owner spec: "If a rebase doesn't change the
# branch itself and the last critic review for the branch passed, the
# critic's job should only be to see if the changes from the rebase cause a
# problem."). The carried PASS covers the branch's own diff only.
#   - nothing came in upstream (same base, or an upstream range that changes
#     no file): the carried PASS stands, no model call -> 0
#   - a forward rebase: -> an interaction plan for run_interaction
#   - anything that cannot be assembled (a non-forward rebase, an unreadable
#     upstream delta): NOT ATTEMPTED -> nil, and the caller runs a FULL review
def carry_hit(base, sha, keys, dec)
  src = dec.candidate[:receipt]
  judged = src["carried_from"] ? "carried #{src['at']} via #{short12(src['sha'])}" : "judged #{src['at']}"
  from, to = CriticCarry.upstream_range(src, keys)
  if from
    anc = Open3.capture3("git", "merge-base", "--is-ancestor", from, to)[2]
    unless anc.success?
      return carry_not_attempted("the source's base #{short12(from)} is not an ancestor of the new base #{short12(to)} " \
                                 "(not a forward rebase), so there is no upstream delta to review on its own")
    end
    up_diff, _e, st1 = Open3.capture3("git", "diff", *DIFF_FLAGS, from, to)
    up_paths, _e, st2 = Open3.capture3("git", "diff", "--no-ext-diff", "--name-only", from, to)
    br_paths, _e, st3 = Open3.capture3("git", "diff", "--no-ext-diff", "--name-only", keys["merge_base"], sha)
    br_diff, _e, st4 = Open3.capture3("git", "diff", *DIFF_FLAGS, keys["merge_base"], sha)
    unless [st1, st2, st3, st4].all?(&:success?)
      return carry_not_attempted("the upstream delta #{short12(from)}..#{short12(to)} or the branch diff could not be read")
    end
  end
  if from.nil? || up_diff.strip.empty?
    path = write_verdict(sha, base, "pass", [], false, keys: keys,
                         carried: { root: dec.root, receipt: dec.candidate[:path] }, exclusive: true)
    return carry_not_attempted("the carried receipt could not be written (see the NOTE above)") unless path
    puts "critic-review: PASS (CARRIED) — identical change already passed at #{short12(dec.root)} " \
         "(patch-id #{short12(keys['patch_id'])}; #{judged}, merge-base #{short12(src['merge_base'])}); no model call. Receipt #{path}."
    puts "  NOTE nothing came in upstream (#{from ? 'the upstream range changes no file' : 'the base did not move'}); integration-gate still gates the integrated head."
    return 0
  end

  up = up_paths.split("\n").reject(&:empty?)
  shared = CriticCarry.shared_files(up, br_paths.split("\n").reject(&:empty?))
  warn "critic-review: CARRY HIT — identical change already passed at #{short12(dec.root)} (patch-id #{short12(keys['patch_id'])}; #{judged}); " \
       "the branch's own diff is not re-judged. Reviewing ONLY the upstream delta #{short12(from)}..#{short12(to)} " \
       "(#{up.size} file(s) changed upstream, #{shared.size} also touched by the branch) for what it breaks in the branch."
  { root: dec.root, receipt: dec.candidate[:path], range: "#{from}..#{to}",
    prompt: CriticPrompt.build_interaction(upstream_range: "#{from}..#{to}", upstream_diff: up_diff,
                                           branch_diff: br_diff, shared_files: shared) }
end

# Run the interaction review a carry hit planned. -> exit code, like run().
def run_interaction(base, sha, keys, plan)
  started = mark_running(sha)
  raw, invoke_ok = judge_call(plan[:prompt], :interaction)
  findings, trailer_ok = parse_findings(raw)
  iaction, = decide(findings || [], trailer_ok, invoke_ok)
  action, code, label = CriticCarry.interaction_outcome(iaction)
  from, to = plan[:range].split("..")
  range12 = "#{short12(from)}..#{short12(to)}"
  path = write_verdict(sha, base, action, findings || [], false, keys: keys,
                       carried: { root: plan[:root], receipt: plan[:receipt] },
                       interaction: { range: plan[:range], verdict: iaction }, started_at: started)
  case action
  when "pass"
    puts "critic-review: #{label} — the branch's diff passed at #{short12(plan[:root])}; the upstream delta #{range12} " \
         "does not break it. Receipt #{path || '(not written)'}."
  when "block"
    warn "critic-review: BLOCKED (INTERACTION) — the upstream delta #{range12} breaks the branch: #{findings.join(', ')}"
    body = raw.to_s.lines
    trailer = body.rindex { |l| l =~ /^\s*FINDINGS:/i }
    body = body[0...trailer] if trailer
    text = body.join.strip
    warn(text.empty? ? "  (the critic returned a verdict with no body -- re-run to see it)" : text)
    warn "  Fix: the branch's own diff already passed; what is reported is what the rebase brought in breaking it. Adapt the branch to the upstream change (or say why a finding is wrong in the MR), then re-run."
    warn_round_notice(sha)
    warn_report_pointer(write_report(sha, raw), sha)
  else
    warn "critic-review: FAIL-OPEN — the interaction review of the upstream delta #{range12} did not return a usable verdict (infra/model error); NOT blocking, and NO green verdict is recorded."
    warn "  Fix: re-run ai/bin/critic-review once `claude` is reachable; the carried PASS covers only the branch's own diff, not what the rebase brought in. This head now has a (fail-open) receipt, so the re-run is a FULL review, not another interaction review."
    raw.to_s.strip.empty? ? warn("  NOTE the critic produced NO output at all, so there is no report to record.") : warn_report_pointer(write_report(sha, raw), sha)
  end
  code
end

def default_base
  out, _e, st = Open3.capture3("git", "symbolic-ref", "refs/remotes/origin/HEAD")
  return out.strip.sub(%r{^refs/remotes/}, "") if st.success? && !out.strip.empty?
  "main"
end

def run(argv)
  base = (i = argv.index("--base")) ? argv[i + 1] : default_base
  sha = head_sha
  dirty = tree_dirty?
  # The judge's input is built ONCE, pinned to the resolved head, and the carry
  # keys are computed from that same text -- a receipt's keys must describe
  # exactly what its judge was shown. The fallback diff (uncommitted work vs
  # base) is never keyed.
  pinned = sha || "HEAD"
  td, td_usable = three_dot_diff(base, pinned)
  judge_diff = td_usable ? td : diff_for(base, pinned)
  log = commit_log(base, pinned)
  keys, key_reason = sha ? head_carry_keys(base, sha, td_usable ? td : "") : [nil, "no resolvable HEAD commit"]
  key_reason ||= "commit log unreadable" if log.nil?

  if argv.include?("--no-carry")
    warn "critic-review: CARRY SKIPPED (--no-carry); running the judge."
  elsif (carried = attempt_carry(base, sha, dirty, keys, key_reason))
    # 0: a carried PASS with nothing new upstream. A Hash: a hit whose upstream
    # delta must be reviewed for interaction (round 3). nil falls through to a
    # FULL review, as every fail-closed path does.
    return carried if carried.is_a?(Integer)
    return run_interaction(base, sha, keys, carried)
  end

  started = mark_running(sha)
  raw, invoke_ok = critic_output(judge_diff, log)
  findings, trailer_ok = parse_findings(raw)
  action, code = decide(findings || [], trailer_ok, invoke_ok)
  write_verdict(sha, base, action, findings || [], dirty, keys: key_reason ? nil : keys, started_at: started)

  case action
  when "pass"
    puts "critic-review: PASS — athena-diff-critic reported no findings on the diff vs #{base}."
  when "block"
    warn "critic-review: BLOCKED — athena-diff-critic found: #{findings.join(', ')}"
    # PRINT THE BODY, NOT A GREP OF IT.
    #
    # This was `raw.lines.grep(/^\s*-\s*\[/)`, which printed NOTHING whenever
    # the critic formatted a finding any other way -- a numbered list, a
    # "**MUST-FIX**" heading, a table. The caller was then told the judge had
    # found things in three categories and shown none of them. Measured on
    # DND-184: three consecutive BLOCKED runs whose findings were dropped
    # here, and the work could only continue by invoking the critic by hand.
    #
    # A filter that silently discards the only content that matters, and
    # reports success at doing so, is the defect class this judge exists to
    # catch, sitting in the judge's own runner.
    #
    # Everything above the FINDINGS trailer is the report, printed whole. The
    # trailer is dropped because the line above already names the categories.
    body = raw.to_s.lines
    trailer = body.rindex { |l| l =~ /^\s*FINDINGS:/i }
    body = body[0...trailer] if trailer
    text = body.join.strip
    warn(text.empty? ? "  (the critic returned a verdict with no body -- re-run to see it)" : text)
    warn "  Fix: address each finding above (or, if a finding is wrong, say why in the MR) before this change ships."
    warn_round_notice(sha)
    # The WHOLE raw output, trailer included -- this file is the archival copy,
    # not a second rendering of what was just printed.
    warn_report_pointer(write_report(sha, raw), sha)
  when "fail-open"
    warn "critic-review: FAIL-OPEN — the critic did not return a usable verdict (infra/model error); NOT blocking."
    warn "  Fix: re-run ai/bin/critic-review once `claude` is reachable; a human should eyeball this diff since the judge did not run."
    # A fail-open's raw output is the diagnosis (a model error, a partial answer,
    # a missing trailer) and is just as destroyable by a truncating capture.
    # Empty raw is its OWN state: there is no body to point at, and saying so is
    # not the same as pointing at a file that would be empty.
    if raw.to_s.strip.empty?
      warn "  NOTE the critic produced NO output at all, so there is no report to record."
    else
      warn_report_pointer(write_report(sha, raw), sha)
    end
  end
  code
end

# Capture $stderr around a block, returning [result, stderr_text].
def capture_err
  require "stringio"
  prev = $stderr
  $stderr = StringIO.new
  res = yield
  [res, $stderr.string]
ensure
  $stderr = prev
end

def capture_out
  require "stringio"
  prev = $stdout
  $stdout = StringIO.new
  res = yield
  [res, $stdout.string]
ensure
  $stdout = prev
end

# EVERY self-test assertion goes through st_check, so a failing case prints its
# NAME. The suite used to chain `ok &&= <cond>`: a false case said nothing, and
# every later case in that suite was skipped, so the only output of a red run
# was "self-test FAILED" (DND-1435: the sandboxed harness-gate red could not be
# diagnosed). A case name is printed at the failure, and run_self_test lists all
# of them again at the end, so a reader of a truncated tail still learns which.
SELF_TEST_FAILED_CASES = []

def st_check(name, cond)
  return true if cond

  warn "critic-review --self-test: FAILED case: #{name}"
  SELF_TEST_FAILED_CASES << name
  false
end

# A suite that RAISES is a failure with a name too, never a stack trace that
# ends the run before the other suites report.
def st_suite(name)
  before = SELF_TEST_FAILED_CASES.size
  return true if yield
  # Its failing cases already named themselves; name the suite only if none did.
  return false if SELF_TEST_FAILED_CASES.size > before

  st_check("#{name}: the suite failed without naming a case", false)
rescue StandardError => e
  st_check("#{name}: raised #{e.class}: #{e.message} (at #{e.backtrace&.first})", false)
end

# The self-test's git runs against NO global or system git config. The fixture
# repos must build their own state: the host's `init.defaultBranch=main` in
# ~/.gitconfig used to be what made `--base main` resolve in them, so inside
# tool-sandbox (an empty HOME) case (13) failed and nothing on the host could
# show it (DND-1435). Isolating the config here makes the host run exactly as
# hermetic as the sandboxed one.
def with_hermetic_git_config
  require "tmpdir"
  keys = %w[GIT_CONFIG_GLOBAL GIT_CONFIG_NOSYSTEM]
  prev = keys.to_h { |k| [k, ENV[k]] }
  Dir.mktmpdir("critic-review-gitcfg-") do |d|
    empty = File.join(d, "gitconfig")
    File.write(empty, "")
    ENV["GIT_CONFIG_GLOBAL"] = empty
    ENV["GIT_CONFIG_NOSYSTEM"] = "1"
    yield
  end
ensure
  prev&.each { |k, v| v.nil? ? ENV.delete(k) : ENV[k] = v }
end

# The receipt half of the suite. It runs inside a REAL throwaway git repo,
# because the writer/reader resolve their store through git -- running it in
# the live repo would both pollute $GIT_DIR and test the wrong tree.
#
# Every case here is a MISS case except the first: the whole point of the
# receipt is that "never ran" / "still running" / "fail-open" / "stale SHA"
# stop being indistinguishable from PASS, so a suite that only proved the
# PASS path would prove nothing about the defect this exists to catch.
def run_receipt_self_test
  require "tmpdir"
  ok = true
  c = ->(name, cond) { ok = st_check("receipt #{name}", cond) && ok }
  stubs = Dir.mktmpdir("critic-review-stubs-")
  clean_out = File.join(stubs, "c"); File.write(clean_out, "looks good\nFINDINGS: none\n")
  findings_out = File.join(stubs, "f"); File.write(findings_out, "- [access-control] x.ex:1 — no authz\nFINDINGS: access-control\n")
  broken_out = File.join(stubs, "b"); File.write(broken_out, "the model crashed, no trailer here\n")

  # (8) unresolvable store: outside any git work tree, a missing store is an
  # ERROR (3), never a pass. This is the case that would otherwise exit 0.
  Dir.mktmpdir("critic-review-nogit-") do |nogit|
    Dir.chdir(nogit) do
      code, err = capture_err { verdict_for("a" * 40) }
      c.call("(8) no git work tree exits 3", code == 3)
      c.call("(8) no git work tree carries a Fix:", err.include?("Fix:"))
    end
  end

  # (cov) --covering: a PASS counts only if its judged diff (merge_base..sha)
  # covers the target. The DND-1185 miss: a PASS judged against a stacked parent
  # that is not on the target read as a PASS for the whole integrated diff.
  Dir.mktmpdir("critic-review-cov-") do |repo|
    Dir.chdir(repo) do
      sh = ->(*a) { system(*a, out: File::NULL, err: File::NULL) }
      commit = lambda do |f|
        File.write(f, "#{f}\n")
        sh.call("git", "add", "-A")
        sh.call("git", "-c", "commit.gpgsign=false", "commit", "-qm", f)
        head_sha
      end
      sh.call("git", "init", "-q", "-b", "trunk", ".")
      sh.call("git", "config", "user.email", "t@example.invalid")
      sh.call("git", "config", "user.name", "t")
      root = commit.call("root")
      sh.call("git", "checkout", "-qb", "parent")
      parent = commit.call("parent")
      sh.call("git", "checkout", "-qb", "child")
      sha = commit.call("child")
      dir = verdict_dir
      FileUtils.mkdir_p(dir)
      receipt = lambda do |mb, schema = 2|
        r = { "schema" => schema, "tool" => "critic-review", "sha" => sha, "base" => "x", "verdict" => "pass",
              "findings" => [], "dirty" => false, "at" => "2026-09-29T00:00:00Z" }
        r["merge_base"] = mb if schema >= 2
        File.write(File.join(dir, "#{sha}.json"), JSON.generate(r))
      end
      read = ->(cov) { capture_err { capture_out { verdict_for(sha, cov) }[0] } }
      receipt.call(parent)
      code, err = read.call("trunk")
      check_cov = c
      check_cov.call("cov1 narrow-base PASS does not cover trunk", code == 3 && err.include?("does not cover") && err.include?("Fix:"))
      code, = read.call("parent")
      check_cov.call("cov2 the same PASS covers the parent it was judged on", code == 0)
      code, = read.call(nil)
      check_cov.call("cov3 no --covering keeps the old reading", code == 0)
      receipt.call(root)
      code, = read.call("trunk")
      check_cov.call("cov4 an ancestor merge_base covers the target", code == 0)
      receipt.call(nil, 1)
      code, = read.call("trunk")
      check_cov.call("cov5 a legacy schema-1 PASS is not checked", code == 0)
      receipt.call("zz")
      code, err = read.call("trunk")
      check_cov.call("cov6 a schema-2 PASS with no usable merge_base is refused", code == 3 && err.include?("Fix:"))
      receipt.call(parent)
      code, err = read.call("no-such-ref")
      check_cov.call("cov7 an unresolvable --covering is COULD NOT LOOK", code == 3 && err.include?("COULD NOT LOOK"))
    end
  end
  c.call("(cov8) --covering without --verdict-for is refused",
         usage_error(["--covering", "main"]) == "--covering applies only to --verdict-for.")

  Dir.mktmpdir("critic-review-repo-") do |repo|
    Dir.chdir(repo) do
      sh = ->(*a) { system(*a, out: File::NULL, err: File::NULL) }
      sh.call("git", "init", "-q", ".")
      sh.call("git", "config", "user.email", "t@example.invalid")
      sh.call("git", "config", "user.name", "t")
      File.write("a.txt", "one\n")
      sh.call("git", "add", "-A")
      sh.call("git", "-c", "commit.gpgsign=false", "commit", "-qm", "one")
      parent = head_sha
      File.write("a.txt", "two\n")
      sh.call("git", "add", "-A")
      sh.call("git", "-c", "commit.gpgsign=false", "commit", "-qm", "two")
      sha = head_sha
      c.call("(0) the fixture repo has two distinct commits", !sha.nil? && sha != parent)
      dir = verdict_dir
      c.call("(0) the fixture repo resolves a verdict store", !dir.nil?)

      # (2) no receipt -> 3, and it must NOT read as a pass. It names what was
      # searched (DND-457) and never claims to know the judge did not run.
      code, err = capture_err { verdict_for(sha) }
      c.call("(2) no receipt exits 3", code == 3)
      c.call("(2) no receipt says so", err.match?(/no receipt recorded/))
      c.call("(2) no receipt names the searched key",
             err.include?("Searched key: git common dir #{File.realpath(File.join(repo, '.git'))}"))
      c.call("(2) no receipt counts the receipts considered", err.include?("receipt(s) considered"))
      c.call("(2) no receipt never claims the judge has NOT run", !err.match?(/has NOT run/))
      c.call("(2) no receipt carries a Fix:", err.include?("Fix:"))

      # (4) still running (the DND-194 state) -> 3, named DISTINCTLY from (2).
      FileUtils.mkdir_p(dir)
      File.write(File.join(dir, "#{sha}.running"), Time.now.utc.iso8601)
      code, err = capture_err { verdict_for(sha) }
      c.call("(4) a running judge exits 3", code == 3)
      c.call("(4) a running judge reads IN PROGRESS", err.match?(/IN PROGRESS/))
      c.call("(4) a running judge carries a Fix:", err.include?("Fix:"))
      FileUtils.rm_f(File.join(dir, "#{sha}.running"))

      # (1) hit + (10) the running marker is cleared by a completed run.
      ENV["CRITIC_REVIEW_STUB"] = clean_out
      _r, _e = capture_err { run(["--base", "main"]) }
      c.call("(1) a PASS run records a receipt", File.file?(File.join(dir, "#{sha}.json")))
      c.call("(10) a completed run clears the running marker", !File.exist?(File.join(dir, "#{sha}.running")))
      code, _err = capture_err { verdict_for(sha) }
      c.call("(1) --verdict-for reads the recorded PASS as 0", code == 0)
      # (10b, DND-1006) the start survives the marker's removal: the receipt
      # carries started_at, at or before "at", and duration_s, their gap.
      rec = JSON.parse(File.read(File.join(dir, "#{sha}.json")))
      t_start = (Time.iso8601(rec["started_at"].to_s) rescue nil)
      t_at = (Time.iso8601(rec["at"].to_s) rescue nil)
      dur_ok = t_start && t_at && rec["duration_s"].is_a?(Numeric) && rec["duration_s"] >= 0 &&
               t_start <= t_at && (t_at - t_start - rec["duration_s"]).abs <= 1
      warn "self-test: FAIL — (10b) the receipt lacks a consistent started_at/duration_s: #{rec.slice('started_at', 'at', 'duration_s').inspect}. Fix: pass mark_running's start to write_verdict (started_at:)." unless dur_ok
      c.call("(10b) the receipt carries a consistent started_at/duration_s", dur_ok)

      # (5) stale SHA: the PASS above belongs to `sha`, not to `parent`.
      code, err = capture_err { verdict_for(parent) }
      c.call("(5) a stale SHA exits 3", code == 3)
      c.call("(5) a stale SHA carries a Fix:", err.include?("Fix:"))

      # (3) THE DND-212 REGRESSION: a fail-open still exits 0 for the captain
      # (never wedge the fleet) but records NO green verdict for the admiral.
      FileUtils.rm_f(File.join(dir, "#{sha}.json"))
      ENV["CRITIC_REVIEW_STUB"] = broken_out
      rc, _e = capture_err { run(["--base", "main"]) }
      c.call("(3) a fail-open exits 0 for the captain", rc == 0)
      code, err = capture_err { verdict_for(sha) }
      c.call("(3) a fail-open reads 3 for the admiral", code == 3)
      c.call("(3) a fail-open reads FAILED OPEN", err.match?(/FAILED OPEN/))
      c.call("(3) a fail-open carries a Fix:", err.include?("Fix:"))

      # (9) block -> the receipt records it and the reader returns 2.
      ENV["CRITIC_REVIEW_STUB"] = findings_out
      rc, _e = capture_err { run(["--base", "main"]) }
      c.call("(9) a BLOCK run exits 2", rc == 2)
      code, err = capture_err { verdict_for(sha) }
      c.call("(9) --verdict-for reads the recorded BLOCK as 2", code == 2)
      c.call("(9) a recorded BLOCK carries a Fix:", err.include?("Fix:"))

      # (15-19) THE REPORT BODY SURVIVES A TRUNCATED READ.
      #
      # The defect: the receipt kept the finding CATEGORIES and threw the body
      # away, so `critic-review | tail -N` destroyed the only copy of the text
      # saying what was wrong. Three instances in the 2026-09-20 notif-platform
      # run, one of them unrecoverable. These cases test the property, not the
      # wording: a file exists, it holds the body, and a reader who keeps only
      # the END of the stream still learns where it is.
      report = File.join(dir, "#{sha}.report.txt")
      FileUtils.rm_f(report)
      ENV["CRITIC_REVIEW_STUB"] = findings_out
      rc, err = capture_err { run(["--base", "main"]) }
      c.call("(15) a BLOCK run exits 2", rc == 2)
      # (15) recorded, and WHOLE -- the trailer too, since this is the archival
      # copy and not a re-render of what was printed.
      c.call("(15) a BLOCK records a report file", File.file?(report))
      c.call("(15) the report is the whole judge output", File.file?(report) && File.read(report) == File.read(findings_out))
      # (16) it holds the very text a truncated read loses: the finding body.
      c.call("(16) the report holds the finding body", File.file?(report) && File.read(report).include?("no authz"))
      # (17) THE TRUNCATION-SURVIVAL PROPERTY. `tail` keeps the end, so the
      # pointer must be at the end. A regression that moves it anywhere else
      # (e.g. before warn_round_notice) leaves the feature working and the
      # REASON for it broken -- which is exactly how this would rot back.
      tail = err.lines.map(&:strip).reject(&:empty?).last(4).join("\n")
      c.call("(17) the last lines of stderr name the report", tail.include?(report))
      c.call("(17) the last lines of stderr carry a Fix:", tail.include?("Fix:"))

      # (18) a fail-open's diagnosis is just as destroyable, so it is recorded
      # too -- the missing-trailer output IS the thing a human must read.
      FileUtils.rm_f(report)
      ENV["CRITIC_REVIEW_STUB"] = broken_out
      _rc, err = capture_err { run(["--base", "main"]) }
      c.call("(18) a fail-open records a report file", File.file?(report))
      c.call("(18) the fail-open report holds its diagnosis",
             File.file?(report) && File.read(report).include?("the model crashed"))
      c.call("(18) a fail-open names its report", err.include?(report))

      # (19) EMPTY raw is its OWN state. Pointing at a file that would be empty
      # is a claimed mechanism that cannot fire; say there is nothing instead.
      empty_out = File.join(stubs, "e"); File.write(empty_out, "   \n")
      FileUtils.rm_f(report)
      ENV["CRITIC_REVIEW_STUB"] = empty_out
      _rc, err = capture_err { run(["--base", "main"]) }
      c.call("(19) an empty judge output records no report", !File.exist?(report))
      c.call("(19) an empty judge output says NO output at all", err.match?(/NO output at all/))
      c.call("(19) an empty judge output points at no report", !err.include?("FULL REPORT RECORDED AT"))

      # (20-21) A NEW RECEIPT RETIRES THE OLD REPORT (DND-907).
      #
      # The defect: a FAIL-OPEN wrote <sha>.report.txt; a re-run on the same
      # sha recorded `verdict: pass` and never touched the report, so the file
      # the "FULL REPORT" pointer names contradicted the receipt beside it.
      # Measured on a75a777 (DND-880 captain report, 2026-09-27).
      #
      # (20) FAIL-OPEN with a body, then PASS on the same sha: no report
      # survives, matching every other PASS (M21).
      named = ->(label, cond) { st_check("receipt #{label}", cond) }
      ENV["CRITIC_REVIEW_STUB"] = broken_out
      capture_err { run(["--base", "main"]) }
      ok = named.call("(20) a fail-open with a body records a report", File.file?(report)) && ok
      ENV["CRITIC_REVIEW_STUB"] = clean_out
      rc, _e = capture_err { run(["--base", "main"]) }
      ok = named.call("(20) the re-run PASSES", rc == 0) && ok
      ok = named.call("(20) a PASS after a fail-open leaves no stale report", !File.exist?(report)) && ok
      # (21) BLOCK, then an EMPTY-raw FAIL-OPEN on the same sha: the fail-open
      # records no report of its own, so the BLOCK's body must not stand in
      # for it beside a fail-open receipt.
      ENV["CRITIC_REVIEW_STUB"] = findings_out
      capture_err { run(["--base", "main"]) }
      ok = named.call("(21) a BLOCK records a report", File.file?(report)) && ok
      ENV["CRITIC_REVIEW_STUB"] = empty_out
      capture_err { run(["--base", "main"]) }
      ok = named.call("(21) an empty-raw fail-open after a BLOCK leaves no stale report", !File.exist?(report)) && ok
      # (22) a report that CANNOT be removed is named, never silently kept. A
      # non-empty directory at the report's path defeats rm_f for any user,
      # root included, so this reproduces the failure without permissions.
      # rm_rf first: if (21) regressed, its report is still a FILE here, and
      # mkdir_p would raise and end the suite instead of naming the failure.
      FileUtils.rm_rf(report)
      FileUtils.mkdir_p(File.join(report, "x"))
      ENV["CRITIC_REVIEW_STUB"] = clean_out
      rc, err = capture_err { run(["--base", "main"]) }
      ok = named.call("(22) an unremovable report is named with a Fix:",
                      err.include?("could not be removed: #{report}") && err.include?("Fix:")) && ok
      ok = named.call("(22) and the verdict is unchanged: still a PASS, exit 0", rc == 0) && ok
      FileUtils.rm_rf(report)

      ENV["CRITIC_REVIEW_STUB"] = findings_out

      # (7) malformed receipt is an ERROR, not a pass.
      File.write(File.join(dir, "#{sha}.json"), "{not json")
      code, err = capture_err { verdict_for(sha) }
      c.call("(7) a malformed receipt exits 3", code == 3)
      c.call("(7) a malformed receipt carries a Fix:", err.include?("Fix:"))

      # (6) a verdict recorded against a DIRTY tree did not judge what is
      # about to merge.
      File.write(File.join(dir, "#{sha}.json"), JSON.generate(
        "schema" => VERDICT_SCHEMA, "sha" => sha, "base" => "main",
        "verdict" => "pass", "findings" => [], "dirty" => true,
        "at" => Time.now.utc.iso8601
      ))
      code, err = capture_err { verdict_for(sha) }
      c.call("(6) a PASS recorded on a dirty tree exits 3", code == 3)
      c.call("(6) a PASS recorded on a dirty tree carries a Fix:", err.include?("Fix:"))

      # A non-SHA argument is rejected rather than globbed into a match.
      code, err = capture_err { verdict_for("") }
      c.call("(6b) an empty SHA argument exits 3", code == 3)
      c.call("(6b) an empty SHA argument carries a Fix:", err.include?("Fix:"))

      ENV.delete("CRITIC_REVIEW_STUB")
    end
  end

  # (11-14) ROUND COUNTING -- the convergence signal (athena:critic-convergence).
  # Its own repo: the cases above rewrite one SHA's receipt repeatedly, which
  # would make the count here meaningless.
  #
  # The notice is stderr on an already-exit-2 path, so none of this can change
  # whether the judge blocks; what is under test is that the ROUND NUMBER is
  # right, and that an unresolvable store says so instead of reading as round 1.
  Dir.mktmpdir("critic-review-rounds-") do |repo|
    Dir.chdir(repo) do
      sh = ->(*a) { system(*a, out: File::NULL, err: File::NULL) }
      sh.call("git", "init", "-q", ".")
      sh.call("git", "config", "user.email", "t@example.invalid")
      sh.call("git", "config", "user.name", "t")
      commit = lambda do |body|
        File.write("a.txt", body)
        sh.call("git", "add", "-A")
        sh.call("git", "-c", "commit.gpgsign=false", "commit", "-qm", body)
        head_sha
      end
      first = commit.call("one")

      # (11) no store yet -> nil, and the caller says ROUND NUMBER UNKNOWN with
      # a Fix:. It must NEVER silently read as round 1.
      c.call("(11) no store yet counts as unknown, not 0", rounds_recorded.nil?)
      _r, err = capture_err { warn_round_notice(first) }
      c.call("(11) no store says ROUND NUMBER UNKNOWN", err.include?("ROUND NUMBER UNKNOWN"))
      c.call("(11) no store carries a Fix:", err.include?("Fix:"))
      c.call("(11) no store never reads as round 1", !err.match?(/ROUND 1\b/))

      ENV["CRITIC_REVIEW_STUB"] = findings_out

      # (12) round 1 BLOCK records a receipt but prints NO round notice --
      # a converging first pass must not be nagged.
      rc, err = capture_err { run(["--base", "main"]) }
      c.call("(12) the round-1 BLOCK exits 2", rc == 2)
      c.call("(12) round 1 is counted as 1", rounds_recorded&.first == 1)
      c.call("(12) round 1 prints no ROUND notice", !err.include?("ROUND"))
      c.call("(12) round 1 does not route to critic-convergence", !err.include?("critic-convergence"))

      # (13) round 2 BLOCK DOES print it, names the round, routes to the skill,
      # and lists the PRIOR sha while EXCLUDING the current head.
      second = commit.call("two")
      rc, err = capture_err { run(["--base", "main"]) }
      c.call("(13) the round-2 BLOCK exits 2", rc == 2)
      c.call("(13) round 2 is counted as 2", rounds_recorded&.first == 2)
      c.call("(13) the notice names ROUND 2", err.include?("ROUND 2 on this change"))
      c.call("(13) the notice routes to athena:critic-convergence", err.include?("athena:critic-convergence"))
      c.call("(13) the notice names the CLUSTER ROUND", err.include?("CLUSTER ROUND"))
      # These two are claims about the ROUND NOTICE -- "it lists the prior
      # SHAs and not the head you are on" -- so they are asserted against the
      # notice, not against all of stderr. The report pointer that follows it
      # names the current head inside a file path, legitimately and by design;
      # reading the whole stream would fail on that and say "the notice named
      # the current head", which is not what happened.
      notice = err.split("FULL REPORT RECORDED AT").first.to_s
      c.call("(13) the notice names the earlier round's SHA", notice.include?(first[0, 7]))
      c.call("(13) the notice does not name the current head", !notice.include?(second[0, 7]))
      c.call("(13) the notice says round count is NEVER a reason to override", err.match?(/NEVER a reason to override/))

      # (13b) BELOW THE ARTIFACT CEILING the notice must NOT mention it -- a
      # per-cluster loop that is still working is never told to descope. (The
      # at-ceiling half is case 15, in its own repo, because driving the count
      # up here would break case 14's expectation of exactly 2.)
      c.call("(13b) below the ceiling the notice does not name the ARTIFACT CEILING", !err.include?("ARTIFACT CEILING"))

      # (14) THE REBASE CASE. A rebase rewrites the round SHAs and orphans every
      # earlier receipt, so an ancestry-based count would read LOW and silently
      # under-report the round -- the failed-lookup class. Counting from the
      # DIRECTORY survives it: move HEAD off both recorded commits entirely and
      # the count must still be 2.
      commit.call("three")
      sh.call("git", "-c", "commit.gpgsign=false", "reset", "-q", "--hard", first)
      c.call("(14) a reset off both recorded commits still counts 2", rounds_recorded&.first == 2)

      ENV.delete("CRITIC_REVIEW_STUB")
    end
  end

  # (15) THE ARTIFACT CEILING, at and one short of the boundary. Its OWN repo:
  # driving the round count to 12 inside the case-11-14 repo would break case
  # 14's expectation of exactly 2.
  #
  # What is under test is the BOUNDARY, not "some large number fires" -- the
  # ceiling's whole justification is that it sits ABOVE the two loops that
  # RESOLVED at eight rounds, so a ceiling that crept down to 8 would start
  # ordering needless descopes and nothing else would notice.
  Dir.mktmpdir("critic-review-ceiling-") do |repo|
    Dir.chdir(repo) do
      sh = ->(*a) { system(*a, out: File::NULL, err: File::NULL) }
      sh.call("git", "init", "-q", ".")
      sh.call("git", "config", "user.email", "t@example.invalid")
      sh.call("git", "config", "user.name", "t")
      commit = lambda do |body|
        File.write("a.txt", body)
        sh.call("git", "add", "-A")
        sh.call("git", "-c", "commit.gpgsign=false", "commit", "-qm", body)
        head_sha
      end
      commit.call("base")
      ENV["CRITIC_REVIEW_STUB"] = findings_out

      c.call("(15c) the ceiling sits above both loops that resolved at 8", ARTIFACT_CEILING_ROUND > 8)

      # Each commit body MUST be unique: commit.call writes it to a.txt, so a
      # repeated body is an empty commit git refuses -- HEAD would not move, no
      # new receipt would be recorded, and the count would never advance. The
      # iteration bound is belt-and-braces so a future regression FAILS the
      # suite instead of hanging it (repo CLAUDE.md -> the safe-wait pattern:
      # every loop carries a max-iteration bound).
      n = 0
      while (rounds_recorded&.first || 0) < ARTIFACT_CEILING_ROUND - 1
        n += 1
        break if n > ARTIFACT_CEILING_ROUND + 5
        commit.call("round-#{n}")
        capture_err { run(["--base", "main"]) }
      end

      # One SHORT of the ceiling: silent about it.
      c.call("(15c) the count reaches one short of the ceiling", rounds_recorded&.first == ARTIFACT_CEILING_ROUND - 1)
      _rc, err = capture_err { warn_round_notice(head_sha) }
      c.call("(15c) one short, the notice names its round",
             err.include?("ROUND #{ARTIFACT_CEILING_ROUND - 1} on this change"))
      c.call("(15c) one short, the notice is silent about the ceiling", !err.include?("ARTIFACT CEILING"))

      # AT the ceiling: names it, routes to the artifact-scope decision, and
      # still exits 2. The notice is stderr on an already-blocking path, so it
      # must never change whether the judge blocks.
      commit.call("at-ceiling")
      rc, err = capture_err { run(["--base", "main"]) }
      c.call("(15c) at the ceiling the BLOCK still exits 2", rc == 2)
      c.call("(15c) the count reaches the ceiling", rounds_recorded&.first == ARTIFACT_CEILING_ROUND)
      c.call("(15c) at the ceiling the notice names the ARTIFACT CEILING", err.include?("ARTIFACT CEILING"))
      c.call("(15c) at the ceiling the notice carries a Fix:", err.include?("Fix:"))
      c.call("(15c) at the ceiling the notice offers PARK", err.include?("PARK"))
      c.call("(15c) at the ceiling the core still lands only on FINDINGS: none", err.include?("FINDINGS: none"))
      # The ceiling paragraph ITSELF routes to a SCOPE decision and offers no
      # merge path -- scoped to the text after the marker, because the generic
      # notice above it legitimately contains "merge with findings open" in the
      # course of FORBIDDING it.
      ceiling_text = err.split("ARTIFACT CEILING", 2).last.to_s
      c.call("(15c) the ceiling paragraph offers no merge path",
             !ceiling_text.match?(/--critic-override|known-open|merge with findings/i))
      c.call("(15c) the ceiling paragraph routes to the ARTIFACT-scope decision",
             ceiling_text.match?(/ARTIFACT-scope decision/i))

      ENV.delete("CRITIC_REVIEW_STUB")
    end
  end

  FileUtils.remove_entry(stubs)
  ok
end

# DND-457: a verdict recorded in ONE checkout of a repo must be found from ANY
# checkout of it. The writer keys per-worktree ($GIT_DIR/critic-verdicts); the
# reader used to look ONLY in its own $GIT_DIR, so the main checkout said "the
# judge has NOT run" for a SHA whose PASS sat in a worktree -- a failed lookup
# reading as a fact it could not know. Each case names itself on failure, so
# the fail-first run says WHICH property broke.
def run_cross_checkout_self_test
  require "tmpdir"
  ok = true
  check = ->(name, cond) { ok = st_check("cross-checkout #{name}", cond) && ok }
  stubs = Dir.mktmpdir("critic-review-xstubs-")
  clean_out = File.join(stubs, "c"); File.write(clean_out, "looks good\nFINDINGS: none\n")

  Dir.mktmpdir("critic-review-xrepo-") do |root|
    main_co = File.join(root, "main")
    wt_a = File.join(root, "wt-a")
    wt_b = File.join(root, "wt-b")
    sh = ->(*a) { system(*a, out: File::NULL, err: File::NULL) }
    FileUtils.mkdir_p(main_co)
    Dir.chdir(main_co) do
      sh.call("git", "init", "-q", "-b", "main", ".")
      sh.call("git", "config", "user.email", "t@example.invalid")
      sh.call("git", "config", "user.name", "t")
      File.write("a.txt", "one\n")
      sh.call("git", "add", "-A")
      sh.call("git", "-c", "commit.gpgsign=false", "commit", "-qm", "one")
      sh.call("git", "worktree", "add", "-q", "-b", "feat-a", wt_a)
      sh.call("git", "worktree", "add", "-q", "-b", "feat-b", wt_b)
    end

    sha = nil
    Dir.chdir(wt_a) do
      File.write("a.txt", "two\n")
      sh.call("git", "-c", "commit.gpgsign=false", "commit", "-qam", "two")
      sha = head_sha
      ENV["CRITIC_REVIEW_STUB"] = clean_out
      capture_err { capture_out { run(["--base", "main"]) } }
      ENV.delete("CRITIC_REVIEW_STUB")
      code, = capture_err { capture_out { verdict_for(sha) }[0] }
      check.call("x0 the recording worktree reads its own PASS", code == 0)
    end

    # x1 THE DND-457 REPRO: the PASS was recorded in wt-a; the main checkout
    # must find it, not report "has NOT run".
    Dir.chdir(main_co) do
      (code, out), err = capture_err { capture_out { verdict_for(sha) } }
      check.call("x1 main checkout finds a PASS recorded in a worktree (exit #{code}; #{err.lines.first.to_s.strip})", code == 0)
      check.call("x1 the PASS line names the store it was found in", out.include?("worktrees/wt-a/critic-verdicts"))
      check.call("x1 never claims the judge has NOT run", !err.match?(/has NOT run/))
    end

    # x2 a sibling worktree finds it too.
    Dir.chdir(wt_b) do
      code, = capture_err { capture_out { verdict_for(sha) }[0] }
      check.call("x2 sibling worktree finds a PASS recorded in another worktree (exit #{code})", code == 0)
    end

    # x3 A WRONGLY COMPUTED KEY IS AN ERROR, NOT AN EMPTY RESULT. ".git" is
    # exactly what plain `--git-common-dir` returns in a main checkout.
    stores, why = verdict_stores(".git")
    check.call("x3 a relative common dir is refused", stores.nil? && why.to_s.include?("not absolute"))
    stores, why = verdict_stores("")
    check.call("x3 an empty common dir is refused", stores.nil? && why.to_s.include?("empty"))
    stores, why = verdict_stores(File.join(root, "no-such-dir"))
    check.call("x3 a missing common dir is refused", stores.nil? && why.to_s.include?("not a directory"))

    # x4 BOTH SIDES NORMALISE THE SAME WAY: from every checkout -- including one
    # reached through a symlinked path -- the writer's store is one of the
    # reader's candidates, and the resolver hands back an absolute key.
    link = File.join(root, "link-to-main")
    File.symlink(main_co, link)
    [main_co, wt_a, wt_b, link].each do |co|
      Dir.chdir(co) do
        common, why = git_common_dir
        check.call("x4 #{File.basename(co)}: common dir resolves absolute (#{common.inspect})", why.nil? && common.start_with?("/"))
        cands, = verdict_stores(common)
        check.call("x4 #{File.basename(co)}: writer's store is among the reader's candidates", cands.to_a.include?(own_store))
        code, = capture_err { capture_out { verdict_for(sha) }[0] }
        check.call("x4 #{File.basename(co)}: finds the PASS (exit #{code})", code == 0)
      end
    end

    # x5 A REAL MISS NAMES WHAT IT SEARCHED and how many receipts it read.
    Dir.chdir(main_co) do
      code, err = capture_err { verdict_for("b" * 40) }
      check.call("x5 miss exits 3", code == 3)
      check.call("x5 miss says no receipt in any checkout", err.include?("no receipt recorded for it in any checkout"))
      check.call("x5 miss names the key", err.include?("git common dir #{File.realpath(File.join(main_co, '.git'))}"))
      check.call("x5 miss lists the worktree store it searched", err.include?("worktrees/wt-a/critic-verdicts"))
      check.call("x5 miss counts the receipts considered", err.include?("1 receipt(s) considered"))
      check.call("x5 miss carries Fix:", err.include?("Fix:"))
      check.call("x5 miss never claims the judge has NOT run", !err.match?(/has NOT run/))
    end

    # x6 CONFLICTING receipts: never pick one. The checkout's OWN receipt
    # still wins inside that checkout.
    b_store = Dir.chdir(wt_b) { verdict_dir }
    FileUtils.mkdir_p(b_store)
    File.write(File.join(b_store, "#{sha}.json"), JSON.generate(
      "schema" => VERDICT_SCHEMA, "sha" => sha, "base" => "main", "verdict" => "block",
      "findings" => ["correctness"], "dirty" => false, "at" => Time.now.utc.iso8601
    ))
    Dir.chdir(main_co) do
      code, err = capture_err { capture_out { verdict_for(sha) }[0] }
      check.call("x6 PASS vs BLOCK is CONFLICTING and keeps the BLOCK's exit 2 (exit #{code})", code == 2 && err.include?("CONFLICTING") && err.include?("recorded BLOCK"))
      check.call("x6 conflict names each receipt", err.include?("wt-a") && err.include?("wt-b") && err.include?("Fix:"))
    end
    Dir.chdir(wt_b) { check.call("x6 own BLOCK wins in wt-b", capture_err { verdict_for(sha) }[0] == 2) }
    Dir.chdir(wt_a) { check.call("x6 own PASS wins in wt-a", capture_err { capture_out { verdict_for(sha) }[0] }[0] == 0) }
    # PASS vs FAIL-OPEN disagree without a BLOCK: exit 3, still CONFLICTING.
    File.write(File.join(b_store, "#{sha}.json"), JSON.generate(
      "schema" => VERDICT_SCHEMA, "sha" => sha, "base" => "main", "verdict" => "fail-open",
      "findings" => [], "dirty" => false, "at" => Time.now.utc.iso8601
    ))
    Dir.chdir(main_co) do
      code, err = capture_err { capture_out { verdict_for(sha) }[0] }
      check.call("x6 PASS vs FAIL-OPEN is CONFLICTING exit 3 (exit #{code})", code == 3 && err.include?("CONFLICTING"))
    end
    FileUtils.rm_f(File.join(b_store, "#{sha}.json"))

    # x7 a run IN PROGRESS in another worktree is seen from the main checkout.
    other = "c" * 40
    File.write(File.join(b_store, "#{other}.running"), "2026-09-24T00:00:00Z")
    Dir.chdir(main_co) do
      code, err = capture_err { verdict_for(other) }
      check.call("x7 a running marker in a worktree reads IN PROGRESS from main", code == 3 && err.include?("IN PROGRESS") && err.include?("worktrees/wt-b"))
    end
    FileUtils.rm_f(File.join(b_store, "#{other}.running"))

    # x8 an UNREADABLE store is COULD NOT LOOK, not a miss. (root reads
    # anything, so the case cannot be staged there.)
    unless Process.uid.zero?
      File.chmod(0o000, b_store)
      Dir.chdir(main_co) do
        code, err = capture_err { verdict_for(sha) }
        check.call("x8 unreadable store is COULD NOT LOOK (exit #{code})", code == 3 && err.include?("COULD NOT LOOK") && err.include?("Fix:"))
      end
      File.chmod(0o755, b_store)
    end
  end

  # x9 outside any repo: COULD NOT LOOK, never "no verdict".
  Dir.mktmpdir("critic-review-xnogit-") do |nogit|
    Dir.chdir(nogit) do
      code, err = capture_err { verdict_for("a" * 40) }
      check.call("x9 outside a repo is COULD NOT LOOK (exit #{code})", code == 3 && err.include?("COULD NOT LOOK") && err.include?("Fix:"))
      check.call("x9 outside a repo does not claim a miss", !err.include?("no receipt recorded"))
    end
  end
  FileUtils.remove_entry(stubs)
  ok
end

# DND-986 DOMAIN: the pure carry-key and decision functions in
# ai/lib/critic_carry.rb. Every case names itself on failure. The cases marked
# MISS feed a key that is absent or wrongly matching and assert the code SAYS
# so -- a carry that cannot be attempted must never read as "found nothing".
def run_carry_domain_self_test
  ok = true
  check = ->(name, cond) { ok = st_check("carry domain #{name}", cond) && ok }
  cc = CriticCarry

  # normalize_diff
  d_a = "diff --git a/x b/x\nindex 1111111..2222222 100644\n--- a/x\n+++ b/x\n@@ -1,2 +1,3 @@\n a\n+b\n c\n"
  d_b = "diff --git a/x b/x\nindex 3333333..4444444 100644\n--- a/x\n+++ b/x\n@@ -7,2 +9,3 @@\n a\n+b\n c\n"
  check.call("D1 index lines and hunk numbers are normalised away", cc.normalize_diff(d_a) == cc.normalize_diff(d_b))
  check.call("D2 a one-space indentation change is NOT normalised away",
             cc.normalize_diff(d_a) != cc.normalize_diff(d_a.sub("+b\n", "+ b\n")))
  check.call("D3 hunk function context is kept",
             cc.normalize_diff("@@ -3,4 +9,4 @@ def foo\n").start_with?("@@ @@ def foo"))
  check.call("D4 an added body line that looks like an index line is kept",
             cc.normalize_diff("+index 1..2\n").include?("+index 1..2"))
  check.call("D4b a single-line hunk header normalises too", cc.normalize_diff("@@ -3 +9 @@\n") == "@@ @@\n")
  check.call("D4c digests differ exactly when normalised text differs",
             cc.diff_digest(d_a) == cc.diff_digest(d_b) && cc.diff_digest(d_a) =~ /\A[0-9a-f]{64}\z/)

  # msgs_digest / judge_digest
  check.call("D5 a body with failing-first evidence digests differently",
             cc.msgs_digest(["fix: a\n"]) != cc.msgs_digest(["fix: a\n\nFailing before: x\n"]))
  check.call("D6 the digest reads bodies only (no SHAs), so a rebase keeps it",
             cc.msgs_digest(%W[one\n two\n]) == cc.msgs_digest(%W[one\n two\n]))
  check.call("D7 bodies are NUL-separated: [a,b] != [ab]", cc.msgs_digest(%w[a b]) != cc.msgs_digest(%w[ab]))
  check.call("D7b a trailing empty body is not the same as no body", cc.msgs_digest(["a", ""]) != cc.msgs_digest(["a"]))
  check.call("D8 an ABSENT agent definition differs from a present one",
             cc.judge_digest("T", [["p1", "X"], ["p2", nil]]) != cc.judge_digest("T", [["p1", "X"], ["p2", "Y"]]))
  check.call("D8b the location's role label is part of the digest",
             cc.judge_digest("T", [["project", "X"]]) != cc.judge_digest("T", [["user", "X"]]))
  check.call("D9 a one-byte template change differs", cc.judge_digest("T", []) != cc.judge_digest("U", []))

  # decide
  sha1 = "1" * 40
  keys = { "merge_base" => "a" * 40, "patch_id" => "b" * 40, "diff_digest" => "c" * 64,
           "msgs_digest" => "d" * 64, "judge_digest" => "e" * 64 }
  rec = lambda do |verdict: "pass", sha: sha1, **over|
    { "schema" => 2, "sha" => sha, "verdict" => verdict, "dirty" => false,
      "carried_from" => nil }.merge(keys).merge(over.transform_keys(&:to_s))
  end
  cand = ->(r, path: "/s/#{r['sha']}.json", validated: true, why: nil) { { receipt: r, path: path, validated: validated, invalid_reason: why } }
  near = ->(dec) { dec.report[:near_misses].map { |_p, reason| reason }.join(" | ") }

  dec = cc.decide(keys, [cand.call(rec.call)])
  check.call("D10 a validated schema-2 PASS with equal keys carries", dec.outcome == :carry && dec.root == sha1)
  pass_c = cand.call(rec.call)
  block_c = cand.call(rec.call(verdict: "block", sha: "2" * 40))
  [[pass_c, block_c], [block_c, pass_c]].each_with_index do |cands, i|
    dec = cc.decide(keys, cands)
    check.call("D11.#{i} a BLOCK on the identical change vetoes regardless of order",
               dec.outcome == :refused && dec.candidate.equal?(block_c))
  end
  other_judge_block = cand.call(rec.call(verdict: "block", sha: "5" * 40, judge_digest: "0" * 64))
  dec = cc.decide(keys, [pass_c, other_judge_block])
  check.call("D11d a BLOCK under ANOTHER judge version still vetoes (veto ignores judge_digest)",
             dec.outcome == :refused && dec.candidate.equal?(other_judge_block))
  unreadable = { receipt: nil, path: "/s/broken.json", validated: false, invalid_reason: nil }
  dec = cc.decide(keys, [pass_c, unreadable])
  check.call("D25 MISS an unreadable receipt is NOT ATTEMPTED naming it (it might be a BLOCK)",
             dec.outcome == :not_attempted && dec.reason.include?("/s/broken.json"))
  # An UNKEYED BLOCK (schema 1, or schema 2 with a null veto key) is judged
  # by the caller's recompute of its patch: :same, :different, or a String
  # saying why it could not be recomputed.
  legacy_block = cand.call({ "schema" => 1, "sha" => "4" * 40, "verdict" => "block", "dirty" => false })
  legacy_block[:unkeyed_block] = :same
  dec = cc.decide(keys, [pass_c, legacy_block])
  check.call("D11b a schema-1 BLOCK on the same patch (recomputed) vetoes", dec.outcome == :refused && dec.candidate.equal?(legacy_block))
  legacy_block[:unkeyed_block] = :different
  dec = cc.decide(keys, [pass_c, legacy_block])
  check.call("D11c a schema-1 BLOCK on another patch does not veto", dec.outcome == :carry)
  nullkey_block = cand.call(rec.call(verdict: "block", sha: "6" * 40, patch_id: nil, diff_digest: nil,
                                     msgs_digest: nil, judge_digest: nil, merge_base: nil))
  nullkey_block[:unkeyed_block] = :same
  dec = cc.decide(keys, [pass_c, nullkey_block])
  check.call("D26 a schema-2 BLOCK with null keys on the same patch (recomputed) vetoes",
             dec.outcome == :refused && dec.candidate.equal?(nullkey_block))
  nullkey_block[:unkeyed_block] = nil
  dec = cc.decide(keys, [pass_c, nullkey_block])
  check.call("D26b an unkeyed BLOCK the caller never classified is NOT ATTEMPTED (fail closed)",
             dec.outcome == :not_attempted && dec.reason.include?("/s/#{'6' * 40}.json"))
  nullkey_block[:unkeyed_block] = "source commit missing"
  dec = cc.decide(keys, [pass_c, nullkey_block])
  check.call("D27 an unkeyed BLOCK whose patch cannot be recomputed is NOT ATTEMPTED naming it and why",
             dec.outcome == :not_attempted && dec.reason.include?("/s/#{'6' * 40}.json") && dec.reason.include?("source commit missing"))
  # D29 an unkeyed BLOCK whose commit is already in the head's base (:landed)
  # is not this change: it does not stop the carry, and it is COUNTED, so the
  # caller can say how many it set aside (never a silent drop).
  nullkey_block[:unkeyed_block] = :landed
  dec = cc.decide(keys, [pass_c, nullkey_block])
  check.call("D29 an unkeyed BLOCK already in the head's base does not stop the carry, and is counted",
             dec.outcome == :carry && dec.report[:landed_blocks] == [nullkey_block[:path]])
  legacy_block[:unkeyed_block] = :same
  dec = cc.decide(keys, [pass_c, nullkey_block, legacy_block])
  check.call("D29b a landed BLOCK never masks a same-patch BLOCK beside it", dec.outcome == :refused && dec.candidate.equal?(legacy_block))
  # --- Round 3: the INTERACTION review (owner spec). On a hit the carried PASS
  # covers only the branch's own diff; the judge then reviews only what the
  # rebase brought in.
  mb_old = "a" * 40
  mb_new = "c" * 40
  check.call("I1 same base: no upstream range (plain carry, no model call)",
             cc.upstream_range({ "merge_base" => mb_old }, { "merge_base" => mb_old }).nil?)
  check.call("I2 moved base: the range is source base .. new base",
             cc.upstream_range({ "merge_base" => mb_old }, { "merge_base" => mb_new }) == [mb_old, mb_new])
  check.call("I3 files touched by both sides, sorted, no duplicates",
             cc.shared_files(%w[b.rb a.rb x.md a.rb], %w[a.rb z.rb b.rb]) == %w[a.rb b.rb])
  check.call("I4 interaction PASS -> head PASS labelled CARRIED + INTERACTION",
             cc.interaction_outcome("pass") == ["pass", 0, "PASS (CARRIED + INTERACTION)"])
  check.call("I5 interaction BLOCK -> head BLOCK (exit 2)", cc.interaction_outcome("block")[0, 2] == ["block", 2])
  check.call("I6 interaction fail-open -> no green verdict (fail-open)", cc.interaction_outcome("fail-open")[0] == "fail-open")
  check.call("I6b an unknown interaction action is never a pass", cc.interaction_outcome("weird")[0] == "fail-open")
  ip = CriticPrompt.build_interaction(upstream_range: "#{mb_old}..#{mb_new}", upstream_diff: "UPSTREAMBODY",
                                      branch_diff: "BRANCHBODY", shared_files: %w[a.rb b.rb])
  check.call("I7 interaction prompt leads with its own instruction", ip.start_with?(CriticPrompt::INTERACTION_INSTRUCTION))
  check.call("I8 the instruction scopes the judge to the upstream delta and forbids re-judging the branch",
             CriticPrompt::INTERACTION_INSTRUCTION.include?("upstream") &&
             CriticPrompt::INTERACTION_INSTRUCTION.match?(/do not re-judge/i) &&
             CriticPrompt::INTERACTION_INSTRUCTION.include?("FINDINGS"))
  check.call("I9 names the upstream range", ip.include?("#{mb_old}..#{mb_new}"))
  check.call("I10 carries the upstream diff, then the branch diff as context",
             ip.include?("UPSTREAMBODY") && ip.include?("BRANCHBODY") && ip.index("UPSTREAMBODY") < ip.index("BRANCHBODY"))
  check.call("I11 lists the files both sides touch", ip.include?("a.rb") && ip.include?("b.rb"))
  none_shared = CriticPrompt.build_interaction(upstream_range: "x..y", upstream_diff: "U", branch_diff: "B", shared_files: [])
  check.call("I12 no shared file is said, not left blank", none_shared.include?(CriticPrompt::INTERACTION_NO_SHARED))
  fenced = CriticPrompt.build_interaction(upstream_range: "x..y", upstream_diff: "a\n```\nb", branch_diff: "B", shared_files: [])
  check.call("I13 a ``` inside a diff cannot close its block", fenced.include?("````diff\na\n```\nb\n````"))
  check.call("I14 the interaction prompt does not carry the full-review bug-fix addendum",
             !ip.include?(CriticPrompt::BUG_FIX_RULE))

  odd = cand.call({ "sha" => "7" * 40, "verdict" => "pass" })
  odd2 = cand.call({ "schema" => 3, "sha" => "8" * 40, "verdict" => "pass" })
  dec = cc.decide(keys, [odd, odd2])
  check.call("D28 unknown or missing schemas are counted and named in the miss",
             dec.outcome == :miss && dec.report[:unknown_schema] == 2 && cc.miss_lines(dec.report).join.include?("unknown or missing schema"))
  %w[diff_digest msgs_digest judge_digest].each_with_index do |k, i|
    dec = cc.decide(keys, [cand.call(rec.call(k => "f" * 64))])
    check.call("D#{12 + i} a differing #{k} is a miss that names it (#{near.call(dec)})",
               dec.outcome == :miss && near.call(dec).include?(k) && dec.report[:share_patch_id] == 1)
  end
  legacy = { "schema" => 1, "sha" => sha1, "verdict" => "pass", "dirty" => false }
  dec = cc.decide(keys, [cand.call(legacy)])
  check.call("D15 a schema-1 PASS is never a source and the miss names schema 1",
             dec.outcome == :miss && dec.report[:schema1] == 1 && cc.miss_lines(dec.report).join("\n").include?("schema 1"))
  %w[source\ commit\ missing recompute\ mismatch].each do |why|
    dec = cc.decide(keys, [cand.call(rec.call, validated: false, why: why)])
    check.call("D16 an unvalidated source is a miss naming #{why}", dec.outcome == :miss && near.call(dec).include?(why))
  end
  dec = cc.decide(keys, [cand.call(rec.call(dirty: true))])
  check.call("D17 a dirty-tree PASS is a miss", dec.outcome == :miss && near.call(dec).include?("dirty"))
  dec = cc.decide(keys, [cand.call(rec.call(verdict: "fail-open"))])
  check.call("D18 a fail-open is counted, never used", dec.outcome == :miss && dec.report[:fail_open] == 1)
  dec = cc.decide(keys.merge("patch_id" => nil), [cand.call(rec.call)])
  check.call("D19 MISS a nil head key is NOT ATTEMPTED, never a miss",
             dec.outcome == :not_attempted && dec.reason.include?("patch_id"))
  dec = cc.decide(keys.merge("merge_base" => ""), [])
  check.call("D19b an empty head key is NOT ATTEMPTED", dec.outcome == :not_attempted)
  dec = cc.decide(keys, [])
  check.call("D20 zero candidates is a miss with count 0",
             dec.outcome == :miss && dec.report[:considered].zero? && dec.report[:share_patch_id].zero?)
  s0 = "0" * 40
  dec = cc.decide(keys, [cand.call(rec.call(carried_from: s0))])
  check.call("D21 a carried source passes its ROOT through (chains never nest)", dec.outcome == :carry && dec.root == s0)
  carried_c = cand.call(rec.call(carried_from: s0, sha: "3" * 40))
  judged_c = cand.call(rec.call(sha: s0))
  dec = cc.decide(keys, [carried_c, judged_c])
  check.call("D21b with several usable sources the judged one is named", dec.outcome == :carry && dec.candidate.equal?(judged_c))
  dec = cc.decide(keys, [cand.call(rec.call("merge_base" => nil))])
  check.call("D22 a source with a null key is never used", dec.outcome == :miss && near.call(dec).include?("null key"))
  dec = cc.decide(keys, [cand.call(rec.call(carried_from: "not-a-sha"))])
  check.call("D23 a source with a malformed carried_from is never used", dec.outcome == :miss)
  other = cand.call(rec.call("patch_id" => "9" * 40))
  dec = cc.decide(keys, [other, cand.call(legacy)])
  check.call("D24 counts: considered all, share only the equal patch-id",
             dec.report[:considered] == 2 && dec.report[:share_patch_id].zero? && dec.report[:near_misses].empty?)
  ok
end

# DND-986 MANAGER: carry inside a real throwaway repo with a stubbed judge.
#
# Two stubs: CRITIC_REVIEW_STUB answers a FULL review, and
# CRITIC_REVIEW_STUB_INTERACTION answers an INTERACTION review (round 3, owner
# spec). Cases that expect a carry set the full stub to BLOCK, so a run that
# fell back to a full review would exit 2. CRITIC_REVIEW_PROMPT_LOG records
# which kind of prompt each judge call was sent, so "no model call" and
# "interaction only" are asserted directly. Every miss case sets the full stub
# to BLOCK too, so "the judge ran" is observable as exit 2.
#
# HOME is a throwaway so the judge digest reads a fixture agent definition,
# never the machine's real ~/.claude/agents.
def run_carry_self_test
  require "tmpdir"
  ok = true
  check = ->(name, cond) { ok = st_check("carry #{name}", cond) && ok }
  stubs = Dir.mktmpdir("critic-review-carry-stubs-")
  pass_out = File.join(stubs, "p"); File.write(pass_out, "fine\nFINDINGS: none\n")
  block_out = File.join(stubs, "b"); File.write(block_out, "- [correctness] x:1 — wrong\nFINDINGS: correctness\n")
  home = Dir.mktmpdir("critic-review-carry-home-")
  agent_def = File.join(home, ".claude", "agents", "#{CRITIC}.md")
  FileUtils.mkdir_p(File.dirname(agent_def))
  File.write(agent_def, "fixture critic v1\n")
  prev_home = ENV["HOME"]
  ENV["HOME"] = home
  git = ->(*a) { system("git", "-c", "commit.gpgsign=false", *a, out: File::NULL, err: File::NULL) }
  sha_of = ->(ref) { Open3.capture3("git", "rev-parse", ref)[0].strip }
  broken_out = File.join(stubs, "x"); File.write(broken_out, "model crashed, no trailer\n")
  plog = File.join(stubs, "prompts.log")
  go = lambda do |argv, stub, inter = pass_out|
    ENV["CRITIC_REVIEW_STUB"] = stub
    ENV["CRITIC_REVIEW_STUB_INTERACTION"] = inter
    ENV["CRITIC_REVIEW_PROMPT_LOG"] = plog
    File.write(plog, "")
    (rc, out), err = capture_err { capture_out { run(argv) } }
    [rc, out, err]
  end
  kinds = -> { File.read(plog).scan(/^=== PROMPT (\w+)$/).flatten }
  last_prompt = -> { File.read(plog).split(/^=== PROMPT \w+$/).last.to_s }
  receipt = ->(sha) { JSON.parse(File.read(File.join(verdict_dir, "#{sha}.json"))) }

  # The common setup: main has a seed; feature commit F1 ("fix: x" with
  # evidence) is judged PASS vs main; main advances; feature rebases -> F2, an
  # identical patch with a new SHA and no receipt. Yields [f1, f2] inside it.
  fixture = lambda do |two_commits: false, &blk|
    Dir.mktmpdir("critic-review-carry-") do |root|
      repo = File.join(root, "repo")
      FileUtils.mkdir_p(repo)
      Dir.chdir(repo) do
        git.call("init", "-q", "-b", "main", ".")
        git.call("config", "user.email", "t@example.invalid")
        git.call("config", "user.name", "t")
        File.write("seed.txt", "seed\n")
        git.call("add", "-A"); git.call("commit", "-qm", "seed")
        git.call("checkout", "-qb", "feat")
        if two_commits
          File.write("f.txt", "a\n"); git.call("add", "-A"); git.call("commit", "-qm", "part one")
          File.write("f.txt", "a\nb\n"); git.call("add", "-A"); git.call("commit", "-qm", "part two")
        else
          File.write("f.txt", "a\nb\n"); git.call("add", "-A")
          git.call("commit", "-qm", "fix: x\n\nFailing before: y")
        end
        f1 = head_sha
        go.call(["--base", "main"], pass_out)
        git.call("checkout", "-q", "main")
        File.write("m.txt", "m\n"); git.call("add", "-A"); git.call("commit", "-qm", "main moves")
        git.call("checkout", "-q", "feat")
        git.call("rebase", "-q", "main")
        blk.call(f1, head_sha, root)
      end
    end
  end

  fixture.call do |f1, f2, _root|
    r1 = receipt.call(f1)
    # M1 a judged receipt is schema 2 and carries every key.
    check.call("M1 judged receipt is schema 2", r1["schema"] == 2)
    check.call("M1 judged receipt has all five keys",
               CriticCarry::HEAD_KEYS.all? { |k| CriticCarry.key_ok?(r1[k]) })
    check.call("M1 judged receipt carried_from is null", r1.key?("carried_from") && r1["carried_from"].nil?)
    check.call("M1 merge_base is the seed", r1["merge_base"] == sha_of.call("main~1"))
    check.call("M0 the rebase made a new SHA", f1 != f2 && !f2.to_s.empty?)

    # M2 the identical rebased change: the carried PASS covers the branch's
    # diff, and ONLY an interaction review of the upstream delta runs.
    mb1 = r1["merge_base"]
    mb2 = sha_of.call("main")
    # A leftover report for F2 (DND-907) must not survive the receipt below.
    FileUtils.mkdir_p(verdict_dir)
    File.write(File.join(verdict_dir, "#{f2}.report.txt"), "stale fail-open body\n")
    rc, out, err = go.call(["--base", "main"], block_out)
    check.call("M2 hit + interaction PASS exits 0 although a full review would BLOCK (exit #{rc}; #{err.lines.first})", rc == 0)
    check.call("M2 stdout starts PASS (CARRIED + INTERACTION)", out.start_with?("critic-review: PASS (CARRIED + INTERACTION)"))
    check.call("M2 exactly one judge call, and it was the interaction review (#{kinds.call.inspect})", kinds.call == ["interaction"])
    ip = last_prompt.call
    check.call("M2 the interaction prompt names the upstream range", ip.include?("#{mb1}..#{mb2}"))
    check.call("M2 it carries the upstream delta (m.txt) and the branch diff as context (f.txt)",
               ip.include?("+++ b/m.txt") && ip.include?("+++ b/f.txt") && ip.index("+++ b/m.txt") < ip.index("+++ b/f.txt"))
    check.call("M2 the carry-hit line names the source and range", err.include?("CARRY HIT") && err.include?(f1[0, 12]))
    r2 = receipt.call(f2)
    check.call("M2 receipt: pass, carried from F1", r2["carried_from"] == f1 && r2["verdict"] == "pass" && r2["schema"] == 2)
    check.call("M2 receipt: upstream range and interaction verdict", r2["upstream_range"] == "#{mb1}..#{mb2}" && r2["interaction"] == "pass")
    check.call("M2 receipt records its own keys", r2["merge_base"] == mb2 && r2["patch_id"] == r1["patch_id"])
    check.call("M2 receipt names the matched receipt", r2["carried_receipt"] == File.join(own_store, "#{f1}.json"))
    check.call("M2 no .running marker left", !File.exist?(File.join(verdict_dir, "#{f2}.running")))
    # M21 an interaction PASS, like a full PASS, writes no report file.
    check.call("M21 an interaction PASS writes no report file, and retires a stale one", !File.exist?(File.join(verdict_dir, "#{f2}.report.txt")))
    # M20 an interaction review IS a judge round (a model looked); only a pure
    # carry is excluded.
    check.call("M20 rounds count the interaction review (#{rounds_recorded.inspect})", rounds_recorded&.first == 2)

    # M3 the reader returns 0 and names the root and the range in stable tokens.
    (code, rout), = capture_err { capture_out { verdict_for(f2) } }
    check.call("M3 verdict_for an interaction-passed head is 0", code == 0)
    check.call("M3 the PASS line carries both tokens",
               rout.include?("[critic-carried-from=#{f1}]") && rout.include?("[critic-upstream=#{mb1}..#{mb2}]"))
    (code, rout), = capture_err { capture_out { verdict_for(f1) } }
    check.call("M3 a judged PASS has no token", code == 0 && !rout.include?("critic-carried-from"))
    # M3b an upstream_range with no carried_from is malformed: an interaction
    # review only ever follows a carry, and integration-gate needs both.
    p1 = File.join(verdict_dir, "#{f1}.json")
    saved = File.read(p1)
    File.write(p1, JSON.generate(JSON.parse(saved).merge("upstream_range" => "#{mb1}..#{mb2}")))
    (code, _o), rerr = capture_err { capture_out { verdict_for(f1) } }
    File.write(p1, saved)
    check.call("M3b upstream_range without carried_from is refused (exit 3, Fix:)",
               code == 3 && rerr.include?("upstream_range") && rerr.include?("Fix:"))
    # M3c a PASS whose recorded interaction verdict is not a pass is malformed.
    p2 = File.join(verdict_dir, "#{f2}.json")
    saved = File.read(p2)
    File.write(p2, JSON.generate(JSON.parse(saved).merge("interaction" => "block")))
    (code, _o), rerr = capture_err { capture_out { verdict_for(f2) } }
    File.write(p2, saved)
    check.call("M3c verdict pass with interaction block is refused (exit 3, Fix:)",
               code == 3 && rerr.include?("interaction") && rerr.include?("Fix:"))

    # M4 a chain passes its ROOT through; with the judged receipt preferred as
    # the source, the range starts at ITS base (the widest delta).
    git.call("checkout", "-q", "main")
    File.write("m2.txt", "m\n"); git.call("add", "-A"); git.call("commit", "-qm", "main moves again")
    git.call("checkout", "-q", "feat"); git.call("rebase", "-q", "main")
    f3 = head_sha
    mb3 = sha_of.call("main")
    rc, = go.call(["--base", "main"], block_out)
    r3 = receipt.call(f3)
    check.call("M4 second hit exits 0", rc == 0)
    check.call("M4 carried_from is the root F1, not F2", r3["carried_from"] == f1)
    check.call("M4 with both usable, the judged receipt is named", r3["carried_receipt"] == File.join(own_store, "#{f1}.json"))
    check.call("M4 the range runs from the judged source's base", r3["upstream_range"] == "#{mb1}..#{mb3}")
    # M4b the chain: F1's receipt gone, F2's receipt is the source, the range
    # is F2's base .. new base, and the ROOT is still F1.
    FileUtils.rm_f(File.join(verdict_dir, "#{f3}.json"))
    FileUtils.mv(File.join(verdict_dir, "#{f1}.json"), File.join(stubs, "f1-receipt.json"))
    rc, = go.call(["--base", "main"], block_out)
    r3 = receipt.call(f3)
    check.call("M4b hit from a carried source exits 0", rc == 0)
    check.call("M4b carried_from stays the root F1", r3["carried_from"] == f1)
    check.call("M4b carried_receipt is F2's", r3["carried_receipt"] == File.join(own_store, "#{f2}.json"))
    check.call("M4b the range is F2's base .. new base", r3["upstream_range"] == "#{mb2}..#{mb3}")
    FileUtils.mv(File.join(stubs, "f1-receipt.json"), File.join(verdict_dir, "#{f1}.json"))

    # M11 a head with its own receipt is judged, never carried over.
    rc, _o, err = go.call(["--base", "main"], pass_out)
    check.call("M11 a carried head re-run is NOT ATTEMPTED (#{err.lines.first})",
               err.include?("CARRY NOT ATTEMPTED — HEAD already has a receipt (pass)"))
    File.write(File.join(verdict_dir, "#{f3}.json"), JSON.generate(r3.merge("verdict" => "block", "carried_from" => nil)))
    rc, _o, err = go.call(["--base", "main"], pass_out)
    check.call("M11 own BLOCK: not attempted, judged", err.include?("HEAD already has a receipt (block)") && rc == 0)
    check.call("M11 the receipt now reflects the judge", receipt.call(f3)["verdict"] == "pass" && receipt.call(f3)["carried_from"].nil?)

    # M12 a running marker is a receipt state too.
    git.call("commit", "-q", "--amend", "--no-edit", "--date=2001-01-01T00:00:00")
    f4 = head_sha
    File.write(File.join(verdict_dir, "#{f4}.running"), "x")
    _rc, _o, err = go.call(["--base", "main"], pass_out)
    check.call("M12 running marker: NOT ATTEMPTED (running)", err.include?("CARRY NOT ATTEMPTED — HEAD already has a receipt (running)"))
  end

  # M2b the interaction review BLOCKS: the head is BLOCK, its receipt is keyed,
  # and it vetoes the next carry of this patch.
  fixture.call do |_f1, f2, _root|
    rc, _o, err = go.call(["--base", "main"], pass_out, block_out)
    check.call("M2b interaction BLOCK: exit 2 (#{err.lines.first.to_s.strip})", rc == 2)
    check.call("M2b says the upstream delta breaks the branch", err.include?("BLOCKED (INTERACTION)"))
    check.call("M2b one judge call, the interaction review", kinds.call == ["interaction"])
    r2 = receipt.call(f2)
    check.call("M2b receipt: block, interaction block, keyed",
               r2["verdict"] == "block" && r2["interaction"] == "block" && CriticCarry.keyed_block?(r2))
    check.call("M2b a report body is recorded", File.file?(File.join(verdict_dir, "#{f2}.report.txt")))
    code, = capture_err { capture_out { verdict_for(f2) }[0] }
    check.call("M2b the reader says BLOCK", code == 2)
    git.call("checkout", "-q", "main")
    File.write("m3.txt", "m\n"); git.call("add", "-A"); git.call("commit", "-qm", "main moves on")
    git.call("checkout", "-q", "feat"); git.call("rebase", "-q", "main")
    rc, out, err = go.call(["--base", "main"], pass_out, pass_out)
    check.call("M2b the next rebase is REFUSED by that BLOCK and fully reviewed (#{err.lines.first.to_s.strip})",
               err.include?("CARRY REFUSED — receipt #{File.join(own_store, "#{f2}.json")}") &&
               kinds.call == ["full"] && rc == 0 && out.start_with?("critic-review: PASS —"))
  end

  # M2c the interaction review FAILS OPEN: no green verdict for the head.
  fixture.call do |_f1, f2, _root|
    rc, _o, err = go.call(["--base", "main"], pass_out, broken_out)
    check.call("M2c interaction fail-open: exit 0, loud", rc == 0 && err.include?("FAIL-OPEN"))
    code, = capture_err { capture_out { verdict_for(f2) }[0] }
    check.call("M2c the reader gives no green verdict", code == 3)
  end

  # M2d same base (an amend that keeps patch, message and base): nothing came
  # in upstream, so the carried PASS stands with NO model call.
  fixture.call do |f1, _f2, _root|
    git.call("reset", "-q", "--hard", f1)
    git.call("commit", "-q", "--amend", "--no-edit", "--date=2001-01-01T00:00:00")
    # A leftover report for this head (DND-907) must not survive the carried
    # receipt: this is the exclusive write's retire, which M21 does not reach.
    stale = File.join(verdict_dir, "#{head_sha}.report.txt")
    FileUtils.mkdir_p(verdict_dir)
    File.write(stale, "stale fail-open body\n")
    rc, out, _err = go.call(["--base", "main"], block_out, block_out)
    check.call("M2d same base: PASS (CARRIED), exit 0", rc == 0 && out.start_with?("critic-review: PASS (CARRIED) —"))
    check.call("M2d the carried PASS retires a stale report", !File.exist?(stale))
    check.call("M2d no judge call at all (#{kinds.call.inspect})", kinds.call.empty?)
    check.call("M2d receipt has no upstream range", receipt.call(head_sha)["upstream_range"].nil?)
  end

  # M2e a NON-forward rebase (the source's base is not an ancestor of the new
  # base) has no "upstream delta": fail closed to a full review.
  fixture.call do |f1, _f2, _root|
    go.call(["--base", "main", "--no-carry"], pass_out)   # F2 judged on the moved base
    FileUtils.rm_f(File.join(verdict_dir, "#{f1}.json"))
    git.call("rebase", "-q", "--onto", "main~1", "main")  # back onto the seed
    rc, _o, err = go.call(["--base", "main"], block_out)
    check.call("M2e non-forward: NOT ATTEMPTED, full review (#{err.lines.first.to_s.strip})",
               err.include?("CARRY NOT ATTEMPTED — the source's base") && kinds.call == ["full"] && rc == 2)
  end

  # M5 a changed patch (a conflict resolved by editing a line) is judged.
  fixture.call do |_f1, _f2, _root|
    File.write("f.txt", "a\nB\n"); git.call("commit", "-qa", "--amend", "--no-edit")
    rc, _o, err = go.call(["--base", "main"], block_out)
    check.call("M5 changed patch: judge ran (exit #{rc})", rc == 2)
    check.call("M5 CARRY MISS with 0 sharing the patch-id", err.include?("CARRY MISS") && err.include?("0 share the patch-id"))
    check.call("M5 miss names the key and counts", err.include?("receipt(s) in 1 of 1 candidate store(s) considered") && err.include?("Running the judge."))
  end

  # M6 a re-indented line: patch-id equal, bytes differ.
  fixture.call do |_f1, _f2, _root|
    File.write("f.txt", "a\n  b\n"); git.call("commit", "-qa", "--amend", "--no-edit")
    rc, _o, err = go.call(["--base", "main"], block_out)
    check.call("M6 re-indent: judge ran (exit #{rc})", rc == 2)
    check.call("M6 miss names diff_digest (#{err.lines.grep(/near miss|MISS/).join.strip})",
               err.include?("1 share the patch-id") && err.include?("diff_digest"))
  end

  # M7 a reworded message.
  fixture.call do |_f1, _f2, _root|
    git.call("commit", "-q", "--amend", "-m", "fix: x reworded")
    rc, _o, err = go.call(["--base", "main"], block_out)
    check.call("M7 reworded: judge ran, miss names msgs_digest", rc == 2 && err.include?("msgs_digest"))
  end

  # M8 a squash keeps the total diff but not the messages.
  fixture.call(two_commits: true) do |_f1, _f2, _root|
    git.call("reset", "-q", "--soft", "main")
    git.call("commit", "-qm", "part one\n\npart two")
    rc, _o, err = go.call(["--base", "main"], block_out)
    check.call("M8 squash: judge ran, miss names msgs_digest", rc == 2 && err.include?("msgs_digest"))
  end

  # M9 an edited agent definition.
  fixture.call do |_f1, _f2, _root|
    File.write(agent_def, "fixture critic v2\n")
    rc, _o, err = go.call(["--base", "main"], block_out)
    File.write(agent_def, "fixture critic v1\n")
    check.call("M9 agent edit: judge ran, miss names judge_digest", rc == 2 && err.include?("judge_digest"))
  end

  # M10 a BLOCK on the identical change in ANOTHER checkout vetoes. The BLOCK
  # is recorded by a REAL review run in that checkout, so its keys are the ones
  # that checkout actually computes -- a receipt copied from this checkout
  # would share this checkout's keys and prove nothing about the cross-checkout
  # case (the judge digest once hashed the checkout's own path, and a copied
  # fixture hid that the veto could never fire across checkouts).
  fixture.call do |f1, _f2, root|
    wt = File.join(root, "wt2")
    git.call("worktree", "add", "-q", "--detach", wt, f1)
    other = Dir.chdir(wt) do
      go.call(["--base", "main", "--no-carry"], block_out)
      File.realpath(verdict_dir)
    end
    check.call("M10 fixture: the other checkout recorded a BLOCK", File.file?(File.join(other, "#{f1}.json")))
    rc, out, err = go.call(["--base", "main"], pass_out)
    check.call("M10 CARRY REFUSED names the other checkout's BLOCK receipt (#{err.lines.first.to_s.strip})",
               err.include?("CARRY REFUSED — receipt #{File.join(other, "#{f1}.json")}"))
    check.call("M10 the judge ran (stub PASS, not carried)", rc == 0 && out.start_with?("critic-review: PASS —"))
  end

  # M10b a PASS recorded in ANOTHER checkout carries here (the keys agree
  # across checkouts of one repo).
  fixture.call do |f1, f2, root|
    wt = File.join(root, "wt2")
    git.call("worktree", "add", "-q", "--detach", wt, f1)
    other = Dir.chdir(wt) do
      go.call(["--base", "main", "--no-carry"], pass_out)
      File.realpath(verdict_dir)
    end
    FileUtils.rm_f(File.join(verdict_dir, "#{f1}.json"))
    rc, out, err = go.call(["--base", "main"], block_out)
    check.call("M10b a PASS from another checkout carries (exit #{rc}; #{err.lines.first.to_s.strip})",
               rc == 0 && out.start_with?("critic-review: PASS (CARRIED + INTERACTION)"))
    check.call("M10b names the other checkout's receipt",
               receipt.call(f2)["carried_receipt"] == File.join(other, "#{f1}.json"))
  end

  # M28 A SCHEMA-2 BLOCK WITH NULL KEYS still vetoes. A judged run records null
  # keys when a key could not be computed (here: the agent definition is
  # unreadable) although the judge saw the real diff and can BLOCK. Recorded by
  # a REAL run, then the definition is restored and the branch rebased.
  unless Process.uid.zero?
    fixture.call do |f1, _f2, root|
      wt = File.join(root, "wt2")
      git.call("worktree", "add", "-q", "--detach", wt, f1)
      File.chmod(0o000, agent_def)
      blk = begin
        Dir.chdir(wt) do
          go.call(["--base", "main", "--no-carry"], block_out)
          File.join(File.realpath(verdict_dir), "#{f1}.json")
        end
      ensure
        File.chmod(0o644, agent_def)
      end
      r = JSON.parse(File.read(blk))
      check.call("M28 fixture: a schema-2 BLOCK with null keys was recorded",
                 r["schema"] == 2 && r["verdict"] == "block" && r["patch_id"].nil?)
      rc, out, err = go.call(["--base", "main"], pass_out)
      check.call("M28 null-key BLOCK: CARRY REFUSED naming it (#{err.lines.first.to_s.strip})",
                 err.include?("CARRY REFUSED — receipt #{blk}"))
      check.call("M28 the judge ran", rc == 0 && out.start_with?("critic-review: PASS —"))
    end
  end

  # M29 an unkeyed BLOCK whose commit is gone cannot be recomputed: fail closed.
  fixture.call do |_f1, _f2, _root|
    gone = "a" * 40
    File.write(File.join(verdict_dir, "#{gone}.json"), JSON.generate(
      "schema" => 1, "tool" => "critic-review", "sha" => gone, "base" => "main", "verdict" => "block",
      "findings" => ["correctness"], "dirty" => false, "at" => "2026-09-20T00:00:00Z"
    ))
    rc, _o, err = go.call(["--base", "main"], block_out)
    check.call("M29 unrecomputable BLOCK: NOT ATTEMPTED naming it (#{err.lines.first.to_s.strip})",
               err.include?("CARRY NOT ATTEMPTED — BLOCK receipt #{File.join(own_store, "#{gone}.json")}") && rc == 2)
  end

  # M30 a LEGACY BLOCK on a commit that is already in the head's base (it
  # landed) is not this change. Its patch cannot be recovered -- with no
  # recorded merge-base, its merge-base with the base is itself, an empty diff
  # -- and it used to stop every carry in the repo for good. Measured live
  # 2026-09-28: 8 such receipts in ~/dev/custom's stores, so no carry could
  # ever fire there (7 of them clean). It is set aside, and the NOTE names it.
  # Only a CLEAN receipt: its judge saw committed content, which is upstream.
  fixture.call do |_f1, f2, _root|
    landed = sha_of.call("main~1")
    File.write(File.join(verdict_dir, "#{landed}.json"), JSON.generate(
      "schema" => 1, "tool" => "critic-review", "sha" => landed, "base" => "origin/main", "verdict" => "block",
      "findings" => ["convention"], "dirty" => false, "at" => "2026-09-21T04:12:05Z"
    ))
    rc, out, err = go.call(["--base", "main"], block_out)
    check.call("M30 a BLOCK already in the base does not stop the carry (exit #{rc}; #{err.lines.first.to_s.strip})",
               rc == 0 && out.start_with?("critic-review: PASS (CARRIED + INTERACTION)"))
    check.call("M30 the NOTE counts the landed BLOCK it set aside",
               err.include?("NOTE 1 BLOCK receipt(s) with no usable carry keys are on commits already in this head's base"))
    check.call("M30 the NOTE names the receipt it set aside",
               err.include?(File.join(own_store, "#{landed}.json")))
    check.call("M30 receipt carried", receipt.call(f2)["carried_from"].to_s.match?(CriticCarry::SHA40))
  end

  # M30b a DIRTY unkeyed BLOCK at a commit in the base is NOT set aside. Its
  # judge was shown uncommitted work (the fallback diff), which never landed
  # and might be this very change. Reviewer repro on 162d3285: uncommitted X
  # BLOCKed at the base tip, X then committed, passed and rebased -> PASS
  # (CARRIED + INTERACTION), a BLOCK turned into a PASS. Fail closed.
  fixture.call do |_f1, _f2, _root|
    tip = sha_of.call("main~1")
    File.write(File.join(verdict_dir, "#{tip}.json"), JSON.generate(
      "schema" => 1, "tool" => "critic-review", "sha" => tip, "base" => "origin/main", "verdict" => "block",
      "findings" => ["convention"], "dirty" => true, "at" => "2026-09-21T04:12:05Z"
    ))
    rc, _o, err = go.call(["--base", "main"], block_out)
    check.call("M30b a dirty BLOCK in the base: NOT ATTEMPTED naming it (exit #{rc}; #{err.lines.first.to_s.strip})",
               rc == 2 && err.include?("CARRY NOT ATTEMPTED — BLOCK receipt #{File.join(own_store, "#{tip}.json")}") &&
               !err.include?("set aside"))
  end

  # M10c a LEGACY (schema-1) BLOCK on the same patch still vetoes: receipts
  # written before schema 2 carry no keys, so the patch is recomputed from the
  # commit. Matching on patch-id alone can only add vetoes.
  fixture.call do |f1, _f2, root|
    wt = File.join(root, "wt2")
    git.call("worktree", "add", "-q", "--detach", wt, f1)
    other = Dir.chdir(wt) { File.join(File.realpath(File.dirname(verdict_dir)), "critic-verdicts") }
    FileUtils.mkdir_p(other)
    File.write(File.join(other, "#{f1}.json"), JSON.generate(
      "schema" => 1, "tool" => "critic-review", "sha" => f1, "base" => "main", "verdict" => "block",
      "findings" => ["correctness"], "dirty" => false, "at" => "2026-09-20T00:00:00Z"
    ))
    rc, out, err = go.call(["--base", "main"], pass_out)
    check.call("M10c legacy BLOCK: CARRY REFUSED (#{err.lines.first.to_s.strip})",
               err.include?("CARRY REFUSED — receipt #{File.join(other, "#{f1}.json")}"))
    check.call("M10c the judge ran", rc == 0 && out.start_with?("critic-review: PASS —"))
  end

  # M25/M26 MISS: a receipt that cannot be read might be a BLOCK on this very
  # change (a truncated file is what a concurrent non-atomic write looks like),
  # so it can never silently drop out of the veto.
  [["truncated", ->(p) { File.write(p, File.read(p)[0, 40]) }],
   (["chmod 000", ->(p) { File.chmod(0o000, p) }] unless Process.uid.zero?)].compact.each do |label, damage|
    fixture.call do |f1, _f2, root|
      wt = File.join(root, "wt2")
      git.call("worktree", "add", "-q", "--detach", wt, f1)
      blk = Dir.chdir(wt) do
        go.call(["--base", "main", "--no-carry"], block_out)
        File.join(File.realpath(verdict_dir), "#{f1}.json")
      end
      damage.call(blk)
      rc, _o, err = go.call(["--base", "main"], block_out)
      File.chmod(0o644, blk)
      check.call("M25 #{label} receipt: NOT ATTEMPTED naming it, judge ran (#{err.lines.first.to_s.strip})",
                 err.include?("CARRY NOT ATTEMPTED — receipt #{blk} is unreadable") && rc == 2)
    end
  end

  # M27 the carried write never overwrites a receipt that appeared meanwhile.
  fixture.call do |_f1, f2, _root|
    path = File.join(verdict_dir, "#{f2}.json")
    File.write(path, "{\"verdict\":\"block\"}")
    kept = File.join(verdict_dir, "#{f2}.report.txt")
    File.write(kept, "the block's body\n")
    wrote, = capture_err { write_verdict(f2, "main", "pass", [], false, exclusive: true) }
    check.call("M27 an exclusive write refuses an existing receipt", wrote == false && File.read(path) == "{\"verdict\":\"block\"}")
    check.call("M27 and keeps that receipt's report (DND-907)", File.read(kept) == "the block's body\n")
    check.call("M27 and leaves no temp file behind", Dir.glob(File.join(verdict_dir, ".*tmp*")).empty?)
  end

  # M13 dirty tree.
  fixture.call do |_f1, _f2, _root|
    File.write("untracked.txt", "x\n")
    rc, _o, err = go.call(["--base", "main"], block_out)
    check.call("M13 dirty: NOT ATTEMPTED — dirty tree; judge ran", err.include?("CARRY NOT ATTEMPTED — dirty tree") && rc == 2)
  end

  # M14 HEAD == base: nothing to key.
  fixture.call do |_f1, _f2, _root|
    rc, _o, err = go.call(["--base", "feat"], block_out)
    check.call("M14 empty three-dot diff: NOT ATTEMPTED (#{err.lines.first})",
               err.include?("CARRY NOT ATTEMPTED — three-dot diff empty or failed") && rc == 2)
  end

  # M15 --no-carry forces the judge.
  fixture.call do |_f1, _f2, _root|
    rc, _o, err = go.call(["--base", "main", "--no-carry"], block_out)
    check.call("M15 --no-carry: SKIPPED and judged", err.include?("CARRY SKIPPED (--no-carry); running the judge.") && rc == 2)
  end

  # M16 a schema-1 source is never used, and the reader still reads it.
  fixture.call do |f1, _f2, _root|
    legacy = receipt.call(f1).slice("tool", "sha", "base", "verdict", "findings", "dirty", "at").merge("schema" => 1)
    File.write(File.join(verdict_dir, "#{f1}.json"), JSON.generate(legacy))
    rc, _o, err = go.call(["--base", "main"], block_out)
    check.call("M16 schema 1: judge ran, miss names schema 1", rc == 2 && err.include?("schema 1"))
    code, = capture_err { capture_out { verdict_for(f1) }[0] }
    check.call("M16 the reader still passes a schema-1 PASS", code == 0)
  end

  # M17 MISS: a source whose recorded keys do not recompute.
  fixture.call do |f1, _f2, _root|
    File.write("f.txt", "a\nZ\n"); git.call("commit", "-qa", "--amend", "--no-edit")
    keys, = head_carry_keys("main", head_sha)
    File.write(File.join(verdict_dir, "#{f1}.json"), JSON.generate(receipt.call(f1).merge(keys.slice(*CriticCarry::MATCH_KEYS))))
    rc, _o, err = go.call(["--base", "main"], block_out)
    check.call("M17 tampered keys: judge ran, recompute mismatch", rc == 2 && err.include?("recompute mismatch"))
  end

  # M18 the source commit is gone from the object store.
  # F1 is held only by ORIG_HEAD and the reflogs of HEAD, feat and main (the
  # fixture's only refs), so those are expired BY NAME. Never `--all`: the agent
  # git wrapper refuses `reflog expire --all` (DND-775 rule D2) and this suite
  # must pass with it first on PATH (DND-1103).
  fixture.call do |f1, _f2, _root|
    git.call("update-ref", "-d", "ORIG_HEAD")
    git.call("reflog", "expire", "--expire=now", "HEAD", "refs/heads/feat", "refs/heads/main")
    git.call("gc", "-q", "--prune=now")
    check.call("M18 fixture: the source commit is gone before the run",
               !Open3.capture3("git", "cat-file", "-e", "#{f1}^{commit}")[2].success?)
    rc, _o, err = go.call(["--base", "main"], block_out)
    check.call("M18 pruned source: judge ran, source commit missing", rc == 2 && err.include?("source commit missing"))
  end

  # M19 MISS: an unlistable store is COULD NOT LOOK, never a miss.
  unless Process.uid.zero?
    fixture.call do |_f1, _f2, root|
      git.call("worktree", "add", "-q", "--detach", File.join(root, "wt3"), "HEAD")
      wts = File.join(git_common_dir[0], "worktrees")
      File.chmod(0o000, wts)
      begin
        rc, _o, err = go.call(["--base", "main"], block_out)
      ensure
        File.chmod(0o755, wts)
      end
      check.call("M19 unlistable store: NOT ATTEMPTED — verdict store could not be resolved (#{err.lines.first})",
                 err.include?("CARRY NOT ATTEMPTED — verdict store could not be resolved") && rc == 2)
      check.call("M19 never reads as a miss", !err.include?("CARRY MISS"))
    end
  end

  ENV.delete("CRITIC_REVIEW_STUB")

  # M22 / M23 argument handling for --no-carry.
  check.call("M22 --no-carry with --verdict-for is refused",
             capture_err { capture_out { main(["--no-carry", "--verdict-for", "a" * 40]) }[0] }[0] == 64)
  check.call("M22 --no-carry with --self-test is refused",
             capture_err { capture_out { main(["--self-test", "--no-carry"]) }[0] }[0] == 64)
  check.call("M22 --no-carry alone is well-formed", usage_error(["--no-carry", "--base", "main"]).nil?)
  rc, shown = capture_out { main(["--help"]) }
  check.call("M23 --help lists --no-carry", rc == 0 && shown.include?("--no-carry"))

  # M24 carry cannot contaminate critic-eval (DND-888): it never touches receipts.
  eval_src = File.read(File.join(__dir__, "critic-eval")) rescue nil
  check.call("M24 critic-eval is readable", !eval_src.nil?)
  %w[critic-verdicts verdict_dir write_verdict CriticCarry].each do |tok|
    check.call("M24 critic-eval does not reference #{tok}", eval_src.to_s.include?(tok) == false)
  end
  ok
ensure
  ENV["HOME"] = prev_home if prev_home
  %w[CRITIC_REVIEW_STUB CRITIC_REVIEW_STUB_INTERACTION CRITIC_REVIEW_PROMPT_LOG].each { |k| ENV.delete(k) }
  FileUtils.remove_entry(stubs) if stubs
  FileUtils.remove_entry(home) if home
end

# A SET stub never reaches the live model. The merge-boarding self-test's r8/r9
# hand critic-review a FIFO so the judge stays "running" until the test answers.
# A FIFO is not File.file?, so the stub was skipped and `claude -p` ran for real
# inside the blocking harness gate. When the model hit its session limit the
# judge failed open and the whole gate went red (DND-446 report, 2026-09-28
# 17:44Z). A fake `claude` first on PATH records any live call.
def run_stub_self_test
  ok = true
  check = ->(name, cond) { ok = st_check("stub #{name}", cond) && ok }
  prev = %w[PATH CRITIC_REVIEW_STUB CRITIC_REVIEW_STUB_INTERACTION].to_h { |k| [k, ENV[k]] }
  Dir.mktmpdir("critic-review-stub-") do |d|
    bin = File.join(d, "bin"); FileUtils.mkdir_p(bin)
    marker = File.join(d, "live-claude-ran")
    File.write(File.join(bin, "claude"), "#!/bin/sh\ntouch '#{marker}'\necho 'FINDINGS: none'\n")
    File.chmod(0o755, File.join(bin, "claude"))
    ENV["PATH"] = "#{bin}:#{prev['PATH']}"
    ENV.delete("CRITIC_REVIEW_STUB_INTERACTION")

    # S1: a FIFO stub is read, and answers the judge.
    fifo = File.join(d, "stub.fifo")
    system("mkfifo", fifo)
    writer = Thread.new { File.write(fifo, "looks good\nFINDINGS: none\n") }
    ENV["CRITIC_REVIEW_STUB"] = fifo
    out, good = judge_call("P", :full)
    writer.join(10)
    check.call("S1 a FIFO stub answers the judge", good && out.include?("FINDINGS: none"))
    check.call("S1 a FIFO stub never calls the live model", !File.exist?(marker))

    # S2: a set stub that cannot be read fails open; it never falls through to
    # the live model (a wrongly computed stub path must not look like "unset").
    FileUtils.rm_f(marker)
    ENV["CRITIC_REVIEW_STUB"] = File.join(d, "no-such-stub")
    out, good = capture_err { judge_call("P", :full) }[0]
    check.call("S2 a missing stub fails open", good == false)
    check.call("S2 a missing stub never calls the live model", !File.exist?(marker))
  end
  ok
ensure
  prev&.each { |k, v| v.nil? ? ENV.delete(k) : ENV[k] = v }
end

def run_self_test
  SELF_TEST_FAILED_CASES.clear
  ok = with_hermetic_git_config do
    # Every sub-suite runs, so one failing suite never hides another's failures.
    %w[stub carry_domain carry cross_checkout core receipt].map do |suite|
      st_suite(suite) { send("run_#{suite}_self_test") }
    end.all?
  end
  if ok && SELF_TEST_FAILED_CASES.empty?
    puts "critic-review: self-test OK"
    0
  else
    warn "critic-review: self-test FAILED — #{SELF_TEST_FAILED_CASES.size} failed case(s):"
    SELF_TEST_FAILED_CASES.each { |name| warn "  - #{name}" }
    warn "  Fix: keep the semantics exact — findings BLOCK (exit 2), none PASSES, any infra/no-trailer error FAILS OPEN (exit 0, loud) for the CAPTAIN, and records a receipt so --verdict-for tells the ADMIRAL apart: pass=0, block=2, and none/running/fail-open/stale-SHA/dirty/malformed=3. A state that cannot be verified is never a pass."
    1
  end
end

# The parser, prompt, decision, argument and end-to-end cases.
def run_core_self_test
  require "tmpdir"
  ok = true
  c = ->(name, cond) { ok = st_check("core #{name}", cond) && ok }
  c.call("(N1) every self-test assertion is named: no anonymous `ok &&=` chain",
         anonymous_assertion_lines(File.read(__FILE__)).empty?)
  c.call("(N2) a failing case prints its name and is listed", named_case_reports_itself?)
  Dir.mktmpdir("critic-review-selftest-") do |d|
    findings_out = File.join(d, "f"); File.write(findings_out, "- [access-control] x.ex:1 — no authz\nFINDINGS: access-control\n")
    clean_out    = File.join(d, "c"); File.write(clean_out, "looks good\nFINDINGS: none\n")
    broken_out   = File.join(d, "b"); File.write(broken_out, "the model crashed, no trailer here\n")

    # parser
    c.call("(P1) the parser reads a findings trailer", parse_findings(File.read(findings_out)) == [["access-control"], true])
    c.call("(P2) the parser reads FINDINGS: none", parse_findings(File.read(clean_out)) == [[], true])
    c.call("(P3) the parser reports a missing trailer", parse_findings(File.read(broken_out)) == [nil, false])

    # PROMPT BUILDER -- ONE COPY, asserted rather than assumed.
    #
    # critic-eval's recall/precision numbers are the stated reason this critic
    # is trusted as a BLOCKING step, and they only describe the shipping judge
    # while both bins send it the same prompt. Built separately the two were
    # byte-identical and free to drift silently: an edit to the shipping prompt
    # that missed the eval would leave the eval scoring a prompt nobody runs,
    # still printing a number and still reading as PASS.
    #
    # So this asserts the SHAPE and then the SINGLE COPY -- that neither bin
    # carries its own inlined instruction string. A comment saying "keep these
    # in sync" is exactly the guard that cannot fire.
    built = CriticPrompt.build(diff: "DIFFBODY")
    c.call("(B1) the prompt starts with the instruction", built.start_with?(CriticPrompt::INSTRUCTION))
    c.call("(B2) the prompt fences the diff", built.include?("```diff\nDIFFBODY\n```"))
    c.call("(B3) the varying part comes LAST (cache prefix)",
           built.rindex("DIFFBODY") > built.rindex(CriticPrompt::INSTRUCTION))

    # BUG-FIX REGRESSION EVIDENCE (DND-400). The rule lives in ai/CLAUDE.md ->
    # "TDD Workflow"; the enforceable half rides in the prompt, because the
    # judge can only rule on a fix claim it can SEE, and the claim lives in the
    # commit messages. So assert all three parts, each as a separate outcome:
    #   - the addendum sits in the STABLE prefix, ahead of every varying part;
    #   - supplied commit messages land between the addendum and the diff;
    #   - a MISSING input (nil) and an EMPTY one ("") print different markers --
    #     "no commits" must never read the same as "nobody passed the commits".
    with_msgs = CriticPrompt.build(diff: "DIFFBODY", commit_messages: "fix: MSGBODY")
    c.call("(B4) the bug-fix rule is in the prompt", with_msgs.include?(CriticPrompt::BUG_FIX_RULE))
    c.call("(B5) the bug-fix rule precedes the commit messages",
           with_msgs.index(CriticPrompt::BUG_FIX_RULE) < with_msgs.index("MSGBODY"))
    c.call("(B6) the commit messages precede the diff", with_msgs.index("MSGBODY") < with_msgs.index("DIFFBODY"))
    c.call("(B7) the bug-fix rule is in a prompt with no commits passed", built.include?(CriticPrompt::BUG_FIX_RULE))
    c.call("(B8) a nil commit log reads NOT SUPPLIED", built.include?(CriticPrompt::COMMITS_NOT_SUPPLIED))
    none = CriticPrompt.build(diff: "DIFFBODY", commit_messages: "")
    c.call("(B9) an empty commit log reads NONE", none.include?(CriticPrompt::COMMITS_NONE))
    c.call("(B9) an empty commit log never reads NOT SUPPLIED", !none.include?(CriticPrompt::COMMITS_NOT_SUPPLIED))
    c.call("(B10) supplied commits print neither marker",
           !with_msgs.include?(CriticPrompt::COMMITS_NOT_SUPPLIED) && !with_msgs.include?(CriticPrompt::COMMITS_NONE))
    # The addendum names its own normative home, so a reader of a finding can
    # find the rule it enforces (cite by section name, never restate a second copy).
    c.call("(B11) the bug-fix rule cites TDD Workflow", CriticPrompt::BUG_FIX_RULE.include?("TDD Workflow"))
    c.call("(B12) commit-msg is a supported token", CriticPrompt::SUPPORTED_TOKENS.include?("commit-msg"))
    # Pasted test output often carries its own ``` fence. The commits block must
    # use a LONGER fence, or that paste closes the block early and the judge
    # reads the rest of the evidence as loose prompt text.
    fenced = CriticPrompt.build(diff: "D", commit_messages: "fix: x\n```\nFAILOUT\n```\nafter")
    c.call("(B13) the commits block uses a longer fence than a pasted one",
           fenced.include?("````text\nfix: x\n```\nFAILOUT\n```\nafter\n````"))

    %w[critic-review critic-eval].each do |bin|
      path = File.join(__dir__, bin)
      # A missing source is an ERROR, never a quietly-skipped case: a check that
      # cannot find what it checks must not report the same thing as a clean one.
      unless File.file?(path)
        warn "critic-review --self-test: cannot read #{path} to verify the single-copy prompt property."
        warn "  Fix: run --self-test from a checkout that contains ai/bin/#{bin}; do not treat this as a pass."
        c.call("(B14) #{bin} is readable for the single-copy check", false)
        next
      end
      src = File.read(path)
      c.call("(B14) #{bin} uses the shared CriticPrompt.build", src.include?("CriticPrompt.build"))
      c.call("(B15) #{bin} does not inline its own instruction", !src.include?("\"#{CriticPrompt::INSTRUCTION}"))
    end

    # THE SHIPPING CALLER PASSES EVERY SUPPORTED INPUT.
    #
    # One copy of the builder is not enough on its own. A new input could be
    # added to CriticPrompt and wired ONLY into critic-eval -- the eval would
    # then feed the judge a prompt shape no shipping caller ever produces,
    # still print recall/precision, and still read as PASS, while describing a
    # judge nobody runs. That is the same divergence the single-copy property
    # exists to prevent, arriving through the parameter list instead of through
    # a second inlined string.
    #
    # STATED LIMIT: this proves the KEYWORD appears at the shipping call site,
    # not that a non-empty value flows through it. It catches forgotten wiring,
    # which is the measured failure mode; it does not catch an input wired to
    # something empty.
    ship = File.read(File.join(__dir__, "critic-review")) rescue nil
    body = ship && ship[/^def critic_output\b.*?(?=^def |\z)/m]
    start = body && body.index("CriticPrompt.build(")
    if start.nil?
      warn "critic-review --self-test: could not locate the CriticPrompt.build call inside critic_output."
      warn "  Fix: keep the shipping prompt built by CriticPrompt.build inside critic_output; do not treat"
      warn "  an unreadable or restructured call site as a pass — a check that cannot find what it checks"
      warn "  must not report the same thing as a clean one."
      c.call("(B16) the CriticPrompt.build call is found inside critic_output", false)
    else
      # Balanced-paren scan rather than a line/`[^)]*` match, so a future
      # multi-line or nested-call argument list cannot truncate the text and
      # report a missing keyword that is actually present.
      depth = 0
      call = nil
      body[start..].each_char.with_index do |c, i|
        depth += 1 if c == "("
        if c == ")"
          depth -= 1
          (call = body[start, i + 1]) && break if depth.zero?
        end
      end
      CriticPrompt::SUPPORTED_INPUTS.each do |key|
        next if call && call.include?("#{key}:")
        warn "critic-review --self-test: the shipping prompt call omits `#{key}:`, which is in CriticPrompt::SUPPORTED_INPUTS."
        warn "  Fix: pass #{key}: in critic_output's CriticPrompt.build call, or drop it from CriticPrompt::INPUTS."
        warn "  An input only critic-eval passes leaves the eval scoring a prompt the shipping judge never sees."
        c.call("(B17) the shipping prompt call passes #{key}:", false)
      end
    end

    # decision matrix
    c.call("(D1) findings BLOCK with exit 2", decide(["access-control"], true, true) == ["block", 2])
    c.call("(D2) no findings PASS with exit 0", decide([], true, true) == ["pass", 0])
    c.call("(D3) no trailer fails open with exit 0", decide([], false, true) == ["fail-open", 0])
    c.call("(D4) a failed invocation fails open with exit 0", decide([], true, false) == ["fail-open", 0])

    # ARGUMENT HANDLING -- the model-free dispatch paths.
    #
    # These assert the CHEAP outcome, which is the whole point: every case here
    # must return WITHOUT invoking `claude`. CRITIC_REVIEW_STUB is deliberately
    # unset for them, so if any case ever fell through to run() again it would
    # try to spawn the model (and, in this live repo, write a verdict receipt)
    # rather than quietly passing.
    c.call("(A1) a bare call is accepted (review HEAD)", usage_error([]).nil?)
    c.call("(A2) --base main is accepted", usage_error(["--base", "main"]).nil?)
    c.call("(A3) --verdict-for SHA is accepted", usage_error(["--verdict-for", "deadbeef"]).nil?)
    c.call("(A4) --self-test is accepted", usage_error(["--self-test"]).nil?)
    c.call("(A5) --help is accepted", !usage_error(["--help"]))
    c.call("(A6) a typo'd flag is refused", !usage_error(["--bogus"]).nil?)
    c.call("(A7) a bare SHA is not --verdict-for", !usage_error(["abc123"]).nil?)
    c.call("(A8) --verdict-for with no value is refused", !usage_error(["--verdict-for"]).nil?)
    c.call("(A9) --base with no value is refused", !usage_error(["--base"]).nil?)
    c.call("(A10) --base whose value is a flag is refused", !usage_error(["--base", "--verdict-for"]).nil?)

    # --help prints usage, exits 0, invokes nothing.
    rc, shown = capture_out { main(["--help"]) }
    c.call("(H1) --help exits 0", rc == 0)
    c.call("(H2) --help names --verdict-for", shown.include?("--verdict-for"))
    c.call("(H3) --help names --self-test", shown.include?("--self-test"))

    # An unrecognised argument is REFUSED (64), not silently reviewed. 64 is
    # neither 0 (pass) nor 2 (block) nor 3 (no green verdict), so a usage error
    # can never be mistaken for a verdict by integration-gate.
    rc, shown = capture_err { capture_out { main(["--bogus"]) }[0] }
    c.call("(U1) an unknown flag exits 64", rc == 64)
    c.call("(U2) an unknown flag carries a Fix:", shown.include?("Fix:"))
    c.call("(U3) an unknown flag is named", shown.include?("--bogus"))
    c.call("(U4) --verdict-for with no value exits 64",
           capture_err { capture_out { main(["--verdict-for"]) }[0] }[0] == 64)

    # end-to-end via stub. These run inside a THROWAWAY git repo: run() now
    # writes a verdict receipt into $GIT_DIR, and doing that in the live repo
    # would both pollute it and record a stub verdict against a real head.
    Dir.mktmpdir("critic-review-e2e-") do |repo|
      Dir.chdir(repo) do
        sh = ->(*a) { system(*a, out: File::NULL, err: File::NULL) }
        sh.call("git", "init", "-q", ".")
        sh.call("git", "config", "user.email", "t@example.invalid")
        sh.call("git", "config", "user.name", "t")
        File.write("a.txt", "one\n")
        sh.call("git", "add", "-A")
        sh.call("git", "-c", "commit.gpgsign=false", "commit", "-qm", "one")

        ENV["CRITIC_REVIEW_STUB"] = findings_out
        c.call("(E1) a findings stub BLOCKS with exit 2", capture_err { run(["--base", "main"]) }[0] == 2)
        ENV["CRITIC_REVIEW_STUB"] = clean_out
        c.call("(E2) a clean stub PASSES with exit 0", capture_err { run(["--base", "main"]) }[0] == 0)
        ENV["CRITIC_REVIEW_STUB"] = broken_out
        c.call("(E3) a no-trailer stub fails open with exit 0, not a block",
               capture_err { run(["--base", "main"]) }[0] == 0)

        # THE BODY REACHES THE CALLER even when it is not a "- [cat]" bullet
        # list. A blocked run that shows no findings is unactionable, and the
        # previous grep produced exactly that for any other format.
        odd_out = File.join(d, "o")
        File.write(odd_out, "**MUST-FIX**\n1. foo.sh:12 drops the status\nFINDINGS: correctness\n")
        ENV["CRITIC_REVIEW_STUB"] = odd_out
        rc, shown = capture_err { run(["--base", "main"]) }
        c.call("(E4) a non-bullet findings body BLOCKS with exit 2", rc == 2)
        c.call("(E5) a non-bullet findings body reaches the caller", shown.include?("foo.sh:12 drops the status"))
        c.call("(E6) the trailer is not echoed", !shown.include?("FINDINGS: correctness"))
        ENV.delete("CRITIC_REVIEW_STUB")

        # COMMIT LOG -- the judge's commit-msg input, three outcomes kept apart:
        # commits present, none (""), and an unreadable log (nil, said on stderr).
        first = `git rev-parse HEAD`.strip
        File.write("a.txt", "two\n")
        sh.call("git", "-c", "commit.gpgsign=false", "commit", "-qam", "fix: two")
        c.call("(L1) the commit log carries the commits", commit_log(first).to_s.include?("fix: two"))
        c.call("(L2) no commits is an empty log", commit_log("HEAD") == "")
        rc_nil, said = capture_err { commit_log("no-such-ref-dnd400").inspect }
        c.call("(L3) an unreadable log is nil, named, with a Fix:",
               rc_nil == "nil" && said.include?("Fix:") && said.include?("no-such-ref-dnd400"))

        # DIFF HERMETICITY (DND-773b) -- the patch fed to the judge must not
        # vary with the caller's OWN git config: diff.external can swap in a
        # different tool entirely, color.diff=always forces ANSI escapes into
        # the patch with no terminal attached (unlike the default `auto`), and
        # diff.noprefix drops the a//b/ prefixes. None of these raise -- the
        # diff still "succeeds", just as a different diff.
        sh.call("git", "config", "color.diff", "always")
        sh.call("git", "config", "diff.noprefix", "true")
        ext = File.join(repo, "fake-ext-diff.sh")
        File.write(ext, "#!/bin/sh\necho EXTERNAL-DIFF-RAN\n")
        File.chmod(0o755, ext)
        sh.call("git", "config", "diff.external", ext)
        out = diff_for(first)
        c.call("(X1) diff.external is not invoked", !out.include?("EXTERNAL-DIFF-RAN"))
        c.call("(X2) color.diff=always adds no ANSI codes", !out.include?("\e["))
        c.call("(X3) the a/ b/ prefixes survive diff.noprefix",
               out.include?("--- a/a.txt") && out.include?("+++ b/a.txt"))
        sh.call("git", "config", "--unset", "diff.external")
        sh.call("git", "config", "--unset", "diff.noprefix")
        sh.call("git", "config", "--unset", "color.diff")
      end
    end
  end
  ok
end

# (N1) The lines of SRC that assert anonymously: `ok &&= <cond>` chains, the
# form that printed nothing when it failed and skipped every case after it.
def anonymous_assertion_lines(src)
  src.lines.each_with_index.select { |l, _| l.match?(/^\s*ok\s*&&=/) }.map { |_, i| i + 1 }
end

# (N2) A false case prints its name and joins the end-of-run list; a true one
# does neither. Probed on a scratch copy of the list, so the probe's own
# deliberate failure never reaches the real one.
def named_case_reports_itself?
  saved = SELF_TEST_FAILED_CASES.dup
  SELF_TEST_FAILED_CASES.clear
  r_false, said = capture_err { st_check("probe-dnd1435", false) }
  r_true, quiet = capture_err { st_check("probe-ok-dnd1435", true) }
  listed = SELF_TEST_FAILED_CASES.dup
  r_false == false && said.include?("FAILED case: probe-dnd1435") &&
    r_true == true && quiet.empty? && listed == ["probe-dnd1435"]
ensure
  SELF_TEST_FAILED_CASES.replace(saved) if saved
end

# Dispatch is a FUNCTION returning an exit code, not a bare `if` at the bottom,
# so --help and the argument-refusal path are reachable from the self-test. A
# guard nothing can test is a guard nothing keeps.
def main(argv)
  if (err = usage_error(argv))
    warn "critic-review: #{err}"
    warn USAGE
    warn "  Fix: re-run using one of the forms above. An unrecognised argument is refused, not ignored: ignoring it would fall through to a full model-in-loop review of HEAD (slow, and it records a verdict receipt) when you asked for something else."
    return 64
  end

  # --help is checked BEFORE --self-test and --verdict-for so it is always the
  # cheap, model-free answer, whatever else is on the line.
  if argv.include?("--help") || argv.include?("-h")
    puts USAGE
    return 0
  end

  return run_self_test if argv.include?("--self-test")

  if (idx = argv.index("--verdict-for"))
    cov = (c = argv.index("--covering")) ? argv[c + 1].to_s : nil
    return verdict_for(argv[idx + 1].to_s, cov)
  end

  run(argv)
end

exit main(ARGV)
