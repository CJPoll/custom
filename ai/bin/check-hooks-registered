#!/usr/bin/env ruby
# frozen_string_literal: true

# check-hooks-registered — assert the harness hooks are actually wired into the
# live Claude Code settings, not just present on disk.
#
# The motivating outage (2026-09-17): a telemetry change rewrote the "hooks"
# block of ~/.claude/settings.json and dropped the existing entries, silently
# disabling safe-wait-guard and pronoun-guard. Nothing detected it — a guard
# file can exist, pass its own --self-test, and still never run because it is
# registered nowhere. This check closes that blind spot: it compares the
# committed source of truth (ai/hooks/registry.json) against the live settings
# and fails, naming each drift, if a registered hook is missing.
#
# Environment-safe by design: if the target settings file does not exist (a
# fresh machine, a CI/agent env with a different HOME, a container), there is
# nothing to assert, so it PASSES with a note rather than false-failing every
# harness commit. It only fails when a settings file exists AND a registry hook
# is absent from it.
#
# THE BAR IS THE REGISTRY THAT LANDED, NOT THE BRANCH'S (DND-743, folding in
# DND-478). The hooks the live settings MUST wire are the ones in
# ai/hooks/registry.json as it landed on origin's main (ai/lib/landed.rb: the
# union over origin/main's tip and merge-base(HEAD, origin/main), the strictest).
# It used to be the branch's own copy, which broke both ways:
#   - a branch that ADDED a hook failed until the live settings wired it. The
#     only way to green was `setup-hooks --install` from the worktree, which
#     wires the MAIN checkout's path, where the script does not exist until the
#     branch lands: exit 127 on every tool call (DND-670). Machine config became
#     a precondition of reviewing code;
#   - a branch that REMOVED or re-evented a landed hook lowered its own bar, so
#     real drift on main passed. See ~/dev/custom/CLAUDE.md -> "A check's own
#     bar must not live in the diff it is checking".
# So the check now reports, in order:
#   1. BRANCH CONSISTENCY: every entry in this checkout's registry names a script
#      that exists here and is executable (fails, exit 1). Needs no settings.
#   2. DANGLING: a wired command under a checkout's ai/hooks/ whose script is
#      missing or not executable, the exit-127 state (fails, exit 1).
#   3. DRIFT: a LANDED (event, script) pair the live settings do not wire
#      (fails, exit 1) -- exactly the pre-DND-743 failure, keyed on what landed.
#   4. PENDING: a pair only this branch adds, not wired yet. Named, never a
#      failure: it is wired after it lands, from the main checkout.
# A bar that cannot be read (origin unreachable, local origin/main disagreeing
# with origin, a malformed registry or settings file) is COULD NOT MEASURE,
# exit 3, never a pass. An offline machine with a settings file is exit 3. When
# the landed bar cannot be read but a failure is visible without it (dangling,
# or an inconsistent branch registry), the exit is 1: that failure stands
# whatever landed, and the missing measurement is printed beside it.
#
# Deliberately gem-free (stdlib only); run with bare `ruby`.
#
# Usage:
#   ai/bin/check-hooks-registered            assert registry hooks are live
#   ai/bin/check-hooks-registered --self-test  verify the checker's own logic
#
# Override the target settings file with HOOKS_SETTINGS_FILE (used by the
# self-test and by scripts/setup-hooks --check; defaults to ~/.claude/settings.json).
#
# Exit codes: 0 ok / not-this-env · 1 drift, dangling, or an inconsistent
# branch registry · 3 could not measure (the landed bar, the branch registry, or
# the settings file could not be read)

require "json"
require "shellwords"
require_relative "../lib/landed"

AI_DIR       = File.expand_path("..", __dir__)          # .../ai
REPO_DIR     = File.expand_path("..", AI_DIR)           # repo root (may be a worktree)
REGISTRY_REL = "ai/hooks/registry.json"
# HOOKS_REGISTRY_FILE is a TEST SEAM, matching setup-hooks': the two tools must
# be checkable against the same synthetic registry, or "they agree" is asserted
# only where both happen to read the real one. It replaces only the BRANCH
# registry (consistency and pending). The required set is always read from
# origin, so no environment variable can lower the bar.
REGISTRY     = ENV.fetch("HOOKS_REGISTRY_FILE") { File.join(REPO_DIR, REGISTRY_REL) }
EXIT_OK         = 0
EXIT_FAIL       = 1
EXIT_UNMEASURED = 3

# A registry (or settings) document that cannot be read or has the wrong shape.
class RegistryError < StandardError; end

# The MAIN checkout for this repo. Hooks are always wired at the main checkout's
# path, because a worktree path vanishes when the worktree is cleaned up. But
# captains run the gate FROM a worktree, where REPO_DIR is that worktree — so
# comparing only REPO_DIR-based paths reported all 5 hooks as drifted in every
# worktree (observed 2026-09-18, DND-182). That false failure is worse than
# cosmetic: the documented recovery is `setup-hooks --install`, which would then
# rewire the live settings to a path that disappears — the 2026-09-17 outage
# class. Resolve the main checkout through git's common dir (a worktree's
# --git-common-dir IS the main checkout's .git) and accept either spelling.
def main_checkout_dir(dir = REPO_DIR)
  common = `git -C #{dir.shellescape} rev-parse --git-common-dir 2>/dev/null`.strip
  return dir if common.empty?

  common = File.expand_path(common, dir) unless common.start_with?("/")
  parent = File.dirname(common)
  File.directory?(parent) ? parent : dir
rescue StandardError
  dir
end

# Every checkout whose hook paths count as "this repo's hooks", most-canonical
# first. In the main checkout this is a single entry.
def checkout_dirs
  [main_checkout_dir, REPO_DIR].uniq
end

def settings_path
  ENV["HOOKS_SETTINGS_FILE"] || File.join(Dir.home, ".claude", "settings.json")
end

# Expand a registry (repo-relative) script path to the absolute command string
# settings.json stores, for the canonical (main) checkout.
def abs_script(rel, dir = main_checkout_dir)
  File.join(dir, rel)
end

# Resolve a command's path through symlinks so two spellings of the same script
# compare equal. On this machine ~/.claude/hooks is a symlink to the repo's
# ai/hooks/, so a live entry spelled `~/.claude/hooks/foo.sh` is the SAME file as
# the registry's `<repo>/ai/hooks/foo.sh` — comparing raw strings falsely reports
# drift (and makes setup-hooks append a duplicate).
#
# The DIRECTORY is resolved even when the file does not exist, and it must stay
# in step with setup-hooks' own `norm` — these two answer the same question and
# a divergence between them is drift reported by one tool and not the other.
# Falling back to the literal string made the comparison depend on whether the
# script is on disk right now, which is irrelevant to "are these two spellings
# the same location": a wired hook whose file is temporarily absent read as
# drift, and a hook being added on a branch read as drift against the main
# checkout it is not in yet. Resolving `dirname` needs no file. A command that
# is not a bare path has no directory component and is returned unchanged.
def norm(cmd)
  return cmd if cmd.nil? || cmd.empty?
  return File.realpath(cmd) if File.exist?(cmd)

  dir = File.dirname(cmd)
  # A missing directory, or a command that is not a path at all, is left alone:
  # realpath would resolve it against the CWD and invent an absolute path for a
  # command that names no location this process can see. setup-hooks' `norm`
  # makes the same choice; the two must agree, or drift is reported by one tool
  # and not the other.
  return cmd if dir == "." || !File.directory?(dir)

  File.join(File.realpath(dir), File.basename(cmd))
rescue StandardError
  cmd
end

# The entries of a registry document. Raises RegistryError, naming where, when
# the text is not JSON or an entry is not {event, matcher, script} strings: a
# malformed registry is a measurement that failed, never an empty one.
def parse_registry(text, where)
  data = JSON.parse(text)
  hooks = data.is_a?(Hash) ? data["hooks"] : nil
  raise RegistryError, "#{where}: no \"hooks\" array" unless hooks.is_a?(Array)

  hooks.each_with_index do |e, i|
    good = e.is_a?(Hash) && %w[event script].all? { |k| e[k].is_a?(String) && !e[k].empty? } &&
           e.fetch("matcher", "").is_a?(String)
    raise RegistryError, "#{where}: entry #{i} is not {event, matcher, script} strings: #{e.inspect}" unless good
  end
  hooks
rescue JSON::ParserError => e
  raise RegistryError, "#{where}: not valid JSON (#{e.message.lines.first.to_s.strip})"
end

# This checkout's registry (the branch's copy). Raises RegistryError.
def load_registry(file = REGISTRY)
  parse_registry(File.read(file), file)
rescue SystemCallError => e
  raise RegistryError, "#{file}: cannot be read (#{e.message})"
end

# The registry entries that LANDED: the union over every landed point (the
# strictest bar). Returns [points, entries]. Raises Landed::Unreadable (a
# malformed landed registry included) or Landed::Mismatch. Empty entries when
# no landed point has the file (the registry is being introduced by this diff).
def landed_registry(root = REPO_DIR)
  pts, bars = Landed.read_bar(root, REGISTRY_REL) do |text, label, sha|
    parse_registry(text, "#{REGISTRY_REL} @ #{label} #{sha[0, 12]}")
  rescue RegistryError => e
    raise Landed::Unreadable.new([[label, e.message]])
  end
  [pts, bars.flatten(1).uniq { |e| row_key(e) }]
end

def pair_key(entry)
  [entry["event"], entry["script"]]
end

# A registry row's identity (DND-887): (event, normalized matcher, script).
def row_key(entry)
  [entry["event"], mnorm(entry["matcher"]), entry["script"]]
end

# Entries of this checkout's registry whose script is missing or not
# executable in this checkout. Returns human-readable strings.
def inconsistent(registry, root = REPO_DIR)
  registry.filter_map do |e|
    path = File.join(root, e["script"])
    if !File.file?(path)
      "#{e['event']} -> #{e['script']}: no such file in #{root}"
    elsif !File.executable?(path)
      "#{e['event']} -> #{e['script']}: not executable"
    end
  end
end

# Wired commands that point into a checkout's ai/hooks/ at a script that is
# missing or not executable: the hook fails (exit 127/126) on every event it
# matches. The first shell word of the command is the path. Returns strings.
def dangling(settings, dirs = checkout_dirs)
  hook_dirs = dirs.map { |d| norm(File.join(d, "ai", "hooks")) }
  commands = []
  (settings["hooks"] || {}).each do |event, matchers|
    Array(matchers).each { |m| Array(m["hooks"]).each { |h| commands << [event, h["command"].to_s] } }
  end
  commands.uniq.filter_map do |event, cmd|
    word = begin
      Shellwords.split(cmd).first.to_s
    rescue ArgumentError
      cmd
    end
    path = norm(word)
    next unless hook_dirs.any? { |h| path.start_with?("#{h}/") }
    next if File.file?(path) && File.executable?(path)

    "#{event} -> #{cmd}: #{File.exist?(path) ? 'not executable' : 'does not exist'}"
  end
end

# A wiring is identified by (event, matcher, command) -- DND-887. Keyed on
# (event, command) alone, a second registry row for the same script on the same
# event with a different matcher collapsed into the first: setup-hooks never
# installed it and this check reported it wired. Claude Code treats an omitted
# matcher, "" and "*" alike (match everything), so they compare equal.
# setup-hooks' `mnorm` makes the same choice; the two must agree.
def mnorm(matcher)
  matcher.nil? || matcher == "" || matcher == "*" ? "" : matcher
end

# All [event, matcher, command] wirings in a parsed settings hash, each with the
# matcher as written (for naming it) alongside its normalized form.
def registered_wirings(settings)
  out = []
  (settings["hooks"] || {}).each do |event, groups|
    Array(groups).each do |m|
      Array(m["hooks"]).each do |h|
        out << { event: event, matcher: m["matcher"], key: [event, mnorm(m["matcher"]), norm(h["command"])] }
      end
    end
  end
  out
end

def describe(event, matcher, script)
  "#{event} #{(matcher || '').inspect} -> #{script}"
end

# Registry rows with no wiring on their (event, matcher, script). Returns a
# list of human-readable drift strings (empty == all registered).
def drift_for(settings, registry, dirs = checkout_dirs)
  have = registered_wirings(settings).map { |w| w[:key] }
  registry.reject do |e|
    dirs.any? { |d| have.include?([e["event"], mnorm(e["matcher"]), norm(abs_script(e["script"], d))]) }
  end.map { |e| describe(e["event"], e["matcher"], e["script"]) }
end

# Wirings of a registry script, on an event the registry wires it on, under a
# matcher the registry does not declare for that pair: a row whose matcher
# changed, or two rows that were once one combined matcher. The declared rows
# may all be present too, so drift_for alone reports these as healthy.
def stale_for(settings, registry, dirs = checkout_dirs)
  declared = Hash.new { |h, k| h[k] = [] }
  registry.each { |e| declared[[e["event"], e["script"]]] << mnorm(e["matcher"]) }
  registered_wirings(settings).filter_map do |w|
    event, matcher, cmd = w[:key]
    script = declared.keys.find do |ev, s|
      ev == event && dirs.any? { |d| norm(abs_script(s, d)) == cmd }
    end&.last
    next unless script
    next if declared[[event, script]].include?(matcher)

    "#{describe(event, w[:matcher], script)} (stale: that matcher is not declared for this script)"
  end
end

def unmeasured(lines)
  warn "check-hooks-registered: COULD NOT MEASURE — this is not a pass."
  lines.each { |l| warn l }
  EXIT_UNMEASURED
end

# Printed with every unreadable landed bar, so nobody reads exit 3 on an
# offline machine as a new defect.
OFFLINE_NOTE = "  Note: the bar is what landed on origin, so an offline machine with a settings " \
               "file exits 3 (could not measure). Only a machine with no settings file passes " \
               "without origin."

# The settings hash at path. Raises RegistryError when it is not a JSON object.
def load_settings(path)
  data = JSON.parse(File.read(path))
  raise RegistryError, "#{path}: not a JSON object" unless data.is_a?(Hash)
  raise RegistryError, "#{path}: \"hooks\" is not an object" unless data.fetch("hooks", {}).is_a?(Hash)

  data
rescue JSON::ParserError => e
  raise RegistryError, "#{path}: not valid JSON (#{e.message.lines.first.to_s.strip})"
rescue SystemCallError => e
  raise RegistryError, "#{path}: cannot be read (#{e.message})"
end

# The landed bar as [description, entries], or [nil, lines] when it could not
# be measured (lines explain why).
def measure_landed(landed, root)
  pts, entries = landed.call(root)
  ["landed #{REGISTRY_REL} (#{Landed.describe(pts)})", entries]
rescue Landed::Unreadable => e
  [nil, Landed.unreadable_lines("hook registry", e.probes)]
rescue Landed::Mismatch => e
  [nil, Landed.mismatch_lines(e.local, e.remote, e.source)]
end

# The check. Keyword arguments exist for the inline self-test; the CLI passes
# none. `landed` is how the landed registry is read (Landed, from origin).
def run(path: settings_path, registry_file: REGISTRY, root: REPO_DIR,
        landed: ->(r) { landed_registry(r) }, dirs: checkout_dirs)
  begin
    registry = load_registry(registry_file)
  rescue RegistryError => e
    return unmeasured(["  this checkout's hook registry cannot be read: #{e.message}",
                       "  Fix: repair #{REGISTRY_REL} on this branch (a JSON object whose \"hooks\" is an " \
                       "array of {event, matcher, script} strings) and re-run."])
  end

  broken = inconsistent(registry, root)
  unless File.exist?(path)
    if broken.empty?
      puts "check-hooks-registered: no settings file at #{path} — nothing to assert (not this environment). OK."
      return EXIT_OK
    end
    report_failures(path, broken, [], [], [])
    return EXIT_FAIL
  end

  begin
    settings = load_settings(path)
  rescue RegistryError => e
    return unmeasured(["  the live settings cannot be read: #{e.message}",
                       "  Fix: this is the owner's machine state; report it to the owner. Do not " \
                       "rewrite the file (the clobber path of the 2026-09-17 outage)."])
  end

  dangle = dangling(settings, dirs)
  bar, landed_entries = measure_landed(landed, root)
  if bar.nil?
    # A failure the check can SEE is broken whatever landed (a script that
    # cannot run exits 127/126 on every event), so it is exit 1, with the
    # missing measurement still printed. Exit 3 only when nothing is known bad.
    return unmeasured(landed_entries + [OFFLINE_NOTE]) if broken.empty? && dangle.empty?

    report_failures(path, broken, dangle, [], [])
    unmeasured(landed_entries + [OFFLINE_NOTE])
    return EXIT_FAIL
  end

  # Rows, not pairs (DND-887): every landed row is required on its own
  # matcher, a row only this branch declares is pending, and a wiring of a
  # declared script under a matcher NEITHER side declares is stale. A branch
  # that changes a landed row's matcher cannot lower its own bar: the landed
  # matcher stays required until the change lands (a machine wired from main
  # has it), and the new one is pending. Declarations on both sides count for
  # stale, so neither half of that install window reads as stale.
  drift   = drift_for(settings, landed_entries, dirs)
  keys    = landed_entries.map { |e| row_key(e) }
  pending = drift_for(settings, registry.reject { |e| keys.include?(row_key(e)) }, dirs)
  stale   = stale_for(settings, landed_entries + registry, dirs)
  if broken.empty? && dangle.empty? && drift.empty? && stale.empty?
    puts "check-hooks-registered: all #{landed_entries.size} landed registry rows are wired in #{path}, " \
         "each on its declared (event, matcher) (bar: #{bar}). OK."
    report_pending(pending)
    return EXIT_OK
  end

  report_failures(path, broken, dangle, drift, pending, stale)
  EXIT_FAIL
end

def report_pending(pending, out = $stdout)
  return if pending.empty?

  out.puts "  #{pending.size} hook(s) this branch adds are not wired yet (pending, not a failure):"
  pending.each { |m| out.puts "  ~ #{m}" }
  out.puts "  After the branch lands, wire them with `scripts/setup-hooks --install` in the MAIN " \
           "checkout. Do not wire them before: the main checkout has no such script yet, so every " \
           "event it matches would fail with exit 127."
end

def report_failures(path, broken, dangle, drift, pending, stale = [])
  warn "check-hooks-registered: FAIL"
  unless broken.empty?
    warn "  #{broken.size} registry entr(ies) on this branch name a script that cannot run:"
    broken.each { |m| warn "  - #{m}" }
    warn "  Fix: add the script (chmod +x) or correct its path in #{REGISTRY_REL}."
  end
  unless dangle.empty?
    warn "  #{dangle.size} wired hook(s) in #{path} point at a script that cannot run (dangling):"
    dangle.each { |m| warn "  - #{m}" }
    warn "  Fix: this usually means a hook was wired before its branch landed. Land that branch " \
         "(the main checkout then has the script), or have the owner remove that one entry from " \
         "#{path}. Live settings are the owner's machine state: an agent reports this, it does not edit it."
  end
  unless drift.empty?
    warn "  #{drift.size} landed registry row(s) are NOT wired on their (event, matcher) in #{path}:"
    drift.each { |m| warn "  - #{m}" }
    warn "  Fix: re-wire them by running `scripts/setup-hooks --install` from the MAIN checkout " \
         "(it MERGES into settings.json, backing it up first — it never clobbers the existing block; " \
         "it adds each missing (event, matcher, script) row). If a hook was intentionally retired or " \
         "its matcher changed, change #{REGISTRY_REL} and land that; if main already did so after " \
         "your merge-base, rebase onto origin/main."
  end
  unless stale.empty?
    warn "  #{stale.size} wiring(s) in #{path} use a matcher neither the landed nor this branch's " \
         "registry declares for that script:"
    stale.each { |m| warn "  - #{m}" }
    warn "  Fix: run `scripts/setup-hooks --install` from the MAIN checkout; it replaces a stale " \
         "matcher, touching only that registry script's wiring on that event. If the matcher is " \
         "intended, declare it in #{REGISTRY_REL} and land that."
  end
  report_pending(pending, $stderr)
end

# ---------------------------------------------------------------------------
# DND-887: a hook is identified by (event, matcher, script), not (event,
# script). Two registry rows for one script on one event with different
# matchers are two wirings; keyed without the matcher, the second collapsed
# into the first, was never installed, and this check could not see it.
#
# Composed with DND-743's landed bar, per ROW: every landed (event, matcher,
# script) row is required, a row only this branch declares is pending, and a
# matcher neither side declares is stale. A branch that CHANGES a landed row's
# matcher cannot lower its own bar with it: the landed matcher stays required
# until the change lands.
#
# Driven through `run`, the entry point the CLI calls, with the landed bar
# injected and a throwaway checkout whose hook script exists, so the cases
# assert exit codes and the named lines without reading any origin.
def matcher_key_cases(check)
  require "tmpdir"
  require "stringio"
  Dir.mktmpdir do |dir|
    script = "ai/hooks/dnd-887-two-matchers.sh"
    FileUtils.mkdir_p(File.join(dir, "ai", "hooks"))
    File.write(File.join(dir, script), "#!/bin/sh\nexit 0\n")
    File.chmod(0o755, File.join(dir, script))
    cmd = File.join(dir, script)
    row = ->(matcher, event = "PreToolUse") { { "event" => event, "matcher" => matcher, "script" => script } }
    # probe(landed rows, branch rows, wired matchers[, event]) -> [exit, all output]
    probe = lambda do |landed, branch, wired, event = "PreToolUse"|
      reg = File.join(dir, "registry.json")
      File.write(reg, JSON.generate({ "hooks" => branch }))
      groups = wired.map do |m|
        g = { "hooks" => [{ "type" => "command", "command" => cmd }] }
        g["matcher"] = m unless m.equal?(:omitted)
        g
      end
      f = File.join(dir, "settings.json")
      File.write(f, JSON.generate({ "hooks" => { event => groups } }))
      o, e = $stdout, $stderr
      buf = StringIO.new
      $stdout = $stderr = buf
      begin
        rc = run(path: f, registry_file: reg, root: dir, dirs: [dir],
                 landed: ->(_r) { [[["fixture landed", "0" * 40]], landed] })
      ensure
        $stdout, $stderr = o, e
      end
      [rc, buf.string]
    end
    two = [row.call("Bash"), row.call("Edit|Write")]

    rc, = probe.call(two, two, ["Bash", "Edit|Write"])
    check.call("two same-script rows, different matchers, both wired -> no drift", rc == EXIT_OK)

    # Sabotage: remove one of the two. The OLD keying's install produced exactly
    # this file (the second row collapsed into the first), so this is also the
    # migration case: it must read as drift, naming the missing matcher.
    rc, out = probe.call(two, two, ["Bash"])
    check.call("one of two same-script rows removed -> drift (exit 1)", rc == EXIT_FAIL)
    check.call("the drift line names the missing matcher and script",
               out.include?('"Edit|Write"') && out.include?(script))

    rc, out = probe.call(two, two, ["Edit|Write"])
    check.call("the other row removed -> drift naming it",
               rc == EXIT_FAIL && out.include?('"Bash" ->') && !out.include?('"Edit|Write" ->'))

    # A registry script wired under a matcher neither the landed nor the branch
    # registry declares for it is stale wiring -- the signature a live file
    # keeps when two rows were once one combined matcher (DND-840).
    rc, out = probe.call(two, two, ["Bash|Edit|Write"])
    check.call("combined matcher where the registry has two rows -> drift, named stale",
               rc == EXIT_FAIL && out.include?('"Bash|Edit|Write"') && out.include?("stale"))
    rc, out = probe.call(two, two, ["Bash", "Edit|Write", "Other"])
    check.call("declared rows wired plus an undeclared matcher -> stale (exit 1)",
               rc == EXIT_FAIL && out.include?('"Other"') && out.include?("stale"))

    # Claude Code treats an omitted matcher, "" and "*" alike (match all), so a
    # registry "" is satisfied by any of the three and none of them is stale.
    all_row = [row.call("", "SessionStart")]
    all_ok = [:omitted, "", "*"].all? { |m| probe.call(all_row, all_row, [m], "SessionStart").first == EXIT_OK }
    check.call("omitted / \"\" / \"*\" matcher all satisfy a registry \"\" row", all_ok)

    # --- composed with the landed bar (DND-743) ---
    # A second matcher row only this branch adds, for a landed (event, script):
    # pending, like any branch-added hook, and named.
    rc, out = probe.call([row.call("Bash")], two, ["Bash"])
    check.call("a branch-added matcher row for a landed script, unwired -> pending, exit 0",
               rc == EXIT_OK && out.include?("pending") && out.include?('"Edit|Write"'))

    # A landed row the branch still declares cannot be rescued by the branch.
    rc, = probe.call(two, [row.call("Bash")], ["Bash"])
    check.call("a landed matcher row the branch drops, unwired -> still drift (exit 1)", rc == EXIT_FAIL)

    # A landed script the branch removes entirely stays required (DND-743).
    rc, = probe.call([row.call("Bash")], [], [])
    check.call("a landed script the branch removes, unwired -> still drift (exit 1)", rc == EXIT_FAIL)

    # A matcher change on the branch. Wired from main (the landed matcher) it
    # passes with the new row pending; wired only the new way, the landed row is
    # drift: a branch that narrows a matcher cannot pass on its own say-so.
    broad  = [row.call("Bash|mcp__notion.*")]
    narrow = [row.call("Bash|mcp__notion-work__API-post-page")]
    rc, out = probe.call(broad, narrow, ["Bash|mcp__notion-work__API-post-page"])
    check.call("matcher change, wired only the NEW way -> drift on the landed row (exit 1)",
               rc == EXIT_FAIL && out.include?('"Bash|mcp__notion.*"'))
    rc, out = probe.call(broad, narrow, ["Bash|mcp__notion.*"])
    check.call("matcher change, wired the LANDED way -> exit 0, new row pending",
               rc == EXIT_OK && out.include?("pending") && out.include?('"Bash|mcp__notion-work__API-post-page"'))
    rc, out = probe.call(broad, narrow, ["Other"])
    check.call("matcher change, wired neither way -> drift on the landed row, and stale",
               rc == EXIT_FAIL && out.include?('"Bash|mcp__notion.*"') && out.include?("stale"))

    # A split: until it lands, the combined landed row is still required.
    split = [row.call("Bash"), row.call("Edit")]
    rc, = probe.call([row.call("Bash|Edit")], split, ["Bash", "Edit"])
    check.call("a landed matcher split in two, only the halves wired -> drift (exit 1)", rc == EXIT_FAIL)
    rc, out = probe.call([row.call("Bash|Edit")], split, ["Bash|Edit"])
    check.call("a landed matcher split in two, landed row wired -> exit 0, halves pending",
               rc == EXIT_OK && out.include?("pending") && out.include?('"Edit"'))

    # Landed is the union over origin/main's tip and the merge-base. A branch
    # cut before main changed a matcher sees both as landed; wired the new way,
    # the old row is drift until the branch rebases (as for a retired hook).
    rc, out = probe.call(broad + narrow, narrow, ["Bash|mcp__notion-work__API-post-page"])
    check.call("landed union holds old + new matcher, branch and live new -> drift naming rebase",
               rc == EXIT_FAIL && out.include?('"Bash|mcp__notion.*"') && out.include?("rebase onto origin/main"))
  end
end

def self_test
  require "tmpdir"
  registry = load_registry
  ok = true
  check = lambda do |name, cond|
    puts "  #{cond ? 'ok  ' : 'FAIL'} #{name}"
    ok &&= cond
  end

  # A settings hash with every registry hook wired -> no drift.
  full = { "hooks" => {} }
  registry.each do |e|
    (full["hooks"][e["event"]] ||= []) << {
      "matcher" => e["matcher"], "hooks" => [{ "type" => "command", "command" => abs_script(e["script"]) }]
    }
  end
  check.call("complete settings -> no drift", drift_for(full, registry).empty?)

  # Drop one hook -> exactly that one drifts.
  partial = JSON.parse(JSON.generate(full))
  dropped = registry.first
  partial["hooks"][dropped["event"]].reject! { |m| m["hooks"].any? { |h| h["command"] == abs_script(dropped["script"]) } }
  d = drift_for(partial, registry)
  check.call("missing one hook -> one drift", d.size == 1 && d.first.include?(dropped["script"]))

  # Empty settings -> everything drifts.
  check.call("empty settings -> all drift", drift_for({ "hooks" => {} }, registry).size == registry.size)

  # A live entry that reaches the same script through a symlink counts as wired
  # (this machine's ~/.claude/hooks -> repo ai/hooks). Build a settings hash whose
  # commands point at a symlinked copy of the repo hooks dir and assert no drift.
  Dir.mktmpdir do |dir|
    link = File.join(dir, "hooks-link")
    File.symlink(File.join(REPO_DIR, "ai", "hooks"), link)
    linked = { "hooks" => {} }
    registry.each do |e|
      base = File.basename(e["script"])
      (linked["hooks"][e["event"]] ||= []) << {
        "matcher" => e["matcher"], "hooks" => [{ "type" => "command", "command" => File.join(link, base) }]
      }
    end
    check.call("symlinked script path -> no drift", drift_for(linked, registry).empty?)
  end

  # WORKTREE EQUIVALENCE (the 2026-09-18 DND-182 false-fail). Settings wired at
  # the MAIN checkout must read as wired when the check runs from a worktree,
  # whose REPO_DIR is the worktree. Simulate with an explicit `dirs` list: a
  # (non-existent, so norm() passes it through literally) worktree dir plus the
  # main checkout.
  #
  # `full` is wired at main_checkout_dir, so the simulated dirs list is the one
  # checkout_dirs yields from a worktree: [main, worktree]. DND-507: this case
  # used to pass [REPO_DIR, fake_worktree], which names the main checkout only
  # when the suite itself runs there -- so it was red in every worktree, i.e.
  # wherever captains run the gate, and green only by inspection.
  fake_worktree = "/nonexistent/worktrees/custom/some-branch"
  check.call("settings wired at main + running from a worktree -> no drift",
             drift_for(full, registry, [main_checkout_dir, fake_worktree]).empty?)
  check.call("worktree dir ALONE does not satisfy main-wired settings",
             drift_for(full, registry, [fake_worktree]).size == registry.size)

  # main_checkout_dir resolves to the main checkout from the main checkout AND
  # from a linked worktree, and degrades to its argument outside a git repo
  # rather than raising. Proven against a throwaway repo + worktree, so the
  # answer does not depend on which checkout runs this suite (DND-507: the old
  # `main_checkout_dir(REPO_DIR) == REPO_DIR` held only in the main checkout).
  Dir.mktmpdir do |d|
    repo = File.join(d, "repo")
    wt   = File.join(d, "wt")
    git_env = { "GIT_AUTHOR_NAME" => "t", "GIT_AUTHOR_EMAIL" => "t@t",
                "GIT_COMMITTER_NAME" => "t", "GIT_COMMITTER_EMAIL" => "t@t" }
    built = system("git", "-c", "init.defaultBranch=main", "init", "-q", repo, out: File::NULL, err: File::NULL) &&
            system(git_env, "git", "-C", repo, "commit", "-q", "--allow-empty", "-m", "init",
                   out: File::NULL, err: File::NULL) &&
            system("git", "-C", repo, "worktree", "add", "-q", "--detach", wt, out: File::NULL, err: File::NULL)
    check.call("fixture repo + linked worktree built", built)
    if built
      real = ->(p) { File.realpath(p) }
      check.call("main_checkout_dir(main checkout) == main checkout",
                 real.call(main_checkout_dir(repo)) == real.call(repo))
      check.call("main_checkout_dir(linked worktree) == main checkout",
                 real.call(main_checkout_dir(wt)) == real.call(repo))
    end
  end
  Dir.mktmpdir { |d| check.call("main_checkout_dir(non-git) == arg", main_checkout_dir(d) == d) }

  # Run the real entry point but silence its (expected) diagnostic output so the
  # gate log stays clean — we assert on the exit code only.
  quiet = lambda do |&blk|
    o, e = $stdout, $stderr
    $stdout = $stderr = File.open(File::NULL, "w")
    begin; blk.call; ensure; $stdout.close; $stdout, $stderr = o, e; end
  end
  # The run paths, with the landed bar injected so this suite stays hermetic.
  # The origin-backed read is proven end to end, on fixture repos with a bare
  # origin, by ai/test/check-hooks-registered/self-test.sh. Settings here are
  # wired at THIS checkout, where every branch script exists, so a hook this
  # branch adds (absent from the main checkout until it lands) is not dangling.
  as_landed = ->(entries) { ->(_root) { [[["fixture landed", "0" * 40]], entries] } }
  never = ->(_root) { raise "the landed bar must not be read here" }
  here = [REPO_DIR]
  wire_here = lambda do |entries|
    s = { "hooks" => {} }
    entries.each do |e|
      (s["hooks"][e["event"]] ||= []) << {
        "matcher" => e["matcher"], "hooks" => [{ "type" => "command", "command" => abs_script(e["script"], REPO_DIR) }]
      }
    end
    JSON.generate(s)
  end
  go = ->(f, landed, **kw) { quiet.call { run(path: f, landed: landed, dirs: here, **kw) } }
  Dir.mktmpdir do |dir|
    check.call("absent settings file -> exit 0, landed bar not read",
               go.call(File.join(dir, "nope.json"), never) == EXIT_OK)
    f = File.join(dir, "settings.json")
    File.write(f, JSON.generate({ "hooks" => {} }))
    check.call("present drifted file -> exit 1", go.call(f, as_landed.call(registry)) == EXIT_FAIL)
    File.write(f, wire_here.call(registry))
    check.call("complete file -> exit 0", go.call(f, as_landed.call(registry)) == EXIT_OK)
    extra = { "event" => "SessionStart", "matcher" => "", "script" => "ai/hooks/landed-elsewhere.sh" }
    check.call("a landed hook the branch registry lacks is still required -> exit 1",
               go.call(f, as_landed.call(registry + [extra])) == EXIT_FAIL)
    File.write(f, wire_here.call(registry.drop(1)))
    check.call("a branch-only hook (not landed), unwired, is pending, not a failure -> exit 0",
               go.call(f, as_landed.call(registry.drop(1))) == EXIT_OK)
    check.call("...and the same hook once landed and unwired is drift -> exit 1",
               go.call(f, as_landed.call(registry)) == EXIT_FAIL)
    unreadable = ->(_root) { raise Landed::Unreadable.new([["fixture probe", "unreachable"]]) }
    check.call("landed bar unreadable -> exit 3", go.call(f, unreadable) == EXIT_UNMEASURED)
    mismatch = ->(_root) { raise Landed::Mismatch.new("a" * 40, "b" * 40) }
    check.call("local origin/main disagrees with origin -> exit 3", go.call(f, mismatch) == EXIT_UNMEASURED)
    ghost = abs_script("ai/hooks/definitely-not-on-disk-#{Process.pid}.sh", REPO_DIR)
    dangling_settings = JSON.parse(wire_here.call(registry))
    (dangling_settings["hooks"]["SessionStart"] ||= []) << {
      "matcher" => "", "hooks" => [{ "type" => "command", "command" => ghost }]
    }
    File.write(f, JSON.generate(dangling_settings))
    check.call("landed bar unreadable, but a wired hook is dangling -> exit 1 (a seen failure outranks it)",
               go.call(f, unreadable) == EXIT_FAIL)
    File.write(f, "{ not json")
    check.call("malformed settings -> exit 3", go.call(f, never) == EXIT_UNMEASURED)
    bad_reg = File.join(dir, "registry.json")
    File.write(bad_reg, JSON.generate({ "hooks" => 7 }))
    check.call("malformed branch registry -> exit 3", go.call(f, never, registry_file: bad_reg) == EXIT_UNMEASURED)
  end

  # dangling: a wired command under a checkout's ai/hooks/ that cannot run.
  Dir.mktmpdir do |d|
    FileUtils.mkdir_p(File.join(d, "ai", "hooks"))
    live = File.join(d, "ai", "hooks", "live.sh")
    File.write(live, "#!/bin/sh\n")
    File.chmod(0o755, live)
    noexec = File.join(d, "ai", "hooks", "noexec.sh")
    File.write(noexec, "#!/bin/sh\n")
    File.chmod(0o644, noexec)
    ghost = File.join(d, "ai", "hooks", "ghost.sh")
    s = { "hooks" => { "Stop" => [{ "matcher" => "", "hooks" => [
      { "command" => live }, { "command" => "#{ghost} --flag" }, { "command" => noexec },
      { "command" => "/usr/bin/true" }
    ] }] } }
    got = dangling(s, [d])
    check.call("dangling: a missing script is flagged", got.any? { |m| m.include?("ghost.sh") && m.include?("does not exist") })
    check.call("dangling: a non-executable script is flagged", got.any? { |m| m.include?("noexec.sh") })
    check.call("dangling: a runnable hook and a command outside ai/hooks/ are not", got.size == 2)
  end

  # `check` closes over `ok`, so a failing case here reddens the suite.
  matcher_key_cases(check)

  puts(ok ? "ALL CASES PASS" : "SELF-TEST FAILED")
  ok ? 0 : 1
end

# Internal: print this tool's normalized form of one path, so setup-hooks'
# self-test can compare the two SHIPPED implementations rather than copies of
# them. The step-lock between them is asserted as an invariant in both comment
# blocks; an invariant nothing checks is the thing the next reader relies on.
if ARGV.include?("--help") || ARGV.include?("-h")
  puts <<~TXT
    Usage:
      ai/bin/check-hooks-registered              assert every hook in
                                                 ai/hooks/registry.json AS LANDED on
                                                 origin/main is wired into the live
                                                 Claude Code settings; a hook only
                                                 this branch adds is named as pending
                                                 (not a failure); a wired hook whose
                                                 script cannot run fails (dangling).
                                                 Exit 0 ok, 1 fail, 3 could not measure
      ai/bin/check-hooks-registered --norm PATH  print this tool's normalized form
                                                 of PATH (used by setup-hooks'
                                                 self-test)
      ai/bin/check-hooks-registered --self-test  deterministic suite (no model)
      ai/bin/check-hooks-registered --help       this text

    Environment-safe: passes with a note when no settings file exists (CI/agent
    env). Recover drift with `scripts/setup-hooks --install`.
  TXT
  exit 0
end
require_relative "../lib/strict_argv"

# Parsed BEFORE anything runs (DND-813). An argument this tool does not
# recognise must never fall through: `--self-tset` ran the live check and exited
# 0, and a valueless `--norm` printed the normalised form of "" -- an answer to
# a question nobody asked, which setup-hooks' agreement probe would compare as
# if it were real. Every argument must be a declared flag; the modes exclude
# each other.
CLI_SPEC = { "--self-test" => :switch, "--norm" => :value }.freeze

# -> [opts, nil] on success, [nil, reason] on a usage error.
def parse_cli(argv)
  opts = StrictArgv.parse(argv, CLI_SPEC)
  if opts["--self-test"] && opts["--norm"]
    return [nil, "--norm PATH and --self-test are two modes; pass one"]
  end

  [opts, nil]
rescue StrictArgv::UsageError => e
  [nil, e.message]
end

cli, reason = parse_cli(ARGV)
if reason
  warn "check-hooks-registered: usage error — #{reason}."
  warn "  Fix: re-run with only the flags `ai/bin/check-hooks-registered --help` " \
       "lists: no argument (the live check), --norm PATH, or --self-test. An " \
       "unrecognised argument is refused, not ignored: ignoring it would run " \
       "the live check and report its verdict as the answer to what you asked."
  exit 2
end
if cli.key?("--norm")
  puts norm(cli["--norm"])
  exit 0
elsif cli["--self-test"]
  exit self_test
else
  exit run
end
