#!/usr/bin/ruby
# frozen_string_literal: true

# check-hooks-registered — assert the harness hooks are actually wired into the
# live Claude Code settings, not just present on disk.
#
# The motivating outage (2026-09-17): a telemetry change rewrote the "hooks"
# block of ~/.claude/settings.json and dropped the existing entries, silently
# disabling safe-wait-guard and pronoun-guard. Nothing detected it — a guard
# file can exist, pass its own --self-test, and still never run because it is
# registered nowhere. This check closes that blind spot: it compares the
# committed source of truth (ai/hooks/registry.json) against the live settings
# and fails, naming each drift, if a registered hook is missing.
#
# Environment-safe by design: if the target settings file does not exist (a
# fresh machine, a CI/agent env with a different HOME, a container), there is
# nothing to assert, so it PASSES with a note rather than false-failing every
# harness commit. It only fails when a settings file exists AND a registry hook
# is absent from it.
#
# THE BAR IS THE REGISTRY THAT LANDED, NOT THE BRANCH'S (DND-743, folding in
# DND-478). The hooks the live settings MUST wire are the ones in
# ai/hooks/registry.json as it landed on origin's main (ai/lib/landed.rb: the
# union over origin/main's tip and merge-base(HEAD, origin/main), the strictest).
# It used to be the branch's own copy, which broke both ways:
#   - a branch that ADDED a hook failed until the live settings wired it. The
#     only way to green was `setup-hooks --install` from the worktree, which
#     wires the MAIN checkout's path, where the script does not exist until the
#     branch lands: exit 127 on every tool call (DND-670). Machine config became
#     a precondition of reviewing code;
#   - a branch that REMOVED or re-evented a landed hook lowered its own bar, so
#     real drift on main passed. See ~/dev/custom/CLAUDE.md -> "A check's own
#     bar must not live in the diff it is checking".
# So the check now reports, in order:
#   1. BRANCH CONSISTENCY: every entry in this checkout's registry names a script
#      that exists here and is executable (fails, exit 1). Needs no settings.
#   2. DANGLING: a wired command under a checkout's ai/hooks/ whose script is
#      missing or not executable, the exit-127 state (fails, exit 1).
#   3. DRIFT: a LANDED (event, script) pair the live settings do not wire
#      (fails, exit 1) -- exactly the pre-DND-743 failure, keyed on what landed.
#   4. PENDING: a pair only this branch adds, not wired yet. Named, never a
#      failure: it is wired after it lands, from the main checkout.
#   5. RETIRED, STILL WIRED (DND-1517): a row of the LANDED registry's
#      `retired` list (an exact event, matcher, script) the live settings still
#      wire (fails, exit 1, like a stale matcher: a wiring the landed registry
#      says must go, and `setup-hooks --install` removes it). A retirement only
#      this branch adds is pending; one the branch drops still counts. A row
#      the landed union still requires wins over its retirement. A branch row
#      both declared and retired is an inconsistent branch registry (exit 1).
#   6. AHEAD OF THE PINNED BAR (DND-1552): under harness-gate the bar is
#      origin's main as of the gate start. When origin's main has since moved
#      past the pin and the owner ran `setup-hooks --install` from the main
#      checkout, the live wiring matches the NEWER main, and steps 3 and 5 read
#      that as drift. So when 3 or 5 (or a stale matcher) fails, the live
#      settings are measured against a NEWER bar with the same three rules
#      (every row wired, no stale matcher, no retired row wired). That bar is
#      the newer origin/main's registry plus the registry at any landed point
#      OLDER than the pin (the merge-base, when the branch was cut before it):
#      only the pin is superseded, so a branch that needs a rebase still fails.
#      A newer origin/main with no registry is could-not-judge, never an empty
#      bar. Only if the live wiring passes the newer bar in full is each pinned
#      failure named "ahead of the pinned bar" instead of failing. Wiring that passes neither
#      bar fails as before; dangling and an inconsistent branch registry are
#      never excused. The newer registry is read from git (ai/lib/landed.rb,
#      Landed.newer_tip), never from the working tree.
# A bar that cannot be read (origin unreachable, local origin/main disagreeing
# with origin, a malformed registry or settings file) is COULD NOT MEASURE,
# exit 3, never a pass. An offline machine with a settings file is exit 3. When
# the landed bar cannot be read but a failure is visible without it (dangling,
# or an inconsistent branch registry), the exit is 1: that failure stands
# whatever landed, and the missing measurement is printed beside it.
#
# Deliberately gem-free (stdlib only); run with bare `ruby`.
#
# Usage:
#   ai/bin/check-hooks-registered            assert registry hooks are live
#   ai/bin/check-hooks-registered --self-test  verify the checker's own logic
#
# Override the target settings file with HOOKS_SETTINGS_FILE (used by the
# self-test and by scripts/setup-hooks --check; defaults to ~/.claude/settings.json).
#
# Exit codes: 0 ok / not-this-env · 1 drift, dangling, or an inconsistent
# branch registry · 3 could not measure (the landed bar, the branch registry, or
# the settings file could not be read, or the main checkout could not be
# resolved, DND-1720)

require "json"
require "shellwords"
require "stringio"
require_relative "../lib/agent_stash_env"
require_relative "../lib/landed"

AI_DIR       = File.expand_path("..", __dir__)          # .../ai
REPO_DIR     = File.expand_path("..", AI_DIR)           # repo root (may be a worktree)
REGISTRY_REL = "ai/hooks/registry.json"
# HOOKS_REGISTRY_FILE is a TEST SEAM, matching setup-hooks': the two tools must
# be checkable against the same synthetic registry, or "they agree" is asserted
# only where both happen to read the real one. It replaces only the BRANCH
# registry (consistency and pending). The required set is always read from
# origin, so no environment variable can lower the bar.
REGISTRY     = ENV.fetch("HOOKS_REGISTRY_FILE") { File.join(REPO_DIR, REGISTRY_REL) }
EXIT_OK         = 0
EXIT_FAIL       = 1
EXIT_UNMEASURED = 3

# A registry (or settings) document that cannot be read or has the wrong shape.
class RegistryError < StandardError; end

# The MAIN checkout for this repo. Hooks are always wired at the main checkout's
# path, because a worktree path vanishes when the worktree is cleaned up. But
# captains run the gate FROM a worktree, where REPO_DIR is that worktree — so
# comparing only REPO_DIR-based paths reported all 5 hooks as drifted in every
# worktree (observed 2026-09-18, DND-182). That false failure is worse than
# cosmetic: the documented recovery is `setup-hooks --install`, which would then
# rewire the live settings to a path that disappears — the 2026-09-17 outage
# class. Resolve the main checkout through git's common dir (a worktree's
# --git-common-dir IS the main checkout's .git) and accept either spelling.
#
# A main checkout that cannot be resolved raises MainCheckoutError (DND-1720),
# the same rule as scripts/lib/main-checkout.sh. It used to return `dir`
# itself, so a copy outside git, or one whose git dirs cannot be entered,
# judged the live wiring against its own (possibly worktree) paths with no
# word that the main checkout was never found.
class MainCheckoutError < StandardError; end

def main_checkout_dir(dir = REPO_DIR)
  common = `git -C #{dir.shellescape} rev-parse --path-format=absolute --git-common-dir 2>/dev/null`.strip
  unless $?.success? && common.start_with?("/")
    raise MainCheckoutError, "'#{dir}' is not inside a git checkout (git common dir #{common.inspect})"
  end

  common = File.realpath(common)
  # Only <checkout>/.git has the checkout as its parent; a --separate-git-dir
  # repo's parent is a well-formed wrong key (same rule as main-checkout.sh).
  unless File.basename(common) == ".git"
    raise MainCheckoutError, "the git common dir of '#{dir}' is #{common.inspect}, not <checkout>/.git"
  end

  File.dirname(common)
rescue SystemCallError => e
  raise MainCheckoutError, "cannot resolve the git common dir of '#{dir}' (#{common.inspect}): #{e.message}"
end

# The COULD NOT MEASURE lines for a MainCheckoutError.
def main_checkout_lines(err)
  ["  the main checkout cannot be resolved: #{err.message}",
   "  Fix: run the copy in the main checkout's ai/bin/ (e.g. ~/dev/custom/ai/bin/check-hooks-registered), " \
   "or repair that checkout's git dir."]
end

# Every checkout whose hook paths count as "this repo's hooks", most-canonical
# first. In the main checkout this is a single entry. Raises MainCheckoutError.
def checkout_dirs(root = REPO_DIR)
  [main_checkout_dir(root), root].uniq
end

def settings_path
  ENV["HOOKS_SETTINGS_FILE"] || File.join(Dir.home, ".claude", "settings.json")
end

# Expand a registry (repo-relative) script path to the absolute command string
# settings.json stores, for the canonical (main) checkout. The default `dir`
# (and the `dirs = checkout_dirs` defaults below) raise MainCheckoutError when
# there is no main checkout; the live path passes them explicitly, from run().
def abs_script(rel, dir = main_checkout_dir)
  File.join(dir, rel)
end

# Resolve a command's path through symlinks so two spellings of the same script
# compare equal. On this machine ~/.claude/hooks is a symlink to the repo's
# ai/hooks/, so a live entry spelled `~/.claude/hooks/foo.sh` is the SAME file as
# the registry's `<repo>/ai/hooks/foo.sh` — comparing raw strings falsely reports
# drift (and makes setup-hooks append a duplicate).
#
# The DIRECTORY is resolved even when the file does not exist, and it must stay
# in step with setup-hooks' own `norm` — these two answer the same question and
# a divergence between them is drift reported by one tool and not the other.
# Falling back to the literal string made the comparison depend on whether the
# script is on disk right now, which is irrelevant to "are these two spellings
# the same location": a wired hook whose file is temporarily absent read as
# drift, and a hook being added on a branch read as drift against the main
# checkout it is not in yet. Resolving `dirname` needs no file. A command that
# is not a bare path has no directory component and is returned unchanged.
def norm(cmd)
  return cmd if cmd.nil? || cmd.empty?
  return File.realpath(cmd) if File.exist?(cmd)

  dir = File.dirname(cmd)
  # A missing directory, or a command that is not a path at all, is left alone:
  # realpath would resolve it against the CWD and invent an absolute path for a
  # command that names no location this process can see. setup-hooks' `norm`
  # makes the same choice; the two must agree, or drift is reported by one tool
  # and not the other.
  return cmd if dir == "." || !File.directory?(dir)

  File.join(File.realpath(dir), File.basename(cmd))
rescue StandardError
  cmd
end

# The entries of a registry document. Raises RegistryError, naming where, when
# the text is not JSON or an entry is not {event, matcher, script} strings: a
# malformed registry is a measurement that failed, never an empty one.
def parse_registry(text, where)
  data = JSON.parse(text)
  hooks = data.is_a?(Hash) ? data["hooks"] : nil
  raise RegistryError, "#{where}: no \"hooks\" array" unless hooks.is_a?(Array)

  hooks.each_with_index do |e, i|
    good = e.is_a?(Hash) && %w[event script].all? { |k| e[k].is_a?(String) && !e[k].empty? } &&
           e.fetch("matcher", "").is_a?(String)
    raise RegistryError, "#{where}: entry #{i} is not {event, matcher, script} strings: #{e.inspect}" unless good
  end
  hooks
rescue JSON::ParserError => e
  raise RegistryError, "#{where}: not valid JSON (#{e.message.lines.first.to_s.strip})"
end

# The registry's `retired` rows (DND-1517): wirings a hook leaves the machine
# by, each an exact {event, matcher, script}. `setup-hooks --install` unwires
# them. Absent means none. Raises RegistryError, naming where, on a malformed
# list: a retirement that cannot be read is a failed measurement, not an empty
# one.
def parse_retired(text, where)
  data = JSON.parse(text)
  rows = data.is_a?(Hash) ? data.fetch("retired", []) : nil
  raise RegistryError, "#{where}: \"retired\" is not an array" unless rows.is_a?(Array)

  rows.each_with_index do |e, i|
    good = e.is_a?(Hash) && %w[event script].all? { |k| e[k].is_a?(String) && !e[k].empty? } &&
           e.fetch("matcher", "").is_a?(String)
    raise RegistryError, "#{where}: retired entry #{i} is not {event, matcher, script} strings: #{e.inspect}" unless good
  end
  rows
rescue JSON::ParserError => e
  raise RegistryError, "#{where}: not valid JSON (#{e.message.lines.first.to_s.strip})"
end

# This checkout's registry (the branch's copy). Raises RegistryError.
def load_registry(file = REGISTRY)
  parse_registry(File.read(file), file)
rescue SystemCallError => e
  raise RegistryError, "#{file}: cannot be read (#{e.message})"
end

# This checkout's retired rows. Raises RegistryError.
def load_retired(file = REGISTRY)
  parse_retired(File.read(file), file)
rescue SystemCallError => e
  raise RegistryError, "#{file}: cannot be read (#{e.message})"
end

# The registry entries that LANDED: the union over every landed point (the
# strictest bar). Returns [points, entries, retired]: the retired rows are the
# union too (DND-1517). Raises Landed::Unreadable (a malformed landed registry
# included) or Landed::Mismatch. Empty entries when no landed point has the
# file (the registry is being introduced by this diff).
def landed_registry(root = REPO_DIR)
  pts, bars = Landed.read_bar(root, REGISTRY_REL) do |text, label, sha|
    where = "#{REGISTRY_REL} @ #{label} #{sha[0, 12]}"
    [parse_registry(text, where), parse_retired(text, where)]
  rescue RegistryError => e
    raise Landed::Unreadable.new([[label, e.message]])
  end
  [pts, bars.flat_map(&:first).uniq { |e| row_key(e) }, bars.flat_map(&:last).uniq { |e| row_key(e) }]
end

# A registry row's identity (DND-887): (event, normalized matcher, script).
def row_key(entry)
  [entry["event"], mnorm(entry["matcher"]), entry["script"]]
end

# Entries of this checkout's registry whose script is missing or not
# executable in this checkout. Returns human-readable strings.
def inconsistent(registry, root = REPO_DIR)
  registry.filter_map do |e|
    path = File.join(root, e["script"])
    if !File.file?(path)
      "#{e['event']} -> #{e['script']}: no such file in #{root}"
    elsif !File.executable?(path)
      "#{e['event']} -> #{e['script']}: not executable"
    end
  end
end

# Wired commands that point into a checkout's ai/hooks/ at a script that is
# missing or not executable: the hook fails (exit 127/126) on every event it
# matches. The first shell word of the command is the path. Returns strings.
def dangling(settings, dirs = checkout_dirs)
  hook_dirs = dirs.map { |d| norm(File.join(d, "ai", "hooks")) }
  commands = []
  (settings["hooks"] || {}).each do |event, matchers|
    Array(matchers).each { |m| Array(m["hooks"]).each { |h| commands << [event, h["command"].to_s] } }
  end
  commands.uniq.filter_map do |event, cmd|
    word = begin
      Shellwords.split(cmd).first.to_s
    rescue ArgumentError
      cmd
    end
    path = norm(word)
    next unless hook_dirs.any? { |h| path.start_with?("#{h}/") }
    next if File.file?(path) && File.executable?(path)

    "#{event} -> #{cmd}: #{File.exist?(path) ? 'not executable' : 'does not exist'}"
  end
end

# A wiring is identified by (event, matcher, command) -- DND-887. Keyed on
# (event, command) alone, a second registry row for the same script on the same
# event with a different matcher collapsed into the first: setup-hooks never
# installed it and this check reported it wired. Claude Code treats an omitted
# matcher, "" and "*" alike (match everything), so they compare equal.
# setup-hooks' `mnorm` makes the same choice; the two must agree.
def mnorm(matcher)
  matcher.nil? || matcher == "" || matcher == "*" ? "" : matcher
end

# All [event, matcher, command] wirings in a parsed settings hash, each with the
# matcher as written (for naming it) alongside its normalized form.
def registered_wirings(settings)
  out = []
  (settings["hooks"] || {}).each do |event, groups|
    Array(groups).each do |m|
      Array(m["hooks"]).each do |h|
        out << { event: event, matcher: m["matcher"], key: [event, mnorm(m["matcher"]), norm(h["command"])] }
      end
    end
  end
  out
end

def describe(event, matcher, script)
  "#{event} #{(matcher || '').inspect} -> #{script}"
end

# Registry rows with no wiring on their (event, matcher, script). Returns a
# list of human-readable drift strings (empty == all registered).
def drift_for(settings, registry, dirs = checkout_dirs)
  have = registered_wirings(settings).map { |w| w[:key] }
  registry.reject do |e|
    dirs.any? { |d| have.include?([e["event"], mnorm(e["matcher"]), norm(abs_script(e["script"], d))]) }
  end.map { |e| describe(e["event"], e["matcher"], e["script"]) }
end

# Wirings of a registry script, on an event the registry wires it on, under a
# matcher the registry does not declare for that pair: a row whose matcher
# changed, or two rows that were once one combined matcher. The declared rows
# may all be present too, so drift_for alone reports these as healthy.
def stale_for(settings, registry, dirs = checkout_dirs, except: [])
  declared = Hash.new { |h, k| h[k] = [] }
  registry.each { |e| declared[[e["event"], e["script"]]] << mnorm(e["matcher"]) }
  # A wiring a landed retirement names is reported once, as retired (DND-1517).
  skip = except.flat_map { |e| dirs.map { |d| [e["event"], mnorm(e["matcher"]), norm(abs_script(e["script"], d))] } }
  registered_wirings(settings).filter_map do |w|
    next if skip.include?(w[:key])

    event, matcher, cmd = w[:key]
    script = declared.keys.find do |ev, s|
      ev == event && dirs.any? { |d| norm(abs_script(s, d)) == cmd }
    end&.last
    next unless script
    next if declared[[event, script]].include?(matcher)

    "#{describe(event, w[:matcher], script)} (stale: that matcher is not declared for this script)"
  end
end

# The live wirings of retired rows (DND-1517): each row matches exactly its
# (event, matcher, script), the wiring `setup-hooks --install` unwires. The same
# script under another matcher is not this row's. Returns [row, line] pairs.
def retired_wired(settings, rows, dirs = checkout_dirs)
  have = registered_wirings(settings).map { |w| w[:key] }
  rows.filter_map do |e|
    hit = dirs.any? { |d| have.include?([e["event"], mnorm(e["matcher"]), norm(abs_script(e["script"], d))]) }
    [e, describe(e["event"], e["matcher"], e["script"])] if hit
  end
end

# Branch rows that both declare and retire one (event, matcher, script): a
# contradiction setup-hooks refuses to apply. Returns strings.
def declared_and_retired(registry, retired)
  keys = registry.map { |e| row_key(e) }
  retired.select { |e| keys.include?(row_key(e)) }.map do |e|
    "#{describe(e['event'], e['matcher'], e['script'])}: both declared in \"hooks\" and retired"
  end
end

def unmeasured(lines)
  warn "check-hooks-registered: COULD NOT MEASURE — this is not a pass."
  lines.each { |l| warn l }
  EXIT_UNMEASURED
end

# Printed with every unreadable landed bar, so nobody reads exit 3 on an
# offline machine as a new defect.
OFFLINE_NOTE = "  Note: the bar is what landed on origin, so an offline machine with a settings " \
               "file exits 3 (could not measure). Only a machine with no settings file passes " \
               "without origin."

# Who may run the installer a Fix: names. The gate runs in every captain's
# worktree, so without this a captain that hit drift mid-gate followed the
# Fix: and edited the machine's settings unasked (DND-864 fix3, 2026-09-28).
INSTALLER_WHO = "  Who runs it: a session on this machine that its own owner turn or its own " \
                "admiral's brief authorizes (~/.claude/CLAUDE.md -> Owner approval policy -> " \
                "Notify after). A captain or other subagent without that brief reports it to its " \
                "admiral instead and does not run the installer."

# The settings hash at path. Raises RegistryError when it is not a JSON object.
def load_settings(path)
  data = JSON.parse(File.read(path))
  raise RegistryError, "#{path}: not a JSON object" unless data.is_a?(Hash)
  raise RegistryError, "#{path}: \"hooks\" is not an object" unless data.fetch("hooks", {}).is_a?(Hash)

  data
rescue JSON::ParserError => e
  raise RegistryError, "#{path}: not valid JSON (#{e.message.lines.first.to_s.strip})"
rescue SystemCallError => e
  raise RegistryError, "#{path}: cannot be read (#{e.message})"
end

# The newer bar, as [description, entries, retired], or nil when there is no
# pin or origin's main is the pin (see Landed.newer_tip). It is the newer
# origin/main's registry, unioned with the registry at each OLDER landed point
# the pinned bar also holds: merge-base(HEAD, origin/main) when the branch was
# cut before the pin. Only the pin itself is superseded, so a branch that needs
# a rebase still needs one ("drift then says rebase" below). Raises
# Landed::Unreadable when a registry is malformed, or when the newer origin/main
# has no registry at all (a newer bar that cannot be read is never an empty
# one), and Landed::Mismatch.
def newer_registry(root = REPO_DIR, older = [])
  tip = Landed.newer_tip(root)
  return nil unless tip

  points = [tip] + older
  bars = points.each_with_index.filter_map do |(label, sha), i|
    where = "#{REGISTRY_REL} @ #{label} #{sha[0, 12]}"
    text = Landed.file_at(root, sha, REGISTRY_REL, label)
    if text.nil?
      raise Landed::Unreadable.new([[label, "#{sha[0, 12]} has no #{REGISTRY_REL}, so it cannot say what the live wiring should be"]]) if i.zero?

      next
    end
    [parse_registry(text, where), parse_retired(text, where)]
  rescue RegistryError => e
    raise Landed::Unreadable.new([[label, e.message]])
  end
  ["#{REGISTRY_REL} @ #{Landed.describe(points)}",
   bars.flat_map(&:first).uniq { |e| row_key(e) }, bars.flat_map(&:last).uniq { |e| row_key(e) }]
end

# Does the live wiring pass the newer origin/main's bar in full? Returns
# [desc, nil] when it does, [nil, note] when it does not or the newer bar
# cannot be read, and [nil, nil] when there is no newer origin/main.
def ahead_of_pin(settings, registry, newer, root, dirs, older)
  got = newer.call(root, older)
  return [nil, nil] if got.nil?

  desc, entries, retired = got
  keys = entries.map { |e| row_key(e) }
  retiring = retired.reject { |e| keys.include?(row_key(e)) }
  misses = drift_for(settings, entries, dirs) +
           stale_for(settings, entries + registry, dirs, except: retiring) +
           retired_wired(settings, retiring, dirs).map(&:last)
  return [desc, nil] if misses.empty?

  [nil, "the live wiring is not ahead of the pinned bar either: against #{desc} it still has " \
        "#{misses.size} problem(s) (#{misses.join('; ')})"]
rescue Landed::Unreadable, Landed::Mismatch => e
  [nil, "could not read a newer origin/main to tell whether the live wiring is ahead of the pinned " \
        "bar (#{e.message}); it is measured against the pinned bar alone"]
end

def report_ahead(items, desc, out = $stdout)
  out.puts "  #{items.size} pinned-bar failure(s) are ahead of the pinned bar (not drift): the live " \
           "wiring passes #{desc} in full, a commit that landed after harness-gate pinned origin/main:"
  items.each { |m| out.puts "  ~ #{m}: ahead of the pinned bar" }
end

# The landed bar as [description, entries, retired, points], or [nil, lines]
# when it could not be measured (lines explain why).
def measure_landed(landed, root)
  pts, entries, retired = landed.call(root)
  ["landed #{REGISTRY_REL} (#{Landed.describe(pts)})", entries, retired, pts]
rescue Landed::Unreadable => e
  [nil, Landed.unreadable_lines("hook registry", e.probes)]
rescue Landed::Mismatch => e
  [nil, Landed.mismatch_lines(e.local, e.remote, e.source)]
end

# The check. Keyword arguments exist for the inline self-test; the CLI passes
# none. `landed` is how the landed registry is read (Landed, from origin).
def run(path: settings_path, registry_file: REGISTRY, root: REPO_DIR,
        landed: ->(r) { landed_registry(r) }, newer: ->(r, older) { newer_registry(r, older) }, dirs: nil)
  begin
    registry = load_registry(registry_file)
    branch_retired = load_retired(registry_file)
  rescue RegistryError => e
    return unmeasured(["  this checkout's hook registry cannot be read: #{e.message}",
                       "  Fix: repair #{REGISTRY_REL} on this branch (a JSON object whose \"hooks\" is an " \
                       "array of {event, matcher, script} strings, and whose optional \"retired\" is too) " \
                       "and re-run."])
  end

  broken = inconsistent(registry, root) + declared_and_retired(registry, branch_retired)
  unless File.exist?(path)
    if broken.empty?
      puts "check-hooks-registered: no settings file at #{path} — nothing to assert (not this environment). OK."
      return EXIT_OK
    end
    report_failures(path, broken, [], [], [])
    return EXIT_FAIL
  end

  begin
    settings = load_settings(path)
  rescue RegistryError => e
    return unmeasured(["  the live settings cannot be read: #{e.message}",
                       "  Fix: this is the owner's machine state; report it to the owner. Do not " \
                       "rewrite the file (the clobber path of the 2026-09-17 outage)."])
  end

  # Resolved only once there is a settings file to judge, so a machine with
  # none still passes as "not this environment". An unresolvable main
  # checkout is COULD NOT MEASURE, or exit 1 beside a failure already seen.
  begin
    dirs ||= checkout_dirs(root)
  rescue MainCheckoutError => e
    return unmeasured(main_checkout_lines(e)) if broken.empty?

    report_failures(path, broken, [], [], [])
    unmeasured(main_checkout_lines(e))
    return EXIT_FAIL
  end

  dangle = dangling(settings, dirs)
  bar, landed_entries, landed_retired, landed_pts = measure_landed(landed, root)
  if bar.nil?
    # A failure the check can SEE is broken whatever landed (a script that
    # cannot run exits 127/126 on every event), so it is exit 1, with the
    # missing measurement still printed. Exit 3 only when nothing is known bad.
    return unmeasured(landed_entries + [OFFLINE_NOTE]) if broken.empty? && dangle.empty?

    report_failures(path, broken, dangle, [], [])
    unmeasured(landed_entries + [OFFLINE_NOTE])
    return EXIT_FAIL
  end

  # Rows, not pairs (DND-887): every landed row is required on its own
  # matcher, a row only this branch declares is pending, and a wiring of a
  # declared script under a matcher NEITHER side declares is stale. A branch
  # that changes a landed row's matcher cannot lower its own bar: the landed
  # matcher stays required until the change lands (a machine wired from main
  # has it), and the new one is pending. Declarations on both sides count for
  # stale, so neither half of that install window reads as stale.
  drift   = drift_for(settings, landed_entries, dirs)
  keys    = landed_entries.map { |e| row_key(e) }
  pending = drift_for(settings, registry.reject { |e| keys.include?(row_key(e)) }, dirs)
  # Retired rows (DND-1517), also on the landed bar. A landed retirement still
  # wired fails, like a stale matcher: a wiring the landed registry says must
  # go, which `setup-hooks --install` removes. A landed row that is still
  # REQUIRED wins over a retirement of the same row (the union holds both when
  # main retired it after this branch's merge-base; drift then says rebase).
  # A retirement only this branch adds is pending, and one the branch drops
  # still counts: a branch can neither unwire nor excuse a landed hook.
  retiring = landed_retired.reject { |e| keys.include?(row_key(e)) }
  still_wired = retired_wired(settings, retiring, dirs)
  rkeys    = landed_retired.map { |e| row_key(e) }
  pending_retired = retired_wired(settings, branch_retired.reject { |e| rkeys.include?(row_key(e)) }, dirs)
  stale   = stale_for(settings, landed_entries + registry, dirs, except: retiring)
  ahead_note = nil
  ahead_desc = nil
  ahead = []
  unless drift.empty? && stale.empty? && still_wired.empty?
    # Only on a pinned-bar failure: a pass needs no newer read.
    # The pin is the first landed point; any later one (the merge-base) is
    # older than the pin and stays part of the bar.
    ahead_desc, ahead_note = ahead_of_pin(settings, registry, newer, root, dirs, landed_pts.drop(1))
    if ahead_desc
      ahead = drift.map { |m| "#{m} (not wired)" } + stale + still_wired.map { |_e, d| "#{d} (retired, still wired)" }
      drift = []
      stale = []
      still_wired = []
    end
  end
  if broken.empty? && dangle.empty? && drift.empty? && stale.empty? && still_wired.empty?
    puts "check-hooks-registered: all #{landed_entries.size} landed registry rows are wired in #{path}, " \
         "each on its declared (event, matcher), and none of the #{retiring.size} landed retired row(s) is still wired " \
         "(bar: #{bar})#{ahead_desc ? ', or the live wiring is ahead of it' : ''}. OK."
    report_ahead(ahead, ahead_desc) if ahead_desc
    report_pending(pending)
    report_pending_retired(pending_retired)
    return EXIT_OK
  end

  report_failures(path, broken, dangle, drift, pending, stale: stale, retired: still_wired.map(&:last),
                                                        pending_retired: pending_retired)
  warn "  note: #{ahead_note}" if ahead_note
  report_ahead(ahead, ahead_desc, $stderr) if ahead_desc
  EXIT_FAIL
end

def report_pending_retired(pending_retired, out = $stdout)
  return if pending_retired.empty?

  out.puts "  #{pending_retired.size} retirement(s) this branch adds are still wired (pending, not a failure):"
  pending_retired.each { |_e, d| out.puts "  ~ #{d} (pending retirement: still wired)" }
  out.puts "  After the branch lands, `scripts/setup-hooks --install` in the MAIN checkout unwires them."
end

def report_pending(pending, out = $stdout)
  return if pending.empty?

  out.puts "  #{pending.size} hook(s) this branch adds are not wired yet (pending, not a failure):"
  pending.each { |m| out.puts "  ~ #{m}" }
  out.puts "  After the branch lands, wire them with `scripts/setup-hooks --install` in the MAIN " \
           "checkout. Do not wire them before: the main checkout has no such script yet, so every " \
           "event it matches would fail with exit 127."
end

def report_failures(path, broken, dangle, drift, pending, stale: [], retired: [], pending_retired: [])
  warn "check-hooks-registered: FAIL"
  unless broken.empty?
    warn "  #{broken.size} registry entr(ies) on this branch cannot be applied:"
    broken.each { |m| warn "  - #{m}" }
    warn "  Fix: add the script (chmod +x) or correct its path in #{REGISTRY_REL}; for a row both " \
         "declared and retired, keep only the one you mean."
  end
  unless dangle.empty?
    warn "  #{dangle.size} wired hook(s) in #{path} point at a script that cannot run (dangling):"
    dangle.each { |m| warn "  - #{m}" }
    warn "  Fix: this usually means a hook was wired before its branch landed. Land that branch " \
         "(the main checkout then has the script), or have the owner remove that one entry from " \
         "#{path}. Live settings are the owner's machine state: an agent reports this, it does not edit it."
  end
  unless drift.empty?
    warn "  #{drift.size} landed registry row(s) are NOT wired on their (event, matcher) in #{path}:"
    drift.each { |m| warn "  - #{m}" }
    warn "  Fix: re-wire them by running `scripts/setup-hooks --install` from the MAIN checkout " \
         "(it MERGES into settings.json, backing it up first — it never clobbers the existing block; " \
         "it adds each missing (event, matcher, script) row). If a hook was intentionally retired, move " \
         "its row to the \"retired\" list of #{REGISTRY_REL} and land that; if its matcher changed, " \
         "change #{REGISTRY_REL} and land that; if main already did either after " \
         "your merge-base, rebase onto origin/main."
    warn INSTALLER_WHO
  end
  unless stale.empty?
    warn "  #{stale.size} wiring(s) in #{path} use a matcher neither the landed nor this branch's " \
         "registry declares for that script:"
    stale.each { |m| warn "  - #{m}" }
    warn "  Fix: run `scripts/setup-hooks --install` from the MAIN checkout; it replaces a stale " \
         "matcher, touching only that registry script's wiring on that event. If the matcher is " \
         "intended, declare it in #{REGISTRY_REL} and land that."
    warn INSTALLER_WHO
  end
  unless retired.empty?
    warn "  #{retired.size} wiring(s) in #{path} are retired by the landed #{REGISTRY_REL} but still wired:"
    retired.each { |m| warn "  - #{m} (retired, still wired)" }
    warn "  Fix: run `scripts/setup-hooks --install` from the MAIN checkout; it unwires exactly each " \
         "retired (event, matcher, script), backing settings.json up first and touching nothing else."
    warn INSTALLER_WHO
  end
  report_pending(pending, $stderr)
  report_pending_retired(pending_retired, $stderr)
end

# ---------------------------------------------------------------------------
# DND-887: a hook is identified by (event, matcher, script), not (event,
# script). Two registry rows for one script on one event with different
# matchers are two wirings; keyed without the matcher, the second collapsed
# into the first, was never installed, and this check could not see it.
#
# Composed with DND-743's landed bar, per ROW: every landed (event, matcher,
# script) row is required, a row only this branch declares is pending, and a
# matcher neither side declares is stale. A branch that CHANGES a landed row's
# matcher cannot lower its own bar with it: the landed matcher stays required
# until the change lands.
#
# Driven through `run`, the entry point the CLI calls, with the landed bar
# injected and a throwaway checkout whose hook script exists, so the cases
# assert exit codes and the named lines without reading any origin.
def matcher_key_cases(check)
  require "tmpdir"
  require "stringio"
  Dir.mktmpdir do |dir|
    script = "ai/hooks/dnd-887-two-matchers.sh"
    FileUtils.mkdir_p(File.join(dir, "ai", "hooks"))
    File.write(File.join(dir, script), "#!/bin/sh\nexit 0\n")
    File.chmod(0o755, File.join(dir, script))
    cmd = File.join(dir, script)
    row = ->(matcher, event = "PreToolUse") { { "event" => event, "matcher" => matcher, "script" => script } }
    # probe(landed rows, branch rows, wired matchers[, event]) -> [exit, all output]
    probe = lambda do |landed, branch, wired, event = "PreToolUse"|
      reg = File.join(dir, "registry.json")
      File.write(reg, JSON.generate({ "hooks" => branch }))
      groups = wired.map do |m|
        g = { "hooks" => [{ "type" => "command", "command" => cmd }] }
        g["matcher"] = m unless m.equal?(:omitted)
        g
      end
      f = File.join(dir, "settings.json")
      File.write(f, JSON.generate({ "hooks" => { event => groups } }))
      o, e = $stdout, $stderr
      buf = StringIO.new
      $stdout = $stderr = buf
      begin
        rc = run(path: f, registry_file: reg, root: dir, dirs: [dir],
                 landed: ->(_r) { [[["fixture landed", "0" * 40]], landed, []] }, newer: ->(_r, _o) {})
      ensure
        $stdout, $stderr = o, e
      end
      [rc, buf.string]
    end
    two = [row.call("Bash"), row.call("Edit|Write")]

    rc, = probe.call(two, two, ["Bash", "Edit|Write"])
    check.call("two same-script rows, different matchers, both wired -> no drift", rc == EXIT_OK)

    # Sabotage: remove one of the two. The OLD keying's install produced exactly
    # this file (the second row collapsed into the first), so this is also the
    # migration case: it must read as drift, naming the missing matcher.
    rc, out = probe.call(two, two, ["Bash"])
    check.call("one of two same-script rows removed -> drift (exit 1)", rc == EXIT_FAIL)
    check.call("the drift line names the missing matcher and script",
               out.include?('"Edit|Write"') && out.include?(script))
    # The drift Fix: names who may run the installer, so a captain that hits it
    # mid-gate reports instead of editing the machine's settings (DND-864 fix3).
    check.call("the drift Fix: says a subagent reports it to its admiral",
               out.include?("reports it to its admiral"))

    rc, out = probe.call(two, two, ["Edit|Write"])
    check.call("the other row removed -> drift naming it",
               rc == EXIT_FAIL && out.include?('"Bash" ->') && !out.include?('"Edit|Write" ->'))

    # A registry script wired under a matcher neither the landed nor the branch
    # registry declares for it is stale wiring -- the signature a live file
    # keeps when two rows were once one combined matcher (DND-840).
    rc, out = probe.call(two, two, ["Bash|Edit|Write"])
    check.call("combined matcher where the registry has two rows -> drift, named stale",
               rc == EXIT_FAIL && out.include?('"Bash|Edit|Write"') && out.include?("stale"))
    rc, out = probe.call(two, two, ["Bash", "Edit|Write", "Other"])
    check.call("the stale-only Fix: says a subagent reports it to its admiral",
               rc == EXIT_FAIL && !out.include?("NOT wired") && out.include?("reports it to its admiral"))
    rc, out = probe.call(two, two, ["Bash", "Edit|Write", "Other"])
    check.call("declared rows wired plus an undeclared matcher -> stale (exit 1)",
               rc == EXIT_FAIL && out.include?('"Other"') && out.include?("stale"))

    # Claude Code treats an omitted matcher, "" and "*" alike (match all), so a
    # registry "" is satisfied by any of the three and none of them is stale.
    all_row = [row.call("", "SessionStart")]
    all_ok = [:omitted, "", "*"].all? { |m| probe.call(all_row, all_row, [m], "SessionStart").first == EXIT_OK }
    check.call("omitted / \"\" / \"*\" matcher all satisfy a registry \"\" row", all_ok)

    # --- composed with the landed bar (DND-743) ---
    # A second matcher row only this branch adds, for a landed (event, script):
    # pending, like any branch-added hook, and named.
    rc, out = probe.call([row.call("Bash")], two, ["Bash"])
    check.call("a branch-added matcher row for a landed script, unwired -> pending, exit 0",
               rc == EXIT_OK && out.include?("pending") && out.include?('"Edit|Write"'))

    # A landed row the branch still declares cannot be rescued by the branch.
    rc, = probe.call(two, [row.call("Bash")], ["Bash"])
    check.call("a landed matcher row the branch drops, unwired -> still drift (exit 1)", rc == EXIT_FAIL)

    # A landed script the branch removes entirely stays required (DND-743).
    rc, = probe.call([row.call("Bash")], [], [])
    check.call("a landed script the branch removes, unwired -> still drift (exit 1)", rc == EXIT_FAIL)

    # A matcher change on the branch. Wired from main (the landed matcher) it
    # passes with the new row pending; wired only the new way, the landed row is
    # drift: a branch that narrows a matcher cannot pass on its own say-so.
    broad  = [row.call("Bash|mcp__notion.*")]
    narrow = [row.call("Bash|mcp__notion-work__API-post-page")]
    rc, out = probe.call(broad, narrow, ["Bash|mcp__notion-work__API-post-page"])
    check.call("matcher change, wired only the NEW way -> drift on the landed row (exit 1)",
               rc == EXIT_FAIL && out.include?('"Bash|mcp__notion.*"'))
    rc, out = probe.call(broad, narrow, ["Bash|mcp__notion.*"])
    check.call("matcher change, wired the LANDED way -> exit 0, new row pending",
               rc == EXIT_OK && out.include?("pending") && out.include?('"Bash|mcp__notion-work__API-post-page"'))
    rc, out = probe.call(broad, narrow, ["Other"])
    check.call("matcher change, wired neither way -> drift on the landed row, and stale",
               rc == EXIT_FAIL && out.include?('"Bash|mcp__notion.*"') && out.include?("stale"))

    # A split: until it lands, the combined landed row is still required.
    split = [row.call("Bash"), row.call("Edit")]
    rc, = probe.call([row.call("Bash|Edit")], split, ["Bash", "Edit"])
    check.call("a landed matcher split in two, only the halves wired -> drift (exit 1)", rc == EXIT_FAIL)
    rc, out = probe.call([row.call("Bash|Edit")], split, ["Bash|Edit"])
    check.call("a landed matcher split in two, landed row wired -> exit 0, halves pending",
               rc == EXIT_OK && out.include?("pending") && out.include?('"Edit"'))

    # Landed is the union over origin/main's tip and the merge-base. A branch
    # cut before main changed a matcher sees both as landed; wired the new way,
    # the old row is drift until the branch rebases (as for a retired hook).
    rc, out = probe.call(broad + narrow, narrow, ["Bash|mcp__notion-work__API-post-page"])
    check.call("landed union holds old + new matcher, branch and live new -> drift naming rebase",
               rc == EXIT_FAIL && out.include?('"Bash|mcp__notion.*"') && out.include?("rebase onto origin/main"))
  end
end

# ---------------------------------------------------------------------------
# DND-1517: retired rows, through `run` with the landed bar injected (rows and
# retirements). The black-box suite covers the origin-backed read; these pin
# the two rules it cannot reach cheaply: a still-required landed row wins over
# a landed retirement of the same row, and a retired wiring is reported once.
def retired_cases(check)
  require "tmpdir"
  Dir.mktmpdir do |dir|
    script = "ai/hooks/dnd-1517-r.sh"
    FileUtils.mkdir_p(File.join(dir, "ai", "hooks"))
    File.write(File.join(dir, script), "#!/bin/sh\nexit 0\n")
    File.chmod(0o755, File.join(dir, script))
    cmd = File.join(dir, script)
    row = ->(matcher) { { "event" => "PostToolUse", "matcher" => matcher, "script" => script } }
    probe = lambda do |landed, landed_retired, branch, wired|
      reg = File.join(dir, "registry.json")
      File.write(reg, JSON.generate(branch))
      groups = wired.map { |m| { "matcher" => m, "hooks" => [{ "type" => "command", "command" => cmd }] } }
      f = File.join(dir, "settings.json")
      File.write(f, JSON.generate({ "hooks" => { "PostToolUse" => groups } }))
      o, e = $stdout, $stderr
      buf = StringIO.new
      $stdout = $stderr = buf
      begin
        rc = run(path: f, registry_file: reg, root: dir, dirs: [dir],
                 landed: ->(_r) { [[["fixture landed", "0" * 40]], landed, landed_retired] }, newer: ->(_r, _o) {})
      ensure
        $stdout, $stderr = o, e
      end
      [rc, buf.string]
    end

    rc, out = probe.call([], [row.call("")], { "hooks" => [] }, [""])
    check.call("retired: landed retirement still wired -> exit 1, named, Fix: setup-hooks --install",
               rc == EXIT_FAIL && out.include?("retired, still wired") && out.include?("setup-hooks --install"))
    rc, = probe.call([], [row.call("")], { "hooks" => [] }, [])
    check.call("retired: landed retirement unwired -> exit 0", rc == EXIT_OK)
    rc, = probe.call([], [row.call("")], { "hooks" => [] }, ["Bash"])
    check.call("retired: the script under a matcher the retirement does not name is not that row -> exit 0",
               rc == EXIT_OK)
    # The landed union holds the row as required (merge-base) AND retired (tip):
    # required wins, so a machine wired from either side is not failed for it.
    rc, out = probe.call([row.call("")], [row.call("")], { "hooks" => [row.call("")] }, [""])
    check.call("retired: a row both required and retired on the landed union -> required wins, exit 0",
               rc == EXIT_OK && !out.include?("retired, still wired"))
    # The script still declared under another matcher: its retired matcher row
    # would also read as stale. It is reported once, as retired.
    rc, out = probe.call([row.call("Bash")], [row.call("")], { "hooks" => [row.call("Bash")] }, ["Bash", ""])
    check.call("retired: a retired wiring of a still-declared script is reported as retired, not also stale",
               rc == EXIT_FAIL && out.include?("retired, still wired") && !out.include?("stale"))
    rc, out = probe.call([], [], { "hooks" => [], "retired" => [row.call("")] }, [""])
    check.call("retired: a branch-only retirement still wired -> exit 0, pending",
               rc == EXIT_OK && out.include?("pending retirement"))
    rc, out = probe.call([], [], { "hooks" => [], "retired" => [{ "event" => "PostToolUse" }] }, [])
    check.call("retired: a malformed branch retired entry -> could not measure (exit 3)",
               rc == EXIT_UNMEASURED && out.include?("retired entry 0"))
  end
end

# ---------------------------------------------------------------------------
# THE AGENT-STASH ENV (DND-775). The registry's `env` section is the settings
# env that activates the agent-stash guard (ai/lib/agent_stash_env.rb explains
# the states). This reports it on its own line and never folds it into the hook
# verdict above: INACTIVE (exit 0, the owner has not run
# `scripts/setup-hooks --install-env`), ACTIVE (exit 0, runtime asserted too),
# PENDING RESTART (exit 0: ACTIVE, except this session's shell snapshot
# predates the install, DND-1036), DRIFT/FAIL (exit 1), or COULD NOT MEASURE
# (exit 3). The overall exit is the worse of the two checks.
#
# AHEAD OF THE PINNED BAR (DND-1570): drift against the pin is retried against a
# NEWER origin/main (Landed.newer_tip); a live env that equals that env exactly is
# named ahead and passes, anything else stays DRIFT, and a newer main whose env
# cannot be read is "could not judge" (the pinned drift stands).
#
# THE BAR IS THE ENV AS LANDED, like the hooks' (DND-743). The expected values
# come from ai/hooks/registry.json at origin/main's tip (ai/lib/landed.rb,
# honouring the harness-gate pin), expanded against the MAIN checkout. The tip,
# not the union: the owner installs from the main checkout after it
# fast-forwards to that tip, and env values must match exactly. A branch can
# therefore neither lower nor rewrite the bar. Deciding INACTIVE needs no bar:
# none of the guard's keys in the settings is a fact about the settings alone,
# so an offline machine that never activated still reads INACTIVE. Keys present
# while the tip has no env section is a FAIL: the guard is live on this machine
# ahead of its landing, the fail-closed outage state.
def landed_env_section(root = REPO_DIR)
  pts, bars = Landed.read_bar(root, REGISTRY_REL) do |text, label, sha|
    data = begin
      JSON.parse(text)
    rescue JSON::ParserError => e
      raise Landed::Unreadable.new([["#{REGISTRY_REL} @ #{label} #{sha[0, 12]}", "not valid JSON (#{e.message.lines.first.to_s.strip})"]])
    end
    [label, data.is_a?(Hash) ? data["env"] : nil]
  end
  tip_label = pts.first&.first
  tip = bars.find { |(label, _)| label == tip_label }
  [Landed.describe([pts.first]), tip ? tip[1] : nil, pts.first&.last]
end

# THE AGENT-BIN ALLOWLIST IS WHAT LANDED (DND-1842). ATHENA_AGENT_BIN is the
# MAIN checkout's ai/agent-bin, machine state that follows the newest landing.
# So the files it may hold are the entries of ai/agent-bin/ in the tree of the
# same landed tip the env bar came from, read from git, never a list in the
# diff under check. A live file the pinned tip lacks is retried against a newer
# origin/main (Landed.newer_tip), like the env and the hook rows (DND-1552,
# DND-1570): when that commit lands every live file, it is named ahead of the
# pinned bar and passes; anything it does not land still fails. A branch's own
# ai/agent-bin/ only feeds the pending note.
#
# The entries of ai/agent-bin/ at commit sha, as base names. An absent
# directory is [] (a measurement: nothing landed there). A failed read raises
# Landed::Unreadable.
def bin_files_at(root, sha, label)
  rel = AgentStashEnv::BIN_REL
  raise Landed::Unreadable.new([[label, "no landed commit to read #{rel}/ at"]]) if sha.to_s.empty?

  out, ok = Landed.git_read(root, "ls-tree", "-z", "--name-only", "--full-tree", sha, "--", "#{rel}/")
  raise Landed::Unreadable.new([[label, "#{sha[0, 12]}: git ls-tree failed for #{rel}/"]]) unless ok

  out.split("\0").reject(&:empty?).map { |p| p.delete_prefix("#{rel}/") }
end

# The landed allowlist as [description, files] for the landed tip sha.
def landed_bin_files(root, sha)
  ["#{AgentStashEnv::BIN_REL}/ @ #{sha.to_s[0, 12]}", bin_files_at(root, sha, "landed #{AgentStashEnv::BIN_REL}/")]
end

# The newer origin/main's allowlist as [description, files], or nil when there
# is no pin or origin's main is the pin. Raises Landed::Unreadable or
# Landed::Mismatch as Landed.newer_tip does.
def newer_bin_files(root)
  tip = Landed.newer_tip(root)
  return nil unless tip

  label, sha = tip
  ["#{AgentStashEnv::BIN_REL}/ @ newer origin/main #{sha[0, 12]}", bin_files_at(root, sha, label)]
end

# The entries of the checkout's own ai/agent-bin/ (the branch under check).
# They only feed the pending note, so an absent directory is []; any other
# read failure raises SystemCallError, which the caller reports as COULD NOT
# MEASURE rather than as "the branch adds nothing".
def branch_bin_files(root)
  Dir.children(File.join(root, AgentStashEnv::BIN_REL))
rescue Errno::ENOENT
  []
end

# The allowlist the live wrapper directory is judged against, as
# [files, bar, ahead, notes]. ahead is the ahead-of-the-pinned-bar line, set
# only when the live directory passes the newer bar in full; the caller prints
# it only after a passing verdict (DND-1599). notes holds the reason it is not
# ahead and the pending line for wrappers the branch adds.
def bin_bar(bin, root, tip_sha, landed_bin:, newer_bin:, branch_bin:)
  bar, files = landed_bin.call(root, tip_sha)
  notes = []
  ahead = nil
  extras = AgentStashEnv.bin_extras(bin, files)
  unless extras.empty?
    begin
      got = newer_bin.call(root)
      if got
        ndesc, nfiles = got
        still = AgentStashEnv.bin_extras(bin, nfiles)
        if still.empty?
          ahead = "agent-bin ahead of the pinned bar — #{bin} holds #{extras.join(', ')}, which #{ndesc} lands, a " \
                  "commit that landed after harness-gate pinned origin/main (not drift)."
          bar = "#{ndesc}, ahead of the pinned bar (#{bar})"
          files = nfiles
        else
          notes << "the live agent-bin is not ahead of the pinned bar either: #{ndesc} does not land #{still.join(', ')}"
        end
      end
    rescue Landed::Unreadable, Landed::Mismatch => e
      notes << "could not read a newer origin/main to tell whether the live agent-bin is ahead of the pinned bar " \
               "(#{e.message}); it is measured against the pinned bar alone"
    end
  end
  pending = (branch_bin.call(root) - files - AgentStashEnv.bin_extras(bin, files)).sort
  unless pending.empty?
    notes << "#{AgentStashEnv::BIN_REL}/ on this branch adds #{pending.join(', ')}: pending (not judged until it " \
             "lands on main and the main checkout fast-forwards)."
  end
  [files, bar, ahead, notes]
end

# THE AGENT PATH LINE IS WHAT LANDED (DND-1861, the DND-1842 class). The
# CLAUDE_ENV_FILE script is the MAIN checkout's ai/agent-env/session-env.sh,
# machine state that follows the newest landing. So the lines it must run are
# the lines that file runs in the tree of the same landed tip the env bar came
# from, read from git, never a constant in the diff under check. A live script
# that does not run exactly those lines is retried against a newer origin/main
# (Landed.newer_tip): when it runs exactly that commit's lines, it is named
# ahead of the pinned bar and passes; anything else still fails. A landed
# script that is missing, unreadable or runs nothing cannot say what the live
# one should run: Landed::Unreadable, so COULD NOT MEASURE, never a pass. The
# branch's own copy of the script is never read.
#
# The lines ai/agent-env/session-env.sh runs at commit sha.
def env_lines_at(root, sha, label)
  rel = AgentStashEnv::ENV_SCRIPT_REL
  raise Landed::Unreadable.new([[label, "no landed commit to read #{rel} at"]]) if sha.to_s.empty?

  text = Landed.file_at(root, sha, rel, label)
  if text.nil?
    raise Landed::Unreadable.new([[label, "#{sha[0, 12]}: #{rel} does not exist, so it cannot say what line the " \
                                          "live script must run"]])
  end
  lines = AgentStashEnv.code_lines(text)
  raise Landed::Unreadable.new([[label, "#{sha[0, 12]}: #{rel} runs no line"]]) if lines.empty?

  lines
end

# The landed lines as [description, lines] for the landed tip sha.
def landed_env_lines(root, sha)
  ["#{AgentStashEnv::ENV_SCRIPT_REL} @ #{sha.to_s[0, 12]}",
   env_lines_at(root, sha, "landed #{AgentStashEnv::ENV_SCRIPT_REL}")]
end

# The newer origin/main's lines as [description, lines], or nil when there is
# no pin or origin's main is the pin. Raises Landed::Unreadable or
# Landed::Mismatch as Landed.newer_tip does.
def newer_env_lines(root)
  tip = Landed.newer_tip(root)
  return nil unless tip

  label, sha = tip
  ["#{AgentStashEnv::ENV_SCRIPT_REL} @ newer origin/main #{sha[0, 12]}", env_lines_at(root, sha, label)]
end

# The lines the live CLAUDE_ENV_FILE script is judged against, as
# [lines, bar, ahead, notes], like bin_bar. ahead is set only when the live
# script runs exactly the newer main's lines; the caller prints it only after
# a passing verdict (DND-1599). A live script that cannot be read is judged
# against the pinned bar, and env_file_problems reports the read failure.
#
# A pinned tip whose script cannot be read (the env landed after the pin, so
# the script did too) is judged against the newer origin/main alone, as the
# env section is (DND-1570). With no newer main, or one that cannot be read
# either, the pinned Landed::Unreadable stands: COULD NOT MEASURE.
def env_line_bar(file, root, tip_sha, landed_lines:, newer_lines:)
  live = live_env_lines(file)
  begin
    bar, lines = landed_lines.call(root, tip_sha)
  rescue Landed::Unreadable => e
    return env_line_newer_only(file, live, root, newer_lines) || raise(e)
  end
  return [lines, bar, nil, []] if live.nil? || AgentStashEnv.same_code?(live, lines)

  begin
    got = newer_lines.call(root)
    return [lines, bar, nil, []] unless got

    ndesc, nlines = got
    unless AgentStashEnv.same_code?(live, nlines)
      return [lines, bar, nil, ["the live #{AgentStashEnv::ENV_FILE} script is not ahead of the pinned bar either: " \
                                "it does not run exactly the line #{ndesc} lands"]]
    end
    [nlines, "#{ndesc}, ahead of the pinned bar (#{bar})", env_line_ahead(file, ndesc), []]
  rescue Landed::Unreadable, Landed::Mismatch => e
    [lines, bar, nil, ["could not read a newer origin/main to tell whether the live #{AgentStashEnv::ENV_FILE} " \
                       "script is ahead of the pinned bar (#{e.message}); it is measured against the pinned bar alone"]]
  end
end

# The code lines of the live script, or nil when it cannot be read.
def live_env_lines(file)
  AgentStashEnv.code_lines(File.read(file))
rescue SystemCallError
  nil
end

def env_line_ahead(file, ndesc)
  "agent PATH line ahead of the pinned bar — #{file} runs the line #{ndesc} lands, a commit that landed after " \
    "harness-gate pinned origin/main (not drift)."
end

# The pinned tip's script could not be read: the newer origin/main's bar as
# [lines, bar, ahead, notes], or nil when there is no newer main or it cannot
# be read either (the caller then re-raises the pinned failure).
def env_line_newer_only(file, live, root, newer_lines)
  got = begin
    newer_lines.call(root)
  rescue Landed::Unreadable, Landed::Mismatch
    nil
  end
  return nil unless got

  ndesc, nlines = got
  bar = "#{ndesc} (the pinned tip's #{AgentStashEnv::ENV_SCRIPT_REL} could not be read)"
  return [nlines, bar, env_line_ahead(file, ndesc), []] if live && AgentStashEnv.same_code?(live, nlines)

  [nlines, bar, nil, ["the pinned tip's #{AgentStashEnv::ENV_SCRIPT_REL} could not be read, so the live " \
                      "#{AgentStashEnv::ENV_FILE} script is measured against #{ndesc} alone"]]
end

# AHEAD OF THE PINNED BAR (DND-1570), the agent-stash env's counterpart of the
# hook rows' (DND-1552). The newer origin/main's env section as
# [description, section], or nil when there is no pin or origin's main is the
# pin (Landed.newer_tip). A newer main with no registry, or one that is not
# valid JSON, raises Landed::Unreadable: a newer bar that cannot be read is
# never an empty one. A newer main whose registry has no env section yields a
# nil section (it declares no env, so no live env is ahead of it).
def newer_env_section(root = REPO_DIR)
  tip = Landed.newer_tip(root)
  return nil unless tip

  label, sha = tip
  where = "#{REGISTRY_REL} @ #{sha[0, 12]}"
  text = Landed.file_at(root, sha, REGISTRY_REL, label)
  raise Landed::Unreadable.new([[label, "#{where} does not exist, so it cannot say what the live env should be"]]) if text.nil?

  data = begin
    JSON.parse(text)
  rescue JSON::ParserError => e
    raise Landed::Unreadable.new([[where, "not valid JSON (#{e.message.lines.first.to_s.strip})"]])
  end
  ["#{REGISTRY_REL} @ newer origin/main #{sha[0, 12]}", data.is_a?(Hash) ? data["env"] : nil]
end

# Does the live env equal the NEWER origin/main's declared env? Returns
# [desc, exp, nil] when it does (exp is that env expanded for main),
# [nil, nil, note] when it does not or the newer bar cannot be read, and
# [nil, nil, nil] when there is no newer origin/main. Only an exact match
# passes: an env equal to neither bar stays drift.
def env_ahead_of_pin(env, main, root, newer_env)
  got = newer_env.call(root)
  return [nil, nil, nil] if got.nil?

  desc, section = got
  return [nil, nil, "the newer origin/main (#{desc}) declares no agent-stash env, so the live env is not ahead of the pinned bar"] if section.nil?

  exp = AgentStashEnv.expected({ "env" => section }, main)
  res = AgentStashEnv.settings_state(env, exp)
  return [desc, exp, nil] if res.state == :active

  why = res.state == :inactive ? "carries none of that env's keys" : "differs (#{res.lines.join('; ')})"
  [nil, nil, "the live env is not ahead of the pinned bar either: against #{desc} it #{why}"]
rescue Landed::Unreadable, Landed::Mismatch => e
  [nil, nil, "could not read a newer origin/main to tell whether the live env is ahead of the pinned bar " \
             "(#{e.message}); it is measured against the pinned bar alone"]
end

# The branch's own registry is never read here: neither the INACTIVE decision
# (a fixed key rule, AgentStashEnv.any_guard_key?) nor the expected values (the
# landed env) comes from the diff under check (critic round 4).
def run_agent_stash_env(path: settings_path, main: nil, root: REPO_DIR,
                        landed_env: ->(r) { landed_env_section(r) },
                        newer_env: ->(r) { newer_env_section(r) },
                        landed_bin: ->(r, sha) { landed_bin_files(r, sha) },
                        newer_bin: ->(r) { newer_bin_files(r) },
                        branch_bin: ->(r) { branch_bin_files(r) },
                        landed_lines: ->(r, sha) { landed_env_lines(r, sha) },
                        newer_lines: ->(r) { newer_env_lines(r) },
                        proc_env: ENV,
                        session_snapshot: ->(now) { AgentStashEnv.session_snapshot(now: now) },
                        now: -> { Time.now }, out: $stdout, err: $stderr)
  tag = "check-hooks-registered: agent-stash env"
  unless File.exist?(path)
    out.puts "#{tag}: no settings file at #{path} — nothing to assert (not this environment). OK."
    return EXIT_OK
  end
  begin
    main ||= main_checkout_dir(root)
  rescue MainCheckoutError => e
    err.puts "#{tag}: COULD NOT MEASURE — this is not a pass."
    main_checkout_lines(e).each { |l| err.puts l }
    return EXIT_UNMEASURED
  end
  settings = JSON.parse(File.read(path))
  env = settings.is_a?(Hash) ? settings["env"] : nil
  unless AgentStashEnv.any_guard_key?(env)
    out.puts "#{tag}: INACTIVE — none of its keys are in #{path} (not activated; the owner activates it after " \
             "it lands with `#{File.join(main, 'scripts/setup-hooks')} --install-env` and a session restart). OK."
    return EXIT_OK
  end

  begin
    bar, section, tip_sha = landed_env.call(root)
  rescue Landed::Unreadable => e
    err.puts "#{tag}: COULD NOT MEASURE — this is not a pass."
    Landed.unreadable_lines("hook registry env", e.probes).each { |l| err.puts l }
    return EXIT_UNMEASURED
  rescue Landed::Mismatch => e
    err.puts "#{tag}: COULD NOT MEASURE — this is not a pass."
    Landed.mismatch_lines(e.local, e.remote, e.source).each { |l| err.puts l }
    return EXIT_UNMEASURED
  end
  ahead_desc = nil
  ahead_note = nil
  ahead_exp = nil
  ahead_desc, ahead_exp, ahead_note = env_ahead_of_pin(env, main, root, newer_env) if section.nil?
  if section.nil? && ahead_desc.nil?
    err.puts "  note: #{ahead_note}" if ahead_note
    err.puts "#{tag}: FAIL — #{path} carries agent-stash keys, but the env has not landed (#{bar}). " \
             "The guard is live ahead of its script: every agent ref update may fail closed."
    err.puts "  Fix: the owner runs `#{File.join(main, 'scripts/setup-hooks')} --remove-env` and restarts " \
             "sessions, then re-installs after the branch lands."
    return EXIT_FAIL
  end
  exp = ahead_exp || AgentStashEnv.expected({ "env" => section }, main)
  res = ahead_desc ? AgentStashEnv::Result.new(:active, [], 0) : AgentStashEnv.settings_state(env, exp)
  if res.state == :inactive
    # A guard trace exists (any_guard_key? above) but none of the landed keys
    # does: a renamed or case-variant key. That is drift, never INACTIVE.
    res = AgentStashEnv::Result.new(:drift, ["#{path} carries agent-stash keys (a hook.agentstash.* / " \
                                             "hook.reference-transaction.* GIT_CONFIG key, ATHENA_AGENT_BIN or " \
                                             "#{AgentStashEnv::INSTALLED_AT}), " \
                                             "but none of the landed env's keys"], 1)
  end
  if res.state == :drift && ahead_desc.nil?
    ahead_desc, ahead_exp, ahead_note = env_ahead_of_pin(env, main, root, newer_env)
    if ahead_desc
      exp = ahead_exp
      res = AgentStashEnv::Result.new(:active, [], 0)
    end
  end
  ahead_line = nil
  if ahead_desc
    bar = "#{ahead_desc}, ahead of the pinned bar (#{bar})"
    # DND-1599: printed only after a passing verdict. Printed first, "ahead"
    # read as the verdict above a runtime FAIL.
    ahead_line = "#{tag}: ahead of the pinned bar — the live env equals the env #{ahead_desc} declares, a " \
                 "commit that landed after harness-gate pinned origin/main; it differs from the pinned bar " \
                 "only by that newer commit (not drift)."
  end
  if res.state == :drift
    err.puts "  note: #{ahead_note}" if ahead_note
    err.puts "#{tag}: DRIFT — #{path} holds part of the agent-stash env, or values that differ from #{bar}:"
    res.lines.each { |l| err.puts "  - #{l}" }
    err.puts "  Fix: the owner re-applies it from the MAIN checkout (fast-forwarded to origin/main): " \
             "`#{File.join(main, 'scripts/setup-hooks')} --remove-env && " \
             "#{File.join(main, 'scripts/setup-hooks')} --install-env`, then restarts sessions. " \
             "An agent reports this; live settings are the owner's machine state."
    shared = AgentStashEnv::SHARED_VARS.select do |k|
      exp[:vars].key?(k) && env.is_a?(Hash) && env.key?(k) && env[k] != exp[:vars][k]
    end
    unless shared.empty?
      # --remove-env keeps a shared key that is not ours, so the line above
      # alone would loop (review, DND-1080).
      err.puts "  Fix: #{shared.join(', ')} holds another value, which --remove-env keeps: the owner removes it " \
               "from the settings env by hand first. Claude Code reads one CLAUDE_ENV_FILE, so the guard cannot " \
               "be active beside another."
    end
    return EXIT_FAIL
  end

  begin
    bin_files, bin_desc, ahead_bin, bin_other = bin_bar(exp[:vars]["ATHENA_AGENT_BIN"].to_s, root, tip_sha,
                                                        landed_bin: landed_bin, newer_bin: newer_bin,
                                                        branch_bin: branch_bin)
  rescue Landed::Unreadable => e
    err.puts "#{tag}: COULD NOT MEASURE — this is not a pass."
    Landed.unreadable_lines("agent-bin allowlist", e.probes).each { |l| err.puts l }
    return EXIT_UNMEASURED
  rescue SystemCallError => e
    err.puts "#{tag}: COULD NOT MEASURE — this is not a pass. A wrapper directory could not be listed " \
             "(#{e.message.lines.first.to_s.strip}), so whether it holds a file that shadows a real command is unknown."
    err.puts "  Fix: make #{exp[:vars]['ATHENA_AGENT_BIN']} and this checkout's #{AgentStashEnv::BIN_REL}/ " \
             "readable (`chmod u+r`), then re-run."
    return EXIT_UNMEASURED
  end
  # DND-1861: the agent PATH line is read as landed. A landed env with no
  # CLAUDE_ENV_FILE needs no line: env_file_problems fails it on its own.
  env_lines = []
  env_desc = nil
  ahead_line_env = nil
  env_other = []
  env_script = exp[:vars][AgentStashEnv::ENV_FILE].to_s
  unless env_script.empty?
    begin
      env_lines, env_desc, ahead_line_env, env_other = env_line_bar(env_script, root, tip_sha,
                                                                    landed_lines: landed_lines,
                                                                    newer_lines: newer_lines)
    rescue Landed::Unreadable => e
      err.puts "#{tag}: COULD NOT MEASURE — this is not a pass. The agent PATH line the " \
               "#{AgentStashEnv::ENV_FILE} script must run could not be read as landed."
      Landed.unreadable_lines("agent PATH line (#{AgentStashEnv::ENV_SCRIPT_REL})", e.probes).each { |l| err.puts l }
      return EXIT_UNMEASURED
    end
  end
  # DND-1599: an ahead line is printed only after a passing verdict.
  late_ahead = [ahead_bin, ahead_line_env].compact
  other_notes = bin_other + env_other
  problems = AgentStashEnv.runtime_problems(env, exp, main: main, bin_files: bin_files, bin_bar: bin_desc,
                                                      env_lines: env_lines, env_bar: env_desc)
  notes, session, path_problem = AgentStashEnv.session_state(exp, proc_env: proc_env)
  problems += session
  if problems.empty? && path_problem.nil?
    out.puts "#{tag}: ACTIVE — settings values match #{bar}; hook script, `git hook list` (agentstash), " \
             "wrapper and CLAUDE_ENV_FILE PATH line verified. OK."
    out.puts "  note: #{ahead_line}" if ahead_line
    (late_ahead + other_notes + notes).each { |n| out.puts "  note: #{n}" }
    return EXIT_OK
  end
  unless problems.empty?
    err.puts "#{tag}: FAIL — the settings values match (active), but:"
    (problems + [path_problem].compact).each { |l| err.puts "  - #{l}" }
    other_notes.each { |n| err.puts "  note: #{n}" }
    return EXIT_FAIL
  end
  code = report_session_path(path_problem, env, tag: tag, main: main, snapshot: session_snapshot, now: now.call,
                                                out: out, err: err)
  out.puts "  note: #{ahead_line}" if ahead_line && code == EXIT_OK
  if code == EXIT_OK
    (late_ahead + other_notes).each { |n| out.puts "  note: #{n}" }
  else
    other_notes.each { |n| err.puts "  note: #{n}" }
  end
  code
rescue JSON::ParserError, SystemCallError => e
  err.puts "#{tag}: COULD NOT MEASURE — #{e.message.lines.first.to_s.strip}. " \
           "Fix: repair the file named above (registry or settings JSON) and re-run; this is not a pass."
  EXIT_UNMEASURED
end

# PENDING RESTART (DND-1036). The settings env is ACTIVE and every runtime
# check passed; the one problem is that this session's first git on PATH is not
# the wrapper. That is a pending restart only if this session's shell snapshot
# was built before the env was installed (ai/lib/agent_stash_env.rb explains
# both times and why the snapshot is "session start"). Either time unreadable
# is COULD NOT MEASURE (exit 3), never pending; a snapshot at or after the
# install is FAIL. Neither time comes from the branch: the stamp is in the live
# settings, the snapshot in this process's ancestry.
def report_session_path(path_problem, env, tag:, main:, snapshot:, now:, out:, err:)
  installed = AgentStashEnv.installed_at(env, now: now)
  snap_time, snap_path = snapshot.call(now)
  if AgentStashEnv.pending_verdict(snap_time, installed) == :pending
    out.puts "#{tag}: PENDING RESTART — settings values match the landed env and the runtime checks pass, but " \
             "this session's shell snapshot #{snap_path} was built #{AgentStashEnv.iso(snap_time)}, before the " \
             "env was installed at #{AgentStashEnv.iso(installed)} (#{AgentStashEnv::INSTALLED_AT}), so its PATH " \
             "predates the wrapper. OK (exit 0): restart this session to load it; a session started after the " \
             "install that still lacks the wrapper is a failure."
    return EXIT_OK
  end
  err.puts "#{tag}: FAIL — the settings values match (active), but:"
  err.puts "  - #{path_problem}"
  err.puts "  - this session's shell snapshot #{snap_path} was built #{AgentStashEnv.iso(snap_time)}, at or after " \
           "the env install at #{AgentStashEnv.iso(installed)}: this is not a pending restart, the " \
           "#{AgentStashEnv::ENV_FILE} PATH line did not take effect."
  EXIT_FAIL
rescue AgentStashEnv::Unmeasured => e
  err.puts "#{tag}: COULD NOT MEASURE — this is not a pass."
  err.puts "  - #{path_problem}"
  err.puts "  - whether that is a pending restart could not be decided: #{e.message}."
  err.puts "  Fix: restart this Claude Code session: a fresh session runs the CLAUDE_ENV_FILE script that puts the " \
           "wrapper first, and ACTIVE " \
           "needs neither time. A process outside any Claude Code session (a tmux or cron shell that inherited " \
           "ATHENA_AGENT_BIN) has no snapshot: unset ATHENA_AGENT_BIN there, or run the check from a session. " \
           "Do not re-stamp an older install to make this read pending: `#{File.join(main, 'scripts/setup-hooks')} " \
           "--remove-env && #{File.join(main, 'scripts/setup-hooks')} --install-env` dates the install NOW, which " \
           "reads every session started since the real install as pending, so it is safe only together with " \
           "restarting every session."
  EXIT_UNMEASURED
end

# The live check's exit from the hook verdict and the agent-stash env verdict
# (DND-775). The header's precedence rule holds across the two: a failure (1)
# either side can see stands whatever the other could not measure (3), so a
# visible failure is never reported as COULD NOT MEASURE. Otherwise the worse.
def combined_exit(hook, env)
  return EXIT_FAIL if [hook, env].include?(EXIT_FAIL)

  [hook, env].max
end

# The agent-stash env cases (DND-775), in-process against a fixture main
# checkout, settings file and CLAUDE_ENV_FILE script. Returns true when all pass.
def agent_stash_env_self_test(check)
  require "fileutils"
  registry = JSON.parse(File.read(REGISTRY))
  # DND-1080: the wrapper reaches the Bash tool's PATH through the
  # CLAUDE_ENV_FILE script, never ~/.zshrc (the shell snapshot ends with
  # Claude Code's own PATH, so a profile PATH change is discarded).
  env_rel = "ai/agent-env/session-env.sh"
  tracked = File.join(REPO_DIR, env_rel)
  # The branch's own script: one line, which puts ATHENA_AGENT_BIN first on
  # PATH. A shape check of this tree's file, never the live bar (DND-1861).
  tracked_lines = File.exist?(tracked) ? AgentStashEnv.code_lines(File.read(tracked)) : []
  check.call("env: the tracked #{env_rel} runs one line, which prepends ATHENA_AGENT_BIN to PATH",
             tracked_lines.size == 1 && tracked_lines.first.include?('PATH="$ATHENA_AGENT_BIN:$PATH"'))
  check.call("env: #{env_rel} is AgentStashEnv::ENV_SCRIPT_REL", AgentStashEnv::ENV_SCRIPT_REL == env_rel)
  # A synthetic line no checker version carries: the bar is whatever landed.
  fx_line = 'PATH="$ATHENA_AGENT_BIN:$PATH"; export PATH # fixture landed line'
  check.call("env: the registry env points CLAUDE_ENV_FILE at {{MAIN}}/#{env_rel}",
             registry.dig("env", "vars", AgentStashEnv::ENV_FILE) == "{{MAIN}}/#{env_rel}")
  profile = File.join(REPO_DIR, "dotfiles", ".zshrc")
  check.call("env: dotfiles/.zshrc no longer carries the dead agent PATH line (it never reached the Bash tool)",
             File.exist?(profile) && !File.read(profile).include?("ATHENA_AGENT_BIN"))
  Dir.mktmpdir("agent-stash-env-selftest") do |dir|
    main = File.join(dir, "main")
    FileUtils.mkdir_p([File.join(main, "ai", "git-hooks"), File.join(main, "ai", "agent-bin"),
                       File.join(main, "ai", "agent-env")])
    FileUtils.cp(File.join(REPO_DIR, AgentStashEnv::HOOK_REL), File.join(main, AgentStashEnv::HOOK_REL))
    FileUtils.cp(File.join(REPO_DIR, "ai", "agent-bin", "git"), File.join(main, "ai", "agent-bin", "git"))
    env_file = File.join(main, env_rel)
    File.write(env_file, "# fixture\n#{fx_line}\n")
    reg = File.join(dir, "registry.json")
    File.write(reg, JSON.generate(registry))
    exp = AgentStashEnv.expected(registry, main)
    full = { "GIT_CONFIG_COUNT" => exp[:pairs].size.to_s }
    exp[:pairs].each_with_index { |(k, v), i| full["GIT_CONFIG_KEY_#{i}"] = k; full["GIT_CONFIG_VALUE_#{i}"] = v }
    full.merge!(exp[:vars])
    settings = File.join(dir, "settings.json")
    landed = ->(_root) { ["fixture landed", registry["env"]] }
    # The live /proc walk is never reached from here: every case injects the
    # session's snapshot time (DND-1036), so the session running the suite is
    # never read.
    now = Time.utc(2026, 9, 28, 8, 0, 0)
    snap_old = ->(_now) { [Time.utc(2026, 9, 26, 19, 31, 9), "/h/.claude/shell-snapshots/snapshot-zsh-1-a.sh"] }
    # Hermetic by default: no pin, so no newer origin/main (DND-1570).
    # DND-1842: the agent-bin allowlist is injected as landed; the default
    # fixture bar lands git, gh and glab, with no newer main and no branch adds.
