#!/usr/bin/ruby
# frozen_string_literal: true

# harness-eval — the deterministic core of the harness self-improvement eval
# loop. It replays a curated corpus of PAST regressions (ai/eval/fixtures/) and
# asserts that each one is still CAUGHT by its guard — the "did a harness change
# help / did it regress?" substrate the rest of the program depends on.
#
# Deterministic ONLY: every case asserts a checkable artifact (a guard fires or
# does not fire on a fixture; a guard's health check + self-test pass). There is
# NO model in the loop and NO free-form replay — the LLM-judged tier is a
# separate concern (B4 critics). Seeded by ai/bin/check-generic-skills (a
# one-case micro-eval) and the shipwright journal's labeled incidents.
#
# A case is DATA: ai/eval/fixtures/<NN-name>/meta (key=value) plus, for stdin
# cases, an input file. Modes:
#   hook-stdin    pipe <input> into ai/hooks/<guard>.sh; verdict "fires" iff the
#                 hook emits a PreToolUse deny; compared to expect (fires|clean).
#   guard-health  run ai/bin/<guard> AND ai/bin/<guard> --self-test; the case
#                 passes iff both exit 0 (the guard both catches its regression,
#                 via its self-test, and passes clean on the current tree).
#                 It credits any bin that exits 0, so it cannot tell a no-op
#                 tool from a real one; bin-stdin can.
#   bin-stdin     run ai/bin/<guard> [args...] with <input> on stdin, a fresh
#                 HOME, cwd = the repo root, and a 30 s process-group cap
#                 (DND-1427). Exit 0 = clean; exit 1 with `Fix:` in stdout or
#                 stderr = fires; anything else (bin missing or not
#                 executable, input missing, bad meta, another exit, a signal,
#                 the cap) = error, which matches NEITHER expectation: a
#                 missing tool never reads as clean. Meta: guard= must match
#                 GUARD_NAME_RE (a bare ai/bin name; a bad one executes
#                 nothing), expect=fires|clean, input=<file in the case dir>,
#                 optional args=<JSON array of strings>.
#
# Deliberately gem-free (stdlib only); run with bare `ruby`.
#
# Usage:
#   ai/bin/harness-eval             run the corpus; exit 0 iff every case matches
#   ai/bin/harness-eval --self-test verify the runner's own mechanics
#
# Adding a case: create ai/eval/fixtures/<NN-name>/meta with regression=, guard=,
# mode=, expect= (and input= for hook-stdin and bin-stdin; optional args= for
# bin-stdin), plus the input file. Keep it
# deterministic — assert a guard verdict, never a model judgement.

require "json"
require "open3"
require "fileutils"
require "tmpdir"
require_relative "../lib/bounded_command"

AI_DIR       = File.expand_path("..", __dir__)
REPO_ROOT    = File.expand_path("..", AI_DIR)
FIXTURES_DIR = File.join(AI_DIR, "eval", "fixtures")
SCORECARD    = File.join(AI_DIR, "eval", "scorecard.json")
BASELINE     = File.join(AI_DIR, "eval", "baseline.json")
HOOKS_DIR    = File.join(AI_DIR, "hooks")
BIN_DIR      = File.join(AI_DIR, "bin")

def parse_meta(path)
  meta = {}
  File.foreach(path) do |line|
    line = line.strip
    next if line.empty? || line.start_with?("#")
    k, _, v = line.partition("=")
    meta[k.strip] = v.strip
  end
  meta
end

# Run a hook with the fixture JSON on stdin; return true iff it denied.
# Invoke with an ISOLATED HOME so any per-invocation hook state (e.g.
# pronoun-guard's ${HOME}/.claude/.pronoun-checked dedup markers, which make an
# identical re-send pass) is fresh every run — otherwise a "fires" case would
# only fire the first time and the eval would be non-deterministic.
def hook_fires?(guard, input_path)
  hook = File.join(HOOKS_DIR, "#{guard}.sh")
  return [false, "hook not found: #{hook}"] unless File.executable?(hook)

  input = File.read(input_path)
  Dir.mktmpdir("harness-eval-home-") do |home|
    env = { "HOME" => home }
    out, _err, _st = Open3.capture3(env, hook, stdin_data: input)
    return [out.include?('"permissionDecision":"deny"'), out]
  end
rescue StandardError => e
  [false, "hook error: #{e.message}"]
end

# Run a bin guard's real check AND its self-test; both must exit 0.
def guard_healthy?(guard)
  bin = File.join(BIN_DIR, guard)
  return [false, "bin not found: #{bin}"] unless File.executable?(bin)

  _o1, _e1, st1 = Open3.capture3(bin)
  _o2, _e2, st2 = Open3.capture3(bin, "--self-test")
  ok = st1.success? && st2.success?
  [ok, "real=#{st1.exitstatus} self-test=#{st2.exitstatus}"]
rescue StandardError => e
  [false, "guard error: #{e.message}"]
end

# --- bin-stdin (DND-1427) ----------------------------------------------------
# Pipe a fixture into ai/bin/<guard> and read its verdict from the exit: 0 is
# clean, 1 with a `Fix:` line is fires, anything else is an error that matches
# no expectation. A missing tool must never read as clean.

# The cap only stops a hang; it is never a verdict threshold.
BIN_STDIN_TIMEOUT_S = 30
# A bare ai/bin name: no `/`, no `..`, so a fixture cannot name a path outside
# the bin dir (`../hooks/x`, `/bin/sh`).
GUARD_NAME_RE = /\A[a-z0-9][a-z0-9-]{1,62}\z/
BIN_STDIN_EXPECTS = %w[fires clean].freeze

# Domain (pure): the verdict table. -> [verdict, detail]. The checks run from
# the most to the least decisive, so a timeout or signal is never read from
# whatever output the tool left behind, and no outcome at all is an error.
def bin_stdin_verdict(exit_status:, termsig:, timed_out:, output:, precheck_error:,
                      timeout_s: BIN_STDIN_TIMEOUT_S)
  return ["error", precheck_error] if precheck_error
  return ["error", "timeout #{timeout_s}s"] if timed_out
  return ["error", "signal #{termsig}"] if termsig
  return ["error", "no exit status"] if exit_status.nil?
  return ["clean", "exit 0"] if exit_status.zero?
  return ["fires", "exit 1 with Fix:"] if exit_status == 1 && output.to_s.include?("Fix:")
  return ["error", "exit 1 without Fix:"] if exit_status == 1

  ["error", "exit #{exit_status}"]
end

# Parse the optional args= key. -> [array, nil] or [nil, reason].
def bin_stdin_args(raw)
  return [[], nil] if raw.nil? || raw.empty?

  args = JSON.parse(raw)
  return [nil, "bad args: not a JSON array of strings: #{raw}"] unless args.is_a?(Array) && args.all?(String)

  [args, nil]
rescue JSON::ParserError
  [nil, "bad args: not JSON: #{raw}"]
end

# Domain (pure but for one file-existence check): -> nil, or an error detail.
def validate_bin_stdin_meta(meta, case_dir)
  guard = meta["guard"].to_s
  return "bad guard name: #{guard.inspect}" unless GUARD_NAME_RE.match?(guard)
  return "bad expect: #{meta['expect'].inspect}" unless BIN_STDIN_EXPECTS.include?(meta["expect"])

  _args, reason = bin_stdin_args(meta["args"])
  return reason if reason

  input = meta["input"].to_s
  path = File.join(case_dir, input)
  return "input missing: #{path}" if input.empty? || !File.file?(path)

  nil
end

# Side Effects: the one exec site. Runs bin_dir/<guard> with argv (no shell),
# stdin = the input file, a fresh HOME per run (a tool's HOME state must not
# carry between cases), cwd = the repo root, and a process-group bound.
# -> the raw outcome bin_stdin_verdict classifies.
def bin_stdin_run(guard, input_path, args, bin_dir:, timeout:)
  bin = File.join(bin_dir, guard)
  return { precheck_error: "bin not found: #{bin}" } unless File.file?(bin)
  return { precheck_error: "not executable: #{bin}" } unless File.executable?(bin)

  Dir.mktmpdir("harness-eval-home-") do |home|
    r = BoundedCommand.run([bin, *args], timeout: timeout, chdir: REPO_ROOT,
                                         env: { "HOME" => home }, stdin: input_path)
    { exit_status: r.exitstatus, termsig: r.termsig, timed_out: r.timed_out,
      output: "#{r.out}#{r.err}" }
  end
end

# Manager: validate, run, classify. Nothing executes on invalid meta.
def evaluate_bin_stdin(dir, meta, base, bin_dir:, timeout:)
  invalid = validate_bin_stdin_meta(meta, dir)
  outcome = if invalid
              { precheck_error: invalid }
            else
              args, _reason = bin_stdin_args(meta["args"])
              bin_stdin_run(meta["guard"], File.join(dir, meta["input"]), args, bin_dir: bin_dir, timeout: timeout)
            end
  raw = { exit_status: nil, termsig: nil, timed_out: false, output: "", precheck_error: nil }.merge(outcome)
  verdict, detail = bin_stdin_verdict(**raw, timeout_s: timeout)
  output = raw[:output].to_s.strip
  detail = "#{detail} -- #{output}" unless output.empty?
  base.merge(verdict: verdict, pass: (verdict != "error" && verdict == meta["expect"]), detail: detail[0, 200])
end

# Evaluate one case dir -> {name, regression, guard, expect, verdict, pass, detail}
# bin_dir and bin_stdin_timeout are seams for the self-test; production uses
# ai/bin and the 30 s cap.
def evaluate(dir, bin_dir: BIN_DIR, bin_stdin_timeout: BIN_STDIN_TIMEOUT_S)
  meta = parse_meta(File.join(dir, "meta"))
  name = File.basename(dir)
  mode = meta["mode"]
  expect = meta["expect"]
  base = { name: name, regression: meta["regression"], guard: meta["guard"], expect: expect }

  case mode
  when "hook-stdin"
    fired, detail = hook_fires?(meta["guard"], File.join(dir, meta["input"]))
    verdict = fired ? "fires" : "clean"
    base.merge(verdict: verdict, pass: (verdict == expect), detail: detail[0, 200])
  when "guard-health"
    healthy, detail = guard_healthy?(meta["guard"])
    verdict = healthy ? "pass" : "fail"
    base.merge(verdict: verdict, pass: (healthy && expect == "pass"), detail: detail)
  when "bin-stdin"
    evaluate_bin_stdin(dir, meta, base, bin_dir: bin_dir, timeout: bin_stdin_timeout)
  else
    base.merge(verdict: "error", pass: false, detail: "unknown mode: #{mode.inspect}")
  end
end

def run_corpus(fixtures_dir, write_scorecard:, baseline_path: BASELINE)
  dirs = Dir.glob(File.join(fixtures_dir, "*")).select { |d| File.file?(File.join(d, "meta")) }.sort
  if dirs.empty?
    warn "harness-eval: FAILED — no fixtures with a meta file under #{fixtures_dir}"
    warn "  Fix: add ai/eval/fixtures/<NN-name>/meta (regression=, guard=, mode=, expect=)."
    return 1
  end

  results = dirs.map { |d| evaluate(d) }
  passed = results.count { |r| r[:pass] }
  total  = results.size

  results.each do |r|
    mark = r[:pass] ? "PASS" : "FAIL"
    puts "#{mark}  #{r[:name]}  [guard=#{r[:guard]} expect=#{r[:expect]} got=#{r[:verdict]}]"
    puts "      #{r[:regression]}" if r[:regression]
  end
  puts "harness-eval: #{passed}/#{total} cases pass"

  if write_scorecard
    FileUtils.mkdir_p(File.dirname(SCORECARD))
    File.write(SCORECARD, JSON.pretty_generate(
      "generated" => Time.now.utc.iso8601,
      "passed" => passed, "total" => total,
      "cases" => results.map { |r| r.transform_keys(&:to_s) }
    ))
  end

  # Baseline diff (A2): compare this run to the committed known-good baseline.
  # A REGRESSION (a case the baseline passes but this run fails) is the fail
  # signal — never trade a known regression for an unproven gain. A newly-fixed
  # case is an improvement (reported, not a failure).
  baseline = load_baseline(baseline_path)
  if baseline
    now = results.each_with_object({}) { |r, h| h[r[:name]] = r[:pass] }
    regressed = baseline.select { |name, was| was && now[name] == false }.keys
    fixed     = baseline.select { |name, was| !was && now[name] == true }.keys
    new_cases = now.keys - baseline.keys
    puts ""
    puts "baseline diff: #{regressed.size} regressed, #{fixed.size} fixed, #{new_cases.size} new case(s)"
    fixed.each { |n| puts "  + fixed: #{n}" }
    new_cases.each { |n| puts "  · new:   #{n} (#{now[n] ? 'pass' : 'fail'})" }
    unless regressed.empty?
      warn "harness-eval: FAILED — regression vs baseline:"
      regressed.each { |n| warn "  - #{n}: baseline pass -> now fail" }
      warn "  Fix: a harness change broke a case the baseline caught. Restore the guard/behavior; " \
           "do NOT run --update-baseline to hide it. Update the baseline only for an intended change."
      return 1
    end
    return 0
  end

  failures = results.reject { |r| r[:pass] }
  return 0 if failures.empty?

  warn ""
  warn "harness-eval: FAILED — #{failures.size} case(s) did not match expectation:"
  failures.each { |r| warn "  - #{r[:name]}: expected #{r[:expect]}, got #{r[:verdict]} (#{r[:detail]})" }
  warn "  Fix: a regression is no longer caught by its guard (or a guard now false-fires). " \
       "Restore the guard so the case matches its expected verdict; never weaken a guard to go green."
  1
end

def load_baseline(path = BASELINE)
  return nil unless path && File.file?(path)
  data = JSON.parse(File.read(path))
  data["cases"].each_with_object({}) { |c, h| h[c["name"]] = c["pass"] }
rescue StandardError => e
  warn "harness-eval: Note: baseline unreadable (#{e.message}); running without baseline diff."
  nil
end

def update_baseline(fixtures_dir)
  dirs = Dir.glob(File.join(fixtures_dir, "*")).select { |d| File.file?(File.join(d, "meta")) }.sort
  results = dirs.map { |d| evaluate(d) }
  FileUtils.mkdir_p(File.dirname(BASELINE))
  File.write(BASELINE, JSON.pretty_generate(
    "generated" => Time.now.utc.iso8601,
    "cases" => results.map { |r| { "name" => r[:name], "pass" => r[:pass] } }
  ))
  puts "harness-eval: baseline written to #{BASELINE} (#{results.count { |r| r[:pass] }}/#{results.size} pass)"
  0
end

require "time"
require_relative "../lib/strict_argv"

# Every argument must be a declared flag (DND-526): a typo of --update-baseline
# used to fall through to the default corpus run, which writes the scorecard.
CLI_SPEC = { "--self-test" => :switch, "--update-baseline" => :switch }.freeze

# -> [opts, nil] on success, [nil, reason] on a usage error.
def parse_cli(argv)
  opts = StrictArgv.parse(argv, CLI_SPEC)
  if opts["--self-test"] && opts["--update-baseline"]
    return [nil, "--self-test and --update-baseline are separate modes; pass one"]
  end

  [opts, nil]
rescue StrictArgv::UsageError => e
  [nil, e.message]
end

def mode_for(opts)
  return :self_test if opts["--self-test"]
  return :update_baseline if opts["--update-baseline"]

  :corpus
end

# bin-stdin self-test (DND-1427): the pure verdict table (V), meta validation
# (M), and the real spawn over stub bins in a tmpdir (B). -> [failure, ...].
def self_test_bin_stdin(dir)
  fails = []
  expect_eq = lambda do |label, got, want|
    fails << "#{label}: expected #{want.inspect}, got #{got.inspect}" unless got == want
  end

  # V: bin_stdin_verdict, pure.
  v = ->(**kw) { bin_stdin_verdict(**{ exit_status: nil, termsig: nil, timed_out: false, output: "", precheck_error: nil }.merge(kw)) }
  expect_eq.call("V-1 exit 0", v.call(exit_status: 0)[0], "clean")
  expect_eq.call("V-1b exit 0 with Fix: is still clean", v.call(exit_status: 0, output: "Fix: x")[0], "clean")
  expect_eq.call("V-2 exit 1 with Fix:", v.call(exit_status: 1, output: "bad\n  Fix: do y")[0], "fires")
  expect_eq.call("V-3 exit 1 without Fix:", v.call(exit_status: 1, output: "bad"), ["error", "exit 1 without Fix:"])
  expect_eq.call("V-4 exit 2 with Fix: is still an error", v.call(exit_status: 2, output: "Fix: x")[0], "error")
  expect_eq.call("V-4 exit 2 detail", v.call(exit_status: 2)[1], "exit 2")
  expect_eq.call("V-4 exit 127 detail", v.call(exit_status: 127)[1], "exit 127")
  expect_eq.call("V-5 signal", v.call(exit_status: 137, termsig: 9), ["error", "signal 9"])
  expect_eq.call("V-6 timeout", v.call(timed_out: true, timeout_s: 30), ["error", "timeout 30s"])
  expect_eq.call("V-6b timeout outranks output", v.call(timed_out: true, timeout_s: 30, output: "Fix: y")[0], "error")
  expect_eq.call("V-7 precheck carried", v.call(precheck_error: "bin not found: /x", exit_status: 0),
                 ["error", "bin not found: /x"])
  expect_eq.call("V-8 no outcome at all is an error, never clean", v.call[0], "error")

  # M: validate_bin_stdin_meta.
  case_dir = File.join(dir, "case")
  FileUtils.mkdir_p(case_dir)
  File.write(File.join(case_dir, "in.txt"), "x\n")
  good = { "guard" => "foo-check", "mode" => "bin-stdin", "expect" => "fires", "input" => "in.txt" }
  m = ->(over) { validate_bin_stdin_meta(good.merge(over), case_dir).to_s }
  expect_eq.call("M-1 valid", validate_bin_stdin_meta(good, case_dir), nil)
  expect_eq.call("M-1b valid with args", validate_bin_stdin_meta(good.merge("args" => '["--strict"]'), case_dir), nil)
  { "M-2 path in guard" => ["guard", "../hooks/x", "bad guard name"],
    "M-3 absolute guard" => ["guard", "/bin/sh", "bad guard name"],
    "M-7 empty guard" => ["guard", "", "bad guard name"],
    "M-7b uppercase guard" => ["guard", "Foo", "bad guard name"],
    "M-4 bad expect" => ["expect", "pass", "bad expect"],
    "M-5 input missing" => ["input", "nope.txt", "input missing"],
    "M-5b input blank" => ["input", "", "input missing"],
    "M-6 args object" => ["args", '{"a":1}', "bad args"],
    "M-6b args non-string" => ["args", "[1]", "bad args"],
    "M-6c args not JSON" => ["args", "--strict", "bad args"] }.each do |label, (key, val, needle)|
    got = m.call(key => val)
    fails << "#{label}: expected an error naming #{needle.inspect}, got #{got.inspect}" unless got.include?(needle)
  end
  no_input = good.reject { |k, _| k == "input" }
  fails << "M-5c no input key must be an error" unless validate_bin_stdin_meta(no_input, case_dir).to_s.include?("input missing")

  # B: evaluate with stub bins and a real spawn.
  bin_dir = File.join(dir, "bin")
  FileUtils.mkdir_p(bin_dir)
  stub = lambda do |name, body|
    path = File.join(bin_dir, name)
    File.write(path, "#!/bin/sh\n#{body}\n")
    File.chmod(0o755, path)
  end
  stub.call("fires-bin", "cat >/dev/null; echo 'x Fix: y' >&2; exit 1")
  stub.call("clean-bin", "cat >/dev/null; exit 0")
  stub.call("mark-bin", "if grep -q MARK; then echo 'found MARK. Fix: remove it' >&2; exit 1; fi; exit 0")
  stub.call("args-bin", "cat >/dev/null; if [ \"$1\" = --strict ]; then echo 'Fix: strict' >&2; exit 1; fi; exit 0")
  stub.call("home-bin", "if [ -e \"$HOME/marker\" ]; then echo 'Fix: HOME leaked' >&2; exit 1; fi; touch \"$HOME/marker\"; exit 0")
  stub.call("hang-bin", "echo $$ > \"#{File.join(dir, 'hang.pid')}\"; exec sleep 60")
  stub.call("noexec-bin", "exit 0")
  File.chmod(0o644, File.join(bin_dir, "noexec-bin"))
  escape_marker = File.join(dir, "escaped")
  File.write(File.join(dir, "x"), "#!/bin/sh\ntouch '#{escape_marker}'\nexit 0\n")
  File.chmod(0o755, File.join(dir, "x"))

  n = 0
  # opts: input: (the fixture's stdin), timeout: (the injected cap).
  run_case = lambda do |meta, opts = {}|
    input = opts.fetch(:input, "hello\n")
    timeout = opts.fetch(:timeout, BIN_STDIN_TIMEOUT_S)
    n += 1
    cdir = File.join(dir, "cases", format("%02d", n))
    FileUtils.mkdir_p(cdir)
    File.write(File.join(cdir, "in.txt"), input)
    File.write(File.join(cdir, "meta"),
               { "regression" => "r", "mode" => "bin-stdin", "input" => "in.txt" }.merge(meta)
                 .map { |k, val| "#{k}=#{val}" }.join("\n") + "\n")
    evaluate(cdir, bin_dir: bin_dir, bin_stdin_timeout: timeout)
  end
  check = lambda do |label, r, verdict, pass, detail = nil|
    ok = r[:verdict] == verdict && r[:pass] == pass && (detail.nil? || r[:detail].to_s.include?(detail))
    fails << "#{label}: expected verdict=#{verdict} pass=#{pass} detail~#{detail.inspect}, got #{r.inspect}" unless ok
  end

  check.call("B-1 fires matches", run_case.call("guard" => "fires-bin", "expect" => "fires"), "fires", true)
  check.call("B-2 clean matches", run_case.call("guard" => "clean-bin", "expect" => "clean"), "clean", true)
  check.call("B-3 no-op tool on a fires case", run_case.call("guard" => "clean-bin", "expect" => "fires"), "clean", false)
  check.call("B-4 always-deny on a clean case", run_case.call("guard" => "fires-bin", "expect" => "clean"), "fires", false)
  check.call("B-5 missing bin, expect=clean", run_case.call("guard" => "absent-bin", "expect" => "clean"),
             "error", false, "bin not found: #{File.join(bin_dir, 'absent-bin')}")
  check.call("B-6 missing bin, expect=fires", run_case.call("guard" => "absent-bin", "expect" => "fires"),
             "error", false, "bin not found")
  check.call("B-6b not executable", run_case.call("guard" => "noexec-bin", "expect" => "clean"),
             "error", false, "not executable")
  check.call("B-7 stdin with MARK", run_case.call({ "guard" => "mark-bin", "expect" => "fires" }, input: "a MARK b\n"),
             "fires", true)
  check.call("B-7 stdin without MARK", run_case.call({ "guard" => "mark-bin", "expect" => "clean" }, input: "a b\n"),
             "clean", true)
  check.call("B-8 args passed as argv", run_case.call("guard" => "args-bin", "expect" => "fires", "args" => '["--strict"]'),
             "fires", true)
  check.call("B-8 no args by default", run_case.call("guard" => "args-bin", "expect" => "clean"), "clean", true)
  2.times do |i|
    check.call("B-9 isolated HOME run #{i + 1}", run_case.call("guard" => "home-bin", "expect" => "clean"), "clean", true)
  end
  check.call("B-10 a hang is capped", run_case.call({ "guard" => "hang-bin", "expect" => "clean" }, timeout: 1),
             "error", false, "timeout 1s")
  hang_pid = File.file?(File.join(dir, "hang.pid")) ? File.read(File.join(dir, "hang.pid")).to_i : 0
  if hang_pid.positive?
    begin
      Process.kill(0, hang_pid)
      stat = File.read("/proc/#{hang_pid}/stat") rescue "" # rubocop:disable Style/RescueModifier
      fails << "B-10 the hung child #{hang_pid} was not reaped" unless stat.split(") ").last.to_s.start_with?("Z")
    rescue Errno::ESRCH
      nil
    end
  else
    fails << "B-10 the hung child never started (no pid file)"
  end
  check.call("B-11 bad guard name executes nothing", run_case.call("guard" => "../x", "expect" => "clean"),
             "error", false, "bad guard name")
  fails << "B-11 ../x was executed (marker exists)" if File.exist?(escape_marker)
  check.call("B-12 missing input executes nothing", run_case.call("guard" => "home-bin", "expect" => "clean", "input" => "gone.txt"),
             "error", false, "input missing")
  fails
end

def run_self_test
  dir = File.join(Dir.tmpdir, "harness-eval-selftest-#{Process.pid}")
  FileUtils.mkdir_p(dir)
  ok = true
  begin
    # Synthetic guard-health cases pointing at a known-good and known-bad bin via
    # a stubbed evaluate: here we exercise the pass/fail accounting directly.
    good = { name: "good", pass: true }
    bad  = { name: "bad", pass: false }
    results = [good, bad]
    passed = results.count { |r| r[:pass] }
    unless passed == 1 && results.size == 2
      warn "self-test: FAIL — accounting wrong (#{passed}/2)"; ok = false
    end
    # meta parser round-trips
    m = File.join(dir, "meta")
    File.write(m, "regression=x\nguard=g\nmode=guard-health\nexpect=pass\n")
    parsed = parse_meta(m)
    unless parsed["guard"] == "g" && parsed["expect"] == "pass" && parsed["mode"] == "guard-health"
      warn "self-test: FAIL — meta parse: #{parsed.inspect}"; ok = false
    end
    # a failing case must make the corpus fail: run over a synthetic fixture set
    fx = File.join(dir, "fixtures")
    FileUtils.mkdir_p(File.join(fx, "01-bad"))
    File.write(File.join(fx, "01-bad", "meta"), "regression=r\nguard=nope\nmode=guard-health\nexpect=pass\n")
    code = run_corpus(fx, write_scorecard: false, baseline_path: nil)
    unless code == 1
      warn "self-test: FAIL — a bogus guard case should fail the corpus (got #{code})"; ok = false
    end
    # argv (DND-526): every argument must be a declared flag. In-process only —
    # a black-box typo on the old parser would run the corpus and WRITE the
    # scorecard (or the baseline) into this checkout.
    { %w[--update-baselin] => "--update-baselin", %w[--self-tset] => "--self-tset",
      %w[stray] => "stray", %w[--update-baseline=1] => "--update-baseline=",
      %w[--update-baseline --update-baseline] => "--update-baseline",
      %w[--self-test --update-baseline] => "--update-baseline",
      %w[--update-baseline --self-test] => "--update-baseline" }.each do |args, named|
      _o, reason = parse_cli(args)
      next if reason.to_s.include?(named)

      warn "self-test: FAIL — parse_cli(#{args.inspect}) must be a usage error naming #{named}, got #{reason.inspect}"
      ok = false
    end
    { [] => :corpus, %w[--update-baseline] => :update_baseline, %w[--self-test] => :self_test }.each do |args, want|
      o, reason = parse_cli(args)
      next if reason.nil? && mode_for(o) == want

      warn "self-test: FAIL — parse_cli(#{args.inspect}) must accept and select #{want}, got #{reason.inspect}"
      ok = false
    end
    failures = self_test_bin_stdin(File.join(dir, "bin-stdin"))
    failures.each { |f| warn "self-test: FAIL — bin-stdin #{f}" }
    ok = false unless failures.empty?
  ensure
    FileUtils.rm_rf(dir)
  end
  if ok
    puts "harness-eval: self-test OK"
    0
  else
    warn "harness-eval: self-test FAILED"
    warn "  Fix: the runner's accounting/parse/exit logic is broken — a failing case must exit 1."
    1
  end
end

if ARGV.include?("--help") || ARGV.include?("-h")
  puts <<~TXT
    Usage:
      ai/bin/harness-eval                    run the regression corpus and compare
                                             against ai/eval/baseline.json; writes
                                             ai/eval/scorecard.json
      ai/bin/harness-eval --update-baseline  rewrite the baseline from this run
                                             (never to hide a regression)
      ai/bin/harness-eval --self-test        deterministic suite (no model)
      ai/bin/harness-eval --help             this text
  TXT
  exit 0
end
opts, reason = parse_cli(ARGV)
if reason
  warn "harness-eval: usage error — #{reason}."
  warn "  Fix: re-run with only the flags `ai/bin/harness-eval --help` lists: no " \
       "argument (run the corpus), --update-baseline, or --self-test. An " \
       "unrecognised argument is refused, not ignored: ignoring it would run " \
       "the corpus and write ai/eval/scorecard.json."
  exit 2
end
exit(
  case mode_for(opts)
  when :self_test then run_self_test
  when :update_baseline then update_baseline(FIXTURES_DIR)
  else run_corpus(FIXTURES_DIR, write_scorecard: true)
  end
)
