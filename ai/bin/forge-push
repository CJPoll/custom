#!/usr/bin/env bash
#
# forge-push — push to a remote through Athena's forge wrapper for that
# remote's host, never with plain git and never with a wrapper named by hand
# (DND-1995).
#
# Every unattended push (the ~/dev/custom no-CI landing, the shipwright and
# lead-time lane sync-up, the lead-time product lane, wt under WT_AGENT_PUSH)
# used to name `gh-athena git push`. After the GitLab cutover (DND-1947) origin
# is git@gitlab.com:..., and a push that names gh-athena no longer reaches it
# as Athena. This tool asks ai/bin/forge-git for the route (`forge-git --route
# <url>`), so the host table exists once and a read and a push of the same
# remote always take the same route. (The cron runners' athena_fetch_origin_main,
# in scripts/athena-*-run.sh, still holds its own copy of the table for its
# fetch; reported in DND-1995, since the coordinator owns those scripts.)
#
#   git@github.com:*  https://github.com/*   -> ai/bin/gh-athena git -C <dir> push ...
#   git@gitlab.com:*  https://gitlab.com/*   -> ai/bin/glab-athena git -C <dir> push ...
#   anything else                            -> REFUSED, exit 3 (ssh://, an
#        ~/.ssh/config host alias, another host, AND a local path: a push has
#        no plain-git route, because the wrappers hold the push refusals --
#        RED MAIN, NO RECEIPT, HTTPS-only, identity -- in
#        ai/lib/forge-git-passthrough.sh, and plain git would skip them all).
#
# The remote is the one git push itself reaches: the first argument that is
# not an option, else branch.<current>.pushRemote, remote.pushDefault,
# branch.<current>.remote, then origin. A configured remote routes by EVERY
# push URL it has (`git remote get-url --push --all`), so a pushurl override
# is routed by what the push really reaches; push URLs on two forges are
# refused. Any other word is taken as the URL itself, as git takes it.
#
# The push arguments are read with git push's own grammar (fg_push_argv, the
# wrappers' shared passthrough, DND-1843), so the routed word is the one git
# pushes to. A URL literal is routed after git's pushInsteadOf / insteadOf
# rewrite. Refused before any push (exit 64): --repo (it names the remote away
# from the positional word), and any argument git push itself would reject.
#
# Exit codes: the wrapper's own exit code (its refusals are exit 3 with a
# Fix:), or
#   64 usage error, or the route key cannot be computed (no -C, not a git
#      repository, a remote with no URL, an unknown remote word). A key that
#      cannot be resolved is an error, never "plain git".
#   3  refused: the URL is in no form the Athena route takes.
#
# Test seams (tests only): FORGE_GIT_GH_ATHENA and FORGE_GIT_GLAB_ATHENA name
# the wrapper to run, as for ai/bin/forge-git; FORGE_PUSH_FORGE_GIT names the
# forge-git to ask for the route. The same user can redirect git's own
# transport, so the seams widen nothing.
set -uo pipefail

PROG=forge-push

usage() {
  cat <<'EOF'
forge-push — push through Athena's forge wrapper for the remote's host.

Usage:
  forge-push -C <dir> [git push args...]
  forge-push --help

  -C <dir>   the repository to push from (required; never guessed from the cwd).

Everything after -C <dir> is passed to `git push` unchanged. The remote is the
first non-option argument, else the current branch's pushRemote,
remote.pushDefault, the branch's remote, then origin. A remote name routes by
every push URL it has; any other word is the URL.

Route (the host table in ai/bin/forge-git; forge-git --route <url>):
  git@github.com:*, https://github.com/*   ai/bin/gh-athena git -C <dir> push ...
  git@gitlab.com:*, https://gitlab.com/*   ai/bin/glab-athena git -C <dir> push ...
  anything else (ssh://, a host alias,     refused, exit 3
    another host, a local path)

Refused: --repo, or an argument git push would reject (exit 64); push URLs
on two forges (exit 3).

Example (a lane landing on main):
  forge-push -C <lane> origin HEAD:main

Exit: the wrapper's own code; 64 usage or an unresolvable route key; 3 refused.
EOF
}

die() { # die <code> <what> <fix>
  printf '%s: %s\n  Fix: %s\n' "${PROG}" "$2" "$3" >&2
  exit "$1"
}

DIR=""
while [ $# -gt 0 ]; do
  case "$1" in
    --help|-h) usage; exit 0 ;;
    -C) [ $# -ge 2 ] || die 64 "-C needs a directory" "pass -C <repository dir>."
        DIR="$2"; shift 2; break ;;
    *) break ;;
  esac
done
[ -n "${DIR}" ] || die 64 "no -C <dir> before the push arguments" "pass forge-push -C <repository dir> [git push args]; forge-push never guesses the repository from the cwd."
[ "${1-}" = push ] && die 64 "the first push argument is 'push'" "drop the word 'push': forge-push -C <dir> <remote> <refspec>; everything after -C <dir> is git push's own arguments."
git -C "${DIR}" rev-parse --git-dir >/dev/null 2>&1 \
  || die 64 "'${DIR}' is not a git repository" "pass -C a directory inside the repository you push from."

HERE="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
FORGE_GIT="${FORGE_PUSH_FORGE_GIT:-${HERE}/forge-git}"
[ -x "${FORGE_GIT}" ] || die 64 "${FORGE_GIT} is missing or not executable, so no route can be chosen" "run forge-push from a full ~/dev/custom checkout (ai/bin/forge-git beside it)."

# The remote word, read with git push's own grammar: fg_push_argv in the
# wrappers' shared passthrough (DND-1843), so a bundled short option (-fo <v>),
# an abbreviation (--e <v>) or a `--` is read exactly as git reads it, and the
# word routed here is the word git pushes to.
# shellcheck source=../lib/forge-git-passthrough.sh
. "${HERE}/../lib/forge-git-passthrough.sh" 2>/dev/null && declare -F fg_push_argv >/dev/null \
  || die 64 "cannot load fg_push_argv from ${HERE}/../lib/forge-git-passthrough.sh, so the push's remote cannot be read" "run forge-push from a full ~/dev/custom checkout (ai/bin and ai/lib side by side)."
fg_push_argv "$@"
[ -z "${FG_PA_BAD}" ] \
  || die 64 "'${FG_PA_BAD}' is no option of git push, an abbreviation that matches more than one, or an option missing its value or given one it does not take" "spell the option as git push --help names it, with its value attached (--opt=value)."
for o in "${FG_PA_OPTS[@]}"; do
  case "${o}" in
    --repo|--repo=*)
      die 64 "push --repo names the remote apart from the positional word, which the route would not see" "name the remote as the first non-option argument: forge-push -C <dir> <remote> <refspec>." ;;
  esac
done
REMOTE_WORD="${FG_PA_POS[0]-}"

if [ -z "${REMOTE_WORD}" ]; then
  branch="$(git -C "${DIR}" symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  if [ -n "${branch}" ]; then
    REMOTE_WORD="$(git -C "${DIR}" config --get "branch.${branch}.pushRemote" 2>/dev/null || true)"
  fi
  [ -n "${REMOTE_WORD}" ] || REMOTE_WORD="$(git -C "${DIR}" config --get remote.pushDefault 2>/dev/null || true)"
  if [ -z "${REMOTE_WORD}" ] && [ -n "${branch}" ]; then
    REMOTE_WORD="$(git -C "${DIR}" config --get "branch.${branch}.remote" 2>/dev/null || true)"
  fi
  REMOTE_WORD="${REMOTE_WORD:-origin}"
fi

if [ "${REMOTE_WORD}" != . ] && git -C "${DIR}" config --get "remote.${REMOTE_WORD}.url" >/dev/null 2>&1; then
  URLS="$(git -C "${DIR}" remote get-url --push --all "${REMOTE_WORD}" 2>/dev/null)" \
    || die 64 "remote '${REMOTE_WORD}' in '${DIR}' has no readable push URL" "check 'git -C ${DIR} remote -v'."
  KEY="remote '${REMOTE_WORD}'"
else
  case "${REMOTE_WORD}" in
    .|*/*|*:*) ;;
    *) die 64 "'${REMOTE_WORD}' is neither a remote of '${DIR}' nor a URL or path, so no route can be chosen" "check 'git -C ${DIR} remote -v'; name a configured remote, or pass the URL." ;;
  esac
  # A URL literal: git rewrites it by url.<base>.pushInsteadOf (longest
  # prefix) else url.<base>.insteadOf before it pushes, so route by the
  # rewritten URL, as the passthrough resolves it.
  URLS="" best=0
  while read -r key prefix; do
    base="${key#url.}"; base="${base%.pushinsteadof}"
    if [ -n "${prefix}" ] && [[ "${REMOTE_WORD}" == "${prefix}"* ]] && [ "${#prefix}" -gt "${best}" ]; then
      best="${#prefix}"; URLS="${base}${REMOTE_WORD#"${prefix}"}"
    fi
  done < <(git -C "${DIR}" config --get-regexp '^url\..*\.pushinsteadof$' 2>/dev/null || true)
  [ -n "${URLS}" ] || URLS="$(git -C "${DIR}" ls-remote --get-url "${REMOTE_WORD}" 2>/dev/null)" \
    || die 64 "git could not expand '${REMOTE_WORD}' to the URL it pushes to" "check 'git -C ${DIR} config --get-regexp ^url\\.'."
  KEY="'${REMOTE_WORD}'"
fi

ROUTE=""
seen=0
while IFS= read -r url; do
  [ -n "${url}" ] || continue
  seen=$((seen + 1))
  # forge-git prints only the route on exit 0, and only its refusal (exit 3)
  # or failure (any other code) on stderr. A failure to look is never read as
  # a refusal of the URL.
  r="$("${FORGE_GIT}" --route "${url}" 2>&1)"; rrc=$?
  case "${rrc}" in
    0) ;;
    3) r="" ;;
    *) die 64 "${FORGE_GIT} --route '${url}' failed (exit ${rrc}), so the route could not be read: ${r}" "run '${FORGE_GIT} --route ${url}' by hand and fix what it reports; a route forge-git could not compute is never read as a refusal." ;;
  esac
  case "${r}" in
    gh-athena|glab-athena) ;;
    local)
      die 3 "${KEY} pushes to '${url}', a local path; a push has no plain-git route, because the push refusals (RED MAIN, NO RECEIPT, HTTPS-only, identity) live in the forge wrappers" \
        "push to the github.com or gitlab.com remote (git@<host>:<owner>/<repo>.git or https://<host>/<owner>/<repo>.git). A push to a local repository is not an unattended forge push: run it with git yourself, outside the harness paths." ;;
    *)
      die 3 "${KEY} pushes to '${url}', which is not a github.com or gitlab.com URL in a form the Athena route takes; refusing rather than push with the owner's credentials" \
        "set the remote to the git@<host>:<owner>/<repo>.git or https://<host>/<owner>/<repo>.git form on github.com or gitlab.com (git -C '${DIR}' remote set-url [--push] <name> <url>). An ssh:// URL, an ~/.ssh/config host alias, or another host has no Athena route." ;;
  esac
  if [ -n "${ROUTE}" ] && [ "${ROUTE}" != "${r}" ]; then
    die 3 "${KEY} has push URLs on two forges (${ROUTE} and ${r}); one push cannot run as both identities" \
      "give the remote push URLs on one forge, or push to each forge's remote by name, one forge-push call each."
  fi
  ROUTE="${r}"
done <<< "${URLS}"
[ "${seen}" -gt 0 ] && [ -n "${ROUTE}" ] \
  || die 64 "${KEY} in '${DIR}' resolved to no push URL" "check 'git -C ${DIR} remote -v'; give the remote a URL."

case "${ROUTE}" in
  gh-athena) WRAPPER="${FORGE_GIT_GH_ATHENA:-${HERE}/gh-athena}" ;;
  glab-athena) WRAPPER="${FORGE_GIT_GLAB_ATHENA:-${HERE}/glab-athena}" ;;
esac
[ -x "${WRAPPER}" ] || die 64 "the wrapper ${WRAPPER} is missing or not executable" "run forge-push from a full ~/dev/custom checkout (ai/bin/${ROUTE} beside it)."

export GIT_TERMINAL_PROMPT=0
exec "${WRAPPER}" git -C "${DIR}" push "$@"
