#!/usr/bin/ruby
# frozen_string_literal: true
#
# next-mission -- pick the ONE ticket an admiral dispatches next, and name the
# rule that picked it (DND-985, epic "Harness: scope-growth rules", W8).
#
# Read-only. It reads the DND Tickets data source through the Notion REST API
# with the notion-personal integration token (~/.claude/notion-personal-token,
# the same file athena:ticket-management's curl recipe uses), or reads an
# offline JSON fixture. It never writes Notion, git, or the state log.
#
# The rule (tiers 0-4 and the functional-first hold) lives in
# ai/lib/next_mission.rb; its prose home is athena:ticket-management ->
# "Priority: critical path first". The Notion reads live in
# ai/lib/next_mission_notion.rb.
#
# Exit codes -- a failed lookup must never look like an empty one:
#   0  picked a ticket (stdout: "<ID>\t<rule>")
#   1  no candidate: the output names the filter that emptied the set and the
#      count each filter matched
#   2  usage error (bad flag, bad id, conflicting inputs)
#   3  could not read (Notion/HTTP failure, missing token, unreadable fixture,
#      data outside the known vocabulary). Never read as "no candidate".
require "json"
require_relative "../lib/strict_argv"
require_relative "../lib/next_mission"
require_relative "../lib/next_mission_notion"

PROG = "next-mission"
TOKEN_FILE = File.join(Dir.home, ".claude", "notion-personal-token")
SUITE = File.expand_path("../lib/test/next-mission/self-test.sh", __dir__)

USAGE = <<~TXT
  Usage: ai/bin/next-mission (--scope EPIC | --tickets IDS | --from-json FILE) [options]

  Pick the next ticket to dispatch from a scope and print it with the rule that
  picked it. Read-only.

  Scope (at least one; --scope and --tickets combine as a union):
    --scope EPIC        an epic page id (32 hex, dashes optional) or its exact title
    --tickets IDS       comma-separated ticket ids, e.g. DND-12,DND-40
    --from-json FILE    offline: read the scope from a JSON fixture instead of Notion
                        ({"tickets":[{id,status,kind,severity,path,area,depends_on,created}],
                          "external":[{id,status}]}); not combinable with --scope/--tickets

  Options:
    --started IDS       comma-separated ids the state log records as started (added to
                        Notion In Progress; the state log's Mission table is authoritative)
    --harness-lane      only Area=Harness and Path=Off tickets (the P7 harness lane)
    --json              print the full result as JSON (ticket, tier, rule, funnel, held_back)
    --self-test         run the deterministic suite (no network)
    --help              this text

  Tiers: 0 Path=Promoted; 1 Vulnerability CRITICAL/HIGH; 2 Bug + Path=Blocking;
  3 Path=Critical in dependency order; 4 the rest by Severity, Kind, age.
  Tier-4 non-Features wait while a Critical/Feature ticket in scope is unfinished.

  Exit: 0 picked; 1 no candidate (names the emptying filter); 2 usage; 3 read failure.
TXT

SPEC = {
  "--scope" => :value, "--tickets" => :value, "--from-json" => :value, "--started" => :value,
  "--harness-lane" => :switch, "--json" => :switch, "--self-test" => :switch, "--help" => :switch
}.freeze

def usage_error(msg)
  warn "#{PROG}: #{msg}"
  warn "Fix: run `#{PROG} --help`; pass --scope EPIC and/or --tickets DND-1,DND-2, or --from-json FILE for offline use."
  exit 2
end

def read_error(msg, fix)
  warn "#{PROG}: could not read the scope: #{msg}"
  warn "Fix: #{fix}"
  warn "This is a read failure, not an empty queue: do not dispatch on it."
  exit 3
end

def id_list(flag, raw)
  ids = raw.split(",").map(&:strip).reject(&:empty?)
  usage_error("#{flag} is empty") if ids.empty?
  bad = ids.reject { |i| i.match?(NextMission::ID_RE) }
  usage_error("#{flag} has malformed id(s) #{bad.join(', ')}; expected PREFIX-NUMBER, e.g. DND-12") unless bad.empty?
  ids.uniq
end

def load_fixture(path)
  data = JSON.parse(File.read(path))
  mk = lambda do |h|
    NextMission::Ticket.new(id: h["id"], page_id: h["page_id"], title: h["title"], status: h["status"],
                            kind: h["kind"], severity: h["severity"], path: h["path"], area: h["area"],
                            depends_on: Array(h["depends_on"]), created: h["created"])
  end
  NextMissionNotion::Scope.new(scope: Array(data.fetch("tickets")).map(&mk),
                               external: Array(data["external"]).map(&mk))
rescue SystemCallError, JSON::ParserError, KeyError, TypeError, NoMethodError => e
  read_error("fixture #{path}: #{e.class}: #{e.message}",
             "pass a readable JSON file shaped as in --help (a top-level \"tickets\" array).")
end

def load_notion(opts)
  unless File.readable?(TOKEN_FILE)
    read_error("the notion-personal token file #{TOKEN_FILE} is missing or unreadable",
               "owner-gated: ask the owner to place the notion-personal integration token at " \
               "#{TOKEN_FILE}; never mint or rotate one yourself.")
  end
  token = File.read(TOKEN_FILE).strip
  read_error("#{TOKEN_FILE} is empty", "owner-gated: ask the owner to restore the notion-personal token.") if token.empty?
  NextMissionNotion.new(NextMissionNotion::HttpTransport.new(token))
                   .load(epic: opts["--scope"], tickets: opts["--tickets"] && id_list("--tickets", opts["--tickets"]))
rescue NextMissionNotion::ReadError => e
  read_error(e.message, "check the epic id/title and ticket ids against Notion; on an HTTP 401/403 the " \
                        "notion-personal integration lost access (owner-gated); on 429/5xx re-run shortly.")
end

def render_empty(result)
  puts "#{PROG}: no candidate to dispatch"
  puts "emptied by: #{result.emptied_by}"
  puts "reason: #{result.reason}"
  puts "funnel (matched at each filter, in order):"
  result.funnel.each { |stage, n| puts "  #{NextMission::STAGES.fetch(stage).split(' (').first}: #{n}" }
  hint = {
    in_scope: "the scope matched no tickets; check --scope/--tickets name the intended epic.",
    not_terminal: "every ticket in scope is terminal; the epic may be ready to close.",
    not_flake: "only Flake tickets remain; they belong to the flaky lane.",
    harness_lane: "no Area=Harness, Path=Off ticket in scope; the harness lane has nothing here.",
    not_started: "everything open is already started; wait for a slot's captain to land.",
    not_waiting_on_owner: "the rest are Needs Attention; they wait on the owner, so report them.",
    unblocked: "every remaining ticket waits on an unfinished Depends On; land a blocker first.",
    functional_first: "finish the Critical/Feature tickets named above; tier-4 findings follow them."
  }.fetch(result.emptied_by)
  puts "Fix: none needed if this is expected -- #{hint}"
end

begin
  opts = StrictArgv.parse(ARGV, SPEC)
rescue StrictArgv::UsageError => e
  usage_error(e.message)
end

if opts["--help"]
  puts USAGE
  exit 0
end
exec(SUITE) if opts["--self-test"]

if opts["--from-json"] && (opts["--scope"] || opts["--tickets"])
  usage_error("--from-json replaces the Notion read; it cannot be combined with --scope or --tickets")
end
usage_error("no scope given") unless opts["--from-json"] || opts["--scope"] || opts["--tickets"]
started = opts["--started"] ? id_list("--started", opts["--started"]) : []

loaded = opts["--from-json"] ? load_fixture(opts["--from-json"]) : load_notion(opts)

begin
  result = NextMission.select(scope: loaded.scope, external: loaded.external, started: started,
                              harness_lane: opts["--harness-lane"] ? true : false)
rescue NextMission::DataError => e
  read_error(e.message, "the ticket data is outside the vocabulary next-mission knows; fix the ticket in " \
                        "Notion, or update ai/lib/next_mission.rb if the schema gained a value on purpose.")
end

if opts["--json"]
  puts JSON.pretty_generate(result.to_h)
elsif result.pick
  puts "#{result.pick.id}\t#{result.rule}"
else
  render_empty(result)
end
exit(result.pick ? 0 : 1)
