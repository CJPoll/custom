#!/usr/bin/env ruby
# frozen_string_literal: true

# blast-radius — answers the ONE merge question the rest of the merge bar never
# asked: does merging this head PERFORM a real-world action, or does it publish
# code?
#
# Every criterion in athena:merge-boarding's bar is about whether the CODE is
# CORRECT (CI green, one review round, the captain's report, the head SHA, a
# per-SHA standing-judge verdict). None of them asks what merging CAUSES.
#
# Measured 2026-09-20 (gen_saas PR #256, DND-234): the repo's
# .github/workflows/post-merge.yml runs `terraform init && terraform apply
# -auto-approve` on every merge to main, so merging that PR would have created a
# real, billable AWS KMS key whose destruction makes every wrapped secret
# permanently undecryptable. An unattended admiral following the documented bar
# EXACTLY AND CORRECTLY would have merged it. The only thing that stopped it was
# a captain choosing to read a workflow file nobody told it to read -- a safety
# property resting on judgement rather than structure. This script is the
# structure.
#
# THE DISCRIMINATOR is a conjunction, evaluated in this order:
#
#   HOT = (the diff touches a declared irreversible/billable surface)
#         AND (merging triggers automation on the default branch)
#
# "Touches" counts BOTH paths of a rename or copy (see CHANGED_PATHS_ARGS):
# moving a surface file out of its pattern changes that surface.
#
# Both terms are load-bearing, and the ORDER is what preserves throughput:
#
#   * Path first, and it is the cheap common case. A routine app-code merge hits
#     zero declared patterns and exits 0 immediately -- one `git diff` plus
#     fnmatch, no network, no model, no owner. The automation term is never even
#     consulted. Deploy-on-merge is the NORMAL case (gen_saas and walt_ui both);
#     gating on it alone would stall every merge on an absent owner and defeat
#     athena:run-autonomously outright.
#   * Automation second, and only for a hot path. A .tf change in a repo where a
#     human applies later is landing code, not performing an action -- correctly
#     not gated. The same .tf in a repo where merge => `terraform apply
#     -auto-approve` IS the action.
#
# In one sentence: merging is gated when merging PERFORMS the change rather than
# PUBLISHES it. That is why .tf counts and an ordinary Elixir deploy does not.
#
# FAILED LOOKUPS NEVER READ AS EMPTY (~/.claude/CLAUDE.md -> "A failed lookup
# must never look like an empty one"). "No post-merge.yml found" is exactly the
# ambiguous empty result that doctrine warns about, so the automation term is
# THREE-VALUED, never boolean, and UNDETERMINED fails CLOSED:
#
#   path hit? | automation        | verdict | exit
#   ----------+-------------------+---------+-----
#   no        | (not consulted)   | COLD    | 0
#   yes       | CONFIRMED         | HOT     | 4
#   yes       | UNDETERMINED      | HOT     | 4
#   yes       | CONFIRMED-ABSENT  | WARM    | 0
#
# UNDETERMINED fails closed because the cost is asymmetric with no human
# watching: a false positive costs one held MR plus an owner ping (and the fleet
# moves on to the next Mission -- an already-specified move), while a false
# negative costs a real billable key. It fails closed only inside the already-
# rare hot-path branch, so routine throughput is never touched. And every run
# PRINTS both terms, so a miss is observable rather than silent.
#
# Read-only: never writes, never reaches the network, never calls a model --
# which is what makes --self-test gate-safe.
#
# Usage:
#   blast-radius --base <ref> --head <ref> [--repo <dir>]
#                [--owner-approval <authorization>] [--gate-ran <label>]
#   blast-radius --self-test
#
#   --gate-ran <label>  display only: the gate command that verified <head>,
#                       appended to the HOT-OWNER-APPROVED line so the owner-
#                       facing record names what ran (integration-gate passes
#                       it). It never changes the verdict or the exit code.
#
# Exit codes:
#   0  COLD / WARM / HOT-OWNER-APPROVED -- merging publishes code (or the owner
#      authorized the action)
#   2  usage / unresolvable ref / empty diff / manifest error
#   4  HOT -- merging performs an irreversible, billable or one-way action.
#      NOT the fleet's call.

require "json"
require "yaml"
require "open3"
require "tmpdir"
require "fileutils"
require "set"

PROG = "blast-radius"

# The manifest is resolved from THIS SCRIPT'S OWN committed location, never from
# cwd and never from the target repo. blast-radius is run from a PRODUCT
# worktree; a cwd-relative manifest path would resolve to nothing there and
# produce a silent COLD -- the precise failed-lookup trap this check exists to
# avoid, reintroduced inside the check itself.
DEFAULT_MANIFEST = File.expand_path("../blast-radius/surfaces.json", __dir__)

# FNM_DOTMATCH is load-bearing (DND-422). Without it `*` and `**/` never match
# a leading `.`, so every `**/` surface silently skipped dot-prefixed
# directories: gen_saas's auto-applied terraform root .pkg/prod/tf read COLD.
# The flag only RELAXES matching -- any path matched without it still matches --
# so it widens every surface and narrows none. Pinned by self-test cases 6b-6d.
FNM = File::FNM_PATHNAME | File::FNM_EXTGLOB | File::FNM_DOTMATCH

# Branch names treated as the default branch for trigger matching.
DEFAULT_BRANCHES = %w[main master].freeze

# Bumped 1 -> 2 when surfaces gained `content`: a predicate over the file's TEXT
# rather than only its path. No schema-1 surface needed one.
MANIFEST_SCHEMA = 2

ECTO_MIGRATION_EVALUATOR = "ecto-migration-v1"

KNOWN_CONTENT_KEYS = %w[
  evaluator comment known_gaps
  exempt_region region_def region_other_def executable_regions
  exclude_first match_line match_region
].freeze

# DND-589: a surface may declare `references` -- files merge-time CI EXECUTES
# by relative path are hits too (see ci_references).
CI_REFERENCES_EVALUATOR = "ci-local-references-v1"
KNOWN_REFERENCES_KEYS = %w[evaluator comment known_gaps].freeze

def die(msg, fix, code = 2)
  warn "#{PROG}: #{msg}"
  warn "Fix: #{fix}"
  exit code
end

# --- manifest ---------------------------------------------------------------

def load_manifest(path)
  unless File.file?(path)
    die("manifest not found at #{path}.",
        "the surface manifest is missing. It is resolved from this script's own " \
        "committed location (ai/blast-radius/surfaces.json), so this means the " \
        "checkout is incomplete -- restore the file from git. A manifest that " \
        "cannot be loaded is an ERROR, never 'nothing is sensitive'.")
  end

  begin
    data = JSON.parse(File.read(path))
  rescue JSON::ParserError => e
    die("manifest #{path} is not valid JSON (#{e.message}).",
        "repair the JSON syntax in ai/blast-radius/surfaces.json, then re-run. " \
        "An unparseable manifest is an ERROR, never an empty surface list.")
  end

  unless data.is_a?(Hash) && data["schema"] == MANIFEST_SCHEMA
    die("manifest #{path} has schema #{data.is_a?(Hash) ? data['schema'].inspect : 'n/a'}, expected #{MANIFEST_SCHEMA}.",
        "this script understands schema #{MANIFEST_SCHEMA} only. Either migrate the manifest or " \
        "update blast-radius to handle the new schema. Refusing to classify " \
        "against a schema it does not understand.")
  end

  surfaces = data["surfaces"]
  unless surfaces.is_a?(Array) && !surfaces.empty?
    die("manifest #{path} declares no surfaces.",
        "a manifest with zero surfaces would classify EVERY merge as COLD, " \
        "silently disabling this check. Restore the surface list. Zero surfaces " \
        "is an ERROR, not 'nothing is sensitive'.")
  end

  # A surface may declare `content`: a predicate over the FILE'S TEXT, not just
  # its path. A path-only surface is unchanged. Validate here, loudly, because
  # the two ways to get this wrong are both silent:
  #   - ignoring an unknown content rule => the surface degrades to a PATH-ONLY
  #     gate, and every routine migration reads HOT.
  #   - ignoring the surface entirely    => it reads COLD and the gate is off.
  # Both are "a failed lookup that looks like an empty one". Refuse instead.
  surfaces.each do |s|
    c = s["content"]
    next if c.nil?

    unless c.is_a?(Hash)
      die("surface '#{s['class']}' has a `content` key that is not an object.",
          "`content` declares a text predicate; it must be an object. Refusing " \
          "to classify: a content rule this script cannot read would silently " \
          "become either a path-only gate or no gate at all.")
    end

    unless c["evaluator"] == ECTO_MIGRATION_EVALUATOR
      die("surface '#{s['class']}' declares content evaluator #{c['evaluator'].inspect}, " \
          "which this blast-radius does not implement.",
          "this script implements '#{ECTO_MIGRATION_EVALUATOR}' only. Either update " \
          "blast-radius to implement that evaluator, or correct the manifest. An " \
          "unevaluable content rule is an ERROR -- never a path-only gate (which " \
          "would flag every routine migration) and never a silent miss.")
    end

    unknown = c.keys - KNOWN_CONTENT_KEYS
    unless unknown.empty?
      die("surface '#{s['class']}' declares unknown content key(s): #{unknown.join(', ')}.",
          "this script would IGNORE those keys, so the rule would not mean what " \
          "the manifest says. Remove them, or implement them in content_hit?. " \
          "Silently ignoring part of a safety rule is the defect this check exists " \
          "to prevent.")
    end

    if (c["match_line"].to_a + c["match_region"].to_a).empty?
      die("surface '#{s['class']}' declares `content` with no match rules.",
          "a content surface with nothing to match can never hit, silently " \
          "disabling this surface while the manifest still lists it. Restore the " \
          "match_line / match_region rules.")
    end
  end

  # `references` has the same two silent failure modes as `content`: an
  # unimplemented evaluator ignored would drop the executed-file surface (COLD),
  # and an unknown key ignored would make the rule mean less than it says.
  surfaces.each do |s|
    r = s["references"]
    next if r.nil?

    unless r.is_a?(Hash) && r["evaluator"] == CI_REFERENCES_EVALUATOR
      die("surface '#{s['class']}' declares references evaluator " \
          "#{r.is_a?(Hash) ? r['evaluator'].inspect : r.inspect}, which this blast-radius does not implement.",
          "this script implements `references: {evaluator: \"#{CI_REFERENCES_EVALUATOR}\"}` only. " \
          "Either implement the evaluator in ci_references or correct the manifest. " \
          "An unevaluable references rule is an ERROR -- ignoring it would read every " \
          "file CI executes as COLD.")
    end

    unknown = r.keys - KNOWN_REFERENCES_KEYS
    next if unknown.empty?

    die("surface '#{s['class']}' declares unknown references key(s): #{unknown.join(', ')}.",
        "this script would IGNORE those keys. Remove them, or implement them in " \
        "ci_references. Silently ignoring part of a safety rule is the defect this " \
        "check exists to prevent.")
  end

  pattern_count = surfaces.sum { |s| (s["patterns"] || []).size }
  if pattern_count.zero?
    die("manifest #{path} declares #{surfaces.size} surface(s) but ZERO patterns.",
        "every surface has an empty `patterns` list, so nothing can ever match " \
        "and every merge would read as COLD. Restore the patterns. Zero patterns " \
        "is an ERROR, not 'nothing is sensitive'.")
  end

  [surfaces, pattern_count]
end

# --- matching ---------------------------------------------------------------

# `**/*.tf` must also match a REPO-ROOT `main.tf`. Under FNM_PATHNAME a leading
# `**/` does not match zero directories, so the depth-0 form is tried too. This
# is pinned by a self-test case; without it every root-level terraform file
# would read as COLD. The fallback uses the same FNM (so DOTMATCH too): a
# repo-root `.terraform.lock.hcl` or a `.x.tf` must not slip through it.
#
# A TRAILING `/**` has the mirror-image trap (DND-422): under FNM_PATHNAME it
# behaves like `/*` and matches ONE level only, so `**/helm/**` missed
# helm/chart/templates/deploy.yaml and `**/k8s/**` missed k8s/base/app.yaml.
# The `/**/*` form -- any depth below -- is tried too. Every variant only ADDS
# to the original pattern, so this widens and never narrows.
def match?(pattern, path)
  pattern_variants(pattern).any? { |p| File.fnmatch?(p, path, FNM) }
end

def pattern_variants(pattern)
  variants = [pattern]
  variants << pattern.sub(%r{/\*\*\z}, "/**/*") if pattern.end_with?("/**")
  variants + variants.select { |p| p.start_with?("**/") }.map { |p| p.sub(%r{\A\*\*/}, "") }
end

# Split an Ecto migration into [region, line] pairs.
#
# Region attribution is PER-`def`, deliberately NOT "above/below the `def down`
# line". A file that defines `down` BEFORE `up`, or that puts a helper after
# `down`, breaks the positional form -- and it breaks it OPEN, reading an
# executable `drop table` as exempt. Pinned by a self-test case.
#
# Only `down` is exempt. `helper` is executable-by-default: a private helper
# called from `up` runs on deploy, and proving a helper is reachable only from
# `down` needs call-graph analysis. Fail closed.
# The manifest declares POLICY (which operations destroy data); this function
# knows the LANGUAGE. Two lexical facts, both learned from replaying the rule
# over the real 372-migration corpus on 2026-09-20 rather than from a fixture:
#
#   * `@moduledoc """ ... """` prose is not code. Six of the corpus's 25 hits
#     were sentences like "then drop the extension" and "drop the plaintext
#     columns" inside a moduledoc -- a 24% false-positive rate, entirely
#     documentation. Comment lines were already skipped; docstrings are the
#     same class and were not.
#   * A call can span lines. walt_ui's 20260821164800 is
#     `drop_if_exists(\n  constraint(...)\n)`, where the ARGUMENT -- the thing
#     that decides whether rows are lost -- is on the next line. Matching per
#     physical line cannot see it, so the index/constraint exclusion missed and
#     the fail-closed rule fired on a constraint drop. Lines are therefore
#     joined into LOGICAL lines while parentheses are unbalanced.
#
# Returns [region, logical_line] pairs.
def ecto_regions(text, rule)
  region_def = Regexp.new(rule["region_def"])
  other_def  = Regexp.new(rule["region_other_def"])
  region = "toplevel"
  in_doc = false
  out = []
  pending = nil
  pending_region = nil

  text.to_s.lines.each do |line|
    # Doc attributes: `@moduledoc """` opens a block that ends at the next
    # `"""`; a single-line `@doc "..."` / `@moduledoc false` is dropped outright.
    if in_doc
      in_doc = false if line.strip == '"""'
      next
    end
    if line.match?(/^\s*@(moduledoc|doc|typedoc|shortdoc)\s+"""/)
      in_doc = true
      next
    end
    next if line.match?(/^\s*@(moduledoc|doc|typedoc|shortdoc)\s/)

    if pending.nil?
      if (m = line.match(region_def))
        region = m[1]
      elsif line.match?(other_def)
        region = "helper"
      end
      next if line.strip.start_with?("#")
    end

    if pending
      # A comment does not execute at ANY nesting depth. Without this, a comment
      # inside a multi-line call is joined into the logical line and its PROSE is
      # matched: walt_ui's 20260716120000 has `execute(` spanning a comment
      # reading "intentionally does NOT drop faraday_user", which fired the
      # fail-closed rule on a migration that drops nothing. Inside a `"""`
      # heredoc, though, a `#` line is SQL content rather than a comment -- an
      # odd number of `"""` so far means we are in one.
      in_heredoc = pending.scan('"""').length.odd?
      if !in_heredoc && line.strip.start_with?("#")
        next
      end
      pending << line
      pending_balance = pending.count("(") - pending.count(")")
      if pending_balance <= 0
        out << [pending_region, pending]
        pending = nil
        pending_region = nil
      end
      next
    end

    if line.count("(") - line.count(")") > 0
      pending = +line.dup
      pending_region = region
      next
    end

    out << [region, line]
  end

  # An unterminated call still has to be classified -- dropping it would be a
  # silent miss.
  out << [pending_region, pending] if pending
  out
end

# [:hit, detail] / [:miss, nil] / [:skipped, detail]
#
# Content is read from the file AT HEAD, never from diff text. A diff hunk may
# not show the `def down` line, which would make the up/down distinction
# undecidable; the complete file always does. Ecto migrations are append-only by
# convention, so the diff usually IS the whole file -- reading at head makes that
# structural rather than lucky, and for an edited already-deployed migration it
# is strictly more correct (the deploy runs the file as it is at head).
def content_hit?(repo, head, path, rule)
  _, _, exists = git(repo, "cat-file", "-e", "#{head}:#{path}")
  unless exists
    # DELETED at head. A migration that is not there does not execute on deploy,
    # so this is correctly not a hit -- but it is PRINTED, never silently
    # dropped (ai/CLAUDE.md -> "A failed lookup must never look like an empty
    # one"): this is the one residual undecidable-looking case, and a reader has
    # to be able to tell it from "examined and clean".
    return [:skipped, "absent at head (deleted) -- not executed on deploy"]
  end

  text, err, ok = git(repo, "show", "#{head}:#{path}")
  unless ok
    # Present but unreadable is NOT the deleted case, and must not borrow its
    # benign reading. Fail closed.
    return [:hit, "UNDETERMINED-content: readable check passed but `git show` failed (#{err.to_s.strip})"]
  end

  exempt    = rule["exempt_region"]
  exec_set  = rule["executable_regions"].to_a
  excludes  = rule["exclude_first"].to_a.map { |r| [Regexp.new(r["re"]), r["why"]] }
  lines_res = rule["match_line"].to_a.map { |r| [Regexp.new(r["re"]), r["why"]] }
  region_res = rule["match_region"].to_a.map { |r| [Regexp.new(r["re"], Regexp::IGNORECASE), r["why"]] }

  executable = []
  ecto_regions(text, rule).each do |region, line|
    next if region == exempt
    next unless exec_set.include?(region)
    # A commented-out line does not execute.
    next if line.strip.start_with?("#")

    executable << line

    # Exclusions are checked FIRST: dropping an index or a constraint loses no
    # rows. This is what keeps routine schema hygiene ungated -- 19 of the 49
    # naive hits measured across walt_ui were exactly these.
    next if excludes.any? { |re, _| line.match?(re) }

    lines_res.each do |re, why|
      return [:hit, "#{why} (in `#{region}`: #{line.strip.gsub(/\s+/, ' ')})"] if line.match?(re)
    end
  end

  # Region-WIDE, so a destructive statement inside an `execute """ ... """`
  # heredoc is covered. A per-line scan passes those only by accident.
  joined = executable.join
  region_res.each do |re, why|
    if (m = joined.match(re))
      return [:hit, "#{why} (matched #{m[0].strip.inspect})"]
    end
  end

  [:miss, nil]
end

# `refs` is a lazily-computed ci_references result, shared with the caller so
# the report can print it. It is computed only when a changed file matched no
# pattern of a surface that declares `references`.
def hits_for(files, surfaces, repo = nil, head = nil, refs = {})
  hits = []
  examined = []
  files.each do |f|
    surfaces.each do |s|
      unless (s["patterns"] || []).any? { |p| match?(p, f) }
        next unless s["references"] && repo && head

        refs[:result] ||= ci_references(repo, head)
        via = refs[:result][:files][f]
        next unless via

        hits << { path: f, class: s["class"], why: s["why"], via: via }
        break
      end

      if (rule = s["content"])
        verdict, detail = content_hit?(repo, head, f, rule)
        examined << { path: f, class: s["class"], verdict: verdict, detail: detail }
        # A path hit alone is NOT a surface hit for a content surface: routine
        # migrations touch these paths on every feature MR and must stay COLD.
        next unless verdict == :hit

        hits << { path: f, class: s["class"], why: s["why"], detail: detail }
        break
      end

      hits << { path: f, class: s["class"], why: s["why"] }
      break
    end
  end
  [hits, examined]
end

# --- git --------------------------------------------------------------------

def git(repo, *args)
  out, err, st = Open3.capture3("git", "-C", repo, *args)
  [out, err, st.success?]
end

# The changed-path listing (DND-770). Every flag is load-bearing, and each
# pins a git default a user config could otherwise change:
#   --no-renames  rename/copy detection (on by default, diff.renames) lists
#                 only a rename's NEW path, so a surface file moved out of its
#                 pattern vanished from the set and read COLD. Both sides of a
#                 rename or copy are changes. It overrides diff.renames.
#   -z            NUL-terminated and verbatim. Without it core.quotePath
#                 (default true) prints a non-ASCII path C-quoted, and a
#                 quoted string matches no pattern.
CHANGED_PATHS_ARGS = %w[diff --no-renames -z --name-only].freeze

def changed_files(repo, base, head)
  _, _, ok = git(repo, "rev-parse", "--verify", "#{base}^{commit}")
  unless ok
    die("cannot resolve --base '#{base}' in #{repo}.",
        "the base ref does not name a commit in this repo. Pass the SHA pair " \
        "integration-gate printed. An unresolvable ref is an ERROR -- it must " \
        "never be treated as 'no files changed', which would read as COLD.")
  end

  _, _, ok = git(repo, "rev-parse", "--verify", "#{head}^{commit}")
  unless ok
    die("cannot resolve --head '#{head}' in #{repo}.",
        "the head ref does not name a commit in this repo. Pass the SHA pair " \
        "integration-gate printed. An unresolvable ref is an ERROR -- it must " \
        "never be treated as 'no files changed', which would read as COLD.")
  end

  out, err, ok = git(repo, *CHANGED_PATHS_ARGS, "#{base}..#{head}")
  unless ok
    die("`git #{CHANGED_PATHS_ARGS.join(' ')} #{base}..#{head}` failed in #{repo}: #{err.strip}",
        "the diff could not be computed, so the changed-file set is UNKNOWN, " \
        "not empty. Resolve the git error and re-run.")
  end

  files = out.split("\0").reject(&:empty?)
  if files.empty?
    die("the diff #{base}..#{head} is EMPTY -- refusing to classify.",
        "a merge with no changed files is either a wrong ref pair or nothing to " \
        "merge. Either way it is an ERROR, not COLD. Re-check the SHAs you " \
        "intend to land (they must be the pair integration-gate printed), then " \
        "re-run.")
  end
  files
end

# --- automation detection ---------------------------------------------------

# Every workflow file, dot-prefixed ones included (DND-422): a glob without
# FNM_DOTMATCH skips `.deploy.yml`, and a skipped deploy workflow reads as
# CONFIRMED-ABSENT -- a WARM pass for a repo that deploys on merge.
def workflow_files(repo)
  Dir.glob(File.join(repo, ".github", "workflows", "*.{yml,yaml}"), File::FNM_DOTMATCH).sort
end

# Returns [state, detail] where state is one of
# "CONFIRMED" / "UNDETERMINED" / "CONFIRMED-ABSENT".
#
# NOTE: this parses TRIGGERS. It deliberately does NOT grep for the filename
# `post-merge.yml` the way ai/bin/lead-time does -- lead-time answers a
# different question (WHICH completed run was the deploy) and coupling them
# would make one brittle filename load-bearing for two unrelated guarantees.
def detect_automation(repo)
  wf_dir = File.join(repo, ".github", "workflows")
  if Dir.exist?(wf_dir)
    files = workflow_files(repo)
    if files.empty?
      # The directory exists but holds no workflow: fall through to the other
      # forge shapes rather than claiming provable absence.
    else
      files.each do |f|
        rel = f.sub("#{repo}/", "")
        begin
          doc = YAML.safe_load(File.read(f), aliases: true)
        rescue StandardError => e
          return ["UNDETERMINED",
                  "#{rel}: unparseable YAML (#{e.class}) -- cannot prove it does " \
                  "NOT deploy on merge"]
        end
        # workflow_trigger reads `on:` under both "on" and `true`: YAML 1.1
        # parses a bare `on:` key as the BOOLEAN true, and checking only "on"
        # would silently find nothing on every real workflow file -- the
        # failed-lookup class, inside the detector.
        trig = workflow_trigger(doc)
        next if trig.nil?

        return [trig.determined ? "CONFIRMED" : "UNDETERMINED", "#{rel}: #{trig.detail}"]
      end
      return ["CONFIRMED-ABSENT",
              "#{files.size} GitHub workflow(s) parsed, every trigger is pre-merge " \
              "(#{PRE_MERGE_EVENTS.to_a.join(', ')}, or a push to a non-default branch)"]
    end
  end

  if File.exist?(File.join(repo, ".gitlab-ci.yml")) || Dir.exist?(File.join(repo, ".gitlab", "ci"))
    return ["CONFIRMED",
            ".gitlab-ci.yml present (GitLab: pipeline ABSENCE is not provable by " \
            "this check -- proving a pipeline will NOT deploy needs rules:/only: " \
            "evaluated across the whole graph, and an unproven negative here is " \
            "the silent-empty class -- treated as present)"]
  end

  %w[Jenkinsfile azure-pipelines.yml azure-pipelines.yaml].each do |n|
    if File.exist?(File.join(repo, n))
      return ["UNDETERMINED",
              "#{n} present -- a forge shape this check does not model, so it " \
              "cannot prove merging does not deploy"]
    end
  end
  %w[.circleci .buildkite].each do |d|
    if Dir.exist?(File.join(repo, d))
      return ["UNDETERMINED",
              "#{d}/ present -- a forge shape this check does not model, so it " \
              "cannot prove merging does not deploy"]
    end
  end

  ["CONFIRMED-ABSENT", "no CI configuration of any recognised kind in the repo"]
end

# --- which GitHub triggers are merge-time automation (DND-590) --------------
#
# The question: does MERGING change what a later run executes with the default
# branch's secrets? For nearly every GitHub event the answer is yes, because
# the run uses the workflow file and the checkout of the DEFAULT BRANCH (or of
# a ref cut from it, such as a release tag): push to the default branch,
# workflow_run, schedule, workflow_dispatch, repository_dispatch, release,
# pull_request_target (base-branch code, with secrets, on every PR), issues,
# issue_comment, and the rest. workflow_call counts too: its callers can live in
# other repos (`uses: org/repo/.github/workflows/x.yml@main`) that this check
# cannot read, so "no caller runs it" is an unproven negative.
#
# So the model is a DENY-list of the triggers that do NOT, never an allow-list
# of the ones that do: an event name this code has never seen is a hit (it
# widens, never narrows). PRE_MERGE_EVENTS run the PULL REQUEST'S OWN head, or
# the merge-queue candidate, BEFORE it lands: the proposed code already ran
# under review, and merging changes nothing those runs execute.
#   pull_request, pull_request_review, pull_request_review_comment -- the PR's
#     merge ref (refs/pull/N/merge), i.e. the PR's own code.
#   merge_group -- the merge-queue candidate commit, before it reaches the
#     default branch.
# A push is a hit only when it can fire on the default branch; a branch
# pattern this code does not evaluate (a glob or a `!` negation) counts as
# matching it.
#
# An `on:` shape this code does not model (a number, a list holding a mapping,
# a missing or empty `on:`, a non-list branch filter) is NOT "no trigger": it is
# returned as an UNDETERMINED hit, which detect_automation reports as
# UNDETERMINED (exit 4) and ci_references scans as a root. Reading an
# unrecognised shape as absent would be the failed-lookup class: a wrong key
# and a key that matches nothing would both exit 0.
PRE_MERGE_EVENTS = %w[pull_request pull_request_review pull_request_review_comment merge_group].to_set.freeze
BRANCH_PATTERN_CHARS = /[*?\[+!]/

# detail: what fired, for the report. determined: false when the shape was not
# understood, so the caller fails closed as UNDETERMINED instead of CONFIRMED.
TriggerHit = Struct.new(:detail, :determined)

def undetermined_trigger(what)
  TriggerHit.new("#{what} -- an `on:` shape this check does not model, so its " \
                 "triggers are UNKNOWN and it cannot prove merging does not run it", false)
end

# The trigger verdict for one parsed workflow document: a TriggerHit, or nil
# when every trigger is pre-merge.
def workflow_trigger(doc)
  return undetermined_trigger("workflow is not a YAML mapping (#{doc.class})") unless doc.is_a?(Hash)
  return undetermined_trigger("no `on:` key") unless doc.key?("on") || doc.key?(true)

  trigger_hit(doc.key?("on") ? doc["on"] : doc[true])
end

def trigger_hit(on)
  case on
  when String
    event_hit(on, nil, "on: #{on}")
  when Array
    return undetermined_trigger("on: #{on.inspect} (a list entry is not an event name)") unless on.all?(String)

    first_hit(on.map { |e| event_hit(e, nil, "on: [#{on.join(', ')}] includes #{e}") })
  when Hash
    return undetermined_trigger("on: #{on.keys.inspect} (a key is not an event name)") unless on.keys.all?(String)

    first_hit(on.map { |e, cfg| event_hit(e, cfg, "on.#{e}") })
  when nil
    undetermined_trigger("an empty `on:`")
  else
    undetermined_trigger("on: #{on.inspect} (#{on.class})")
  end
end

# A determined hit wins over an undetermined one; nil only when every entry is nil.
def first_hit(hits)
  hits.compact.min_by { |h| h.determined ? 0 : 1 }
end

def event_hit(event, cfg, label)
  return nil if PRE_MERGE_EVENTS.include?(event)
  return push_hit(cfg, label) if event == "push"

  TriggerHit.new(label, true)
end

def push_hit(push, label)
  unfiltered = TriggerHit.new("#{label} (no branch filter -- fires on the default branch)", true)
  return unfiltered unless push.is_a?(Hash)
  return unfiltered unless push.key?("branches")

  branches = push["branches"]
  branches = [branches] if branches.is_a?(String)
  unless branches.is_a?(Array) && branches.all?(String)
    return undetermined_trigger("#{label}.branches: #{branches.inspect}")
  end

  shown = "on.push.branches=[#{branches.join(', ')}]"
  return TriggerHit.new(shown, true) unless (branches & DEFAULT_BRANCHES).empty?

  if branches.any? { |b| b.match?(BRANCH_PATTERN_CHARS) }
    return TriggerHit.new("#{shown} (a branch pattern this check does not evaluate -- " \
                          "counted as matching the default branch)", true)
  end
  # `tags:` alongside a branch filter still fires on every matching tag push,
  # which runs the tagged commit -- in practice a merged one -- with secrets.
  return TriggerHit.new("#{label}.tags (a tag push runs the tagged commit)", true) if push.key?("tags")

  nil
end

# --- files merge-time CI executes by relative path (DND-589) ----------------
#
# The deploy-automation patterns name CI CONFIG files. What merging makes CI DO
# is also decided by the files those configs EXECUTE: a local action
# (`uses: ./tools/release`), a script a deploy step runs
# (.pkg/prod/bin/deploy-guard.sh), a GitLab `include: local:` file, and whatever
# THOSE name in turn. Each read COLD before DND-589.
#
# Everything is read AT HEAD (git ls-tree / git show), never from the working
# tree: the question is what the commit being merged will execute.
#
# The roots are the configs whose later runs execute the merged code: a GitHub
# workflow with any trigger workflow_trigger counts (push to the default branch,
# schedule, workflow_dispatch, pull_request_target, ... -- see PRE_MERGE_EVENTS),
# every GitLab CI file (GitLab absence is not provable, as in detect_automation),
# and a workflow whose YAML does not parse or whose `on:` shape is unmodelled
# (its triggers are unknown, so it fails WIDE). A workflow whose every trigger
# is pre-merge (pull_request, merge_group, ...) is not a root: it runs the PR's
# own head before merge, and merging does not change what it executes.
#
# A reference is a path-shaped token that NAMES A FILE AT HEAD, resolved
# against the repo root, the referring file's directory and every
# `working-directory:` in it. A token that names nothing is not a reference --
# that existence check is what keeps prose, URLs and command words out. A token
# preceded by `*` or `/` is part of a glob or a longer path, never its own
# reference (`hashFiles('**/mix.lock')` executes nothing). A directory counts
# only when it holds an action.yml/action.yaml, and then all of it does.
#
# The walk is transitive, but it only FOLLOWS files that execute: CI YAML,
# action metadata, and scripts (a shebang or a script extension). A data file a
# deploy script ships (a compose file, a Caddyfile) is a hit but is not itself
# followed further unless it is YAML. A script's full-line comments are stripped
# first. YAML is read STRUCTURALLY: its comments are gone, and the subtrees under
# keys that SELECT or CACHE files rather than run them (`changes:`, `paths:`,
# `cache:`, `artifacts:`, the `on:` trigger block ...) are skipped. That list is
# a deny-list on purpose: an unknown key is scanned, so a key this code has
# never seen widens, never narrows. A YAML file that does not parse is scanned
# as raw text instead, which also only widens. These bounds are measured, not
# taste: unbounded, walt_ui's CI reached 372 files -- every ADR, through a
# CLAUDE.md a check script mentions in a comment -- and with raw YAML text, 91,
# including LiveView source files named in a `changes:` list. A gate that fires
# on every feature MR is bypassed in practice, which is a weakening in effect.
REF_TOKEN = %r{(?<![\w./*~-])(?:\.{1,2}/|/)?[\w.-]+(?:/[\w.-]+)*}
REF_EXPANSION = /\$\{\{[^}]*\}\}|\$\{[^}]*\}|\$\w+/
REF_WORKDIR = /working-directory:\s*["']?([^\s"'#]+)/
REF_SCAN_LIMIT = 1_048_576
REF_FOLLOW_EXT = /\.(ya?ml|sh|bash|zsh|ksh|rb|py|pl|ps1)\z/
REF_COMMENT_LINE = /^[ \t]*#.*$/
# Documentation is read, never executed: a runbook an error message links, or a
# CLAUDE.md a check greps, decides nothing a merge does. Measured on walt_ui,
# these were the bulk of the false hits that remained after the bounds above.
REF_NEVER_EXECUTED = /\.(md|markdown)\z/i

# Keys whose subtree names files to SELECT on (rules, triggers), CACHE or UPLOAD,
# or is display text -- never files the job executes.
REF_YAML_SKIP = %w[
  changes exists paths paths-ignore branches branches-ignore tags tags-ignore
  cache artifacts name description if on
].to_set.freeze

# [text-of-executed-strings, working-directories] from a parsed YAML document.
#
# A TOP-LEVEL hidden key (`.name:`) whose value is not a mapping is an anchor
# definition -- GitLab's idiom for a shared `changes:` list
# (`.ci:image-paths: &image-paths`) -- not a job. Aliases are resolved by the
# parser, so wherever that anchor is USED its strings are scanned (or skipped)
# by the key it is used under; skipping the bare definition loses nothing that
# executes. A hidden MAPPING is a job template and is always scanned.
def yaml_exec_strings(node, out = [], dirs = [], top: true)
  case node
  when Hash
    node.each do |k, v|
      next if k == true || REF_YAML_SKIP.include?(k.to_s)
      next if top && k.to_s.start_with?(".") && !v.is_a?(Hash)

      dirs << v if k.to_s == "working-directory" && v.is_a?(String)
      yaml_exec_strings(v, out, dirs, top: false)
    end
  when Array
    node.each { |v| yaml_exec_strings(v, out, dirs, top: false) }
  when String
    out << node
  end
  [out, dirs]
end

def followable?(path, text)
  path.match?(REF_FOLLOW_EXT) || text.start_with?("#!")
end

def show_at(repo, head, path)
  out, err, ok = git(repo, "show", "#{head}:#{path}")
  return out if ok

  die("cannot read #{path} at #{short(head)} (#{err.strip}).",
      "`git ls-tree` listed this file, so an unreadable blob means the object store " \
      "is damaged or the ref moved. The set of files CI executes is UNKNOWN, not " \
      "empty -- resolve the git error and re-run.")
end

# Returns { files: {path => referrer}, roots: [path], notes: [String] }.
def ci_references(repo, head)
  out, err, ok = git(repo, "ls-tree", "-r", "-z", "--name-only", head)
  unless ok
    die("`git ls-tree -r #{head}` failed in #{repo}: #{err.strip}",
        "the file list at head is UNKNOWN, not empty, so the files CI executes " \
        "cannot be computed. Resolve the git error and re-run.")
  end
  tree = out.split("\0")
  tree_set = tree.to_set
  action_dirs = tree.select { |p| File.basename(p).match?(/\Aaction\.ya?ml\z/) }
                    .map { |p| norm_dir(File.dirname(p)) }.to_set

  notes = []
  roots = tree.select do |p|
    if p.match?(%r{\A\.github/workflows/[^/]+\.ya?ml\z})
      begin
        trig = workflow_trigger(YAML.safe_load(show_at(repo, head, p), aliases: true))
        notes << "#{p}: #{trig.detail} -- scanned as a root" if trig && !trig.determined
        !trig.nil?
      rescue Psych::Exception => e
        notes << "#{p}: unparseable YAML (#{e.class}) -- triggers unknown, scanned as a root"
        true
      end
    else
      p == ".gitlab-ci.yml" || p.start_with?(".gitlab/ci/")
    end
  end

  files = {}
  queue = roots.dup
  seen = roots.to_set
  until queue.empty?
    f = queue.shift
    text = show_at(repo, head, f)
    next unless roots.include?(f) || followable?(f, text)

    if text.bytesize > REF_SCAN_LIMIT || text.include?("\0")
      notes << "#{f}: not scanned (binary or over #{REF_SCAN_LIMIT} bytes) -- anything it names is not followed"
      next
    end
    references_in(text, f, tree, tree_set, action_dirs, notes).each do |r|
      next if seen.include?(r)

      seen << r
      files[r] = f
      queue << r
    end
  end
  { files: files, roots: roots, notes: notes }
end

def references_in(text, referrer, tree, tree_set, action_dirs, notes = [])
  text = text.scrub(" ")
  doc = nil
  if referrer.match?(/\.ya?ml\z/)
    begin
      doc = YAML.safe_load(text, aliases: true)
    rescue Psych::Exception => e
      notes << "#{referrer}: unparseable YAML (#{e.class}) -- scanned as raw text"
    end
  end
  structured = doc.is_a?(Hash) || doc.is_a?(Array)
  if structured
    strings, workdirs = yaml_exec_strings(doc)
    flat = strings.join("\n").gsub(REF_EXPANSION, " ")
  else
    flat = text.gsub(REF_COMMENT_LINE, "").gsub(REF_EXPANSION, " ")
    workdirs = flat.scan(REF_WORKDIR).flatten
  end
  bases = ["", norm_dir(File.dirname(referrer))]
  bases += workdirs.reject { |w| w.include?("$") }.map { |w| norm_dir(w.sub(%r{\A/+}, "")) }
  bases = bases.map { |b| b == "." ? "" : b }.uniq

  found = Set.new
  flat.scan(REF_TOKEN).uniq.each do |tok|
    rel = tok.sub(%r{\A/+}, "")
    next if rel.empty?

    # A BARE name (no `/`) in a script is resolved beside the script, never at
    # the repo root: a CI step's cwd is the repo root, a script's is not, and a
    # root lookup turns every quoted word (`"mix.lock"` in a test fixture) into
    # a reference.
    tok_bases = !structured && !tok.include?("/") ? bases - [""] : bases
    tok_bases.each do |b|
      p = File.expand_path(rel, "/#{b}").delete_prefix("/")
      next if p.empty? || p.match?(REF_NEVER_EXECUTED)

      if tree_set.include?(p)
        found << p
      elsif action_dirs.include?(p)
        tree.each { |t| found << t if t.start_with?("#{p}/") }
      end
    end
  end
  found.delete(referrer)
  found.to_a.sort
end

# --- terraform apply roots (a NOTE, never a verdict input) ------------------
#
# A repo can hold several terraform roots, and merging applies only some of
# them. gen_saas: post-merge.yml runs `terraform apply -auto-approve` in
# .pkg/prod/tf on every merge, while .pkg/prod/tf/github and .pkg/prod/tf/kms
# are applied by the owner by hand, so merging them is inert (DND-408/DND-422).
# The owner deciding a held MR needs to know which one it is, so each terraform
# hit names the merge-time apply that covers it -- read from the workflows,
# never hardcoded.
#
# This NEVER changes the verdict. "No apply step found for this directory" is
# an unproven negative: the directory may be a module the applied root sources,
# or the apply may run from a script this parse cannot see. Downgrading on it
# would be the failed-lookup-reads-as-empty class, so such a hit stays HOT and
# the note says so.
TF_FILE = /(\A|\/)(\.terraform\.lock\.hcl|[^\/]*\.(tf|tf\.json|tfvars|tfvars\.json|tfstate))\z/
# The `apply` SUBCOMMAND, after any global flags (`terraform -chdir=x apply`) --
# never a bare word later on the line (`terraform plan -out=apply.plan`).
TF_APPLY = /\b(terraform|tofu)(\s+-\S+)*\s+apply\b/

def norm_dir(dir)
  d = dir.to_s.strip.sub(%r{\A(\./)+}, "").sub(%r{/+\z}, "")
  d.empty? ? "." : d
end

# Returns { applies: [{dir:, where:}], scanned: n_workflows, steps: n_apply_steps }.
# Only workflows whose later runs execute the merged code count (workflow_trigger);
# each apply names the trigger, so a cron apply never reads as the merge push.
def terraform_apply_roots(repo)
  applies = []
  scanned = 0
  workflow_files(repo).each do |f|
    rel = f.sub("#{repo}/", "")
    doc = begin
      YAML.safe_load(File.read(f), aliases: true)
    rescue StandardError
      nil # detect_automation already reports an unparseable workflow as UNDETERMINED
    end
    next unless doc.is_a?(Hash)

    trig = workflow_trigger(doc)
    next if trig.nil?

    scanned += 1
    wf_dir = doc.dig("defaults", "run", "working-directory")
    (doc["jobs"].is_a?(Hash) ? doc["jobs"] : {}).each do |job_id, job|
      next unless job.is_a?(Hash) && job["steps"].is_a?(Array)

      job_dir = job.dig("defaults", "run", "working-directory") || wf_dir
      job["steps"].each do |step|
        next unless step.is_a?(Hash) && step["run"].is_a?(String) && step["run"].match?(TF_APPLY)

        chdir = step["run"][/-chdir=("[^"]+"|'[^']+'|\S+)/, 1]&.delete("\"'")
        base = step["working-directory"] || job_dir || "."
        dir = chdir ? File.join(base, chdir) : base
        applies << { dir: norm_dir(dir), where: "#{rel} (#{trig.detail}) job #{job_id}" }
      end
    end
  end
  { applies: applies, scanned: scanned, steps: applies.size }
end

# The `./x` module sources declared by the top-level .tf files of `root` at head,
# normalised. Read from the commit being merged, not the working tree. nil when
# `git grep` itself failed (exit >1), so "could not look" never reads as "no
# module" (exit 1 is git grep's genuine no-match).
def module_sources(repo, head, root)
  spec = root == "." ? ":(glob)*.tf" : ":(glob)#{root}/*.tf"
  out, _, st = Open3.capture3("git", "-C", repo, "grep", "-h", "-E", "source[[:space:]]*=", head, "--", spec)
  return nil if st.exitstatus.nil? || st.exitstatus > 1

  out.scan(%r{source\s*=\s*"\./([^"]+)"}).flatten.map { |s| norm_dir(s) }
end

def apply_note(path, roots, repo, head)
  return nil unless path.match?(TF_FILE)

  dir = norm_dir(File.dirname(path))
  if (a = roots[:applies].find { |x| x[:dir] == dir })
    return "AUTO-APPLIED on merge: #{a[:where]} runs `terraform apply` in #{a[:dir]}"
  end

  if (a = roots[:applies].find { |x| x[:dir] == "." || dir.start_with?("#{x[:dir]}/") })
    rel = a[:dir] == "." ? dir : dir.delete_prefix("#{a[:dir]}/")
    mods = module_sources(repo, head, a[:dir])
    if mods.nil?
      return "under auto-applied root #{a[:dir]} (#{a[:where]}); could not read that root's " \
             "module sources at head, so whether merging applies #{dir} is UNKNOWN -- still HOT."
    end
    if mods.any? { |m| rel == m || rel.start_with?("#{m}/") }
      return "AUTO-APPLIED on merge: #{dir} is a module sourced by root #{a[:dir]}, which " \
             "#{a[:where]} applies"
    end

    return "no merge-time `terraform apply` runs in #{dir}: it sits under auto-applied root " \
           "#{a[:dir]} (#{a[:where]}) but that root's top-level .tf files do not source " \
           "./#{rel} as a module. Likely a separate owner-applied root, so merging may be " \
           "inert -- still HOT: an unproven negative fails closed."
  end

  "no merge-time `terraform apply` runs in #{dir} (scanned #{roots[:scanned]} merge-triggered " \
    "workflow(s), #{roots[:steps]} apply step(s): " \
    "#{roots[:applies].map { |x| x[:dir] }.uniq.join(', ').then { |s| s.empty? ? 'none' : s }}). " \
    "Likely owner-applied, so merging may be inert -- still HOT: an unproven negative fails closed."
end

# --- reporting --------------------------------------------------------------

def short(sha)
  sha.to_s[0, 7]
end

def print_report(verdict, head, manifest, surfaces, pattern_count, files, hits, automation, examined = [], notes = {}, refs = nil)
  puts "BLAST-RADIUS #{verdict} #{short(head)}"
  puts "  manifest: #{manifest} (#{surfaces.size} class(es), #{pattern_count} pattern(s))"
  # This line is the failed-lookup doctrine discharged: a zero can always name
  # WHICH key found zero, so "no surface hit" and "the manifest never loaded"
  # can never read the same.
  puts "  compared: #{files.size} changed file(s) against #{pattern_count} pattern(s) -> #{hits.size} hit"
  # Same doctrine, one level deeper. For a CONTENT surface a path match is not a
  # hit, so without this line a migration MR that went COLD could not say whether
  # it examined the migration and found it clean, or never looked at all -- and a
  # file skipped because it is absent at head must not read like a clean one.
  unless examined.to_a.empty?
    puts "  content-examined: #{examined.size} file(s) against content rule(s)"
    examined.each do |e|
      label = { hit: "HIT", miss: "clean", skipped: "skipped" }[e[:verdict]]
      puts "    #{e[:path]}  [#{e[:class]}] #{label}#{e[:detail] ? " -- #{e[:detail]}" : ''}"
    end
  end
  # DND-589: the executed-file set is a lookup too, so it names its key: how
  # many files, from which configs. "None referenced" and "never looked" differ.
  if refs
    puts "  ci-references: #{refs[:files].size} file(s) executed by #{refs[:roots].size} " \
         "merge-time CI config(s)#{refs[:roots].empty? ? '' : " (#{refs[:roots].join(', ')})"}"
    refs[:notes].each { |n| puts "    #{n}" }
  end
  if automation
    puts "  merge-time automation: #{automation[0]} (#{automation[1]})"
  else
    puts "  merge-time automation: not consulted (no declared surface touched)"
  end
  return if hits.empty?

  puts "  hits:"
  width = hits.map { |h| h[:path].length }.max
  hits.each do |h|
    puts format("    %-#{width}s  [%s] %s", h[:path], h[:class], h[:why])
    puts "      via: executed by #{h[:via]} (a merge-time CI config names it, directly or through a file it runs)" if h[:via]
    puts "      apply: #{notes[h[:path]]}" if notes[h[:path]]
  end
end

HOT_FIX = <<~FIX.freeze
  do NOT merge. This is not a code-quality finding and there is no admiral override for it
  -- the authority to spend money, provision or destroy infrastructure, or take a one-way
  action is the OWNER's alone (~/.claude/CLAUDE.md -> Hard Rule, "NEVER make system-level
  changes ... without the user's express direction"). HOLD this ONE MR, move to the next
  Mission (athena:merge-boarding -> "On exit 3 you get a verdict, or you hold that ONE MR"
  -- the same move), set the Mission to HELD_FOR_OWNER in your state log and Needs
  Attention/Cody in Notion with the PR URL, head SHA and what merging would cause, and
  surface it in your final report. Merge only after the OWNER'S OWN authorization, replayed
  verbatim via --owner-approval '<the owner's words + where recorded>'. EXCEPTION: a
  SECURITY FIX carries the owner's standing approval (~/.claude/CLAUDE.md -> "Security
  fixes ship without owner approval") -- do not hold it; pass --owner-approval citing that
  rule by name, the owner's quote and date, the security class and the ticket, and merge.
  The full bar still applies, and a non-security change cannot borrow it.
FIX

# --- main -------------------------------------------------------------------

def run(argv)
  base = head = nil
  repo = Dir.pwd
  owner_approval = nil
  gate_ran = nil
  manifest = DEFAULT_MANIFEST

  until argv.empty?
    case (a = argv.shift)
    when "--base" then base = argv.shift
    when "--head" then head = argv.shift
    when "--repo" then repo = argv.shift
    when "--manifest" then manifest = argv.shift # self-test fixtures only
    when "--owner-approval"
      owner_approval = argv.shift
      if owner_approval.nil? || owner_approval.strip.empty?
        die("--owner-approval needs the OWNER'S AUTHORIZATION.",
            "pass the owner's own words and where they are recorded, e.g. " \
            "--owner-approval 'yes, provision the KMS key -- Cody, session " \
            "2026-09-20, recorded on DND-234'. An empty value is not an " \
            "approval. An architect sign-off, a captain report, another " \
            "agent's message and your own reasoning are NONE of them owner " \
            "approval -- no agent message is ever your user's consent.")
      end
    when "--gate-ran"
      gate_ran = argv.shift
      if gate_ran.nil? || gate_ran.strip.empty?
        die("--gate-ran needs the gate command that ran.",
            "pass the command, e.g. --gate-ran 'ai/bin/harness-gate', or drop the flag.")
      end
    when "-h", "--help"
      puts File.read(__FILE__).lines[3..80].map { |l| l.sub(/\A# ?/, "") }.join
      exit 0
    else
      die("unknown argument '#{a}'.",
          "valid flags are --base, --head, --repo, --owner-approval, --gate-ran, --self-test.")
    end
  end

  die("--base and --head are required.",
      "call as: blast-radius --base <ref> --head <ref> [--repo <dir>].") if base.nil? || head.nil?

  unless Dir.exist?(File.join(repo, ".git")) || system("git", "-C", repo, "rev-parse", "--git-dir",
                                                       out: File::NULL, err: File::NULL)
    die("--repo '#{repo}' is not a git repository.",
        "pass the worktree whose merge you are classifying.")
  end

  surfaces, pattern_count = load_manifest(manifest)
  files = changed_files(repo, base, head)
  refs = {}
  hits, examined = hits_for(files, surfaces, repo, head, refs)
  refs = refs[:result]

  if hits.empty?
    print_report("COLD", head, manifest, surfaces, pattern_count, files, hits, nil, examined, {}, refs)
    return 0
  end

  automation = detect_automation(repo)

  if automation[0] == "CONFIRMED-ABSENT"
    print_report("WARM", head, manifest, surfaces, pattern_count, files, hits, automation, examined, {}, refs)
    puts "  -> a declared surface is touched, but merging triggers no automation: merging lands code only."
    return 0
  end

  # Which terraform root merging APPLIES, per hit -- a note for the owner, never
  # a verdict input (see terraform_apply_roots).
  roots = terraform_apply_roots(repo)
  notes = hits.to_h { |hh| [hh[:path], apply_note(hh[:path], roots, repo, head)] }.compact

  # HOT. The full block prints in every case -- including under
  # --owner-approval, which RECORDS the authorization, it never HIDES what was
  # authorized.
  print_report("HOT", head, manifest, surfaces, pattern_count, files, hits, automation, examined, notes, refs)

  if owner_approval
    gate_note = gate_ran ? " (GATE: #{gate_ran})" : ""
    puts "BLAST-RADIUS HOT-OWNER-APPROVED #{short(head)} (OWNER-APPROVED: #{owner_approval})#{gate_note}"
    return 0
  end

  warn "#{PROG}: MERGING THIS PERFORMS A REAL-WORLD ACTION. Merging is not landing code here."
  warn "Fix: #{HOT_FIX}"
  4
end

# --- self-test --------------------------------------------------------------

def self_test
  failures = []
  n = 0
  ok = lambda { |desc| n += 1; puts "  ok    #{desc}" }
  bad = lambda { |desc, detail| n += 1; failures << desc; puts "  FAIL  #{desc}\n        #{detail}" }
  check = lambda { |desc, cond, detail| cond ? ok.call(desc) : bad.call(desc, detail) }

  script = File.expand_path(__FILE__)

  # Run the script as a subprocess so exit codes and stderr are exercised
  # exactly as integration-gate will see them.
  run_br = lambda do |args|
    out, err, st = Open3.capture3(RbConfig.ruby, script, *args)
    [out, err, st.exitstatus]
  end

  # `seed:` files land in the BASE commit; the block's files land in the DIFF.
  # The distinction is load-bearing: a workflow created inside the diff is itself
  # a deploy-automation hit, so a COLD fixture must have its workflow already
  # present at base. (That mistake made three cases fail on the first run here.)
  # `config:` pins repo-local git config (it overrides the user's global), so a
  # case that depends on a git default -- rename detection, path quoting -- is
  # measured against that default and not against this machine's ~/.gitconfig.
  mkrepo = lambda do |dir, seed: nil, config: {}, &blk|
    FileUtils.mkdir_p(dir)
    system("git", "-C", dir, "init", "-q", "-b", "main", out: File::NULL, err: File::NULL)
    system("git", "-C", dir, "config", "user.email", "t@t")
    system("git", "-C", dir, "config", "user.name", "t")
    config.each { |k, v| system("git", "-C", dir, "config", k, v) }
    # A global core.excludesFile can otherwise silently exclude fixture files.
    system("git", "-C", dir, "config", "core.excludesFile", "/dev/null")
    File.write(File.join(dir, "README.md"), "seed\n")
    seed&.call(dir)
    system("git", "-C", dir, "add", "-A", out: File::NULL, err: File::NULL)
    system("git", "-C", dir, "commit", "-qm", "seed", out: File::NULL, err: File::NULL)
    base = `git -C #{dir} rev-parse HEAD`.strip
    blk.call(dir)
    system("git", "-C", dir, "add", "-A", out: File::NULL, err: File::NULL)
    system("git", "-C", dir, "commit", "-qm", "change", out: File::NULL, err: File::NULL)
    head = `git -C #{dir} rev-parse HEAD`.strip
    [base, head]
  end

  wf = lambda do |dir, name, body|
    FileUtils.mkdir_p(File.join(dir, ".github", "workflows"))
    File.write(File.join(dir, ".github", "workflows", name), body)
  end

  deploy_wf = "name: post-merge\non:\n  push:\n    branches: [main]\njobs:\n  d:\n    runs-on: ubuntu-latest\n    steps: [{run: terraform apply -auto-approve}]\n"
  pr_wf     = "name: ci\non:\n  pull_request:\njobs:\n  t:\n    runs-on: ubuntu-latest\n    steps: [{run: test}]\n"

  Dir.mktmpdir("blast-radius-selftest") do |tmp|
    # 1. the REAL manifest loads and is non-trivial
    surfaces, pc = nil
    begin
      surfaces, pc = load_manifest(DEFAULT_MANIFEST)
      check.call("the committed manifest loads with >=1 class and >=1 pattern",
                 !surfaces.empty? && pc.positive?,
                 "loaded #{surfaces.inspect}")
    rescue SystemExit
      bad.call("the committed manifest loads with >=1 class and >=1 pattern",
               "load_manifest exited on #{DEFAULT_MANIFEST}")
    end

    # 4. COLD: app code only, in a deploy-on-merge repo
    d = File.join(tmp, "cold")
    b, h = mkrepo.call(d, seed: ->(r) { wf.call(r, "post-merge.yml", deploy_wf) }) { |r| FileUtils.mkdir_p(File.join(r, "lib")); File.write(File.join(r, "lib", "a.ex"), "x\n") }
    out, _, code = run_br.call(["--base", b, "--head", h, "--repo", d])
    check.call("COLD: app-code diff in a deploy-on-merge repo exits 0",
               code.zero? && out.include?("BLAST-RADIUS COLD"), "exit=#{code} out=#{out}")
    check.call("COLD: prints the compared/pattern counts and -> 0 hit (a zero names its key)",
               out.include?("-> 0 hit") && out =~ /compared: \d+ changed file\(s\) against \d+ pattern\(s\)/,
               out)
    check.call("COLD: the automation term is NOT consulted on the cold path",
               out.include?("not consulted"), out)

    # 5. HOT: .tf under a subdir + deploy workflow
    d = File.join(tmp, "hot")
    b, h = mkrepo.call(d, seed: ->(r) { wf.call(r, "post-merge.yml", deploy_wf) }) { |r| FileUtils.mkdir_p(File.join(r, "infra")); File.write(File.join(r, "infra", "kms.tf"), "resource\n") }
    out, err, code = run_br.call(["--base", b, "--head", h, "--repo", d])
    check.call("HOT: .tf + default-branch push workflow exits 4",
               code == 4 && out.include?("BLAST-RADIUS HOT"), "exit=#{code} out=#{out}")
    check.call("HOT: names the file, the class and the workflow",
               out.include?("infra/kms.tf") && out.include?("infrastructure-as-code") && out.include?("post-merge.yml"),
               out)
    check.call("HOT: stderr carries an actionable Fix:", err.include?("Fix:"), err)

    # 6. ROOT-level main.tf — pins the `**/` depth-0 fnmatch trap
    d = File.join(tmp, "root-tf")
    b, h = mkrepo.call(d, seed: ->(r) { wf.call(r, "post-merge.yml", deploy_wf) }) { |r| File.write(File.join(r, "main.tf"), "resource\n") }
    out, _, code = run_br.call(["--base", b, "--head", h, "--repo", d])
    check.call("HOT: a REPO-ROOT main.tf matches `**/*.tf` (depth-0 trap)",
               code == 4 && out.include?("main.tf"), "exit=#{code} out=#{out}")

    # 6b. DOT-DIRECTORY terraform (DND-422). Without FNM_DOTMATCH, `**/` never
    # descends into a dot-prefixed directory, so gen_saas's real, auto-applied
    # root .pkg/prod/tf read COLD: an irreversible credential rotation (#326)
    # would have merged without the owner stop had the PR not also touched a
    # workflow. The diff here touches ONLY the tf file -- nothing else can
    # rescue the verdict.
    d = File.join(tmp, "dotdir-tf")
    b, h = mkrepo.call(d, seed: ->(r) { wf.call(r, "post-merge.yml", deploy_wf) }) do |r|
      FileUtils.mkdir_p(File.join(r, ".pkg", "prod", "tf"))
      File.write(File.join(r, ".pkg", "prod", "tf", "main.tf"), "resource\n")
    end
    out, _, code = run_br.call(["--base", b, "--head", h, "--repo", d])
    check.call("HOT: a DOT-DIR .pkg/prod/tf/main.tf matches `**/*.tf` (FNM_DOTMATCH trap, DND-422)",
               code == 4 && out.include?(".pkg/prod/tf/main.tf") && out.include?("infrastructure-as-code"),
               "exit=#{code} out=#{out}")

    # 6c. The class, not the site: EVERY pattern in the committed manifest must
    # match a path that reaches it through dot-prefixed directories, with a
    # dot-prefixed leaf where the leaf is a wildcard, and at more than one level
    # below a trailing `/**` -- plain and dotted. A sample is BUILT from each
    # pattern, so a pattern added later is covered with no new case.
    unmatched = []
    sampled = 0
    begin
      load_manifest(DEFAULT_MANIFEST)[0].each do |s|
        (s["patterns"] || []).each do |p|
          [[".hidden/.deep/", ".a/.b/.c", ".x"], ["hidden/deep/", "a/b/c", "x"]].each do |lead, deep, leaf|
            sample = p.sub(%r{\A\*\*/}, lead).gsub("**", deep).gsub("*", leaf)
            sampled += 1
            unmatched << [p, sample] unless match?(p, sample)
          end
        end
      end
      check.call("every manifest pattern matches through dot-dirs and at depth below a trailing `/**` (#{sampled} samples)",
                 sampled.positive? && unmatched.empty?,
                 "unmatched (pattern -> sample): #{unmatched.inspect}")
    rescue SystemExit
      bad.call("every manifest pattern matches through dot-dirs and at depth below a trailing `/**`",
               "load_manifest exited on #{DEFAULT_MANIFEST}")
    end

    # 6d. A dot-prefixed workflow FILE is still a workflow. Missing it would make
    # the automation term CONFIRMED-ABSENT (a WARM pass) for a repo that deploys.
    d = File.join(tmp, "dot-wf")
    b, h = mkrepo.call(d, seed: ->(r) { wf.call(r, ".post-merge.yml", deploy_wf) }) { |r| File.write(File.join(r, "main.tf"), "x\n") }
    out, _, code = run_br.call(["--base", b, "--head", h, "--repo", d])
    check.call("HOT: a DOT-PREFIXED workflow file is parsed (never a false CONFIRMED-ABSENT)",
               code == 4 && out.include?(".post-merge.yml"), "exit=#{code} out=#{out}")

    # 6e. Auto-applied vs owner-applied terraform roots (DND-408/DND-422). The
    # workflow says which root merging APPLIES; each tf hit names it. This is a
    # NOTE, never a downgrade: a root with no merge-time apply is still HOT,
    # because "no apply step found" is an unproven negative (a module of the
    # applied root, a script the parse cannot see) and fails closed.
    apply_wf = "name: post-merge\non:\n  push:\n    branches: [main]\njobs:\n  terraform:\n    runs-on: ubuntu-latest\n    steps:\n" \
               "      - name: Init\n        working-directory: .pkg/prod/tf\n        run: terraform init\n" \
               "      - name: Apply\n        working-directory: .pkg/prod/tf\n        run: terraform apply -auto-approve\n"
    d = File.join(tmp, "apply-roots")
    b, h = mkrepo.call(d, seed: ->(r) { wf.call(r, "post-merge.yml", apply_wf) }) do |r|
      %w[.pkg/prod/tf .pkg/prod/tf/kms].each { |dir| FileUtils.mkdir_p(File.join(r, dir)) }
      File.write(File.join(r, ".pkg/prod/tf/main.tf"), "resource\n")
      File.write(File.join(r, ".pkg/prod/tf/kms/main.tf"), "resource\n")
    end
    out, _, code = run_br.call(["--base", b, "--head", h, "--repo", d])
    check.call("apply roots: an auto-applied root AND an owner-applied root are both HOT",
               code == 4 && out.include?(".pkg/prod/tf/main.tf") && out.include?(".pkg/prod/tf/kms/main.tf"),
               "exit=#{code} out=#{out}")
    check.call("apply roots: the auto-applied root is named with its workflow and job",
               out.match?(%r{\.pkg/prod/tf/main\.tf.*\n\s+apply: AUTO-APPLIED on merge: .*post-merge\.yml.*job terraform}),
               out)
    check.call("apply roots: a root with no merge-time apply says so and stays HOT (fails closed)",
               out.match?(%r{\.pkg/prod/tf/kms/main\.tf.*\n\s+apply: no merge-time `terraform apply` runs in \.pkg/prod/tf/kms}) &&
                 out.include?("still HOT"),
               out)

    # 6f. A subdirectory the applied root SOURCES as a module is applied on merge
    # too; the note must not call it owner-applied.
    d = File.join(tmp, "apply-module")
    b, h = mkrepo.call(d, seed: lambda { |r|
      wf.call(r, "post-merge.yml", apply_wf)
      FileUtils.mkdir_p(File.join(r, ".pkg/prod/tf"))
      File.write(File.join(r, ".pkg/prod/tf/main.tf"), "module \"vpc\" {\n  source = \"./vpc\"\n}\n")
    }) do |r|
      FileUtils.mkdir_p(File.join(r, ".pkg/prod/tf/vpc"))
      File.write(File.join(r, ".pkg/prod/tf/vpc/main.tf"), "resource\n")
    end
    out, _, code = run_br.call(["--base", b, "--head", h, "--repo", d])
    check.call("apply roots: a module the applied root sources is named AUTO-APPLIED",
               code == 4 && out.match?(%r{\.pkg/prod/tf/vpc/main\.tf.*\n\s+apply: AUTO-APPLIED on merge: \.pkg/prod/tf/vpc is a module sourced by root \.pkg/prod/tf}),
               "exit=#{code} out=#{out}")

    # 6g. DND-590: a SCHEDULED apply applies the merged root too. The note
    # names the trigger, so "AUTO-APPLIED" never reads as "on the merge push"
    # when it is a cron.
    sched_apply = apply_wf.sub("on:\n  push:\n    branches: [main]\n", "on:\n  schedule:\n    - cron: '0 3 * * *'\n")
    d = File.join(tmp, "apply-schedule")
    b, h = mkrepo.call(d, seed: ->(r) { wf.call(r, "drift.yml", sched_apply) }) do |r|
      FileUtils.mkdir_p(File.join(r, ".pkg/prod/tf"))
      File.write(File.join(r, ".pkg/prod/tf/main.tf"), "resource\n")
    end
    out, _, code = run_br.call(["--base", b, "--head", h, "--repo", d])
    check.call("apply roots: a SCHEDULED apply is AUTO-APPLIED and the note names the trigger (DND-590)",
               code == 4 && out.match?(%r{\.pkg/prod/tf/main\.tf.*\n\s+apply: AUTO-APPLIED on merge: .*drift\.yml \(on\.schedule\) job terraform}),
               "exit=#{code} out=#{out}")

    # 7. WARM: .tf but no CI at all
    d = File.join(tmp, "warm")
    b, h = mkrepo.call(d) { |r| File.write(File.join(r, "main.tf"), "resource\n") }
    out, _, code = run_br.call(["--base", b, "--head", h, "--repo", d])
    check.call("WARM: .tf with no CI config exits 0 as CONFIRMED-ABSENT",
               code.zero? && out.include?("BLAST-RADIUS WARM") && out.include?("CONFIRMED-ABSENT"),
               "exit=#{code} out=#{out}")

    # 8. UNDETERMINED: unparseable workflow YAML fails CLOSED
    d = File.join(tmp, "badyaml")
    b, h = mkrepo.call(d, seed: ->(r) { wf.call(r, "broken.yml", "on: [\n  unclosed\n") }) { |r| File.write(File.join(r, "main.tf"), "x\n") }
    out, _, code = run_br.call(["--base", b, "--head", h, "--repo", d])
    check.call("UNDETERMINED: unparseable workflow YAML fails CLOSED (exit 4)",
               code == 4 && out.include?("UNDETERMINED") && out.include?("broken.yml"),
               "exit=#{code} out=#{out}")

    # 9. UNDETERMINED: an unmodelled forge shape
    d = File.join(tmp, "jenkins")
    b, h = mkrepo.call(d, seed: ->(r) { File.write(File.join(r, "Jenkinsfile"), "pipeline{}\n") }) { |r| File.write(File.join(r, "main.tf"), "x\n") }
    out, _, code = run_br.call(["--base", b, "--head", h, "--repo", d])
    check.call("UNDETERMINED: an unmodelled forge (Jenkinsfile) fails CLOSED (exit 4)",
               code == 4 && out.include?("UNDETERMINED"), "exit=#{code} out=#{out}")

    # 10. GitLab: absence not provable -> CONFIRMED
    d = File.join(tmp, "gitlab")
    b, h = mkrepo.call(d, seed: ->(r) { File.write(File.join(r, ".gitlab-ci.yml"), "stages: [deploy]\n") }) { |r| File.write(File.join(r, "main.tf"), "x\n") }
    out, _, code = run_br.call(["--base", b, "--head", h, "--repo", d])
    check.call("GitLab: .gitlab-ci.yml is CONFIRMED (absence is not provable there)",
               code == 4 && out.include?("CONFIRMED") && out.include?("not provable"),
               "exit=#{code} out=#{out}")

    # 11. A pull_request-only workflow must NOT read as a deploy
    d = File.join(tmp, "pronly")
    b, h = mkrepo.call(d, seed: ->(r) { wf.call(r, "ci.yml", pr_wf) }) { |r| File.write(File.join(r, "main.tf"), "x\n") }
    out, _, code = run_br.call(["--base", b, "--head", h, "--repo", d])
    check.call("WARM: a pull_request-only workflow is not a deploy (trigger parse discriminates)",
               code.zero? && out.include?("BLAST-RADIUS WARM"), "exit=#{code} out=#{out}")

    # 11b. DND-590: every trigger that later runs the MERGED workflow with the
    # default branch's secrets is merge-time automation, not only push and
    # workflow_run. Each fixture's ONLY workflow uses one such trigger; before
    # DND-590 each read CONFIRMED-ABSENT (WARM, exit 0).
    trig_n = 0
    trig_case = lambda do |on_yaml|
      trig_n += 1
      d = File.join(tmp, "trig#{trig_n}")
      body = "name: t\n#{on_yaml}jobs:\n  j:\n    runs-on: ubuntu-latest\n    steps: [{run: echo}]\n"
      b, h = mkrepo.call(d, seed: ->(r) { wf.call(r, "t.yml", body) }) { |r| File.write(File.join(r, "main.tf"), "x\n") }
      run_br.call(["--base", b, "--head", h, "--repo", d])
    end
    [["schedule",            "on:\n  schedule:\n    - cron: '0 0 * * *'\n", "schedule"],
     ["workflow_dispatch",   "on:\n  workflow_dispatch:\n", "workflow_dispatch"],
     ["release",             "on:\n  release:\n    types: [published]\n", "release"],
     ["pull_request_target", "on:\n  pull_request_target:\n", "pull_request_target"],
     ["repository_dispatch", "on: repository_dispatch\n", "repository_dispatch"],
     ["issues (any non-PR event runs default-branch code)", "on: [issues]\n", "issues"],
     ["workflow_call (callers outside this repo are invisible)", "on:\n  workflow_call:\n", "workflow_call"],
     ["an UNKNOWN event name (fails wide, never absent)", "on: [some_future_event]\n", "some_future_event"],
     ["push with a GLOB branch filter (`**`)", "on:\n  push:\n    branches: ['**']\n", "**"],
     ["push with a NEGATED branch filter", "on:\n  push:\n    branches: ['*', '!wip/**']\n", "!wip/**"],
     ["push to a non-default branch OR a tag", "on:\n  push:\n    branches: [staging]\n    tags: ['v*']\n", "tags"]].each do |label, on_yaml, word|
      out, _, code = trig_case.call(on_yaml)
      check.call("HOT: a sole workflow triggered by #{label} is merge-time automation, never CONFIRMED-ABSENT (DND-590)",
                 code == 4 && out.include?("BLAST-RADIUS HOT") && out.include?("CONFIRMED") &&
                   !out.include?("CONFIRMED-ABSENT") && out.include?(word),
                 "exit=#{code} out=#{out}")
    end
    # An `on:` shape the parser does not model is UNDETERMINED (exit 4), never
    # read as "no trigger" -- the failed-lookup class.
    [["a scalar that is not an event name (`on: 42`)", "on: 42\n"],
     ["a list holding a non-string (`on: [{push: x}]`)", "on:\n  - push: x\n"],
     ["a MISSING `on:` key", ""],
     ["an EMPTY `on:`", "on:\n"],
     ["a push.branches filter that is not a list of strings", "on:\n  push:\n    branches: {main: true}\n"]].each do |label, on_yaml|
      out, _, code = trig_case.call(on_yaml)
      check.call("UNDETERMINED: #{label} fails CLOSED, never CONFIRMED-ABSENT (DND-590)",
                 code == 4 && out.include?("UNDETERMINED") && out.include?("t.yml") &&
                   !out.include?("CONFIRMED-ABSENT"),
                 "exit=#{code} out=#{out}")
    end
    # A determined trigger beside an unmodelled one reads CONFIRMED, not
    # UNDETERMINED: the known hit is the stronger, more useful statement.
    out, _, code = trig_case.call("on:\n  push:\n    branches: {main: true}\n  schedule:\n    - cron: '0 0 * * *'\n")
    check.call("CONFIRMED: a known trigger wins over an unmodelled sibling in one `on:` (DND-590)",
               code == 4 && out.include?("CONFIRMED") && !out.include?("UNDETERMINED") && out.include?("on.schedule"),
               "exit=#{code} out=#{out}")
    # Pre-merge triggers stay excluded: they run the PR's OWN head (or the
    # merge-queue candidate) before it lands, so merging changes nothing they
    # execute. Pinned so the widening above cannot swallow them.
    [["merge_group", "on:\n  merge_group:\n"],
     ["pull_request_review", "on: [pull_request_review]\n"],
     ["pull_request + pull_request_review_comment + merge_group", "on: [pull_request, pull_request_review_comment, merge_group]\n"],
     ["push to a NON-default branch only", "on:\n  push:\n    branches: [staging]\n"]].each do |label, on_yaml|
      out, _, code = trig_case.call(on_yaml)
      check.call("WARM: a sole workflow triggered by #{label} is NOT merge-time automation (DND-590)",
                 code.zero? && out.include?("BLAST-RADIUS WARM") && out.include?("CONFIRMED-ABSENT"),
                 "exit=#{code} out=#{out}")
    end

    # 12. deploy-automation class: touching the workflow itself
    d = File.join(tmp, "wfchange")
    b, h = mkrepo.call(d) { |r| wf.call(r, "post-merge.yml", deploy_wf) }
    out, _, code = run_br.call(["--base", b, "--head", h, "--repo", d])
    check.call("HOT: changing .github/workflows/** is the deploy-automation class",
               code == 4 && out.include?("deploy-automation"), "exit=#{code} out=#{out}")

    # 12b-12p. deploy-automation: every file merge-time CI EXECUTES by relative
    # path (DND-589, the DND-422 class). The class covered only the CI config
    # files themselves, so a local action (`uses: ./...`), a script a deploy
    # step runs, or a GitLab `include: local:` file read COLD: editing
    # gen_saas's .pkg/prod/bin/deploy-guard.sh -- the guard that refuses stale
    # prod deploys -- merged with no owner stop. Each case's diff touches ONLY
    # the executed file, so nothing else can rescue the verdict.
    ci_n = 0
    ci_case = lambda do |seed:, change:|
      ci_n += 1
      d = File.join(tmp, "ci-ref#{ci_n}")
      b2, h2 = mkrepo.call(d, seed: seed) { |r| change.call(r) }
      run_br.call(["--base", b2, "--head", h2, "--repo", d])
    end
    put = lambda do |r, path, body = "x\n"|
      FileUtils.mkdir_p(File.dirname(File.join(r, path)))
      File.write(File.join(r, path), body)
    end
    deploy_run = lambda do |steps, extra = ""|
      "name: post-merge\non:\n  push:\n    branches: [main]\n#{extra}jobs:\n  d:\n    runs-on: ubuntu-latest\n    steps:\n#{steps}"
    end
    hot_ci = lambda do |desc, seed, path, via = nil|
      out, _, code = ci_case.call(seed: seed, change: ->(r) { put.call(r, path, "changed\n") })
      check.call(desc,
                 code == 4 && out.include?("BLAST-RADIUS HOT") && out.include?(path) &&
                   out.include?("deploy-automation") && (via.nil? || out.include?(via)),
                 "exit=#{code} out=#{out}")
    end
    cold_ci = lambda do |desc, seed, path|
      out, _, code = ci_case.call(seed: seed, change: ->(r) { put.call(r, path, "changed\n") })
      check.call(desc, code.zero? && out.include?("BLAST-RADIUS COLD"), "exit=#{code} out=#{out}")
    end
    deploy_seed = ->(r) { wf.call(r, "post-merge.yml", deploy_wf) }

    # 12r-12w. the changed-path LISTING itself (DND-770, the DND-422 class).
    # `git diff --name-only` applies rename detection by default, so a rename
    # listed only its NEW path: `git mv .github/workflows/post-merge.yml
    # docs.txt` read COLD, and any surface file could be moved out of its
    # pattern with no owner stop. Both sides of a rename or copy are changes.
    # Each case pins the git default it depends on in the fixture repo, so a
    # user config (diff.renames=false, core.quotePath=false) can neither mask
    # the defect here nor rescue the fix.
    renames_on = { "diff.renames" => "true" }
    tf_body = (1..20).map { |i| "resource \"null_resource\" \"r#{i}\" {}\n" }.join
    # Block-local names only: assigning `out`/`code`/`d` in here would rebind
    # the enclosing scope's, and a later call would overwrite an earlier case's
    # result before it is checked.
    listing_case = lambda do |name, seed:, config: renames_on, &change|
      dir = File.join(tmp, name)
      lb, lh = mkrepo.call(dir, seed: seed, config: config) { |r| change.call(r) }
      lo, le, lc = run_br.call(["--base", lb, "--head", lh, "--repo", dir])
      [lo, le, lc, dir, lb, lh]
    end
    git_mv = ->(r, from, to) { FileUtils.mkdir_p(File.dirname(File.join(r, to))); system("git", "-C", r, "mv", from, to) }
    two_wf_seed = lambda do |r|
      wf.call(r, "post-merge.yml", deploy_wf)
      wf.call(r, "guard.yml", deploy_wf)
    end

    out, _, code, = listing_case.call("rn-out", seed: two_wf_seed) { |r| git_mv.call(r, ".github/workflows/guard.yml", "docs.txt") }
    check.call("HOT: a workflow RENAMED OUT of .github/workflows is deploy-automation (DND-770)",
               code == 4 && out.include?(".github/workflows/guard.yml") && out.include?("deploy-automation"),
               "exit=#{code} out=#{out}")
    check.call("rename: BOTH paths are listed as changed (compared: 2)",
               out.include?("compared: 2 changed file(s)"), out)

    # The ticket's exact fixture: the SOLE deploy workflow renamed out. It must
    # read as the plain `git rm` of that file does -- WARM, naming the path
    # (no workflow is left at head, so merging triggers nothing) -- never COLD.
    out, _, code, = listing_case.call("rn-sole", seed: deploy_seed) { |r| git_mv.call(r, ".github/workflows/post-merge.yml", "docs.txt") }
    out_rm, _, code_rm, = listing_case.call("rm-sole", seed: deploy_seed) { |r| system("git", "-C", r, "rm", "-q", ".github/workflows/post-merge.yml") }
    check.call("the SOLE deploy workflow renamed out reads as its deletion does (WARM, named), never COLD (DND-770)",
               code.zero? && code_rm.zero? && out.include?("BLAST-RADIUS WARM") && out_rm.include?("BLAST-RADIUS WARM") &&
                 out.include?(".github/workflows/post-merge.yml"),
               "rename: exit=#{code} out=#{out}\n        delete: exit=#{code_rm} out=#{out_rm}")

    out, _, code, = listing_case.call("rn-tf-out", seed: ->(r) { deploy_seed.call(r); put.call(r, "infra/kms.tf", tf_body) }) { |r| git_mv.call(r, "infra/kms.tf", "notes.txt") }
    check.call("HOT: an IaC file RENAMED OUT of its pattern is infrastructure-as-code (DND-770)",
               code == 4 && out.include?("infra/kms.tf") && out.include?("infrastructure-as-code"),
               "exit=#{code} out=#{out}")

    out, _, code, = listing_case.call("rn-into", seed: ->(r) { deploy_seed.call(r); put.call(r, "docs.yml", pr_wf) }) { |r| git_mv.call(r, "docs.yml", ".github/workflows/ci.yml") }
    check.call("HOT: a file renamed INTO .github/workflows lists both paths (DND-770)",
               code == 4 && out.include?(".github/workflows/ci.yml") && out.include?("compared: 2 changed file(s)"),
               "exit=#{code} out=#{out}")

    copies_on = { "diff.renames" => "copies" }
    out, _, code, = listing_case.call("cp-out", seed: ->(r) { deploy_seed.call(r); put.call(r, "infra/kms.tf", tf_body) }, config: copies_on) do |r|
      put.call(r, "notes.txt", tf_body)
      FileUtils.rm_f(File.join(r, "infra", "kms.tf"))
    end
    check.call("HOT: an IaC file COPIED out and removed, under diff.renames=copies, names its old path (DND-770)",
               code == 4 && out.include?("infra/kms.tf"), "exit=#{code} out=#{out}")
    # A copy whose source stays is a regression guard, not a fail-first case:
    # copy detection only pairs a source that is itself modified, so the
    # source is listed either way. It pins that the fix does not drop it.
    out, _, code, = listing_case.call("cp-keep", seed: ->(r) { deploy_seed.call(r); put.call(r, "infra/kms.tf", tf_body) }, config: copies_on) do |r|
      put.call(r, "notes.txt", tf_body)
      put.call(r, "infra/kms.tf", tf_body + "resource \"null_resource\" \"extra\" {}\n")
    end
    check.call("HOT: a COPIED IaC file whose source is edited lists both paths",
               code == 4 && out.include?("infra/kms.tf") && out.include?("compared: 2 changed file(s)"),
               "exit=#{code} out=#{out}")

    out, _, code, = listing_case.call("rn-edit", seed: two_wf_seed) do |r|
      git_mv.call(r, ".github/workflows/guard.yml", "docs.txt")
      File.write(File.join(r, "docs.txt"), "#{deploy_wf}# retired\n")
    end
    check.call("HOT: a workflow renamed out AND edited (R<100) is deploy-automation (DND-770)",
               code == 4 && out.include?(".github/workflows/guard.yml"), "exit=#{code} out=#{out}")

    # core.quotePath (default true) prints a non-ASCII path as a C-quoted
    # string, `"infra/km\305\233.tf"`, which no pattern matches.
    quoted = { "core.quotePath" => "true" }
    out, _, code, = listing_case.call("quoted", seed: deploy_seed, config: quoted) { |r| put.call(r, "infra/km\u015b.tf", "resource\n") }
    check.call("HOT: a non-ASCII IaC path is matched verbatim, never as a quoted string (DND-770)",
               code == 4 && out.include?("infra/km\u015b.tf"), "exit=#{code} out=#{out}")

    # Sabotage: the rename cases above must discriminate. A copy of this
    # script without --no-renames must read the rename-out case COLD; if it
    # does not, the cases prove nothing about the flag.
    src = File.read(script)
    site = "%w[diff --no-renames -z --name-only]"
    site_ok = src.index(site) && src.index(site) < src.index("def self_test")
    mutant_src = site_ok ? src.sub(site, "%w[diff -z --name-only]") : src
    mutant = File.join(tmp, "blast-radius-no-renames-mutant")
    File.write(mutant, mutant_src)
    _, _, _, rd, rb, rh = listing_case.call("rn-sabotage", seed: two_wf_seed) { |r| git_mv.call(r, ".github/workflows/guard.yml", "docs.txt") }
    mout, _, mst = Open3.capture3(RbConfig.ruby, mutant, "--base", rb, "--head", rh, "--repo", rd, "--manifest", DEFAULT_MANIFEST)
    check.call("sabotage: without --no-renames the rename-out case reads COLD (the cases discriminate)",
               mutant_src != src && mst.exitstatus.zero? && mout.include?("BLAST-RADIUS COLD"),
               "mutated=#{mutant_src != src} exit=#{mst.exitstatus} out=#{mout}")

    # The ticket's own case: a composite action under .github/actions, which the
    # workflow does not even have to name -- the conventional location is enough.
    hot_ci.call("HOT: .github/actions/deploy/action.yml is deploy-automation (DND-589)",
                deploy_seed, ".github/actions/deploy/action.yml")
    hot_ci.call("HOT: a script INSIDE .github/actions/** is deploy-automation",
                deploy_seed, ".github/actions/deploy/entrypoint.sh")
    hot_ci.call("HOT: an action.yaml OUTSIDE .github (a `uses: ./tools/release` target) is deploy-automation",
                deploy_seed, "tools/release/action.yaml")
    # A local action's other files -- its Dockerfile, its JS entry point -- are
    # executed too; the workflow names only the directory.
    hot_ci.call("HOT: a Dockerfile beside a local action a deploy workflow `uses: ./` is deploy-automation",
                lambda { |r|
                  put.call(r, "tools/release/action.yml", "runs:\n  using: docker\n  image: Dockerfile\n")
                  put.call(r, "tools/release/Dockerfile", "FROM x\n")
                  wf.call(r, "post-merge.yml", deploy_run.call("      - uses: ./tools/release\n"))
                },
                "tools/release/Dockerfile", ".github/workflows/post-merge.yml")
    # gen_saas's real shape: the deploy workflow runs .pkg/prod/bin/deploy-guard.sh.
    hot_ci.call("HOT: a script a deploy workflow `run:`s by relative path is deploy-automation (names the referrer)",
                lambda { |r|
                  put.call(r, ".pkg/prod/bin/deploy-guard.sh", "#!/bin/sh\n")
                  wf.call(r, "post-merge.yml", deploy_run.call("      - run: .pkg/prod/bin/deploy-guard.sh --require-tip main\n"))
                },
                ".pkg/prod/bin/deploy-guard.sh", ".github/workflows/post-merge.yml")
    hot_ci.call("HOT: a `${{ github.workspace }}/scripts/ship.sh` reference resolves to the repo file",
                lambda { |r|
                  put.call(r, "scripts/ship.sh")
                  wf.call(r, "post-merge.yml", deploy_run.call("      - run: bash ${{ github.workspace }}/scripts/ship.sh\n"))
                },
                "scripts/ship.sh")
    hot_ci.call("HOT: `./rollout.sh` under `working-directory: ops` resolves to ops/rollout.sh",
                lambda { |r|
                  put.call(r, "ops/rollout.sh")
                  wf.call(r, "post-merge.yml",
                          deploy_run.call("      - run: ./rollout.sh\n        working-directory: ops\n"))
                },
                "ops/rollout.sh")
    # A deploy script that calls another script: the callee is executed on merge
    # just the same, and nothing in the workflow names it.
    hot_ci.call("HOT: a script called only BY a referenced script is deploy-automation (transitive)",
                lambda { |r|
                  put.call(r, "bin/deploy.sh", "#!/bin/sh\n. bin/lib/push.sh\n")
                  put.call(r, "bin/lib/push.sh")
                  wf.call(r, "post-merge.yml", deploy_run.call("      - run: bin/deploy.sh\n"))
                },
                "bin/lib/push.sh", "bin/deploy.sh")
    # GitLab's analogue of a reusable workflow: `include: local:` outside
    # .gitlab/ci -- walt_ui includes backend/.pkg/gitlab/terraform-aws.yml.
    gl_seed = lambda do |r|
      put.call(r, ".gitlab-ci.yml", "include:\n  - local: /ci/deploy.yml\n")
      put.call(r, "ci/deploy.yml", "deploy:\n  script:\n    - scripts/release.sh\n")
      put.call(r, "scripts/release.sh")
    end
    hot_ci.call("HOT: a GitLab `include: local:` file is deploy-automation", gl_seed, "ci/deploy.yml", ".gitlab-ci.yml")
    hot_ci.call("HOT: a script an INCLUDED GitLab file runs is deploy-automation", gl_seed, "scripts/release.sh", "ci/deploy.yml")

    # The miss. A path that merely LOOKS like an action, or a script no
    # merge-time CI references, must stay COLD -- a gate that fires on every
    # feature MR is bypassed in practice, which is a weakening in effect.
    ref_seed = lambda do |r|
      put.call(r, "scripts/ship.sh")
      put.call(r, "scripts/other.sh")
      wf.call(r, "post-merge.yml",
              deploy_run.call("      - uses: actions/cache@v4\n        with:\n          key: ${{ hashFiles('**/mix.lock') }}\n      - run: scripts/ship.sh\n"))
    end
    cold_ci.call("COLD: lib/actions/action_helper.ex is not an action", ref_seed, "lib/actions/action_helper.ex")
    cold_ci.call("COLD: docs/github-actions.md is not an action", ref_seed, "docs/github-actions.md")
    cold_ci.call("COLD: a script beside a referenced one, but itself unreferenced", ref_seed, "scripts/other.sh")
    cold_ci.call("COLD: a file named only inside a glob (`hashFiles('**/mix.lock')`) is not executed",
                 ->(r) { ref_seed.call(r); put.call(r, "mix.lock") }, "mix.lock")
    # The same glob OUTSIDE a `${{ }}` expression, which the expansion strip
    # does not remove: only the `*` lookbehind keeps it out.
    cold_ci.call("COLD: a file named only inside a bare shell glob (`**/mix.lock`) is not executed",
                 lambda { |r|
                   put.call(r, "mix.lock")
                   wf.call(r, "post-merge.yml", deploy_run.call("      - run: sha256sum **/mix.lock > lock.sum\n"))
                 },
                 "mix.lock")
    # A DATA file a deploy step reads is a hit, but it is not followed: what it
    # names is not executed by naming.
    data_seed = lambda do |r|
      put.call(r, "deploy/settings.json", "{\"hook\": \"lib/other.sh\"}\n")
      put.call(r, "lib/other.sh")
      wf.call(r, "post-merge.yml", deploy_run.call("      - run: jq . deploy/settings.json\n"))
    end
    hot_ci.call("HOT: a data file a deploy step reads is deploy-automation", data_seed, "deploy/settings.json")
    cold_ci.call("COLD: a path named only INSIDE a data file is not followed", data_seed, "lib/other.sh")
    # A pull_request workflow runs the PR's OWN head before merge; merging does
    # not change what it executes. Only merge-triggered roots count.
    cold_ci.call("COLD: a script referenced ONLY by a pull_request workflow",
                 lambda { |r|
                   put.call(r, "scripts/lint.sh")
                   wf.call(r, "ci.yml", "name: ci\non:\n  pull_request:\njobs:\n  t:\n    runs-on: ubuntu-latest\n    steps:\n      - run: scripts/lint.sh\n")
                 },
                 "scripts/lint.sh")
    # DND-590: the reference ROOTS widen with trigger_hit. A script a schedule,
    # workflow_dispatch or pull_request_target workflow runs executes the MERGED
    # copy with the default branch's secrets, so it is deploy-automation too.
    trig_root = lambda do |on_yaml|
      lambda do |r|
        put.call(r, "scripts/job.sh")
        wf.call(r, "t.yml", "name: t\n#{on_yaml}jobs:\n  j:\n    runs-on: ubuntu-latest\n    steps:\n      - run: scripts/job.sh\n")
      end
    end
    hot_ci.call("HOT: a script a SCHEDULE workflow runs is deploy-automation (DND-590)",
                trig_root.call("on:\n  schedule:\n    - cron: '0 0 * * *'\n"), "scripts/job.sh", ".github/workflows/t.yml")
    hot_ci.call("HOT: a script a workflow_dispatch workflow runs is deploy-automation (DND-590)",
                trig_root.call("on: [pull_request, workflow_dispatch]\n"), "scripts/job.sh", ".github/workflows/t.yml")
    hot_ci.call("HOT: a script a pull_request_target workflow runs is deploy-automation (DND-590)",
                trig_root.call("on:\n  pull_request_target:\n"), "scripts/job.sh", ".github/workflows/t.yml")
    hot_ci.call("HOT: a script a workflow with an UNMODELLED `on:` shape runs fails WIDE (DND-590)",
                trig_root.call("on: 42\n"), "scripts/job.sh", ".github/workflows/t.yml")
    cold_ci.call("COLD: a script referenced ONLY by a merge_group workflow (pre-merge, DND-590)",
                 trig_root.call("on:\n  merge_group:\n"), "scripts/job.sh")
    # Each precision bound is pinned from BOTH sides, so neither a bound that
    # stops firing nor one that starts swallowing real references goes unseen.
    gl_anchor = lambda do |r|
      put.call(r, "lib/app.ex")
      put.call(r, "scripts/tpl.sh")
      put.call(r, ".gitlab-ci.yml",
               ".app-paths: &app-paths\n  - lib/app.ex\n" \
               ".deploy-tpl:\n  script:\n    - scripts/tpl.sh\n" \
               "test:\n  rules:\n    - changes: *app-paths\n  script:\n    - echo test\n" \
               "deploy:\n  extends: .deploy-tpl\n")
    end
    cold_ci.call("COLD: a file named only in a hidden anchor list aliased into `changes:`", gl_anchor, "lib/app.ex")
    hot_ci.call("HOT: a hidden MAPPING template's `script:` is still scanned", gl_anchor, "scripts/tpl.sh")
    script_seed = lambda do |r|
      put.call(r, "bin/deploy.sh", "#!/bin/sh\n# historical: lib/notes.sh\n. ./common.sh\necho \"see docs/runbook.md\"\ncat \"VERSION\"\n")
      put.call(r, "bin/common.sh")
      put.call(r, "lib/notes.sh")
      put.call(r, "docs/runbook.md")
      put.call(r, "VERSION")
      put.call(r, "ship.sh")
      wf.call(r, "post-merge.yml", deploy_run.call("      - run: bin/deploy.sh\n      - run: bash ship.sh\n"))
    end
    hot_ci.call("HOT: a script SOURCED beside a referenced script (`. ./common.sh`)", script_seed, "bin/common.sh", "bin/deploy.sh")
    hot_ci.call("HOT: a bare name a workflow step runs from the repo root (`bash ship.sh`)", script_seed, "ship.sh")
    cold_ci.call("COLD: a path named only in a script's COMMENT line", script_seed, "lib/notes.sh")
    cold_ci.call("COLD: documentation a script names (a runbook link) is not executed", script_seed, "docs/runbook.md")
    cold_ci.call("COLD: a bare quoted word in a SCRIPT is not resolved at the repo root", script_seed, "VERSION")

    # The miss must be observable: a COLD verdict names how many executed
    # files it compared against, so "none referenced" and "never looked" differ.
    out, _, code = ci_case.call(seed: ref_seed, change: ->(r) { put.call(r, "lib/a.ex") })
    check.call("COLD: prints the ci-references count and the merge-time CI configs it read",
               code.zero? && out.match?(/ci-references: \d+ file\(s\) executed by 1 merge-time CI config\(s\)/),
               "exit=#{code} out=#{out}")

    # 13. --owner-approval records without hiding
    d = File.join(tmp, "approved")
    b, h = mkrepo.call(d, seed: ->(r) { wf.call(r, "post-merge.yml", deploy_wf) }) { |r| File.write(File.join(r, "main.tf"), "x\n") }
    out, _, code = run_br.call(["--base", b, "--head", h, "--repo", d, "--owner-approval", "owner said go"])
    check.call("--owner-approval exits 0 but STILL prints the full HOT block",
               code.zero? && out.include?("BLAST-RADIUS HOT") && out.include?("HOT-OWNER-APPROVED") && out.include?("owner said go"),
               "exit=#{code} out=#{out}")
    # 13b. --gate-ran names the gate on the approval line (DND-479), display only
    out, _, code = run_br.call(["--base", b, "--head", h, "--repo", d, "--owner-approval", "owner said go",
                                "--gate-ran", "ai/bin/harness-gate"])
    check.call("--gate-ran names the gate on the HOT-OWNER-APPROVED line",
               code.zero? && out.include?("(OWNER-APPROVED: owner said go) (GATE: ai/bin/harness-gate)"),
               "exit=#{code} out=#{out}")
    _, err, code = run_br.call(["--base", b, "--head", h, "--repo", d, "--gate-ran", " "])
    check.call("an empty --gate-ran is a usage error with Fix:",
               code == 2 && err.include?("Fix:"), "exit=#{code} err=#{err}")

    # 14. empty --owner-approval is a usage error
    _, err, code = run_br.call(["--base", b, "--head", h, "--repo", d, "--owner-approval", ""])
    check.call("an EMPTY --owner-approval is refused with a Fix:",
               code == 2 && err.include?("Fix:"), "exit=#{code} err=#{err}")

    # 15. unresolvable ref is an ERROR, not an empty diff
    _, err, code = run_br.call(["--base", "deadbeef", "--head", h, "--repo", d])
    check.call("an unresolvable --base is an ERROR (exit 2), never 'no files'",
               code == 2 && err.include?("Fix:") && err.downcase.include?("resolve"),
               "exit=#{code} err=#{err}")

    # 16. empty diff is an ERROR, not COLD
    _, err, code = run_br.call(["--base", h, "--head", h, "--repo", d])
    check.call("an EMPTY diff is an ERROR (exit 2), never COLD",
               code == 2 && err.include?("EMPTY"), "exit=#{code} err=#{err}")

    # --- destructive-migration (content-gated surface) -----------------------
    #
    # This surface is the first whose predicate is the file's TEXT, not its path.
    # The cases below are split deliberately: the MUST-GATE set proves the gate
    # exists, and the MUST-NOT-GATE set proves the precision that makes it usable.
    # Measured 2026-09-20 over 364 migrations in gen_saas + walt_ui, a naive verb
    # rule was ~50% precise on walt_ui -- and a gate that fires wrongly half the
    # time trains people to bypass it, which is a weakening in effect. The
    # false-positive cases are therefore load-bearing, not decoration.
    mig_n = 0
    mig = lambda do |body, path: nil, seed_wf: deploy_wf, seed_mig: nil|
      mig_n += 1
      d = File.join(tmp, "mig#{mig_n}")
      p = path || "priv/repo/migrations/20240101000000_m.exs"
      seed = lambda do |r|
        wf.call(r, "post-merge.yml", seed_wf) if seed_wf
        if seed_mig
          FileUtils.mkdir_p(File.join(r, File.dirname(p)))
          File.write(File.join(r, p), seed_mig)
        end
      end
      b2, h2 = mkrepo.call(d, seed: seed) do |r|
        FileUtils.mkdir_p(File.join(r, File.dirname(p)))
        if body.nil?
          FileUtils.rm_f(File.join(r, p))
        else
          File.write(File.join(r, p), body)
        end
      end
      out2, err2, code2 = run_br.call(["--base", b2, "--head", h2, "--repo", d])
      [out2, err2, code2]
    end

    wrap = lambda { |up, down = nil| +"defmodule R.M do\n  use Ecto.Migration\n\n  def up do\n#{up}\n  end\n" + (down ? "\n  def down do\n#{down}\n  end\n" : "") + "end\n" }
    chg  = lambda { |body| "defmodule R.M do\n  use Ecto.Migration\n\n  def change do\n#{body}\n  end\nend\n" }

    # --- must gate (HOT, exit 4) ---
    hot_mig = lambda do |desc, body, **kw|
      o, _e, c = mig.call(body, **kw)
      check.call(desc, c == 4 && o.include?("destructive-migration"), "exit=#{c} out=#{o}")
    end

    hot_mig.call("destructive-migration: `drop table` in `def up` is HOT",
                 wrap.call("    drop table(:widgets)"))
    hot_mig.call("destructive-migration: `drop table` in `def change` is HOT (change is executable)",
                 chg.call("    drop table(:widgets)"))
    hot_mig.call("destructive-migration: `remove :col` in `change` is HOT",
                 chg.call("    alter table(:users) do\n      remove :legacy_token\n    end"))
    hot_mig.call("destructive-migration: `remove :col, references(...)` in `up` is HOT (the walt_ui shape)",
                 wrap.call("    alter table(:users) do\n      remove :contact_id, references(:contacts)\n    end"))
    # Ecto-reversibility restores the SCHEMA, never the rows. This case is the
    # one most likely to be "optimized" away by a future reader.
    hot_mig.call("destructive-migration: Ecto-reversible `remove :col, :type` is STILL HOT (rows are gone)",
                 chg.call("    alter table(:users) do\n      remove :nickname, :string\n    end"))
    hot_mig.call("destructive-migration: `drop_if_exists table(...)` in `up` is HOT",
                 wrap.call("    drop_if_exists table(:widgets)"))
    # Raw SQL in a heredoc: a per-line scan passes this only by accident.
    hot_mig.call("destructive-migration: destructive raw SQL in an `execute` heredoc is HOT (region-wide scan)",
                 wrap.call("    execute \"\"\"\n    ALTER TABLE users DROP COLUMN legacy_token;\n    \"\"\""))
    hot_mig.call("destructive-migration: `execute \"TRUNCATE ...\"` in `change` is HOT",
                 chg.call("    execute \"TRUNCATE audit_log\""))
    # The argument is what decides whether rows are lost, so an unrecognised
    # argument is UNDECIDABLE and must fail closed.
    hot_mig.call("destructive-migration: a `drop` with an UNRECOGNISED argument fails CLOSED",
                 wrap.call("    drop some_dynamic_thing(:x)"))
    # Region attribution is per-`def`, not "above the `def down` line". The
    # positional form fails this one OPEN.
    hot_mig.call("destructive-migration: `down` defined BEFORE `up` still gates the `up` (per-def regions)",
                 "defmodule R.M do\n  use Ecto.Migration\n\n  def down do\n    create table(:widgets) do\n    end\n  end\n\n  def up do\n    drop table(:widgets)\n  end\nend\n")
    hot_mig.call("destructive-migration: a destructive `defp` helper is HOT (helpers are executable)",
                 "defmodule R.M do\n  use Ecto.Migration\n\n  def up do\n    nuke()\n  end\n\n  defp nuke do\n    drop table(:widgets)\n  end\nend\n")
    # Classification reads the file AT HEAD, not the hunk.
    hot_mig.call("destructive-migration: an EDITED migration is classified from HEAD, not the hunk",
                 wrap.call("    drop table(:widgets)"),
                 seed_mig: chg.call("    create table(:widgets) do\n    end"))
    hot_mig.call("destructive-migration: the second migrations path glob (priv/*/migrations) matches",
                 wrap.call("    drop table(:widgets)"),
                 path: "priv/replica_repo/migrations/20240101000000_m.exs")
    # DND-422: `**/priv/repo/migrations/*.exs` must descend a dot-prefixed dir.
    hot_mig.call("destructive-migration: a migration under a DOT-DIR (.pkg/app/priv/...) is HOT (FNM_DOTMATCH, DND-422)",
                 wrap.call("    drop table(:widgets)"),
                 path: ".pkg/app/priv/repo/migrations/20240101000000_m.exs")

    # --- must NOT gate (COLD, exit 0) — the precision cases ---
    cold_mig = lambda do |desc, body, **kw|
      o, _e, c = mig.call(body, **kw)
      check.call(desc, c.zero? && o.include?("BLAST-RADIUS COLD"), "exit=#{c} out=#{o}")
    end

    # 15 occurrences in walt_ui. Constraints and indexes hold NO data.
    cold_mig.call("destructive-migration: `drop constraint` is COLD (loses no rows)",
                  chg.call("    drop constraint(:users, :users_email_check)"))
    # 4 occurrences in walt_ui.
    cold_mig.call("destructive-migration: `drop index` is COLD (loses no rows)",
                  wrap.call("    drop index(:users, [:email])"))
    cold_mig.call("destructive-migration: `drop_if_exists index` is COLD",
                  chg.call("    drop_if_exists index(:users, [:email])"))
    cold_mig.call("destructive-migration: `drop unique_index` is COLD",
                  chg.call("    drop unique_index(:users, [:email])"))
    # The core exemption, and the single most common real migration shape.
    cold_mig.call("destructive-migration: `drop table` ONLY inside `def down` is COLD",
                  wrap.call("    create table(:widgets) do\n    end", "    drop table(:widgets)"))
    cold_mig.call("destructive-migration: `remove` inside `def down` (with `add` in `up`) is COLD",
                  wrap.call("    alter table(:users) do\n      add :col, :string\n    end",
                            "    alter table(:users) do\n      remove :col\n    end"))
    cold_mig.call("destructive-migration: a commented-out `drop table` is COLD",
                  wrap.call("    # drop table(:widgets)\n    create table(:gadgets) do\n    end"))

    # --- lexical cases, ALL found by replaying the rule over the real corpus ---
    #
    # Every one of these was a live false positive measured on 2026-09-20 against
    # the 372 migrations in gen_saas + walt_ui. None was predicted by a fixture,
    # which is the argument for the replay: a hand-written fixture builds its
    # input the way the matcher already expects.
    cold_mig.call("destructive-migration: `drop` PROSE in a @moduledoc is COLD (6 corpus false positives)",
                  "defmodule R.M do\n  @moduledoc \"\"\"\n  Rewrites the defaults, then drop the extension.\n  We also drop the plaintext columns here.\n  \"\"\"\n  use Ecto.Migration\n\n  def change do\n    create table(:gadgets) do\n    end\n  end\nend\n")
    cold_mig.call("destructive-migration: a single-line @doc mentioning drop is COLD",
                  "defmodule R.M do\n  @moduledoc \"drop the old table eventually\"\n  use Ecto.Migration\n\n  def change do\n    create table(:gadgets) do\n    end\n  end\nend\n")
    # walt_ui 20260821164800: the ARGUMENT -- the thing that decides whether rows
    # are lost -- was on the next line, so a per-physical-line match could not
    # see it and the fail-closed rule fired on a constraint drop.
    cold_mig.call("destructive-migration: a MULTI-LINE `drop_if_exists(constraint(...))` is COLD",
                  wrap.call("    drop_if_exists(\n      constraint(:users, \"users_contact_id_fkey\")\n    )"))
    # walt_ui 20260716120000: a comment inside a multi-line `execute(`.
    cold_mig.call("destructive-migration: a COMMENT inside a multi-line call is not executable",
                  chg.call("    execute(\n      \"CREATE SCHEMA IF NOT EXISTS s\",\n      # down: intentionally does NOT drop faraday_user\n      \"SELECT 1\"\n    )"))
    # The joining must not LOSE a real hit -- the other direction of the same fix.
    hot_mig.call("destructive-migration: a MULTI-LINE `drop(table(...))` is still HOT",
                 wrap.call("    drop(\n      table(:widgets)\n    )"))
    # Inside a heredoc a `#` line is STRING CONTENT, not an Elixir comment, so
    # Elixir's comment rule must not reach into it. The destructive statement is
    # deliberately the ONLY one and sits on the `#` line: strip that line and the
    # case goes COLD, which is what makes this case discriminate rather than pass
    # on a sibling line. (Its first draft did exactly that -- caught by sabotage,
    # not by the suite being green.)
    hot_mig.call("destructive-migration: a `#` line inside a heredoc is string content, not a comment",
                 wrap.call("    execute(\n      \"\"\"\n      # DROP TABLE widgets;\n      \"\"\"\n    )"))

    # A routine migration must not merely be silent -- it must SAY it was
    # examined and found clean, or "clean" and "never looked" read the same.
    o, _e, c = mig.call(chg.call("    create table(:gadgets) do\n      add :name, :string\n    end"))
    check.call("destructive-migration: a routine migration is COLD",
               c.zero? && o.include?("BLAST-RADIUS COLD"), "exit=#{c} out=#{o}")
    check.call("destructive-migration: a COLD migration PRINTS that it was examined and clean",
               o.include?("content-examined:") && o.include?("clean"), o)

    # The one residual undecidable-looking case: absent at head means deleted,
    # which does not execute on deploy. Not a hit -- but printed, never silent.
    o, _e, c = mig.call(nil, seed_mig: wrap.call("    drop table(:widgets)"))
    check.call("destructive-migration: a DELETED migration is COLD (it never runs on deploy)",
               c.zero? && o.include?("BLAST-RADIUS COLD"), "exit=#{c} out=#{o}")
    check.call("destructive-migration: the deleted-at-head skip is PRINTED, not silent",
               o.include?("skipped") && o.include?("absent at head"), o)

    # The content scan must never run off the cold path.
    o, _e, c = mig.call(chg.call("    create table(:gadgets) do\n    end"),
                        path: "lib/my_app/migrations_helper.ex")
    check.call("destructive-migration: the content rule does not leak into ordinary source paths",
               c.zero? && !o.include?("content-examined:"), "exit=#{c} out=#{o}")

    # --- the conjunction still holds for this class ---
    o, _e, c = mig.call(wrap.call("    drop table(:widgets)"), seed_wf: nil)
    check.call("destructive-migration: destructive migration + NO CI config is WARM, not HOT",
               c.zero? && o.include?("BLAST-RADIUS WARM"), "exit=#{c} out=#{o}")
    o, _e, c = mig.call(wrap.call("    drop table(:widgets)"), seed_wf: pr_wf)
    check.call("destructive-migration: destructive migration + pull_request-only CI is WARM",
               c.zero? && o.include?("BLAST-RADIUS WARM"), "exit=#{c} out=#{o}")

    # --- manifest schema/content validation ---
    mig_d = File.join(tmp, "mig1")
    mb = `git -C #{mig_d} rev-parse HEAD~1`.strip
    mh = `git -C #{mig_d} rev-parse HEAD`.strip

    old_schema = File.join(tmp, "schema1.json")
    File.write(old_schema, JSON.dump({ "schema" => 1, "surfaces" => [{ "class" => "x", "why" => "y", "patterns" => ["**/*"] }] }))
    _, err, code = run_br.call(["--base", mb, "--head", mh, "--repo", mig_d, "--manifest", old_schema])
    check.call("a schema-1 manifest is refused after the content bump (with a Fix:)",
               code == 2 && err.include?("Fix:"), "exit=#{code} err=#{err}")

    # An unevaluable content rule must be an ERROR -- never a silent path-only
    # gate (which would flag EVERY migration) and never a silent miss.
    bad_eval = File.join(tmp, "badeval.json")
    File.write(bad_eval, JSON.dump({ "schema" => MANIFEST_SCHEMA, "surfaces" => [
      { "class" => "x", "why" => "y", "patterns" => ["**/*"],
        "content" => { "evaluator" => "some-future-thing-v9", "match_line" => [{ "re" => "x", "why" => "z" }] } }
    ] }))
    _, err, code = run_br.call(["--base", mb, "--head", mh, "--repo", mig_d, "--manifest", bad_eval])
    check.call("an UNEVALUABLE content rule is an ERROR, not a path-only gate and not a silent miss",
               code == 2 && err.include?("Fix:"), "exit=#{code} err=#{err}")

    unknown_key = File.join(tmp, "unknownkey.json")
    File.write(unknown_key, JSON.dump({ "schema" => MANIFEST_SCHEMA, "surfaces" => [
      { "class" => "x", "why" => "y", "patterns" => ["**/*"],
        "content" => { "evaluator" => ECTO_MIGRATION_EVALUATOR, "match_line" => [{ "re" => "x", "why" => "z" }],
                       "somethig_typoed" => true } }
    ] }))
    _, err, code = run_br.call(["--base", mb, "--head", mh, "--repo", mig_d, "--manifest", unknown_key])
    check.call("an unknown content key is refused rather than SILENTLY IGNORED",
               code == 2 && err.include?("Fix:"), "exit=#{code} err=#{err}")

    # DND-589: the `references` key fails the same two ways `content` does.
    [["an UNIMPLEMENTED references evaluator is an ERROR, not a silently dropped surface",
      { "evaluator" => "some-future-thing-v9" }],
     ["an unknown references key is refused rather than SILENTLY IGNORED",
      { "evaluator" => CI_REFERENCES_EVALUATOR, "follow_dirs_typoed" => true }]].each do |desc, refs_rule|
      f = File.join(tmp, "refs-#{desc.hash.abs}.json")
      File.write(f, JSON.dump({ "schema" => MANIFEST_SCHEMA, "surfaces" => [
        { "class" => "x", "why" => "y", "patterns" => [".github/workflows/**"], "references" => refs_rule }
      ] }))
      _, err, code = run_br.call(["--base", mb, "--head", mh, "--repo", mig_d, "--manifest", f])
      check.call(desc, code == 2 && err.include?("Fix:"), "exit=#{code} err=#{err}")
    end

    norules = File.join(tmp, "norules.json")
    File.write(norules, JSON.dump({ "schema" => MANIFEST_SCHEMA, "surfaces" => [
      { "class" => "x", "why" => "y", "patterns" => ["**/*"],
        "content" => { "evaluator" => ECTO_MIGRATION_EVALUATOR } }
    ] }))
    _, err, code = run_br.call(["--base", mb, "--head", mh, "--repo", mig_d, "--manifest", norules])
    check.call("a content surface with NO match rules is an ERROR, not a silently dead surface",
               code == 2 && err.include?("Fix:"), "exit=#{code} err=#{err}")

    # --owner-approval still prints the full HOT block for this class too.
    o, _e, c = mig.call(wrap.call("    drop table(:widgets)"))
    mig_d2 = File.join(tmp, "mig#{mig_n}")
    ob = `git -C #{mig_d2} rev-parse HEAD~1`.strip
    oh = `git -C #{mig_d2} rev-parse HEAD`.strip
    out, _, code = run_br.call(["--base", ob, "--head", oh, "--repo", mig_d2,
                                "--owner-approval", "yes, drop it -- Cody, recorded on DND-999"])
    check.call("destructive-migration under --owner-approval exits 0 but STILL prints the HOT hit",
               code.zero? && out.include?("BLAST-RADIUS HOT") && out.include?("destructive-migration"),
               "exit=#{code} out=#{out}")

    # 2/3. manifest failure modes — a wrongly-resolved manifest must say so
    empty_manifest = File.join(tmp, "empty.json")
    File.write(empty_manifest, JSON.dump({ "schema" => MANIFEST_SCHEMA, "surfaces" => [] }))
    _, err, code = run_br.call(["--base", b, "--head", h, "--repo", d, "--manifest", empty_manifest])
    check.call("a manifest with ZERO surfaces is an ERROR, not 'nothing is sensitive'",
               code == 2 && err.include?("Fix:"), "exit=#{code} err=#{err}")

    nopat = File.join(tmp, "nopat.json")
    File.write(nopat, JSON.dump({ "schema" => MANIFEST_SCHEMA, "surfaces" => [{ "class" => "x", "why" => "y", "patterns" => [] }] }))
    _, err, code = run_br.call(["--base", b, "--head", h, "--repo", d, "--manifest", nopat])
    check.call("a manifest with ZERO patterns is an ERROR, not 'nothing is sensitive'",
               code == 2 && err.include?("ZERO patterns"), "exit=#{code} err=#{err}")

    _, err, code = run_br.call(["--base", b, "--head", h, "--repo", d, "--manifest", File.join(tmp, "absent.json")])
    check.call("a MISSING manifest is an ERROR, not an empty surface list",
               code == 2 && err.include?("Fix:"), "exit=#{code} err=#{err}")

    bad_schema = File.join(tmp, "schema9.json")
    File.write(bad_schema, JSON.dump({ "schema" => 9, "surfaces" => [{ "class" => "x", "patterns" => ["*"] }] }))
    _, err, code = run_br.call(["--base", b, "--head", h, "--repo", d, "--manifest", bad_schema])
    check.call("an UNKNOWN manifest schema is refused rather than guessed at",
               code == 2 && err.include?("Fix:"), "exit=#{code} err=#{err}")

    # The YAML 1.1 `on:` -> true trap, asserted directly on the parser path.
    doc = YAML.safe_load(deploy_wf, aliases: true)
    check.call("the `on:`-parses-as-boolean-true YAML trap is handled",
               (doc.key?("on") ? doc["on"] : doc[true]) && !trigger_hit(doc.key?("on") ? doc["on"] : doc[true]).nil?,
               "parsed keys=#{doc.keys.inspect}")
  end

  puts
  if failures.empty?
    puts "VERDICT: PASS (#{n} cases)"
    0
  else
    puts "VERDICT: FAIL (#{failures.size} of #{n} cases)"
    puts "Fix: repair each failing case above before committing; blast-radius is a " \
         "merge safety check and a broken classifier silently reads as COLD."
    1
  end
end

if ARGV.include?("--self-test")
  exit self_test
else
  exit run(ARGV.dup)
end
