#!/usr/bin/ruby
# frozen_string_literal: true

# with-secret NAME -- cmd [args...] -- run one command with one declared secret
# in ITS environment only (DND-845). Contract:
# ai/contracts/athena-machine-secrets.md -> with-secret.
#
# NAME is resolved through the registries (ai/secrets/registry.json, then the
# private overlay's overlay/secrets.json), the file is checked as
# check-machine-secrets probe (c) checks it, and cmd is exec'd with NAME set.
# The value never goes in argv and is never printed. Every refusal is one
# stderr line plus a Fix:, and nothing is exec'd.
#
# Bucket placement: Manager + Framework over ai/lib/machine_secrets_host.rb.
# Tests: ai/test/machine-secrets/self-test.sh.

require_relative "../lib/machine_secrets_host"

HELP = <<~HELP
  with-secret -- run one command with one declared secret in its env only (DND-845)

  Usage:
    with-secret NAME -- cmd [args...]
    with-secret --help          this text (stdout, exit 0, no side effects)

  NAME is a registry entry name that is also an env variable name, e.g.
    with-secret GEN_SAAS_ANTHROPIC_API_KEY -- mix phx.server
  It is looked up in ai/secrets/registry.json, then in the private overlay's
  overlay/secrets.json. The file must be a regular file owned by you, mode
  0600 or 0400, in a directory that is not group- or world-writable. One
  trailing newline is dropped. A `dotenv` entry (several secrets in one file)
  is refused: its consumer reads the file itself.

  Exit codes: the command's own, once exec'd. Before that: 1 refused (unknown
  name, malformed registry, dotenv entry, bad or empty file), 2 usage.

  Contract: ai/contracts/athena-machine-secrets.md -> with-secret
HELP

def refuse(msg, fix, code = 1)
  warn "with-secret: #{msg}"
  warn "Fix: #{fix}"
  exit code
end

args = ARGV.dup
if args.first == "--help" || args.first == "-h"
  puts HELP
  exit 0
end

name = args.shift
sep = args.shift
if name.nil? || sep != "--" || args.empty?
  refuse("usage: with-secret NAME -- cmd [args...]", "name the secret, then --, then the command (see with-secret --help)", 2)
end

if MachineSecrets.looks_secret?(name)
  refuse("the NAME argument looks like a credential value, not a name",
         "pass the registry entry's name (e.g. GEN_SAAS_ANTHROPIC_API_KEY), never the value; if a value was typed here, rotate it (ai/contracts/athena-machine-secrets.md -> A leaked value is rotated)")
end
unless MachineSecrets::ENV_NAME_RE.match?(name)
  refuse("#{name} is not an env variable name, so it cannot be set for a command",
         "this entry's consumer reads its path directly (its registry `consumers` say how); " \
         "with-secret takes an entry named like an env variable ([A-Za-z_][A-Za-z0-9_]*)")
end

begin
  entries = MachineSecrets.parse_registry(MachineSecretsHost.working_file(MachineSecretsHost::REGISTRY_REL),
                                          MachineSecretsHost::REGISTRY_REL)
rescue MachineSecrets::Malformed, SystemCallError => e
  refuse("the public registry could not be read (#{e.message})", "restore ai/secrets/registry.json (git checkout origin/main -- ai/secrets/registry.json)")
end
entry = entries.find { |e| e.name == name }
overlay, state = MachineSecretsHost.overlay_registry
if entry && state == :present && Array(overlay).any? { |e| e.name == name }
  refuse("#{name} is declared in both the public registry and the overlay's, so which file to use is ambiguous",
         "rename or remove one of the two entries (ai/contracts/athena-machine-secrets.md -> The registry)")
end
unless entry
  unless state.is_a?(Symbol)
    refuse("#{name} is not in the public registry, and the overlay's registry could not be read: #{state}",
           "repair the private overlay (ai/bin/private-overlay status names the problem)")
  end
  entry = Array(overlay).find { |e| e.name == name }
end
unless entry
  refuse("#{name} is not declared in ai/secrets/registry.json or the overlay's overlay/secrets.json",
         "declare it (ai/contracts/athena-machine-secrets.md -> Adding a secret), or check the spelling")
end
if entry.kind == "dotenv"
  refuse("#{name} is a dotenv entry (several secrets in one file); with-secret sets one variable",
         "load the file inside the one command that needs it, as its registry `consumers` say")
end

begin
  path = MachineSecrets.expand(entry.path, MachineSecretsHost.home)
rescue MachineSecrets::Malformed => e
  refuse(e.message, "run with HOME set to your absolute home directory")
end
res = MachineSecretsHost.check_secret_file(path)
case res[:state]
when :absent
  refuse("#{name}'s file #{res[:shown]} does not exist on this machine",
         "provision it (ai/contracts/athena-machine-secrets.md -> Adding a secret; its registry `rotate` says where the value is minted)")
when :bad
  refuse("#{name}'s file #{res[:shown]} is refused: #{res[:problem]}", res[:fix] || "replace it with a regular 0600 file owned by you")
end

value = MachineSecretsHost.read_secret(path)
refuse("#{name}'s file #{res[:shown]} is empty", "write the value into it (ai/contracts/athena-machine-secrets.md -> Adding a secret)") if value.empty?

begin
  exec({ name => value }, *args)
rescue SystemCallError => e
  refuse("could not run #{args.first} (#{e.class.name.split('::').last})", "check the command name and that it is on PATH", 127)
end
