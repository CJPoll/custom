#!/usr/bin/env ruby
# frozen_string_literal: true

# check-tool-risk — guard that every harness tool is classified in the tool
# risk registry (ai/tools/risk.yml), and the single consumer contract for
# reading a tool's risk class.
#
# WHICH TOOLS (DND-508): every first-party executable ai/lib/harness_tools.rb
# scopes IN -- ai/bin/*, ai/skills/*/bin/*, ai/skills/*/scripts/*, and any
# future executable under ai/. That file holds the scope rule and the reason
# for each directory it leaves OUT. Discovery is git's (tracked, plus untracked
# first-party), never a filesystem glob: an ignored scratch file in ai/bin does
# not demand a classification, while a new untracked tool does. An executable
# no scope rule covers FAILS, and so does an empty discovery.
#
# REGISTRY KEYS (HarnessTools.risk_key): an ai/bin tool is its bare name, as it
# always was. Any other tool is its path under ai/, e.g.
# `skills/athena:slack/bin/post` -- unique where basenames collide, and a
# substring of both `ai/skills/...` and `~/.claude/skills/...`, so
# ai/hooks/workflow-phase-guard.sh's word match finds it either way.
#
# The registry (DND-172 / gap 13) classifies each tool by WORST-CASE capability
# as readOnly / idempotent / destructive (least -> most restrictive). Its
# purpose is to be the concrete input C2 (DND-173) phase-gating reads. This
# script owns two responsibilities:
#
#   * COVERAGE + WELL-FORMEDNESS (gate entry, no args): every harness tool
#     has an entry, no stale entries linger, every entry is well-formed,
#     and `default` stays `destructive` (deny-by-default). Exit 0 pass / 1 fail.
#   * THE CONSUMER CONTRACT (`--class-of <name>`): print exactly one class and
#     exit 0, applying deny-by-default — an unknown/unlisted tool resolves to
#     the most restrictive class. This deny-by-default default lives ONLY here
#     so C2 never re-implements it.
#
# Mirrors the conventions of check-generic-skills / check-inbox-registry:
# stdlib-only (gem-free), YAML via `YAML.safe_load`, run with bare `ruby`, and
# every deny/failure path carries an actionable `Fix:` line (CLAUDE.md ->
# "Guard/error messages are written for the LLM").
#
# Usage:
#   ai/bin/check-tool-risk               coverage + well-formedness; exit 1 on fail
#   ai/bin/check-tool-risk --class-of X  print X's risk class (deny-by-default)
#   ai/bin/check-tool-risk --json        dump the resolved {tool: class} map
#   ai/bin/check-tool-risk --self-test   verify the checker's own logic

require "yaml"
require "fileutils"
require "tmpdir"
require_relative "../lib/harness_tools"

AI_DIR        = File.expand_path("..", __dir__)
REPO_ROOT     = File.expand_path("..", AI_DIR)
REGISTRY_PATH = File.join(AI_DIR, "tools", "risk.yml")

# Deny-by-default: the most restrictive class, assigned to any unclassified
# tool. This constant is the SOLE home of the default so consumers (C2) never
# re-derive it. The registry's own `default:` key is asserted to equal this by
# the coverage check, so the data file and this code can never silently diverge.
DENY_DEFAULT = "destructive"

# The tools that MUST be classified, as [registry keys (sorted), unscoped
# paths]. Test suites (*.self-test.sh, test/) are excluded by first-party
# discovery; dot-prefixed executables are included (DND-422). Raises
# FirstParty::MeasureError when discovery fails or finds nothing.
def enumerate_tools(root)
  found = HarnessTools.discover(root)
  [found.tools.map { |rel| HarnessTools.risk_key(rel) }.sort, found.unscoped]
end

# Load + structurally validate the registry. Returns [registry_hash, errors].
# On any structural problem `errors` is non-empty (each string carries a Fix:)
# and the hash is whatever could be parsed (possibly {}). Never raises.
def load_registry(path)
  errors = []
  unless File.file?(path)
    return [{}, ["registry not found at #{path}. " \
                 "Fix: create ai/tools/risk.yml with `version`, " \
                 "`default: destructive`, `classes:`, and a `tools:` map."]]
  end

  begin
    data = YAML.safe_load(File.read(path))
  rescue Psych::Exception => e
    return [{}, ["registry is not parseable YAML (#{e.message}). " \
                 "Fix: correct the YAML syntax in ai/tools/risk.yml."]]
  end

  unless data.is_a?(Hash)
    return [{}, ["registry top level is not a mapping. " \
                 "Fix: ai/tools/risk.yml must be a YAML mapping with " \
                 "`version`, `default`, `classes`, `tools` keys."]]
  end

  classes = data["classes"]
  unless classes.is_a?(Array) && !classes.empty? && classes.all? { |c| c.is_a?(String) }
    errors << "`classes` is missing or not a non-empty list of strings. " \
              "Fix: set `classes: [readOnly, idempotent, destructive]` in ai/tools/risk.yml."
    classes = []
  end

  if data["default"] != DENY_DEFAULT
    errors << "`default` is #{data['default'].inspect}, must be #{DENY_DEFAULT.inspect} " \
              "(deny-by-default must not be silently loosened). " \
              "Fix: set `default: #{DENY_DEFAULT}` in ai/tools/risk.yml."
  end

  tools = data["tools"]
  unless tools.is_a?(Hash)
    errors << "`tools` is missing or not a mapping. " \
              "Fix: add a `tools:` mapping of tool-name to " \
              "{ class: <#{classes.join('|')}>, reason: <one-word> } in ai/tools/risk.yml."
    tools = {}
  end

  tools.each do |name, entry|
    unless entry.is_a?(Hash)
      errors << "tools['#{name}'] is not a mapping. " \
                "Fix: set '#{name}: { class: <#{DENY_DEFAULT}>, reason: <one-word> }' in ai/tools/risk.yml."
      next
    end
    cls = entry["class"]
    if cls.nil?
      errors << "tools['#{name}'] is missing `class`. " \
                "Fix: add `class: <#{classes.empty? ? DENY_DEFAULT : classes.join('|')}>` to '#{name}' in ai/tools/risk.yml."
    elsif !classes.empty? && !classes.include?(cls)
      errors << "tools['#{name}'].class is #{cls.inspect}, not one of #{classes.inspect}. " \
                "Fix: set '#{name}' class to one of #{classes.join(', ')} in ai/tools/risk.yml."
    end
    reason = entry["reason"]
    if reason.nil? || (reason.is_a?(String) && reason.strip.empty?)
      errors << "tools['#{name}'] is missing `reason`. " \
                "Fix: add a one-word `reason:` token to '#{name}' in ai/tools/risk.yml."
    end
  end

  [data, errors]
end

# The consumer contract. Deny-by-default: unknown/unlisted -> DENY_DEFAULT.
def class_of(name, registry_path)
  data, _errors = load_registry(registry_path)
  tools = data["tools"]
  return DENY_DEFAULT unless tools.is_a?(Hash)

  entry = tools[name]
  return DENY_DEFAULT unless entry.is_a?(Hash)

  cls = entry["class"]
  cls.is_a?(String) ? cls : DENY_DEFAULT
end

# Coverage + well-formedness. Returns [exit_code, lines].
def run_check(root: REPO_ROOT, registry_path: REGISTRY_PATH)
  lines = []
  data, errors = load_registry(registry_path)
  tools = data["tools"].is_a?(Hash) ? data["tools"] : {}

  begin
    bins, unscoped = enumerate_tools(root)
  rescue FirstParty::MeasureError => e
    lines << "check-tool-risk: FAILED — could not discover the harness tools: #{e.message}"
    lines << "  Fix: this repo always has harness tools, so an empty or failed discovery means " \
             "the lookup broke, not that there is nothing to classify. Run `git -C #{root} ls-files ai/bin` " \
             "and check the executable bits; see ai/lib/harness_tools.rb for the scope rule."
    return [1, lines]
  end

  unscoped.each do |rel|
    errors << "no scope rule covers executable '#{rel}', so nothing decided whether it is a harness tool. " \
              "Fix: add a SCOPE entry for its directory in ai/lib/harness_tools.rb: IN (it must then be " \
              "classified here) or OUT with the reason."
  end

  missing = bins - tools.keys
  stale   = tools.keys - bins

  unless missing.empty?
    missing.each do |name|
      errors << "no risk classification for harness tool '#{name}'. " \
                "Fix: add '#{name}: { class: <readOnly|idempotent|destructive>, reason: <one-word> }' " \
                "to ai/tools/risk.yml (unclassified => destructive by deny-by-default; classify it explicitly)."
    end
  end

  unless stale.empty?
    stale.each do |name|
      errors << "registry entry '#{name}' is no longer a harness tool. " \
                "Fix: remove the '#{name}' entry from ai/tools/risk.yml."
    end
  end

  if errors.empty?
    lines << "check-tool-risk: OK — #{bins.size} harness tools, all classified " \
             "(#{bins.size} considered, #{tools.size} entries)"
    return [0, lines]
  end

  lines << "check-tool-risk: FAILED — #{errors.size} problem(s) " \
           "(#{bins.size} harness tools considered, #{tools.size} classified):"
  errors.each { |e| lines << "  - #{e}" }
  [1, lines]
end

def run_json(registry_path: REGISTRY_PATH, root: REPO_ROOT)
  require "json"
  begin
    bins, = enumerate_tools(root)
  rescue FirstParty::MeasureError => e
    return [1, ["check-tool-risk: --json could not discover the harness tools: #{e.message}",
                "  Fix: run from a git checkout of ~/dev/custom; see ai/lib/harness_tools.rb for the scope rule."]]
  end
  map = bins.each_with_object({}) { |name, h| h[name] = class_of(name, registry_path) }
  [0, [JSON.pretty_generate(map)]]
end

# ---- self-test -------------------------------------------------------------

def _git_fixture(root)
  sh = ->(*a) { system(*a, chdir: root, out: File::NULL, err: File::NULL) }
  FileUtils.mkdir_p(root)
  sh.call("git", "init", "-q", ".")
  sh.call("git", "config", "user.email", "t@example.invalid")
  sh.call("git", "config", "user.name", "t")
  # A global core.excludesFile could hide a fixture from git ls-files.
  sh.call("git", "config", "core.excludesFile", "/dev/null")
  FileUtils.mkdir_p(File.join(root, "ai", "bin"))
end

def _commit_all(root)
  system("git", "-C", root, "add", "-A", out: File::NULL, err: File::NULL)
  system("git", "-C", root, "-c", "commit.gpgsign=false", "commit", "-qm", "f",
         out: File::NULL, err: File::NULL)
end

# DND-508: WHICH tools must be classified. Every harness tool from
# ai/lib/harness_tools.rb (git discovery, scoped), not a glob of ai/bin.
def discovery_cases(fail)
  Dir.mktmpdir("check-tool-risk-disc-") do |root|
    _git_fixture(root)
    bin = File.join(root, "ai", "bin")
    _write_exec(bin, "alpha")
    skill = File.join(root, "ai", "skills", "athena:demo", "bin")
    FileUtils.mkdir_p(skill)
    _write_exec(skill, "tool")
    _commit_all(root)
    reg = File.join(root, "risk.yml")

    # An unclassified skill executable fails, named by its path under ai/.
    File.write(reg, _complete_registry(%w[alpha]))
    code, lines = run_check(root: root, registry_path: reg)
    fail.("an unclassified skill executable should fail") unless code == 1
    unless lines.join("\n").include?("skills/athena:demo/bin/tool")
      fail.("the failure should name the skill tool by its key skills/athena:demo/bin/tool")
    end

    File.write(reg, _complete_registry(%w[alpha skills/athena:demo/bin/tool]))
    code, lines = run_check(root: root, registry_path: reg)
    fail.("a fully classified set should pass, got #{lines.join(' / ')}") unless code.zero?

    # An ignored scratch executable in ai/bin does not skew the check.
    File.write(File.join(root, ".git", "info", "exclude"), "scratch-*\n")
    _write_exec(bin, "scratch-dnd")
    code, lines = run_check(root: root, registry_path: reg)
    fail.("an ignored scratch executable in ai/bin must not skew the check: #{lines.join(' / ')}") unless code.zero?

    # A NEW untracked first-party executable still fails until classified.
    fresh = _write_exec(bin, "fresh-tool")
    code, = run_check(root: root, registry_path: reg)
    fail.("a new untracked first-party executable should fail unclassified") unless code == 1
    FileUtils.rm_f(fresh)

    # An executable no scope rule covers fails.
    FileUtils.mkdir_p(File.join(root, "tools"))
    stray = _write_exec(File.join(root, "tools"), "stray")
    code, = run_check(root: root, registry_path: reg)
    fail.("an unscoped executable should fail") unless code == 1
    FileUtils.rm_f(stray)
  end

  # --json on a root git cannot answer fails cleanly (the phase guard then
  # fails open with a logged WARN), never with a stack trace or an empty map.
  Dir.mktmpdir("check-tool-risk-nogit-") do |root|
    code, lines = run_json(root: root, registry_path: File.join(root, "risk.yml"))
    fail.("--json on a non-git root should exit 1, got #{code}") unless code == 1
    fail.("--json failure should carry a Fix:") unless lines.join("\n").include?("Fix:")
  end

  # Empty discovery is an ERROR, never "0 tools, all classified".
  Dir.mktmpdir("check-tool-risk-empty-") do |root|
    _git_fixture(root)
    File.write(File.join(root, "README"), "no executables\n")
    _commit_all(root)
    reg = File.join(root, "risk.yml")
    File.write(reg, _complete_registry([]).sub("tools:\n", "tools: {}\n"))
    code, lines = run_check(root: root, registry_path: reg)
    fail.("empty discovery should fail") unless code == 1
    fail.("empty-discovery failure should carry a Fix:") unless lines.join("\n").include?("Fix:")
  end
end

def _write_exec(dir, name, body = "#!/bin/sh\n:\n")
  path = File.join(dir, name)
  File.write(path, body)
  FileUtils.chmod(0o755, path)
  path
end

def _complete_registry(bins)
  entries = bins.map { |b| "  #{b}: { class: readOnly, reason: t }" }.join("\n")
  <<~YAML
    version: 1
    default: destructive
    classes: [readOnly, idempotent, destructive]
    tools:
    #{entries}
  YAML
end

def run_self_test
  root = File.join(Dir.tmpdir, "check-tool-risk-selftest-#{Process.pid}")
  FileUtils.mkdir_p(root)
  ok = true
  fail = ->(msg) { warn "self-test: FAIL — #{msg}"; ok = false }

  begin
    _git_fixture(root)
    bin_dir = File.join(root, "ai", "bin")
    _write_exec(bin_dir, "alpha")
    _write_exec(bin_dir, "beta")
    _write_exec(bin_dir, "gamma")
    # A *.self-test.sh must be excluded from the enumerated set.
    _write_exec(bin_dir, "alpha.self-test.sh")
    # A non-executable file must be excluded too.
    File.write(File.join(bin_dir, "notes.txt"), "x")

    _commit_all(root)

    enum, = enumerate_tools(root)
    unless enum == %w[alpha beta gamma]
      fail.("enumeration wrong: expected [alpha, beta, gamma], got #{enum.inspect}")
    end

    # DND-422: a dot-prefixed executable is a tool that must be classified.
    dot_root = File.join(root, "dotrepo")
    _git_fixture(dot_root)
    _write_exec(File.join(dot_root, "ai", "bin"), ".hidden-tool")
    dot_enum, = enumerate_tools(dot_root)
    unless dot_enum == %w[.hidden-tool]
      fail.("a dot-prefixed bin was not enumerated: expected [.hidden-tool], got #{dot_enum.inspect}")
    end
    FileUtils.rm_rf(dot_root)

    reg = File.join(root, "risk.yml")
    File.write(File.join(root, ".git", "info", "exclude"), "risk.yml\n")

    # Case 1: complete fixture passes.
    File.write(reg, _complete_registry(%w[alpha beta gamma]))
    code, lines = run_check(root: root, registry_path: reg)
    fail.("complete fixture should pass, got exit #{code}: #{lines.join(' / ')}") unless code.zero?

    # Case 2: a new unclassified bin fails, naming it + a Fix line.
    File.write(reg, _complete_registry(%w[alpha beta]))
    code, lines = run_check(root: root, registry_path: reg)
    body = lines.join("\n")
    fail.("unclassified bin should fail") unless code == 1
    fail.("failure should name the missing 'gamma'") unless body.include?("gamma")
    fail.("failure should carry a Fix: line") unless body.include?("Fix:")

    # Case 3: a bad class value fails.
    File.write(reg, <<~YAML)
      version: 1
      default: destructive
      classes: [readOnly, idempotent, destructive]
      tools:
        alpha: { class: nope, reason: t }
        beta:  { class: readOnly, reason: t }
        gamma: { class: readOnly, reason: t }
    YAML
    code, lines = run_check(root: root, registry_path: reg)
    fail.("bad class value should fail") unless code == 1
    fail.("bad class failure should carry a Fix:") unless lines.join("\n").include?("Fix:")

    # Case 4: a missing reason fails.
    File.write(reg, <<~YAML)
      version: 1
      default: destructive
      classes: [readOnly, idempotent, destructive]
      tools:
        alpha: { class: readOnly }
        beta:  { class: readOnly, reason: t }
        gamma: { class: readOnly, reason: t }
    YAML
    code, = run_check(root: root, registry_path: reg)
    fail.("missing reason should fail") unless code == 1

    # Case 5: default != destructive fails.
    File.write(reg, <<~YAML)
      version: 1
      default: readOnly
      classes: [readOnly, idempotent, destructive]
      tools:
        alpha: { class: readOnly, reason: t }
        beta:  { class: readOnly, reason: t }
        gamma: { class: readOnly, reason: t }
    YAML
    code, lines = run_check(root: root, registry_path: reg)
    fail.("default: readOnly should fail") unless code == 1
    fail.("default failure should carry a Fix:") unless lines.join("\n").include?("Fix:")

    # Case 6: a stale entry fails, naming it.
    File.write(reg, _complete_registry(%w[alpha beta gamma delta]))
    code, lines = run_check(root: root, registry_path: reg)
    fail.("stale entry should fail") unless code == 1
    fail.("stale failure should name 'delta'") unless lines.join("\n").include?("delta")

    # Case 7: --class-of resolves correct classes and deny-by-default.
    File.write(reg, <<~YAML)
      version: 1
      default: destructive
      classes: [readOnly, idempotent, destructive]
      tools:
        alpha: { class: readOnly, reason: t }
        beta:  { class: idempotent, reason: t }
        gamma: { class: destructive, reason: t }
    YAML
    fail.("class_of alpha") unless class_of("alpha", reg) == "readOnly"
    fail.("class_of beta")  unless class_of("beta", reg) == "idempotent"
    fail.("class_of gamma") unless class_of("gamma", reg) == "destructive"
    fail.("class_of unknown must deny-by-default") unless class_of("nonesuch", reg) == "destructive"
    discovery_cases(fail)
  ensure
    FileUtils.rm_rf(root)
  end

  if ok
    puts "check-tool-risk: self-test OK"
    0
  else
    warn "check-tool-risk: self-test FAILED"
    warn "  Fix: the checker's coverage/validation/class-of logic regressed; " \
         "reconcile ai/bin/check-tool-risk against the cases above."
    1
  end
end

# ---- dispatch --------------------------------------------------------------

if ARGV.include?("--help") || ARGV.include?("-h")
  puts <<~TXT
    Usage:
      ai/bin/check-tool-risk                    assert every tool the harness can
                                                call carries a risk annotation in
                                                ai/tools/risk.yml
      ai/bin/check-tool-risk --json             emit the check result as JSON
      ai/bin/check-tool-risk --class-of TOOL    print one tool's risk class
      ai/bin/check-tool-risk --self-test        deterministic suite (no model)
      ai/bin/check-tool-risk --help             this text
  TXT
  exit 0
end
if ARGV.include?("--self-test")
  exit run_self_test
elsif (i = ARGV.index("--class-of"))
  name = ARGV[i + 1]
  if name.nil? || name.empty?
    warn "check-tool-risk: --class-of needs a tool name."
    warn "  Fix: invoke as `ai/bin/check-tool-risk --class-of <tool-name>`."
    exit 2
  end
  puts class_of(name, REGISTRY_PATH)
  exit 0
elsif ARGV.include?("--json")
  code, lines = run_json
  out = code.zero? ? $stdout : $stderr
  lines.each { |l| out.puts l }
  exit code
else
  code, lines = run_check
  out = code.zero? ? $stdout : $stderr
  lines.each { |l| out.puts l }
  exit code
end
