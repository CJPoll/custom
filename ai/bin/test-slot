#!/usr/bin/env bash
# test-slot — machine-wide flock slot pool for heavy test runs.
# DND-485 (DND-474 part 1). Design: Notion DND-485 A&E (architect-474-450).
#
# WHY THIS EXISTS
# On 2026-09-24 ~04:35Z parallel captains and admiral gates ran ~23 heavy test
# runs at once on a 16-core box (load 54.58) and timing-sensitive suites flaked
# (DND-473). Nothing bounded how many heavy runs share one machine. test-slot
# wraps ONE heavy command (a full bin/prep-commit.sh, a full `mix test`, an
# integration-gate run) so that the wrapped commands running at once per
# machine stay inside a budget, whatever repo, worktree, fleet, or session
# launched them.
#
# A WEIGHTED BUDGET, TWO POOLS (DND-1006). Until DND-1006 the cap was N=3
# slots, "provisional, unmeasured", one per run. Now each pool has a BUDGET of
# units and each run declares a WEIGHT (the units it holds while it runs):
#   cpu pool   budget = nproc * 3/2 units (24 on this 16-core box). One unit is
#              one gate worker, measured at 0.5 core; the budget lets slotted
#              runs use 3/4 of the cores (12 of 16, the fleet's load-1
#              dispatch threshold in athena:dispatch-captain), leaving the
#              rest for the owner and for unslotted work. A W-worker
#              harness-gate (DND-1005) weighs W; an undeclared run weighs
#              budget/3 (8), which is exactly its pre-DND-1006 share of N=3,
#              so a caller that never says --weight sees the old concurrency.
#   model pool budget = 8 runs in flight, weight 1 each. Model-in-loop evals
#              (admiral-eval, critic-eval, variant-eval, block-optimize) and
#              critic-review are network- and model-bound, so they queue here
#              and never hold CPU units. They are routed here by name; any
#              other run by --pool model.
# BASIS (recorded passively from real traffic; DND-1222 forbids generating
# load to measure it, so the DND-489 bench was NOT re-run):
#   * 0.5 core per unit: harness-gate at W=8 on heads 423674a7 and 0d08cb1d
#     (after DND-1203, 2026-09-30T03:11Z and 03:19Z) spent 1094 s and 1049 s
#     CPU (sum of timings.jsonl cpu_s) in 273 s and 257 s of slot time
#     (events.jsonl ran_s): 4.00 and 4.08 cores, 0.50 per worker. The one
#     earlier W=8 run (ef3f2a90, before DND-1203) was 1.31 cores, held down
#     by the 946 s suite-reaper self-test; it is not used.
#   * 3/4 of nproc: 2026-09-27 timing study (a local, gitignored note:
#     ai-artifacts/coordination/2026-09-27-gate-timing-parallelism.md A1, B2
#     row 7; its figures are quoted here): three serial gates
#     holding N=3 ran at load1 2.2-2.8 on 16 cores. 2026-09-30T03:35Z: two
#     undeclared walt_ui gates held 2 of 3 slots at load1 21-26, ~12 cores of
#     containerised beam.smp between them. Undeclared runs are therefore not
#     uniform: that reading is why the default keeps the old share rather
#     than a smaller one, and why a heavy caller should declare --weight.
#   * model 8: transcripts touched 2026-09-27..30 show the account sustained
#     23 concurrent claude sessions at peak (p90 8 at 5-minute samples) with
#     no rate-limit failure recorded, so 8 eval/critic runs in flight on top
#     of the fleet's own p90 stays inside what was already sustained.
#   * queue wait BEFORE (events.jsonl, every caller, N=3): 2026-09-26..28:
#     n=1087 at 15.1 runs/h, median 121 s, p90 836 s, 599 over 60 s.
#     2026-09-29: n=327 at 13.6/h, median 0 s, p90 34 s. AFTER: n/a until
#     traffic accrues under the budget. Method: acquired events in a window,
#     grouped by .pool (absent = cpu), median and p90 of waited_s, with the
#     runs per hour beside them so windows compare at like volume.
#
# FASTER, NEVER WEAKER (ai/blocks/ops/safety-checks.md). test-slot changes only
# WHEN the command runs. It never edits the command's argv, stdin, stdout,
# stderr, or exit status, and adds exactly one environment variable
# (ATHENA_TEST_SLOT_HELD, or ATHENA_TEST_SLOT_HELD_MODEL in the model pool).
# Nothing is skipped, filtered, or loosened. Its own
# messages go to stderr, prefixed `test-slot:`.
#
# LIVENESS IS THE FLOCK, NEVER A PID. A slot is held exactly while some process
# holds flock(2) on slot-<i>.lock. The wrapped command inherits that lock's fd,
# so the slot stays held while the command (or any descendant that kept the fd)
# lives, even if this wrapper is SIGKILLed; the kernel frees it when the last
# holder exits. Holder files and pids are diagnostics only, never read to
# decide availability. Nothing needs reaping.
#
# WAITERS ARE SERVED IN ARRIVAL ORDER (DND-823). Every acquirer takes a
# ticket (under seq.lock) and publishes a flock-held waiters/q-<ticket>.w. A
# waiter blocks in flock(2) on its nearest LIVE predecessor's file and rescans
# when that returns; only the head (no live predecessor) takes queue.lock and
# polls the N slots, at a 2 s sleep cadence, bounded by --wait-timeout (Hard
# Rule safe-wait item 3). No spin. A waiter that dies leaves the queue with its
# flock, so it blocks nobody. Before DND-823 every waiter blocked on
# queue.lock itself and re-joined the kernel's wait list at its back each time
# its `flock -w <heartbeat>` lapsed, so grants followed each waiter's last
# renewal, not arrival: a gate starved 55 min while later ones ran. The long
# waits (seq.lock, the predecessor and queue flocks, the head's poll sleep)
# run as a child the script `wait`s on, so INT/TERM/HUP
# exit a waiter at once and kill that child with it (DND-815); only the
# events.lock append (flock -w 5) still defers a signal, by at most 5 s. A
# waiter prints WAITING with the pool, N, every holder, and its queue
# position before it waits, and a heartbeat (with its position) at least every
# 60 s, so a queued gate never looks like a stall.
#
# A WAITER WHOSE CALLER DIED LEAVES THE QUEUE (DND-925). When the process that
# started test-slot dies, the kernel reparents test-slot and sends it no
# signal, so before DND-925 it kept its queue place, later took a slot, and ran
# a gate nobody was waiting on (measured 2026-09-27, DND-794: a killed zsh left
# a queued harness-gate waiter under PID 1). Now a waiter compares its CURRENT
# parent pid (the kernel's, from /proc/self/stat) with the one it started with
# ($PPID): a reparent changes it, and no pid reuse can change it back, so no
# pid or start time is trusted. It checks before it queues, after every
# blocking wait (capped at PARENT_CHECK_S), before every slot poll, and once
# more immediately before CMD starts; on a change it drops its queue file,
# logs `orphaned`, and exits 129 without running CMD. A caller already gone
# before the first check shows as a start under PID 1 in the host pid
# namespace, refused the same way.
#
# MIXED VERSIONS (the rollout). A pre-DND-823 test-slot still queues on
# queue.lock and never reads q-files. The fixed head takes queue.lock before
# it polls, so there is one slot poller at a time across both versions, and
# the slots stay exclusive by their own flocks in either version. Lock order
# is acyclic: seq.lock (held alone, briefly) -> own q-file -> a predecessor's
# q-file (shared, lower ticket) -> queue.lock -> slot locks; the old version
# takes only queue.lock -> slot locks. Either version removes a waiter file
# only when it can flock it exclusively, i.e. when its owner is dead. Among
# old-version waiters order stays what it was until they drain.
#
# ---------------------------------------------------------------------------
# STABLE INTERFACE (DND-486 wraps integration-gate's run and the captain
# Verify step in this; DND-489's bench uses --exclusive and events.jsonl).
# Changing anything in this block is a breaking change for those callers.
#
#   test-slot [--label TEXT] [--wait-timeout SECONDS] [--outcome-file PATH]
#             [--weight UNITS] [--pool cpu|model] [--exclusive] -- CMD [ARGS...]
#   test-slot --status [--pool cpu|model] [--json]
#   test-slot --help | --self-test
#
#   Always invoke the MAIN checkout's copy by absolute path
#   (~/dev/custom/ai/bin/test-slot), so every caller agrees on the budget.
#
#   The COMMAND is CMD with its wrappers skipped: timeout, env, nice, ionice,
#   nohup, setsid, stdbuf and time, with their own options and arguments
#   (DND-1006). It names the default label, picks the pool and the weight. An
#   option a wrapper table does not know stops the skip there, so the wrapper
#   itself is the command (the default weight and the cpu pool: never lighter).
#   --weight UNITS: units this run holds, 1..budget (DND-1006). Default: a
#     harness-gate COMMAND weighs its worker count (its --jobs, else
#     HARNESS_GATE_JOBS, else min(8, nproc/2), as harness-gate resolves it);
#     any other cpu run weighs the cpu default (budget/3); a model run 1.
#   --pool cpu|model: default model for a critic-review, admiral-eval,
#     critic-eval, variant-eval or block-optimize COMMAND, else cpu.
#
#   Exit codes:
#     <CMD's own code>  CMD ran (including 128+n when a signal killed it)
#     75                the wait timed out; CMD NEVER ran (`test-slot: TIMEOUT`)
#     130/143/129       INT/TERM/HUP arrived while WAITING; CMD NEVER ran
#     129               also: the caller died while this run was WAITING
#                       (`test-slot: ORPHANED`, DND-925); CMD NEVER ran. 129
#                       alone does not say which: stderr and the `orphaned`
#                       event do. (141 instead if the dead caller's stderr
#                       is a broken pipe; the queue place is gone by then.)
#     2                 usage/misuse; CMD never ran (bad flag, no `--`/CMD,
#                       invalid N seam, pool dir unusable, cannot register
#                       in the queue, or, since DND-925, cannot read its own
#                       parent pid from /proc: a new refusal, since a run it
#                       cannot tie to a live caller is never queued)
#   --outcome-file PATH: removed at start, then written with exactly one line:
#     `timeout`         the wait timed out; CMD never ran
#     `ran exit=<n>`    CMD ran and exited <n>
#     (file absent)     no outcome recorded: test-slot refused (exit 2), a
#                       signal ended it while WAITING (exit 128+n) or its
#                       caller died then (exit 129); CMD never ran; or the
#                       wrapper was
#                       SIGKILLed (see RESIDUALS)
#   This is how a caller tells "CMD exited 75" from "the wait timed out".
#
#   Environment set for CMD: ATHENA_TEST_SLOT_HELD=<pool dir>:<slot> (cpu
#   pool; <slot> is the run's lowest unit), or ATHENA_TEST_SLOT_HELD_MODEL
#   for a model run (DND-1006: one marker per pool, so nesting across pools
#   never hides the outer marker). A nested test-slot in the same pool that
#   sees it (and finds that unit's lock still held) runs its CMD directly
#   without taking more units, so nesting cannot self-deadlock.
#
#   Pools: cpu = ${XDG_STATE_HOME:-$HOME/.local/state}/athena/test-slots/
#   (0700), model = its model/ subdirectory (0700). Each holds the files below.
#     slot-<i>.lock      one budget UNIT; flock = liveness; never deleted. A run
#                        of weight w holds w of them. Units are taken highest
#                        first, so a pre-DND-1006 run (it knows slots 1..3
#                        only) finds its slots free while new runs hold others.
#     slot-<i>.holder    JSON {label,cwd,pid,started_at,exclusive,pool,weight,
#                        sha,tree}; diagnostic
#     seq.lock           guards ticket issue and the reaping of dead waiters
#     queue.lock         the queue head (and any pre-DND-823 waiter) blocks here
#     waiters/q-<ticket>.w  one per live waiter, flock-held by it; ticket
#                        order = arrival order (DND-823). JSON {label,cwd,pid,
#                        since,ticket}. waiters/<pid>-<epoch>.w is a
#                        pre-DND-823 waiter (unordered)
#     events.jsonl       one JSON line per event {ts,event,slot,label,cwd,pid,
#                        exclusive,waited_s,ran_s,exit,pool,weight,sha,tree};
#                        slot is the lowest unit held; sha/tree are the git
#                        HEAD and top level of the caller's cwd (null outside
#                        a work tree), read again for `released` so a rebase
#                        inside the slot shows (DND-1006); a `reentrant`
#                        event has weight 0 (it takes no units); event is one of
#                        waiting|acquired|released|timeout|reentrant|orphaned
#                        (orphaned: DND-925, the caller died; it can follow
#                        an `acquired` whose CMD then never started, and no
#                        `released` follows it); rotated to
#                        events.jsonl.1 past 1 MiB (one generation kept)
#   --exclusive: BENCH ONLY. Holds the whole cpu budget before CMD runs
#     (DND-489's bench quiesces the fleet with it). No gate, eval or critic
#     path takes it: it is the one machine-wide mutex, and the self-test
#     fails if a repo caller passes it. Refused with --weight or --pool model.
#     Holder lines say EXCLUSIVE.
#   --status [--pool P] [--json]: the pool's budget and basis, the default
#     weight, units held, waiting/unslotted counts, load1, nproc, then each
#     holder (one line per run, with its units and weight), waiter, and heavy
#     run WITHOUT a slot (UNSLOTTED; cpu pool only). Each waiter has its queue
#     position (text `WAITING #<k>:`, JSON "position": k; 1 = served next;
#     null for a pre-DND-823 waiter). With no --pool it shows both pools; its
#     JSON is the cpu pool's document with the model pool's under "model".
#     JSON keeps "n" (= the budget) and "n_basis"; "held" counts units; each
#     holder is one RUN with "units", "weight" and "slot" (its lowest unit,
#     the pre-DND-1006 key). Read-only: never creates the pool.
#
#   Test seams (self-test only): ATHENA_TEST_SLOT_DIR (cpu pool dir; the
#   model pool is its model/); ATHENA_TEST_SLOTS (cpu budget),
#   ATHENA_TEST_SLOT_DEFAULT_WEIGHT (cpu default weight), ATHENA_TEST_MODEL_SLOTS
#   (model budget) and ATHENA_TEST_SLOT_HEARTBEAT (seconds) are honored ONLY
#   when ATHENA_TEST_SLOT_DIR is set to a non-default path, so no override can
#   change the real pool. An honored-but-invalid value is exit 2, never a
#   fallback.
# ---------------------------------------------------------------------------
#
# RESIDUALS (named, not hidden)
#   * Cooperative only: a heavy run that never calls test-slot is not bounded.
#     --status lists it as UNSLOTTED (own uid only). A heavy run inside a
#     docker container (another pid namespace) never inherits our env, so its
#     slot cannot be read: it is listed as CONTAINER and counted apart
#     (in_container=), never as slotted or unslotted.
#   * A descendant that daemonizes while keeping the inherited lock fd keeps
#     the slot held until it exits. --status names the holder label and cwd.
#   * Containers started by `docker compose run` belong to dockerd; a SIGKILL
#     of the whole tree can leave one running after the slot frees.
#   * Re-entrancy trusts ATHENA_TEST_SLOT_HELD plus "that slot's lock is held
#     by someone". A process that started inside an earlier slot, outlived
#     it, and runs test-slot after another run re-took that same slot would
#     skip the pool. It needs a descendant that survives its slot; rare.
#   * An absent --outcome-file means test-slot refused (exit 2), a signal
#     ended it while WAITING (exit 128+n), OR the wrapper itself was
#     SIGKILLed before writing it; in every case no outcome
#     was recorded, so a caller must not read absence as "CMD never ran".
#   * A terminal ^C already reaches CMD (same process group), so INT is
#     forwarded only when test-slot is NOT in its terminal's foreground
#     process group; a programmatic `kill -INT` to a foreground wrapper is
#     therefore not forwarded (TERM/HUP always are).
#   * --status probes a lock with a non-blocking SHARED flock on a fresh fd; an
#     acquirer racing that probe sees the slot busy for microseconds and simply
#     tries the next slot or the next 2 s poll.
#   * FIFO is strict, so the queue is head-of-line: every waiter waits behind
#     the head, including a heavy head (or an --exclusive one) that needs more
#     units than are free. The head keeps the units it has taken while it
#     waits for the rest, as --exclusive always did; nobody behind it could
#     use them anyway. The pools queue independently.
#   * A weight is declared, not measured. An undeclared heavy run holds the
#     default whatever it really burns (see BASIS: a walt_ui gate ran near 6
#     cores). Declare --weight for a run you know is heavier or lighter.
#   * THE UPGRADE (DND-1006). A run already holding a slot keeps it: slot-1..3
#     are units 1..3 of the budget, so each counts as ONE unit until it ends
#     (under-weighted while it lasts). A waiter started by the old script
#     keeps its queue place (same q-files, same queue.lock) and, as head,
#     polls slots 1..3 only; new runs take units highest first, so those stay
#     free longest. Each such old run is bounded by its own CMD or
#     --wait-timeout; after that every holder is weighted.
#     A waiter that is stopped (SIGSTOP) but alive keeps its place, because
#     it still holds its flock; --status shows it at its position.
#   * Parent death is watched only while WAITING (DND-925). Once CMD runs,
#     test-slot waits on it without a timer, so a killed caller leaves a
#     RUNNING gate running to completion in its slot.
#   * A caller that dies before test-slot's bash starts is caught only when
#     test-slot then starts under PID 1 in the host pid namespace. If a child
#     subreaper adopts it first, or it runs in its own pid namespace (a
#     container, whose init is a legitimate parent there), the adopter is
#     indistinguishable from a live caller at startup, so the run proceeds.
#     A caller that dies LATER is caught in both, since the parent changes.
#   * A caller that deliberately detaches a QUEUED run (`nohup test-slot ...
#     &` and then exits) now loses it. Give the run a parent that waits, e.g.
#     `setsid bash -c 'test-slot -- CMD; exit $?' &`.
#   * While pre-DND-823 waiters remain queued (the rollout; at most their
#     --wait-timeout), they are unordered among themselves and compete with
#     the fixed head for queue.lock. --status lists them without a position.
#
# Self-test: ai/test/test-slot/self-test.sh (discovered by harness-gate);
# `test-slot --self-test` execs it.

set -u -o pipefail

PROG=test-slot
# The budgets (DND-1006). BASIS in the header holds the measurements.
# cpu budget = nproc * CPU_SLOTTED_NUM/CPU_SLOTTED_DEN cores * CPU_UNITS_PER_CORE.
CPU_SLOTTED_NUM=3
CPU_SLOTTED_DEN=4
CPU_UNITS_PER_CORE=2
# An undeclared cpu run weighs budget/CPU_DEFAULT_SHARES: its old share of N=3.
CPU_DEFAULT_SHARES=3
CPU_BUDGET_BASIS="measured 2026-09-30: 0.5 core/unit (W=8 harness-gate = 4.0 cores); 3/4 of nproc for slotted runs"
MODEL_BUDGET=8
MODEL_DEFAULT_WEIGHT=1
MODEL_BUDGET_BASIS="8 runs in flight; the account sustained 23 concurrent sessions 2026-09-27..30"
# COMMANDs that queue in the model pool unless --pool says otherwise.
MODEL_COMMANDS=" critic-review admiral-eval critic-eval variant-eval block-optimize "
# harness-gate's own worker default (ai/bin/harness-gate gate_jobs):
# min(max(nproc/2, 1), HARNESS_GATE_MAX_JOBS).
HARNESS_GATE_MAX_JOBS=8
# Run state main sets; these defaults keep a sourced copy (the self-test) whole.
POOL_KIND=cpu
WEIGHT=1
GATE_SHA=""
GATE_TREE=""
EXIT_USAGE=2
EXIT_TIMEOUT=75
POLL_S=2
DEFAULT_WAIT_TIMEOUT_S=7200
DEFAULT_HEARTBEAT_S=60
QUEUE_GRACE_S=1
WAITER_REAP_AGE_S=10
# DND-925: a blocked waiter re-checks its caller at least this often.
PARENT_CHECK_S=5
# PROC_PID_INIT_INO: the kernel's fixed inode for the initial (host) pid
# namespace, so "parent is PID 1" means init only when this matches.
HOST_PID_NS='pid:[4026531836]'
EVENTS_MAX_BYTES=1048576

usage() {
  cat <<'TXT'
Usage:
  test-slot [--label TEXT] [--wait-timeout SECONDS] [--outcome-file PATH]
            [--weight UNITS] [--pool cpu|model] [--exclusive] -- CMD [ARGS...]
  test-slot --status [--pool cpu|model] [--json]
  test-slot --help | --self-test

Run CMD once its weight fits the machine-wide budget of its pool. The cpu pool
holds nproc*3/2 units (one unit = one gate worker, ~0.5 core); the model pool
holds 8 model-bound runs. CMD's argv, stdin, stdout, stderr, and exit code pass
through unchanged. The COMMAND is CMD after timeout/env/nice/ionice/nohup/
setsid/stdbuf/time wrappers.

  --label TEXT          shown to waiters and in --status
                        (default: "<repo or cwd basename> <COMMAND basename>")
  --wait-timeout SECS   give up waiting after SECS (default 7200); exit 75
  --outcome-file PATH   write `timeout` or `ran exit=<n>` (removed at start)
  --weight UNITS        units to hold (default: a harness-gate's worker count,
                        else budget/3 in the cpu pool, 1 in the model pool)
  --pool cpu|model      default model for critic-review, admiral-eval,
                        critic-eval, variant-eval, block-optimize; else cpu
  --exclusive           BENCH ONLY: hold the whole cpu budget while CMD runs
  --status              show the budget, holders, waiters, UNSLOTTED runs
  --self-test           run the hermetic self-test suite

Exit: CMD's code if it ran | 75 wait timed out, CMD never ran | 2 usage |
      129 caller died while waiting (ORPHANED), CMD never ran.
Pool: ${XDG_STATE_HOME:-~/.local/state}/athena/test-slots/ (flock liveness).
Invoke the main checkout's copy by absolute path: ~/dev/custom/ai/bin/test-slot
TXT
}

# ============================================================ pure helpers
# (no I/O; exercised directly by the self-test)

# parse_n RAW — print RAW if it is a positive integer <= 64, else return 1.
parse_n() {
  [[ $1 =~ ^[1-9][0-9]{0,1}$ ]] || return 1
  (($1 <= 64)) || return 1
  printf '%s\n' "$1"
}

is_pos_int() { [[ $1 =~ ^[1-9][0-9]*$ ]]; }

# outcome_line KIND [EXIT] — the one line --outcome-file carries.
outcome_line() {
  case $1 in
    timeout) printf 'timeout\n' ;;
    ran) printf 'ran exit=%s\n' "$2" ;;
  esac
}

# unwrap_index ARGV... — the index in ARGV of the COMMAND: the first word that
# is not a timeout/env/nice/ionice/nohup/setsid/stdbuf/time wrapper, its
# options, or their arguments (timeout's DURATION, env's NAME=VALUE). A wrapper
# option not in these tables stops the skip at that wrapper, so the wrapper is
# the COMMAND. Prints n (one past the end) when wrappers wrap nothing.
unwrap_index() {
  local -a v=("$@")
  local n=${#v[@]} i=0 w b a dd
  while ((i < n)); do
    w=$i
    b=${v[i]##*/}
    i=$((i + 1))
    dd=0
    case $b in
      timeout)
        while ((i < n)); do
          a=${v[i]}
          case $a in
            --) i=$((i + 1)); break ;;
            -s | -k | --signal | --kill-after) i=$((i + 2)) ;;
            --signal=* | --kill-after=* | --preserve-status | --foreground | -v | --verbose | -s?* | -k?*) i=$((i + 1)) ;;
            -*) printf '%s\n' "$w"; return ;;
            *) break ;;
          esac
        done
        ((i < n)) || { printf '%s\n' "$n"; return; }
        i=$((i + 1)) # DURATION
        ;;
      env)
        # Options, then NAME=VALUE assignments (after `--` or the first
        # assignment, a word starting with `-` is the COMMAND).
        while ((i < n)); do
          a=${v[i]}
          if ((dd)) || [[ $a != -* ]]; then
            [[ $a == *=* ]] || break
            dd=1
            i=$((i + 1))
            continue
          fi
          case $a in
            --) dd=1; i=$((i + 1)) ;;
            -i | -0 | - | -v | --ignore-environment | --null | --debug | --list-signal-handling) i=$((i + 1)) ;;
            -u | -C | --unset | --chdir) i=$((i + 2)) ;;
            -u?* | -C?* | --unset=* | --chdir=* | --default-signal | --default-signal=* | --ignore-signal | --ignore-signal=* | --block-signal | --block-signal=*) i=$((i + 1)) ;;
            -*) printf '%s\n' "$w"; return ;;
            *) break ;;
          esac
        done
        ;;
      nice)
        while ((i < n)); do
          a=${v[i]}
          case $a in
            --) i=$((i + 1)); break ;;
            -n | --adjustment) i=$((i + 2)) ;;
            -n?* | --adjustment=* | -[0-9]*) i=$((i + 1)) ;;
            -*) printf '%s\n' "$w"; return ;;
            *) break ;;
          esac
        done
        ;;
      ionice)
        while ((i < n)); do
          a=${v[i]}
          case $a in
            --) i=$((i + 1)); break ;;
            -c | -n | --class | --classdata) i=$((i + 2)) ;;
            -c?* | -n?* | --class=* | --classdata=* | -t | --ignore) i=$((i + 1)) ;;
            -*) printf '%s\n' "$w"; return ;;
            *) break ;;
          esac
        done
        ;;
      nohup)
        [[ ${v[i]:-} == -- ]] && i=$((i + 1))
        ;;
      setsid)
        while ((i < n)); do
          a=${v[i]}
          case $a in
            --) i=$((i + 1)); break ;;
            -c | -f | -w | --ctty | --fork | --wait) i=$((i + 1)) ;;
            -*) printf '%s\n' "$w"; return ;;
            *) break ;;
          esac
        done
        ;;
      stdbuf)
        while ((i < n)); do
          a=${v[i]}
          case $a in
            --) i=$((i + 1)); break ;;
            -i | -o | -e) i=$((i + 2)) ;;
            -i?* | -o?* | -e?* | --input=* | --output=* | --error=*) i=$((i + 1)) ;;
            -*) printf '%s\n' "$w"; return ;;
            *) break ;;
          esac
        done
        ;;
      time)
        while ((i < n)); do
          a=${v[i]}
          case $a in
            --) i=$((i + 1)); break ;;
            -o | -f | --output | --format) i=$((i + 2)) ;;
            -p | -a | -v | -q | --portability | --append | --verbose | --quiet | --output=* | --format=*) i=$((i + 1)) ;;
            -*) printf '%s\n' "$w"; return ;;
            *) break ;;
          esac
        done
        ;;
      *)
        printf '%s\n' "$w"
        return
        ;;
    esac
  done
  ((i > n)) && i=$n
  printf '%s\n' "$i"
}

# command_word ARGV... — the COMMAND (see unwrap_index), or ARGV[0] when the
# wrappers wrap nothing.
command_word() {
  local i
  i=$(unwrap_index "$@")
  if ((i < $#)); then
    local -a v=("$@")
    printf '%s\n' "${v[i]}"
  else
    printf '%s\n' "$1"
  fi
}

# pick_label DIR ARGV... — default label: "<basename DIR> <basename COMMAND>".
pick_label() {
  local dir=$1 cmd
  shift
  cmd=$(command_word "$@")
  printf '%s %s\n' "${dir##*/}" "${cmd##*/}"
}

# infer_pool ARGV... — model when the COMMAND is a model-in-loop tool, else cpu.
infer_pool() {
  local cmd
  cmd=$(command_word "$@")
  if [[ $MODEL_COMMANDS == *" ${cmd##*/} "* ]]; then printf 'model\n'; else printf 'cpu\n'; fi
}

# cpu_budget NPROC — the cpu pool's budget in units (never below 1).
cpu_budget() {
  local b=$(($1 * CPU_SLOTTED_NUM * CPU_UNITS_PER_CORE / CPU_SLOTTED_DEN))
  ((b < 1)) && b=1
  printf '%s\n' "$b"
}

# cpu_default_weight BUDGET — an undeclared cpu run's weight (never below 1).
cpu_default_weight() {
  local w=$(($1 / CPU_DEFAULT_SHARES))
  ((w < 1)) && w=1
  printf '%s\n' "$w"
}

# gate_jobs NPROC ENV_JOBS ARGV... — the worker count a harness-gate COMMAND in
# ARGV will use, resolved as harness-gate resolves it: its --jobs, else the
# HARNESS_GATE_JOBS it will see, else min(max(NPROC/2, 1), 8). What it will
# see starts as ENV_JOBS (this environment's value) and follows the env
# wrappers in front of it: NAME=V sets it; -i, -u/--unset HARNESS_GATE_JOBS
# clear it; empty means unset, as in harness-gate. A value over 6 digits
# prints 999999 (the caller clamps it to the budget). Prints nothing,
# returning 1, when the COMMAND is not harness-gate or the value is not a
# positive integer (harness-gate refuses that itself; the caller falls back).
# NPROC is the machine's online CPU count; harness-gate counts cores with
# Etc.nprocessors, which honours CPU affinity, so under taskset this weighs a
# gate heavier than its workers, never lighter.
gate_jobs() {
  local nproc=$1 cur=$2 i j a b wrap="" val="" found=0
  shift 2
  local -a v=("$@")
  i=$(unwrap_index "$@")
  ((i < ${#v[@]})) && [[ ${v[i]##*/} == harness-gate ]] || return 1
  for ((j = i + 1; j < ${#v[@]}; j++)); do
    a=${v[j]}
    case $a in
      --jobs) val=${v[j + 1]:-}; found=1; break ;;
      --jobs=*) val=${a#--jobs=}; found=1; break ;;
    esac
  done
  if ((!found)); then
    for ((j = 0; j < i; j++)); do
      a=${v[j]}
      b=${a##*/}
      case $b in
        timeout | env | nice | ionice | nohup | setsid | stdbuf | time) wrap=$b; continue ;;
      esac
      [ "$wrap" = env ] || continue
      case $a in
        -i | - | --ignore-environment | -uHARNESS_GATE_JOBS | --unset=HARNESS_GATE_JOBS) cur="" ;;
        -u | --unset) [ "${v[j + 1]:-}" = HARNESS_GATE_JOBS ] && cur=""; j=$((j + 1)) ;;
        HARNESS_GATE_JOBS=*) cur=${a#HARNESS_GATE_JOBS=} ;;
      esac
    done
    if [ -n "$cur" ]; then val=$cur; found=1; fi
  fi
  if ((!found)); then
    val=$((nproc / 2))
    ((val < 1)) && val=1
    ((val > HARNESS_GATE_MAX_JOBS)) && val=$HARNESS_GATE_MAX_JOBS
  fi
  [[ $val =~ ^[1-9][0-9]*$ ]] || return 1
  ((${#val} > 6)) && val=999999
  printf '%s\n' "$val"
}

# json_str S — S as a JSON string literal (quotes included).
json_str() {
  local s=$1
  s=${s//\\/\\\\}
  s=${s//\"/\\\"}
  s=${s//$'\n'/\\n}
  s=${s//$'\t'/\\t}
  s=${s//$'\r'/\\r}
  if [[ $s == *[[:cntrl:]]* ]]; then
    s=$(printf '%s' "$s" | LC_ALL=C tr -d '\000-\037\177')
  fi
  printf '"%s"' "$s"
}

# one_line S — S with newlines/tabs flattened, for a human-readable line.
one_line() { local s=${1//$'\n'/ }; printf '%s' "${s//$'\t'/ }"; }

# compact_units "3 4 5 9" — "3-5,9" (the units one run holds, ascending).
compact_units() {
  local out="" start="" prev="" u
  for u in $1; do
    if [ -n "$prev" ] && ((u == prev + 1)); then prev=$u; continue; fi
    [ -n "$start" ] && out+="${out:+,}$start$([ "$prev" != "$start" ] && printf -- '-%s' "$prev")"
    start=$u
    prev=$u
  done
  [ -n "$start" ] && out+="${out:+,}$start$([ "$prev" != "$start" ] && printf -- '-%s' "$prev")"
  printf '%s\n' "$out"
}

# format_holder_line UNITS LABEL CWD SINCE PID EXCLUSIVE WEIGHT — one line per
# run; UNITS is the space-separated list of units it holds.
format_holder_line() {
  local excl="" n
  [ "$6" = true ] && excl=" EXCLUSIVE"
  n=$(wc -w <<<"$1")
  printf 'units %s (%s of weight %s): %s in %s since %s (pid %s, diagnostic)%s\n' \
    "$(compact_units "$1")" "$n" "$7" "$(one_line "$2")" "$(one_line "$3")" "$4" "$5" "$excl"
}

# fmt_ms MS — milliseconds as seconds with 3 decimals.
fmt_ms() { printf '%d.%03d' $(($1 / 1000)) $(($1 % 1000)); }

# is_heavy_argv ARGV... — 0 when ARGV is a heavy run test-slot should wrap:
#   * a prep-commit.sh run (argv0, or argv1 after a shell), or
#   * a FULL `mix test` (no path argument) under mix/elixir/beam/a shell.
# Anything naming test-slot is the wrapper itself, never a heavy run.
is_heavy_argv() {
  local -a v=("$@")
  local n=${#v[@]} i j a0 a
  ((n > 0)) || return 1
  for a in "${v[@]}"; do [[ ${a##*/} == test-slot ]] && return 1; done
  a0=${v[0]##*/}
  [[ $a0 == prep-commit.sh ]] && return 0
  if ((n > 1)) && [[ ${v[1]##*/} == prep-commit.sh ]]; then
    case $a0 in sh | bash | dash | zsh | env) return 0 ;; esac
  fi
  case $a0 in
    mix | elixir | beam | beam.smp | erl | erlexec | sh | bash | dash | zsh | env) ;;
    *) return 1 ;;
  esac
  for ((i = 0; i < n - 1; i++)); do
    [[ ${v[i]##*/} == mix && ${v[i + 1]} == test ]] || continue
    for ((j = i + 2; j < n; j++)); do
      a=${v[j]}
      [[ $a == */* || $a == *.exs || $a == *.exs:* ]] && return 1
    done
    return 0
  done
  return 1
}

# unslotted_state NS_SELF NS_PID ENV_RC — classify a heavy run for --status:
#   container  it lives in another pid namespace (docker does not pass our env
#              in, so its slot cannot be read; never counted as unslotted)
#   slotted    its environ carries ATHENA_TEST_SLOT_HELD (grep rc 0)
#   unslotted  its environ lacks it (grep rc 1)
#   unknown    its environ could not be read (never read as slotted)
unslotted_state() {
  if [ -n "$1" ] && [ -n "$2" ] && [ "$1" != "$2" ]; then
    printf 'container\n'
    return
  fi
  case $3 in
    0) printf 'slotted\n' ;;
    1) printf 'unslotted\n' ;;
    *) printf 'unknown\n' ;;
  esac
}

# default_signals SIGIGN_HEX — which of INT/QUIT to reset to default for CMD,
# given this process's entry SigIgn mask (/proc/self/status, hex). bash starts
# a backgrounded command with INT and QUIT ignored, and an ignored-at-exec
# signal cannot be trapped or reset by a script; so each of INT/QUIT that was
# NOT ignored when test-slot started is reset for CMD, and one the caller
# deliberately ignored (nohup-style) stays ignored. Prints e.g. "INT,QUIT".
default_signals() {
  local mask out=""
  [[ $1 =~ ^[0-9a-fA-F]+$ ]] || { printf 'INT,QUIT\n'; return; }
  mask=$((16#${1: -8}))
  ((mask & 0x2)) || out="INT"
  ((mask & 0x4)) || out="${out:+$out,}QUIT"
  printf '%s\n' "$out"
}

# parent_state ORIG CUR NS: is the caller that started test-slot still its
# parent? ORIG is the parent pid at start ($PPID), CUR the parent pid now
# (/proc/self/stat), NS this process's pid namespace link. The kernel changes a
# process's parent only by reparenting it when the parent dies, so CUR != ORIG
# means the caller is gone. ORIG == 1 in the host namespace means the caller
# was gone before test-slot started (only init's own children start there).
# NS is consulted only then. Prints alive | gone | unknown (an unreadable
# input it needs is never "alive").
parent_state() {
  [[ $1 =~ ^[0-9]+$ && $2 =~ ^[0-9]+$ ]] || { printf 'unknown\n'; return; }
  if [ "$1" != "$2" ]; then printf 'gone\n'; return; fi
  if [ "$1" = 1 ]; then
    [ -n "$3" ] || { printf 'unknown\n'; return; }
    [ "$3" = "$HOST_PID_NS" ] && { printf 'gone\n'; return; }
  fi
  printf 'alive\n'
}

# ============================================================ side effects

now_ms() { local t=${EPOCHREALTIME/./}; printf '%s\n' $((10#$t / 1000)); }
iso_now() { date -u +%Y-%m-%dT%H:%M:%SZ; }
say() { printf '%s: %s\n' "$PROG" "$*" >&2; }

die_usage() { # die_usage MESSAGE FIX
  printf '%s: %s\n' "$PROG" "$1" >&2
  printf 'Fix: %s\n' "$2" >&2
  exit "$EXIT_USAGE"
}

canon() { realpath -m -- "$1" 2>/dev/null || printf '%s\n' "$1"; }

default_pool_dir() {
  local base=${XDG_STATE_HOME:-}
  if [[ $base != /* ]]; then
    [ -n "${HOME:-}" ] || die_usage "HOME is unset; cannot locate the slot pool." \
      "run with HOME set (the pool lives under \$HOME/.local/state/athena/test-slots)."
    base="$HOME/.local/state"
  fi
  printf '%s/athena/test-slots\n' "$base"
}

# read_nproc — sets NPROC to the online CPU count, or refuses (exit 2): the
# cpu budget is derived from it, and a count it cannot read is never a guess.
read_nproc() {
  NPROC=$(getconf _NPROCESSORS_ONLN 2>/dev/null) || NPROC=""
  [[ $NPROC =~ ^[1-9][0-9]*$ ]] || NPROC=$(nproc 2>/dev/null) || NPROC=""
  [[ $NPROC =~ ^[1-9][0-9]*$ ]] || die_usage \
    "cannot read the online CPU count (getconf _NPROCESSORS_ONLN and nproc both failed); the cpu budget is derived from it." \
    "run test-slot where getconf or nproc (coreutils) works; it never guesses the budget."
}

# seam_count VAR — the value of self-test seam VAR as a count 1..64, or exit 2.
seam_count() {
  parse_n "${!1}" || die_usage "$1='${!1}' is not a unit count." \
    "set $1 to an integer 1..64, or unset it (it is a self-test seam; an invalid value never falls back)."
}

# resolve_pool — sets POOL_ROOT (the cpu pool dir), POOL (the dir of pool
# POOL_KIND), N (its budget in units), N_BASIS, DEFAULT_WEIGHT, NPROC and
# HEARTBEAT_S from the defaults and the seams.
resolve_pool() {
  local def seam v
  def=$(canon "$(default_pool_dir)")
  POOL_ROOT=$def
  read_nproc
  HEARTBEAT_S=$DEFAULT_HEARTBEAT_S
  seam=${ATHENA_TEST_SLOT_DIR:-}
  if [ -n "$seam" ]; then
    POOL_ROOT=$(canon "$seam")
  fi
  local cpu_n cpu_basis=$CPU_BUDGET_BASIS cpu_w model_n=$MODEL_BUDGET model_basis=$MODEL_BUDGET_BASIS
  cpu_n=$(cpu_budget "$NPROC")
  cpu_w=""
  if [ -n "$seam" ] && [ "$POOL_ROOT" != "$def" ]; then
    if [ -n "${ATHENA_TEST_SLOTS+x}" ]; then
      cpu_n=$(seam_count ATHENA_TEST_SLOTS) || exit "$EXIT_USAGE"
      cpu_basis="test seam"
    fi
    if [ -n "${ATHENA_TEST_SLOT_DEFAULT_WEIGHT+x}" ]; then
      cpu_w=$(seam_count ATHENA_TEST_SLOT_DEFAULT_WEIGHT) || exit "$EXIT_USAGE"
    fi
    if [ -n "${ATHENA_TEST_MODEL_SLOTS+x}" ]; then
      model_n=$(seam_count ATHENA_TEST_MODEL_SLOTS) || exit "$EXIT_USAGE"
      model_basis="test seam"
    fi
    if [ -n "${ATHENA_TEST_SLOT_HEARTBEAT+x}" ]; then
      is_pos_int "$ATHENA_TEST_SLOT_HEARTBEAT" || die_usage \
        "ATHENA_TEST_SLOT_HEARTBEAT='$ATHENA_TEST_SLOT_HEARTBEAT' is not a positive integer." \
        "set it to whole seconds, or unset it (it is a self-test seam)."
      HEARTBEAT_S=$ATHENA_TEST_SLOT_HEARTBEAT
    fi
  else
    for v in ATHENA_TEST_SLOTS ATHENA_TEST_SLOT_DEFAULT_WEIGHT ATHENA_TEST_MODEL_SLOTS ATHENA_TEST_SLOT_HEARTBEAT; do
      [ -n "${!v+x}" ] || continue
      say "WARN ignoring $v: the test seams apply only with ATHENA_TEST_SLOT_DIR set to a non-default pool; the real pools use their measured budgets."
    done
  fi
  [ -n "$cpu_w" ] || cpu_w=$(cpu_default_weight "$cpu_n")
  if [ "$POOL_KIND" = model ]; then
    POOL="$POOL_ROOT/model"
    N=$model_n
    N_BASIS=$model_basis
    DEFAULT_WEIGHT=$MODEL_DEFAULT_WEIGHT
  else
    POOL=$POOL_ROOT
    N=$cpu_n
    N_BASIS=$cpu_basis
    DEFAULT_WEIGHT=$cpu_w
  fi
}

# pool_problem — print why an EXISTING pool path is unusable (empty if fine).
pool_problem() {
  local dir=$1 owner mode
  if [ -L "$dir" ]; then printf 'is a symlink'; return; fi
  if [ ! -d "$dir" ]; then printf 'is not a directory'; return; fi
  owner=$(stat -c %u -- "$dir" 2>/dev/null) || { printf 'cannot be stat-ed'; return; }
  mode=$(stat -c %a -- "$dir" 2>/dev/null) || { printf 'cannot be stat-ed'; return; }
  if [ "$owner" != "$(id -u)" ]; then printf 'is owned by uid %s, not %s' "$owner" "$(id -u)"; return; fi
  if [ "$mode" != 700 ]; then printf 'has mode %s, not 700' "$mode"; return; fi
}

refuse_pool() { # refuse_pool DIR PROBLEM
  die_usage "slot pool $1 $2." \
    "make it a real directory owned by you with mode 0700: \`chmod 700 '$1'\` (or remove it if it is not yours to use), then re-run."
}

# ensure_pool_dir DIR — create DIR 0700 if absent, then refuse it unless it
# is a real directory of ours with mode 0700.
ensure_pool_dir() {
  local problem
  if [ ! -e "$1" ] && [ ! -L "$1" ]; then
    mkdir -p -- "$(dirname -- "$1")" 2>/dev/null
    mkdir -m 0700 -- "$1" 2>/dev/null || [ -d "$1" ] || die_usage \
      "cannot create slot pool $1." \
      "make its parent directory writable by you, or point XDG_STATE_HOME at a writable state dir."
  fi
  problem=$(pool_problem "$1")
  [ -z "$problem" ] || refuse_pool "$1" "$problem"
}

ensure_pool() {
  local sub
  # The model pool lives inside the cpu pool dir, so the cpu dir is made
  # (0700) first: `mkdir -p` would leave it at the umask's mode.
  ensure_pool_dir "$POOL_ROOT"
  [ "$POOL" = "$POOL_ROOT" ] || ensure_pool_dir "$POOL"
  sub="$POOL/waiters"
  if [ ! -d "$sub" ]; then
    mkdir -m 0700 -- "$sub" 2>/dev/null || [ -d "$sub" ] || die_usage \
      "cannot create $sub." "check the permissions of $POOL (must be yours, mode 0700)."
  fi
}

# lock_held FILE — 0 when some process holds a flock on FILE. Probes with a
# non-blocking SHARED lock on a fresh open file description; never writes.
lock_held() {
  local fd
  [ -e "$1" ] || return 1
  { exec {fd}<"$1"; } 2>/dev/null || return 1
  if flock -n -s "$fd"; then
    exec {fd}<&-
    return 1
  fi
  exec {fd}<&-
  return 0
}

declare -A SLOT_FD=()

# try_slot I — take slot I without blocking; record its fd in SLOT_FD[I].
try_slot() {
  local i=$1 fd
  { exec {fd}>>"$POOL/slot-$i.lock"; } 2>/dev/null || return 1
  if flock -n "$fd"; then
    SLOT_FD[$i]=$fd
    write_holder "$i"
    return 0
  fi
  exec {fd}>&-
  return 1
}

# try_acquire — take free units, highest first, until this run holds WEIGHT
# of them (all N for --exclusive); units taken on an earlier poll are kept.
# Succeeds (setting SLOT to the lowest unit held) once it holds WEIGHT.
try_acquire() {
  local i u
  for ((i = N; i >= 1 && ${#SLOT_FD[@]} < WEIGHT; i--)); do
    [ -n "${SLOT_FD[$i]:-}" ] || try_slot "$i" || true
  done
  ((${#SLOT_FD[@]} >= WEIGHT)) || return 1
  SLOT=""
  for u in "${!SLOT_FD[@]}"; do
    if [ -z "$SLOT" ] || ((u < SLOT)); then SLOT=$u; fi
  done
  return 0
}

HOLD_SINCE=""
write_holder() {
  local i=$1 f="$POOL/slot-$1.holder" excl=false
  ((EXCLUSIVE)) && excl=true
  [ -n "$HOLD_SINCE" ] || HOLD_SINCE=$(iso_now)
  if printf '{"label":%s,"cwd":%s,"pid":%s,"started_at":"%s","exclusive":%s,"pool":"%s","weight":%s,"sha":%s,"tree":%s}\n' \
    "$(json_str "$LABEL")" "$(json_str "$PWD")" "$$" "$HOLD_SINCE" "$excl" "$POOL_KIND" "$WEIGHT" \
    "$(json_or_null "$GATE_SHA")" "$(json_or_null "$GATE_TREE")" >"$f.$$.tmp" 2>/dev/null; then
    mv -f -- "$f.$$.tmp" "$f" 2>/dev/null || rm -f -- "$f.$$.tmp"
  fi
}

# json_or_null S — S as a JSON string, or null when S is empty.
json_or_null() { if [ -n "$1" ]; then json_str "$1"; else printf 'null'; fi; }

# read_gate_ref — sets GATE_SHA and GATE_TREE to the git HEAD and top level of
# the cwd (empty outside a work tree, recorded as null), so an event names what
# was gated (DND-1006).
read_gate_ref() {
  GATE_TREE=$(git rev-parse --show-toplevel 2>/dev/null) || GATE_TREE=""
  GATE_SHA=""
  [ -n "$GATE_TREE" ] && { GATE_SHA=$(git rev-parse --verify -q 'HEAD^{commit}' 2>/dev/null) || GATE_SHA=""; }
  return 0
}

# append_event EVENT SLOT WAITED_MS RAN_MS EXIT — one line to events.jsonl,
# rotating past EVENTS_MAX_BYTES. A logging failure warns; it never changes
# whether or how CMD runs.
append_event() {
  local fd size line excl=false weight=$WEIGHT
  ((EXCLUSIVE)) && excl=true
  # A re-entrant run takes no units: weight 0, so summing weights over events
  # never counts the outer run twice.
  [ "$1" = reentrant ] && weight=0
  line=$(printf '{"ts":"%s","event":"%s","slot":%s,"label":%s,"cwd":%s,"pid":%s,"exclusive":%s,"waited_s":%s,"ran_s":%s,"exit":%s,"pool":"%s","weight":%s,"sha":%s,"tree":%s}' \
    "$(iso_now)" "$1" "${2:-null}" "$(json_str "$LABEL")" "$(json_str "$PWD")" "$$" "$excl" \
    "${3:+$(fmt_ms "$3")}" "${4:+$(fmt_ms "$4")}" "${5:-null}" \
    "$POOL_KIND" "$weight" "$(json_or_null "$GATE_SHA")" "$(json_or_null "$GATE_TREE")")
  line=${line//\"waited_s\":,/\"waited_s\":null,}
  line=${line//\"ran_s\":,/\"ran_s\":null,}
  if ! { exec {fd}>>"$POOL/events.lock"; } 2>/dev/null; then
    say "WARN could not open $POOL/events.lock; event '$1' not logged. Fix: check $POOL is yours with mode 0700."
    return 0
  fi
  if ! flock -w 5 "$fd"; then
    exec {fd}>&-
    say "WARN events.lock busy >5s; event '$1' not logged. Fix: look for a process wedged holding $POOL/events.lock."
    return 0
  fi
  size=$(stat -c %s -- "$POOL/events.jsonl" 2>/dev/null || echo 0)
  if ((size > EVENTS_MAX_BYTES)); then
    mv -f -- "$POOL/events.jsonl" "$POOL/events.jsonl.1" 2>/dev/null
  fi
  printf '%s\n' "$line" >>"$POOL/events.jsonl" 2>/dev/null ||
    say "WARN could not append to $POOL/events.jsonl. Fix: check disk space and that $POOL is writable."
  exec {fd}>&-
}

# holder_lines — one human line per RUN holding units (a unit counts only
# while its lock is actually held), grouped by the holder's pid. A pre-DND-1006
# holder (no weight) shows weight 1; an unreadable holder file is named.
holder_lines() {
  local i f fields key label cwd since pid excl weight
  local -A units=() row=()
  local -a order=()
  for ((i = 1; i <= N; i++)); do
    lock_held "$POOL/slot-$i.lock" || continue
    f="$POOL/slot-$i.holder"
    if command -v jq >/dev/null 2>&1 &&
      fields=$(jq -r '[.label, .cwd, .started_at, (.pid|tostring), (.exclusive|tostring), ((.weight // 1)|tostring)] | @tsv' "$f" 2>/dev/null) &&
      [ -n "$fields" ]; then
      IFS=$'\t' read -r label cwd since pid excl weight <<<"$fields"
      key="pid:$pid"
      [ -n "${row[$key]+x}" ] || { order+=("$key"); row[$key]="$label"$'\t'"$cwd"$'\t'"$since"$'\t'"$pid"$'\t'"$excl"$'\t'"$weight"; }
      units[$key]="${units[$key]:+${units[$key]} }$i"
    else
      printf 'unit %s: held (holder diagnostics unreadable at %s)\n' "$i" "$f"
    fi
  done
  for key in "${order[@]}"; do
    IFS=$'\t' read -r label cwd since pid excl weight <<<"${row[$key]}"
    format_holder_line "${units[$key]}" "$label" "$cwd" "$since" "$pid" "$excl" "$weight"
  done
}

held_count() {
  local i c=0
  for ((i = 1; i <= N; i++)); do lock_held "$POOL/slot-$i.lock" && c=$((c + 1)); done
  printf '%s\n' "$c"
}

# ------------------------------------------------------------ the FIFO queue
# (DND-823) Every acquirer takes a TICKET: under seq.lock it finds the highest
# ticket among waiters/q-<ticket>.w, adds one, and publishes its own file
# already flock-held (created as a dot-temp, locked, then renamed in), so a
# visible q-file is never unlocked while its owner lives. A waiter is LIVE
# exactly while its file is flock-held; ticket order among live waiters is
# arrival order. A waiter blocks in the kernel on its nearest live
# predecessor's file (a SHARED lock, which cannot be had while the
# predecessor holds its exclusive one), and rescans each time that returns:
# the predecessor got a slot, timed out, or died, and in every case its lock
# is gone. Only the waiter with no live predecessor (the head) goes on to
# queue.lock and the slot poll. Nothing is judged by a pid.

# ticket_of NAME — the ticket in a q-file's basename (q-000000000042.w -> 42),
# or return 1 when NAME is not a q-file.
ticket_of() {
  local b=${1##*/}
  [[ $b =~ ^q-([0-9]{1,18})\.w$ ]] || return 1
  printf '%s\n' $((10#${BASH_REMATCH[1]}))
}

# queue_lines — "ticket<TAB>file" for each LIVE q-file, in ticket order.
queue_lines() {
  local f t
  for f in "$POOL"/waiters/q-*.w; do
    [ -e "$f" ] || continue
    t=$(ticket_of "$f") || continue
    lock_held "$f" && printf '%s\t%s\n' "$t" "$f"
  done | sort -n -k1,1
}

# legacy_waiters — each live waiter file of a pre-DND-823 test-slot
# (<pid>-<epoch>.w): unordered, shown without a position.
legacy_waiters() {
  local f
  for f in "$POOL"/waiters/*.w; do
    [ -e "$f" ] || continue
    ticket_of "$f" >/dev/null && continue
    lock_held "$f" && printf '%s\n' "$f"
  done
}

# waiter_positions — "position<TAB>file" per live waiter: the queue in order
# (1 = the head, next to be served), then legacy ones with position "-".
waiter_positions() {
  queue_lines | awk -F'\t' '{ sub(/^[^\t]*\t/, ""); print NR "\t" $0 }'
  legacy_waiters | sed 's/^/-\t/'
}

# live_waiters — every live waiter file: the queue in order, then legacy ones.
live_waiters() {
  queue_lines | cut -f2-
  legacy_waiters
}

# reap_dead_waiters — remove waiter files no live process holds. Run under
# seq.lock, so no new-style registration is mid-flight: a q-file or dot-temp
# we can lock exclusively is dead. A legacy file is skipped while young (a
# pre-DND-823 waiter creates it before it flocks it).
reap_dead_waiters() {
  local f base epoch now fd
  now=$(date +%s)
  for f in "$POOL"/waiters/*.w "$POOL"/waiters/.q-*.tmp; do
    [ -e "$f" ] || continue
    base=${f##*/}
    if [[ $base != .q-* ]] && ! ticket_of "$base" >/dev/null; then
      epoch=${base#*-}
      epoch=${epoch%.w}
      [[ $epoch =~ ^[0-9]+$ ]] && ((now - epoch < WAITER_REAP_AGE_S)) && continue
    fi
    { exec {fd}<"$f"; } 2>/dev/null || continue
    if flock -n "$fd"; then rm -f -- "$f"; fi
    exec {fd}>&-
  done
}

# predecessor — the file of the live waiter just ahead of TICKET (empty when
# this run is the head).
predecessor() {
  local t f pred=""
  while IFS=$'\t' read -r t f; do
    [ -n "$t" ] || continue
    ((t < TICKET)) || break
    pred=$f
  done < <(queue_lines)
  printf '%s\n' "$pred"
}

# queue_position — 1 + the number of live waiters ahead of TICKET.
queue_position() {
  local t f p=1
  while IFS=$'\t' read -r t f; do
    [ -n "$t" ] || continue
    ((t < TICKET)) && p=$((p + 1))
  done < <(queue_lines)
  printf '%s\n' "$p"
}

WAITER_FILE=""
WAITER_FD=""
TICKET=""
# enqueue — take this run's ticket and publish its flock-held q-file.
enqueue() {
  local sfd f t max=0 tmp final
  { exec {sfd}>>"$POOL/seq.lock"; } 2>/dev/null || die_usage "cannot open $POOL/seq.lock." \
    "check $POOL is yours with mode 0700 and writable."
  wait_lock "$sfd" -x
  reap_dead_waiters
  for f in "$POOL"/waiters/q-*.w; do
    [ -e "$f" ] || continue
    t=$(ticket_of "$f") || continue
    ((t > max)) && max=$t
  done
  TICKET=$((max + 1))
  tmp="$POOL/waiters/.q-$TICKET.$$.tmp"
  final=$(printf '%s/waiters/q-%012d.w' "$POOL" "$TICKET")
  WAITER_FILE=$tmp
  if ! { exec {WAITER_FD}>"$tmp"; } 2>/dev/null || ! flock -n "$WAITER_FD"; then
    rm -f -- "$tmp"
    die_usage "cannot register in the queue at $POOL/waiters." \
      "check disk space and that $POOL/waiters is yours with mode 0700; test-slot never runs a command out of queue order."
  fi
  printf '{"label":%s,"cwd":%s,"pid":%s,"since":"%s","ticket":%s,"weight":%s}\n' \
    "$(json_str "$LABEL")" "$(json_str "$PWD")" "$$" "$(iso_now)" "$TICKET" "$WEIGHT" >&"$WAITER_FD"
  mv -f -- "$tmp" "$final" || {
    rm -f -- "$tmp"
    die_usage "cannot publish $final." "check that $POOL/waiters is writable."
  }
  WAITER_FILE=$final
  exec {sfd}>&-
}

unregister_waiter() {
  [ -n "$WAITER_FILE" ] || return 0
  rm -f -- "$WAITER_FILE"
  [ -n "$WAITER_FD" ] && exec {WAITER_FD}>&-
  WAITER_FILE=""
  WAITER_FD=""
}

position_text() {
  [ -n "$TICKET" ] || return 0
  printf 'queue position %s of %s' "$(queue_position)" "$(queue_lines | wc -l)"
}

ANNOUNCED=0
LAST_HB=0
announce_waiting() {
  ((ANNOUNCED)) && return 0
  ANNOUNCED=1
  LAST_HB=$(now_ms)
  local held lines waiting pos
  held=$(held_count)
  lines=$(holder_lines)
  waiting=$(live_waiters | wc -l)
  pos=$(position_text)
  {
    printf '%s: WAITING for %s unit(s) -- %s pool %s, budget=%s, %s held:\n' \
      "$PROG" "$WEIGHT" "$POOL_KIND" "$POOL" "$N" "$held"
    [ -n "$lines" ] && printf '%s\n' "$lines" | sed 's/^/  /'
    printf '  %s waiting (this run: %s, weight %s%s)\n' "$waiting" "$(one_line "$LABEL")" "$WEIGHT" "${pos:+, $pos}"
    ((EXCLUSIVE)) && printf '  this run is --exclusive (bench only): it needs all %s units\n' "$N"
  } >&2
  append_event waiting "" "$(($(now_ms) - START_MS))" "" ""
}

# maybe_heartbeat — say we are still waiting, at most once per HEARTBEAT_S.
maybe_heartbeat() {
  (($(now_ms) - LAST_HB >= HEARTBEAT_S * 1000)) || return 0
  local waited_s=$((($(now_ms) - START_MS) / 1000)) pos
  pos=$(position_text)
  say "still waiting ${waited_s}s for ${WEIGHT} unit(s); ${pos:+$pos; }$(held_count) of $N held (pool $POOL)"
  LAST_HB=$(now_ms)
}

remaining_ms() { printf '%s\n' $((DEADLINE_MS - $(now_ms))); }

write_outcome() { # write_outcome KIND [EXIT]
  [ -n "$OUTCOME_FILE" ] || return 0
  outcome_line "$@" >"$OUTCOME_FILE" 2>/dev/null ||
    say "WARN could not write --outcome-file $OUTCOME_FILE. Fix: pass a path in a directory you own."
}

# read_ppid: set CUR_PPID to this process's parent pid now, read from the
# kernel (bash's $PPID is fixed at startup); empty when unreadable. Call it in
# the main shell, never in $(...): it reads /proc/self/stat with the read
# builtin, so /proc/self is this shell, and no process is forked.
read_ppid() {
  local stat rest
  CUR_PPID=""
  if read -r stat 2>/dev/null </proc/self/stat; then
    rest=${stat##*) }
    read -r _ CUR_PPID _ <<<"$rest"
  fi
}

# orphan_exit WHY: the caller is gone (or cannot be confirmed). Leave the
# queue FIRST (its stderr may be a dead pipe that kills us on write, exit
# 141), then log, then say so. Exits 129; CMD never ran; no outcome file.
orphan_exit() {
  local waited_ms=$(($(now_ms) - START_MS))
  unregister_waiter
  append_event orphaned "" "$waited_ms" "" ""
  {
    printf '%s: ORPHANED after %ss waiting: %s. Left the queue; the command did NOT run.\n' \
      "$PROG" "$((waited_ms / 1000))" "$1"
    printf 'Fix: keep the caller alive until test-slot returns (block on it). To run it detached on purpose, give it a parent that waits: setsid bash -c '"'"'test-slot -- CMD; exit $?'"'"' &\n'
  } >&2
  exit 129
}

# check_parent [startup]: return 0 while the caller that started test-slot
# is still its parent; otherwise orphan_exit (DND-925). At startup an
# unreadable parent is a refusal (exit 2) rather than a guess.
check_parent() {
  local cur st
  read_ppid
  cur=$CUR_PPID
  st=$(parent_state "$ORIG_PPID" "$cur" "$PID_NS")
  case $st in
    alive) return 0 ;;
    gone)
      if [ "$ORIG_PPID" = "$cur" ]; then
        orphan_exit "it started under PID 1 (its caller was already gone)"
      fi
      orphan_exit "its caller (pid $ORIG_PPID) is gone; it was reparented to pid $cur"
      ;;
  esac
  if [ "${1:-}" = startup ]; then
    die_usage "cannot read this process's parent pid (/proc/self/stat: '$cur', pid ns: '$PID_NS'); test-slot never queues a run it cannot tie to a live caller." \
      "run test-slot on Linux with /proc mounted and readable."
  fi
  orphan_exit "its parent pid can no longer be read (/proc/self/stat), so its caller cannot be confirmed alive"
}

timeout_exit() {
  local waited_ms=$(($(now_ms) - START_MS)) lines
  lines=$(holder_lines)
  {
    printf '%s: TIMEOUT after %ss waiting for %s unit(s) (pool %s, budget=%s); the command did NOT run.\n' \
      "$PROG" "$((waited_ms / 1000))" "$WEIGHT" "$POOL" "$N"
    printf 'Fix: the pool stayed full for %ss. Holders:\n' "$((waited_ms / 1000))"
    [ -n "$lines" ] && printf '%s\n' "$lines" | sed 's/^/  /'
    printf '  If a holder above is wedged, stop that process; otherwise re-run later or pass a longer --wait-timeout. Never bypass the pool.\n'
  } >&2
  append_event timeout "" "$waited_ms" "" ""
  write_outcome timeout
  unregister_waiter
  exit "$EXIT_TIMEOUT"
}

# interruptible CMD... — run CMD as a background child and `wait` for it.
# bash runs a trap only after its FOREGROUND child returns, so a waiter parked
# in a foreground `flock -w 60` answered TERM/INT/HUP up to a minute late
# (DND-815); the `wait` builtin instead returns at once on a trapped signal.
# The child holds nothing of its own: a flock it takes lands on the parent's
# shared open file description. abandon_wait kills it before exiting. The
# child does NOT inherit the waiter file's fd (DND-823): a child orphaned by a
# SIGKILLed waiter would otherwise keep that waiter live in the queue.
interruptible() {
  if [ -n "$WAITER_FD" ]; then
    "$@" {WAITER_FD}>&- &
  else
    "$@" &
  fi
  wait "$!"
}

# abandon_wait CODE — the waiting phase's INT/TERM/HUP handler: kill every
# helper child still running (bash's `jobs -pr` inside $(...) reports this
# shell's job table, so it also covers one started an instant before its pid
# was read; -r skips a finished job whose pid may already be recycled), drop
# the waiter file, exit CODE. It releases only
# what this process holds: any slot fds it took (a partial --exclusive) close
# with it. No outcome file is written, since no outcome was reached.
abandon_wait() {
  local pids
  pids=$(jobs -pr)
  if [ -n "$pids" ]; then
    # shellcheck disable=SC2086 # word-split pid list
    kill -KILL $pids 2>/dev/null
    wait $pids 2>/dev/null
  fi
  unregister_waiter
  exit "$1"
}

# wait_lock FD MODE — take flock MODE (-x or -s) on FD, blocking in the kernel
# in chunks of at most HEARTBEAT_S, bounded by the deadline (timeout_exit).
# A wait longer than QUEUE_GRACE_S announces WAITING first.
wait_lock() {
  local fd=$1 mode=$2 rem chunk
  flock -n "$mode" "$fd" && return 0
  if ! ((ANNOUNCED)); then
    interruptible flock "$mode" -w "$QUEUE_GRACE_S" "$fd" && return 0
    check_parent
    announce_waiting
  fi
  while :; do
    rem=$(remaining_ms)
    ((rem > 0)) || timeout_exit
    chunk=$(((rem + 999) / 1000))
    ((chunk > HEARTBEAT_S)) && chunk=$HEARTBEAT_S
    ((chunk > PARENT_CHECK_S)) && chunk=$PARENT_CHECK_S
    interruptible flock "$mode" -w "$chunk" "$fd" && return 0
    check_parent
    maybe_heartbeat
  done
}

# wait_turn — block until no live waiter is ahead of this run's ticket.
wait_turn() {
  local pred pfd
  while :; do
    check_parent
    pred=$(predecessor)
    [ -n "$pred" ] || return 0
    # Gone between the scan and the open: it left the queue; rescan.
    { exec {pfd}<"$pred"; } 2>/dev/null || continue
    wait_lock "$pfd" -s
    exec {pfd}>&-
  done
}

# acquire — take WEIGHT units (all N with --exclusive), in arrival order.
acquire() {
  local qfd rem nap next_hb
  check_parent startup
  enqueue
  wait_turn
  # Head of the queue. queue.lock is where a pre-DND-823 waiter queues, so
  # taking it keeps one slot poller at a time across old and new versions.
  { exec {qfd}>>"$POOL/queue.lock"; } 2>/dev/null || die_usage "cannot open $POOL/queue.lock." \
    "check $POOL is yours with mode 0700 and writable."
  wait_lock "$qfd" -x
  # Poll the slots at POLL_S, bounded by the deadline; a slot is never taken
  # for a caller that is gone (DND-925).
  check_parent
  if ! try_acquire; then
    announce_waiting
    while check_parent && ! try_acquire; do
      rem=$(remaining_ms)
      ((rem > 0)) || timeout_exit
      maybe_heartbeat
      # Sleep until the next poll, heartbeat, or the deadline, whichever is
      # first (never less than 1 ms: this loop cannot spin).
      nap=$((POLL_S * 1000))
      next_hb=$((LAST_HB + HEARTBEAT_S * 1000 - $(now_ms)))
      ((next_hb < nap)) && nap=$next_hb
      ((rem < nap)) && nap=$rem
      ((nap < 1)) && nap=1
      interruptible sleep "$(fmt_ms "$nap")"
    done
  fi
  exec {qfd}>&-
  unregister_waiter
}

# held_var — the environment variable that marks a held unit of this pool
# kind: one per pool (DND-1006), so a model run nested in a cpu run (or the
# reverse) never hides the outer run's marker from a run nested deeper.
held_var() {
  if [ "$POOL_KIND" = model ]; then printf 'ATHENA_TEST_SLOT_HELD_MODEL\n'; else printf 'ATHENA_TEST_SLOT_HELD\n'; fi
}

# reentrant_slot — 0 when this pool's held_var names a held unit of THIS pool.
reentrant_slot() {
  local var held hpool hslot
  var=$(held_var)
  held=${!var:-}
  [ -n "$held" ] || return 1
  hpool=${held%:*}
  hslot=${held##*:}
  [ "$(canon "$hpool")" = "$POOL" ] || return 1
  if [[ $hslot =~ ^[1-9][0-9]*$ ]] && lock_held "$POOL/slot-$hslot.lock"; then
    SLOT=$hslot
    return 0
  fi
  say "WARN stale $var=$held (that slot is not held); taking a slot normally."
  return 1
}

# in_tty_foreground — 0 when this process is in its terminal's foreground
# process group (so a terminal ^C already reached CMD directly).
in_tty_foreground() {
  local stat rest pgrp tty tpgid
  stat=$(cat "/proc/$$/stat" 2>/dev/null) || return 1
  rest=${stat##*) }
  # fields after comm: state ppid pgrp session tty_nr tpgid
  read -r _ _ pgrp _ tty tpgid _ <<<"$rest"
  [ "$tty" != 0 ] && [ "$pgrp" = "$tpgid" ]
}

CHILD=""
forward() { [ -n "$CHILD" ] && kill -s "$1" "$CHILD" 2>/dev/null; }
forward_int() { in_tty_foreground || forward INT; }

# entry_sigign — the SigIgn mask test-slot inherited, or "" when /proc cannot
# say. Read by a CHILD process (sed reads its own /proc/self/status): bash
# ignores SIGQUIT in itself, so its own mask cannot tell an inherited QUIT
# ignore apart, while a foreground child gets exactly the inherited
# dispositions back. Called before any trap is set.
entry_sigign() {
  sed -n 's/^SigIgn:[[:space:]]*//p' /proc/self/status 2>/dev/null
}

# launch_prefix — sets LAUNCH (array) to what runs CMD with the caller's
# INT/QUIT dispositions restored (see default_signals).
launch_prefix() {
  local sigs
  LAUNCH=()
  sigs=$(default_signals "$ENTRY_SIGIGN")
  [ -n "$sigs" ] || return 0
  if [[ ${CMD[0]} == *=* ]]; then
    say "WARN CMD '${CMD[0]}' contains '=', so env(1) cannot launch it; CMD starts with INT/QUIT ignored (^C will not reach it). Fix: invoke it by a path without '=' (e.g. a symlink)."
    return 0
  fi
  if ! env --default-signal=INT true 2>/dev/null; then
    say "WARN env(1) lacks --default-signal (coreutils < 8.31); CMD starts with INT/QUIT ignored (^C will not reach it). Fix: upgrade coreutils to >= 8.31."
    return 0
  fi
  LAUNCH=(env "--default-signal=$sigs")
}

# run_cmd — run CMD as a child that inherits the slot fd(s), our stdin, and
# our entry INT/QUIT dispositions; forward INT/TERM/HUP; return its exit code.
run_cmd() {
  local in rc prev=0
  launch_prefix
  exec {in}<&0
  "${LAUNCH[@]}" "${CMD[@]}" <&"$in" {in}<&- &
  CHILD=$!
  exec {in}<&-
  trap forward_int INT
  trap 'forward TERM' TERM
  trap 'forward HUP' HUP
  while :; do
    wait "$CHILD"
    rc=$?
    if ((rc == 127)) && ! kill -0 "$CHILD" 2>/dev/null && ((prev != 0)); then
      rc=$prev
      break
    fi
    ((rc > 128)) && kill -0 "$CHILD" 2>/dev/null && { prev=$rc; continue; }
    break
  done
  trap - INT TERM HUP
  return "$rc"
}

# ============================================================ status

scan_unslotted() { # prints "pid<TAB>state<TAB>cwd<TAB>cmd", state unslotted|unknown|container
  local d pid stat rest ppid cwd cmd st env_rc ns_self ns_pid
  local -A matched=() parent=()
  local -a argv
  ns_self=$(readlink /proc/self/ns/pid 2>/dev/null)
  for d in /proc/[0-9]*; do
    [ -O "$d" ] || continue
    pid=${d#/proc/}
    [ "$pid" = "$$" ] && continue
    argv=()
    mapfile -d '' -t argv <"$d/cmdline" 2>/dev/null || continue
    ((${#argv[@]})) || continue
    is_heavy_argv "${argv[@]}" || continue
    stat=$(cat "$d/stat" 2>/dev/null) || continue
    rest=${stat##*) }
    read -r _ ppid _ <<<"$rest"
    matched[$pid]="${argv[*]}"
    parent[$pid]=$ppid
  done
  for pid in "${!matched[@]}"; do
    [ -n "${matched[${parent[$pid]}]+x}" ] && continue
    grep -qza '^ATHENA_TEST_SLOT_HELD=' "/proc/$pid/environ" 2>/dev/null
    env_rc=$?
    ns_pid=$(readlink "/proc/$pid/ns/pid" 2>/dev/null)
    st=$(unslotted_state "$ns_self" "$ns_pid" "$env_rc")
    [ "$st" = slotted ] && continue
    cwd=$(readlink "/proc/$pid/cwd" 2>/dev/null || echo "?")
    cmd=$(one_line "${matched[$pid]}")
    printf '%s\t%s\t%s\t%s\n' "$pid" "$st" "$cwd" "${cmd:0:200}"
  done | sort -n
}

status() {
  local initialised=true problem held=0 waiting=0 load1 lines unslotted="" wfiles
  local -a holders_json=() waiters_json=() uns_json=()
  if [ ! -e "$POOL" ] && [ ! -L "$POOL" ]; then
    initialised=false
  else
    problem=$(pool_problem "$POOL")
    [ -z "$problem" ] || refuse_pool "$POOL" "$problem"
  fi
  load1=$(cut -d' ' -f1 /proc/loadavg 2>/dev/null || echo unknown)
  # Heavy runs that bypass the pool are CPU runs: the scan is the cpu pool's.
  [ "$POOL_KIND" = cpu ] && unslotted=$(scan_unslotted)

  if [ "$initialised" = true ]; then
    held=$(held_count)
    lines=$(holder_lines)
    wfiles=$(waiter_positions)
    [ -n "$wfiles" ] && waiting=$(printf '%s\n' "$wfiles" | wc -l)
  fi
  local ucount=0 ccount=0 _p _st _rest
  while IFS=$'\t' read -r _p _st _rest; do
    [ -n "$_p" ] || continue
    if [ "$_st" = container ]; then ccount=$((ccount + 1)); else ucount=$((ucount + 1)); fi
  done <<<"$unslotted"
  if [ "$POOL_KIND" != cpu ]; then ucount=null; ccount=null; fi

  if ((JSON)); then
    local i f w pid st cwd cmd per_unit=""
    if [ "$initialised" = true ]; then
      # One entry per RUN: its holder file plus the units it holds.
      for ((i = 1; i <= N; i++)); do
        lock_held "$POOL/slot-$i.lock" || continue
        f="$POOL/slot-$i.holder"
        per_unit+="$(jq -c --argjson s "$i" '. + {slot: $s}' "$f" 2>/dev/null ||
          printf '{"slot":%s,"label":null,"pid":null,"diagnostics":"unreadable"}' "$i")"$'\n'
      done
      if [ -n "$per_unit" ]; then
        # "slot" stays (the run's lowest unit) for pre-DND-1006 readers.
        local grouped
        if grouped=$(jq -c -s \
          'group_by(if .pid == null then "unit:\(.slot)" else "pid:\(.pid)" end)
           | map(.[0] + {units: map(.slot), weight: (.[0].weight // 1)} | .slot = .units[0])
           | sort_by(.units[0]) | .[]' <<<"$per_unit") && [ -n "$grouped" ]; then
          mapfile -t holders_json <<<"$grouped"
        else
          # Grouping failed: list every held unit ungrouped rather than none,
          # so a held pool never reads as an empty one.
          mapfile -t holders_json <<<"${per_unit%$'\n'}"
        fi
      fi
      local wpos jpos
      while IFS=$'\t' read -r wpos w; do
        [ -n "$w" ] || continue
        jpos=$wpos
        [ "$wpos" = - ] && jpos=null
        waiters_json+=("$(jq -c --argjson p "$jpos" '. + {position: $p}' "$w" 2>/dev/null ||
          printf '{"position":%s,"label":null,"diagnostics":"unreadable"}' "$jpos")")
      done <<<"$wfiles"
    fi
    while IFS=$'\t' read -r pid st cwd cmd; do
      [ -n "$pid" ] || continue
      uns_json+=("$(printf '{"pid":%s,"environ":"%s","cwd":%s,"cmd":%s}' "$pid" "$st" "$(json_str "$cwd")" "$(json_str "$cmd")")")
    done <<<"$unslotted"
    local IFS=,
    printf '{"initialised":%s,"kind":"%s","pool":%s,"n":%s,"budget":%s,"n_basis":%s,"provisional":false,"default_weight":%s,"held":%s,"waiting":%s,"unslotted":%s,"in_container":%s,"load1":%s,"nproc":%s,"holders":[%s],"waiters":[%s],"unslotted_runs":[%s]}\n' \
      "$initialised" "$POOL_KIND" "$(json_str "$POOL")" "$N" "$N" "$(json_str "$N_BASIS")" "$DEFAULT_WEIGHT" \
      "$held" "$waiting" "$ucount" "$ccount" "$(json_str "$load1")" "$(json_str "$NPROC")" \
      "${holders_json[*]}" "${waiters_json[*]}" "${uns_json[*]}"
    return 0
  fi

  local head ucol=""
  head=$(printf '%s pool: budget=%s units (%s) default_weight=%s' "$POOL_KIND" "$N" "$N_BASIS" "$DEFAULT_WEIGHT")
  [ "$POOL_KIND" = cpu ] && ucol=" unslotted=$ucount in_container=$ccount"
  if [ "$initialised" = false ]; then
    printf '%s pool not initialised at %s%s load1=%s nproc=%s\n' \
      "$head" "$POOL" "$ucol" "$load1" "$NPROC"
  else
    printf '%s held=%s waiting=%s%s load1=%s nproc=%s pool=%s\n' \
      "$head" "$held" "$waiting" "$ucol" "$load1" "$NPROC" "$POOL"
    [ -n "$lines" ] && printf '%s\n' "$lines"
    local w wpos tag label wcwd since wpid wweight
    while IFS=$'\t' read -r wpos w; do
      [ -n "$w" ] || continue
      if [ "$wpos" = - ]; then tag="WAITING (pre-DND-823 waiter, unordered)"; else tag="WAITING #$wpos"; fi
      if IFS=$'\t' read -r label wcwd since wpid wweight < <(jq -r '[.label, .cwd, .since, (.pid|tostring), ((.weight // "?")|tostring)] | @tsv' "$w" 2>/dev/null) &&
        [ -n "$label" ]; then
        printf '%s: %s (weight %s) in %s since %s (pid %s, diagnostic)\n' "$tag" "$(one_line "$label")" "$wweight" "$wcwd" "$since" "$wpid"
      else
        printf '%s: (waiter diagnostics unreadable at %s)\n' "$tag" "$w"
      fi
    done <<<"$wfiles"
  fi
  local pid st cwd cmd
  while IFS=$'\t' read -r pid st cwd cmd; do
    [ -n "$pid" ] || continue
    if [ "$st" = unknown ]; then
      printf 'UNSLOTTED: %s %s %s (environ unreadable: unknown, not slotted)\n' "$pid" "$cwd" "$cmd"
    elif [ "$st" = container ]; then
      printf 'CONTAINER: %s %s %s (another pid namespace: its slot cannot be read; see the host-side run that launched it)\n' "$pid" "$cwd" "$cmd"
    else
      printf 'UNSLOTTED: %s %s %s\n' "$pid" "$cwd" "$cmd"
    fi
  done <<<"$unslotted"
}

# ============================================================ main

main() {
  local mode=run have_dd=0
  ENTRY_SIGIGN=$(entry_sigign)
  LABEL=""
  WAIT_TIMEOUT_S=$DEFAULT_WAIT_TIMEOUT_S
  OUTCOME_FILE=""
  EXCLUSIVE=0
  JSON=0
  CMD=()
  GATE_SHA=""
  GATE_TREE=""
  local wait_raw="" weight_raw="" pool_raw=""
  # DND-813: a flag given twice (in either spelling) is refused rather than
  # silently keeping the second, and a value flag's value may not be the next
  # flag (`--label --exclusive -- CMD` used to label the run "--exclusive" and
  # run it shared).
  local seen=" " flag
  while (($#)); do
    flag=${1%%=*}
    case $1 in
      --*)
        case $seen in *" $flag "*) die_usage "$flag given more than once." "pass $flag once, before \`--\`." ;; esac
        [ "$1" = "--" ] || seen="$seen$flag "
        ;;
    esac
    case $1 in
      -h | --help) usage; exit 0 ;;
      --self-test | --status)
        [ "$mode" = run ] || die_usage "--self-test and --status are two modes." "pass one of them."
        [ "$1" = --self-test ] && mode=selftest || mode=status
        ;;
      --json) JSON=1 ;;
      --exclusive) EXCLUSIVE=1 ;;
      --label | --wait-timeout | --outcome-file | --weight | --pool)
        { (($# >= 2)) && [ -n "$2" ] && [ "${2#-}" = "$2" ]; } || die_usage "$1 needs a value." "pass $1 VALUE before \`--\`."
        case $1 in
          --label) LABEL=$2 ;;
          --wait-timeout) wait_raw=$2 ;;
          --outcome-file) OUTCOME_FILE=$2 ;;
          --weight) weight_raw=$2 ;;
          --pool) pool_raw=$2 ;;
        esac
        shift
        ;;
      --label=* | --wait-timeout=* | --outcome-file=* | --weight=* | --pool=*)
        [ -n "${1#*=}" ] || die_usage "$flag needs a value." "pass $flag=VALUE (non-empty) before \`--\`."
        case $1 in
          --label=*) LABEL=${1#*=} ;;
          --wait-timeout=*) wait_raw=${1#*=} ;;
          --outcome-file=*) OUTCOME_FILE=${1#*=} ;;
          --weight=*) weight_raw=${1#*=} ;;
          --pool=*) pool_raw=${1#*=} ;;
        esac
        ;;
      --) shift; have_dd=1; CMD=("$@"); break ;;
      *) die_usage "unknown argument '$1'." \
        "put test-slot's own flags first, then \`--\`, then the command: test-slot [--label L] -- CMD ARGS (see --help)." ;;
    esac
    shift
  done

  # A stale outcome file must never survive to be read as this run's result.
  if [ -n "$OUTCOME_FILE" ]; then
    rm -f -- "$OUTCOME_FILE" 2>/dev/null
    [ -d "$(dirname -- "$OUTCOME_FILE")" ] && [ -w "$(dirname -- "$OUTCOME_FILE")" ] || die_usage \
      "--outcome-file $OUTCOME_FILE: its directory is missing or not writable." \
      "pass a path in an existing directory you own (namespace it per unit of work)."
  fi

  case $pool_raw in
    "" | cpu | model) ;;
    *) die_usage "--pool '$pool_raw' is not a pool." \
      "pass --pool cpu (heavy CPU runs: gates, suites) or --pool model (model-in-loop evals, critic-review)." ;;
  esac

  case $mode in
    selftest)
      local suite
      suite="$(cd "$(dirname -- "$(realpath -- "${BASH_SOURCE[0]}")")/.." && pwd)/test/test-slot/self-test.sh"
      [ -x "$suite" ] || die_usage "self-test suite missing: $suite." "restore ai/test/test-slot/self-test.sh (chmod +x)."
      exec "$suite"
      ;;
    status)
      # With no --pool, both pools: a run queued for the model pool (a
      # critic-review, an eval) must show wherever the cpu pool's runs do.
      # JSON keeps the cpu pool at the top level and nests the model pool.
      if [ -n "$pool_raw" ]; then
        POOL_KIND=$pool_raw
        resolve_pool
        status
      elif ((JSON)); then
        local cpu_json model_json
        POOL_KIND=cpu; resolve_pool; cpu_json=$(status) || exit $?
        POOL_KIND=model; resolve_pool; model_json=$(status) || exit $?
        jq -c --argjson m "$model_json" '. + {model: $m}' <<<"$cpu_json" || die_usage \
          "could not merge the two pools' --status --json documents." \
          "check jq works, or read each pool with --status --pool cpu --json and --status --pool model --json."
      else
        POOL_KIND=cpu; resolve_pool; status
        POOL_KIND=model; resolve_pool; status
      fi
      exit 0
      ;;
  esac

  if [ -n "$wait_raw" ]; then
    is_pos_int "$wait_raw" || die_usage "--wait-timeout '$wait_raw' is not a positive integer." \
      "pass whole seconds, e.g. --wait-timeout 3600."
    WAIT_TIMEOUT_S=$wait_raw
  fi
  ((have_dd)) || die_usage "no \`--\` before the command." \
    "write: test-slot [flags] -- CMD ARGS (the \`--\` is required)."
  ((${#CMD[@]})) || die_usage "no command after \`--\`." "write: test-slot [flags] -- CMD ARGS."
  read_gate_ref
  [ -n "$LABEL" ] || LABEL=$(pick_label "${GATE_TREE:-$PWD}" "${CMD[@]}")

  # The pool: --pool, else by the COMMAND. --exclusive is the bench's
  # machine-wide mutex over the CPU budget only (DND-1006).
  POOL_KIND=${pool_raw:-$(infer_pool "${CMD[@]}")}
  if ((EXCLUSIVE)); then
    [ -z "$weight_raw" ] || die_usage "--exclusive holds the whole budget; --weight does not apply to it." \
      "drop --weight (or drop --exclusive, which is for the DND-489 bench only)."
    [ "$POOL_KIND" = cpu ] || die_usage "--exclusive applies only to the cpu pool (it quiesces CPU load for the DND-489 bench); this run is in the $POOL_KIND pool." \
      "drop --exclusive: no gate, eval or critic run takes it. For a bench run, pass --pool cpu."
  fi

  resolve_pool

  # The weight: --weight, else a harness-gate's worker count, else the pool's
  # default. --exclusive holds the whole budget.
  if ((EXCLUSIVE)); then
    WEIGHT=$N
  elif [ -n "$weight_raw" ]; then
    [[ $weight_raw =~ ^[1-9][0-9]*$ ]] && ((${#weight_raw} <= 6)) && ((weight_raw <= N)) || die_usage \
      "--weight '$weight_raw' is not a unit count 1..$N (the $POOL_KIND pool's budget); a larger run could never start." \
      "pass --weight 1..$N: the workers (cpu) or model calls in flight (model) this run keeps busy."
    WEIGHT=$weight_raw
  else
    WEIGHT=""
    if [ "$POOL_KIND" = cpu ]; then
      WEIGHT=$(gate_jobs "$NPROC" "${HARNESS_GATE_JOBS:-}" "${CMD[@]}") || WEIGHT=""
    fi
    [ -n "$WEIGHT" ] || WEIGHT=$DEFAULT_WEIGHT
    if ((WEIGHT > N)); then
      say "note: this run's weight $WEIGHT exceeds the $POOL_KIND budget $N; it holds the whole budget."
      WEIGHT=$N
    fi
  fi

  ensure_pool
  START_MS=$(now_ms)
  DEADLINE_MS=$((START_MS + WAIT_TIMEOUT_S * 1000))
  SLOT=""
  # DND-925: the caller this run belongs to, and this pid namespace.
  ORIG_PPID=$PPID
  PID_NS=$(readlink /proc/self/ns/pid 2>/dev/null)

  local rc
  if reentrant_slot; then
    ((EXCLUSIVE)) && say "note: already inside unit $SLOT; --exclusive not re-applied (nested run)."
    append_event reentrant "$SLOT" 0 "" ""
    run_cmd
    rc=$?
    write_outcome ran "$rc"
    exit "$rc"
  fi

  trap 'abandon_wait 130' INT
  trap 'abandon_wait 143' TERM
  trap 'abandon_wait 129' HUP
  acquire
  trap - INT TERM HUP

  local waited_ms=$(($(now_ms) - START_MS)) ran_start
  append_event acquired "$SLOT" "$waited_ms" "" ""
  if ((ANNOUNCED)); then
    if ((EXCLUSIVE)); then
      say "all $N units acquired (exclusive) after $(fmt_ms "$waited_ms")s"
    else
      say "$WEIGHT unit(s) of $N acquired in the $POOL_KIND pool after $(fmt_ms "$waited_ms")s"
    fi
  fi

  export "$(held_var)=$POOL:$SLOT"
  # The caller may have died during the last wait or the logging above: never
  # start CMD for it (DND-925). Its slot fds close with this process.
  check_parent
  ran_start=$(now_ms)
  run_cmd
  rc=$?
  # Read again: a rebase inside the slot (integration-gate --rebase) moved HEAD.
  read_gate_ref
  append_event released "$SLOT" "" "$(($(now_ms) - ran_start))" "$rc"
  write_outcome ran "$rc"
  exit "$rc"
}

# Sourced (by the self-test) → define functions only.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
