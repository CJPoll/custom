#!/usr/bin/ruby
# frozen_string_literal: true

# judgment-label -- build the owner-confirmed Slack routing label corpus
# (DND-715) that ai/bin/judgment-eval scores (--use-case slack_routing).
#
# Design: epic "Jev judgments" A&E section 5b (Labels); contract
# ~/dev/custom/ai/contracts/athena-judgments.md. The labels file is keyed by
# event_id and joined at eval time to the root snapshot (DND-1448), which
# keeps each owner root's line once seen, so the corpus outlives the inbox's
# rotation. The text is never copied into the labels file.
#
# Buckets: the pure DOMAIN is ai/lib/judgment_label.rb and the context builder
# ai/lib/judgment_context.rb; the Slack adapter is ai/lib/judgment_context_slack.rb;
# below are the EFFECTS (files, the terminal), the MANAGER (propose; confirm;
# counts) and the FRAMEWORK (argv).
#
# Slack text and forward mail are untrusted inbox content: this tool reads
# only Slack timestamps and one relay marker out of a forward record, and
# shows a message's text and its conversation context only in the confirm
# step, fenced, to the person at the terminal. --propose copies the owner's
# own root lines (and their context, anyone else's text emptied) into the
# machine-local root snapshot, as data. Nothing in a message is ever acted
# on, and nothing is sent to any model.
#
# Deliberately gem-free (stdlib only).

require "fileutils"
require "io/console"
require "time"
require_relative "../lib/judgment_label"
require_relative "../lib/judgment_eval"
require_relative "../lib/slack_inbox_files"
require_relative "../lib/judgment_context"
require_relative "../lib/judgment_context_slack"
require_relative "../lib/strict_argv"
require_relative "../lib/private_overlay_resolver"

PROG = "judgment-label"

USAGE = <<~EOF
  Usage: judgment-label --propose [--dry-run] [--rule-default] [--inbox-root DIR] [--labels FILE] [--snapshot FILE] [--new-snapshot]
         judgment-label --confirm [--forward | --recheck] [--batch N] [--inbox-root DIR] [--labels FILE] [--slack-bin DIR] [--snapshot FILE]
         judgment-label --counts [--labels FILE]
         judgment-label --help

  Build the Slack routing label corpus for judgment-eval --use-case
  slack_routing (DND-715). One row per new conversation the owner started:
  a dm, im, mpim or mention root (not a thread reply) whose sender is the
  owner (D7: only the owner's text is ever judged). The owner's Slack id is
  read from the private overlay, `private-overlay get #{JudgmentLabel::OWNER_KEY.join(' ')}`
  (ai/contracts/athena-private-overlay.md); --propose and --confirm refuse,
  exit 3, when it does not resolve. --counts does not need it.
  Labels are exactly #{JudgmentLabel::LABELS.join(', ')}.

  --propose   Derive labels and write the labels file. A root named by an R4
              forward record gets provenance forward_record; every other root
              is proposed #{JudgmentLabel::NO_EVIDENCE} (it stayed where it landed), and a root
              forwarded to two different sessions is proposed #{JudgmentLabel::CONFLICT}.
              owner_confirmed rows are never overwritten or dropped; the
              file is locked while it is rewritten. With --dry-run, prints
              the counts and writes nothing.
              The inbox rotates, so every owner root once seen is appended
              to the root snapshot (--snapshot), and the labels are built
              over the snapshot's roots and the live inbox's: a root that
              rotated out keeps its row (DND-1448). Forward records rotate
              too, so what a row recorded is one more vote: a forward_record
              label with no current record is kept, a recorded conflict
              stays one, and a current record that disagrees with a
              recorded label makes a conflict. Forward records are:
                - walt_ui->custom mail, DIR/agent-mail/walt_ui/to-custom (and
                  its .acked/; tmp/ is skipped): harness, or gen_saas when the
                  mail asks custom to relay it to gen_saas;
                - lines walt_ui routed into DIR/custom-session.jsonl (harness)
                  and DIR/gen_saas-session.jsonl (gen_saas).
              A record matches the roots whose Slack ts it names. A record
              whose ts match no inbox line at all is reported by ts; a ts two
              roots share across channels labels neither, and is reported.
              Limit: forward mail is prose, so every ts in its body counts,
              and a quoted ts or relay phrase can mislabel a root.
              judgment-eval treats forward_record as ground truth, so the
              owner can review those rows with --confirm --forward.
              The owner's routing rule (2026-09-28 ~04:25Z) is applied
              mechanically, as provenance rule_confirmed with a "rule"
              field (epic decision D-R2, DND-717); never owner_confirmed:
                - rule 2, session_mention: a root whose text ADDRESSES a
                  session ("harness session: ...", or a short lead-in
                  ending "for the harness session:"; grammar
                  #{JudgmentLabel::MENTION_GRAMMAR}, the server router's own) is labelled that
                  session, over a forward record that disagrees (counted);
                - rule 3, default_walt_ui, only with --rule-default: a root
                  no other evidence labels is walt_ui.
              A default_walt_ui row enters the eval, and --confirm presents
              it with the proposed rows; the owner's answer replaces it. A
              session_mention row does neither: the router routes that root
              by rule and never judges it, so judgment-eval leaves it out.
  --confirm   Show the proposed rows ONE message at a time, at a terminal, and
              record the owner's answer as owner_confirmed. Keys: w walt_ui,
              h harness, g gen_saas, u unclear, Enter keeps the proposal,
              s skips, q quits. Each answer is saved at once. Refused off a
              terminal: a person confirms, never a pipe.
              Each message is shown with its conversation context, read from
              Slack as Athena's own bot (the athena:slack read bins; never
              the owner's account), for this terminal only: nothing is sent
              to any model. The window is the one DND-1048's routing-judge
              design (slack-routing-v2) specifies: the same channel's
              top-level messages from the #{JudgmentContext::WINDOW_S / 60} minutes before, oldest
              first, at most #{JudgmentContext::MAX_MESSAGES}. Each line says what that judge will see
              of it: the owner's text (first #{JudgmentContext::JUDGE_TEXT_CAP} characters, cut marked),
              Athena's post as a session label only, or nothing (anyone
              else, D7). When Slack
              cannot be read the row says "context unavailable: <reason>"
              and you can still answer or skip. The answer records whether
              the context was shown ("context": "shown" or "unavailable").
  --forward   with --confirm: review the forward_record rows instead of the
              proposed ones (Enter keeps the forwarded label, now confirmed)
  --recheck   with --confirm: re-present the owner_confirmed rows whose
              context was not shown (confirmed before DND-1047, or while
              Slack was unreachable). Enter keeps your earlier answer; s
              leaves the row as it was. Until rechecked, the earlier answer
              stays in force.
  --slack-bin DIR   with --confirm: the athena:slack bin directory to read
                    Slack with (default: this checkout's
                    ai/skills/athena:slack/bin)
  --batch N   rows per confirm session, 1..200 (default 10)
  --counts    Print the labels file's rows per label and provenance.

  --inbox-root DIR  default $ATHENA_INBOX_ROOT, else ~/.local/share/athena;
                    holds walt_ui-slack.jsonl and the forward sources above
  --labels FILE     default ${XDG_DATA_HOME:-~/.local/share}/athena/evals/
                    slack-routing-labels.jsonl (machine-local, 0600, never
                    committed)
  --snapshot FILE   with --propose or --confirm: the root snapshot, default
                    DIR/evals/slack-routing-roots.jsonl (DIR the inbox
                    root). Append-only JSONL, 0600, machine-local, never
                    committed: one line per owner root, the first time it is
                    seen, with the root's own fields and text (the owner's,
                    D7) and the context judgment-eval would build for it then
                    (anyone else's text emptied), marked window_complete
                    when every inbox file holding the root's channel
                    reached back over the window.
                    --confirm reads a rotated root's text from it. An
                    ABSENT snapshot while the labels file has rows whose
                    roots are not in the inbox is refused, exit 1: a wrong
                    path or a lost file would drop them.
  --new-snapshot    with --propose: start the snapshot even though rows
                    would be dropped (a machine that never had one)

  Rows are {id, label, provenance, labeler, labeled_at}, the judgment-eval
  label format, plus "context" on an owner_confirmed row and "rule" on a
  rule_confirmed row. The eval's corpus is the snapshot. Check the join with:
    judgment-eval --dry-run --use-case slack_routing --labels FILE \\
      --corpus DIR/evals/slack-routing-roots.jsonl --content-domain work

  Exit codes:
    0  done
    1  an input is missing, empty or malformed, or no owner root was found
    2  usage (including --confirm off a terminal)
    3  the owner's Slack id did not resolve from the private overlay (absent,
       malformed, key missing, or not a Slack user id); nothing was read or
       written

  Every failure prints one stderr line carrying Fix:. For exit 3 it is the
  resolver's own line; the owner id itself is never printed.
EOF

class Failure < StandardError
  attr_reader :code

  def initialize(code, message)
    super(message)
    @code = code
  end
end

def fail!(code, what, fix)
  raise Failure.new(code, "#{PROG}: #{what}. Fix: #{fix}")
end

# ── EFFECTS ──────────────────────────────────────────────────────────────────

module Effects
  module_function

  # owner_id -> the owner's Slack user id from the private overlay. A resolve
  # that fails, or a value that is not a Slack user id, is exit 3 carrying
  # the resolver's one line (its Fix:). Never a fallback, never a guess.
  def owner_id
    file, path = JudgmentLabel::OWNER_KEY
    r = PrivateOverlay::Resolver.get(file, path)
    unless r.state == :found
      raise Failure.new(3, "#{PROG}: the owner's Slack id did not resolve, so nothing was read or written: " \
                           "#{PrivateOverlay.failure_line(r, "#{file}#{path}")}")
    end
    problem = JudgmentLabel.owner_problem(r.value)
    fail!(3, problem, "set #{path} in overlay/#{file}.json of the private overlay (#{r.root}) to the owner's Slack user id") if problem
    r.value
  end

  def default_inbox_root
    root = ENV["ATHENA_INBOX_ROOT"].to_s
    root.empty? ? File.join(Dir.home, ".local", "share", "athena") : root
  end

  def default_labels
    base = ENV["XDG_DATA_HOME"].to_s
    base = File.join(Dir.home, ".local", "share") if base.empty?
    File.join(base, "athena", "evals", "slack-routing-labels.jsonl")
  end

  # read_input(path, what, fix) -> text. Missing and unreadable are distinct
  # from each other and from an empty file (the domain refuses that).
  def read_input(path, what, fix)
    fail!(1, "#{what} #{path} does not exist", fix) unless File.exist?(path)
    fail!(1, "#{what} #{path} is not a readable file", "check its permissions") unless File.file?(path) && File.readable?(path)
    File.read(path, encoding: "UTF-8")
  rescue SystemCallError => e
    fail!(1, "could not read #{what} #{path}: #{e.class}", "check the file and its permissions")
  end

  # mail_files(dir) -> [[path, text]] for dir/*.md and dir/.acked/*.md; tmp/
  # holds half-written mail and is skipped.
  def mail_files(dir)
    fail!(1, "forward mail dir #{dir} does not exist", "point --inbox-root at the root holding agent-mail/walt_ui/to-custom; without it every forward label would vanish silently") unless File.directory?(dir)
    paths = Dir.glob(File.join(dir, "*.md")) + Dir.glob(File.join(dir, ".acked", "*.md"))
    paths.sort.select { |p| File.file?(p) }.map { |p| [p, File.read(p, encoding: "UTF-8")] }
  rescue SystemCallError => e
    fail!(1, "could not read the forward mail under #{dir}: #{e.class}", "check that directory and its files are readable")
  end

  # with_lock(labels) { } -- one writer of the labels file at a time: a
  # --propose and a --confirm (or two confirms) never lose each other's rows.
  def with_lock(labels)
    dir = File.dirname(labels)
    FileUtils.mkdir_p(dir, mode: 0o700)
    File.open("#{labels}.lock", File::RDWR | File::CREAT, 0o600) do |f|
      f.flock(File::LOCK_EX)
      yield
    end
  rescue SystemCallError => e
    fail!(1, "could not lock #{labels}.lock: #{e.class}", "check that #{dir} is writable")
  end

  # labels_rows(path, must_exist:) -> text or nil when absent and allowed.
  def labels_text(path, must_exist:)
    return nil if !must_exist && !File.exist?(path)

    read_input(path, "labels file", "run #{PROG} --propose first (it writes #{path})")
  end

  def write_labels(path, text)
    dir = File.dirname(path)
    FileUtils.mkdir_p(dir, mode: 0o700)
    tmp = "#{path}.tmp.#{Process.pid}"
    File.write(tmp, text, perm: 0o600)
    File.chmod(0o600, tmp)
    File.rename(tmp, path)
  rescue SystemCallError => e
    fail!(1, "could not write #{path}: #{e.class}", "check that #{dir} is writable")
  end

  def default_snapshot(inbox_root)
    File.join(inbox_root, "evals", "slack-routing-roots.jsonl")
  end

  # snapshot_text(path) -> its text, or nil when it does not exist yet (the
  # first --propose creates it). Unreadable is an error, never "empty".
  def snapshot_text(path)
    return nil unless File.exist?(path)

    read_input(path, "root snapshot", "it is judgment-label's own file; check its permissions")
  end

  # append_snapshot(path, text) -- append only, 0600 in a 0700 directory.
  # A file whose last line is unterminated is refused: appending to it would
  # weld two lines into one.
  def append_snapshot(path, text)
    dir = File.dirname(path)
    FileUtils.mkdir_p(dir, mode: 0o700)
    if File.size?(path) && File.open(path, "rb") { |f| f.seek(-1, IO::SEEK_END) && f.read(1) } != "\n"
      fail!(1, "the root snapshot #{path} does not end in a newline", "repair its last line (the file is append-only JSONL; nothing was appended)")
    end
    File.open(path, File::WRONLY | File::APPEND | File::CREAT, 0o600) { |f| f.write(text) }
    File.chmod(0o600, path)
  rescue SystemCallError => e
    fail!(1, "could not append to #{path}: #{e.class}", "check that #{dir} is writable")
  end

  # slack_inbox_files(root) -> {files: [{name:, rows:}], unreadable: n}:
  # every *-slack.jsonl directly under root, read by the reader judgment-eval
  # uses for a context (ai/lib/slack_inbox_files.rb).
  def slack_inbox_files(root)
    SlackInboxFiles.read(root)
  rescue SlackInboxFiles::Error => e
    fail!(1, e.message, e.fix)
  end

  def terminal?
    $stdin.tty? && $stdout.tty?
  end

  def default_slack_bin
    File.expand_path("../skills/athena:slack/bin", __dir__)
  end

  # context_reader(bin_dir) -> the Slack adapter the confirm step reads
  # context through, as Athena's bot.
  def context_reader(bin_dir)
    JudgmentContextSlack.new(bin_dir)
  end

  def now
    Time.now.utc.iso8601
  end
end

# ── MANAGER ──────────────────────────────────────────────────────────────────

module Manager
  module_function

  SESSIONS = %w[custom gen_saas].freeze

  def slack_path(opts)
    File.join(opts[:inbox_root], "walt_ui-slack.jsonl")
  end

  def read_slack(opts)
    path = slack_path(opts)
    text = Effects.read_input(path, "slack inbox", "point --inbox-root at the root holding walt_ui-slack.jsonl (default ~/.local/share/athena)")
    [path, text]
  end

  def forward_records(opts)
    mail_dir = File.join(opts[:inbox_root], "agent-mail", "walt_ui", "to-custom")
    mail = Effects.mail_files(mail_dir).filter_map { |_path, text| JudgmentLabel.mail_record("to-custom-mail", text) }
    by_source = { "to-custom-mail" => mail.size }
    routed = SESSIONS.flat_map do |session|
      path = File.join(opts[:inbox_root], "#{session}-session.jsonl")
      text = Effects.read_input(path, "session inbox", "point --inbox-root at the root holding #{session}-session.jsonl; without it the routed forward labels would vanish silently")
      records = JudgmentLabel.routed_records(text, path, session)
      by_source["#{session}-session"] = records.size
      records
    end
    [mail + routed, by_source]
  end

  def existing_rows(opts, must_exist:)
    text = Effects.labels_text(opts[:labels], must_exist: must_exist)
    text.nil? ? [] : JudgmentLabel.parse_labels(text, opts[:labels])
  end

  def run_propose(opts, out, err)
    opts = opts.merge(owner: Effects.owner_id)
    path, text = read_slack(opts)
    slack = JudgmentLabel.parse_slack(text, path)
    sel = JudgmentLabel.select_roots(slack[:lines], opts[:owner])
    records, by_source = forward_records(opts)
    input = { path: path, text: text, slack: slack, sel: sel, records: records, by_source: by_source }
    if opts[:dry_run]
      propose(opts, input, out, err, write: false)
      out.puts "dry run: nothing written"
    else
      # One --propose at a time, end to end: the labels lock, then the
      # snapshot's, so a root another run appends is never left unlabelled.
      Effects.with_lock(opts[:labels]) do
        Effects.with_lock(opts[:snapshot]) { propose(opts, input, out, err, write: true) }
      end
      out.puts "wrote #{opts[:labels]}"
    end
    0
  rescue JudgmentLabel::InputError => e
    fail!(1, e.message, e.fix)
  end

  # propose -- read the snapshot and the labels file NOW, build, refuse a
  # build that a missing snapshot would make drop rows, then (write:) append
  # the new roots to the snapshot and write the labels. Nothing already in
  # the snapshot is ever rewritten.
  def propose(opts, input, out, err, write:)
    snap = snapshot(opts, input[:sel])
    # A forward record may name a root that has rotated out: the snapshot's
    # roots count as known lines too.
    matched = JudgmentLabel.match(input[:records], input[:slack][:lines] + snap[:kept], snap[:roots])
    report_inputs(input, snap, matched, write, out, err)
    built = JudgmentLabel.build(snap[:roots], matched, existing_rows(opts, must_exist: false), Effects.now,
                                rule_default: opts[:rule_default])
    report_rows(built, out)
    refuse_missing_snapshot(opts, built) if snap[:absent]
    return unless write

    Effects.append_snapshot(opts[:snapshot], JudgmentLabel.render(snapshot_lines(opts, snap[:appended], input, out))) if snap[:appended].any?
    Effects.write_labels(opts[:labels], JudgmentLabel.render(built[:rows]))
  end

  # A snapshot that is absent while label rows would be dropped is a wrong
  # path or a lost file, never "no rotated roots yet" (DND-1448).
  def refuse_missing_snapshot(opts, built)
    return if built[:dropped].zero? || opts[:new_snapshot]

    fail!(1, "the root snapshot #{opts[:snapshot]} does not exist, and #{built[:dropped]} label row(s) have a root in neither the inbox nor any snapshot; " \
             "writing would drop them, so nothing was written",
          "point --snapshot (or --inbox-root) at the existing snapshot; if this machine never had one, run once with --new-snapshot to start it and accept that drop")
  end

  # snapshot -- the root snapshot's roots plus the live roots it lacks.
  def snapshot(opts, sel)
    text = Effects.snapshot_text(opts[:snapshot])
    kept = JudgmentLabel.snapshot_roots(text.nil? ? [] : JudgmentLabel.parse_snapshot(text, opts[:snapshot]), opts[:owner])
    merged = JudgmentLabel.merge_roots(kept[:roots], sel[:roots])
    merged.merge(kept: kept[:roots], not_roots: kept[:not_roots], path: opts[:snapshot], absent: text.nil?)
  end

  # snapshot_lines -- each new root's line, with the context judgment-eval
  # would build for it from the inbox files as they are now.
  def snapshot_lines(opts, roots, input, out)
    read = Effects.slack_inbox_files(opts[:inbox_root])
    files = read[:files]
    lines = files.flat_map { |f| f[:rows] }
    out.puts "snapshot context: #{files.size} inbox file(s) read" + (read[:unreadable].positive? ? ", #{read[:unreadable]} unreadable line(s) skipped" : "")
    raw = JudgmentLabel.raw_rows(input[:text], input[:path], roots.map { |r| r[:event_id] })
    now = Effects.now
    roots.map do |root|
      row = raw.fetch(root[:event_id])
      candidates = JudgmentEval.context_candidates(row, lines, opts[:owner])
      JudgmentLabel.snapshot_row(row, candidates, JudgmentEval.window_covered?(row, files), now)
    end
  end

  # snapshot_line -- an absent snapshot never reads like an empty one.
  def snapshot_line(snap, inbox, write)
    verb = write ? "appended" : "to append (dry run: nothing written)"
    notes = []
    notes << "#{snap[:rotated]} no longer in #{inbox}" if snap[:rotated].positive?
    notes << "#{snap[:not_roots]} not this owner's roots, ignored" if snap[:not_roots].positive?
    kept = snap[:absent] ? "absent, starting it" : "#{snap[:kept].size} roots kept"
    "snapshot: #{snap[:path]}: #{kept}, #{snap[:appended].size} #{verb}" + (notes.empty? ? "" : " (#{notes.join('; ')})")
  end

  def report_inputs(input, snap, matched, write, out, err)
    path, slack, sel, records, by_source = input.values_at(:path, :slack, :sel, :records, :by_source)
    out.puts "slack: #{path}: #{slack[:lines].size + slack[:without_id]} lines" + (slack[:without_id].positive? ? " (#{slack[:without_id]} without event_id, ignored)" : "")
    out.puts "roots: #{sel[:roots].size} owner new-conversation roots " \
             "(excluded: #{sel[:duplicates]} duplicate, #{sel[:non_owner]} not from the owner, #{sel[:replies]} thread replies, #{sel[:other]} other kinds)"
    out.puts snapshot_line(snap, File.basename(path), write)
    if snap[:roots].empty?
      fail!(1, "no owner new-conversation root in #{path} (#{slack[:lines].size} lines considered) or in the root snapshot", "check the owner id (private overlay #{JudgmentLabel::OWNER_KEY.join(' ')}) and that this is the walt_ui slack inbox; nothing was written")
    end
    out.puts "forward records: #{records.size} (#{by_source.map { |k, v| "#{k} #{v}" }.join(', ')}): " \
             "matched #{matched[:matched]}, thread only #{matched[:thread_only]}, unmatched #{matched[:unmatched].size}, conflicts #{matched[:conflicts].size}"
    matched[:unmatched].each do |source, ts|
      err.puts "#{PROG}: unmatched forward record (#{source}): ts #{ts.join(', ')} matches no line in #{File.basename(path)}. " \
               "Fix: none needed to proceed; it labels nothing (a forward of a message this inbox never received, or an older inbox)."
    end
    unless matched[:ambiguous].empty?
      err.puts "#{PROG}: #{matched[:ambiguous].size} ts shared by owner roots in different channels: #{matched[:ambiguous].join(', ')}; " \
               "a forward record naming one labels neither. Fix: none needed to proceed; confirm those roots with --confirm."
    end
  end

  def report_rows(built, out)
    out.puts "labels: #{built[:rows].size} rows"
    JudgmentLabel.counts(built[:rows]).each { |l, p, n| out.puts "  #{l} #{p} #{n}" }
    out.puts "owner_confirmed kept: #{built[:rows].count { |r| r['provenance'] == 'owner_confirmed' }} " \
             "(#{built[:kept_orphans]} in neither this inbox nor the snapshot); forward records disagreeing with the owner: #{built[:disagreements]}; " \
             "dropped (root in neither this inbox nor the snapshot): #{built[:dropped]}"
    out.puts "forward labels kept after their records rotated out: #{built[:kept_forwards]}"
    out.puts "session mentions (rule 2, #{JudgmentLabel::MENTION_GRAMMAR}): " \
             "#{built[:rows].count { |r| r['rule'] == 'session_mention' }} rule_confirmed; " \
             "forward records a mention overrode: #{built[:mention_overrides]}"
  end

  def run_confirm(opts, out, input)
    fail!(2, "--confirm needs a terminal (stdin and stdout)", "the owner runs it at a terminal; a pipe or an agent never confirms a label") unless Effects.terminal?

    opts = opts.merge(owner: Effects.owner_id)
    mode = confirm_mode(opts)
    pending = JudgmentLabel.pending(existing_rows(opts, must_exist: true), mode).first(opts[:batch])
    if pending.empty?
      out.puts "nothing to #{mode == :recheck ? 'recheck' : 'confirm'}: no #{MODE_ROWS[mode]} in #{opts[:labels]}"
      return 0
    end
    path, text = read_slack(opts)
    msgs = messages_for(opts, text, path, pending.map { |r| r["id"] })
    where = "#{File.basename(path)} or the root snapshot"
    reader = Effects.context_reader(opts[:slack_bin])
    done = 0
    skipped = 0
    pending.each_with_index do |row, i|
      msg = msgs[row["id"]]
      context = context_for(msg, reader, where, opts[:owner])
      show(row, msg, context, mode, i, pending.size, where, out)
      verdict = ask(row["label"], mode, out, input)
      case verdict.first
      when :quit then break
      when :skip then skipped += 1
      when :label
        record(opts, row["id"], verdict.last, context["status"] == "ok" ? "shown" : "unavailable")
        done += 1
      end
    end
    left = JudgmentLabel.pending(existing_rows(opts, must_exist: true), mode)
    gone = left.size - messages_for(opts, text, path, left.map { |r| r["id"] }).size
    out.puts "#{mode == :recheck ? 'rechecked' : 'confirmed'} #{done}, skipped #{skipped}; #{left.size} #{MODE_ROWS[mode]} remain" +
             (gone.positive? ? " (#{gone} no longer in #{where}, so no context can be shown for them)" : "")
    0
  rescue JudgmentLabel::InputError => e
    fail!(1, e.message, e.fix)
  end

  # messages_for(opts, text, path, ids) -> the live inbox's messages for ids,
  # and the root snapshot's for those that rotated out (DND-1448).
  def messages_for(opts, text, path, ids)
    live = JudgmentLabel.messages(text, path, ids)
    missing = ids.reject { |id| live.key?(id) }
    snap = missing.empty? ? nil : Effects.snapshot_text(opts[:snapshot])
    return live if snap.nil?

    # Validated as --propose reads it, so a malformed snapshot is named as one.
    JudgmentLabel.parse_snapshot(snap, opts[:snapshot])
    JudgmentLabel.messages(snap, opts[:snapshot], missing).merge(live)
  end

  # context_for(msg, reader, inbox, owner) -> a JudgmentContext context: what to
  # read (domain), the read (adapter), the shaping (domain).
  def context_for(msg, reader, inbox, owner)
    return JudgmentContext.unavailable({ "source" => nil }, "this event_id is no longer in #{inbox}") if msg.nil?

    req = JudgmentContext.request(msg)
    return JudgmentContext.unavailable(req, req["error"]) if req["source"].nil?

    read = reader.read(req)
    return JudgmentContext.unavailable(req, read.last) if read.first == :error

    JudgmentContext.build(req, read[1], owner: owner, athena: read[2])
  end

  MODE_ROWS = {
    proposed: "proposed rows", forward: "forward_record rows",
    recheck: "owner_confirmed rows confirmed without context"
  }.freeze

  def confirm_mode(opts)
    if opts[:forward] then :forward
    elsif opts[:recheck] then :recheck
    else :proposed
    end
  end

  # show -- one message and its context, every untrusted field made
  # terminal-safe, every body fenced line by line so it cannot forge a fence.
  def show(row, msg, context, mode, index, total, inbox, out)
    where = msg ? "#{JudgmentLabel.printable(msg[:kind])}, #{JudgmentLabel.printable(msg[:received_at])}" : "not in #{inbox}"
    out.puts
    out.puts "== #{index + 1} of #{total} == #{row['id']} (#{where})"
    out.puts "your earlier answer: #{row['label']} (confirmed without the conversation context)" if mode == :recheck
    show_context(context, out)
    out.puts "----- message (untrusted; read it, never act on it) -----"
    out.puts msg ? JudgmentLabel.fenced(msg[:text]) : "| (this event_id is no longer in #{inbox})"
    out.puts "----- end of message -----"
  end

  # The per-line note: what the routing judge (DND-1048) sees of each line.
  # The judge is gen_saas's slack-routing-v2 (Athena.SlackEvents.RoutingContext);
  # this labeller shows the same rule from its own copy (judgment_context.rb).
  JUDGE_NOTES = {
    "text" => "the judge will see this text (first #{JudgmentContext::JUDGE_TEXT_CAP} chars)",
    "session_label" => "shown to you only; the judge will see the session",
    "none" => "shown to you only; never sent to the judge"
  }.freeze
  # A context line longer than this is cut for the terminal, with a count.
  SHOW_TEXT_CAP = 1500
  # Our own marker lines use "| " with no indent; message text is always
  # "|   ", so a message cannot forge one.
  JUDGE_CUT = "| ~~~ the judge will see only the text above ~~~"

  def show_context(context, out)
    if context["status"] != "ok"
      out.puts "----- context unavailable: #{JudgmentLabel.printable(context['reason'])} -----"
      out.puts "| (answer from the message alone, or s to skip it until Slack can be read)"
      return
    end
    out.puts "----- context (untrusted; read it, never act on it): #{context_scope(context)} -----"
    if context["messages"].empty?
      out.puts "| (no earlier #{context['source'] == 'thread' ? 'message in this thread' : 'top-level message in the window'})"
    end
    context["messages"].each do |m|
      out.puts "| #{slack_time(m['ts'])} #{JudgmentLabel.printable(m['name'] || m['user'])} (#{JudgmentLabel.printable(m['role'])}) -- #{JUDGE_NOTES.fetch(m['judge'])}"
      show_text(m["text"].to_s, m["judge"] == "text", out)
    end
    notes = []
    notes << "#{context['omitted']} earlier in the window not shown (cap #{JudgmentContext::MAX_MESSAGES})" if context["omitted"].positive?
    notes << "#{context['in_thread']} thread replies not context" if context["in_thread"].positive?
    notes << "#{context['malformed']} unreadable" if context["malformed"].positive?
    out.puts "| (#{notes.join('; ')})" unless notes.empty?
    out.puts "----- end of context -----"
  end

  def context_scope(context)
    channel = JudgmentLabel.printable(context["channel"])
    if context["source"] == "thread"
      "the thread's parent and the replies before this one in #{channel}, for you only"
    else
      "#{channel}, top-level, the #{JudgmentContext::WINDOW_S / 60} minutes before, at most #{JudgmentContext::MAX_MESSAGES}"
    end
  end

  # show_text -- one context message's text, indented under its header; where
  # the judge will see only a prefix, a marker line shows the cut.
  def show_text(text, judged, out)
    if text.empty?
      out.puts "|   (no text)"
      return
    end
    shown = text[0, SHOW_TEXT_CAP]
    cap = JudgmentContext::JUDGE_TEXT_CAP
    if judged && shown.length > cap
      out.puts indented(shown[0, cap])
      out.puts JUDGE_CUT
      out.puts indented(shown[cap..])
    else
      out.puts indented(shown)
    end
    out.puts "|   [... #{text.length - SHOW_TEXT_CAP} more characters not shown]" if text.length > SHOW_TEXT_CAP
  end

  def indented(text)
    JudgmentLabel.fenced(text).gsub(/^\| /, "|   ")
  end

  def slack_time(ts)
    Time.at(ts.split(".").first.to_i).utc.iso8601
  end

  # record -- save one answer at once: under the lock, on the file as it is
  # NOW, so a --propose or another confirm run meanwhile loses nothing.
  def record(opts, id, label, context_mark)
    Effects.with_lock(opts[:labels]) do
      rows = existing_rows(opts, must_exist: true)
      rows = JudgmentLabel.confirm(rows, id, label, opts[:owner], Effects.now, context_mark)
      Effects.write_labels(opts[:labels], JudgmentLabel.render(rows))
    end
  end

  # ask(current, mode, out, input) -> a JudgmentLabel.answer verdict; EOF quits.
  def ask(current, mode, out, input)
    enter = mode == :recheck ? "keep #{current}" : current
    loop do
      out.print "label? [w]alt_ui [h]arness [g]en_saas [u]nclear, Enter = #{enter}, [s]kip, [q]uit: "
      out.flush
      line = input.gets
      return [:quit] if line.nil?

      verdict = JudgmentLabel.answer(line, current)
      return verdict unless verdict.first == :again

      out.puts "not an answer; use w, h, g, u, Enter, s or q"
    end
  end

  def run_counts(opts, out)
    rows = existing_rows(opts, must_exist: true)
    out.puts "labels: #{opts[:labels]}: #{rows.size} rows"
    JudgmentLabel.counts(rows).each { |l, p, n| out.puts "  #{l} #{p} #{n}" }
    0
  rescue JudgmentLabel::InputError => e
    fail!(1, e.message, e.fix)
  end
end

# ── FRAMEWORK ────────────────────────────────────────────────────────────────

SPEC = {
  "--help" => :switch, "-h" => :switch, "--propose" => :switch, "--confirm" => :switch, "--counts" => :switch,
  "--dry-run" => :switch, "--rule-default" => :switch, "--forward" => :switch, "--recheck" => :switch, "--batch" => :integer,
  "--inbox-root" => :value, "--labels" => :value, "--slack-bin" => :value, "--snapshot" => :value,
  "--new-snapshot" => :switch
}.freeze

MODES = %w[--propose --confirm --counts].freeze

def parse_options(argv)
  raw = StrictArgv.parse(argv, SPEC)
  modes = MODES & raw.keys
  fail!(2, modes.empty? ? "no mode given" : "#{modes.join(' and ')} given together", "pass exactly one of #{MODES.join(', ')}; run #{PROG} --help") unless modes.size == 1
  mode = modes.first
  fail!(2, "--dry-run applies only to --propose", "drop --dry-run") if raw["--dry-run"] && mode != "--propose"
  fail!(2, "--rule-default applies only to --propose", "drop --rule-default") if raw["--rule-default"] && mode != "--propose"
  fail!(2, "--batch applies only to --confirm", "drop --batch") if raw.key?("--batch") && mode != "--confirm"
  fail!(2, "--forward applies only to --confirm", "drop --forward") if raw["--forward"] && mode != "--confirm"
  fail!(2, "--recheck applies only to --confirm", "drop --recheck") if raw["--recheck"] && mode != "--confirm"
  fail!(2, "--forward and --recheck given together", "pass one: --forward reviews forward_record rows, --recheck re-presents rows confirmed without context") if raw["--forward"] && raw["--recheck"]
  fail!(2, "--slack-bin applies only to --confirm", "drop --slack-bin") if raw.key?("--slack-bin") && mode != "--confirm"
  fail!(2, "--inbox-root does not apply to --counts", "drop --inbox-root") if raw.key?("--inbox-root") && mode == "--counts"
  fail!(2, "--snapshot does not apply to --counts", "drop --snapshot") if raw.key?("--snapshot") && mode == "--counts"
  fail!(2, "--new-snapshot applies only to --propose", "drop --new-snapshot") if raw["--new-snapshot"] && mode != "--propose"
  batch = raw.fetch("--batch", 10)
  fail!(2, "--batch must be 1..200", "pass a smaller batch") unless (1..200).cover?(batch)
  %w[--inbox-root --labels --slack-bin --snapshot].each do |flag|
    fail!(2, "#{flag} must be an absolute path", "pass an absolute path") if raw.key?(flag) && !raw[flag].start_with?("/")
  end
  inbox_root = raw["--inbox-root"] || Effects.default_inbox_root
  {
    mode: mode, dry_run: raw["--dry-run"] || false, rule_default: raw["--rule-default"] || false, forward: raw["--forward"] || false, recheck: raw["--recheck"] || false,
    batch: batch, inbox_root: inbox_root, labels: raw["--labels"] || Effects.default_labels,
    slack_bin: raw["--slack-bin"] || Effects.default_slack_bin,
    snapshot: raw["--snapshot"] || Effects.default_snapshot(inbox_root), new_snapshot: raw["--new-snapshot"] || false
  }
rescue StrictArgv::UsageError => e
  fail!(2, e.message, "run #{PROG} --help for the flags")
end

def main(argv)
  # --help anywhere wins, before anything else runs (check-bin-help).
  if argv.include?("--help") || argv.include?("-h")
    $stdout.puts USAGE
    return 0
  end

  opts = parse_options(argv)
  case opts[:mode]
  when "--propose" then Manager.run_propose(opts, $stdout, $stderr)
  when "--confirm" then Manager.run_confirm(opts, $stdout, $stdin)
  else Manager.run_counts(opts, $stdout)
  end
rescue Failure => e
  $stderr.puts e.message
  e.code
end

exit(main(ARGV)) if $PROGRAM_NAME == __FILE__
