#!/usr/bin/env bash
# fleet-report -- send one fleet report (a state upsert) to the Athena server's
# fleet registry. FRAMEWORK: parse argv, build the body (domain), hand it to the
# manager. Normative home: ai/contracts/athena-events.md -> *Fleet registry and
# session control* (DND-431 server, DND-433 this reporter).

set -u

usage() {
  cat <<'EOF'
Usage: fleet-report <subcommand> [flags]

Send one report to POST /api/v1/fleet/reports (ai/contracts/athena-events.md ->
Fleet report kinds and their closed schema). Identity is only the machine token:
owner and machine are stamped server-side, so --machine/--owner are refused.

Subcommands (flags may come in any order):
  session-start  [--cwd DIR]                        session_started (project + repo_key
                                                    resolved from DIR's git common dir)
  session-seen   [--agent-id ID] [--agent-type T]   session_seen
  session-end    [--reason R]                       session_ended
  admiral-start  --run-id R --agent-id ID [--scope-label L]   admiral_started
  admiral-scope  --run-id R --missions FILE [--notion-project-id ID]
                                                    admiral_scope (FILE: JSON array of
                                                    mission pointers, exactly tracker,
                                                    ticket_ref, url, title, status,
                                                    captain_state; ID: the scope's
                                                    Notion Project page id, from which
                                                    the server classifies the run's
                                                    domain)
  admiral-seen   --agent-id ID [--agent-type T]     admiral_seen
  admiral-state  --run-id R --state draining|drained|finished|parked   admiral_state
                                                    (parked: stopped at a usage ceiling
                                                    or on a park request; resumable)

Lifecycle subcommands (DND-560; sent by ai/hooks/fleet-lifecycle.sh, and by
ai/hooks/fleet-drain-guard.sh for spawn_denied). T is athena-admiral or
athena-captain; no flag can carry prompt or description text:
  agent-spawn  --tool-use-id U --subagent-type T --mapping mapped|unmapped|not_applicable
               [--caller-agent-id ID] [--ticket-ref REF] [--run-hint R]   agent_spawn
               (not_applicable exactly for an admiral; --ticket-ref exactly with
               mapped, matching ^[A-Z][A-Z0-9]{1,9}-[1-9][0-9]{0,6}$)
  agent-bound  --tool-use-id U --agent-id ID --agent-type T              agent_bound
  agent-start  --agent-id ID --agent-type T                              agent_start
  agent-end    (--agent-id ID | --tool-use-id U) --agent-type T --outcome O
               [--error-class C]                                         agent_end
               (O: stopped|api_error by --agent-id, spawn_failed|spawn_denied by
               --tool-use-id; --error-class exactly with api_error/spawn_failed,
               and a class outside the contract's list is sent as other)

Common flags:
  --session-id S   top-level Claude session id (default: $CLAUDE_CODE_SESSION_ID,
                   which every agent depth's Bash tool carries)
  --dry-run        print the JSON body on stdout; read no token, send nothing
  --help           this text
  --self-test      run the fleet-report suite (fake server; never prod)

Exit codes:
  0 ok   1 local configuration (no token / no athena MCP entry / bad state dir /
  unresolvable repo)   2 usage   3 server refused (prints its Fix:)
  4 server unreachable   5 server fault (5xx)

Environment (optional): ATHENA_INBOX_CLIENT_CONFIG (token config path),
FLEET_CLAUDE_JSON (~/.claude.json path), ATHENA_INBOX_ROOT (inbox registry root),
XDG_STATE_HOME, FLEET_CONNECT_TIMEOUT_S (default 5), FLEET_MAX_TIME_S (default 10).

Every failure prints one stderr line carrying Fix:. The server URL is the origin
of the `athena` MCP entry in ~/.claude.json; the token is read from
~/.config/athena-inbox-client/config.json and fed to curl on stdin, never argv.
EOF
}

SELF="$(realpath -- "${BASH_SOURCE[0]}")"
AI="$(cd -- "$(dirname -- "${SELF}")/.." && pwd -P)"
INBOX_LIB="${AI}/skills/athena:inbox/lib"

die_usage() {
  printf 'fleet-report: %s. Fix: %s\n' "$1" "${2:-run fleet-report --help for the subcommands and their flags.}" >&2
  exit 2
}

# --help / --self-test anywhere win, before anything else runs.
for a in "$@"; do
  case "${a}" in
    -h|--help) usage; exit 0 ;;
    --self-test) exec "${AI}/lib/fleet/test/self-test.sh" ;;
  esac
done

for dep in jq; do
  command -v "${dep}" >/dev/null 2>&1 || { printf 'fleet-report: %s is not on PATH. Fix: install %s.\n' "${dep}" "${dep}" >&2; exit 1; }
done

# shellcheck source=../lib/fleet/domain.sh
. "${AI}/lib/fleet/domain.sh"
# shellcheck disable=SC1091
for f in err names descriptor logchan maildir fence session fs lock inbox; do . "${INBOX_LIB}/${f}.sh"; done
# shellcheck source=../lib/fleet/effects.sh
. "${AI}/lib/fleet/effects.sh"
# shellcheck source=../lib/fleet/manager.sh
. "${AI}/lib/fleet/manager.sh"

# A report killed mid-request (the hook's timeout) still removes its temp dir.
FLEET_POST_TMP=""
trap '[ -n "${FLEET_POST_TMP}" ] && rm -rf -- "${FLEET_POST_TMP}"' EXIT
trap 'exit 143' TERM INT HUP

sub="" session_id="${CLAUDE_CODE_SESSION_ID:-}" cwd="${PWD}" agent_id="" agent_type="" run_id=""
missions_file="" state="" scope_label="" reason="" notion_project_id="" dry_run="" given=" "
tool_use_id="" subagent_type="" caller_agent_id="" mapping="" ticket_ref="" run_hint="" outcome="" error_class=""

# need_value FLAG [NEXT...] -- a value flag needs a value that is not the next
# flag (`--session-id --cwd /x` used to read "--cwd" as the session id), and no
# value flag may be given twice (the second silently won). DND-813.
seen_flags=" "
once() {
  case "${seen_flags}" in *" $1 "*) die_usage "$1 given more than once" "pass $1 once." ;; esac
  seen_flags="${seen_flags}$1 "
}
need_value() {
  once "$1"
  [ "$#" -ge 2 ] && [ -n "$2" ] && [ "${2#-}" = "$2" ] || die_usage "$1 needs a value"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --machine|--machine=*|--machine-id|--machine-id=*|--owner|--owner=*|--owner-id|--owner-id=*)
      die_usage "${1%%=*} is refused: owner and machine are stamped server-side from the machine token" \
        "remove ${1%%=*}; the server reads identity only from the token (athena-events.md -> Fleet identity)." ;;
    --session-id)  need_value "$@"; session_id="$2"; given="${given}session-id "; shift 2 ;;
    --cwd)         need_value "$@"; cwd="$2"; given="${given}cwd "; shift 2 ;;
    --agent-id)    need_value "$@"; agent_id="$2"; given="${given}agent-id "; shift 2 ;;
    --agent-type)  need_value "$@"; agent_type="$2"; given="${given}agent-type "; shift 2 ;;
    --run-id)      need_value "$@"; run_id="$2"; given="${given}run-id "; shift 2 ;;
    --missions)    need_value "$@"; missions_file="$2"; given="${given}missions "; shift 2 ;;
    --state)       need_value "$@"; state="$2"; given="${given}state "; shift 2 ;;
    --scope-label) need_value "$@"; scope_label="$2"; given="${given}scope-label "; shift 2 ;;
    --reason)      need_value "$@"; reason="$2"; given="${given}reason "; shift 2 ;;
    --notion-project-id) need_value "$@"; notion_project_id="$2"; given="${given}notion-project-id "; shift 2 ;;
    --tool-use-id)     need_value "$@"; tool_use_id="$2"; given="${given}tool-use-id "; shift 2 ;;
    --subagent-type)   need_value "$@"; subagent_type="$2"; given="${given}subagent-type "; shift 2 ;;
    --caller-agent-id) need_value "$@"; caller_agent_id="$2"; given="${given}caller-agent-id "; shift 2 ;;
    --mapping)         need_value "$@"; mapping="$2"; given="${given}mapping "; shift 2 ;;
    --ticket-ref)      need_value "$@"; ticket_ref="$2"; given="${given}ticket-ref "; shift 2 ;;
    --run-hint)        need_value "$@"; run_hint="$2"; given="${given}run-hint "; shift 2 ;;
    --outcome)         need_value "$@"; outcome="$2"; given="${given}outcome "; shift 2 ;;
    --error-class)     need_value "$@"; error_class="$2"; given="${given}error-class "; shift 2 ;;
    --dry-run)     once "$1"; dry_run=1; shift ;;
    -*)            die_usage "unknown flag $1" ;;
    *)
      [ -z "${sub}" ] || die_usage "unexpected argument $1 (subcommand already ${sub})"
      sub="$1"; shift ;;
  esac
done

[ -n "${sub}" ] || die_usage "no subcommand given"

# allowed_flags <list> -- refuse any given flag the subcommand does not take.
allowed_flags() {
  local f
  for f in ${given}; do
    case " session-id $1 " in *" ${f} "*) ;; *) die_usage "${sub} does not take --${f}" ;; esac
  done
}

[ -n "${session_id}" ] || die_usage "no session id: --session-id is unset and so is \$CLAUDE_CODE_SESSION_ID" \
  "pass --session-id <top-level claude session id>, or run from inside a Claude Code session."
fleet_valid_id "${session_id}" || die_usage "session id ${session_id@Q} is not a valid id" \
  "pass the top-level session_id exactly as Claude Code gives it (letters, digits, . _ -)."
[ -z "${agent_id}" ] || fleet_valid_id "${agent_id}" || die_usage "agent id ${agent_id@Q} is not a valid id" \
  "pass your own agentId exactly as SendMessage uses it."
[ -z "${run_id}" ] || fleet_valid_id "${run_id}" || die_usage "run id ${run_id@Q} is not a valid id" \
  "pass the run's coordination directory name, e.g. 2026-09-24-p1-fleet."
[ -z "${notion_project_id}" ] || fleet_valid_notion_id "${notion_project_id}" ||
  die_usage "--notion-project-id ${notion_project_id@Q} is not a Notion page id" \
    "pass the Project page's id: 32 hex digits, bare or dashed (e.g. 3e2349da-87fb-81ac-a4f5-ff241e915946), not a URL."

for pair in "tool-use-id:${tool_use_id}" "caller-agent-id:${caller_agent_id}" "run-hint:${run_hint}"; do
  v="${pair#*:}"
  [ -z "${v}" ] || fleet_valid_id "${v}" || die_usage "--${pair%%:*} ${v@Q} is not a valid id" \
    "pass the value exactly as the hook stdin carries it (letters, digits, . _ -; a run hint is a coordination directory name)."
done

require() { [ -n "$2" ] || die_usage "${sub} needs --$1"; }

# lifecycle_refused <problem> -- a combination the contract's closed schema refuses.
lifecycle_refused() {
  die_usage "${sub} refused: $1" \
    "send the combination athena-events.md -> Fleet report kinds and their closed schema allows (fleet-report --help lists it)."
}

case "${sub}" in
  session-start)
    allowed_flags "cwd"
    body="$(fleet_session_started_body "${session_id}" "${cwd}")" || exit 1
    kind=session_started ;;
  session-seen)
    allowed_flags "agent-id agent-type"
    body="$(fleet_body_seen session_seen "${session_id}" "${agent_id}" "${agent_type}")"
    kind=session_seen ;;
  session-end)
    allowed_flags "reason"
    body="$(fleet_body_session_ended "${session_id}" "${reason}")"
    kind=session_ended ;;
  admiral-start)
    allowed_flags "run-id agent-id scope-label"
    require run-id "${run_id}"; require agent-id "${agent_id}"
    body="$(fleet_body_admiral_started "${session_id}" "${run_id}" "${agent_id}" "${scope_label}")"
    kind=admiral_started ;;
  admiral-scope)
    allowed_flags "run-id missions notion-project-id"
    require run-id "${run_id}"; require missions "${missions_file}"
    rc=0
    missions="$(fleet_load_missions "${missions_file}")" || rc=$?
    case "${rc}" in
      0) ;;
      1) die_usage "--missions ${missions}" "write the mission pointers as a JSON array to a file and pass its path." ;;
      *) die_usage "--missions refused: ${missions}" \
           "a mission pointer carries exactly tracker, ticket_ref, url, title, status, captain_state (athena-events.md -> Mission pointers are metadata only)." ;;
    esac
    body="$(fleet_body_admiral_scope "${session_id}" "${run_id}" "${missions}" "${notion_project_id}")"
    kind=admiral_scope ;;
  admiral-seen)
    allowed_flags "agent-id agent-type"
    require agent-id "${agent_id}"
    body="$(fleet_body_seen admiral_seen "${session_id}" "${agent_id}" "${agent_type}")"
    kind=admiral_seen ;;
  admiral-state)
    allowed_flags "run-id state"
    require run-id "${run_id}"; require state "${state}"
    fleet_valid_admiral_state "${state}" || die_usage "--state ${state@Q} is not reportable" \
      "use one of: ${FLEET_ADMIRAL_STATES} (running is set by admiral-start)."
    body="$(fleet_body_admiral_state "${session_id}" "${run_id}" "${state}")"
    kind=admiral_state ;;
  agent-spawn)
    allowed_flags "tool-use-id subagent-type caller-agent-id mapping ticket-ref run-hint"
    require tool-use-id "${tool_use_id}"; require subagent-type "${subagent_type}"; require mapping "${mapping}"
    problem="$(fleet_agent_spawn_problem "${subagent_type}" "${mapping}" "${ticket_ref}")" || lifecycle_refused "${problem}"
    body="$(fleet_body_agent_spawn "${session_id}" "${tool_use_id}" "${subagent_type}" "${caller_agent_id}" "${mapping}" "${ticket_ref}" "${run_hint}")"
    kind=agent_spawn ;;
  agent-bound)
    allowed_flags "tool-use-id agent-id agent-type"
    require tool-use-id "${tool_use_id}"; require agent-id "${agent_id}"; require agent-type "${agent_type}"
    fleet_is_fleet_worker "${agent_type}" || lifecycle_refused "agent_type ${agent_type@Q} is not a fleet worker (${FLEET_WORKER_TYPES})"
    body="$(fleet_body_agent_bound "${session_id}" "${tool_use_id}" "${agent_id}" "${agent_type}")"
    kind=agent_bound ;;
  agent-start)
    allowed_flags "agent-id agent-type"
    require agent-id "${agent_id}"; require agent-type "${agent_type}"
    fleet_is_fleet_worker "${agent_type}" || lifecycle_refused "agent_type ${agent_type@Q} is not a fleet worker (${FLEET_WORKER_TYPES})"
    body="$(fleet_body_agent_start "${session_id}" "${agent_id}" "${agent_type}")"
    kind=agent_start ;;
  agent-end)
    allowed_flags "agent-id tool-use-id agent-type outcome error-class"
    require agent-type "${agent_type}"; require outcome "${outcome}"
    # An unlisted class is mapped, not refused (contract: a Claude Code upgrade
    # that adds a class never gets a report refused).
    [ -z "${error_class}" ] || error_class="$(fleet_error_class "${error_class}")"
    problem="$(fleet_agent_end_problem "${agent_id}" "${tool_use_id}" "${agent_type}" "${outcome}" "${error_class}")" || lifecycle_refused "${problem}"
    body="$(fleet_body_agent_end "${session_id}" "${agent_id}" "${tool_use_id}" "${agent_type}" "${outcome}" "${error_class}")"
    kind=agent_end ;;
  *) die_usage "unknown subcommand ${sub@Q}" ;;
esac

if [ -n "${dry_run}" ]; then
  printf '%s\n' "${body}"
  exit 0
fi

fleet_send "${kind}" "${body}" "${cwd}" "${AI}"
exit $?
