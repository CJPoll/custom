#!/usr/bin/ruby
# frozen_string_literal: true

# judgment-feedback -- the harness client for receiver feedback on Jev
# judgments (DND-1466). Normative home: ai/contracts/athena-judgments.md ->
# *Receiver feedback*; the procedure is the athena:judgment-feedback skill.
# The server is gen_saas POST/GET /api/v1/judgments/feedback (DND-1462).
#
# Buckets: DOMAIN (pure: ai/lib/judgment_feedback.rb and, for scan-tickets
# (DND-1469), ai/lib/judgment_feedback_scan.rb), EFFECTS (the note, seen and
# recorded files; the Athena server through athena_server.rb; the DND tracker,
# read only, through ai/lib/notion_read.rb), MANAGER (record, list, scan) and
# FRAMEWORK (argv, exit codes).
#
# NO TOKEN TOUCHES ARGV OR THE ENVIRONMENT: athena_server.rb writes it into a
# curl config that curl reads on STDIN. No token, note or payload is printed
# unless --with-payloads asks for the payload and note.
#
# Deliberately gem-free (stdlib only).

require "json"
require "uri"
require_relative "../lib/strict_argv"
require_relative "../lib/judgment_feedback"
require_relative "../lib/judgment_feedback_scan"
require_relative "../lib/notion_read"
require_relative "../lib/triage_corpus"
require_relative "../skills/athena:ticket-management/lib/athena_server"

PROG = "judgment-feedback"
ROUTE = "/api/v1/judgments/feedback"
JF = JudgmentFeedback
JFS = JudgmentFeedbackScan
# The DND Tickets data source (as ticket-reclassify reads it).
TICKETS_DATA_SOURCE = "219349da-87fb-8063-8f36-000b362fbd60"

USAGE = <<~EOF
  Usage: judgment-feedback record --call <uuid> [--correct <question>=<label>]...
                                  [--signal <s>] [--note-file <f>] [--session-label <l>]
         judgment-feedback record --use-case slack_routing --subject <event_id> [same options]
         judgment-feedback list [--after <cursor or time>] [--limit N] [--json]
                                [--overlap-s N] [--seen-file <f>] [--with-payloads]
         judgment-feedback scan-tickets --since <time> [--recorded-file <f>] [--json]
         judgment-feedback scan-tickets --cursor-file <f> [--since <time>] [--recorded-file <f>] [--json]
         judgment-feedback --help

  Receiver feedback on Jev judgments (ai/contracts/athena-judgments.md ->
  *Receiver feedback*; procedure: the athena:judgment-feedback skill). The
  server derives the owner and the reporter from this machine's token; there
  is no flag for either.

  record   Say an answered judgment was wrong. Name the call by the id its
           result printed (--call), or a topic-routed Slack conversation by its
           event id (--use-case slack_routing --subject <event_id>).
             --correct q=label  the right label for question q; repeat per
                        question. A choice's label is its option key, a
                        score's its level index ("0" lowest to "n-1"), a
                        noul's "true" or "false". Leave it out when you do not
                        know the right answer.
             --signal s         the signal (the server defaults to explicit)
             --note-file f      a file holding a short note (at most 500
                        characters). Never paste the judged text, a secret or
                        someone else's message into it. It is never printed.
             --session-label l  the reporting session's label
           Prints, exit 0:  recorded <feedback_id> call <call_id>
                            (or "replaced ..." for a second report of yours)

  list     Read the owner's feedback, oldest first, paging until the end.
             --after X     a cursor (<ISO 8601 time>,<uuid>, as next_cursor
                        prints it) or an ISO 8601 time with a zone, e.g.
                        2026-10-01T07:00:00Z. Absent: from the oldest kept row.
             --limit N     rows per page, 1 to 200 (default 100)
             --overlap-s N re-read N seconds behind --after (0 to 3600). Rows
                        commit with the time their transaction began, so a row
                        can land behind a cursor already passed; the overlap
                        finds it. Pair it with --seen-file. Pass it on
                        every run, the first (no --after) included: it also
                        sizes seen_tail, which the next run drops by id.
             --seen-file f ids already handled, one per line (the previous
                        run's seen_tail). A row with one of them is dropped and
                        counted as deduped.
             --json        each row as one JSON line, then a final line
             --with-payloads  include each row's note and request (the text
                        Jev was sent). Read them in session only; never quote
                        them in a ticket, commit or journal.
           Without --with-payloads a row carries ids, names, answers and
           counts, and has_note instead of the note.
           The final line, always printed (with --json):
             {"next_cursor":"<cursor>","complete":true,"rows":N,"deduped":D,"seen_tail":[ids]}
           next_cursor never moves behind --after. seen_tail lists the ids
           read within --overlap-s of next_cursor: save it as the next run's
           --seen-file. Without --json, one line per row (ids only) and
             complete: N rows, D deduped, next_cursor <cursor>
           A read that stops part way prints the rows it read, then
             {"next_cursor":null,"complete":false,"rows":N,"deduped":D,"reason":"<class>"}
           and exits 3 or 4. It is never an empty list: keep the old cursor.

  scan-tickets  Find hand edits of Jev's ticket classifications and Paths,
           and record each as feedback (DND-1469, DND-1470). Reads the DND
           tickets edited at or after --since (read only, through
           ai/lib/notion_read.rb) and, per ticket, its LAST "Jev
           classification:" line. A Kind, Severity or
           Security whose line says source jev, accepted, and whose current
           value differs is recorded against the line's calls.<property> with
           signal field_changed, session label harness, and the correction
           {<question>: <the current value as the question's label>}. It
           writes nothing but that feedback (and --recorded-file).
             --since T          an ISO 8601 time with a zone (the previous
                        run's next_since). Required, or read from
                        --cursor-file: never a whole-tracker scan.
             --cursor-file f  the scan's own cursor. With no --since, the
                        --since is read from it (a missing file is usage:
                        pass --since on a first run). A complete scan
                        writes its next_since to it, one line; an
                        incomplete one leaves it as it was. A cursor that
                        cannot be written is exit 3, after the counts.
             --recorded-file f  "<call> <question>=<label>" per line: what
                        earlier scans recorded. Such an edit is counted
                        already_recorded and not sent again (a second report
                        moves the row past the feedback reader's cursor, so it
                        would be read twice). Each new record is appended.
             --json     one JSON line instead of the lines below, with the
                        same counts, "complete", "next_since" (null unless
                        complete) and, when incomplete, "reason"
           Rows with no DND id are counted (not_a_ticket). Every ticket is
           counted once by reason:
             lines, no_provenance, unparseable, provenance_unread (its body
             could not be read)
           and every property of a ticket with a line once:
             edited, unchanged, filer_sourced, policy_sourced, unlinked (a
             line filed before calls existed), no_call, not_accepted,
             no_label, same_label
           and every ticket with a line once by how its line read
           (DND-1354; "provenance lines:", named per class below it):
             verbatim, recovered_<shape> (a paraphrase that kept all three
             values, each the filer's: abbreviated_json, prose_values; read
             as filer_sourced), unparseable_<reason> (malformed_json,
             lossy_paraphrase: it names a Jev judgment whose call is gone,
             unrecognized_prose)
           and every edited one once by what sending it came to:
             recorded, replaced, already_recorded, refused, not_sent (not
             tried after the sending stopped)
           Since DND-1470 it also reads each ticket's LAST "Jev path:" line.
           When its source is jev and the Path or Blocks edge was changed away
           from that decision, it records against the line's call, with a
           correction cand_<i>=blocks|does_not_block (i from the line's
           candidate_refs) per candidate the change contradicts. A new edge
           onto a candidate after the one Jev blocked contradicts nothing
           (Jev may have accepted blocks there too). A Critical or Promoted
           Path is authored: counted, never recorded. Every ticket is
           counted once on the ticket_blocking line:
             provenance_unread, no_path_line, unparseable, filer_sourced,
             rule_sourced, path_unset, authored_override, edges_unread (its
             Blocks edges could not be read), blocking_no_edge, unchanged,
             unlinked (a line filed before call existed), no_call,
             no_candidate_named, not_contradicted, edited
           The tickets behind unlinked, no_call, not_accepted, no_label,
           unparseable, provenance_unread and refused are named, and on the
           ticket_blocking line those behind its provenance_unread,
           unparseable, path_unset, edges_unread, blocking_no_edge,
           unlinked, no_call and no_candidate_named. The last line is
             complete: next_since <time>
           Save that as the next --since. A body or a Blocks edge that could
           not be read, a server that could not be reached (exit 3), or a
           correction the server refused as invalid (exit 4: the scan's
           labels are wrong) ends with
             INCOMPLETE (<reason>): keep the old --since
           and the failure line on stderr. The records it sent stand (the
           server keeps one per call and reporter). Any other refusal
           (not_found, not_judged, eval_call) is the server's answer for
           that call: named, and the scan is still complete.
           Environment (optional, tests): JUDGMENT_FEEDBACK_NOTION_API (a
           loopback URL), JUDGMENT_FEEDBACK_NOTION_PACE_S (seconds between
           Notion reads, default 0.4).

  Exit codes, each with its own first line on stderr carrying Fix::
    0  ok
    2  usage (nothing was sent): "judgment-feedback: <what>. Fix: ..."
    3  "COULD NOT REACH SERVER: ...", "SERVER FAILED: HTTP <status> ...",
       "UNREADABLE SERVER ANSWER: ..." or (scan-tickets) "COULD NOT READ
       NOTION: ..."
    4  "SERVER REFUSED: HTTP <status> <error>[ (field <f>)]. Fix: <server's fix>"
       (not_found, not_judged, eval_call, invalid), or (scan-tickets)
       "SERVER REFUSED: <n> correction(s) as invalid. Fix: ...". A refusal
       is a fact to report, not something to work around.

  The Athena server URL is the origin of the `athena` MCP entry in
  ~/.claude.json and its token is read from
  ~/.config/athena-inbox-client/config.json, fed to curl on stdin, never argv.
  Environment (optional): ATHENA_INBOX_CLIENT_CONFIG, FLEET_CLAUDE_JSON,
  JUDGMENT_FEEDBACK_MAX_TIME_S (per request, default 60).
EOF

USAGE_FIX = "run `judgment-feedback --help` for the forms"

# A failure that ends the run: exit `code`, printing `line` on stderr.
class Failure < StandardError
  attr_reader :code

  def initialize(code, line)
    super(line)
    @code = code
  end
end

def unexpected_line(error)
  "#{PROG}: UNEXPECTED ERROR: #{error.class}. Fix: this is a bug in #{PROG}; report it with the command you ran (never the note)."
end

# The failure's class: the capitalised words its line starts with.
def reason_of(line)
  line[/\A[A-Z][A-Z ]+[A-Z]/] || "UNEXPECTED ERROR"
end

def usage!(what, fix = USAGE_FIX)
  raise Failure.new(2, "#{PROG}: #{what}. Fix: #{fix}")
end

# ── EFFECTS ──────────────────────────────────────────────────────────────────

module Effects
  module_function

  def read_file(flag, path)
    usage!("#{flag} #{path} does not exist", "pass the path of an existing file") unless File.exist?(path)
    usage!("#{flag} #{path} is not a readable file", "check its permissions") unless File.file?(path) && File.readable?(path)
    File.read(path, encoding: "UTF-8").scrub
  end

  def endpoint
    AthenaServer.endpoint
  rescue AthenaServer::Unreachable => e
    raise Failure.new(3, JF.unreachable_line(e.message))
  end

  def max_time
    AthenaServer.max_time("JUDGMENT_FEEDBACK_MAX_TIME_S")
  end

  def post(origin, token, body)
    AthenaServer.post_json(origin, token, ROUTE, body, max_time: max_time)
  rescue AthenaServer::Unreachable, AthenaServer::UnsafeValue => e
    raise Failure.new(3, JF.unreachable_line(e.message))
  end

  def get(origin, token, query)
    AthenaServer.get_json(origin, token, "#{ROUTE}?#{URI.encode_www_form(query)}", max_time: max_time)
  rescue AthenaServer::Unreachable, AthenaServer::UnsafeValue => e
    raise Failure.new(3, JF.unreachable_line(e.message))
  end

  def now = Time.now.utc

  def append_line(path, line)
    File.open(path, "a", 0o600) { |f| f.puts(line) }
  rescue SystemCallError => e
    raise Failure.new(3, "#{PROG}: could not append to --recorded-file #{path}: #{e.class}. Fix: check that file is writable; the record itself was sent")
  end

  # write_cursor(path, next_since, err) -> exit code. The file is replaced
  # whole (a temp file renamed over it), so a reader never sees half a line.
  def write_cursor(path, next_since, err)
    tmp = "#{path}.tmp-#{Process.pid}"
    File.write(tmp, "#{next_since}\n")
    File.rename(tmp, path)
    0
  rescue SystemCallError => e
    begin
      File.delete(tmp)
    rescue SystemCallError
      nil
    end
    err.puts "#{PROG}: could not write --cursor-file #{path}: #{e.class}. Fix: check that its directory exists and is writable; " \
             "the scan was complete, so re-run it with the same --since"
    3
  end

  def notion_line(error)
    "COULD NOT READ NOTION: #{error.message}. Fix: #{error.fix}"
  end

  # The DND tracker, read only, through NotionRead (its allowlist refuses
  # anything but a read before it is sent).
  class Notion
    def initialize
      @origin, @token = NotionRead.credentials(ENV["JUDGMENT_FEEDBACK_NOTION_API"])
    rescue NotionRead::Error => e
      usage!(e.message.sub("the Notion API override", "JUDGMENT_FEEDBACK_NOTION_API"), e.fix) if e.message.start_with?("the Notion API override")
      raise Failure.new(3, Effects.notion_line(e))
    end

    def pace
      value = ENV["JUDGMENT_FEEDBACK_NOTION_PACE_S"].to_s
      /\A\d{1,2}(\.\d{1,3})?\z/.match?(value) ? value.to_f : 0.4
    end

    # edited_since(since) -> the tracker rows edited at or after `since`, or
    # Failure (a failed read is never an empty one).
    def edited_since(since)
      NotionRead.query_all(@origin, @token, TICKETS_DATA_SOURCE, pace: pace, filter: JFS.filter(since))
    rescue NotionRead::Error => e
      raise Failure.new(3, Effects.notion_line(e))
    end

    # body(page_id) -> the page's block texts, or nil when they could not be
    # read (the ticket is then counted provenance_unread).
    def body(page_id)
      NotionRead.children_all(@origin, @token, page_id, pace: pace).filter_map { |b| TriageCorpus.block_text(b) }
    rescue NotionRead::Error
      nil
    end

    # ref(page_id) -> the DND ref of a page (a Blocks target); "page:<id>"
    # for a page that was read but has no DND id (never a candidate); nil
    # only when it could not be read (DND-1470: the finding is then counted
    # edges_unread, never read as "no edge").
    def ref(page_id)
      ticket = TriageCorpus.ticket_from_row(NotionRead.page(@origin, @token, page_id, pace: pace))
      ticket ? ticket["ref"] : "page:#{page_id}"
    rescue NotionRead::Error
      nil
    end
  end
end

# ── MANAGER ──────────────────────────────────────────────────────────────────

module Manager
  module_function

  def record(opts, corrections, out)
    note = nil
    if opts["--note-file"]
      note = Effects.read_file("--note-file", opts["--note-file"]).sub(/\s+\z/, "")
      usage!("--note-file #{opts['--note-file']} is empty", "write the note into it, or leave --note-file out") if note.empty?
    end
    body = JF.record_body(call: opts["--call"], use_case: opts["--use-case"], subject: opts["--subject"],
                          corrections: corrections, signal: opts["--signal"], note: note,
                          session_label: opts["--session-label"])
    origin, token = Effects.endpoint
    resp = Effects.post(origin, token, body)
    failure = JF.http_failure(resp)
    raise Failure.new(*failure) if failure

    out.puts JF.recorded_line(resp[:body])
    0
  rescue JF::UnreadableAnswer => e
    raise Failure.new(3, JF.unreadable_line(e.message))
  end

  # list -> exit code. Rows read before a failure are still printed, then a
  # final line saying complete:false; the failure line goes to stderr.
  def list(opts, out, err)
    view = List.new(opts)
    rows, failure = view.read
    kept = rows.reject { |r| view.seen.include?(r["id"].downcase) }
    kept.each { |r| out.puts(opts["--json"] ? JSON.generate(JF.redact(r, opts["--with-payloads"])) : JF.row_line(r)) }
    deduped = rows.size - kept.size
    if failure
      err.puts failure[1]
      out.puts(opts["--json"] ? JSON.generate("next_cursor" => nil, "complete" => false, "rows" => kept.size, "deduped" => deduped, "reason" => reason_of(failure[1])) : "INCOMPLETE (#{reason_of(failure[1])}): #{kept.size} rows, #{deduped} deduped read before the failure; keep the old cursor.")
      return failure[0]
    end
    final = JF.final_cursor(view.start, rows)
    cursor = final && JF.encode(final)
    if opts["--json"]
      out.puts JSON.generate("next_cursor" => cursor, "complete" => true, "rows" => kept.size, "deduped" => deduped,
                             "seen_tail" => JF.seen_tail(rows, final, view.overlap))
    else
      out.puts "complete: #{kept.size} rows, #{deduped} deduped, next_cursor #{cursor || 'none'}"
    end
    0
  end

  # scan(opts, out, err) -> exit code (DND-1469; --help scan-tickets). Reads
  # the tracker first, then sends one record per new edit. Counts are printed
  # whatever happened; only a complete scan prints a next_since.
  def scan(opts, out, err)
    cursor_file = opts["--cursor-file"]
    since = JFS.parse_since(opts["--since"] || Scan.since_from(cursor_file))
    file = opts["--recorded-file"]
    recorded = file && File.exist?(file) ? JFS.recorded_keys(Effects.read_file("--recorded-file", file)) : Set.new
    started = Effects.now
    notion = Effects::Notion.new
    rows = notion.edited_since(since)
    tickets = Scan.tickets(rows).map { |t| Scan.with_body(t, notion.body(t["page_id"])) }
    tally = JFS.tally(tickets.map { |t| [t["ref"], JFS.ticket_verdict(t)] })
    refs = tickets.to_h { |t| [t["page_id"], t["ref"]] }
    paths = JFS.blocking_tally(tickets.map { |t| [t["ref"], JFS.blocking_verdict(t, Scan.edge_refs(t, notion, refs))] })
    sent = Scan.new(recorded, file).send_all(tally[:edits] + paths[:edits])
    view = Scan.view(since, rows.size, tickets.size, tally.merge(paths: paths), sent, started)
    Scan.print(view, opts["--json"], out)
    return Scan.incomplete(view, opts["--json"], out, err) unless view["complete"]

    cursor_file ? Effects.write_cursor(cursor_file, view["next_since"], err) : 0
  end

  # The scan's tracker reading, its records and its printed view.
  class Scan
    # since_from(cursor file or nil) -> the --since text it holds.
    def self.since_from(path)
      usage!("scan-tickets needs --since", "pass the previous run's next_since, or --cursor-file; on a first run, a time with a zone such as a day ago") unless path
      usage!("--cursor-file #{path} does not exist and no --since was given",
             "on a first run pass --since with a time with a zone (such as a day ago) beside --cursor-file; a complete scan then writes the file") unless File.exist?(path)
      Effects.read_file("--cursor-file", path).strip
    end

    def self.tickets(rows)
      tickets = rows.filter_map { |r| TriageCorpus.ticket_from_row(r) }
      missing = tickets.flat_map { |t| t["schema_missing"] + (t["path_select"] ? [] : ["Path"]) }.uniq.sort
      unless missing.empty?
        raise Failure.new(3, "COULD NOT READ NOTION: the tracker rows carry no select property #{missing.join(', ')}. " \
                             "Fix: the DND Tickets schema changed; update TriageCorpus.ticket_from_row and #{PROG}")
      end
      tickets.sort_by { |t| TriageCorpus.number(t["ref"]) }
    end

    def self.with_body(ticket, blocks)
      ticket.merge("body_read" => !blocks.nil?, "blocks_text" => blocks || [])
    end

    # edge_refs(ticket, notion, refs) -> the DND refs of the ticket's Blocks
    # edges when its Path verdict needs them (DND-1470), [] when it does
    # not, or nil when any could not be read: a truncated Blocks relation or
    # an unreadable target is never read as "no edge". `refs` maps the scan's
    # own rows by page id, so only an edge onto a ticket outside the scan
    # costs a read.
    def self.edge_refs(ticket, notion, refs)
      return [] unless JFS.edges_needed?(ticket)
      return nil if ticket["blocks_truncated"]

      found = ticket["blocks"].map { |id| refs.fetch(id) { refs[id] = notion.ref(id) } }
      found.include?(nil) ? nil : found
    end

    def initialize(recorded, file)
      @recorded = recorded
      @file = file
      @counts = JFS::RECORD_OUTCOMES.to_h { |r| [r, 0] }.merge("not_sent" => 0)
      @refused = []
      @invalid = 0
    end

    # send_all(edits) -> {counts:, refused:, failure:}. A refusal is the
    # server's answer for that call (counted, named); anything else that is
    # not a stored record stops the sending, and the rest count not_sent.
    # A refusal as `invalid` means this scan's correction label is not one
    # the question offers (our mapping is wrong), so it is a failure too,
    # after the sending: the cursor must not move past those edits.
    def send_all(edits)
      failure = nil
      edits.each do |ref, property, call, correction|
        if failure
          @counts["not_sent"] += 1
          next
        end
        @stored = false
        failure = send_one(ref, property, call, correction)
        @counts["not_sent"] += 1 if failure && !@stored
      end
      { counts: @counts, refused: @refused, failure: failure || invalid_failure }
    end

    def send_one(ref, property, call, correction)
      key = JFS.record_key(call, correction)
      if @recorded.include?(key)
        @counts["already_recorded"] += 1
        return nil
      end

      origin, token = (@endpoint ||= Effects.endpoint)
      body = JF.record_body(call: call, corrections: correction, signal: JFS::SIGNAL, session_label: JFS::SESSION_LABEL)
      resp = Effects.post(origin, token, body)
      failure = JF.http_failure(resp)
      return refuse(ref, property, failure[1]) if failure && failure[0] == 4
      return failure if failure

      @counts[JF.recorded_line(resp[:body]).start_with?("replaced") ? "replaced" : "recorded"] += 1
      @stored = true
      @recorded << key
      Effects.append_line(@file, key) if @file
      nil
    rescue Failure => e
      [e.code, e.message]
    rescue JF::UnreadableAnswer => e
      [3, JF.unreadable_line(e.message)]
    end

    def refuse(ref, property, line)
      error = line[/\ASERVER REFUSED: HTTP \d+ ([a-z_]+)/, 1] || "refused"
      @counts["refused"] += 1
      @invalid += 1 if error == "invalid"
      @refused << "#{ref} #{property} #{error}"
      nil
    end

    def invalid_failure
      return nil if @invalid.zero?

      [4, "SERVER REFUSED: #{@invalid} correction(s) as invalid. Fix: the scan's labels (JudgmentFeedbackScan.label, or " \
          "BLOCKS_LABEL / DOES_NOT_BLOCK_LABEL for a path correction) no longer match " \
          "the question set the call used (a new version?); update them, then re-run with the same --since"]
    end

    NAMED = %w[provenance_unread unparseable unlinked no_call not_accepted no_label].freeze

    def self.view(since, rows, tickets, tally, sent, started)
      failure = sent[:failure] || unread_failure(tally[:tickets]["provenance_unread"]) || edges_failure(tally[:paths][:counts]["edges_unread"])
      { "complete" => failure.nil?, "since" => JFS.iso(since), "next_since" => failure ? nil : JFS.iso(JFS.next_since(started)),
        "rows" => rows, "not_a_ticket" => rows - tickets, "tickets" => tally[:tickets], "properties" => tally[:properties],
        "ticket_blocking" => tally[:paths][:counts], "ticket_blocking_named" => tally[:paths][:refs],
        "provenance_lines" => tally[:lines], "provenance_named" => tally[:line_refs],
        "records" => sent[:counts], "named" => NAMED.to_h { |r| [r, tally[:refs].fetch(r, [])] }.reject { |_, v| v.empty? },
        "refused" => sent[:refused], "failure" => failure }.tap { |v| v["reason"] = reason_of(failure[1]) if failure }
    end

    def self.unread_failure(unread)
      return nil if unread.zero?

      [3, "COULD NOT READ NOTION: #{unread} ticket bodies could not be read. Fix: re-run with the same --since; a body that keeps failing is named under provenance_unread"]
    end

    def self.edges_failure(unread)
      return nil if unread.zero?

      [3, "COULD NOT READ NOTION: #{unread} findings' Blocks edges could not be read. Fix: re-run with the same --since; a finding that keeps failing is named under ticket_blocking edges_unread"]
    end

    def self.print(view, json, out)
      if json
        out.puts JSON.generate(view.except("failure"))
        return
      end
      line = ->(h) { h.map { |k, v| "#{k} #{v}" }.join(", ") }
      out.puts "scan-tickets: since #{view['since']}: #{view['rows']} rows edited (#{view['not_a_ticket']} without a DND id)"
      out.puts "tickets: #{line.call(view['tickets'])}"
      out.puts "properties: #{line.call(view['properties'])}"
      out.puts "provenance lines: #{view['provenance_lines'].empty? ? 'none read' : line.call(view['provenance_lines'])}"
      out.puts "ticket_blocking: #{line.call(view['ticket_blocking'])}"
      out.puts "records: #{line.call(view['records'])}"
      view["named"].each { |reason, refs| out.puts "  #{reason}: #{refs.join(', ')}" }
      view["provenance_named"].each { |klass, refs| out.puts "  provenance #{klass}: #{refs.join(', ')}" }
      view["ticket_blocking_named"].each { |reason, refs| out.puts "  ticket_blocking #{reason}: #{refs.join(', ')}" }
      view["refused"].each { |r| out.puts "  refused: #{r}" }
      out.puts "complete: next_since #{view['next_since']}" if view["complete"]
    end

    # incomplete -> the exit code, after saying why on stderr (with its Fix:)
    # and, without --json, on stdout (never a next_since). With --json the
    # one line already says complete:false and the reason.
    def self.incomplete(view, json, out, err)
      code, why = view["failure"]
      err.puts why
      out.puts "INCOMPLETE (#{view['reason']}): keep the old --since" unless json
      code
    end
  end

  # The read's inputs and its paging loop.
  class List
    attr_reader :start, :overlap, :seen

    def initialize(opts)
      @limit = opts.fetch("--limit", JF::DEFAULT_LIMIT)
      usage!("--limit must be 1 to #{JF::MAX_LIMIT}", "ask for 1 to #{JF::MAX_LIMIT} rows per page") unless (1..JF::MAX_LIMIT).cover?(@limit)
      @overlap = opts.fetch("--overlap-s", 0)
      usage!("--overlap-s must be 0 to #{JF::MAX_OVERLAP_S}", "a minute (60) is ample") unless (0..JF::MAX_OVERLAP_S).cover?(@overlap)
      @start = opts["--after"] && JF.parse_after(opts["--after"])
      @seen = opts["--seen-file"] ? JF.seen_ids(Effects.read_file("--seen-file", opts["--seen-file"])) : Set.new
    end

    # read -> [rows, nil] for a complete read, or [rows read so far, [exit, line]].
    def read
      rows = []
      origin, token = Effects.endpoint
      cur = @start && (@overlap.positive? ? JF.step_back(@start, @overlap) : @start)
      loop do
        page = fetch(origin, token, cur)
        rows.concat(page[:rows])
        return [rows, nil] unless page[:has_more]

        nxt = page[:next_cursor]
        raise JF::UnreadableAnswer, "has_more with no next_cursor" if nxt.nil?
        raise JF::UnreadableAnswer, "next_cursor did not advance past #{JF.encode(cur)}" if cur && !JF.after?(nxt, cur)

        cur = nxt
      end
    rescue Failure => e
      [rows, [e.code, e.message]]
    rescue JF::UnreadableAnswer => e
      [rows, [3, JF.unreadable_line(e.message)]]
    rescue StandardError => e
      [rows, [3, unexpected_line(e)]]
    end

    def fetch(origin, token, cur)
      query = cur ? [["after", JF.encode(cur)]] : []
      resp = Effects.get(origin, token, query + [["limit", @limit.to_s]])
      failure = JF.http_failure(resp)
      raise Failure.new(*failure) if failure

      JF.page(resp[:body], limit: @limit, after: cur)
    end
  end
end

# ── FRAMEWORK ────────────────────────────────────────────────────────────────

LIST_SPEC = { "--after" => :value, "--limit" => :integer, "--json" => :switch, "--overlap-s" => :integer,
              "--seen-file" => :value, "--with-payloads" => :switch }.freeze
RECORD_SPEC = { "--call" => :value, "--use-case" => :value, "--subject" => :value, "--signal" => :value,
                "--note-file" => :value, "--session-label" => :value }.freeze
SCAN_SPEC = { "--since" => :value, "--recorded-file" => :value, "--cursor-file" => :value, "--json" => :switch }.freeze

# split_corrections(argv) -> [the --correct values, the rest]. --correct is
# the one repeatable flag, so it is taken out before the strict parse.
def split_corrections(argv)
  values = []
  rest = []
  i = 0
  while i < argv.length
    if argv[i] == "--correct"
      value = argv[i + 1]
      usage!("--correct needs a value", "pass --correct <question>=<label>") if value.nil? || value.empty? || value.start_with?("-")
      values << value
      i += 2
    else
      rest << argv[i]
      i += 1
    end
  end
  [values, rest]
end

def main(argv, out, err)
  if argv.include?("--help")
    out.print USAGE
    return 0
  end
  command, *rest = argv
  case command
  when "record"
    pairs, rest = split_corrections(rest)
    Manager.record(StrictArgv.parse(rest, RECORD_SPEC), JF.corrections(pairs), out)
  when "list"
    Manager.list(StrictArgv.parse(rest, LIST_SPEC), out, err)
  when "scan-tickets"
    Manager.scan(StrictArgv.parse(rest, SCAN_SPEC), out, err)
  when nil
    usage!("no subcommand", "run `judgment-feedback record ...`, `list ...` or `scan-tickets ...`")
  else
    usage!("unknown subcommand #{command.start_with?('-') ? command : command.inspect}", "the subcommands are record, list and scan-tickets")
  end
rescue StrictArgv::UsageError, JF::UsageError, JFS::UsageError => e
  err.puts "#{PROG}: #{e.message}. Fix: #{USAGE_FIX}"
  2
rescue Failure => e
  err.puts e.message
  e.code
rescue StandardError => e
  err.puts unexpected_line(e)
  3
end

exit(main(ARGV, $stdout, $stderr)) if $PROGRAM_NAME == __FILE__
