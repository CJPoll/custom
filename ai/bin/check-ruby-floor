#!/usr/bin/ruby
# frozen_string_literal: true
#
# check-ruby-floor -- the harness runs on Ruby FLOOR (3.4) and nothing older,
# whatever directory a tool is started from, and every tracked Ruby file parses
# under FLOOR.
#
# WHY THIS EXISTS
#
# The harness's Ruby is 3.4: system ruby (/usr/bin/ruby -> ruby34, 3.4.10) on
# both the desktop and the laptop. Owner decision, Cody, 2026-09-27 ~11:00Z:
# "we want ruby 3.4, not 2.7" and "3.4 is our global default for harness and
# our projects". Two gaps let a harness tool run under something else:
#
#   1. A `#!/usr/bin/env ruby` shebang goes through PATH, and in an interactive
#      session PATH starts with asdf's shims. asdf picks the Ruby from the
#      CURRENT DIRECTORY's .tool-versions, and harness tools run with cwd in
#      other projects. Measured 2026-09-27 (DND-931): from ~/dev/shenron (pins
#      ruby 2.7.0, not installed) every such tool died with "No version is set
#      for command ruby"; from a directory pinning 2.7.8 it ran under 2.7.8.
#   2. Syntax newer than a machine's Ruby passes on the machine that has it.
#      DND-710's judgment-eval did exactly that while the desktop still pinned
#      2.7.8.
#
# (Before DND-931 this check enforced a 2.7 FLOOR, from d8885f80, written on an
# unratified coordinator rule. The owner reversed it the same day: 3.4.)
#
# WHAT IT ENFORCES
#
#   floor    FLOOR here must not be LOWER than the FLOOR that landed (origin/main
#            and merge-base, via ai/lib/landed.rb). Raising it is free.
#   shebang  every tracked Ruby-shebang file under ai/ (plus HARNESS_EXTRA) starts
#            with exactly HARNESS_SHEBANG, an absolute interpreter path that no
#            PATH or version-manager lookup can redirect. The rule is textual,
#            so both machines reach the same verdict.
#   runtime  HARNESS_SHEBANG, executed by the kernel from a scratch directory
#            pinning each of HOSTILE_PINS (.tool-versions and .ruby-version), with
#            ASDF_RUBY_VERSION / RBENV_VERSION / RUBYOPT / RUBYLIB scrubbed,
#            loads `json` (so the user gem dir's native extensions load under
#            it) and reports a Ruby at or above FLOOR. A shebang that does not
#            start, or crashes loading json, is a finding.
#   syntax   every tracked Ruby file parses under FLOOR, using the interpreter
#            the runtime probe found: `ruby -c` per file when its minor IS the
#            floor; Prism with `version: FLOOR` when it is newer (so 3.5-only
#            syntax still fails while the other machine runs 3.4).
#
# WHICH FILES
#
#   Every path `git ls-files --cached` lists (committed or staged), regular file,
#   not a symlink, that is Ruby by what it IS: extension .rb / .rake / .gemspec,
#   basename Gemfile or Rakefile, or a first line `#!...ruby` (`#! /usr/bin/env
#   ruby`, with a space, included: d8885f80's pattern missed that form, so ten
#   scripts/ and git-custom/ files were never read). The syntax pass
#   reads all of them. The shebang rule reads the Ruby-shebang files under ai/
#   and in HARNESS_EXTRA: scripts/ and git-custom/ are the owner's personal
#   utilities (ai/lib/harness_tools.rb SCOPE), and some load gems only an asdf
#   Ruby has.
#
# KNOWN LIMITS (named, not hidden)
#
#   * `ruby` invoked BY NAME from a shell script, or `ruby -e '...'`, still goes
#     through PATH and is not read. The repo's .tool-versions (`ruby system`)
#     covers such calls made with cwd inside this repo or a worktree of it.
#   * SYNTAX and interpreter only: a stdlib method a newer Ruby adds is not seen.
#   * The shebang, the pin and this file's enforcement are in the diff. Only
#     FLOOR is ratcheted against what landed; a diff that edits the ratchet
#     itself still defeats it (~/dev/custom/CLAUDE.md -> "A check's own bar must
#     not live in the diff it is checking").
#
# There is no suppression marker: a marker is writable by the diff it would
# excuse.
#
# Deliberately gem-free (stdlib only; prism is a default gem from 3.3).

require "open3"
require "tmpdir"
require "fileutils"
require_relative "../lib/landed"

REPO = File.expand_path("../..", __dir__)
SELF_REL = "ai/bin/check-ruby-floor"

# The harness Ruby floor. Ratcheted: a diff may raise it, never lower it.
FLOOR = "3.4"

# The one shebang a harness Ruby executable may carry. Absolute, so neither
# PATH nor asdf's per-directory pin can pick another Ruby.
HARNESS_SHEBANG = "#!/usr/bin/ruby"

# Harness Ruby executables outside ai/ (owner-run installers of harness state).
HARNESS_EXTRA = %w[scripts/setup-inbox-registry].freeze

# The versions the runtime probe's scratch directories pin, each a Ruby
# asdf/rbenv would select there if they were consulted. Measured 2026-09-27:
#   2.7.8  an old Ruby (~/dev/shenron pins 2.7.0): env-ruby tools ran under it,
#          or died "No version is set" where it was not installed (DND-931).
#   3.4.7  a SAME-minor asdf Ruby (navigator, beryl, browser pin it): it shares
#          the user gem dir ~/.gem/ruby/3.4.0 with system ruby 3.4.10, whose
#          json-2.18.0 ext is linked to /usr/lib64/libruby34.so, so every
#          `require "json"` died with "linked to incompatible" (DND-958).
HOSTILE_PINS = %w[2.7.8 3.4.7].freeze

# Variables that override a version manager's per-directory choice. A probe
# with one set would measure the override, not the shebang.
SCRUB_ENV = %w[ASDF_RUBY_VERSION RBENV_VERSION RUBYOPT RUBYLIB].freeze

PROBE_TIMEOUT = 30

FLOOR_LINE = /^FLOOR = "(\d+\.\d+)"$/.freeze

USAGE = <<~TXT.freeze
  Usage:
    ai/bin/check-ruby-floor              check the harness Ruby floor (#{FLOOR}):
                                         the landed floor is not lowered, every
                                         harness Ruby executable starts with
                                         #{HARNESS_SHEBANG}, that interpreter is
                                         #{FLOOR}+ and loads json from directories
                                         pinning ruby #{HOSTILE_PINS.join(' / ')},
                                         and every tracked Ruby file parses under
                                         #{FLOOR}
    ai/bin/check-ruby-floor --self-test  deterministic, hermetic suite
                                         (throwaway git repos only)
    ai/bin/check-ruby-floor --help       this text

  Exit 0 = all of the above hold. Exit 1 = at least one does not (each named),
  or discovery found no Ruby file. Exit 2 = usage error. Exit 3 = could not
  measure (no git, the landed floor unreadable, or no way to parse under
  #{FLOOR}); never a pass.
TXT

class MeasureError < StandardError; end

# --- versions ----------------------------------------------------------------

def minor_of(version)
  version.to_s.split(".").first(2).map(&:to_i)
end

def below?(version, floor)
  (minor_of(version) <=> minor_of(floor)).negative?
end

# The FLOOR a text of this file declares, or nil.
def parse_floor(text)
  text.to_s[FLOOR_LINE, 1]
end

# The highest landed FLOOR, or nil when this file had not landed at any point.
# Raises Landed::Unreadable / Landed::Mismatch.
def landed_floor(root)
  pts, bars = Landed.read_bar(root, SELF_REL) do |text, label, sha|
    parse_floor(text) or raise Landed::Unreadable.new(
      [[label, "#{sha[0, 12]}: landed #{SELF_REL} has no `FLOOR = \"x.y\"` line"]]
    )
  end
  [pts, bars.max_by { |v| minor_of(v) }]
end

# --- discovery ---------------------------------------------------------------

RUBY_EXT = /\.(?:rb|rake|gemspec)\z/.freeze
RUBY_NAMES = %w[Gemfile Rakefile].freeze
RUBY_SHEBANG = %r{\A#!\s*\S*(?:/|\s)(?:env\s+(?:-\S+\s+)*)?ruby[\d.]*(?:\s|\z)}.freeze

def ruby_file?(path, first_line)
  return true if path =~ RUBY_EXT || RUBY_NAMES.include?(File.basename(path))

  first_line.to_s =~ RUBY_SHEBANG ? true : false
end

def first_line(abs)
  File.open(abs, "rb") { |f| f.gets.to_s }.scrub
end

def discover(root)
  out, err, status = Open3.capture3("git", "-C", root, "ls-files", "--cached", "-z")
  raise MeasureError, "git -C #{root} ls-files failed: #{err.strip}" unless status.success?

  out.split("\0").uniq.sort.select do |rel|
    abs = File.join(root, rel)
    next false if File.symlink?(abs) || !File.file?(abs)

    ruby_file?(rel, first_line(abs))
  end
rescue Errno::ENOENT
  raise MeasureError, "git executable not found on PATH"
end

# The harness Ruby executables among files: a Ruby shebang, under ai/ or named
# in HARNESS_EXTRA.
def harness_executables(root, files)
  files.select do |rel|
    next false unless rel.start_with?("ai/") || HARNESS_EXTRA.include?(rel)

    first_line(File.join(root, rel)) =~ RUBY_SHEBANG
  end
end

# -> [[rel, 1, message]] for every harness executable not on HARNESS_SHEBANG.
def shebang_findings(root, files, shebang)
  harness_executables(root, files).filter_map do |rel|
    line = first_line(File.join(root, rel)).chomp
    next if line == shebang

    [rel, 1, "shebang `#{line}` is not the harness shebang `#{shebang}` (shebang)"]
  end
end

# --- runtime probe -------------------------------------------------------------

# Runs cmd in dir with env, killing its process group after timeout seconds.
# -> [stdout, stderr, status or nil on timeout]
def run_in(env, cmd, dir, timeout = PROBE_TIMEOUT)
  Open3.popen3(env, *cmd, chdir: dir, pgroup: true) do |stdin, out, err, wait|
    stdin.close
    readers = [Thread.new { out.read }, Thread.new { err.read }]
    status = wait.join(timeout)&.value
    unless status
      begin
        Process.kill("KILL", -wait.pid)
      rescue Errno::ESRCH
        nil
      end
      wait.join
    end
    [readers[0].value, readers[1].value, status]
  end
end

# A scratch directory that pins ruby `pin` for asdf and rbenv alike.
def hostile_dir(pin)
  dir = Dir.mktmpdir("check-ruby-floor-pin-")
  File.write(File.join(dir, ".tool-versions"), "ruby #{pin}\n")
  File.write(File.join(dir, ".ruby-version"), "#{pin}\n")
  dir
end

# What the probe runs: load json (a native extension from the user gem dir
# when one is installed there), then report the interpreter.
PROBE_BODY = "require \"json\"\nprint RUBY_VERSION, \"\\n\", RbConfig.ruby, \"\\n\"\n"

def probe_env(path_prefix)
  env = SCRUB_ENV.to_h { |k| [k, nil] }
  env["PATH"] = [path_prefix, ENV["PATH"]].compact.join(":") if path_prefix
  env
end

# Executes a script starting with shebang, from a directory pinning ruby pin.
# -> { ok: true, version:, ruby: } or { ok: false, why: }
def probe(shebang, pin, path_prefix = nil, body = PROBE_BODY)
  dir = hostile_dir(pin)
  script = File.join(dir, "probe")
  File.write(script, "#{shebang}\n#{body}")
  File.chmod(0o755, script)
  out, err, status = run_in(probe_env(path_prefix), [script], dir)
  return { ok: false, why: "did not finish within #{PROBE_TIMEOUT}s" } unless status
  unless status.success?
    return { ok: false, why: "exited #{status.exitstatus.inspect}: #{err.strip.lines.first.to_s.strip}" }
  end

  version, ruby = out.lines.map(&:strip)
  return { ok: false, why: "printed no Ruby version (#{out.strip[0, 80].inspect})" } unless version =~ /\A\d+\.\d+/

  { ok: true, version: version, ruby: ruby }
rescue SystemCallError => e
  { ok: false, why: "could not be executed (#{e.class}: #{e.message})" }
ensure
  FileUtils.rm_rf(dir) if dir
end

# -> [[rel, 1, message]] (empty when the probe reports FLOOR or newer)
def runtime_findings(result, shebang, floor, pin)
  where = "run from a directory pinning ruby #{pin}"
  return [[shebang, 1, "the harness shebang, #{where}, #{result[:why]} (runtime)"]] unless result[:ok]
  return [] unless below?(result[:version], floor)

  [[shebang, 1, "the harness shebang, #{where}, runs ruby #{result[:version]} " \
                "(#{result[:ruby]}), below the floor #{floor} (runtime)"]]
end

# --- syntax -----------------------------------------------------------------

# How to parse under floor with the interpreter ruby_version.
# -> :exact (`ruby -c`), :prism (Prism, version: floor), or nil (older).
def syntax_mode(ruby_version, floor)
  cmp = minor_of(ruby_version) <=> minor_of(floor)
  return :exact if cmp.zero?
  return :prism if cmp.positive?

  nil
end

# Runs inside the resolved interpreter: ARGV = [floor, root, rel...]. Prints one
# `rel\tline\tmessage` per file Prism rejects at that version.
PRISM_SCRIPT = <<~'RUBY'
  require "prism"
  floor, root, *rels = ARGV
  rels.each do |rel|
    src = File.binread(File.join(root, rel)).force_encoding("UTF-8")
    result = Prism.parse(src, version: "#{floor}.0")
    next if result.errors.empty?

    err = result.errors.first
    puts [rel, err.location.start_line, err.message.tr("\t\n", "  ")].join("\t")
  end
RUBY

# -> [[rel, line, message]]
def syntax_findings(root, files, ruby, ruby_version, floor)
  case syntax_mode(ruby_version, floor)
  when :exact
    files.filter_map do |rel|
      _out, err, status = run_in(probe_env(nil), [ruby, "-c", rel], root)
      raise MeasureError, "`#{ruby} -c #{rel}` did not finish within #{PROBE_TIMEOUT}s" unless status
      next if status.success?

      msg = err.lines.find { |l| l.include?(rel) } || err.lines.first
      line = msg.to_s[/:(\d+):/, 1].to_i
      [rel, line, "does not parse under ruby #{ruby_version} (`ruby -c`): " \
                  "#{msg.to_s.sub(/\A.*?:\d+:\s*/, '').strip} (syntax)"]
    end
  when :prism
    out, err, status = run_in(probe_env(nil), [ruby, "-e", PRISM_SCRIPT, floor, root, *files], root)
    unless status&.success?
      raise MeasureError, "Prism under #{ruby} (#{ruby_version}) could not parse at version #{floor}: " \
                          "#{err.strip.lines.first.to_s.strip}"
    end
    out.lines.map do |row|
      rel, line, msg = row.chomp.split("\t", 3)
      [rel, line.to_i, "does not parse as Ruby #{floor} (Prism, host ruby #{ruby_version}): #{msg} (syntax)"]
    end
  else
    raise MeasureError, "the resolved harness ruby #{ruby_version} is older than #{floor}, " \
                        "so nothing can parse under #{floor}"
  end
end

# --- the check ----------------------------------------------------------------

FIXES = {
  "floor" => "FLOOR is ratcheted: it may rise, never fall. Restore the landed value. " \
             "Lowering it is the owner's call, landed on main by the owner.",
  "shebang" => "make the first line exactly `#{HARNESS_SHEBANG}`. `#!/usr/bin/env ruby` goes " \
               "through PATH, where asdf picks the Ruby from the CURRENT directory's " \
               ".tool-versions (e.g. ~/dev/shenron pins 2.7.0).",
  "runtime" => "the harness Ruby is system ruby #{FLOOR}+ at #{HARNESS_SHEBANG.delete_prefix('#!')}, " \
               "the Ruby that built the user gem dir's native extensions. On Gentoo that path is " \
               "an eselect symlink, so `eselect ruby set` to an older Ruby moves the whole harness " \
               "with no other signal; this finding is that signal. Where the path is missing, " \
               "older than #{FLOOR}, or cannot load json, restoring it is an OWNER step on the " \
               "system (e.g. `sudo eselect ruby set ruby34`, or installing Ruby #{FLOOR}); an " \
               "agent reports it and does not run it. Do not change the shebang to route around " \
               "it (no Gentoo-specific /usr/bin/ruby34), and do not edit ~/.gem.",
  "syntax" => "rewrite the named site so Ruby #{FLOOR} parses it (both machines run " \
              "#{FLOOR}). There is no suppression marker."
}.freeze

def emit_findings(findings, context)
  warn "check-ruby-floor: #{findings.length} finding(s) against the harness Ruby floor " \
       "#{FLOOR} (#{context}):"
  findings.each { |rel, line, msg| warn "  #{rel}:#{line}: #{msg}" }
  kinds = findings.map { |_r, _l, msg| msg[/\((\w+)\)\z/, 1] }.compact.uniq
  # Each advice line carries the literal `Fix:` marker (~/dev/custom/CLAUDE.md ->
  # "Guard/error messages are written for the LLM").
  kinds.each { |k| warn "  Fix: (#{k}) #{FIXES.fetch(k)}" }
end

def could_not_measure(lines)
  warn "check-ruby-floor: COULD NOT MEASURE -- this is not a pass."
  lines.each { |l| warn l }
  3
end

# opts (all optional, for the self-test):
#   landed:      -> [points, floor or nil]; default reads origin via Landed
#   floor:       this tree's floor; default FLOOR
#   shebang:     the shebang to probe; default HARNESS_SHEBANG
#   path_prefix: prepended to PATH for the runtime probe
#   pins:        the versions to probe from; default HOSTILE_PINS
# -> exit code
def run_check(root = REPO, opts = {})
  floor = opts.fetch(:floor, FLOOR)
  shebang = opts.fetch(:shebang, HARNESS_SHEBANG)
  findings = []

  begin
    pts, landed = opts.key?(:landed) ? opts[:landed].call : landed_floor(root)
  rescue Landed::Unreadable => e
    return could_not_measure(Landed.unreadable_lines("Ruby floor", e.probes))
  rescue Landed::Mismatch => e
    return could_not_measure(Landed.mismatch_lines(e.local, e.remote, e.source))
  end
  if landed && below?(floor, landed)
    findings << [SELF_REL, 1, "FLOOR #{floor} is lower than the landed floor #{landed} " \
                              "(#{Landed.describe(pts)}) (floor)"]
  end

  files = discover(root)
  if files.empty?
    warn "check-ruby-floor: FOUND NOTHING -- git lists no tracked Ruby file under #{root}."
    warn "  Fix: this repo has Ruby files, so an empty set means discovery broke " \
         "(wrong root, or the RUBY_EXT/RUBY_SHEBANG rules). Check `git -C #{root} " \
         "ls-files` and the rules in #{__FILE__}."
    return 1
  end
  harness = harness_executables(root, files)
  findings.concat(shebang_findings(root, files, shebang))

  pins = opts.fetch(:pins, HOSTILE_PINS)
  results = pins.map { |pin| [pin, probe(shebang, pin, opts[:path_prefix])] }
  results.each { |pin, result| findings.concat(runtime_findings(result, shebang, floor, pin)) }

  # Parse under the OLDEST Ruby the shebang gave, and only when every probe
  # gave a floor-or-newer one.
  good = results.map(&:last).select { |r| r[:ok] && !below?(r[:version], floor) }
  syntax_note = "syntax not read: the harness shebang did not give a #{floor}+ ruby from every pinned directory"
  if good.length == results.length
    oldest = good.min_by { |r| r[:version].split(".").map(&:to_i) }
    findings.concat(syntax_findings(root, files, oldest[:ruby], oldest[:version], floor))
    syntax_note = "syntax mode #{syntax_mode(oldest[:version], floor)} under #{oldest[:ruby]} #{oldest[:version]}"
  end

  context = "#{files.length} Ruby file(s), #{harness.length} harness executable(s); #{syntax_note}"
  if findings.empty?
    seen = results.map { |pin, r| "ruby-#{pin} dir -> #{r[:version]}" }.join(", ")
    puts "check-ruby-floor: OK -- floor #{floor} (landed: #{landed || 'none yet'}); " \
         "#{harness.length} harness executable(s) on #{shebang}, which loads json and runs " \
         "#{seen}; #{files.length} Ruby file(s) parse under #{floor} (#{syntax_note})."
    return 0
  end

  emit_findings(findings, context)
  1
rescue MeasureError => e
  could_not_measure(["  #{e.message}.",
                     "  Fix: run from inside the custom repo with git on PATH and system " \
                     "ruby #{FLOOR}+ at #{HARNESS_SHEBANG.delete_prefix('#!')}."])
end

# --- self-test ---------------------------------------------------------------

def git!(dir, *args)
  _out, err, status = Open3.capture3("git", "-C", dir, *args)
  raise "git #{args.join(' ')} failed: #{err}" unless status.success?
end

def fixture_repo(files, untracked = {})
  dir = Dir.mktmpdir("check-ruby-floor-")
  git!(dir, "init", "-q")
  write = lambda do |rel, body|
    path = File.join(dir, rel)
    FileUtils.mkdir_p(File.dirname(path))
    File.write(path, body)
    File.chmod(0o755, path) if body.start_with?("#!")
  end
  files.each { |rel, body| write.call(rel, body) }
  git!(dir, "add", "--", *files.keys) unless files.empty?
  untracked.each { |rel, body| write.call(rel, body) }
  dir
end

# Run run_check against a fixture, capturing both streams.
def check_fixture(dir, opts = {})
  opts = { landed: -> { [[["fixture", "0" * 40]], nil] } }.merge(opts)
  r_out, w_out = IO.pipe
  r_err, w_err = IO.pipe
  saved_out = $stdout.dup
  saved_err = $stderr.dup
  $stdout.reopen(w_out)
  $stderr.reopen(w_err)
  code = run_check(dir, opts)
  [code, nil]
ensure
  $stdout.reopen(saved_out)
  $stderr.reopen(saved_err)
  w_out.close
  w_err.close
  text = r_out.read + r_err.read
  r_out.close
  r_err.close
  return [code, text]
end

# A stand-in for a version manager's `ruby` shim: it honours the CURRENT
# directory's pin, exactly the behaviour that broke the harness from
# ~/dev/shenron (2.7.x) and ~/dev/browser (3.4.7). It prints what the probe
# prints, so the probe reads the pinned version; under a 3.4.7 pin it fails the
# way asdf 3.4.7 fails loading the user gem dir's json ext (DND-958).
def fake_shim_dir
  dir = Dir.mktmpdir("check-ruby-floor-shim-")
  File.write(File.join(dir, "ruby"), <<~SH)
    #!/bin/sh
    v="$(sed -n 's/^ruby //p' .tool-versions 2>/dev/null)"
    if [ "${v}" = "3.4.7" ]; then
      echo "json/ext/parser.so: linked to incompatible libruby (LoadError) (fake shim)" >&2
      exit 1
    fi
    printf '%s\\n%s\\n' "${v:-3.4.0}" "$0 (fake shim honouring $(pwd)/.tool-versions)"
  SH
  File.chmod(0o755, File.join(dir, "ruby"))
  dir
end

GOOD_TOOL = "#{HARNESS_SHEBANG}\nputs 1\n".freeze

def run_self_test
  fails = 0
  report = lambda do |ok, name, detail = nil|
    if ok
      puts "PASS #{name}"
    else
      fails += 1
      puts "FAIL #{name}#{detail ? " -- #{detail}" : ''}"
    end
  end
  dirs = []
  shim = fake_shim_dir
  dirs << shim

  # Pure helpers.
  report.call(syntax_mode("3.4.10", "3.4") == :exact, "syntax mode: 3.4 host is exact (`ruby -c`)")
  report.call(syntax_mode("3.5.0", "3.4") == :prism, "syntax mode: newer host is Prism at the floor")
  report.call(syntax_mode("2.7.8", "3.4").nil?, "syntax mode: older host cannot parse under the floor")
  report.call(below?("2.7.8", "3.4") && below?("3.3.0", "3.4") && !below?("3.4.10", "3.4") &&
              !below?("3.10.0", "3.4"), "below?: compares minor versions numerically")
  report.call(parse_floor(File.read(__FILE__)) == FLOOR && parse_floor("FLOOR = \"2.7\"\n") == "2.7" &&
              parse_floor("x = 1\n").nil?, "parse_floor reads the FLOOR line, nil when absent")

  # A tree on the harness shebang with 3.4 syntax passes.
  d = fixture_repo("ai/bin/tool" => "#{HARNESS_SHEBANG}\ndef a(x) = x + 1\n[1].map { it }\n",
                   "ai/lib/x.rb" => "h = { a: 1 }\nh => { a: }\n")
  dirs << d
  code, text = check_fixture(d)
  report.call(code.zero? && text.include?("OK --") && text.include?("1 harness executable(s)"),
              "3.4 syntax on the harness shebang passes", "code=#{code} #{text[0, 400]}")

  # THE REGRESSION (DND-931): a bare `#!/usr/bin/env ruby` harness tool, from a
  # directory pinning an old Ruby, with a cwd-honouring shim first on PATH.
  # The shim models both measured failures: the 2.7.8 pin runs an old Ruby, the
  # 3.4.7 pin dies loading a foreign-ABI json extension.
  d = fixture_repo("ai/bin/tool" => "#!/usr/bin/env ruby\nputs 1\n")
  dirs << d
  code, text = check_fixture(d, shebang: "#!/usr/bin/env ruby", path_prefix: shim)
  report.call(code == 1 && text.include?("pinning ruby 2.7.8, runs ruby 2.7.8") &&
              text.include?("Fix: (runtime)"),
              "runtime: an env-ruby shebang resolves a 2.7.8 pin and is flagged",
              "code=#{code} #{text[0, 700]}")
  report.call(code == 1 && text.include?("pinning ruby 3.4.7, exited 1") &&
              text.include?("linked to incompatible"),
              "runtime: an env-ruby shebang that cannot load json under a 3.4.7 pin is flagged",
              "code=#{code} #{text[0, 700]}")
  # ... and the same shim does not reach the harness shebang.
  d = fixture_repo("ai/bin/tool" => GOOD_TOOL)
  dirs << d
  code, text = check_fixture(d, path_prefix: shim)
  report.call(code.zero?, "runtime: the harness shebang ignores the cwd-honouring shim",
              "code=#{code} #{text[0, 400]}")

  # An inherited override must not mask the pin: the probe scrubs it.
  saved = ENV["ASDF_RUBY_VERSION"]
  begin
    ENV["ASDF_RUBY_VERSION"] = "system"
    env_seen = probe("#!/bin/sh", "2.7.8", nil, "echo \"${ASDF_RUBY_VERSION:-unset}\"; echo x; exit 0\n")
  ensure
    ENV["ASDF_RUBY_VERSION"] = saved
  end
  report.call(!env_seen[:ok] && env_seen[:why].include?("unset"),
              "runtime: the probe scrubs ASDF_RUBY_VERSION", env_seen.inspect)

  # A shebang that cannot start is a finding, not a pass.
  d = fixture_repo("ai/bin/tool" => "#!/nonexistent/ruby\nputs 1\n")
  dirs << d
  code, text = check_fixture(d, shebang: "#!/nonexistent/ruby")
  report.call(code == 1 && text.include?("could not be executed") && text.include?("Fix: (runtime)"),
              "runtime: a missing interpreter is flagged", "code=#{code} #{text[0, 400]}")

  # /usr/bin/ruby follows eselect: a harness interpreter re-pointed to an older
  # Ruby (here a stand-in reporting 3.3.9) is flagged, and the Fix names the
  # owner's system step.
  old = File.join(shim, "ruby33")
  File.write(old, "#!/bin/sh\nprintf '3.3.9\\n/usr/bin/ruby33\\n'\n")
  File.chmod(0o755, old)
  d = fixture_repo("ai/bin/tool" => "#!#{old}\nputs 1\n")
  dirs << d
  code, text = check_fixture(d, shebang: "#!#{old}")
  report.call(code == 1 && text.include?("runs ruby 3.3.9") && text.include?("below the floor #{FLOOR}") &&
              text.include?("eselect ruby set") && text.include?("OWNER step"),
              "runtime: a harness interpreter re-pointed below the floor is flagged, Fix names the owner step",
              "code=#{code} #{text[0, 700]}")

  # Shebang rule: an env-ruby harness tool is flagged by text on any machine;
  # a personal script outside ai/ is not; HARNESS_EXTRA is.
  d = fixture_repo("ai/bin/bad" => "#!/usr/bin/env ruby\nputs 1\n",
                   "ai/skills/s/bin/bad2" => "#! /usr/bin/env ruby\nputs 1\n",
                   "scripts/personal" => "#!/usr/bin/env ruby\nputs 1\n",
                   HARNESS_EXTRA.first => "#!/usr/bin/env ruby\nputs 1\n",
                   "ai/bin/ok" => GOOD_TOOL)
  dirs << d
  code, text = check_fixture(d)
  report.call(code == 1 && text.include?("ai/bin/bad:1:") && text.include?("ai/skills/s/bin/bad2:1:") &&
              text.include?("#{HARNESS_EXTRA.first}:1:") && !text.include?("scripts/personal") &&
              !text.include?("ai/bin/ok:") && text.include?("Fix: (shebang)"),
              "shebang: env-ruby harness tools flagged, personal scripts not", "code=#{code} #{text[0, 600]}")

  # Syntax: something 3.4 cannot parse fails, naming file:line.
  d = fixture_repo("ai/lib/broken.rb" => "x = 1\ndef a(\n", "ai/bin/ok" => GOOD_TOOL)
  dirs << d
  code, text = check_fixture(d)
  report.call(code == 1 && text.include?("ai/lib/broken.rb:") && text.include?("(syntax)") &&
              text.include?("Fix: (syntax)"), "syntax: an unparseable file fails", "code=#{code} #{text[0, 400]}")

  # Discovery: a ruby-shebang file with no .rb is read; untracked is not.
  d = fixture_repo({ "tools/t" => "#!/usr/bin/env ruby\ndef a(\n", "ai/bin/ok" => GOOD_TOOL },
                   "scratch.rb" => "def a(\n")
  dirs << d
  code, text = check_fixture(d)
  report.call(code == 1 && text.include?("tools/t:") && !text.include?("scratch.rb"),
              "discovery: ruby shebang read; untracked file not", "code=#{code} #{text[0, 400]}")

  # Floor ratchet: lowering fails, equal or new passes, unreadable is exit 3.
  d = fixture_repo("ai/bin/ok" => GOOD_TOOL)
  dirs << d
  pts = [["origin/main (tip)", "a" * 40]]
  code, text = check_fixture(d, landed: -> { [pts, "3.5"] })
  report.call(code == 1 && text.include?("lower than the landed floor 3.5") && text.include?("Fix: (floor)"),
              "floor: lower than landed fails", "code=#{code} #{text[0, 400]}")
  code, = check_fixture(d, landed: -> { [pts, "2.7"] })
  report.call(code.zero?, "floor: raising it above the landed 2.7 passes")
  code, text = check_fixture(d, landed: -> { raise Landed::Unreadable.new([["refs/remotes/origin/main", "no such ref"]]) })
  report.call(code == 3 && text.include?("COULD NOT MEASURE") && text.include?("Fix:"),
              "floor: an unreadable landed bar is exit 3, not a pass", "code=#{code} #{text[0, 400]}")

  # found-nothing is a failure, distinct from could-not-measure.
  d = fixture_repo("README.md" => "hi\n")
  dirs << d
  code, text = check_fixture(d)
  report.call(code == 1 && text.include?("FOUND NOTHING") && text.include?("Fix:"),
              "no Ruby file: exit 1, FOUND NOTHING, Fix:", "code=#{code} #{text[0, 200]}")

  # End to end on a REAL tool: this file, run from a directory pinning an old
  # Ruby with a cwd-honouring shim first on PATH, runs on the floor.
  # RUBYOPT=-r<file> makes whichever real Ruby starts report its version from
  # inside the tool's own process.
  # Each pin runs twice: with the fake shim first on PATH (deterministic on any
  # machine), and with this machine's real PATH (its real asdf shims and user
  # gem dir, where the DND-931/DND-958 failures were measured). `-rjson` loads
  # json the way critic-review does.
  HOSTILE_PINS.each do |pin_version|
    pin = hostile_dir(pin_version)
    dirs << pin
    reporter = File.join(pin, "report_version.rb")
    File.write(reporter, "$stderr.puts \"RUBY_UNDER_TEST=\#{RUBY_VERSION}\"\n")
    [["fake shim", shim], ["real PATH", nil]].each do |label, prefix|
      env = probe_env(prefix).merge("RUBYOPT" => "-rjson -r#{reporter}")
      out, err, status = run_in(env, [File.expand_path(__FILE__), "--help"], pin)
      seen = err[/RUBY_UNDER_TEST=(\S+)/, 1]
      report.call(status&.success? && out.include?("Usage:") && !out.include?("fake shim") &&
                  seen && !below?(seen, FLOOR),
                  "end to end (#{label}): #{SELF_REL} from a ruby-#{pin_version}-pinned dir loads json " \
                  "and runs under ruby #{seen.inspect} (>= #{FLOOR})",
                  "status=#{status.inspect} out=#{out[0, 200]} err=#{err[0, 300]}")
    end
  end

  if fails.zero?
    puts "check-ruby-floor self-test: OK"
    0
  else
    puts "check-ruby-floor self-test: #{fails} failure(s)"
    puts "  Fix: a case above changed verdict; re-check the probe, the shebang rule, " \
         "the ratchet, or the syntax pass before shipping."
    1
  end
ensure
  (dirs || []).each { |dir| FileUtils.rm_rf(dir) }
end

# --- CLI ---------------------------------------------------------------------

if ARGV.include?("--help") || ARGV.include?("-h")
  puts USAGE
  exit 0
end
require_relative "../lib/strict_argv"

# An argument this tool does not recognise must never fall through to the live
# check (DND-813): every argument must be a declared flag.
CLI_SPEC = { "--self-test" => :switch }.freeze

def parse_cli(argv)
  [StrictArgv.parse(argv, CLI_SPEC), nil]
rescue StrictArgv::UsageError => e
  [nil, e.message]
end

cli, reason = parse_cli(ARGV)
if reason
  warn "check-ruby-floor: usage error -- #{reason}."
  warn "  Fix: re-run with only the flags `ai/bin/check-ruby-floor --help` lists: no " \
       "argument (the live check) or --self-test. An unrecognised argument is " \
       "refused, not ignored."
  exit 2
end

exit(cli["--self-test"] ? run_self_test : run_check)
