#!/usr/bin/env bash
# glab (agent wrapper) — the agent-session PATH front of the real glab (DND-1803).
#
# A forge write on plain glab, typed or inside a script, is refused with a Fix:
# naming ~/dev/custom/ai/bin/glab-athena; reads and calls made through glab-athena pass
# through to the real glab. `glab --help` prints the real help, then a note.
# Everything is ai/lib/agent-forge-cli.sh: where this runs, how it decides,
# and what it cannot see.
AFC_TOOL=glab
AFC_SELF=$0
_afc_lib="$(dirname "$(readlink -f "$0" 2>/dev/null || printf '%s' "$0")")/../lib/agent-forge-cli.sh"
# shellcheck source=../lib/agent-forge-cli.sh
if ! . "$_afc_lib" 2>/dev/null || ! declare -F afc_main >/dev/null; then
  printf 'glab (agent wrapper): REFUSED `glab %s`: cannot load %s, so whether this is a forge write is unknown. Fix: restore ai/lib/agent-forge-cli.sh in the checkout that holds ai/agent-bin; meanwhile run the command through ~/dev/custom/ai/bin/glab-athena.\n' "$*" "$_afc_lib" >&2
  exit 1
fi
afc_main "$@"
