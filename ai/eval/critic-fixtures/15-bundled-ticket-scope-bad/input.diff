--- a/lib/billing/proration.ex
+++ b/lib/billing/proration.ex
@@ -20,3 +20,7 @@ defmodule Billing.Proration do
   end
+
+  def elapsed_days(%Period{starts_on: starts_on}, today) do
+    max(Date.diff(today, starts_on), 0)
+  end
 end
--- a/test/billing/proration_test.exs
+++ b/test/billing/proration_test.exs
@@ -30,3 +30,8 @@ defmodule Billing.ProrationTest do
     assert Proration.remaining_days(period, ~D[2026-01-10]) == 5
   end
+
+  test "elapsed_days counts days since the period started" do
+    period = %Period{starts_on: ~D[2026-01-01]}
+    assert Proration.elapsed_days(period, ~D[2026-01-04]) == 3
+  end
 end
