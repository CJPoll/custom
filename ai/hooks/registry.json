{
  "_meta": "Source of truth for which ai/hooks/*.sh are registered in ~/.claude/settings.json, and on which event/matcher. `ai/bin/check-hooks-registered` asserts these are live (drift is the bug that silently disabled safe-wait-guard + pronoun-guard on 2026-09-17); `scripts/setup-hooks --install` writes them by MERGING (never clobbering the existing block — the clobber is what caused the outage). Paths are repo-relative and expanded to absolute against this repo's location. Matchers are Claude Code tool-name regexes; \"\" matches all (used for non-tool events).",
  "hooks": [
    { "event": "PreToolUse", "matcher": "Bash", "script": "ai/hooks/safe-wait-guard.sh" },
    { "event": "PreToolUse", "matcher": "Bash", "script": "ai/hooks/forge-identity-guard.sh" },
    { "event": "PreToolUse", "matcher": "Bash", "script": "ai/hooks/forge-auth-guard.sh" },
    { "event": "PreToolUse", "matcher": "Bash", "script": "ai/hooks/workflow-phase-guard.sh" },
    { "event": "PreToolUse", "matcher": "Bash|SendMessage|mcp__notion.*", "script": "ai/hooks/pronoun-guard.sh" },
    { "event": "PreToolUse", "matcher": "Edit|Write|MultiEdit|NotebookEdit", "script": "ai/hooks/inbox-untrusted-guard.sh" },
    { "event": "PreToolUse", "matcher": "Agent|Task", "script": "ai/hooks/fleet-drain-guard.sh" },
    { "event": "PostToolUse", "matcher": "Bash", "script": "ai/hooks/inbox-untrusted-guard.sh" },
    { "event": "PostToolUse", "matcher": "", "script": "ai/hooks/harness-event.sh" },
    { "event": "PostToolUse", "matcher": "", "script": "ai/hooks/fleet-report.sh" },
    { "event": "Stop", "matcher": "", "script": "ai/hooks/notify-idle.sh" },
    { "event": "SessionStart", "matcher": "", "script": "ai/hooks/main-session-policy.sh" },
    { "event": "SessionStart", "matcher": "", "script": "ai/hooks/athena-inbox-poll.sh" },
    { "event": "SessionStart", "matcher": "", "script": "ai/hooks/athena-slack-poll.sh" },
    { "event": "SessionStart", "matcher": "", "script": "ai/hooks/flaky-marker-sweep.sh" },
    { "event": "SessionStart", "matcher": "", "script": "ai/hooks/fleet-report.sh" },
    { "event": "SessionEnd", "matcher": "", "script": "ai/hooks/fleet-report.sh" }
  ]
}
