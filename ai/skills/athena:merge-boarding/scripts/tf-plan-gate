#!/usr/bin/ruby
# frozen_string_literal: true

# tf-plan-gate -- does this terraform plan destroy stateful infra or add cost?
#
# The objective check behind ~/.claude/CLAUDE.md -> "Standing owner approvals"
# -> "What no standing approval covers": a plan that DESTROYS or REPLACES a
# stateful resource, or ADDS COST, holds for the owner under every standing
# approval. A secrets update (a new value or config on an existing secret) is
# not held by itself.
#
# Input is `terraform show -json <planfile>`. It never runs terraform, never
# touches AWS, and reads nothing from the diff under test.
#
# Doctrine: ai/skills/athena:merge-boarding/SKILL.md -> exit 4.
# Self-test: ai/skills/athena:merge-boarding/test/tf-plan-gate/self-test.sh

require "json"

PROG = "tf-plan-gate"
HERE = File.expand_path(__dir__)

# Types whose create adds no recurring cost. Their destroy or replace loses no
# data too, EXCEPT the VALUE_HOLDING_TYPES below. Every other type fails WIDE:
# its create counts as cost, and its destroy or replace counts as stateful.
FREE_STATELESS_TYPES = %w[
  aws_db_parameter_group aws_db_subnet_group aws_ecr_lifecycle_policy
  aws_ecr_repository_policy aws_eip_association aws_iam_instance_profile
  aws_iam_openid_connect_provider aws_iam_policy aws_iam_role aws_iam_role_policy
  aws_iam_role_policy_attachment aws_internet_gateway aws_kms_alias aws_route
  aws_route_table aws_route_table_association aws_s3_bucket_lifecycle_configuration
  aws_s3_bucket_ownership_controls aws_s3_bucket_policy aws_s3_bucket_public_access_block
  aws_s3_bucket_server_side_encryption_configuration aws_s3_bucket_versioning
  aws_secretsmanager_secret_version aws_security_group aws_security_group_rule
  aws_ssm_parameter aws_subnet aws_vpc aws_vpc_security_group_egress_rule
  aws_vpc_security_group_ingress_rule github_actions_secret github_actions_variable
  null_resource random_id random_password random_string terraform_data time_sleep
].freeze
FREE_STATELESS_PREFIXES = %w[random_ time_ tls_].freeze

# Free to create, and an update of the value ships (a secrets UPDATE). But a
# destroy or replace loses a stored value, often one set out-of-band under
# ignore_changes, or suspends versioning, and so can an update of anything
# but the value, tags or description. Those hold as DESTROY.
VALUE_HOLDING_TYPES = %w[
  aws_s3_bucket_versioning aws_secretsmanager_secret_version aws_ssm_parameter
  github_actions_secret github_actions_variable
].freeze

# An expiration policy deletes stored objects or images when it runs, so a
# create or update holds as DESTROY. Removing one deletes nothing.
EXPIRY_POLICY_TYPES = %w[aws_ecr_lifecycle_policy aws_s3_bucket_lifecycle_configuration].freeze

# Named for the output only; the rule is "not free-stateless".
STATEFUL_TYPES = %w[
  aws_db_instance aws_dynamodb_table aws_ebs_volume aws_ecr_repository aws_efs_file_system
  aws_eip aws_elasticache_cluster aws_elasticache_replication_group aws_instance
  aws_kms_key aws_rds_cluster aws_rds_cluster_instance aws_s3_bucket
  aws_secretsmanager_secret
].freeze

# An update that changes any of these, at any depth, is a sizing change. Sizes
# have no reliable order, so any change holds, up or down.
COST_ATTRS = %w[
  allocated_storage billing_mode desired_capacity desired_count instance_class
  instance_count instance_type iops max_allocated_storage max_size min_size
  multi_az node_type num_cache_nodes read_capacity storage_throughput storage_type
  throughput tier volume_size volume_type write_capacity
].freeze

def usage
  <<~EOF
    #{PROG} -- does a terraform plan destroy stateful infra or add cost?

    Usage:
      #{PROG} --plan PLAN.json [--control CONTROL.json]
      #{PROG} --help | --self-test

    PLAN.json is `terraform show -json <planfile>` for the change.
    --control is the offline control-vs-change method only: the same plan
    for the base commit, both made without state, so every action is
    create. A create present identically in the control is an existing
    resource and is skipped. If either plan has an update or a delete it
    has state, and --control is refused (exit 2): merging applies the
    whole plan, drift included, so it is judged whole. A managed resource in the
    control but absent from the change plan (by address and by
    previous_address) is a DESTROY: the change removed its block, which an
    offline plan, having no state, cannot show as a delete.

    HOLD when any managed resource change:
      DESTROY   deletes or replaces (delete+create) a type that is not
                known free-and-stateless (stateful types fail wide), or one
                that holds a stored value (#{VALUE_HOLDING_TYPES.first(3).join(', ')}, ...),
                or updates such a type beyond its value, tags or description;
                or creates or updates an expiration policy (#{EXPIRY_POLICY_TYPES.join(', ')});
      COST      creates a type that is not known free-and-stateless, or
                creates a free one at an explicitly set billed size (an
                Advanced-tier SSM parameter), or updates a sizing attribute (#{COST_ATTRS.first(4).join(', ')}, ...)
                or leaves one unknown until apply.
    A create or update of a secret's value or config is not held by itself.
    prevent_destroy makes terraform refuse to plan. It still writes a plan
    file, marked errored and missing the refused resource; an errored or
    incomplete plan is exit 3, never CLEAR.

    Output: one line per held change, VERDICT<TAB>address<TAB>reason.

    Exit codes:
      0  CLEAR: nothing destroys stateful infra or adds cost
      4  HOLD: the owner's go is needed (listed)
      2  usage / unreadable file / --control on a plan with state (nothing measured)
      3  COULD NOT MEASURE: not a plan JSON, or an errored/incomplete plan
  EOF
end

def die(code, msg, fix)
  warn "#{PROG}: #{msg}"
  warn "Fix: #{fix}"
  exit code
end

plan_path = nil
control_path = nil
args = ARGV.dup
until args.empty?
  a = args.shift
  case a
  when "--help", "-h" then puts usage; exit 0
  when "--self-test"
    # ai/skills/athena:merge-boarding/test/tf-plan-gate/self-test.sh
    exec(File.join(File.dirname(HERE), "test/tf-plan-gate/self-test.sh"))
  when "--plan" then plan_path = args.shift or die(2, "--plan needs a file", "pass --plan <terraform show -json output>")
  when "--control" then control_path = args.shift or die(2, "--control needs a file", "pass --control <base plan JSON>")
  else die(2, "unknown argument: #{a}", "see --help; valid flags are --plan, --control, --self-test")
  end
end
die(2, "--plan is required", "run `terraform plan -out=p && terraform show -json p > plan.json`, then pass --plan plan.json") unless plan_path

def load_plan(path)
  raw = File.read(path)
rescue SystemCallError => e
  die(2, "cannot read #{path}: #{e.message}", "pass a readable plan JSON file")
else
  begin
    doc = JSON.parse(raw)
  rescue JSON::ParserError => e
    die(3, "COULD NOT MEASURE: #{path} is not JSON (#{e.message.lines.first.strip})",
        "pass `terraform show -json <planfile>` output, not the human plan text")
  end
  unless doc.is_a?(Hash) && doc.key?("format_version") && doc["resource_changes"].is_a?(Array)
    die(3, "COULD NOT MEASURE: #{path} has no format_version/resource_changes array",
        "pass `terraform show -json <planfile>` output for a saved plan; a state file or an empty file measures nothing")
  end
  # terraform writes a plan file even when planning fails (e.g. prevent_destroy
  # refusing a destroy), and the refused resource is absent from it.
  if doc["errored"] == true
    die(3, "COULD NOT MEASURE: #{path} is an ERRORED plan; the resources that failed to plan are missing from it",
        "run `terraform plan` and read its error. `Instance cannot be destroyed` means the change destroys a " \
        "prevent_destroy resource: hold for the owner. Anything else: fix the plan and re-run.")
  end
  if doc["complete"] == false
    die(3, "COULD NOT MEASURE: #{path} is an incomplete plan (complete:false, deferred changes)",
        "a partial plan can hide destroys; plan until complete, or hold for the owner")
  end
  unless doc["resource_changes"].all? { |rc| rc.is_a?(Hash) }
    die(3, "COULD NOT MEASURE: #{path} has a resource_changes element that is not an object",
        "pass unmodified `terraform show -json <planfile>` output")
  end
  doc
end

def managed(doc)
  doc["resource_changes"].select { |rc| rc["mode"] == "managed" }
end

def free_stateless?(type)
  FREE_STATELESS_TYPES.include?(type) || FREE_STATELESS_PREFIXES.any? { |p| type.start_with?(p) }
end

# Free to create is not the same as safe to destroy.
def safe_destroy?(type)
  free_stateless?(type) && !VALUE_HOLDING_TYPES.include?(type)
end

# Attributes a value-holding type changes IN PLACE: the value itself, tags and
# description. Any other top-level attribute that differs (or is unknown until
# apply, bar ignorable_unknown? below) may force a replace, which loses the
# stored value.
IN_PLACE_VALUE_ATTRS = %w[
  description encrypted_value insecure_value plaintext_value secret_binary
  secret_string tags tags_all value
].freeze

# Attributes the provider computes, never config. A real plan marks them
# unknown on a create (id, arn, version) and on a value update (a new version,
# updated_at). Their unknown-ness says nothing about a replace, so it is
# ignored; a KNOWN change to one is still compared.
COMPUTED_VALUE_ATTRS = %w[
  arn created_at has_secret_string_wo has_value_wo id remote_updated_at
  updated_at version version_id
].freeze

# Offline, "unknown in both plans" does not mean unchanged: an offline plan
# has no state, so every reference to another resource is unknown in both,
# and re-pointing one (secret_id from secret a to secret b) changes nothing
# the values show. So a both-unknown attribute is set aside only when its
# CONFIGURATION expression is provably the same in both plans:
#   - the expression (constant_value / references) is identical, and
#   - every reference is to a resource or data source (whose own change is
#     judged on its own row), count.index, or a variable whose value is the
#     same: a root variable's plan value, or a module variable's call
#     expression, checked the same way one level up.
# local.*, module.*, each.* and anything else cannot be seen in the plan JSON,
# so they are never provably the same, and the attribute holds (fail wide).
class ConfigIndex
  def initialize(doc)
    @doc = doc
    @root = doc.dig("configuration", "root_module") || {}
  end

  # [module names], config-relative resource address
  def self.split(address)
    segs = address.gsub(/\[[^\]]*\]/, "").split(".")
    mods = []
    while segs.first == "module" && segs.size > 2
      mods << segs[1]
      segs = segs.drop(2)
    end
    [mods, segs.join(".")]
  end

  def module_at(mods)
    mods.reduce(@root) { |m, name| m.is_a?(Hash) ? m.dig("module_calls", name, "module") : nil }
  end

  # A module variable's call expression; when the call does not set it, the
  # variable's declaration (with its default) as [:default, declaration].
  def call_expr(mods, var)
    parent = module_at(mods[0..-2])
    call = parent.is_a?(Hash) ? parent.dig("module_calls", mods.last) : nil
    return nil unless call.is_a?(Hash)

    exprs = call["expressions"] || {}
    return exprs[var] if exprs.key?(var)

    decl = call.dig("module", "variables", var)
    decl.nil? ? nil : [:default, decl]
  end

  def resource_expr(address, path)
    mods, rel = self.class.split(address)
    mod = module_at(mods)
    res = mod.is_a?(Hash) ? Array(mod["resources"]).find { |r| r.is_a?(Hash) && r["address"] == rel } : nil
    return [mods, nil] unless res

    # :unset = the resource is in the configuration and this attribute is not
    # set in it (a provider default). Unset in both plans is the same config.
    expr = path.reduce(res["expressions"] || {}) do |e, k|
      case e
      when Hash then e.key?(k) ? e[k] : :unset
      when Array then k.to_s.match?(/\A\d+\z/) && k.to_i < e.size ? e[k.to_i] : :unset
      else :unset
      end
    end
    [mods, expr]
  end

  def root_var(name)
    @doc.dig("variables", name)
  end
end

def same_expr?(ctrl, chg, mods, ec, eh, depth = 0)
  return false if ec.nil? || eh.nil? || ec != eh || depth > 20
  return true if eh == :unset
  return true if eh.is_a?(Array) && eh.first == :default # same declaration, same default
  return false unless eh.is_a?(Hash) && (eh.key?("constant_value") || eh.key?("references"))

  Array(eh["references"]).all? do |ref|
    head, name = ref.split(".", 3)
    case head
    when "count" then true
    when "var"
      if mods.empty?
        vc = ctrl.root_var(name)
        vc && vc == chg.root_var(name)
      else
        same_expr?(ctrl, chg, mods[0..-2], ctrl.call_expr(mods, name), chg.call_expr(mods, name), depth + 1)
      end
    when "local", "module", "each", "path", "terraform", "self" then false
    else true # a resource or data source reference: judged on its own row
    end
  end
end

# A proc(path) answering "is this attribute's expression provably the same in
# the control and the change?" for one resource address.
def stable_expr_check(ctrl_index, chg_index, address)
  lambda do |path|
    mods, ec = ctrl_index.resource_expr(address, path)
    _, eh = chg_index.resource_expr(address, path)
    same_expr?(ctrl_index, chg_index, mods, ec, eh)
  end
end

# An attribute unknown until apply is not the diff's when it is computed, or
# (offline) when the control's create has it unknown too AND its expression is
# provably the same (STABLE). Any other unknown attribute holds: it could be
# config that forces a replace.
def ignorable_unknown?(key, unknown, base_unknown, stable)
  return false unless unknown == true
  return true if COMPUTED_VALUE_ATTRS.include?(key)

  base_unknown == true && !stable.nil? && stable.call([key])
end

def replace_risk_attrs(before, after, unknown, base_unknown = nil, stable = nil)
  b = before.is_a?(Hash) ? before : {}
  a = after.is_a?(Hash) ? after : {}
  u = unknown.is_a?(Hash) ? unknown : {}
  bu = base_unknown.is_a?(Hash) ? base_unknown : {}
  (b.keys | a.keys | u.keys).reject { |k| IN_PLACE_VALUE_ATTRS.include?(k) || ignorable_unknown?(k, u[k], bu[k], stable) }
                            .select { |k| u[k] == true || b[k] != a[k] }.sort
end

def destroy_label(type)
  return "holds a stored value" if VALUE_HOLDING_TYPES.include?(type)

  STATEFUL_TYPES.include?(type) ? "stateful" : "not known stateless"
end

# Tag maps are labels, not sizing: a tag named `tier` bills nothing.
TAG_ATTRS = %w[tags tags_all].freeze

# Paths of COST_ATTRS keys whose values differ between before and after, or
# are unknown in after. Offline, BASE_UNKNOWN is the control create's
# after_unknown: a sizing attribute unknown in both is not the diff's only
# when STABLE proves its expression the same in both plans (see
# stable_expr_check); one unknown only in the change always holds.
def cost_diffs(before, after, unknown, path = [], base_unknown = nil, stable = nil)
  out = []
  keys = ((before.is_a?(Hash) ? before.keys : []) | (after.is_a?(Hash) ? after.keys : []) |
          (unknown.is_a?(Hash) ? unknown.keys : []))
  if before.is_a?(Hash) || after.is_a?(Hash) || unknown.is_a?(Hash)
    (keys - TAG_ATTRS).each do |k|
      b = before.is_a?(Hash) ? before[k] : nil
      a = after.is_a?(Hash) ? after[k] : nil
      u = unknown.is_a?(Hash) ? unknown[k] : nil
      bu = base_unknown.is_a?(Hash) ? base_unknown[k] : nil
      if COST_ATTRS.include?(k)
        set_aside = bu == true && !stable.nil? && stable.call(path + [k])
        out << "#{(path + [k]).join('.')} unknown until apply" if u == true && !set_aside
        out << "#{(path + [k]).join('.')} #{b.inspect} -> #{a.inspect}" if u != true && b != a
      end
      out.concat(cost_diffs(b, a, u, path + [k], bu, stable)) if [b, a, u].any? { |x| x.is_a?(Hash) || x.is_a?(Array) }
    end
  elsif before.is_a?(Array) || after.is_a?(Array) || unknown.is_a?(Array)
    n = [before, after, unknown].map { |x| x.is_a?(Array) ? x.size : 0 }.max
    n.times do |i|
      b = before.is_a?(Array) ? before[i] : nil
      a = after.is_a?(Array) ? after[i] : nil
      u = unknown.is_a?(Array) ? unknown[i] : nil
      bu = base_unknown.is_a?(Array) ? base_unknown[i] : nil
      out.concat(cost_diffs(b, a, u, path + [i.to_s], bu, stable))
    end
  end
  out
end

# A free-listed type is free only at its free sizing. The value(s) of a
# COST_ATTRS key at which a free-listed type bills nothing; any other value a
# NEW resource sets explicitly holds as COST. An unset one is unknown in a
# real plan (measured: an SSM parameter's tier) and takes the provider or
# account default, a size the diff did not choose, so it does not hold.
# "Free" means no fixed recurring charge: usage-driven charges (versioned
# storage, KMS requests) are not measured here.
FREE_SIZING_VALUES = { "tier" => ["Standard"] }.freeze

# Paths of COST_ATTRS keys a new resource explicitly sets to a non-free value.
def new_sizing(after, unknown, path = [])
  out = []
  if after.is_a?(Hash) || unknown.is_a?(Hash)
    a_h = after.is_a?(Hash) ? after : {}
    u_h = unknown.is_a?(Hash) ? unknown : {}
    ((a_h.keys | u_h.keys) - TAG_ATTRS).each do |k|
      a = a_h[k]
      u = u_h[k]
      if COST_ATTRS.include?(k) && u != true && !a.nil? && !Array(FREE_SIZING_VALUES[k]).include?(a)
        out << "#{(path + [k]).join('.')} = #{a.inspect}"
      end
      out.concat(new_sizing(a, u, path + [k])) if [a, u].any? { |x| x.is_a?(Hash) || x.is_a?(Array) }
    end
  elsif after.is_a?(Array) || unknown.is_a?(Array)
    n = [after, unknown].map { |x| x.is_a?(Array) ? x.size : 0 }.max
    n.times do |i|
      out.concat(new_sizing(after.is_a?(Array) ? after[i] : nil, unknown.is_a?(Array) ? unknown[i] : nil, path + [i.to_s]))
    end
  end
  out
end

plan_doc = load_plan(plan_path)
control_doc = control_path ? load_plan(control_path) : nil
changes = managed(plan_doc)
control = control_doc ? managed(control_doc) : []
plan_index = ConfigIndex.new(plan_doc)
control_index = control_doc ? ConfigIndex.new(control_doc) : nil
control_keys = control.map { |rc| [rc["address"], rc.dig("change", "actions"), rc.dig("change", "after")] }

# --control is the offline method only: a plan with no state reads every
# resource as `create`. An update or delete means a plan with state, and
# merging applies all of it, drift included, so nothing in it may be
# subtracted. Refuse rather than judge part of it.
if control_path
  stateful = [[plan_path, changes], [control_path, control]].flat_map do |path, rcs|
    rcs.reject { |rc| (Array(rc.dig("change", "actions")) - %w[create no-op read]).empty? }
       .map { |rc| "#{path}: #{rc['address']} #{Array(rc.dig('change', 'actions')).join('+')}" }
  end
  unless stateful.empty?
    die(2, "--control is for offline (stateless) plans, but these actions show state: #{stateful.first(3).join('; ')}",
        "run without --control: a plan with state is judged whole, drift included, because merging applies the " \
        "whole plan. Use --control only with the offline control-vs-change method, where every action is create.")
  end
end

held = []
considered = 0
skipped_control = 0
changes.each do |rc|
  actions = Array(rc.dig("change", "actions"))
  next if actions.empty? || actions == ["no-op"] || actions == ["read"]

  if actions == ["create"] && control_keys.include?([rc["address"], actions, rc.dig("change", "after")])
    skipped_control += 1
    next
  end
  considered += 1
  addr = rc["address"]
  type = rc["type"].to_s
  if actions.include?("delete") && !safe_destroy?(type)
    verb = actions.include?("create") ? "replace" : "destroy"
    held << ["DESTROY", addr, "#{verb} of #{type} (#{destroy_label(type)})"]
  end
  if EXPIRY_POLICY_TYPES.include?(type) && (actions.include?("create") || actions.include?("update"))
    held << ["DESTROY", addr, "#{type} is an expiration policy: it deletes stored objects or images"]
  end
  if actions == ["create"] && !free_stateless?(type)
    held << ["COST", addr, "new #{type} (not known free)"]
  end
  # Offline (no state) a resize reads as create-vs-create at one address:
  # compare its sizing attributes with the control's create.
  base_create = control.find { |c| c["address"] == addr && c.dig("change", "actions") == ["create"] }
  # A NEW free-listed resource (no control counterpart) is free only at its
  # free sizing.
  if actions.include?("create") && free_stateless?(type) && !base_create
    new_sizing(rc.dig("change", "after"), rc.dig("change", "after_unknown")).each do |d|
      held << ["COST", addr, "new #{type} at a billed size: #{d}"]
    end
  end
  if actions == ["create"] && base_create
    base_unknown = base_create.dig("change", "after_unknown")
    stable = stable_expr_check(control_index, plan_index, addr)
    cost_diffs(base_create.dig("change", "after"), rc.dig("change", "after"), rc.dig("change", "after_unknown"),
               [], base_unknown, stable).each do |d|
      held << ["COST", addr, "sizing change vs the control: #{d}"]
    end
    # Offline, an update and a force-new replace look the same. For a type
    # whose replace loses a value, only a known in-place change is let through.
    if VALUE_HOLDING_TYPES.include?(type)
      moved = replace_risk_attrs(base_create.dig("change", "after"), rc.dig("change", "after"),
                                 rc.dig("change", "after_unknown"), base_unknown, stable)
      unless moved.empty?
        held << ["DESTROY", addr, "#{type} (holds a stored value): offline, #{moved.join(', ')} changed and may force a replace"]
      end
    end
  end
  if actions.include?("update")
    ch = rc["change"]
    cost_diffs(ch["before"], ch["after"], ch["after_unknown"]).each do |d|
      held << ["COST", addr, "sizing change: #{d}"]
    end
    # Online as offline: a value-holding type passes only a value, tags or
    # description change. Any other attribute can do what its delete does
    # (suspending versioning, moving a secret to another repository).
    if VALUE_HOLDING_TYPES.include?(type)
      moved = replace_risk_attrs(ch["before"], ch["after"], ch["after_unknown"])
      unless moved.empty?
        held << ["DESTROY", addr, "#{type} (holds a stored value): update changes #{moved.join(', ')}, not only its value"]
      end
    end
  end
end

# A resource the control plans but the change does not is removed from config.
change_addrs = changes.flat_map { |rc| [rc["address"], rc["previous_address"]] }.compact
control_only = 0
control.each do |rc|
  next if change_addrs.include?(rc["address"])

  control_only += 1
  type = rc["type"].to_s
  next if safe_destroy?(type)

  held << ["DESTROY", rc["address"], "#{type} (#{destroy_label(type)}) is in the control plan but absent from the change plan: its block was removed"]
end

held.each { |h| puts h.join("\t") }
summary = "#{PROG}: #{considered} resource change(s) considered" +
          (control_path ? ", #{skipped_control} also in the control, skipped, #{control_only} only in the control" : "")
if held.empty?
  puts "#{summary}; CLEAR: nothing destroys stateful infra or adds cost."
  exit 0
end
puts "#{summary}; HOLD: #{held.size} change(s) need the owner's go."
puts "Fix: hold the MR and request the owner's go with a Block Kit DM " \
     "(athena:slack -> Asking the owner for a decision); no standing approval covers these."
exit 4
