#!/usr/bin/env bash
# locked-merge -- merge one GitHub PR, or one GitLab MR on a project with no
# merge train, inside the repo's merge critical section.
#
# DND-1943: gitlab.com Free has no merge trains, so a GitLab project without
# one had no locked merge and the TOCTOU below was open there. `--mr <iid>`
# runs the same steps under the same lock file, with the pinned
# `glab-athena mr merge <iid> --squash --sha <head>` as the merge call. A
# project with merge trains enabled (its merge_trains_enabled, read from the
# project, never guessed from the host name) is refused with exit 12: it
# boards the train (athena:merge-boarding -> Boarding).
#
# Why this exists: a GitHub squash-merge does NOT refuse when the base moved
# after integration-gate ran. With no textual conflict it lands a tree nobody
# gated. Check-then-merge is a TOCTOU (gen_saas 2026-09-23: AM-2's squash
# landed on DND-347's merge a minute later, integrated head ungated). Six fleets
# then hand-rolled the same flock recipe from prose. This is that recipe.
#
# DND-1463 (owner, 2026-10-01): a base that moved on past the gated base is now
# accepted, a deliberate velocity trade ("The velocity increase is worth the
# risk of incompatible concurrent merges."). The lock still serialises merges;
# a conflict is still refused; and the landed tree must still equal the merge
# this script computed under the lock, so the forge cannot land anything else.
#
# It ADDS refusals in front of an existing pinned merge and replaces none:
# integration-gate still runs first, merges stay one at a time, gh-athena's
# all-green refusal stays the green check, confirm-merged still runs.
#
# "integration-gate runs first" is ENFORCED, not trusted (DND-965). gen_saas
# #468 merged past a RED gate because a prep script printed READY without
# reading the exit code, and nothing here asked. Now the merge requires the
# gate's own receipt for exactly --head, recorded against the base re-checked
# under the lock or an ancestor of it (DND-1463: owner, 2026-10-01, "Let's
# soften that merge guard requirement."). There is deliberately no flag or env var that
# skips it (~/dev/custom/CLAUDE.md -> "A check's own bar must not live in the
# diff it is checking"); the only owner override is integration-gate's own
# --owner-approval, which the receipt records.
#
# Doctrine: ai/skills/athena:merge-boarding/SKILL.md -> Landing onto a moving main.
# Self-test: ai/skills/athena:merge-boarding/test/locked-merge/self-test.sh
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SKILL_DIR="$(dirname "${HERE}")"
# origin is read through Athena's forge route (DND-1977), never the owner's SSH
# key: the admiral runs this unattended.
FORGE_GIT="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../../bin/forge-git"

# The receipt reader is shared with gh-athena's merge guard and the writer
# (integration-gate), so the three cannot drift (DND-969).
IR_LIB="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../../lib/integration-receipt.sh"
# shellcheck source=../../../lib/integration-receipt.sh
if ! . "${IR_LIB}" 2>/dev/null; then
  printf 'locked-merge: cannot load %s\nFix: run locked-merge from its committed path in a full ~/dev/custom checkout (ai/skills and ai/lib side by side).\n' "${IR_LIB}" >&2
  exit 2
fi
# The red-tip judge (DND-1902) is gh-athena's merge guard's, so the two read a
# red base tip one way.
GMG_LIB="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../../lib/gh-merge-guard.sh"
# shellcheck source=../../../lib/gh-merge-guard.sh
if ! . "${GMG_LIB}" 2>/dev/null; then
  printf 'locked-merge: cannot load %s\nFix: run locked-merge from its committed path in a full ~/dev/custom checkout (ai/skills and ai/lib side by side).\n' "${GMG_LIB}" >&2
  exit 2
fi

usage() {
  cat <<'EOF'
locked-merge -- merge one GitHub PR, or one GitLab MR on a project with no
merge train, under the repo's merge lock.

Usage:
  locked-merge --pr <n> --head <sha> [--repo DIR] [--lock PATH] [--wait SECS]
               [--require-idle-workflow <workflow-file>]
  locked-merge --mr <iid> --head <sha> [--repo DIR] [--lock PATH] [--wait SECS]
  locked-merge --help | --self-test

Run integration-gate first; pass the SHA its INTEGRATION OK line names as
--head. Under an flock (default ~/.local/state/athena/<repo>-merge.lock, the
path fleets already share) it:
  1. fetches origin and reads the PR (must be OPEN, head == --head);
  2. requires integration-gate's RECEIPT for --head, at
     <git common dir>/integration-receipts/<head>.json: verdict pass, head ==
     --head, and a recorded base R that is the current origin/<base> SHA B or
     an ANCESTOR of it (DND-1463), and that --head contains. No flag skips
     this; integration-gate writes it only on INTEGRATION OK. When R != B it
     prints BASE MOVED: the head merged with R..B was never gated;
  3. computes the expected squash tree, git merge-tree B --head (the head's
     own tree when R == B). A conflict is refused here (exit 3);
  4. with --require-idle-workflow <workflow-file>, keyed on the base SHA B
     (DND-1378): the base commit's own push run, looked up by SHA and
     re-read by id, must be completed, and the <base> run list must show no
     queued/running run. No run for the base SHA is NOT SEEN YET (under 600s)
     or NO RUN FOR BASE (exit 5), never idle, unless the commit carries a skip
     marker ([skip ci] and kin). Any read it cannot make is COULD NOT LOOK
     (exit 2). The base run's conclusion is printed; a non-success is a WARN;
  4b. stops the line (DND-1902): reads the runs on the base tip B itself,
     and B's tree against ai/config/main-content-checks.json (a duplicated
     migration version). A duplicate refuses (exit 11), naming each, unless
     --head contains B and removes every duplicate (RED-MAIN FIX). A judged
     red or pending run (CI or a post-merge deploy) is named and merges
     (DND-2061: --head need not contain B), and so are runs it cannot read.
     The content it cannot read is COULD NOT
     LOOK (exit 2). No check on B and no declared content check merge as
     before. The
     expected squash tree from step 3 is read against the same declaration:
     a duplicate there is a SEMANTIC CONFLICT (exit 3);
  5. merges via gh-athena pr merge --squash --match-head-commit <head> (no --auto);
  6. confirm-merged --pr <n> --fetch (bounded retry), also after a failed
     merge call, which can still have landed (DND-1324);
  7. asserts the merge commit's parent == B and its tree == the expected
     tree from step 3;
  8. releases the lock and runs teardown-stack --pr <n> --repo DIR, which
     tears down the PR's worktree stack (DND-864).

GitLab (--mr, DND-1943): origin must be gitlab.com. Before the lock it reads
the project (plain glab): merge_trains_enabled true is exit 12 (board the
train instead); the key absent, with merge_method present, is a project with
no train (gitlab.com Free omits the field). Then the guard the glab-athena
it calls will load must define the tip-pipeline judge (glmg_tip_gate,
DND-1941): without it, exit 2 NO TIP JUDGE, so nothing merges through --mr
before that judge exists. A fork MR is refused (exit 2). The same lock file and
steps follow, with these differences:
  1. the MR is read with glab api (state opened, sha == --head);
  4. --require-idle-workflow is GitHub-only and refused with --mr;
  4b. the base tip's CONTENT is read here as on GitHub; its pipelines are
     judged inside the merge call by glab-athena's merge guard (glmg_tip_gate,
     DND-1941, checked present above), whose MAIN RED / COULD NOT LOOK
     refusals map to exits 11 / 2 as below;
  5. merges via glab-athena mr merge <iid> --squash --sha <head>
     --auto-merge=false --yes (never a deferred merge);
  6. confirm-merged --mr <iid> --fetch;
  7. the landed commit is the MR's merge_commit_sha (squash_commit_sha on a
     fast-forward project);
  8. teardown-stack --mr <iid> --repo DIR.
It writes merge.lock_wait and never merge.landed: an MR's landing is
glab-athena's to record (DND-1939, ai/lib/glab-landing.sh).

Exit (every non-zero prints a Fix: line):
  0 merged, confirmed, tree matches          (landed)
  2 usage / prerequisite / a remote that is not the flag's forge (--pr:
    github.com, --mr: gitlab.com) / a fork MR, or COULD NOT LOOK (a read this
    tool or the merge guard could not make, or NO TIP JUDGE on --mr; nothing
    landed)
  3 stale: PR not open, head moved, CONFLICT with origin/<base>, or a
    SEMANTIC CONFLICT (the merged tree duplicates a migration version) -- merge
    origin/<base> in, resolve, re-gate (nothing landed)
  4 forge refused the merge, and confirm-merged does not show it landed
    (a failed call that DID land is verified and reported as a merge)
  5 required-idle workflow busy, NOT SEEN YET or NO RUN FOR BASE -- retry later (nothing landed)
  6 lock wait timed out; the lock is never broken (nothing landed)
  7 LANDED UNGATED: parent or tree mismatch -- re-gate origin/main now, report it
  8 merge ran but landing not confirmed -- investigate, do not retry blind
  9 no usable integration-gate receipt for --head: NO RECEIPT, RECEIPT
    UNREADABLE (COULD NOT LOOK), RECEIPT INVALID, RECEIPT UNVERIFIED (not
    sealed by the landed gate, DND-1814), RECEIPT UNVERIFIABLE (COULD NOT
    LOOK), RECEIPT FOR ANOTHER BASE
    (recorded base not an ancestor of origin/<base>), or RECEIPT BASE
    UNKNOWN (COULD NOT LOOK) -- run integration-gate on this head (nothing landed)
  10 LANDED and confirmed, but the worktree stack teardown failed -- do not re-merge
  11 MAIN RED: the base tip holds a duplicated migration version, and
     --head is not a fix (contains the tip, removes every duplicate) --
     land only a red-main fix; others wait until that fix lands on the base
     (nothing landed).
     Also when the tip turns red after this check and the merge guard's own
     re-check refuses (DND-1906): no confirm retries, the guard's message kept.
  12 MERGE TRAIN: the GitLab project has merge trains enabled -- board the
     train (athena:merge-boarding -> Boarding); nothing was locked or merged
EOF
}

die() { # <exit> <message> <fix>
  printf 'locked-merge: %s\nFix: %s\n' "$2" "$3" >&2
  exit "$1"
}

PR=""; MR=""; HEAD_SHA=""; REPO="."; LOCK=""; WAIT=900; IDLE_WF=""
while [ $# -gt 0 ]; do
  case "$1" in
    --pr)   [ $# -ge 2 ] || die 2 "--pr needs a value" "pass --pr <number>."; PR="$2"; shift 2 ;;
    --mr)   [ $# -ge 2 ] || die 2 "--mr needs a value" "pass --mr <MR iid>."; MR="$2"; shift 2 ;;
    --head) [ $# -ge 2 ] || die 2 "--head needs a value" "pass --head <full sha from INTEGRATION OK>."; HEAD_SHA="$2"; shift 2 ;;
    --repo) [ $# -ge 2 ] || die 2 "--repo needs a value" "pass --repo <worktree dir>."; REPO="$2"; shift 2 ;;
    --lock) [ $# -ge 2 ] || die 2 "--lock needs a value" "pass --lock <absolute path>, or omit it for the default."; LOCK="$2"; shift 2 ;;
    --wait) [ $# -ge 2 ] || die 2 "--wait needs a value" "pass --wait <seconds>."; WAIT="$2"; shift 2 ;;
    --require-idle-workflow)
            [ $# -ge 2 ] || die 2 "--require-idle-workflow needs a value" "pass the workflow file name, e.g. post-merge.yml."
            IDLE_WF="$2"; shift 2 ;;
    --self-test)
      # Both suites, the GitHub one unchanged (DND-1943).
      bash "${SKILL_DIR}/test/locked-merge/self-test.sh"; st_gh=$?
      bash "${SKILL_DIR}/test/locked-merge-gitlab/self-test.sh"; st_gl=$?
      [ "${st_gh}" -eq 0 ] && [ "${st_gl}" -eq 0 ]; exit $? ;;
    -h|--help) usage; exit 0 ;;
    *) die 2 "unknown argument: $1" "see --help; valid flags are --pr, --mr, --head, --repo, --lock, --wait, --require-idle-workflow, --self-test." ;;
  esac
done

# ---- resolve every key first; a key that cannot be computed is an error ----
# FORGE is chosen by the flag, and the origin must then be that forge's host.
# CH is the change number either way; CH_NAME names it in messages.
if [ -n "${PR}" ] && [ -n "${MR}" ]; then
  die 2 "both --pr and --mr given; a repo is one forge" "pass --pr <n> for a GitHub PR or --mr <iid> for a GitLab MR, not both."
fi
if [ -n "${MR}" ]; then
  FORGE=gitlab; CH="${MR}"; CH_NAME="MR !${MR}"; CH_FLAG=--mr
  case "${MR}" in ''|0*|*[!0-9]*) die 2 "--mr must be an MR iid, digits with no leading zero (got '${MR}')" "pass --mr <iid> (the number after ! in the MR's URL)." ;; esac
  [ -z "${IDLE_WF}" ] || die 2 "--require-idle-workflow names a GitHub Actions workflow and has no GitLab form" \
    "drop it with --mr; a GitLab idle-pipeline check is not built yet (see athena:merge-boarding -> GitLab path (no merge train))."
else
  FORGE=github; CH="${PR}"; CH_NAME="PR ${PR}"; CH_FLAG=--pr
fi
[ "${FORGE}" = gitlab ] || case "${PR}" in ''|*[!0-9]*) die 2 "--pr must be a PR number (got '${PR}')" "pass --pr <number>, or --mr <iid> for a GitLab MR." ;; esac
case "${HEAD_SHA}" in
  *[!0-9a-f]*|'') die 2 "--head must be a full lowercase hex SHA (got '${HEAD_SHA}')" "copy the SHA from integration-gate's INTEGRATION OK line." ;;
esac
[ "${#HEAD_SHA}" -eq 40 ] || die 2 "--head must be a full 40-char SHA (got ${#HEAD_SHA} chars)" "copy the full SHA from integration-gate's INTEGRATION OK line."
case "${WAIT}" in ''|*[!0-9]*) die 2 "--wait must be whole seconds (got '${WAIT}')" "pass --wait <seconds>." ;; esac

REPO="$(cd "${REPO}" 2>/dev/null && pwd)" || die 2 "--repo is not a directory" "pass --repo <the Mission's worktree>."
COMMON="$(git -C "${REPO}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
  || die 2 "${REPO} is not inside a git repository" "pass --repo <the Mission's worktree>."
case "${COMMON}" in
  /*/.git) ;;
  *) die 2 "git common dir '${COMMON}' is not an absolute <repo>/.git path" "run from a normal checkout or worktree of the repo (not a bare clone)." ;;
esac
REPO_NAME="$(basename "$(dirname "${COMMON}")")"

ORIGIN_URL="$(git -C "${REPO}" config --get remote.origin.url 2>/dev/null)" \
  || die 2 "no remote 'origin' in ${REPO}" "run from a checkout whose origin is the repo the ${CH_NAME} belongs to."
if [ "${FORGE}" = github ]; then
  case "${ORIGIN_URL}" in
    *github.com[:/]*) ;;
    *) die 2 "origin '${ORIGIN_URL}' is not github.com" "--pr is for a GitHub PR; for a GitLab MR pass --mr <iid> (a project with a merge train boards it instead: athena:merge-boarding -> Boarding)." ;;
  esac
else
  # glab-athena acts on gitlab.com only, so the GitLab path does too. The
  # project path is the whole path after the host (nested groups included).
  [[ "${ORIGIN_URL}" =~ ^([a-z][a-z0-9+.-]*://)?([^@/]*@)?gitlab\.com(:[0-9]+)?[:/]+(.+)$ ]] \
    || die 2 "origin '${ORIGIN_URL}' is not gitlab.com" "--mr is for a gitlab.com MR; for a GitHub PR pass --pr <n>."
  GL_PROJECT="${BASH_REMATCH[4]%/}"; GL_PROJECT="${GL_PROJECT%.git}"
  [[ "${GL_PROJECT}" =~ ^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)+$ ]] \
    || die 2 "COULD NOT LOOK: origin '${ORIGIN_URL}' names no <namespace>/<project> (got '${GL_PROJECT}')" \
         "set origin to the project's URL (git@gitlab.com:<namespace>/<project>.git); nothing was merged."
  GL_ENC="${GL_PROJECT//\//%2F}"
fi

LM_LOCK_KIND=explicit   # telemetry's closed `lock` label: never the caller's path
if [ -z "${LOCK}" ]; then
  LM_LOCK_KIND=default
  # Deliberately NOT $XDG_STATE_HOME: a second derivation would split the lock
  # silently (two admirals, two files, no exclusion).
  [ -n "${HOME:-}" ] || die 2 "HOME is unset, so the default lock path cannot be computed" "set HOME or pass --lock <absolute path>."
  LOCK="${HOME}/.local/state/athena/${REPO_NAME}-merge.lock"
fi
case "${LOCK}" in /*) ;; *) die 2 "--lock must be absolute (got '${LOCK}')" "pass an absolute --lock path." ;; esac
mkdir -p "$(dirname "${LOCK}")" || die 2 "cannot create $(dirname "${LOCK}")" "check permissions on the lock directory."
echo "LOCK ${LOCK}"

AI_BIN="${LOCKED_MERGE_AI_BIN:-$(cd "${SKILL_DIR}/../../bin" 2>/dev/null && pwd)}"
if [ "${FORGE}" = github ]; then WRAPPER=gh-athena READER=gh MERGE_CALL="gh-athena pr merge ${PR}"
else WRAPPER=glab-athena READER=glab MERGE_CALL="glab-athena mr merge ${MR}"; fi
for t in "${WRAPPER}" confirm-merged teardown-stack; do
  [ -x "${AI_BIN}/${t}" ] || die 2 "${AI_BIN}/${t} not found" "run this script from its home in ~/dev/custom/ai/skills/athena:merge-boarding/scripts/."
done
command -v "${READER}" >/dev/null 2>&1 || die 2 "${READER} (read-only forge CLI) not on PATH" "install ${READER}; reads use plain ${READER}."
command -v flock >/dev/null 2>&1 || die 2 "flock not on PATH" "install util-linux flock."
command -v jq >/dev/null 2>&1 || die 2 "jq not on PATH" "install jq; the ${CH_NAME} state and the integration-gate receipt are read with it."

# ---- GitLab: the project decides train or no train (DND-1943) ----
# Read from the project, never from the host name. gitlab.com Free omits
# merge_trains_enabled (measured 2026-10-04 on cjpoll/gen_saas: merge_method
# "merge", no merge_trains_enabled key), so an absent key is a project with no
# train ONLY when the read is a full project view: merge_method must be there.
# Anything else is COULD NOT LOOK, never "no train" (ai/CLAUDE.md -> "A failed
# lookup must never look like an empty one"). Before the lock: a train project
# takes nothing here.
gl_api() { # <endpoint> -- one plain-glab read on gitlab.com
  glab api --hostname gitlab.com "$1"
}
if [ "${FORGE}" = gitlab ]; then
  gl_err="$(mktemp)" || die 2 "COULD NOT LOOK: mktemp failed" "check that \$TMPDIR is writable; nothing was merged."
  proj_json="$(cd "${REPO}" && gl_api "projects/${GL_ENC}" 2>"${gl_err}")"; proj_rc=$?
  proj_why="$(head -3 "${gl_err}" | tr '\n' ' ')"; rm -f "${gl_err}"
  [ "${proj_rc}" -eq 0 ] || die 2 "COULD NOT LOOK: glab api projects/${GL_ENC} failed (exit ${proj_rc}): ${proj_why}" \
    "check glab auth for gitlab.com and that ${GL_PROJECT} exists; whether it has a merge train is unknown, so nothing was merged."
  trains="$(jq -r 'if type != "object" then "BAD"
                   elif (.merge_method | type) != "string" then "BAD"
                   elif has("merge_trains_enabled") | not then "absent"
                   elif (.merge_trains_enabled | type) == "boolean" then (.merge_trains_enabled | tostring)
                   else "BAD" end' <<<"${proj_json}" 2>/dev/null)" || trains=BAD
  case "${trains}" in
    true) die 12 "MERGE TRAIN: ${GL_PROJECT} has merge trains enabled (merge_trains_enabled true), so ${CH_NAME} boards the train, not this tool" \
            "board it: athena:merge-boarding -> Boarding (glab-athena api -X POST \"projects/:id/merge_trains/merge_requests/${MR}\" -f sha=${HEAD_SHA}, from a checkout of the project). Nothing was locked or merged." ;;
    false) echo "PROJECT ${GL_PROJECT}: merge trains disabled (merge_trains_enabled false)" ;;
    absent) echo "PROJECT ${GL_PROJECT}: no merge train (merge_trains_enabled not offered; merge_method $(jq -r .merge_method <<<"${proj_json}"))" ;;
    *) die 2 "COULD NOT LOOK: the project read for ${GL_PROJECT} is not a full project view (no merge_method, or a non-boolean merge_trains_enabled): $(head -c 200 <<<"${proj_json}" | tr '\n' ' ')" \
         "read it as a member with at least Developer access (glab auth status for gitlab.com); whether it has a merge train is unknown, so nothing was merged." ;;
  esac

  # ---- the tip-pipeline judge must exist where it will run (DND-1941) ----
  # On GitLab a red base tip's PIPELINES are judged inside the merge call, by
  # the guard the wrapper sources (glmg_tip_gate). This tool does not copy that
  # judge. So it asks the guard the wrapper at ${AI_BIN} will load whether the
  # judge is there, and refuses when it is not. Since DND-2061 its pipelines
  # are a note in every state; what it still refuses is the tip's CONTENT at
  # merge time (the DND-1906 re-check), so a tool that read as a full locked
  # merge without that re-check would be the claim with no
  # mechanism behind it (CLAUDE.md -> "A claimed mechanism must be able to
  # fire"). Before DND-1941 lands, every --mr merge stops here.
  GLMG_FOR_WRAPPER="$(dirname "$(readlink -f "${AI_BIN}/${WRAPPER}")")/../lib/glab-merge-guard.sh"
  if ! ( . "${GLMG_FOR_WRAPPER}" >/dev/null 2>&1 && declare -F glmg_tip_gate >/dev/null ); then
    die 2 "NO TIP JUDGE (COULD NOT LOOK): the merge guard ${WRAPPER} loads (${GLMG_FOR_WRAPPER}) defines no tip-pipeline judge (glmg_tip_gate, DND-1941), or does not load, so the merge-time re-check of the ${GL_PROJECT} target tip's content (DND-1906) would not run" \
      "land DND-1941 (glab merge guard parity: red tip and content) in ~/dev/custom and fast-forward the main checkout, then re-run. Merging around it is lowering the merge bar, an owner decision (~/.claude/CLAUDE.md -> Owner approval policy, item 5). Nothing was locked or merged."
  fi
  echo "TIP-JUDGE ${GLMG_FOR_WRAPPER}: glmg_tip_gate runs inside the merge call"
fi

# ---- telemetry (DND-1475) ----
# merge.lock_wait (the time blocked in flock -w, acquired or timeout) and
# merge.landed (a merge confirm-merged confirmed: via=pr, the PR, the base
# before, the merge commit after) feed the lead-time ledger's lock-wait counter
# and its `merge` phase. Both are recorded where they happen and EMITTED from
# the EXIT trap, after fd 9 is closed, so the merge lock is never held while
# the writer runs. Fails open through ai/lib/telemetry-emit.sh: no exit code
# or stdout changes. A binding that will not load is no telemetry.
# Both carry the gated head (--head) and resolve their unit from the PR's head
# branch once it is read (--unit-branch), because this tool runs from a
# checkout whose own branch need not name the ticket; the ledger joins them to
# the landing by unit or head.
# On GitLab (DND-1943) only merge.lock_wait is written: the MR's merge.landed
# (via=mr) is glab-athena's to record (DND-1939), and a second one would count
# the landing twice. glab-athena's record runs inside the merge call, so
# while the merge lock is held (ai/lib/glab-landing.sh, its cost residual).
# lead-time-phases starts a GitLab MR's merge phase from this lock_wait.
LM_TEL_LIB="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../../lib/telemetry-emit.sh"
# shellcheck source=../../../lib/telemetry-emit.sh
if ! . "${LM_TEL_LIB}" 2>/dev/null; then
  athena_telemetry_emit() { :; }; athena_telemetry_now() { :; }
  athena_telemetry_clock_us() { :; }; athena_telemetry_seconds_since() { :; }
fi
LM_WAIT_AT=""; LM_WAIT_S=""; LM_WAIT_OUTCOME=""; LM_LANDED_AT=""; LM_LANDED_AFTER=""; LM_BEFORE=""
LM_UNIT_BRANCH=""
lm_emit() {
  local -a base=( --head "${HEAD_SHA}" ) opt=()
  exec 9>&-
  # The writer reads repo (and, with no --unit-branch, unit) from its cwd: the
  # repo being merged.
  cd "${REPO}" 2>/dev/null || return 0
  [ -n "${LM_UNIT_BRANCH}" ] && base+=( --unit-branch "${LM_UNIT_BRANCH}" )
  if [ -n "${LM_WAIT_OUTCOME}" ]; then
    opt=( "${base[@]}" )
    [ -n "${LM_WAIT_AT}" ] && opt+=( --at "${LM_WAIT_AT}" )
    [ -n "${LM_WAIT_S}" ] && opt+=( --duration "${LM_WAIT_S}" )
    athena_telemetry_emit --event merge.lock_wait --attr "lock=${LM_LOCK_KIND}" --attr "outcome=${LM_WAIT_OUTCOME}" "${opt[@]}"
  fi
  if [ -n "${LM_LANDED_AFTER}" ]; then
    opt=( "${base[@]}" )
    [ -n "${LM_LANDED_AT}" ] && opt+=( --at "${LM_LANDED_AT}" )
    [ -n "${LM_BEFORE}" ] && opt+=( --attr "before=${LM_BEFORE}" )
    athena_telemetry_emit --event merge.landed --attr via=pr --attr "pr=${PR}" --attr "after=${LM_LANDED_AFTER}" "${opt[@]}"
  fi
  return 0
}
trap lm_emit EXIT

# ---- the critical section ----
exec 9>>"${LOCK}"
LM_WAIT_AT="$(athena_telemetry_now)"; lm_t0="$(athena_telemetry_clock_us)"
if flock -w "${WAIT}" 9; then LM_WAIT_OUTCOME=acquired; else LM_WAIT_OUTCOME=timeout; fi
LM_WAIT_S="$(athena_telemetry_seconds_since "${lm_t0}")"
if [ "${LM_WAIT_OUTCOME}" = timeout ]; then
  held="$(date -u -r "${LOCK}" +%FT%TZ 2>/dev/null || echo unknown)"
  die 6 "timed out after ${WAIT}s waiting for ${LOCK} (last touched ${held})" \
    "another merge holds the lock; retry later. Never delete the lock file -- a held flock is a live merge."
fi
touch "${LOCK}" 2>/dev/null || true

"${FORGE_GIT}" -C "${REPO}" fetch -q origin \
  || die 3 "git fetch origin (forge-git) failed" "check the network and the forge wrapper's credentials (ai/bin/forge-preflight), then re-run; nothing was merged."

if [ "${FORGE}" = github ]; then
  pr_json="$(cd "${REPO}" && gh pr view "${PR}" --json state,headRefOid,headRefName,baseRefName 2>/dev/null)" \
    || die 2 "gh pr view ${PR} failed" "check gh auth and that PR ${PR} exists in this repo; nothing was merged."
  state="$(jq -r '.state // empty' <<<"${pr_json}")"
  pr_head="$(jq -r '.headRefOid // empty' <<<"${pr_json}")"
  base="$(jq -r '.baseRefName // empty' <<<"${pr_json}")"
  # The PR's head branch names the work (a ticket branch): telemetry's unit.
  LM_UNIT_BRANCH="$(jq -r '.headRefName // empty' <<<"${pr_json}")"
  [ -n "${state}" ] && [ -n "${pr_head}" ] && [ -n "${base}" ] \
    || die 2 "gh pr view ${PR} returned no state/head/base" "check gh auth; an empty answer is not a PR."
  OPEN_STATE=OPEN
else
  gl_err="$(mktemp)" || die 2 "COULD NOT LOOK: mktemp failed" "check that \$TMPDIR is writable; nothing was merged."
  pr_json="$(cd "${REPO}" && gl_api "projects/${GL_ENC}/merge_requests/${MR}" 2>"${gl_err}")"; mr_rc=$?
  mr_why="$(head -3 "${gl_err}" | tr '\n' ' ')"; rm -f "${gl_err}"
  [ "${mr_rc}" -eq 0 ] || die 2 "COULD NOT LOOK: glab api projects/${GL_ENC}/merge_requests/${MR} failed (exit ${mr_rc}): ${mr_why}" \
    "check glab auth for gitlab.com and that !${MR} exists in ${GL_PROJECT}; nothing was merged."
  jq -e --argjson i "${MR}" 'type == "object" and .iid == $i' <<<"${pr_json}" >/dev/null 2>&1 \
    || die 2 "COULD NOT LOOK: the read of !${MR} did not return MR !${MR}: $(head -c 200 <<<"${pr_json}" | tr '\n' ' ')" "check glab auth; an answer for another MR is not this MR. Nothing was merged."
  state="$(jq -r '.state // empty' <<<"${pr_json}")"
  pr_head="$(jq -r '.sha // empty' <<<"${pr_json}")"
  base="$(jq -r '.target_branch // empty' <<<"${pr_json}")"
  LM_UNIT_BRANCH="$(jq -r '.source_branch // empty' <<<"${pr_json}")"
  [ -n "${state}" ] && [ -n "${pr_head}" ] && [ -n "${base}" ] \
    || die 2 "COULD NOT LOOK: the read of !${MR} has no state/sha/target_branch" "check glab auth; an empty answer is not an MR. Nothing was merged."
  # A fork MR's head lives in another project, whose own pipeline the merge
  # guard would read as the head's. Most restrictive: refuse it here.
  jq -e '(.source_project_id | type) == "number" and .source_project_id == .target_project_id' <<<"${pr_json}" >/dev/null 2>&1 \
    || die 2 "!${MR} comes from another project (source_project_id $(jq -r '.source_project_id' <<<"${pr_json}") is not the target's $(jq -r '.target_project_id' <<<"${pr_json}"))" \
         "push the branch into ${GL_PROJECT} itself and open the MR from there, then gate and merge that MR. Nothing was merged."
  OPEN_STATE=opened
fi

[ "${state}" = "${OPEN_STATE}" ] || die 3 "${CH_NAME} is ${state}, not ${OPEN_STATE}" "if it merged, run confirm-merged; otherwise reopen it before merging."
[ "${pr_head}" = "${HEAD_SHA}" ] \
  || die 3 "${CH_NAME} head is ${pr_head}, not the gated ${HEAD_SHA}" "re-run integration-gate on the new head and pass its SHA."

B="$(git -C "${REPO}" rev-parse --verify -q "refs/remotes/origin/${base}^{commit}")" \
  || die 2 "origin/${base} does not resolve after fetch" "check the PR's base branch exists on origin."
git -C "${REPO}" cat-file -e "${HEAD_SHA}^{commit}" 2>/dev/null \
  || die 3 "gated head ${HEAD_SHA} is not in the local object store" "fetch the PR branch in this worktree and re-run integration-gate."

# ---- the gate's receipt for exactly this head, on the tip or an ancestor ----
# DND-965 made the receipt required; DND-1463 (owner, 2026-10-01) accepts one
# recorded against an ANCESTOR of the tip, so a merge that landed while this PR
# waited no longer forces a full re-gate. The outcomes stay textually distinct,
# because "the gate never passed" and "I could not read whether it did" call
# for different next steps (~/dev/custom/ai/CLAUDE.md -> "A failed lookup must
# never look like an empty one"). Every one refuses before the merge call.
REGATE="run integration-gate on this head (from any checkout of this repo, with origin/${base} at ${B}), then re-run locked-merge with the SHA its INTEGRATION OK line names."
if ! ir_read_receipt "${COMMON}" "${HEAD_SHA}" "${B}"; then
  die 9 "${IR_KIND}: ${IR_WHY}" "${IR_HOW:+${IR_HOW} }${REGATE}"
fi
R="${IR_BASE}"
# integration-gate records only a base the head contains. A receipt whose base
# the head does not contain describes a run that never happened on this head.
git -C "${REPO}" merge-base --is-ancestor "${R}" "${HEAD_SHA}" 2>/dev/null; anc_rc=$?
case "${anc_rc}" in
  0) ;;
  1) die 9 "RECEIPT INVALID: ${IR_RECEIPT} records base ${R}, which the head ${HEAD_SHA} does not contain; integration-gate never records such a base" \
       "${REGATE}" ;;
  *) die 9 "RECEIPT BASE UNKNOWN (COULD NOT LOOK): git merge-base --is-ancestor ${R} ${HEAD_SHA} failed (exit ${anc_rc}), so whether the head contains the receipt's base is unknown" \
       "check that ${R} and ${HEAD_SHA} are commits in this repo (git -C ${REPO} cat-file -t <sha>); if the receipt's base is gone, ${REGATE}" ;;
esac
echo "RECEIPT ${IR_RECEIPT} base ${R} recorded ${IR_RECORDED_AT}"
if [ "${R}" = "${B}" ]; then
  echo "BASE origin/${base} ${B} is the gated base"
else
  echo "BASE MOVED origin/${base} ${B}: the receipt's base ${R} is an ancestor; the head merged with ${R}..${B} was never gated (DND-1463, owner-accepted)"
fi

# ---- the expected squash tree, computed before the merge call (DND-1463) ----
# GitHub's squash tree is the head merged into the base tip (merge-ort). When
# R == B the head contains B and this is the head's own tree, the pre-DND-1463
# check. When main moved, it is the head merged with R..B. Step 7 compares the
# landed tree against it, so a forge that lands something else still reads as
# LANDED UNGATED. A conflict here is refused now, before anything lands.
# stdout and stderr are read apart: a warning on stderr (a rename-limit notice)
# must never be taken for the tree id or a conflicted path.
mt_err="$(mktemp)" || die 2 "COULD NOT LOOK: mktemp failed" "check that \$TMPDIR is writable; nothing was merged."
mt_out="$(git -C "${REPO}" merge-tree --write-tree --name-only "${B}" "${HEAD_SHA}" 2>"${mt_err}")"; mt_rc=$?
mt_why="$(head -3 "${mt_err}" | tr '\n' ' ')"; rm -f "${mt_err}"
case "${mt_rc}" in
  0) EXPECTED_TREE="$(head -1 <<<"${mt_out}")" ;;
  1) die 3 "CONFLICT: the head ${HEAD_SHA} conflicts with origin/${base} at ${B} in: $(sed -n '2,/^$/p' <<<"${mt_out}" | grep -v '^$' | sort -u | tr '\n' ' ')" \
       "merge origin/${base} into the PR branch (never rebase a published branch), resolve the conflict, push as Athena, re-run integration-gate on the new head, wait for CI green, then re-run locked-merge. Nothing was merged." ;;
  *) die 2 "COULD NOT LOOK: git merge-tree ${B} ${HEAD_SHA} failed (exit ${mt_rc}): ${mt_why}" \
       "check git >= 2.38 (merge-tree --write-tree) and that both commits are local; nothing was merged." ;;
esac
[[ "${EXPECTED_TREE}" =~ ^[0-9a-f]{40}$ ]] \
  || die 2 "COULD NOT LOOK: git merge-tree printed no tree id (got '${EXPECTED_TREE}')" \
       "check git >= 2.38 (merge-tree --write-tree); nothing was merged."
echo "EXPECTED-TREE ${EXPECTED_TREE} (${HEAD_SHA} merged into ${B})"

# ---- required-idle workflow, keyed on the base SHA (DND-1378) ----
# A single base-branch list read can miss the run for the commit that just
# landed (not listed yet, or a stale list), and "no live run listed" then read
# as idle: gen_saas #562 merged during #579's deploy. So the base commit's OWN
# run is looked up by SHA and re-read by id; a run that cannot be found is
# NOT SEEN YET / NO RUN FOR BASE, never idle (ai/CLAUDE.md -> "A failed lookup
# must never look like an empty one"). The base-branch count stays on top, so a
# re-run of an older run still holds. The base run's conclusion is printed. A
# failed deploy that reports on B is named by the red-tip check below, which
# never refuses a red run (DND-2061); a non-success that check does not see is
# a WARN here.
BASE_RUN_GRACE_S=600
idle_check() {
  local wf="$1" commit_json ids id view st conc now ct age msg marker branch_json live
  commit_json="$(cd "${REPO}" && gh run list --workflow "${wf}" --commit "${B}" --event push --limit 20 \
                  --json databaseId,status,conclusion,headSha,createdAt 2>/dev/null)" \
    || die 2 "COULD NOT LOOK: gh run list --workflow ${wf} --commit ${B} failed" \
         "check the workflow file name, gh auth, and that gh supports 'run list --commit' (gh >= 2.x). Could-not-read is never idle; nothing was merged."
  jq -e 'type == "array"' <<<"${commit_json}" >/dev/null 2>&1 \
    || die 2 "COULD NOT LOOK: gh run list --commit returned non-JSON" "check gh auth; nothing was merged."
  jq -e --arg b "${B}" 'all(.[]; .headSha == $b)' <<<"${commit_json}" >/dev/null \
    || die 2 "COULD NOT LOOK: gh run list --commit ${B} returned a run for another SHA" \
         "gh ignored --commit (upgrade gh). A list keyed on the wrong SHA is never idle; nothing was merged."
  ids="$(jq -r '.[].databaseId' <<<"${commit_json}")"
  local base_run="" base_conc=""
  for id in ${ids}; do
    view="$(cd "${REPO}" && gh run view "${id}" --json databaseId,status,conclusion,headSha 2>/dev/null)" \
      || die 2 "COULD NOT LOOK: gh run view ${id} failed" "check gh auth; nothing was merged."
    jq -e --arg b "${B}" --argjson i "${id}" '.databaseId == $i and .headSha == $b' <<<"${view}" >/dev/null 2>&1 \
      || die 2 "COULD NOT LOOK: gh run view ${id} did not return run ${id} for ${B}" "check gh auth; nothing was merged."
    st="$(jq -r '.status' <<<"${view}")"; conc="$(jq -r '.conclusion // ""' <<<"${view}")"
    [ "${st}" = completed ] || die 5 "BASE DEPLOY BUSY: ${wf} run ${id} for base ${B} is ${st}" \
      "wait with ~/dev/custom/ai/bin/gh-ci-wait --repo <owner>/<repo> --run-id ${id} --sha ${B} (a 60 s poll on the App budget, DND-1706), then re-run locked-merge; nothing was merged."
    [ -n "${base_run}" ] || { base_run="${id}"; base_conc="${conc}"; }
  done
  if [ -z "${base_run}" ]; then
    now="$(date +%s)"; ct="$(git -C "${REPO}" show -s --format=%ct "${B}")"; age=$(( now - ct ))
    msg="$(git -C "${REPO}" show -s --format=%B "${B}")"
    marker="$(grep -o -i -E '\[(skip ci|ci skip|no ci|skip actions|actions skip)\]|^skip-checks: *true' <<<"${msg}" | head -1)"
    if [ "${age}" -lt "${BASE_RUN_GRACE_S}" ]; then
      die 5 "NOT SEEN YET: no ${wf} run for base ${B} (committed ${age}s ago; GitHub lists a push's run after a delay)" \
        "retry in a minute. A missing run is never idle; nothing was merged."
    elif [ -n "${marker}" ]; then
      echo "BASE-RUN none: ${B} carries '${marker}', no run expected; idle judged by the ${base} run list alone"
    else
      die 5 "NO RUN FOR BASE: ${B} has no ${wf} push run ${age}s after commit" \
        "find on the forge why the push started no run (workflow disabled, Actions outage, a skip marker this check does not know); re-run once a run exists. Merging without --require-idle-workflow is an owner decision (~/.claude/CLAUDE.md -> Owner approval policy, item 5). Nothing was merged."
    fi
  fi
  branch_json="$(cd "${REPO}" && gh run list --workflow "${wf}" --branch "${base}" --limit 100 \
                  --json databaseId,status,headSha 2>/dev/null)" \
    || die 2 "COULD NOT LOOK: gh run list --workflow ${wf} --branch ${base} failed" "check the workflow file name and gh auth; nothing was merged."
  jq -e 'type == "array"' <<<"${branch_json}" >/dev/null 2>&1 \
    || die 2 "COULD NOT LOOK: gh run list --branch returned non-JSON" "check gh auth; nothing was merged."
  live="$(jq -r '[.[] | select(.status != "completed") | .databaseId] | map(tostring) | join(" ")' <<<"${branch_json}")"
  [ -z "${live}" ] || die 5 "${base} BUSY: ${wf} has queued/in-progress run(s): ${live}" \
    "wait for each run with ~/dev/custom/ai/bin/gh-ci-wait --repo <owner>/<repo> --run-id <id> (a 60 s poll on the App budget, DND-1706), then re-run; nothing was merged."
  if [ -n "${base_run}" ]; then
    echo "IDLE ${wf} base ${B}: BASE-RUN ${base_run} completed/${base_conc}; ${base} list counted $(jq length <<<"${branch_json}") runs, none live"
    [ "${base_conc}" = success ] || echo "WARN base deploy ${base_run} for ${B} concluded ${base_conc:-unknown}; the stop-the-line check next reads ${B}'s own runs and names a red one, without refusing it (DND-2061; athena:merge-boarding -> The merge bar, step Stop the line)"
  fi
}
[ -z "${IDLE_WF}" ] || idle_check "${IDLE_WF}"

# ---- stop the line: a red base tip (DND-1902) ----
# gen_saas 2026-10-03: main went red at 14:06Z and a merge landed onto it at
# 14:23Z, because stop-the-line was a message that arrived a minute late. The
# tip B's own runs and its content are read here, under the lock, with
# gh-athena's judge (ai/lib/gh-merge-guard.sh -> gmg_line_check); the guard
# reads them again. It runs AFTER the idle check, so a deploy that check
# waited out is read concluded, not pending.
if [ "${FORGE}" = github ]; then
  [[ "${ORIGIN_URL}" =~ github\.com[:/]+([^/]+)/([^/]+)$ ]] \
    || die 2 "COULD NOT LOOK: origin '${ORIGIN_URL}' names no <owner>/<repo>, so the base tip's runs cannot be read" \
         "set origin to the GitHub repo's URL (https://github.com/<owner>/<repo>.git); nothing was merged."
  GH_OWNER="${BASH_REMATCH[1]}"; GH_REPO="${BASH_REMATCH[2]%.git}"
  if gmg_line_check "${GH_OWNER}" "${GH_REPO}" "origin/${base}" "${B}" "${HEAD_SHA}" "${REPO}"; then tip_rc=0; else tip_rc=$?; fi
  case "${tip_rc}" in
    0) echo "${GMG_LINE_NOTE}" ;;
    1) die 11 "${GMG_LINE_WHY}" "$(gmg_line_fix "${GH_OWNER}" "${GH_REPO}" "${base}" "${B}"), then re-run locked-merge. Nothing was merged." ;;
    *) die 2 "${GMG_LINE_WHY}" \
         "make the tip's content readable (git fetch origin; fix the declaration if the message names it), then re-run locked-merge. The tip's runs are never the cause (a note, DND-2061); nothing was merged." ;;
  esac
else
  # GitLab (DND-1943): the tip's CONTENT is forge-free (git and
  # ai/config/main-content-checks.json, looked up by <namespace>/<project> in
  # each product's paths; an undeclared path of a declared product is COULD
  # NOT LOOK, DND-2034), so the
  # same shared judge reads it here. The tip's PIPELINES are judged inside the
  # merge call by glab-athena's guard (DND-1941); its refusal is classified
  # below, after the call, exactly as gh-athena's is.
  if gmg_content_health "${GL_PROJECT%/*}" "${GL_PROJECT##*/}" "${B}" "${HEAD_SHA}" "${REPO}"; then tip_rc=0; else tip_rc=$?; fi
  case "${tip_rc}" in
    0) case "${GMG_CONTENT_STATE}" in
         NONE) echo "BASE-TIP origin/${base} ${B} content: $(gmg_content_none_note); its pipelines are judged by the merge guard (DND-1941)" ;;
         CLEAN) echo "BASE-TIP origin/${base} ${B} content: no duplicated migration version (${GMG_CONTENT_COUNTS}); its pipelines are judged by the merge guard (DND-1941)" ;;
         FIX) echo "BASE-TIP origin/${base} ${B} content: RED-MAIN FIX: the tip holds a duplicated migration version and the head removes it:
${GMG_CONTENT_DUPS}" ;;
       esac ;;
    1) die 11 "${GMG_RED_MARK} origin/${base} tip ${B} is RED, so the line is stopped (DND-1902).
  Duplicated migration version(s) (ai/config/main-content-checks.json):
${GMG_CONTENT_DUPS}
  The head ${HEAD_SHA} is not a red-main fix: it must contain ${B} and remove every duplicate." \
         "land only a red-main fix: a head that contains ${B}, removes every duplicate named above, and carries its own INTEGRATION OK receipt (merge origin/${base} into it, fix it, push as Athena, re-gate), then re-run locked-merge. Every other MR waits until that fix lands on ${base}. Nothing was merged." ;;
    *) die 2 "${GMG_LOOK_MARK} whether the origin/${base} tip ${B} is red cannot be told: ${GMG_CONTENT_WHY}" \
         "make the tip readable (git fetch origin; fix the declaration if the message names it: an undeclared path of a declared product is added to that entry's paths in ~/dev/custom/ai/config/main-content-checks.json, landed on custom main), then re-run locked-merge. Could-not-read is never green; nothing was merged." ;;
  esac
fi

# ---- the merged tree must not break main either (DND-1902) ----
# gen_saas #767 and #771 each added an athena migration with one version; the
# duplicate existed only once both had landed. A receipt on an older base is
# accepted (DND-1463), so the squash tree computed above is the first place
# the two meet: read it against the same declaration.
if [ "${GMG_CONTENT_STATE}" != NONE ]; then
  if gmg_mig_dups "${REPO}" "${EXPECTED_TREE}" "${GMG_CONTENT_RE}"; then mt_rc=0; else mt_rc=$?; fi
  if [ "${mt_rc}" != 0 ]; then
    gmg_dups_why "${mt_rc}" "the expected squash tree ${EXPECTED_TREE}"
    die 2 "COULD NOT LOOK: ${GMG_CONTENT_WHY}" "fix what the message names, then re-run locked-merge; nothing was merged."
  fi
  [ -z "${GMG_DUPS}" ] || die 3 "SEMANTIC CONFLICT: ${HEAD_SHA} merged into origin/${base} at ${B} holds duplicated migration version(s) (ai/config/main-content-checks.json):
$(sed 's/^/    /' <<<"${GMG_DUPS}")" \
    "merge origin/${base} into the PR branch (never rebase a published branch), renumber this PR's migration to a version no other migration in its directory holds, push as Athena, re-run integration-gate, then re-run locked-merge. Nothing was merged."
  echo "MERGED-TREE content: no duplicated migration version (${GMG_DUP_NDIRS} director(ies), ${GMG_DUP_NFILES} migration(s) read)"
fi

# confirm_landed <tries> -- confirm-merged, bounded; sets confirmed=1 on a landing.
confirmed=""
confirm_landed() {
  local i
  for i in $(seq 1 "$1"); do
    if "${AI_BIN}/confirm-merged" "${CH_FLAG}" "${CH}" --repo "${REPO}" --fetch >/dev/null 2>&1; then confirmed=1; return 0; fi
    [ "${i}" -lt "$1" ] && sleep "${LOCKED_MERGE_CONFIRM_SLEEP:-20}"
  done
  return 1
}

# A failed merge call does not mean nothing landed (DND-1324: GitHub answered
# 502 after the squash landed, and exit 4 said "nothing was merged"). Ask the
# forge before claiming either; a landing goes on to the same checks below.
merge_err="$(mktemp)" || die 2 "COULD NOT LOOK: mktemp failed" "check that \$TMPDIR is writable; nothing was merged."
merge_rc=0
if [ "${FORGE}" = github ]; then
  ( cd "${REPO}" && "${AI_BIN}/gh-athena" pr merge "${PR}" --squash --match-head-commit "${HEAD_SHA}" ) 2>"${merge_err}" || merge_rc=$?
else
  # Run from the checkout: the guard reads the receipt from its git common
  # dir. --auto-merge=false: glab defaults auto-merge on, and a merge GitLab
  # deferred until a pipeline finished would land outside this lock.
  ( cd "${REPO}" && "${AI_BIN}/glab-athena" mr merge "${MR}" -R "${GL_PROJECT}" --squash --sha "${HEAD_SHA}" --auto-merge=false --yes ) 2>"${merge_err}" || merge_rc=$?
fi
cat "${merge_err}" >&2
merge_red="" merge_look=""
if [ "${merge_rc}" -ne 0 ] && gmg_refusal_has_reason "${merge_err}" "${GMG_RED_MARK}"; then merge_red=1; fi
# DND-1907: the guard could not look (tip runs, tree, content, or the gate
# declaration). Red outranks it, as in the guard. Nothing landed either.
if [ -z "${merge_red}" ] && [ "${merge_rc}" -ne 0 ] && gmg_refusal_has_reason "${merge_err}" "${GMG_LOOK_MARK}"; then merge_look=1; fi
rm -f "${merge_err}"
# DND-1906: the tip turned red between the check above and the guard's own
# re-check. The guard refused before any call to the forge, so nothing landed:
# exit 11 at once, with no confirm retries (they read as exit 4).
[ -z "${merge_red}" ] || die 11 "${GMG_RED_MARK} the merge guard refused ${CH_NAME}: ${base}'s content went red after the check above; its message is above" \
  "land only a red-main fix: a head that contains the red tip the guard names above (not ${B}, which this tool read before the tip moved), removes every duplicate it names, and carries its own INTEGRATION OK receipt; re-run integration-gate on it, then re-run locked-merge. Every other ${CH_NAME%% *} waits until that fix lands on ${base}. Nothing was merged."
# DND-1907: exit 2 at once, with no confirm retries (they read as exit 4).
[ -z "${merge_look}" ] || die 2 "${GMG_LOOK_MARK} the merge guard refused ${CH_NAME} because it could not look (at ${base}, or at what its message above names)" \
  "read the guard's own Fix: above, fix what it could not read (${READER} auth, the checkout), then re-run locked-merge. Nothing was merged."
if [ "${merge_rc}" -ne 0 ]; then
  confirm_landed 3 \
    || die 4 "${MERGE_CALL} refused or failed, and confirm-merged does not show it landed" \
         "read the wrapper's own Fix: above (checks not green, conflict). If it was a forge error (5xx, timeout), check the ${CH_NAME%% *} on the forge before re-running."
  echo "locked-merge: the merge call failed, but ${CH_NAME} landed (confirm-merged); verifying it like any other merge" >&2
fi

[ -n "${confirmed}" ] || confirm_landed 6
[ -n "${confirmed}" ] || die 8 "merge of ${CH_NAME} ran but confirm-merged did not confirm it" \
  "check the ${CH_NAME%% *} on the forge by hand; do not retry the merge blind."

if [ "${FORGE}" = github ]; then
  M="$(cd "${REPO}" && gh pr view "${PR}" --json mergeCommit -q '.mergeCommit.oid // empty' 2>/dev/null)"
else
  # The commit main gained: the merge commit, or on a fast-forward project
  # (no merge commit) the squash commit.
  M="$(cd "${REPO}" && gl_api "projects/${GL_ENC}/merge_requests/${MR}" 2>/dev/null | jq -r '.merge_commit_sha // .squash_commit_sha // empty' 2>/dev/null)"
fi
[ -n "${M}" ] || die 8 "${CH_NAME} reports no merge commit" "check the ${CH_NAME%% *} on the forge by hand; do not retry the merge blind."
# Confirmed landed (confirm-merged), with its merge commit: that is the event,
# whatever the parent/tree checks below then say about it. GitHub only: on
# GitLab glab-athena records it (DND-1939).
if [ "${FORGE}" = github ] && [[ "${M}" =~ ^[0-9a-f]{40}$ ]]; then
  LM_LANDED_AT="$(athena_telemetry_now)"; LM_LANDED_AFTER="${M}"; LM_BEFORE="${B}"
fi
"${FORGE_GIT}" -C "${REPO}" fetch -q origin 2>/dev/null
git -C "${REPO}" cat-file -e "${M}^{commit}" 2>/dev/null \
  || die 8 "merge commit ${M} not fetchable" "fetch origin and compare ${M}^{tree} with the expected tree ${EXPECTED_TREE} by hand."
parent="$(git -C "${REPO}" rev-parse "${M}^1")"
[ "${parent}" = "${B}" ] || die 7 "LANDED UNGATED: merge ${M} sits on ${parent}, not the checked base ${B}" \
  "re-run the gate on origin/${base} now and report the ungated landing to the coordinator."
[ "$(git -C "${REPO}" rev-parse "${M}^{tree}")" = "${EXPECTED_TREE}" ] \
  || die 7 "LANDED UNGATED: merge ${M}'s tree differs from the expected tree ${EXPECTED_TREE} (${HEAD_SHA} merged into ${B})" \
       "re-run the gate on origin/${base} now and report the ungated landing to the coordinator."

echo "MERGED ${CH} ${M} ON ${B} TREE-MATCH"

# ---- merge-driven teardown (DND-864) ----
# The landing is confirmed, so the merged branch's worktree stack goes now,
# per PR: a multi-part Mission reclaims each part's stack as that part lands.
# teardown-stack re-confirms the merge, finds the ONE worktree with the PR's
# head branch, and refuses anything it cannot attribute. A stack whose
# containers are already gone is attributed by the stack marker integration-gate
# recorded in the worktree's git dir (DND-1576). Release the merge lock first:
# a teardown is not part of the critical section.
exec 9>&-
if ! "${AI_BIN}/teardown-stack" "${CH_FLAG}" "${CH}" --repo "${REPO}"; then
  die 10 "${CH_NAME} LANDED, but teardown-stack could not tear down its worktree stack" \
    "the merge is done; do not re-merge. Read teardown-stack's Fix: above, then re-run ${AI_BIN}/teardown-stack ${CH_FLAG} ${CH} --repo ${REPO}."
fi
exit 0
