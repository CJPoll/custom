#!/usr/bin/env bash
# locked-merge -- merge one GitHub PR inside the repo's merge critical section.
#
# Why this exists: a GitHub squash-merge does NOT refuse when the base moved
# after integration-gate ran. With no textual conflict it lands a tree nobody
# gated. Check-then-merge is a TOCTOU (gen_saas 2026-09-23: AM-2's squash
# landed on DND-347's merge a minute later, integrated head ungated). Six fleets
# then hand-rolled the same flock recipe from prose. This is that recipe.
#
# DND-1463 (owner, 2026-10-01): a base that moved on past the gated base is now
# accepted, a deliberate velocity trade ("The velocity increase is worth the
# risk of incompatible concurrent merges."). The lock still serialises merges;
# a conflict is still refused; and the landed tree must still equal the merge
# this script computed under the lock, so the forge cannot land anything else.
#
# It ADDS refusals in front of an existing pinned merge and replaces none:
# integration-gate still runs first, merges stay one at a time, gh-athena's
# all-green refusal stays the green check, confirm-merged still runs.
#
# "integration-gate runs first" is ENFORCED, not trusted (DND-965). gen_saas
# #468 merged past a RED gate because a prep script printed READY without
# reading the exit code, and nothing here asked. Now the merge requires the
# gate's own receipt for exactly --head, recorded against the base re-checked
# under the lock or an ancestor of it (DND-1463: owner, 2026-10-01, "Let's
# soften that merge guard requirement."). There is deliberately no flag or env var that
# skips it (~/dev/custom/CLAUDE.md -> "A check's own bar must not live in the
# diff it is checking"); the only owner override is integration-gate's own
# --owner-approval, which the receipt records.
#
# Doctrine: ai/skills/athena:merge-boarding/SKILL.md -> Landing onto a moving main.
# Self-test: ai/skills/athena:merge-boarding/test/locked-merge/self-test.sh
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SKILL_DIR="$(dirname "${HERE}")"

# The receipt reader is shared with gh-athena's merge guard and the writer
# (integration-gate), so the three cannot drift (DND-969).
IR_LIB="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../../lib/integration-receipt.sh"
# shellcheck source=../../../lib/integration-receipt.sh
if ! . "${IR_LIB}" 2>/dev/null; then
  printf 'locked-merge: cannot load %s\nFix: run locked-merge from its committed path in a full ~/dev/custom checkout (ai/skills and ai/lib side by side).\n' "${IR_LIB}" >&2
  exit 2
fi

usage() {
  cat <<'EOF'
locked-merge -- merge one GitHub PR under the repo's merge lock.

Usage:
  locked-merge --pr <n> --head <sha> [--repo DIR] [--lock PATH] [--wait SECS]
               [--require-idle-workflow <workflow-file>]
  locked-merge --help | --self-test

Run integration-gate first; pass the SHA its INTEGRATION OK line names as
--head. Under an flock (default ~/.local/state/athena/<repo>-merge.lock, the
path fleets already share) it:
  1. fetches origin and reads the PR (must be OPEN, head == --head);
  2. requires integration-gate's RECEIPT for --head, at
     <git common dir>/integration-receipts/<head>.json: verdict pass, head ==
     --head, and a recorded base R that is the current origin/<base> SHA B or
     an ANCESTOR of it (DND-1463), and that --head contains. No flag skips
     this; integration-gate writes it only on INTEGRATION OK. When R != B it
     prints BASE MOVED: the head merged with R..B was never gated;
  3. computes the expected squash tree, git merge-tree B --head (the head's
     own tree when R == B). A conflict is refused here (exit 3);
  4. with --require-idle-workflow <workflow-file>, keyed on the base SHA B
     (DND-1378): the base commit's own push run, looked up by SHA and
     re-read by id, must be completed, and the <base> run list must show no
     queued/running run. No run for the base SHA is NOT SEEN YET (under 600s)
     or NO RUN FOR BASE (exit 5), never idle, unless the commit carries a skip
     marker ([skip ci] and kin). Any read it cannot make is COULD NOT LOOK
     (exit 2). The base run's conclusion is printed; a non-success is a WARN;
  5. merges via gh-athena pr merge --squash --match-head-commit <head> (no --auto);
  6. confirm-merged --pr <n> --fetch (bounded retry), also after a failed
     merge call, which can still have landed (DND-1324);
  7. asserts the merge commit's parent == B and its tree == the expected
     tree from step 3;
  8. releases the lock and runs teardown-stack --pr <n> --repo DIR, which
     tears down the PR's worktree stack (DND-864).

Exit (every non-zero prints a Fix: line):
  0 merged, confirmed, tree matches          (landed)
  2 usage / prerequisite / non-GitHub remote (nothing landed)
  3 stale: PR not open, head moved, or CONFLICT with origin/<base> -- merge
    origin/<base> in, resolve, re-gate (nothing landed)
  4 forge refused the merge, and confirm-merged does not show it landed
    (a failed call that DID land is verified and reported as a merge)
  5 required-idle workflow busy, NOT SEEN YET or NO RUN FOR BASE -- retry later (nothing landed)
  6 lock wait timed out; the lock is never broken (nothing landed)
  7 LANDED UNGATED: parent or tree mismatch -- re-gate origin/main now, report it
  8 merge ran but landing not confirmed -- investigate, do not retry blind
  9 no usable integration-gate receipt for --head: NO RECEIPT, RECEIPT
    UNREADABLE (COULD NOT LOOK), RECEIPT INVALID, RECEIPT UNVERIFIED (not
    sealed by the landed gate, DND-1814), RECEIPT UNVERIFIABLE (COULD NOT
    LOOK), RECEIPT FOR ANOTHER BASE
    (recorded base not an ancestor of origin/<base>), or RECEIPT BASE
    UNKNOWN (COULD NOT LOOK) -- run integration-gate on this head (nothing landed)
  10 LANDED and confirmed, but the worktree stack teardown failed -- do not re-merge
EOF
}

die() { # <exit> <message> <fix>
  printf 'locked-merge: %s\nFix: %s\n' "$2" "$3" >&2
  exit "$1"
}

PR=""; HEAD_SHA=""; REPO="."; LOCK=""; WAIT=900; IDLE_WF=""
while [ $# -gt 0 ]; do
  case "$1" in
    --pr)   [ $# -ge 2 ] || die 2 "--pr needs a value" "pass --pr <number>."; PR="$2"; shift 2 ;;
    --head) [ $# -ge 2 ] || die 2 "--head needs a value" "pass --head <full sha from INTEGRATION OK>."; HEAD_SHA="$2"; shift 2 ;;
    --repo) [ $# -ge 2 ] || die 2 "--repo needs a value" "pass --repo <worktree dir>."; REPO="$2"; shift 2 ;;
    --lock) [ $# -ge 2 ] || die 2 "--lock needs a value" "pass --lock <absolute path>, or omit it for the default."; LOCK="$2"; shift 2 ;;
    --wait) [ $# -ge 2 ] || die 2 "--wait needs a value" "pass --wait <seconds>."; WAIT="$2"; shift 2 ;;
    --require-idle-workflow)
            [ $# -ge 2 ] || die 2 "--require-idle-workflow needs a value" "pass the workflow file name, e.g. post-merge.yml."
            IDLE_WF="$2"; shift 2 ;;
    --self-test) exec bash "${SKILL_DIR}/test/locked-merge/self-test.sh" ;;
    -h|--help) usage; exit 0 ;;
    *) die 2 "unknown argument: $1" "see --help; valid flags are --pr, --head, --repo, --lock, --wait, --require-idle-workflow, --self-test." ;;
  esac
done

# ---- resolve every key first; a key that cannot be computed is an error ----
case "${PR}" in ''|*[!0-9]*) die 2 "--pr must be a PR number (got '${PR}')" "pass --pr <number>." ;; esac
case "${HEAD_SHA}" in
  *[!0-9a-f]*|'') die 2 "--head must be a full lowercase hex SHA (got '${HEAD_SHA}')" "copy the SHA from integration-gate's INTEGRATION OK line." ;;
esac
[ "${#HEAD_SHA}" -eq 40 ] || die 2 "--head must be a full 40-char SHA (got ${#HEAD_SHA} chars)" "copy the full SHA from integration-gate's INTEGRATION OK line."
case "${WAIT}" in ''|*[!0-9]*) die 2 "--wait must be whole seconds (got '${WAIT}')" "pass --wait <seconds>." ;; esac

REPO="$(cd "${REPO}" 2>/dev/null && pwd)" || die 2 "--repo is not a directory" "pass --repo <the Mission's worktree>."
COMMON="$(git -C "${REPO}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
  || die 2 "${REPO} is not inside a git repository" "pass --repo <the Mission's worktree>."
case "${COMMON}" in
  /*/.git) ;;
  *) die 2 "git common dir '${COMMON}' is not an absolute <repo>/.git path" "run from a normal checkout or worktree of the repo (not a bare clone)." ;;
esac
REPO_NAME="$(basename "$(dirname "${COMMON}")")"

ORIGIN_URL="$(git -C "${REPO}" config --get remote.origin.url 2>/dev/null)" \
  || die 2 "no remote 'origin' in ${REPO}" "run from a checkout whose origin is the GitHub repo."
case "${ORIGIN_URL}" in
  *github.com[:/]*) ;;
  *) die 2 "origin '${ORIGIN_URL}' is not github.com" "GitLab repos merge through the merge train (athena:merge-boarding -> Boarding); this tool is for GitHub squash merges only." ;;
esac

LM_LOCK_KIND=explicit   # telemetry's closed `lock` label: never the caller's path
if [ -z "${LOCK}" ]; then
  LM_LOCK_KIND=default
  # Deliberately NOT $XDG_STATE_HOME: a second derivation would split the lock
  # silently (two admirals, two files, no exclusion).
  [ -n "${HOME:-}" ] || die 2 "HOME is unset, so the default lock path cannot be computed" "set HOME or pass --lock <absolute path>."
  LOCK="${HOME}/.local/state/athena/${REPO_NAME}-merge.lock"
fi
case "${LOCK}" in /*) ;; *) die 2 "--lock must be absolute (got '${LOCK}')" "pass an absolute --lock path." ;; esac
mkdir -p "$(dirname "${LOCK}")" || die 2 "cannot create $(dirname "${LOCK}")" "check permissions on the lock directory."
echo "LOCK ${LOCK}"

AI_BIN="${LOCKED_MERGE_AI_BIN:-$(cd "${SKILL_DIR}/../../bin" 2>/dev/null && pwd)}"
for t in gh-athena confirm-merged teardown-stack; do
  [ -x "${AI_BIN}/${t}" ] || die 2 "${AI_BIN}/${t} not found" "run this script from its home in ~/dev/custom/ai/skills/athena:merge-boarding/scripts/."
done
command -v gh >/dev/null 2>&1 || die 2 "gh (read-only forge CLI) not on PATH" "install gh; reads use plain gh."
command -v flock >/dev/null 2>&1 || die 2 "flock not on PATH" "install util-linux flock."
command -v jq >/dev/null 2>&1 || die 2 "jq not on PATH" "install jq; the PR state and the integration-gate receipt are read with it."

# ---- telemetry (DND-1475) ----
# merge.lock_wait (the time blocked in flock -w, acquired or timeout) and
# merge.landed (a merge confirm-merged confirmed: via=pr, the PR, the base
# before, the merge commit after) feed the lead-time ledger's lock-wait counter
# and its `merge` phase. Both are recorded where they happen and EMITTED from
# the EXIT trap, after fd 9 is closed, so the merge lock is never held while
# the writer runs. Fails open through ai/lib/telemetry-emit.sh: no exit code
# or stdout changes. A binding that will not load is no telemetry.
# Both carry the gated head (--head) and resolve their unit from the PR's head
# branch once it is read (--unit-branch), because this tool runs from a
# checkout whose own branch need not name the ticket; the ledger joins them to
# the landing by unit or head.
LM_TEL_LIB="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../../lib/telemetry-emit.sh"
# shellcheck source=../../../lib/telemetry-emit.sh
if ! . "${LM_TEL_LIB}" 2>/dev/null; then
  athena_telemetry_emit() { :; }; athena_telemetry_now() { :; }
  athena_telemetry_clock_us() { :; }; athena_telemetry_seconds_since() { :; }
fi
LM_WAIT_AT=""; LM_WAIT_S=""; LM_WAIT_OUTCOME=""; LM_LANDED_AT=""; LM_LANDED_AFTER=""; LM_BEFORE=""
LM_UNIT_BRANCH=""
lm_emit() {
  local -a base=( --head "${HEAD_SHA}" ) opt=()
  exec 9>&-
  # The writer reads repo (and, with no --unit-branch, unit) from its cwd: the
  # repo being merged.
  cd "${REPO}" 2>/dev/null || return 0
  [ -n "${LM_UNIT_BRANCH}" ] && base+=( --unit-branch "${LM_UNIT_BRANCH}" )
  if [ -n "${LM_WAIT_OUTCOME}" ]; then
    opt=( "${base[@]}" )
    [ -n "${LM_WAIT_AT}" ] && opt+=( --at "${LM_WAIT_AT}" )
    [ -n "${LM_WAIT_S}" ] && opt+=( --duration "${LM_WAIT_S}" )
    athena_telemetry_emit --event merge.lock_wait --attr "lock=${LM_LOCK_KIND}" --attr "outcome=${LM_WAIT_OUTCOME}" "${opt[@]}"
  fi
  if [ -n "${LM_LANDED_AFTER}" ]; then
    opt=( "${base[@]}" )
    [ -n "${LM_LANDED_AT}" ] && opt+=( --at "${LM_LANDED_AT}" )
    [ -n "${LM_BEFORE}" ] && opt+=( --attr "before=${LM_BEFORE}" )
    athena_telemetry_emit --event merge.landed --attr via=pr --attr "pr=${PR}" --attr "after=${LM_LANDED_AFTER}" "${opt[@]}"
  fi
  return 0
}
trap lm_emit EXIT

# ---- the critical section ----
exec 9>>"${LOCK}"
LM_WAIT_AT="$(athena_telemetry_now)"; lm_t0="$(athena_telemetry_clock_us)"
if flock -w "${WAIT}" 9; then LM_WAIT_OUTCOME=acquired; else LM_WAIT_OUTCOME=timeout; fi
LM_WAIT_S="$(athena_telemetry_seconds_since "${lm_t0}")"
if [ "${LM_WAIT_OUTCOME}" = timeout ]; then
  held="$(date -u -r "${LOCK}" +%FT%TZ 2>/dev/null || echo unknown)"
  die 6 "timed out after ${WAIT}s waiting for ${LOCK} (last touched ${held})" \
    "another merge holds the lock; retry later. Never delete the lock file -- a held flock is a live merge."
fi
touch "${LOCK}" 2>/dev/null || true

git -C "${REPO}" fetch -q origin \
  || die 3 "git fetch origin failed" "check the network/credentials, then re-run; nothing was merged."

pr_json="$(cd "${REPO}" && gh pr view "${PR}" --json state,headRefOid,headRefName,baseRefName 2>/dev/null)" \
  || die 2 "gh pr view ${PR} failed" "check gh auth and that PR ${PR} exists in this repo; nothing was merged."
state="$(jq -r '.state // empty' <<<"${pr_json}")"
pr_head="$(jq -r '.headRefOid // empty' <<<"${pr_json}")"
base="$(jq -r '.baseRefName // empty' <<<"${pr_json}")"
# The PR's head branch names the work (a ticket branch): telemetry's unit.
LM_UNIT_BRANCH="$(jq -r '.headRefName // empty' <<<"${pr_json}")"
[ -n "${state}" ] && [ -n "${pr_head}" ] && [ -n "${base}" ] \
  || die 2 "gh pr view ${PR} returned no state/head/base" "check gh auth; an empty answer is not a PR."

[ "${state}" = "OPEN" ] || die 3 "PR ${PR} is ${state}, not OPEN" "if it merged, run confirm-merged; otherwise reopen it before merging."
[ "${pr_head}" = "${HEAD_SHA}" ] \
  || die 3 "PR ${PR} head is ${pr_head}, not the gated ${HEAD_SHA}" "re-run integration-gate on the new head and pass its SHA."

B="$(git -C "${REPO}" rev-parse --verify -q "refs/remotes/origin/${base}^{commit}")" \
  || die 2 "origin/${base} does not resolve after fetch" "check the PR's base branch exists on origin."
git -C "${REPO}" cat-file -e "${HEAD_SHA}^{commit}" 2>/dev/null \
  || die 3 "gated head ${HEAD_SHA} is not in the local object store" "fetch the PR branch in this worktree and re-run integration-gate."

# ---- the gate's receipt for exactly this head, on the tip or an ancestor ----
# DND-965 made the receipt required; DND-1463 (owner, 2026-10-01) accepts one
# recorded against an ANCESTOR of the tip, so a merge that landed while this PR
# waited no longer forces a full re-gate. The outcomes stay textually distinct,
# because "the gate never passed" and "I could not read whether it did" call
# for different next steps (~/dev/custom/ai/CLAUDE.md -> "A failed lookup must
# never look like an empty one"). Every one refuses before the merge call.
REGATE="run integration-gate on this head (from any checkout of this repo, with origin/${base} at ${B}), then re-run locked-merge with the SHA its INTEGRATION OK line names."
if ! ir_read_receipt "${COMMON}" "${HEAD_SHA}" "${B}"; then
  die 9 "${IR_KIND}: ${IR_WHY}" "${IR_HOW:+${IR_HOW} }${REGATE}"
fi
R="${IR_BASE}"
# integration-gate records only a base the head contains. A receipt whose base
# the head does not contain describes a run that never happened on this head.
git -C "${REPO}" merge-base --is-ancestor "${R}" "${HEAD_SHA}" 2>/dev/null; anc_rc=$?
case "${anc_rc}" in
  0) ;;
  1) die 9 "RECEIPT INVALID: ${IR_RECEIPT} records base ${R}, which the head ${HEAD_SHA} does not contain; integration-gate never records such a base" \
       "${REGATE}" ;;
  *) die 9 "RECEIPT BASE UNKNOWN (COULD NOT LOOK): git merge-base --is-ancestor ${R} ${HEAD_SHA} failed (exit ${anc_rc}), so whether the head contains the receipt's base is unknown" \
       "check that ${R} and ${HEAD_SHA} are commits in this repo (git -C ${REPO} cat-file -t <sha>); if the receipt's base is gone, ${REGATE}" ;;
esac
echo "RECEIPT ${IR_RECEIPT} base ${R} recorded ${IR_RECORDED_AT}"
if [ "${R}" = "${B}" ]; then
  echo "BASE origin/${base} ${B} is the gated base"
else
  echo "BASE MOVED origin/${base} ${B}: the receipt's base ${R} is an ancestor; the head merged with ${R}..${B} was never gated (DND-1463, owner-accepted)"
fi

# ---- the expected squash tree, computed before the merge call (DND-1463) ----
# GitHub's squash tree is the head merged into the base tip (merge-ort). When
# R == B the head contains B and this is the head's own tree, the pre-DND-1463
# check. When main moved, it is the head merged with R..B. Step 7 compares the
# landed tree against it, so a forge that lands something else still reads as
# LANDED UNGATED. A conflict here is refused now, before anything lands.
# stdout and stderr are read apart: a warning on stderr (a rename-limit notice)
# must never be taken for the tree id or a conflicted path.
mt_err="$(mktemp)" || die 2 "COULD NOT LOOK: mktemp failed" "check that \$TMPDIR is writable; nothing was merged."
mt_out="$(git -C "${REPO}" merge-tree --write-tree --name-only "${B}" "${HEAD_SHA}" 2>"${mt_err}")"; mt_rc=$?
mt_why="$(head -3 "${mt_err}" | tr '\n' ' ')"; rm -f "${mt_err}"
case "${mt_rc}" in
  0) EXPECTED_TREE="$(head -1 <<<"${mt_out}")" ;;
  1) die 3 "CONFLICT: the head ${HEAD_SHA} conflicts with origin/${base} at ${B} in: $(sed -n '2,/^$/p' <<<"${mt_out}" | grep -v '^$' | sort -u | tr '\n' ' ')" \
       "merge origin/${base} into the PR branch (never rebase a published branch), resolve the conflict, push as Athena, re-run integration-gate on the new head, wait for CI green, then re-run locked-merge. Nothing was merged." ;;
  *) die 2 "COULD NOT LOOK: git merge-tree ${B} ${HEAD_SHA} failed (exit ${mt_rc}): ${mt_why}" \
       "check git >= 2.38 (merge-tree --write-tree) and that both commits are local; nothing was merged." ;;
esac
[[ "${EXPECTED_TREE}" =~ ^[0-9a-f]{40}$ ]] \
  || die 2 "COULD NOT LOOK: git merge-tree printed no tree id (got '${EXPECTED_TREE}')" \
       "check git >= 2.38 (merge-tree --write-tree); nothing was merged."
echo "EXPECTED-TREE ${EXPECTED_TREE} (${HEAD_SHA} merged into ${B})"

# ---- required-idle workflow, keyed on the base SHA (DND-1378) ----
# A single base-branch list read can miss the run for the commit that just
# landed (not listed yet, or a stale list), and "no live run listed" then read
# as idle: gen_saas #562 merged during #579's deploy. So the base commit's OWN
# run is looked up by SHA and re-read by id; a run that cannot be found is
# NOT SEEN YET / NO RUN FOR BASE, never idle (ai/CLAUDE.md -> "A failed lookup
# must never look like an empty one"). The base-branch count stays on top, so a
# re-run of an older run still holds. The base run's conclusion is printed; a
# non-success is a WARN, not a refusal: no ratified rule holds a merge on a
# failed deploy, and such a hold would also refuse the fix or revert merge.
BASE_RUN_GRACE_S=600
idle_check() {
  local wf="$1" commit_json ids id view st conc now ct age msg marker branch_json live
  commit_json="$(cd "${REPO}" && gh run list --workflow "${wf}" --commit "${B}" --event push --limit 20 \
                  --json databaseId,status,conclusion,headSha,createdAt 2>/dev/null)" \
    || die 2 "COULD NOT LOOK: gh run list --workflow ${wf} --commit ${B} failed" \
         "check the workflow file name, gh auth, and that gh supports 'run list --commit' (gh >= 2.x). Could-not-read is never idle; nothing was merged."
  jq -e 'type == "array"' <<<"${commit_json}" >/dev/null 2>&1 \
    || die 2 "COULD NOT LOOK: gh run list --commit returned non-JSON" "check gh auth; nothing was merged."
  jq -e --arg b "${B}" 'all(.[]; .headSha == $b)' <<<"${commit_json}" >/dev/null \
    || die 2 "COULD NOT LOOK: gh run list --commit ${B} returned a run for another SHA" \
         "gh ignored --commit (upgrade gh). A list keyed on the wrong SHA is never idle; nothing was merged."
  ids="$(jq -r '.[].databaseId' <<<"${commit_json}")"
  local base_run="" base_conc=""
  for id in ${ids}; do
    view="$(cd "${REPO}" && gh run view "${id}" --json databaseId,status,conclusion,headSha 2>/dev/null)" \
      || die 2 "COULD NOT LOOK: gh run view ${id} failed" "check gh auth; nothing was merged."
    jq -e --arg b "${B}" --argjson i "${id}" '.databaseId == $i and .headSha == $b' <<<"${view}" >/dev/null 2>&1 \
      || die 2 "COULD NOT LOOK: gh run view ${id} did not return run ${id} for ${B}" "check gh auth; nothing was merged."
    st="$(jq -r '.status' <<<"${view}")"; conc="$(jq -r '.conclusion // ""' <<<"${view}")"
    [ "${st}" = completed ] || die 5 "BASE DEPLOY BUSY: ${wf} run ${id} for base ${B} is ${st}" \
      "wait with ~/dev/custom/ai/bin/gh-ci-wait --repo <owner>/<repo> --run-id ${id} --sha ${B} (a 60 s poll on the App budget, DND-1706), then re-run locked-merge; nothing was merged."
    [ -n "${base_run}" ] || { base_run="${id}"; base_conc="${conc}"; }
  done
  if [ -z "${base_run}" ]; then
    now="$(date +%s)"; ct="$(git -C "${REPO}" show -s --format=%ct "${B}")"; age=$(( now - ct ))
    msg="$(git -C "${REPO}" show -s --format=%B "${B}")"
    marker="$(grep -o -i -E '\[(skip ci|ci skip|no ci|skip actions|actions skip)\]|^skip-checks: *true' <<<"${msg}" | head -1)"
    if [ "${age}" -lt "${BASE_RUN_GRACE_S}" ]; then
      die 5 "NOT SEEN YET: no ${wf} run for base ${B} (committed ${age}s ago; GitHub lists a push's run after a delay)" \
        "retry in a minute. A missing run is never idle; nothing was merged."
    elif [ -n "${marker}" ]; then
      echo "BASE-RUN none: ${B} carries '${marker}', no run expected; idle judged by the ${base} run list alone"
    else
      die 5 "NO RUN FOR BASE: ${B} has no ${wf} push run ${age}s after commit" \
        "find on the forge why the push started no run (workflow disabled, Actions outage, a skip marker this check does not know); re-run once a run exists. Merging without --require-idle-workflow is an owner decision (~/.claude/CLAUDE.md -> Owner approval policy, item 5). Nothing was merged."
    fi
  fi
  branch_json="$(cd "${REPO}" && gh run list --workflow "${wf}" --branch "${base}" --limit 100 \
                  --json databaseId,status,headSha 2>/dev/null)" \
    || die 2 "COULD NOT LOOK: gh run list --workflow ${wf} --branch ${base} failed" "check the workflow file name and gh auth; nothing was merged."
  jq -e 'type == "array"' <<<"${branch_json}" >/dev/null 2>&1 \
    || die 2 "COULD NOT LOOK: gh run list --branch returned non-JSON" "check gh auth; nothing was merged."
  live="$(jq -r '[.[] | select(.status != "completed") | .databaseId] | map(tostring) | join(" ")' <<<"${branch_json}")"
  [ -z "${live}" ] || die 5 "${base} BUSY: ${wf} has queued/in-progress run(s): ${live}" \
    "wait for each run with ~/dev/custom/ai/bin/gh-ci-wait --repo <owner>/<repo> --run-id <id> (a 60 s poll on the App budget, DND-1706), then re-run; nothing was merged."
  if [ -n "${base_run}" ]; then
    echo "IDLE ${wf} base ${B}: BASE-RUN ${base_run} completed/${base_conc}; ${base} list counted $(jq length <<<"${branch_json}") runs, none live"
    [ "${base_conc}" = success ] || echo "WARN base deploy ${base_run} for ${B} concluded ${base_conc:-unknown}; merging anyway: no ratified rule holds a merge on a failed deploy (DND-1378 escalation)"
  fi
}
[ -z "${IDLE_WF}" ] || idle_check "${IDLE_WF}"

# confirm_landed <tries> -- confirm-merged, bounded; sets confirmed=1 on a landing.
confirmed=""
confirm_landed() {
  local i
  for i in $(seq 1 "$1"); do
    if "${AI_BIN}/confirm-merged" --pr "${PR}" --repo "${REPO}" --fetch >/dev/null 2>&1; then confirmed=1; return 0; fi
    [ "${i}" -lt "$1" ] && sleep "${LOCKED_MERGE_CONFIRM_SLEEP:-20}"
  done
  return 1
}

# A failed merge call does not mean nothing landed (DND-1324: GitHub answered
# 502 after the squash landed, and exit 4 said "nothing was merged"). Ask the
# forge before claiming either; a landing goes on to the same checks below.
if ! ( cd "${REPO}" && "${AI_BIN}/gh-athena" pr merge "${PR}" --squash --match-head-commit "${HEAD_SHA}" ); then
  confirm_landed 3 \
    || die 4 "gh-athena pr merge ${PR} refused or failed, and confirm-merged does not show it landed" \
         "read the wrapper's own Fix: above (checks not green, conflict). If it was a forge error (5xx, timeout), check the PR on the forge before re-running."
  echo "locked-merge: the merge call failed, but PR ${PR} landed (confirm-merged); verifying it like any other merge" >&2
fi

[ -n "${confirmed}" ] || confirm_landed 6
[ -n "${confirmed}" ] || die 8 "merge of PR ${PR} ran but confirm-merged did not confirm it" \
  "check the PR on the forge by hand; do not retry the merge blind."

M="$(cd "${REPO}" && gh pr view "${PR}" --json mergeCommit -q '.mergeCommit.oid // empty' 2>/dev/null)"
[ -n "${M}" ] || die 8 "PR ${PR} reports no merge commit" "check the PR on the forge by hand; do not retry the merge blind."
# Confirmed landed (confirm-merged), with its merge commit: that is the event,
# whatever the parent/tree checks below then say about it.
if [[ "${M}" =~ ^[0-9a-f]{40}$ ]]; then
  LM_LANDED_AT="$(athena_telemetry_now)"; LM_LANDED_AFTER="${M}"; LM_BEFORE="${B}"
fi
git -C "${REPO}" fetch -q origin 2>/dev/null
git -C "${REPO}" cat-file -e "${M}^{commit}" 2>/dev/null \
  || die 8 "merge commit ${M} not fetchable" "fetch origin and compare ${M}^{tree} with the expected tree ${EXPECTED_TREE} by hand."
parent="$(git -C "${REPO}" rev-parse "${M}^1")"
[ "${parent}" = "${B}" ] || die 7 "LANDED UNGATED: merge ${M} sits on ${parent}, not the checked base ${B}" \
  "re-run the gate on origin/${base} now and report the ungated landing to the coordinator."
[ "$(git -C "${REPO}" rev-parse "${M}^{tree}")" = "${EXPECTED_TREE}" ] \
  || die 7 "LANDED UNGATED: merge ${M}'s tree differs from the expected tree ${EXPECTED_TREE} (${HEAD_SHA} merged into ${B})" \
       "re-run the gate on origin/${base} now and report the ungated landing to the coordinator."

echo "MERGED ${PR} ${M} ON ${B} TREE-MATCH"

# ---- merge-driven teardown (DND-864) ----
# The landing is confirmed, so the merged branch's worktree stack goes now,
# per PR: a multi-part Mission reclaims each part's stack as that part lands.
# teardown-stack re-confirms the merge, finds the ONE worktree with the PR's
# head branch, and refuses anything it cannot attribute. A stack whose
# containers are already gone is attributed by the stack marker integration-gate
# recorded in the worktree's git dir (DND-1576). Release the merge lock first:
# a teardown is not part of the critical section.
exec 9>&-
if ! "${AI_BIN}/teardown-stack" --pr "${PR}" --repo "${REPO}"; then
  die 10 "PR ${PR} LANDED, but teardown-stack could not tear down its worktree stack" \
    "the merge is done; do not re-merge. Read teardown-stack's Fix: above, then re-run ${AI_BIN}/teardown-stack --pr ${PR} --repo ${REPO}."
fi
exit 0
