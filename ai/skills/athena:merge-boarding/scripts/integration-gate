#!/usr/bin/env bash
# integration-gate -- assert a branch is safe to land onto a MOVING main.
#
# `origin/main` moves under a fleet mid-run: another fleet, the shipwright
# cron, the owner typing in the main checkout. This script answers the only
# question that changes what the admiral does -- "did the target move since my
# branch point, and is the gate still green once I contain it?" -- and it
# answers it with SHAs, never with a liveness guess about who else is running.
#
# Why the re-gate is the load-bearing half: two MRs with COMPLETELY DISJOINT
# file sets can each be gate-green alone and gate-red merged, because several
# harness checks judge a single global document or number --
# `check-agent-size`'s per-agent line budget, `ai/hooks/registry.json`,
# `ai/inbox/registry.json`. Git sees no conflict and (in a repo with no CI,
# like ~/dev/custom) nothing re-runs the gate after a rebase, so the defect is
# invisible to both git and the forge. This ADDS a check at a moment where none
# ran; it never drops, skips, downgrades, or path-excludes one.
#
# This script is an ASSERTION: without --rebase it never rebases, commits,
# pushes, or touches the working tree or any ref. A conflicting rebase is a
# judgement call, so --rebase only ever replays a clean branch onto the target
# and REFUSES on a conflict (DND-1064); it never resolves one, and it refuses
# a main checkout and a detached HEAD. Without --rebase it is safe to run
# anywhere, any number of times. Its one other write is its RECEIPT
# (DND-965): on INTEGRATION OK, and only then, it records the pass at
# <git common dir>/integration-receipts/<head>.json, outside every working tree. locked-merge refuses a head with no such
# receipt, so "the gate passed on this SHA" no longer rests on the caller's
# word (gen_saas #468 merged past a RED gate because a prep script printed
# READY without reading the exit code). Every run that does not end in
# INTEGRATION OK removes any receipt for its head, so a stale pass cannot
# outlive a later RED. A receipt it cannot remove (before the gate runs) or
# cannot write (after a green gate) is exit 5; only the second follows a gate.
# The receipt is SEALED (DND-1814): ai/bin/receipt-seal adds the producer (the
# git blobs of the gate files that wrote it) and an HMAC under this machine's
# receipt-seal key, and every reader (ai/lib/integration-receipt.sh) refuses a
# receipt that does not verify. The critic verdict this gate reads is sealed
# the same way by critic-review, so a pass a person or the branch's own gate
# code merely WRITES is never trusted. Residual, said out loud: code running as
# this user that deliberately invokes the sealer (ai/bin/receipt-seal, or
# ai/lib/receipt_seal.rb) can still seal one; ai/lib/receipt_seal.rb says why
# and what closing it needs. OPEN, both DND-1808's (this seal does not fix
# it): (a) the sealer is an oracle to any same-uid process; (b) gen_saas's
# gate cannot be sandboxed.
# After the gate runs, in a linked worktree that runs a
# compose stack, it also has teardown-stack record that worktree's stack
# marker in the worktree's own git dir (DND-1576), outside every working tree.
#
# In the repo that holds it, it judges a head with the LANDED judges (DND-1796,
# step 3a'): inside the slot it reads the target's ai/ tree out of git into a
# temp dir and re-executes the target's copy of itself from there, so this
# script, its libs, blast-radius, its manifest, the owner verifiers and
# critic-review are the target's, never a branch's or a working tree's.
#
# Run: ~/dev/custom/ai/bin/integration-gate [--target <ref>], with the
#   Mission's worktree as the cwd (the main checkout's shim; landed code).
# Self-test: ai/skills/athena:merge-boarding/test/self-test.sh
set -uo pipefail

PROG="integration-gate"

# The receipt schema/path and the gate-declaration rule live in ONE shared
# library, also read by locked-merge and gh-athena's merge guard, so the three
# cannot drift (DND-969).
# /proc/<pid>/stat is read by the one shared rule (whole file, fields after
# the LAST ") "), never line by line (DND-1625).
PS_LIB="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../../lib/proc-stat.sh"
# shellcheck source=../../../lib/proc-stat.sh
if ! . "$PS_LIB" 2>/dev/null; then
  echo "${PROG}: cannot load ${PS_LIB}." >&2
  echo "Fix: run integration-gate from its committed path in a full ~/dev/custom checkout (ai/skills and ai/lib side by side)." >&2
  exit 2
fi
IR_LIB="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../../lib/integration-receipt.sh"
# shellcheck source=../../../lib/integration-receipt.sh
if ! . "$IR_LIB" 2>/dev/null; then
  echo "${PROG}: cannot load ${IR_LIB}." >&2
  echo "Fix: run integration-gate from its committed path in a full ~/dev/custom checkout (ai/skills and ai/lib side by side)." >&2
  exit 2
fi
TARGET="origin/main"
GATE_CMD=""
DO_FETCH=1
WITH_CRITIC=0
SINCE=""
CRITIC_OVERRIDE=""
OVERRIDE_STATE=""
OWNER_APPROVAL=""
SLOT_WAIT=""
REBASE=0
# The argv as given, for the re-run inside the test slot (DND-1064) and the
# re-exec of the landed copy (DND-1796).
ORIG_ARGS=( "$@" )

# A usage error in the parse below (exit 2) must still leave no pass for the
# head (DND-1656), yet the parse itself stays write-free so --help writes
# nothing. So the removal rides an EXIT trap that acts ONLY on exit 2, and the
# trap is replaced by the telemetry trap once the parse is done. The exit code
# stays 2 even if the removal fails (it says so loudly instead).
ig_usage_clear_receipt() {
  local head common receipt
  head="$(git rev-parse --verify -q "HEAD^{commit}" 2>/dev/null)" || return 0
  [ -n "$head" ] || return 0
  common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
  case "$common" in /*) ;; *) return 0 ;; esac
  receipt="$(ir_receipt_path "$common" "$head")"
  if ! rm -f "$receipt" 2>/dev/null; then
    echo "${PROG}: could not remove the earlier receipt ${receipt}." >&2
    echo "Fix: make $(dirname "$receipt") writable and re-run; a stale pass this usage error could not clear would outlive its result." >&2
  fi
  return 0
}
trap 'rc=$?; [ "$rc" -eq 2 ] && ig_usage_clear_receipt' EXIT

usage() {
  cat <<'EOF'
Usage: integration-gate [--target <ref>] [--since <ref>] [--gate '<cmd>']
                        [--no-fetch] [--with-critic] [--rebase]
                        [--slot-wait-timeout <secs>] [--self-test]

Asserts that HEAD contains the current target ref AND that the local gate is
green on that integrated head. Exits 0 only when both hold.

It takes its machine test slot FIRST (DND-1064), then fetches and judges
containment inside the slot, so "HEAD contains <target>" is evaluated when the
gate starts, never before a queue wait that main can move during. Run under
test-slot already (the captain form), it re-enters the held slot at once.

On exit 0 (and only then) it writes a RECEIPT for the head, atomically, at
  <git common dir>/integration-receipts/<head-sha>.json
recording the head, the target SHA it contained (base), the gate and its
source, any --critic-override / --owner-approval, the SHA a carried critic
PASS came from (critic_carried_from; the OK line then says CRITIC CARRIED) and
the upstream range its interaction review covered (critic_upstream_range; the
OK line then says CRITIC CARRIED + INTERACTION), the
blast-radius verdict, the INTEGRATION OK line, and a UTC timestamp. It is
SEALED (DND-1814): ai/bin/receipt-seal adds the producer (the git blobs of
the gate files that wrote it) and an HMAC under this machine's receipt-seal
key. locked-merge, gh-athena's merge and push guards, main-health and
ready-and-idle require it and refuse one that does not verify: unsealed,
edited, another key's, or written by a gate copy that never landed. Any other
outcome removes a receipt for that head, a usage error (exit 2) included; a
usage error that cannot remove it still exits 2 and says so, never 5. There is
no flag that skips it.

The judges are the LANDED ones (DND-1796). When the gated repo is the one
that holds this script, the copy you start never judges: inside the slot,
after the fetch (and any --rebase), it reads the target's ai/ tree out of git
into a temp dir and re-executes the target's copy of itself, which removes
that dir when it exits. So this script, its libs, blast-radius, its manifest,
the owner verifiers and critic-review are the target's, never a branch's or a
working tree's. A --with-critic judge started before the slot by a checkout
whose critic-review or ai/lib is not the target's is stopped; the landed
judge runs. A judge the target lacks or git cannot read is exit 2, never the
branch's copy. Another repo's diff cannot reach them, so there they resolve
beside this script. Run the main checkout's
~/dev/custom/ai/bin/integration-gate: this step runs only in the copy started.

Once the gate has run (green or RED), it runs `teardown-stack --record
--worktree <root>`: in a linked worktree with a compose stack up, that
records the stack marker teardown-stack needs to remove the stack's volumes
after a merge if the containers are gone by then (DND-1576). Its lines are
prefixed `integration-gate: `; it never changes the verdict or exit code.

  --target <ref>   integration target (default: origin/main). It sets the
                   containment check and the critic base ONLY. The declared
                   gate runs unchanged and is not told the target, so a
                   stage of its own may still compare against main
                   (gen_saas bin/checks/merge-conflicts.sh always merges
                   against origin/main). A stacked branch whose base
                   conflicts with main is therefore RED there under any
                   --target. That red is real: the stack is stale vs main,
                   and is fixed once at the stack base, not per ticket.
  --since <ref>    the target SHA your branch was last reviewed/gated against
                   (the "baseline main" in your state log). REQUIRED for a
                   meaningful file-set intersection once you have rebased:
                   after a rebase the original branch point is unrecoverable,
                   so without it the intersection is reported UNAVAILABLE
                   rather than silently empty.
  --gate '<cmd>'   gate command to run at the repo root -- ONLY for a repo that
                   declares no gate. The gate is read from the LANDED target,
                   never from argv or the working tree: the first of
                   bin/prep-commit.sh, ai/bin/harness-gate that exists on
                   <target> is the repo's declared gate and always runs. A
                   --gate that differs from it is refused (exit 2). With no
                   declared gate, --gate is required, and a command that can
                   never fail (true, :, exit 0, echo ..., 'x || true',
                   'x; true', 'x &', an empty string) is refused (exit 2).
                   Every OK line names the gate that ran and where it came
                   from, and marks it EDITED BY THIS BRANCH when the branch
                   changes the gate script itself.
  --no-fetch       skip the fetch; compare against the target ref as-is
  --with-critic    also run the standing judge (critic-review --base <target>)
                   on this head, CONCURRENTLY with the gate, unless a PASS
                   covering the target is already recorded for it (critic-review
                   --verdict-for --covering: a PASS judged against a stacked
                   parent does not cover the target and is re-judged). It is joined before the verdict
                   step, which then reads the judge's receipt exactly as
                   without the flag, so wall time is max(gate, critic), not
                   the sum. Only a SEALED PASS counts, before the gate or
                   after it (DND-1814): one written by hand, or by a gate
                   step mid-gate, is no verdict (exit 3, UNVERIFIED PASS).
                   On a RED gate the judge is still joined, so one
                   round returns both sets of findings. The judge queues in
                   test-slot's model pool (DND-1326), never the cpu pool.
  --slot-wait-timeout <secs>
                   the gate runs inside the machine's heavy-test slot pool
                   (ai/bin/test-slot in the MAIN checkout of the repo that
                   holds this script, i.e. ~/dev/custom); give up
                   waiting for a slot after <secs> (default: test-slot's own).
                   A give-up is exit 6, GATE NOT RUN -- never OK, never RED.
                   Run bare, the slot holds the units test-slot gives the
                   declared gate itself (test-slot --weight-of; a
                   harness-gate its worker count: HARNESS_GATE_JOBS, else
                   harness-gate's default). Under a caller's
                   `test-slot -- integration-gate` (the captain form) the
                   caller's slot is the one held, at test-slot's default
                   unless the caller passes --weight. <secs> also bounds
                   the --with-critic judge's wait in the model pool.
  --rebase         inside the slot, after the fetch, if HEAD does not contain
                   the target: rebase the checked-out branch onto it, then
                   gate (and judge) the rebased head. Refuses a dirty tree
                   before touching anything; on a conflict it aborts the
                   rebase, names the conflicting paths, and exits 2 with the
                   branch at its original head -- it never resolves one.
                   Without --since, the intersection is measured from the
                   pre-rebase branch point. The containment bar is unchanged:
                   the gated head contains the target read at gate start.
                   Refused in a main checkout and on a detached HEAD. After a
                   clean rebase the branch STAYS rebased whatever the gate or
                   judge then say; the old head is ORIG_HEAD (or the reflog).
  --critic-override <reason>
                   merge WITHOUT a standing-judge verdict on this head -- and
                   ONLY that: the receipt is read first either way, and a
                   recorded BLOCK is REFUSED with this flag exactly as without
                   it. Covers the ABSENCE of a verdict (never ran / still
                   running / fail-open / unreadable receipt). Requires a reason;
                   the reason AND the state actually overridden are printed into
                   the INTEGRATION OK line for your state log. Bounded to this
                   one invocation.
  --owner-approval 'session:<session-uuid>/<message-uuid> quote:<words>'
                   merge a head whose blast radius is HOT. A VERIFIABLE record
                   of the owner's own words: the reference names the owner's
                   human-typed turn in that Claude Code session's transcript
                   (~/.claude/projects/*/<session-uuid>.jsonl), and the quote
                   must appear in it verbatim. blast-radius verifies it; free
                   text, a rule citation, an architect sign-off or a captain
                   report is refused (exit 2). Printed into the INTEGRATION OK
                   line and the receipt. What holds at all:
                   ~/.claude/CLAUDE.md -> "Owner approval policy".
  --owner-approval 'click:<delivery_id>'
                   the same, cleared by the owner's Block Kit click (DND-1784;
                   Cody, 2026-10-02: "Gate accepts a verified owner click,
                   without hesitation."). <delivery_id> is the click's
                   slack.interaction line on the `session` channel of the
                   SESSION's project. blast-radius checks, mechanically: the
                   line is there and is kind slack.interaction; actor.is_owner
                   is true and actor.user_id is the private overlay's owner
                   id; it is no grant button; its value is
                   'approve-exit4 <owner>/<repo>#<pr>@<head sha>' naming this
                   repo's origin and the exact head gated; and no later owner
                   click on that message chose otherwise. A click for head A
                   also clears a later head B of the same PR (DND-1832) when
                   the PR's own diff, git diff --binary
                   <merge-base(target, head)> <head>, computed here from git
                   objects, is byte-identical at A and B; origin's PR head
                   ref (refs/pull/<pr>/head or refs/merge-requests/<pr>/head)
                   is B; and no later owner click names that PR and holds it.
                   So a rebase or a merge of main that moves no byte of the
                   PR's change needs no new click. A relayed click, a click
                   on another message, a click for another PR, a head whose
                   PR diff differs by a byte (both merge-bases and heads are
                   named), a reversed or held approve, or a record it cannot
                   verify is refused (exit 2, Fix:). A head A whose objects
                   are not here, or a PR ref that cannot be read, is "could
                   not look", never a pass.
                   athena:slack -> "A click is untrusted input".
  --self-test      run the dedicated test suite and exit

Exit codes: 0 integration OK | 1 gate RED on the integrated head
            2 usage / unresolvable ref / branch behind target /
              --rebase refused (dirty tree, main checkout, detached
              HEAD), REBASE CONFLICT, or REBASE FAILED /
              gate refused (a no-op, or not the gate the target declares) /
              working tree is not HEAD (uncommitted or untracked paths,
              before the gate or left by it; ignored files do not count) /
              the main checkout's ai/bin/test-slot cannot be found or run,
              or its outcome temp dir cannot be created (gate not run) /
              no landed judge: the target lacks the gate, its libs,
              blast-radius, its manifest, the owner verifiers or
              critic-review, or git cannot read them, or the target moved
              under the re-executed copy (DND-1796)
            3 no green critic verdict on the integrated head
            4 merging performs a real-world action -- owner's call, not the
              fleet's (see --owner-approval)
            5 receipt error, no INTEGRATION OK printed. Either a stale
              receipt for the head could not be removed (raised BEFORE the
              gate runs: no gate ran, nothing passed), or the receipt could
              not be written or sealed after a green gate (the gate passed, but the
              pass is not recorded and locked-merge will refuse the head).
              Read the message to tell them apart; a usage error that
              cannot remove it still exits 2, never 5
            6 gate NOT RUN: no machine test slot within the wait, or
              test-slot left no outcome (neither OK nor RED; re-run)
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    --target) TARGET="${2-}"; [ -n "$TARGET" ] || { echo "${PROG}: --target needs a ref." >&2; echo "Fix: pass a ref, e.g. --target origin/main." >&2; exit 2; }; shift 2 ;;
    --since)  SINCE="${2-}"; [ -n "$SINCE" ] || { echo "${PROG}: --since needs a ref." >&2; echo "Fix: pass the target SHA your branch was last gated against, e.g. --since 2e0eff3." >&2; exit 2; }; shift 2 ;;
    --gate)   GATE_CMD="${2-}"; [ -n "$GATE_CMD" ] || { echo "${PROG}: --gate needs a command." >&2; echo "Fix: pass a command, e.g. --gate 'ai/bin/harness-gate'." >&2; exit 2; }; shift 2 ;;
    --no-fetch) DO_FETCH=0; shift ;;
    --with-critic) WITH_CRITIC=1; shift ;;
    --rebase) REBASE=1; shift ;;
    --slot-wait-timeout) SLOT_WAIT="${2-}"; [[ "$SLOT_WAIT" =~ ^[1-9][0-9]*$ ]] || { echo "${PROG}: --slot-wait-timeout needs whole seconds (got '${SLOT_WAIT}')." >&2; echo "Fix: pass a positive integer, e.g. --slot-wait-timeout 3600, or omit it to use test-slot's default wait." >&2; exit 2; }; shift 2 ;;
    --critic-override) CRITIC_OVERRIDE="${2-}"; [ -n "$CRITIC_OVERRIDE" ] || { echo "${PROG}: --critic-override needs a REASON." >&2; echo "Fix: pass why you are merging with no judge verdict, e.g. --critic-override 'model unreachable for 3 re-runs; hotfix cannot wait'. An unrecorded bypass is the exact failure this flag exists to replace. Note it cannot cover a recorded BLOCK -- that is refused with or without the flag." >&2; exit 2; }; shift 2 ;;
    --owner-approval) OWNER_APPROVAL="${2-}"; [ -n "$OWNER_APPROVAL" ] || { echo "${PROG}: --owner-approval needs the OWNER'S AUTHORIZATION." >&2; echo "Fix: pass a verifiable record of the owner's decision: --owner-approval 'session:<session-uuid>/<message-uuid> quote:<the owner's words, verbatim>', or the owner's click, --owner-approval 'click:<delivery_id>' (see --help). An empty value is not an approval, and no agent message is ever your user's consent." >&2; exit 2; }; shift 2 ;;
    --self-test)
      HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
      exec bash "$(dirname "${HERE}")/test/self-test.sh" ;;
    -h|--help) usage; exit 0 ;;
    *) echo "${PROG}: unknown argument '$1'." >&2
       echo "Fix: see --help; valid flags are --target, --since, --gate, --no-fetch, --with-critic, --rebase, --slot-wait-timeout, --critic-override, --owner-approval, --self-test." >&2
       exit 2 ;;
  esac
done
# --since as the caller gave it; a --rebase may set SINCE later (DND-1796
# carries that into the re-exec of the landed copy).
ARG_SINCE="$SINCE"

# --- telemetry: one integration_gate.run per invocation (DND-1475) ----------
# The lead-time ledger reads `queue` (to this run's start) and `integrate`
# (its wall) from this event. Exactly ONE per invocation, on every exit path
# after the parse above (--help, --self-test and an unknown flag never reach
# here and emit nothing). This script runs twice per invocation: the outer run
# re-executes itself inside test-slot (section 1b). Only the OUTER run emits,
# from its EXIT trap, so its at/duration cover the whole invocation (slot wait
# included) and its exit code is the caller's. The run inside the slot knows
# what the outer cannot: the head it judged (after a --rebase, the rebased
# head), the target SHA it contained and whether it rebased. It appends those
# to a facts file in the outer run's private temp dir (INTEGRATION_GATE_FACTS);
# a fact it never reached stays unknown, and the event omits it (null, never a
# guess). Contract: ai/contracts/athena-telemetry.md. Fails open: the emit runs
# through ai/lib/telemetry-emit.sh, which never changes an exit code or stdout.
# A binding that will not load is no telemetry, never a refusal.
IG_TEL_LIB="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../../../lib/telemetry-emit.sh"
# shellcheck source=../../../lib/telemetry-emit.sh
if ! . "$IG_TEL_LIB" 2>/dev/null; then
  athena_telemetry_emit() { :; }; athena_telemetry_now() { :; }
  athena_telemetry_clock_us() { :; }; athena_telemetry_seconds_since() { :; }
fi
IG_TEL_AT="$(athena_telemetry_now)"
IG_TEL_T0="$(athena_telemetry_clock_us)"
# The emitting role. An env marker alone never makes a run the inner one: the
# slot check in section 1b settles it (IN_SLOT), and resets this to 1 when the
# marker was not backed by a held slot.
IG_TEL_EMIT=1
[ "${INTEGRATION_GATE_IN_SLOT:-}" = 1 ] && IG_TEL_EMIT=0
IG_FACTS=""       # inner run: the file it appends facts to
IG_FACTS_OUT=""   # outer run: the file the inner run wrote
# ig_fact KEY VALUE -- the run inside the slot records one fact for the outer.
ig_fact() { [ -n "$IG_FACTS" ] && printf '%s=%s\n' "$1" "$2" >>"$IG_FACTS" 2>/dev/null; return 0; }
# ig_emit_run RC -- the one event, once. Outcome is a closed vocabulary keyed
# on the exit code (see --help's exit codes), never free text.
ig_emit_run() {
  local rc="$1" head="" base="" rebased=false outcome k v dur
  local -a opt=()
  [ "$IG_TEL_EMIT" = 1 ] || return 0
  IG_TEL_EMIT=0
  if [ -n "$IG_FACTS_OUT" ] && [ -f "$IG_FACTS_OUT" ]; then
    while IFS='=' read -r k v; do
      case "$k" in
        head) [[ "$v" =~ ^[0-9a-f]{40}$ ]] && head="$v" ;;
        base) [[ "$v" =~ ^[0-9a-f]{40}$ ]] && base="$v" ;;
        rebased) [ "$v" = true ] && rebased=true ;;
      esac
    done <"$IG_FACTS_OUT"
  fi
  [ -n "$head" ] || head="${HEAD0:-}"
  case "$rc" in
    0) outcome=ok ;; 1) outcome=red ;; 2) outcome=refused ;; 3) outcome=no_critic_pass ;;
    4) outcome=held ;; 5) outcome=receipt_error ;; 6) outcome=not_run ;;
    *) if [ "$rc" -gt 128 ]; then outcome=interrupted; else outcome=other; fi ;;
  esac
  dur="$(athena_telemetry_seconds_since "$IG_TEL_T0")"
  [ -n "$IG_TEL_AT" ] && opt+=( --at "$IG_TEL_AT" )
  [ -n "$dur" ] && opt+=( --duration "$dur" )
  [[ "$head" =~ ^[0-9a-f]{40}$ ]] && opt+=( --head "$head" )
  [ -n "$base" ] && opt+=( --attr "base=$base" )
  local wc=false; [ "$WITH_CRITIC" -eq 1 ] && wc=true
  athena_telemetry_emit --event integration_gate.run --attr "exit_code=$rc" --attr "outcome=$outcome" \
    --attr "rebased=$rebased" --attr "with_critic=$wc" "${opt[@]}"
  return 0
}
trap 'ig_emit_run $?' EXIT

# --- 0a. clear the head's receipt before any refusal ------------------------
# A run that does not end in INTEGRATION OK leaves no pass for its head, and
# that includes a run refused or killed before (or during) the queue wait.
# So the receipt for the head it starts on goes FIRST, before any refusal:
# the test-slot refusals in section 0 included (DND-1504: they used to come
# first, so a missing test-slot left an earlier pass standing). The run inside
# the slot repeats this harmlessly, and removes (and checks) again for the
# head it gates. Two refusals still come earlier, by necessity: a usage error
# in the argument parse (which stays write-free so --help writes nothing, and
# clears the head's receipt from its own EXIT trap on exit 2, DND-1656), and a
# missing receipt library (above),
# without which the receipt's path is unknown.
HEAD0="$(git rev-parse --verify -q "HEAD^{commit}" 2>/dev/null)"
if [ -n "$HEAD0" ]; then
  OUTER_COMMON="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
  case "$OUTER_COMMON" in
    /*) OUTER_RECEIPT="$(ir_receipt_path "$OUTER_COMMON" "$HEAD0")"
        if ! rm -f "$OUTER_RECEIPT" 2>/dev/null; then
          echo "${PROG}: could not remove the earlier receipt ${OUTER_RECEIPT}." >&2
          echo "Fix: make $(dirname "$OUTER_RECEIPT") writable (ls -ld '$(dirname "$OUTER_RECEIPT")') and re-run. A stale pass this run cannot clear would outlive its result." >&2
          exit 5
        fi ;;
  esac
fi

# --- 0. the machine test-slot pool (DND-486) ------------------------------
# The gate is the heaviest run an admiral starts, and ~23 unbounded heavy runs
# at once took this box to load 54 and flaked timing-sensitive suites (DND-473).
# So the gate runs inside test-slot, which bounds heavy runs per machine.
#
# WHICH test-slot: the MAIN checkout's copy of the custom repo that holds this
# script, never a worktree's and never PATH. test-slot's stable interface
# requires that, so every caller agrees on the budget (DND-1006); a worktree
# copy on a branch that edits it would gate against the shared pool with its
# own. The run holds the weight test-slot gives the declared gate itself
# (gate_slot_weight, DND-1326), and the --with-critic judge queues in its
# model pool (start_critic). The main checkout
# is found from the git common dir of THIS script's checkout (realpath first,
# so ~/.claude/skills still lands in ~/dev/custom), which is the same for the
# main checkout, every worktree, and every shipwright lane. A checkout that
# cannot be resolved, or a wrapper missing there, is a refusal (exit 2), never
# a silent fallback to an unslotted run. test-slot changes only WHEN the gate
# starts: command, source, and exit semantics are unchanged.
SELF_DIR="$(dirname "$(realpath "${BASH_SOURCE[0]}")")"
# The target's copy that step 3a' materialised and re-executed (DND-1796)
# runs from a temp dir that is no checkout, so it is told the git common dir
# of the copy that started it. Honoured only with the re-exec marker; section
# 1b honours that marker only inside a held slot, and a run outside one never
# reaches the gate with it (the outer run unsets it before the slot).
if [ "${INTEGRATION_GATE_LANDED_REEXEC:-}" = 1 ] && [ -n "${INTEGRATION_GATE_SCRIPT_COMMON:-}" ]; then
  SELF_COMMON="$INTEGRATION_GATE_SCRIPT_COMMON"
else
  SELF_COMMON="$(git -C "$SELF_DIR" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
fi
case "$SELF_COMMON" in
  /*/.git) TEST_SLOT="$(dirname "$SELF_COMMON")/ai/bin/test-slot" ;;
  *) echo "${PROG}: cannot locate the main checkout that holds this script (${SELF_DIR}); git common dir resolved to '${SELF_COMMON}'." >&2
     echo "Fix: run integration-gate from a git checkout (or worktree) of ~/dev/custom whose main checkout is a normal clone with a .git directory. It needs that main checkout's ai/bin/test-slot and never runs a gate outside the machine slot pool (DND-474)." >&2
     exit 2 ;;
esac
if [ ! -x "$TEST_SLOT" ]; then
  echo "${PROG}: cannot run the gate: test-slot is not executable at ${TEST_SLOT}." >&2
  echo "Fix: the main checkout's ai/bin/test-slot is missing (${TEST_SLOT}); update that checkout (git -C '$(dirname "$SELF_COMMON")' pull --ff-only) and re-run. integration-gate never runs a gate outside the machine slot pool (DND-474)." >&2
  exit 2
fi

# --- 1. cwd must be inside a work tree -------------------------------------
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "${PROG}: '$(pwd)' is not inside a git work tree." >&2
  echo "Fix: run this from the Mission's worktree (the tree holding the branch you intend to merge)." >&2
  exit 2
fi
ROOT="$(git rev-parse --show-toplevel)" || exit 2
cd "$ROOT" || exit 2

short() { git rev-parse --short "$1"; }
tree_dirt() { git -C "$ROOT" status --porcelain 2>&1; }
CRITIC="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../bin" 2>/dev/null && pwd)/critic-review"
TEARDOWN="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../bin" 2>/dev/null && pwd)/teardown-stack"

# DND-1576: record the worktree's stack marker right after the gate ran, while
# the stack the gate used is still up. A captain's later `docker compose down`
# (no -v) leaves volumes and no container, and teardown-stack can attribute
# those at merge time only through this marker. Advisory: the gate verdict
# never depends on it, and its lines are prefixed so a Fix: of teardown-stack's
# is not read as this gate's own. teardown-stack decides when there is nothing
# to record (a main checkout, no stack, a repo script) without asking docker.
record_stack_marker() {
  local out rc
  if [ ! -x "$TEARDOWN" ]; then
    echo "${PROG}: stack marker not recorded: ${TEARDOWN} is missing or not executable."
    return 0
  fi
  out="$("$TEARDOWN" --record --worktree "$ROOT" 2>&1)"; rc=$?
  [ -n "$out" ] && printf '%s\n' "$out" | sed "s/^/${PROG}: /"
  if [ "$rc" -ne 0 ]; then
    echo "${PROG}: stack marker not recorded (teardown-stack --record exit ${rc}); the gate verdict does not depend on it, but if this worktree's containers are gone by its merge, teardown-stack will refuse its volumes and name each one."
  fi
  return 0
}

fetch_target() {
  [ "$DO_FETCH" -eq 1 ] || return 0
  local remote
  case "$TARGET" in
    */*) remote="${TARGET%%/*}" ;;
    *)   remote="" ;;
  esac
  if [ -n "$remote" ] && grep -qx -- "$remote" <<<"$(git remote)"; then
    git fetch "$remote" >/dev/null 2>&1 || \
      echo "${PROG}: WARN fetch of '${remote}' failed; comparing against the ref as it stands locally." >&2
  fi
}

# refuse_dirty_tree <head sha> -- the gate runs in the WORKING TREE but the
# receipt certifies the committed HEAD (DND-1011), and --rebase must never
# replay over uncommitted work. So the tree must be exactly HEAD.
refuse_dirty_tree() {
  local dirt
  dirt="$(tree_dirt)"
  [ -z "$dirt" ] && return 0
  echo "${PROG}: the working tree is not HEAD ($(short "$1")), so a gate run here would not judge the commit being certified. Uncommitted or untracked paths:" >&2
  printf '%s\n' "$dirt" | head -20 >&2
  echo "Fix: commit the paths above (or remove them, or gitignore build output), then re-run. A pass on uncommitted content is not a pass of $(short "$1")." >&2
  exit 2
}

# require_critic_tools -- --with-critic needs critic-review and setsid.
require_critic_tools() {
  if [ ! -x "$CRITIC" ]; then
    echo "${PROG}: --with-critic cannot locate critic-review (expected ${CRITIC})." >&2
    echo "Fix: run this script from its committed path under ~/dev/custom, or drop --with-critic and run ~/dev/custom/ai/bin/critic-review yourself." >&2
    exit 3
  fi
  if ! command -v setsid >/dev/null 2>&1; then
    echo "${PROG}: --with-critic needs setsid (util-linux) to run the judge in its own process group." >&2
    echo "Fix: install util-linux, or drop --with-critic and run ~/dev/custom/ai/bin/critic-review yourself before this script." >&2
    exit 2
  fi
}

# start_critic <head sha> -- the standing judge on <head>, in its own process
# group. setsid execs in place (a background subshell is not a group leader),
# so $! is the group leader's pid AND the process-group id; the leader is the
# test-slot that runs the judge (its argv names critic-review).
#
# The judge queues in test-slot's MODEL pool (DND-1326), as a critic-review a
# caller wraps itself does: it holds no cpu unit, and the model pool bounds
# how many model runs are in flight machine-wide. test-slot is the group
# leader here and CMD its child in the same group, so the one group signal
# still reaches test-slot, critic-review and its `claude -p`. A judge the
# model pool never admits (a --slot-wait-timeout give-up, a test-slot
# refusal) records no verdict, and the verdict step reads that absence as
# it always has; its log keeps test-slot's own lines.
start_critic() {
  local -a judge_slot=( --pool model --label "critic-review $(basename "$ROOT") ${1:0:8}" )
  [ -n "$SLOT_WAIT" ] && judge_slot+=( --wait-timeout "$SLOT_WAIT" )
  CRITIC_LOG="$(mktemp "${TMPDIR:-/tmp}/integration-gate-critic.XXXXXX")"
  ( cd "$ROOT" && exec setsid "$TEST_SLOT" "${judge_slot[@]}" -- "$CRITIC" --base "$TARGET" ) >"$CRITIC_LOG" 2>&1 &
  CRITIC_PGID=$!
  CRITIC_ADOPTED=0; CRITIC_ACTIVE=1
  echo "${PROG}: --with-critic: running the standing judge on $(short "$1") beside the gate (pgid ${CRITIC_PGID}, log ${CRITIC_LOG})"
}

# Joins the judge and prints its verdict lines. Called on every path out of
# the gate step that reports a result, so a RED gate still returns the judge's
# findings; any other exit stops it through the EXIT trap. A judge started
# before the slot wait was started by the outer run, so it is not this
# process's child: block on its pid instead of `wait`.
join_critic() {
  [ "$CRITIC_ACTIVE" -eq 1 ] || return 0
  if [ -n "$CRITIC_PGID" ]; then
    if [ "$CRITIC_ADOPTED" -eq 1 ]; then
      tail --pid="$CRITIC_PGID" -f /dev/null 2>/dev/null
    else
      wait "$CRITIC_PGID" 2>/dev/null
    fi
  fi
  CRITIC_PGID=""; CRITIC_ACTIVE=0
  grep -E '^critic-review:|^FINDINGS:' "$CRITIC_LOG" >&2 || tail -5 "$CRITIC_LOG" >&2
}

# --- 1b. take the slot FIRST (DND-1064) --------------------------------------
# The containment bar is "the gated head contains <target> when the gate
# starts". It used to be read before the test-slot wait, and waits of 5-26 min
# now exceed the gap between landings (2026-09-28: DND-907, DND-896+945 and
# DND-902 each refused twice; the admiral lost three landing windows). So this
# run re-executes itself inside test-slot and does everything from the fetch on
# there: the fetch, the containment check, --rebase, the gate, the verdict.
# Called under test-slot already, test-slot re-enters the held slot at once.
#
# The cheap refusals (dirty tree, --with-critic tools) run before the wait so
# they never cost a queue, and are checked again inside it. The judge on the
# current head starts BEFORE the wait, as it always has (DND-1010), and the
# run inside the slot adopts it when the head is unchanged; after a --rebase
# it stops it and judges the new head. The inner run is recognised only while
# the slot ATHENA_TEST_SLOT_HELD names is really held (its flock is taken, the
# same test test-slot makes before it re-enters), so neither the marker nor a
# stale slot variable can move the containment check back before a wait.
CRITIC_PGID=""; CRITIC_LOG=""; CRITIC_ADOPTED=0; CRITIC_ACTIVE=0; SLOT_TMP=""
# slot_really_held -- 0 when ATHENA_TEST_SLOT_HELD=<pool>:<n> names a slot
# lock some process holds: a shared non-blocking flock on a fresh open fails.
slot_really_held() {
  local held="${ATHENA_TEST_SLOT_HELD:-}" pool slot lock fd
  [ -n "$held" ] || return 1
  pool="${held%:*}"; slot="${held##*:}"
  [[ "$slot" =~ ^[1-9][0-9]*$ ]] || return 1
  lock="${pool}/slot-${slot}.lock"
  [ -e "$lock" ] || return 1
  { exec {fd}<"$lock"; } 2>/dev/null || return 1
  if flock -n -s "$fd"; then exec {fd}<&-; return 1; fi
  exec {fd}<&-
  return 0
}
# gate_slot_weight -- appends --weight to SLOT_ARGS so the outer slot holds
# what test-slot would weigh the gate itself at (DND-1326): a harness-gate its
# worker count (--jobs is not passable here, so HARNESS_GATE_JOBS, else its
# default), anything else test-slot's default. It asks the main checkout's
# test-slot (--weight-of), so there is one weight rule, test-slot's. The gate
# is the one declared on the target as it stands before the in-slot fetch
# (the weight is a scheduling declaration; the gate that runs is still
# resolved inside the slot), else the words of a caller's --gate. When the
# weight cannot be read (a test-slot that predates --weight-of, a target not
# yet fetched) the slot takes test-slot's default, as before DND-1326, and
# SLOT_WEIGHT_NOTE says so: a failed lookup never reads as a weight.
gate_slot_weight() {
  local tsha gate w rc=3 why
  local -a argv=()
  if tsha="$(git rev-parse --verify -q "${TARGET}^{commit}" 2>/dev/null)"; then
    if gate="$(ir_declared_gate_on "$ROOT" "$tsha")"; then rc=0; else rc=$?; fi
  fi
  if [ "$rc" -eq 0 ]; then
    argv=( "$gate" )
  elif [ -n "$GATE_CMD" ]; then
    read -r -a argv <<<"$GATE_CMD"
  fi
  if [ "${#argv[@]}" -eq 0 ]; then
    # Three states, three notes: "could not look" never reads as "none".
    case "$rc" in
      1) why="${TARGET} declares no gate and no --gate was passed" ;;
      2) why="${TARGET}'s declared gate could not be read (its commit is not in this object store)" ;;
      *) why="${TARGET} is not fetched yet, so its declared gate could not be read" ;;
    esac
    SLOT_WEIGHT_NOTE="test-slot's default weight: ${why}"
    return 0
  fi
  # --pool cpu: the outer slot is always a cpu-pool slot, so its weight is
  # read in cpu units even when the gate names a model-pool command.
  if w="$("$TEST_SLOT" --weight-of --pool cpu -- "${argv[@]}" 2>/dev/null)" && [[ "$w" =~ ^[1-9][0-9]*$ ]]; then
    SLOT_ARGS+=( --weight "$w" )
    SLOT_WEIGHT_NOTE="weight ${w}, as test-slot weighs ${argv[0]}"
  else
    SLOT_WEIGHT_NOTE="test-slot's default weight: ${TEST_SLOT} --weight-of could not weigh ${argv[0]} (a test-slot older than DND-1326?)"
  fi
}

IN_SLOT=0
if [ "${INTEGRATION_GATE_IN_SLOT:-}" = 1 ] && slot_really_held; then IN_SLOT=1; fi
PRESTARTED="${INTEGRATION_GATE_PRESTARTED_CRITIC:-}"
# Telemetry (DND-1475): the run inside the slot reports facts, the outer emits.
if [ "$IN_SLOT" -eq 1 ]; then
  IG_TEL_EMIT=0
  [[ "${INTEGRATION_GATE_FACTS:-}" == *integration-gate-slot.*/facts ]] && IG_FACTS="$INTEGRATION_GATE_FACTS"
else
  IG_TEL_EMIT=1
fi
# DND-1796: the re-exec marker is set only by step 3a' on the target's copy it
# materialised, inside the slot it holds; that copy never re-executes again,
# and it removes its own materialised tree when it exits. Outside a held slot
# the marker is refused: no caller sets it, so it is forged or stale, and a
# forged marker may only ever make a run refuse.
LANDED_REEXEC=0
LANDED_TMP=""
if [ "${INTEGRATION_GATE_LANDED_REEXEC:-}" = 1 ]; then
  if [ "$IN_SLOT" -ne 1 ]; then
    echo "${PROG}: INTEGRATION_GATE_LANDED_REEXEC is set, but this run holds no test slot; only step 3a' sets it, inside the slot." >&2
    echo "Fix: unset INTEGRATION_GATE_LANDED_REEXEC and INTEGRATION_GATE_SCRIPT_COMMON, then run ~/dev/custom/ai/bin/integration-gate again." >&2
    exit 2
  fi
  LANDED_REEXEC=1
  # The materialised tree is this copy's own top (SELF_DIR is
  # <top>/ai/skills/athena:merge-boarding/scripts) and nothing else.
  ld="$(cd "${SELF_DIR}/../../../.." 2>/dev/null && pwd -P)"
  if [ -n "${INTEGRATION_GATE_LANDED_DIR:-}" ] && [ "$(realpath -e "$INTEGRATION_GATE_LANDED_DIR" 2>/dev/null)" = "$ld" ] \
     && [[ "$(basename "$ld")" == integration-gate-landed.* ]]; then
    LANDED_TMP="$ld"
    trap 'rc=$?; rm -rf "$LANDED_TMP" 2>/dev/null; exit "$rc"' EXIT
  fi
fi
unset INTEGRATION_GATE_IN_SLOT INTEGRATION_GATE_PRESTARTED_CRITIC INTEGRATION_GATE_FACTS \
  INTEGRATION_GATE_LANDED_REEXEC INTEGRATION_GATE_SCRIPT_COMMON INTEGRATION_GATE_LANDED_DIR

if [ "$IN_SLOT" -eq 0 ]; then
  # A tree `git status` cannot even read (a corrupt object) is left for the run
  # inside the slot, which names the exact failure; only a readable dirty tree
  # is refused here, before it costs a queue wait.
  if [ -n "$HEAD0" ] && git -C "$ROOT" status --porcelain >/dev/null 2>&1; then
    refuse_dirty_tree "$HEAD0"
    if [ "$WITH_CRITIC" -eq 1 ]; then
      require_critic_tools
      fetch_target
      if ! "$CRITIC" --verdict-for "$HEAD0" --covering "$TARGET" >/dev/null 2>&1; then
        start_critic "$HEAD0"
        export INTEGRATION_GATE_PRESTARTED_CRITIC="${CRITIC_PGID} ${HEAD0} ${CRITIC_LOG}"
      fi
    fi
  fi
  # It replaces the telemetry trap, so it emits too: after the judge is
  # stopped, before SLOT_TMP (which holds the facts file) is removed.
  outer_cleanup() {
    local rc=$?
    [ -n "$CRITIC_PGID" ] && kill -TERM -- "-${CRITIC_PGID}" 2>/dev/null
    [ -n "$CRITIC_LOG" ] && rm -f "$CRITIC_LOG" 2>/dev/null
    ig_emit_run "$rc"
    [ -n "$SLOT_TMP" ] && rm -rf "$SLOT_TMP" 2>/dev/null
    return "$rc"
  }
  trap outer_cleanup EXIT
  SLOT_TMP="$(mktemp -d "${TMPDIR:-/tmp}/integration-gate-slot.XXXXXX")" || {
    SLOT_TMP=""
    echo "${PROG}: cannot create a private temp dir for the test-slot outcome." >&2
    echo "Fix: make ${TMPDIR:-/tmp} writable, then re-run. Nothing was checked." >&2
    exit 2
  }
  OUTCOME="${SLOT_TMP}/outcome"
  IG_FACTS_OUT="${SLOT_TMP}/facts"
  SLOT_ARGS=( --label "integration-gate $(basename "$ROOT") ${HEAD0:0:8}" --outcome-file "$OUTCOME" --pool cpu )
  [ -n "$SLOT_WAIT" ] && SLOT_ARGS+=( --wait-timeout "$SLOT_WAIT" )
  gate_slot_weight
  echo "${PROG}: taking a machine test slot first (${SLOT_WEIGHT_NOTE}); the fetch and the containment check run inside it (DND-1064)"
  "$TEST_SLOT" "${SLOT_ARGS[@]}" -- env INTEGRATION_GATE_IN_SLOT=1 INTEGRATION_GATE_FACTS="$IG_FACTS_OUT" bash "$(realpath "${BASH_SOURCE[0]}")" "${ORIG_ARGS[@]}"
  SLOT_RC=$?
  OUTCOME_LINE="$(cat "$OUTCOME" 2>/dev/null)"
  if [[ "$OUTCOME_LINE" =~ ^ran\ exit=([0-9]+)$ ]]; then
    # The run inside the slot joined or stopped the judge on every path that
    # reaches the gate step; on an earlier exit (a containment refusal, say)
    # outer_cleanup stops it here.
    exit "${BASH_REMATCH[1]}"
  fi
  join_critic
  if [ "$OUTCOME_LINE" = timeout ]; then
    echo "${PROG}: GATE NOT RUN on ${HEAD0:0:12}: no machine test slot within the wait window." >&2
    echo "Fix: the machine's heavy-test slot pool stayed full (see test-slot's holder lines above, or run ~/dev/custom/ai/bin/test-slot --status). Nothing was checked, so this is neither OK nor RED. Re-run integration-gate; do not merge on it." >&2
  else
    echo "${PROG}: GATE NOT RUN on ${HEAD0:0:12}: test-slot left no outcome (exit ${SLOT_RC}; outcome '${OUTCOME_LINE:-<absent>}')." >&2
    echo "Fix: test-slot left no outcome, so whether the gate ran is unknown; this is neither OK nor RED. Read test-slot's lines above (a refusal names its own Fix:), check ${TEST_SLOT} --help, then re-run integration-gate; do not merge on it." >&2
  fi
  exit 6
fi

# Inside the slot. A judge the outer run started is adopted only if it is what
# it claims to be: a live critic-review process group, on a 40-hex head, with
# a temp log this script's mktemp pattern names.
PRE_PGID=""; PRE_SHA=""; PRE_LOG=""
if [ -n "$PRESTARTED" ]; then
  read -r p_pgid p_sha p_log <<<"$PRESTARTED"
  if [[ "$p_pgid" =~ ^[1-9][0-9]*$ ]] && [[ "$p_sha" =~ ^[0-9a-f]{40}$ ]] \
     && [[ "$(basename "${p_log:-x}")" == integration-gate-critic.* ]] && [ -f "$p_log" ] \
     && grep -q 'critic-review' <<<"$(tr '\0' ' ' <"/proc/${p_pgid}/cmdline" 2>/dev/null)" \
     && [ "$(proc_stat_field "/proc/${p_pgid}/stat" 3)" = "$p_pgid" ]; then
    PRE_PGID="$p_pgid"; PRE_SHA="$p_sha"; PRE_LOG="$p_log"
  elif [ -f "${p_log:-}" ] && [[ "$(basename "$p_log")" == integration-gate-critic.* ]]; then
    # The judge already finished (its verdict is on disk): adopt only the log.
    PRE_SHA="$p_sha"; PRE_LOG="$p_log"
  fi
fi

# --- 2. fetch (inside the slot) ----------------------------------------------
fetch_target

# --- 2b. --rebase: replay a clean branch onto the fetched target (DND-1064) --
# Only when HEAD does not already contain it. A dirty tree is refused before
# anything moves; a conflict is aborted and named, never resolved. The branch
# point before the rebase becomes the intersection anchor when no --since was
# given, so the file sets stay measurable after the replay.
if [ "$REBASE" -eq 1 ] \
   && R_TARGET="$(git rev-parse --verify -q "${TARGET}^{commit}" 2>/dev/null)" \
   && R_HEAD="$(git rev-parse --verify -q "HEAD^{commit}" 2>/dev/null)" \
   && ! git merge-base --is-ancestor "$R_TARGET" "$R_HEAD" 2>/dev/null; then
  # A main checkout is a shared surface (~/dev/custom/CLAUDE.md -> "Agents
  # work in worktrees, not the main checkout"), and a rewrite made in here is
  # invisible to worktree-escape-guard. A detached HEAD would leave the branch
  # at its old head while the receipt names the rebased one.
  if [ "$(git rev-parse --path-format=absolute --git-dir 2>/dev/null)" = "$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" ]; then
    echo "${PROG}: --rebase refused: ${ROOT} is a main checkout, and --rebase rewrites the checked-out branch." >&2
    echo "Fix: run integration-gate --rebase from the Mission's worktree, or drop --rebase here and rebase by hand (git rebase ${TARGET}) after checking nobody else is using this checkout." >&2
    exit 2
  fi
  if ! R_BRANCH="$(git symbolic-ref -q --short HEAD 2>/dev/null)"; then
    echo "${PROG}: --rebase refused: HEAD is detached at $(short "$R_HEAD"), so a rebase would move no branch and the receipt would name a head nothing points at." >&2
    echo "Fix: check out the Mission branch (git checkout <branch>) and re-run integration-gate --rebase." >&2
    exit 2
  fi
  refuse_dirty_tree "$R_HEAD"
  # The judge started before the wait reads this tree with git (index.lock),
  # and it judges a head the rebase replaces, so stop its whole process group
  # and let it drain BEFORE the rebase touches the index. Block on the leader
  # (bounded at 30 s), then KILL whatever is left of the group.
  if [ -n "$PRE_PGID" ]; then
    kill -TERM -- "-${PRE_PGID}" 2>/dev/null
    timeout 30 tail --pid="$PRE_PGID" -f /dev/null 2>/dev/null
    kill -KILL -- "-${PRE_PGID}" 2>/dev/null
    echo "${PROG}: --with-critic: stopped the judge started on ${PRE_SHA:0:12} before the slot wait; the rebased head is judged instead"
    PRE_PGID=""
  fi
  R_BASE="$(git merge-base "$R_HEAD" "$R_TARGET" 2>/dev/null)"
  # Pinned against user config: no rerere replay, no autostash, no other
  # branch's ref moved (updateRefs), no merge replay, no signing prompt that
  # could hang while the slot is held. An interrupt mid-rebase aborts it, so
  # the tree is never left with a rebase in progress.
  rebase_in_progress() { git rev-parse -q --verify REBASE_HEAD >/dev/null 2>&1 || [ -d "$(git rev-parse --git-path rebase-merge)" ] || [ -d "$(git rev-parse --git-path rebase-apply)" ]; }
  trap 'rebase_in_progress && git rebase --abort >/dev/null 2>&1; exit 130' INT
  trap 'rebase_in_progress && git rebase --abort >/dev/null 2>&1; exit 143' TERM
  trap 'rebase_in_progress && git rebase --abort >/dev/null 2>&1; exit 129' HUP
  R_ERR="$(git -c rerere.enabled=false -c rebase.autoStash=false -c rebase.updateRefs=false \
             -c rebase.rebaseMerges=false -c commit.gpgSign=false \
             rebase --quiet --no-update-refs --no-rebase-merges "$R_TARGET" 2>&1)"
  R_RC=$?
  trap - INT TERM HUP
  if [ "$R_RC" -ne 0 ]; then
    R_CONFLICTS="$(git diff --name-only --diff-filter=U 2>/dev/null)"
    R_KIND="REBASE FAILED (not a conflict)"; [ -n "$R_CONFLICTS" ] && R_KIND="REBASE CONFLICT"
    if rebase_in_progress; then
      git rebase --abort >/dev/null 2>&1 || {
        echo "${PROG}: ${R_KIND}, and 'git rebase --abort' also failed; the rebase is still in progress in ${ROOT}." >&2
        echo "Fix: run 'git rebase --abort' in ${ROOT} by hand (or 'git status' to see what is left), confirm ${R_BRANCH} is back at $(short "$R_HEAD"), then rebase onto ${TARGET} yourself." >&2
        exit 2
      }
    fi
    if [ -n "$R_CONFLICTS" ]; then
      echo "${PROG}: REBASE CONFLICT rebasing $(short "$R_HEAD") onto ${TARGET} ($(short "$R_TARGET")); the rebase was aborted and the branch is back at $(git rev-parse --short HEAD). Conflicting paths:" >&2
      printf '%s\n' "$R_CONFLICTS" | sed 's/^/    /' >&2
      echo "Fix: rebase onto ${TARGET} yourself (git rebase ${TARGET}), resolve the conflicts above, run the local gate, commit, and re-run integration-gate. --rebase never resolves a conflict." >&2
    else
      # Not a conflict: git refused to start or continue (a held index.lock,
      # a hook). Never report that as a conflict -- there is nothing to resolve.
      echo "${PROG}: REBASE FAILED (not a conflict) rebasing $(short "$R_HEAD") onto ${TARGET} ($(short "$R_TARGET")); the branch is at $(git rev-parse --short HEAD). git said:" >&2
      printf '%s\n' "$R_ERR" | head -20 | sed 's/^/    /' >&2
      echo "Fix: read git's error above (a stale .git/index.lock left by a killed git process, or a failing hook), clear its cause, confirm 'git status' is clean at $(short "$R_HEAD"), then re-run integration-gate --rebase." >&2
    fi
    exit 2
  fi
  echo "${PROG}: rebased $(short "$R_HEAD") onto ${TARGET} ($(short "$R_TARGET")) inside the slot -> $(git rev-parse --short HEAD)"
  ig_fact rebased true
  [ -z "$SINCE" ] && [ -n "$R_BASE" ] && SINCE="$R_BASE"
fi

# --- 3. resolve the refs ---------------------------------------------------
if ! HEAD_SHA="$(git rev-parse --verify "HEAD^{commit}" 2>/dev/null)"; then
  echo "${PROG}: HEAD does not resolve to a commit (unborn branch?)." >&2
  echo "Fix: check out the Mission branch with at least one commit, then re-run." >&2
  exit 2
fi
ig_fact head "$HEAD_SHA"

# --- 3a. the receipt (DND-965) ---------------------------------------------
# One store per REPO, not per checkout: the git common dir is the same for the
# main checkout and every linked worktree, so locked-merge finds the receipt
# whichever checkout it runs from. --path-format=absolute because plain
# --git-common-dir is cwd-relative (".git") in a main checkout.
if ! command -v jq >/dev/null 2>&1; then
  echo "${PROG}: jq is not on PATH, so a pass could not be recorded as a receipt." >&2
  echo "Fix: install jq and re-run. locked-merge refuses a head with no receipt, so a pass this script cannot record is not a pass." >&2
  exit 2
fi
COMMON_DIR="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
case "$COMMON_DIR" in
  /*) ;;
  *) echo "${PROG}: git common dir did not resolve to an absolute path (got '${COMMON_DIR}')." >&2
     echo "Fix: run from a normal checkout or linked worktree of the repo with git >= 2.31 (--path-format). The receipt store cannot be located otherwise." >&2
     exit 2 ;;
esac
RECEIPT_DIR="$(ir_store "$COMMON_DIR")"
RECEIPT="$(ir_receipt_path "$COMMON_DIR" "$HEAD_SHA")"
RECEIPT_TMP=""
# A run that does not end in INTEGRATION OK leaves no pass for its head. The
# up-front removal covers a run that is killed; the EXIT trap covers a pass
# another run recorded for this head while this one went RED.
if ! rm -f "$RECEIPT" 2>/dev/null; then
  echo "${PROG}: could not remove the earlier receipt ${RECEIPT}." >&2
  echo "Fix: make ${RECEIPT_DIR} writable (ls -ld '${RECEIPT_DIR}') and re-run. A stale pass this run cannot clear would outlive its result." >&2
  exit 5
fi
clear_receipt_on_failure() {
  local rc=$?
  # A --with-critic judge still running when this script leaves must not be
  # orphaned (the orphaned-spin-loop class). It runs as its own process-group leader, so
  # one group signal reaches critic-review AND the `claude -p` it spawns.
  [ -n "$CRITIC_PGID" ] && kill -TERM -- "-${CRITIC_PGID}" 2>/dev/null
  [ -n "$CRITIC_LOG" ] && rm -f "$CRITIC_LOG" 2>/dev/null
  [ -n "$SLOT_TMP" ] && rm -rf "$SLOT_TMP" 2>/dev/null
  [ -n "$RECEIPT_TMP" ] && rm -f "$RECEIPT_TMP" 2>/dev/null
  [ -n "$LANDED_TMP" ] && rm -rf "$LANDED_TMP" 2>/dev/null
  [ "$rc" -ne 0 ] && rm -f "$RECEIPT" 2>/dev/null
  return "$rc"
}
trap clear_receipt_on_failure EXIT

# A target ref that does not resolve is an ERROR, not an empty result: a
# mistyped or never-fetched ref must never read as "nothing to integrate".
if ! TARGET_SHA="$(git rev-parse --verify "${TARGET}^{commit}" 2>/dev/null)"; then
  echo "${PROG}: target ref '${TARGET}' does not resolve to a commit in $(pwd)." >&2
  echo "Fix: name a ref that exists here (git remote -v; git branch -r). A wrong ref must not be mistaken for 'no drift' -- this is an error, not an empty result." >&2
  exit 2
fi
ig_fact base "$TARGET_SHA"
BASE_SHA="$(git merge-base HEAD "$TARGET_SHA" 2>/dev/null)"
if [ -z "$BASE_SHA" ]; then
  echo "${PROG}: HEAD and '${TARGET}' share no merge base (unrelated histories)." >&2
  echo "Fix: confirm you are in the right worktree and that '${TARGET}' is this repo's integration target." >&2
  exit 2
fi

# --- 3a'. the judges are the LANDED ones, read out of git (DND-1796) -------
# ~/dev/custom/CLAUDE.md -> "A check's own bar must not live in the diff it is
# checking". When the gated repo is the repo that holds this script (custom
# gating custom), a branch can edit its own judges: this script and the libs
# it sources, blast-radius, its manifest (ai/blast-radius/surfaces.json), the
# owner verifiers (ai/lib/owner_turn.rb, ai/lib/owner_click.rb) and the
# standing judge critic-review. They used to resolve beside the running
# script, so from the Mission's worktree they were the branch's copies: a
# commit that dropped a held surface from the manifest read COLD and cleared
# its own exit 4 (probe, 2026-10-02). So, in that repo:
#   - the copy the caller started materialises the TARGET's ai/ tree out of
#     git (git archive TARGET_SHA ai) into a private temp dir, and re-executes
#     the gate found there, inside the slot it holds. Everything that copy
#     resolves beside itself is then the target's: its libs, blast-radius and
#     its manifest and verifiers, critic-review, teardown-stack. No checkout's
#     working tree is read, the main checkout's included.
#   - that copy (the re-exec marker set) asserts its judges are blob-equal to
#     the target's, and removes the temp dir when it exits.
#   - a judge the copy that started it ran beside the slot wait (the
#     --with-critic pre-start) is adopted only if that checkout's critic-review
#     and ai/lib are the target's; otherwise it is stopped and the landed
#     judge runs.
# A path the target lacks, or an object git cannot read, is an ERROR (exit 2),
# never a fall back to the branch's copy and never a pass.
# A gated repo that does NOT hold this script (gen_saas gated by custom's
# gate) cannot edit these judges in its diff, so they still resolve beside
# the script there.
# Residual, said out loud: this runs in whichever copy the caller starts. A
# branch whose own copy drops it defeats it when a caller runs that copy;
# what that copy's own judges seal does not pass: receipts are sealed with
# the blobs of the files that wrote them, and a reader refuses an unlanded
# producer (DND-1814, ai/lib/receipt_seal.rb). That copy can still run the
# LANDED sealer on purpose and get an accepted receipt: OPEN, DND-1808 (a),
# the sealer is an oracle to any same-uid process. The main checkout's
# ~/dev/custom/ai/bin/integration-gate is landed code, which is why the briefs
# and athena:merge-boarding name that path.
IG_SELF_REL="ai/skills/athena:merge-boarding/scripts/integration-gate"
# The judges the re-executed copy asserts are the target's.
IG_JUDGE_PATHS=( "$IG_SELF_REL" ai/lib/integration-receipt.sh ai/lib/proc-stat.sh ai/lib/telemetry-emit.sh
  ai/bin/blast-radius ai/blast-radius/surfaces.json ai/lib/owner_turn.rb ai/lib/owner_click.rb ai/bin/critic-review
  ai/bin/receipt-seal ai/lib/receipt_seal.rb )
# SELF_DIR is <top>/ai/skills/athena:merge-boarding/scripts: four levels up.
SELF_TOP="$(cd "${SELF_DIR}/../../../.." 2>/dev/null && pwd -P)"
COMMON_REAL="$(realpath -e "$COMMON_DIR" 2>/dev/null)"
SELF_COMMON_REAL="$(realpath -e "$SELF_COMMON" 2>/dev/null)"
if [ -z "$COMMON_REAL" ] || [ -z "$SELF_COMMON_REAL" ] || [ -z "$SELF_TOP" ]; then
  echo "${PROG}: cannot tell whether ${ROOT} is the repo that holds this gate: realpath of '${COMMON_DIR}' -> '${COMMON_REAL}', of '${SELF_COMMON}' -> '${SELF_COMMON_REAL}', this copy's top -> '${SELF_TOP}'." >&2
  echo "Fix: run ~/dev/custom/ai/bin/integration-gate from a readable checkout; 'could not tell' never reads as 'another repo', which would let the branch's own judges run (DND-1796)." >&2
  exit 2
fi
JUDGE_SAME_REPO=0
[ "$COMMON_REAL" = "$SELF_COMMON_REAL" ] && JUDGE_SAME_REPO=1
if [ "$LANDED_REEXEC" -eq 1 ] && [ "$JUDGE_SAME_REPO" -ne 1 ]; then
  echo "${PROG}: this is a re-executed landed copy, but ${ROOT} is not the repo that started it (${SELF_COMMON_REAL})." >&2
  echo "Fix: unset INTEGRATION_GATE_LANDED_REEXEC and INTEGRATION_GATE_SCRIPT_COMMON and run ~/dev/custom/ai/bin/integration-gate again; only step 3a' sets them." >&2
  exit 2
fi
if [ "$JUDGE_SAME_REPO" -eq 1 ] && [ "$LANDED_REEXEC" -eq 0 ]; then
  LANDED_TMP="$(mktemp -d "${TMPDIR:-/tmp}/integration-gate-landed.XXXXXX")" || {
    LANDED_TMP=""
    echo "${PROG}: cannot create a private temp dir for the landed judges." >&2
    echo "Fix: make ${TMPDIR:-/tmp} writable, then re-run. Nothing was judged." >&2
    exit 2
  }
  LANDED_ERR="$( { git archive --format=tar "$TARGET_SHA" ai | tar -x -C "$LANDED_TMP"; printf ' rc=%s/%s' "${PIPESTATUS[0]}" "${PIPESTATUS[1]}"; } 2>&1 )"
  LANDED_MISSING=""
  for p in "${IG_JUDGE_PATHS[@]}"; do [ -f "${LANDED_TMP}/${p}" ] || LANDED_MISSING="${LANDED_MISSING} ${p}"; done
  if [ "${LANDED_ERR##* rc=}" != "0/0" ] || [ -n "$LANDED_MISSING" ]; then
    echo "${PROG}: cannot materialise the landed judges from ${TARGET} ($(short "$TARGET_SHA"))${LANDED_MISSING:+; it does not hold:${LANDED_MISSING}}. git archive | tar said:${LANDED_ERR}" >&2
    echo "Fix: the gate, classifier, manifest, verifiers and critic that judge this head are the ones on ${TARGET}. Check they are there (git ls-tree ${TARGET} --${LANDED_MISSING:- ai}) and that the object store is readable (git fsck). A judge the branch adds or edits never judges itself, and 'could not materialise' is never a pass (DND-1796)." >&2
    exit 2
  fi
  REEXEC_PRESTARTED=""
  if [ -n "$PRESTARTED" ]; then
    if git -C "$SELF_TOP" diff --quiet "$TARGET_SHA" -- ai/bin/critic-review ai/lib 2>/dev/null; then
      REEXEC_PRESTARTED="$PRESTARTED"
    else
      # Started beside the slot wait by THIS copy's critic-review, which is not
      # the target's: never let it write the verdict the landed gate reads.
      if [ -n "$PRE_PGID" ]; then
        kill -TERM -- "-${PRE_PGID}" 2>/dev/null
        timeout 30 tail --pid="$PRE_PGID" -f /dev/null 2>/dev/null
        kill -KILL -- "-${PRE_PGID}" 2>/dev/null
      fi
      [ -n "$PRE_LOG" ] && rm -f "$PRE_LOG" 2>/dev/null
      echo "${PROG}: --with-critic: stopped the judge this copy started on ${PRE_SHA:0:12}: its critic-review or ai/lib is not the target's; the landed judge runs instead"
    fi
  fi
  REEXEC_ARGS=( "${ORIG_ARGS[@]}" --no-fetch )
  [ "$SINCE" != "$ARG_SINCE" ] && REEXEC_ARGS+=( --since "$SINCE" )
  echo "${PROG}: re-executing the landed copy of this gate, as on ${TARGET} ($(short "$TARGET_SHA")), read out of git into ${LANDED_TMP}; this checkout's copy (${SELF_TOP}) never judges (DND-1796)"
  # exec skips this run's EXIT trap: nothing below the receipt removal has
  # allocated anything but LANDED_TMP, which the landed copy removes itself.
  # The fetch already ran in this slot (--no-fetch), so it judges this target.
  exec env INTEGRATION_GATE_IN_SLOT=1 INTEGRATION_GATE_LANDED_REEXEC=1 \
    INTEGRATION_GATE_SCRIPT_COMMON="$SELF_COMMON_REAL" INTEGRATION_GATE_LANDED_DIR="$LANDED_TMP" \
    INTEGRATION_GATE_FACTS="${IG_FACTS}" INTEGRATION_GATE_PRESTARTED_CRITIC="${REEXEC_PRESTARTED}" \
    bash "${LANDED_TMP}/${IG_SELF_REL}" "${REEXEC_ARGS[@]}"
fi
if [ "$LANDED_REEXEC" -eq 1 ]; then
  # This copy was materialised from git a moment ago; assert it is the target
  # it judges against (a target that moved in between is a refusal).
  JUDGE_DIFFERS=""
  for p in "${IG_JUDGE_PATHS[@]}"; do
    want="$(git rev-parse -q --verify "${TARGET_SHA}:${p}" 2>/dev/null)"
    have="$(git hash-object -- "${SELF_TOP}/${p}" 2>/dev/null)"
    { [ -n "$want" ] && [ "$want" = "$have" ]; } || JUDGE_DIFFERS="${JUDGE_DIFFERS} ${p}"
  done
  if [ -n "$JUDGE_DIFFERS" ]; then
    echo "${PROG}: the landed copy in ${SELF_TOP} is not ${TARGET} ($(short "$TARGET_SHA")) in:${JUDGE_DIFFERS}." >&2
    echo "Fix: ${TARGET} moved while the gate started, or the copy was altered; re-run ~/dev/custom/ai/bin/integration-gate. Only the target's judges judge this head (DND-1796)." >&2
    exit 2
  fi
  echo "${PROG}: judging with the gate, blast-radius, its manifest, the owner verifiers and critic-review as landed on ${TARGET} ($(short "$TARGET_SHA")), read out of git; never this branch's copies (DND-1796)"
  JUDGE_EDITS="$(git diff --name-only "${TARGET_SHA}...HEAD" -- "${IG_JUDGE_PATHS[@]}" ai/lib 2>/dev/null | sort -u)"
  if [ -n "$JUDGE_EDITS" ]; then
    echo "${PROG}: NOTE this branch edits judge code; the landed copies judge it, not these:"
    printf '%s\n' "$JUDGE_EDITS" | sed 's/^/    /'
  fi
fi

# --- 3b. resolve the gate from the LANDED target (DND-479) ---------------
# The gate command used to be caller-supplied, so `--gate true` turned this
# whole script into a pass that printed INTEGRATION OK exactly like a real run
# (gen_saas PR #337, 2026-09-24). That is ~/dev/custom/CLAUDE.md -> "A check's
# own bar must not live in the diff it is checking", one step removed: the bar
# lived in argv. So a repo's gate is DECLARED by convention -- the first of
# these paths that exists on the target ref, read out of git, never the working
# tree -- and argv cannot replace it. No file in any tenant repo is needed: the
# convention matches what gen_saas (bin/prep-commit.sh, verify-only since
# DND-214) and ~/dev/custom (ai/bin/harness-gate) already ship. The list and
# the lookup are IR_DECLARED_GATES / ir_declared_gate_on in
# ai/lib/integration-receipt.sh, which gh-athena's merge guard also asks.

trim() { local s="$1"; s="${s#"${s%%[![:space:]]*}"}"; s="${s%"${s##*[![:space:]]}"}"; printf '%s' "$s"; }

# A gate path as git names it: no leading ./, no absolute repo-root prefix.
norm_path() { local p; p="$(trim "$1")"; p="${p#./}"; case "$p" in "$ROOT"/*) p="${p#"$ROOT"/}" ;; esac; printf '%s' "$p"; }

# is_noop_simple <command>: one simple command that can never fail. Quote- and
# grouping-unaware ON PURPOSE: a false positive refuses (fails closed), and the
# refusal says how to pass a real gate.
is_noop_simple() {
  local s
  s="$(printf '%s' "$1" | tr -d "'\"(){}" | tr -s '[:space:]' ' ')"; s="$(trim "$s")"
  while :; do
    case "$s" in
      builtin\ *|command\ *|env\ *|exec\ *|nohup\ *|time\ *) s="$(trim "${s#* }")" ;;
      *) break ;;
    esac
  done
  case "$s" in
    ''|:|:\ *|true|true\ *|/bin/true|/bin/true\ *|/usr/bin/true|/usr/bin/true\ *) return 0 ;;
    exit|'exit 0'|return|'return 0'|echo|echo\ *|printf|printf\ *|sleep|sleep\ *) return 0 ;;
    '! false'|'! /bin/false'|'! /usr/bin/false') return 0 ;;
    sh\ -c\ *|bash\ -c\ *|zsh\ -c\ *|dash\ -c\ *) is_noop_cmd "${s#* -c }"; return $? ;;
  esac
  return 1
}

# all_parts_noop <chain>: an `&&` / `|` chain never fails only if no part can.
all_parts_noop() {
  local chain="${1//&&/$'\001'}" part parts
  chain="${chain//|/$'\001'}"
  IFS=$'\001' read -ra parts <<<"$chain"
  for part in "${parts[@]}"; do is_noop_simple "$part" || return 1; done
  return 0
}

# is_noop_cmd <command>: true when the command's exit status is 0 whatever the
# checks inside it do -- a bare no-op, or a real check whose failure is masked
# (`x || true`, `x; true`, `x &`). The exit status is the LAST statement's, and
# an `||` alternative that cannot fail forces that statement green.
is_noop_cmd() {
  local cmd last alt rest
  cmd="$(trim "$(printf '%s' "$1" | tr '\n' ';')")"
  case "$cmd" in *'&&') ;; *'&') return 0 ;; esac
  last="$cmd"
  while :; do last="$(trim "$last")"; case "$last" in *';') last="${last%;}" ;; *) break ;; esac; done
  [ -z "$last" ] && return 0
  last="${last##*;}"
  rest="${last//&&/$'\001'}"; rest="${rest##*&}"; last="${rest//$'\001'/&&}"
  rest="$last"
  while :; do
    alt="${rest%%||*}"
    all_parts_noop "$alt" && return 0
    [ "$rest" = "$alt" ] && break
    rest="${rest#*||}"
  done
  return 1
}

if LANDED_GATE="$(ir_declared_gate_on "$ROOT" "$TARGET_SHA")"; then DECL_RC=0; else DECL_RC=$?; fi
if [ "$DECL_RC" -eq 2 ]; then
  # TARGET_SHA was verified above, so this is a repository fault, and it must
  # never read as "no gate declared".
  echo "${PROG}: ${TARGET} ($(short "$TARGET_SHA")) is not readable in $(pwd), so its declared gate could not be looked up." >&2
  echo "Fix: repair the object store (git fsck; git fetch origin) and re-run. 'Could not look' is not 'no gate declared'." >&2
  exit 2
fi
if [ "$DECL_RC" -eq 0 ]; then
  if [ -n "$GATE_CMD" ] && [ "$(norm_path "$GATE_CMD")" != "$LANDED_GATE" ]; then
    echo "${PROG}: --gate '${GATE_CMD}' refused -- ${TARGET} ($(short "$TARGET_SHA")) declares this repo's gate as ${LANDED_GATE}, and argv may not replace it." >&2
    echo "Fix: drop --gate; ${LANDED_GATE} (the gate as it stands on ${TARGET}) runs by default. The bar is read from the landed target so neither a caller nor the branch under test can lower it (~/dev/custom/CLAUDE.md -> 'A check's own bar must not live in the diff it is checking'). To change the bar, land that change on ${TARGET} first." >&2
    exit 2
  fi
  GATE_CMD="$LANDED_GATE"
  GATE_SOURCE="declared on ${TARGET}"
else
  if [ -z "$GATE_CMD" ]; then
    echo "${PROG}: ${TARGET} ($(short "$TARGET_SHA")) declares no gate (looked for: ${IR_DECLARED_GATES[*]}) and no --gate was passed." >&2
    echo "Fix: pass this repo's real local gate, e.g. --gate 'mix test' or --gate 'cd backend && mix test'. A gate the branch itself adds is not a declaration -- it must be on ${TARGET} first." >&2
    exit 2
  fi
  if is_noop_cmd "$GATE_CMD"; then
    echo "${PROG}: --gate '${GATE_CMD}' refused -- it can never fail, so it would print INTEGRATION OK without checking anything (DND-479)." >&2
    echo "Fix: pass a command that runs this repo's checks and exits non-zero when they fail, e.g. --gate 'mix test'. Not: true, :, exit 0, echo ..., an empty string, or a real check masked by '|| true', '; true' or a trailing '&'. If this repo has no gate at all, hold the MR and say so -- do not merge on a no-op." >&2
    exit 2
  fi
  GATE_SOURCE="caller-supplied; no gate declared on ${TARGET}"
fi

# A gate the branch EDITS is the same class one step removed: the branch picks
# its own bar. It still runs (a check the branch adds must run on integration,
# and running the landed copy would mean writing it into this tree -- this
# script never writes -- or running it out of place, where its sibling-relative
# paths break). So it is marked, loudly, in the run and in every OK line.
GATE_EDITED=0
GATE_FILE="$(norm_path "$GATE_CMD")"; GATE_FILE="${GATE_FILE%% *}"
if [ -n "$GATE_FILE" ]; then
  landed_blob="$(git rev-parse -q --verify "${TARGET_SHA}:${GATE_FILE}" 2>/dev/null)"
  head_blob="$(git rev-parse -q --verify "${HEAD_SHA}:${GATE_FILE}" 2>/dev/null)"
  if [ -n "${landed_blob}${head_blob}" ]; then
    if [ "$landed_blob" != "$head_blob" ] || ! git diff --quiet HEAD -- "$GATE_FILE" 2>/dev/null; then
      GATE_EDITED=1
      echo "${PROG}: WARN gate '${GATE_FILE}' differs from ${TARGET} ($(short "$TARGET_SHA")) -- this branch (or its working tree) edits the gate that judges it. The copy that runs is the branch's, not the landed one: review that diff (git diff ${TARGET} -- ${GATE_FILE}) before merging." >&2
    fi
  fi
fi
GATE_LABEL="${GATE_CMD} -- ${GATE_SOURCE}"
[ "$GATE_EDITED" -eq 1 ] && GATE_LABEL="${GATE_LABEL}; EDITED BY THIS BRANCH"

# The anchor the file sets are measured from. An unresolvable --since is an
# ERROR, not a silent fallback to the merge-base -- falling back would quietly
# answer a different question than the one asked.
if [ -n "$SINCE" ]; then
  if ! ANCHOR="$(git rev-parse --verify "${SINCE}^{commit}" 2>/dev/null)"; then
    echo "${PROG}: --since ref '${SINCE}' does not resolve to a commit in $(pwd)." >&2
    echo "Fix: pass a resolvable SHA/ref for the baseline your branch was gated against (see your state log's 'baseline main =='), or omit --since." >&2
    exit 2
  fi
else
  ANCHOR="$BASE_SHA"
fi

# --- 4. drift verdict, printed EITHER WAY ----------------------------------
# A no-drift run must never look like a skipped run.
AHEAD="$(git rev-list --count "${BASE_SHA}..${TARGET_SHA}" 2>/dev/null || echo 0)"
if [ "$BASE_SHA" = "$TARGET_SHA" ]; then
  echo "${PROG}: target '${TARGET}' unchanged since branch point ($(short "$TARGET_SHA"))."
else
  echo "${PROG}: target '${TARGET}' advanced $(short "$BASE_SHA") -> $(short "$TARGET_SHA") (${AHEAD} commit(s))."
fi

# --- 5. the three file sets (input to the replay-churn rule) ---------------
# Measured from ANCHOR, printed on BOTH the pass and the exit-2 path so a
# still-behind branch can see what is coming at it.
#
# The intersection is UNAVAILABLE, never "empty", when the anchor has collapsed
# onto the target with no --since supplied: once HEAD contains the target,
# merge-base(HEAD,target) IS the target, so the incoming delta is empty BY
# CONSTRUCTION and says nothing about what actually landed. Reporting that as
# an empty intersection would read as "the incoming delta missed my reviewed
# files -- board it", which is a failed lookup wearing an empty result's
# clothes.
# INCOMING is measured from the ANCHOR (what landed on the target since the
# branch was last gated). MINE is measured from the MERGE-BASE, never the
# anchor: from the anchor, "my" set would also contain every file the branch
# merely INHERITED by rebasing over the target, which then shows up in the
# intersection as a fake overlap and forces a replay nobody needed.
# Both lists name BOTH sides of a rename or copy (DND-770): git's default
# rename detection (diff.renames) lists only the new path, so a branch that
# renamed a file the target had just edited read an empty intersection.
# -z keeps a non-ASCII path verbatim; core.quotePath would C-quote it.
#
# A `git diff` failure here (a corrupt object, a missing merge base) must
# never be swallowed by `2>/dev/null`: that would report an empty file set,
# indistinguishable from "these two refs really touch nothing in common" --
# the exact failed-lookup class this script exists to refuse elsewhere
# (~/dev/custom/ai/CLAUDE.md -> "A failed lookup must never look like an
# empty one"). Both refs were already validated as resolvable commits before
# this point (TARGET/SINCE above), so a failure here is an ERROR -- the repo
# itself, not a bad argument -- and it exits loudly rather than returning "".
changed_paths() {
  # The raw -z output is NUL-delimited and MUST stay in a pipeline, never in
  # a bash variable: `$(...)` capture cannot hold a NUL byte, so a capture-
  # then-check rewrite silently drops every delimiter and runs all the
  # filenames together (caught by this change's own self-test, case 22, on
  # the first attempt). So stdout goes straight to `tr`/`sort` as before;
  # only stderr and the exit status are captured, to a file (a second
  # variable capture of raw diff output would reintroduce the same defect).
  local errfile rc
  errfile="$(mktemp 2>/dev/null)" || { echo "${PROG}: mktemp failed; cannot safely check git diff's exit status." >&2; echo "Fix: ensure \$TMPDIR (or /tmp) is writable and re-run." >&2; return 2; }
  git diff --no-renames -z --name-only "$1" "$2" 2>"$errfile" | tr '\0' '\n' | sort -u
  rc="${PIPESTATUS[0]}"
  if [ "$rc" -ne 0 ]; then
    echo "${PROG}: git diff failed measuring changed paths between '$1' and '$2':" >&2
    sed 's/^/    /' "$errfile" >&2
    rm -f "$errfile"
    echo "Fix: this is a repository fault (a corrupt object, an unreachable commit), not an empty result -- inspect '$1' and '$2' directly (git diff --stat '$1' '$2') and repair the object database (git fsck) before re-running; this run does not proceed on an unmeasurable file set." >&2
    return 2
  fi
  rm -f "$errfile"
}
if ! INCOMING="$(changed_paths "$ANCHOR" "$TARGET_SHA")"; then
  exit 2
fi
if ! MINE="$(changed_paths "$BASE_SHA" HEAD)"; then
  exit 2
fi
OVERLAP="$(comm -12 <(printf '%s\n' "$INCOMING" | sed '/^$/d') <(printf '%s\n' "$MINE" | sed '/^$/d'))"

INTERSECTION_AVAILABLE=1
if [ -z "$SINCE" ] && [ "$ANCHOR" = "$TARGET_SHA" ]; then
  INTERSECTION_AVAILABLE=0
fi

echo "--- incoming delta (${TARGET} since $(short "$ANCHOR"))"
printf '%s\n' "$INCOMING" | sed '/^$/d' | sed 's/^/    /'
echo "--- your branch (its own commits, since $(short "$BASE_SHA"))"
printf '%s\n' "$MINE" | sed '/^$/d' | sed 's/^/    /'
echo "--- intersection (drives the No replay churn coverage-intersection rule)"
if [ "$INTERSECTION_AVAILABLE" -eq 0 ]; then
  echo "    UNAVAILABLE -- HEAD already contains ${TARGET}, so the original branch point is unrecoverable and the incoming delta is empty by construction."
  echo "    Fix: re-run with --since <the target SHA this branch was last gated against> to get a real intersection before deciding replay. Do NOT read this as an empty intersection."
elif [ -z "$OVERLAP" ]; then
  echo "    (empty -- incoming delta is outside your reviewed file set)"
else
  printf '%s\n' "$OVERLAP" | sed 's/^/    /'
fi

# --- 7. shared-global advisory (never a failure by itself) ----------------
# These are judged by existing checks as ONE global document or number, so two
# disjoint branches can draw them down against each other. Advisory: the gate
# below is the judge; this only explains a red.
SHARED_RE='^(ai/bin/check-agent-size|ai/hooks/registry\.json|ai/inbox/registry\.json|ai/agents/.*|ai/blocks/.*)$'
SHARED_HITS="$(printf '%s\n%s\n' "$INCOMING" "$MINE" | sed '/^$/d' | sort -u | grep -E "$SHARED_RE" || true)"
if [ -n "$SHARED_HITS" ]; then
  echo "${PROG}: NOTE shared global(s) touched by one or both sides -- these are judged as a single budget/document, so green-alone does not imply green-merged:"
  printf '%s\n' "$SHARED_HITS" | sed 's/^/    /'
fi

# --- 7. HEAD must CONTAIN the target --------------------------------------
if ! git merge-base --is-ancestor "$TARGET_SHA" HEAD; then
  echo "${PROG}: HEAD ($(short "$HEAD_SHA")) does not contain ${TARGET} ($(short "$TARGET_SHA")). NOT safe to merge." >&2
  echo "Fix: your branch does not contain ${TARGET} ($(short "$TARGET_SHA")), read inside the test slot just now. Re-run with --rebase to rebase onto it inside the slot (it refuses on a conflict), or rebase yourself (git rebase ${TARGET}), resolve conflicts, re-run the local gate, then re-run this script (passing --since $(short "$TARGET_SHA") to keep the intersection meaningful)." >&2
  exit 2
fi

# --- 8. run the gate ON THE INTEGRATED HEAD, inside a machine test slot ----
# GATE_CMD was resolved in step 3b: the target's declared gate, or a vetted
# caller-supplied one. The same command string is eval'd in bash at $ROOT
# under `set -uo pipefail` (a caller gate like `make test | tee log` must stay
# RED when make fails); test-slot only decides when it starts (DND-486). One
# difference from the old in-process subshell: it runs in a child bash, so it
# sees exported variables only (no declared gate reads this script's own). The outcome is READ from test-slot's outcome file,
# never inferred from the exit code: a gate that itself exits 75 ran and
# failed, while a wait timeout never ran it at all. A missing or unreadable
# outcome is "not run" (exit 6), never RED and never OK -- a failed lookup
# must not read as a result.
#
# The gate runs in the WORKING TREE, but the receipt certifies the committed
# HEAD (DND-1011). So the tree must be exactly HEAD before the gate, and still
# be exactly HEAD after it. Untracked files count: a forgotten `git add` is how
# a head ships broken while its tree passes. Ignored files (build output,
# deps) do not.
refuse_dirty_tree "$HEAD_SHA"
if [ "$WITH_CRITIC" -eq 1 ]; then
  require_critic_tools
  if [ -n "$PRE_LOG" ] && [ "$PRE_SHA" = "$HEAD_SHA" ]; then
    # The judge the outer run started before the slot wait is on this very
    # head: adopt it (running, or already finished with its verdict on disk).
    CRITIC_PGID="$PRE_PGID"; CRITIC_LOG="$PRE_LOG"; CRITIC_ADOPTED=1; CRITIC_ACTIVE=1
    echo "${PROG}: --with-critic: the judge started on $(short "$HEAD_SHA") before the slot wait is adopted${PRE_PGID:+ (pgid ${PRE_PGID}, still running beside the gate)}"
  else
    if [ -n "$PRE_PGID" ]; then
      kill -TERM -- "-${PRE_PGID}" 2>/dev/null
      echo "${PROG}: --with-critic: stopped the judge started on ${PRE_SHA:0:12} before the slot wait; the head is now $(short "$HEAD_SHA")"
    fi
    [ -n "$PRE_LOG" ] && rm -f "$PRE_LOG" 2>/dev/null
    if "$CRITIC" --verdict-for "$HEAD_SHA" --covering "$TARGET_SHA" >/dev/null 2>&1; then
      echo "${PROG}: --with-critic: a PASS is already recorded for $(short "$HEAD_SHA"); the judge is not re-run."
    else
      start_critic "$HEAD_SHA"
    fi
  fi
fi

echo "${PROG}: running gate on the integrated head $(short "$HEAD_SHA") in a machine test slot: ${GATE_LABEL}"
SLOT_TMP="$(mktemp -d "${TMPDIR:-/tmp}/integration-gate-slot.XXXXXX")" || {
  SLOT_TMP=""
  echo "${PROG}: cannot create a private temp dir for the test-slot outcome." >&2
  echo "Fix: make ${TMPDIR:-/tmp} writable, then re-run. Nothing was checked." >&2
  exit 2
}
OUTCOME="${SLOT_TMP}/outcome"
SLOT_ARGS=( --label "integration-gate $(basename "$ROOT") $(short "$HEAD_SHA")" --outcome-file "$OUTCOME" )
[ -n "$SLOT_WAIT" ] && SLOT_ARGS+=( --wait-timeout "$SLOT_WAIT" )
# A declared gate held as `bash -c` is not one test-slot can read from argv,
# so it is named in ATHENA_TEST_SLOT_GATE_RUN: test-slot checks that claim
# against HEAD's declaration and writes the run's gate.run (DND-1530), which
# lead time's implement/verify anchor on. harness-gate writes its own event,
# so it is never claimed: an older test-slot ignores the variable and passes
# it on to the gate's environment, where a test-slot under test would read
# it. Telemetry only, and fail-open: nothing about the run changes.
GATE_RUN_CLAIM=""
[ "$DECL_RC" -eq 0 ] && [ "$LANDED_GATE" != ai/bin/harness-gate ] && GATE_RUN_CLAIM="${ROOT}/${LANDED_GATE}"
ATHENA_TEST_SLOT_GATE_RUN="$GATE_RUN_CLAIM" \
  "$TEST_SLOT" "${SLOT_ARGS[@]}" -- bash -c 'set -uo pipefail; cd "$1" && eval "$2"' _ "$ROOT" "$GATE_CMD"
SLOT_RC=$?
OUTCOME_LINE="$(cat "$OUTCOME" 2>/dev/null)"
case "$OUTCOME_LINE" in
  timeout)
    join_critic
    echo "${PROG}: GATE NOT RUN on $(short "$HEAD_SHA"): no machine test slot within the wait window." >&2
    echo "Fix: the machine's heavy-test slot pool stayed full (see test-slot's holder lines above, or run ~/dev/custom/ai/bin/test-slot --status). Nothing was checked, so this is neither OK nor RED. Re-run integration-gate; do not merge on it." >&2
    exit 6 ;;
  "ran exit=0") GATE_RC=0 ;;
  *)
    if [[ "$OUTCOME_LINE" =~ ^ran\ exit=([0-9]+)$ ]]; then
      GATE_RC="${BASH_REMATCH[1]}"
    else
      join_critic
      echo "${PROG}: GATE NOT RUN on $(short "$HEAD_SHA"): test-slot left no outcome (exit ${SLOT_RC}; outcome '${OUTCOME_LINE:-<absent>}')." >&2
      echo "Fix: test-slot left no outcome, so whether the gate ran is unknown; this is neither OK nor RED. Read test-slot's lines above (a refusal names its own Fix:), check ${TEST_SLOT} --help, then re-run integration-gate; do not merge on it." >&2
      exit 6
    fi ;;
esac
record_stack_marker
if [ "$GATE_RC" -ne 0 ]; then
  join_critic
  echo "${PROG}: gate RED on the integrated head $(short "$HEAD_SHA") (gate exit ${GATE_RC})." >&2
  echo "Fix: the gate is RED on the integrated head $(short "$HEAD_SHA"); read the failing stage above. This tool ran only the integrated head, so it cannot tell a break from a flake. A test failing for a reason unrelated to this change (a timeout under load, a known Flaky ticket's test) is a flake: ticket it per athena:flaky-ticket, then re-run. Otherwise the integration broke it: a disjoint file set does not imply a disjoint gate (shared budgets/registries), so fix it on this branch and re-run. Do not merge on a RED." >&2
  exit 1
fi
AFTER_SHA="$(git -C "$ROOT" rev-parse --verify HEAD 2>/dev/null)"
DIRT="$(tree_dirt)"
if [ "$AFTER_SHA" != "$HEAD_SHA" ] || [ -n "$DIRT" ]; then
  echo "${PROG}: the gate changed the tree it judged: HEAD $(short "$HEAD_SHA") -> $(short "${AFTER_SHA:-unresolved}")${DIRT:+, with uncommitted paths:}" >&2
  [ -n "$DIRT" ] && printf '%s\n' "$DIRT" | head -20 >&2
  echo "Fix: the green run was of content other than $(short "$HEAD_SHA"), so it certifies nothing. Review what the gate wrote or committed, keep it on this branch if it is right, then re-run integration-gate on the new head." >&2
  exit 2
fi
join_critic

# --- 8b. the standing judge's verdict ON THE HEAD WE ARE DECLARING MERGEABLE -
# A judge that never ran, fail-opened, or had not finished yet used to be
# indistinguishable from one that PASSED, because all three were "exit 0, no
# record". critic-review now writes a per-SHA receipt; this reads it through
# critic-review's OWN reader (never a second copy of the semantics), so the
# same SHA-match discipline as "merge the SHA this script prints" applies to
# the verdict too. A verdict on an earlier commit is not a verdict on this one.
#
# --critic-override covers the ABSENCE of a verdict -- never ran, still
# running, fail-opened, receipt unreadable. It is NOT a way past a recorded
# BLOCK, and the ONLY way to know which of those you are in is to READ THE
# RECEIPT. So the read happens FIRST, unconditionally, and the override is
# applied to its result. It used to short-circuit the read entirely, which
# meant the flag silently also merged past a recorded BLOCK with real findings
# -- while printing "NO standing-judge verdict", the one line the admiral
# copies verbatim into its state log as the attributable record. The record
# then said the opposite of what happened. Reading first is a STRICT
# TIGHTENING: it can only ever REFUSE a merge the flag used to allow.
if [ ! -x "$CRITIC" ]; then
  echo "${PROG}: cannot locate critic-review (expected ${CRITIC})." >&2
  echo "Fix: run this script from its committed path under ~/dev/custom so the judge's verdict reader resolves. A judge that cannot be found is an ERROR, never a pass -- and --critic-override does NOT apply here, because with no reader 'no BLOCK recorded' cannot be told apart from 'nothing was read'." >&2
  exit 3
fi
VERDICT_OUT="$("$CRITIC" --verdict-for "$HEAD_SHA" --covering "$TARGET_SHA" 2>&1)"
VERDICT_RC=$?
# Same streams as before: the reader's PASS line on stdout, everything else on
# stderr. It is captured only so the override can NAME the state it overrode.
if [ "$VERDICT_RC" -eq 0 ]; then printf '%s\n' "$VERDICT_OUT"; else printf '%s\n' "$VERDICT_OUT" >&2; fi
# A CARRIED PASS (DND-986: critic-review found an identical change that had
# already passed) is a present verdict, so it gates exactly like a judged one.
# It is NAMED in the OK line and the receipt, so a post-merge defect can be
# traced to a carry. The reader's bracketed token is the machine-readable
# contract; its prose is not parsed. Only ever read from a PASS (exit 0).
# Round 3 (owner spec): a carried PASS on a moved base is confirmed by an
# INTERACTION review of the upstream delta; the reader then adds
# [critic-upstream=<from>..<to>], and the OK line names both.
CRITIC_CARRIED_FROM=""
CRITIC_UPSTREAM=""
if [ "$VERDICT_RC" -eq 0 ]; then
  CRITIC_CARRIED_FROM="$(grep -oE '\[critic-carried-from=[0-9a-f]{40}\]' <<<"$VERDICT_OUT" | head -n1 | grep -oE '[0-9a-f]{40}')"
  CRITIC_UPSTREAM="$(grep -oE '\[critic-upstream=[0-9a-f]{40}\.\.[0-9a-f]{40}\]' <<<"$VERDICT_OUT" | head -n1 | grep -oE '[0-9a-f]{40}\.\.[0-9a-f]{40}')"
fi

if [ -n "$CRITIC_OVERRIDE" ]; then
  if [ "$VERDICT_RC" -eq 2 ]; then
    echo "${PROG}: CRITIC OVERRIDE REFUSED for $(short "$HEAD_SHA") -- the standing judge recorded a BLOCK for this exact head. NOT safe to merge." >&2
    echo "Fix: --critic-override covers the ABSENCE of a verdict (never ran / still running / fail-open / unreadable receipt). A recorded BLOCK is information, not missing information, and no flag goes past it. Address the findings named above and re-run ~/dev/custom/ai/bin/critic-review to record a verdict for the new head; or hold this ONE MR and move to the next Mission (athena:merge-boarding -> 'The merge bar', the exit-3 bullet)." >&2
    exit 3
  fi
  # Name the state actually being overridden, READ from the receipt. The exit
  # code is the authority (critic-review's reader is the one place the rules
  # live); its own wording only supplies the label, and an unrecognised wording
  # degrades to "state not named" -- never to a guess.
  if [ "$VERDICT_RC" -eq 0 ]; then
    OVERRIDE_STATE="UNUSED -- a recorded PASS verdict already exists for this head"
  else
    case "$VERDICT_OUT" in
      *"IN PROGRESS"*)          OVERRIDE_STATE="judge run STILL RUNNING" ;;
      *"FAILED OPEN"*)          OVERRIDE_STATE="judge FAILED OPEN (infra/model error)" ;;
      # "no receipt recorded" is a searched-and-missed state, never proof the
      # judge did not run (DND-457: a lookup that only read its own worktree
      # used to print "has NOT run" for a PASS sitting in another checkout).
      *"no receipt recorded"*)  OVERRIDE_STATE="NO RECEIPT for this head in any checkout of this repo" ;;
      *"UNVERIFIED PASS"*)      OVERRIDE_STATE="receipt UNVERIFIED (unsealed, edited, or from an unlanded judge: no verdict)" ;;
      *"COULD NOT LOOK"*)       OVERRIDE_STATE="verdict store COULD NOT BE READ (not a miss)" ;;
      *"CONFLICTING"*)          OVERRIDE_STATE="CONFLICTING receipts across checkouts (none is a BLOCK)" ;;
      *"DIRTY working tree"*)   OVERRIDE_STATE="verdict recorded against a DIRTY tree" ;;
      *)                        OVERRIDE_STATE="no green verdict; state not named -- see the critic-review line above" ;;
    esac
  fi
  echo "${PROG}: CRITIC OVERRIDE for $(short "$HEAD_SHA") -- state overridden: ${OVERRIDE_STATE}; reason: ${CRITIC_OVERRIDE}" >&2
  echo "Fix: copy the INTEGRATION OK line below verbatim into your run's state log and name the override in the final report, so this decision is attributable." >&2
elif [ "$VERDICT_RC" -ne 0 ]; then
  echo "${PROG}: no green standing-judge verdict on the integrated head $(short "$HEAD_SHA"). NOT safe to merge." >&2
  echo "Fix: see the critic-review line above — it names WHICH state you are in (no receipt in any checkout / still running / fail-open / dirty tree / conflicting / unverified (an unsealed or forged receipt, DND-1814) / could not look / block). Get a verdict (re-run ~/dev/custom/ai/bin/critic-review here), or hold this ONE MR and move to the next Mission. If and ONLY IF the state is an ABSENCE of a verdict, merge past it with --critic-override '<reason>'; a recorded BLOCK is refused even with that flag." >&2
  exit 3
fi

# --- 8c. blast radius: what does MERGING this head CAUSE? ------------------
# Every criterion above asks whether the CODE is correct. None of them asks
# what merging DOES. Measured 2026-09-20 (gen_saas PR #256, DND-234): merging
# would have run `terraform apply -auto-approve` and created a real, billable
# AWS KMS key -- and the documented bar would have merged it, because nothing
# in the bar asked. This step asks the missing question. It is ADDITIVE: it can
# only ever REFUSE a merge the old bar allowed, never permit one it refused.
# Beside this script. In the repo that holds it, this script is the TARGET's
# copy that step 3a' materialised from git, so this is the target's
# classifier, manifest and verifiers (DND-1796).
BLAST="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../bin" 2>/dev/null && pwd)/blast-radius"
if [ ! -x "$BLAST" ]; then
  echo "${PROG}: cannot locate blast-radius (expected ${BLAST})." >&2
  echo "Fix: run this script from its committed path under ~/dev/custom so the blast-radius classifier resolves. A classifier that cannot be found is an ERROR, never a pass -- 'no surface touched' and 'nothing was checked' must never read the same." >&2
  exit 2
fi
BLAST_ARGS=( --base "$TARGET_SHA" --head "$HEAD_SHA" --repo "$ROOT" --gate-ran "$GATE_LABEL" )
if [ -n "$OWNER_APPROVAL" ]; then
  BLAST_ARGS+=( --owner-approval "$OWNER_APPROVAL" )
fi
BLAST_OUT="$("$BLAST" "${BLAST_ARGS[@]}")"
BLAST_RC=$?
[ -n "$BLAST_OUT" ] && printf '%s\n' "$BLAST_OUT"
if [ "$BLAST_RC" -ne 0 ]; then
  echo "${PROG}: NOT safe to merge -- see the BLAST-RADIUS lines above (exit ${BLAST_RC})." >&2
  exit "$BLAST_RC"
fi

# --- 9. confirmed ----------------------------------------------------------
SUFFIX=""
if [ -n "$CRITIC_CARRIED_FROM" ] && [ -n "$CRITIC_UPSTREAM" ]; then
  # Plain slices, not `short`: the source commit may be gone from this
  # object store (rebased away and pruned), and rev-parse would then fail.
  SUFFIX=" (CRITIC CARRIED + INTERACTION from ${CRITIC_CARRIED_FROM:0:12}; upstream ${CRITIC_UPSTREAM:0:12}..${CRITIC_UPSTREAM:42:12})"
elif [ -n "$CRITIC_CARRIED_FROM" ]; then
  SUFFIX=" (CRITIC CARRIED from ${CRITIC_CARRIED_FROM:0:12})"
fi
if [ -n "$CRITIC_OVERRIDE" ]; then
  SUFFIX="${SUFFIX} (CRITIC OVERRIDE [${OVERRIDE_STATE}]: ${CRITIC_OVERRIDE})"
fi
if [ -n "$OWNER_APPROVAL" ]; then
  SUFFIX="${SUFFIX} (OWNER-APPROVED: ${OWNER_APPROVAL})"
fi
OK_LINE="INTEGRATION OK ${HEAD_SHA} (GATE: ${GATE_LABEL})${SUFFIX}"

# --- 10. record the pass BEFORE announcing it (DND-965) --------------------
# The receipt is what locked-merge requires. Printing INTEGRATION OK without it
# would announce a pass the merge step will refuse, so a failed write is exit 5
# and no OK line. Written to a temp file in the same directory, then renamed,
# so a reader sees a whole receipt or none.
BLAST_LINE="$(grep -m1 '^BLAST-RADIUS ' <<<"$BLAST_OUT")"
[ -n "$BLAST_LINE" ] || BLAST_LINE="(blast-radius printed no BLAST-RADIUS line)"
EDITED_JSON=false; [ "$GATE_EDITED" -eq 1 ] && EDITED_JSON=true
write_receipt() {
  mkdir -p "$RECEIPT_DIR" 2>/dev/null || return 1
  RECEIPT_TMP="$(mktemp "${RECEIPT_DIR}/.${HEAD_SHA}.json.tmp.XXXXXX" 2>/dev/null)" || return 1
  jq -n \
    --arg head "$HEAD_SHA" --arg target_ref "$TARGET" --arg base "$TARGET_SHA" \
    --arg gate "$GATE_CMD" --arg gate_source "$GATE_SOURCE" --argjson edited "$EDITED_JSON" \
    --arg co "$CRITIC_OVERRIDE" --arg co_state "$OVERRIDE_STATE" --arg oa "$OWNER_APPROVAL" \
    --arg blast "$BLAST_LINE" --arg ok_line "$OK_LINE" --arg checkout "$ROOT" \
    --arg carried "$CRITIC_CARRIED_FROM" --arg upstream "$CRITIC_UPSTREAM" \
    --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg schema "$IR_SCHEMA" \
    'def nul: if . == "" then null else . end;
     {schema: $schema, verdict: "pass", head: $head,
      target_ref: $target_ref, base: $base, gate: $gate, gate_source: $gate_source,
      gate_edited_by_branch: $edited, critic_override: ($co | nul),
      critic_override_state: ($co_state | nul), critic_carried_from: ($carried | nul),
      critic_upstream_range: ($upstream | nul),
      owner_approval: ($oa | nul),
      blast_radius: $blast, integration_ok_line: $ok_line, checkout: $checkout,
      recorded_at: $at}' > "$RECEIPT_TMP" || return 1
  # Seal it (DND-1814): the producer (this gate's own files) and an HMAC under
  # this machine's receipt-seal key. Every reader refuses a receipt that does
  # not verify, so a file branch code or a person writes is never a pass.
  "$IR_SEAL" seal --kind integration "$RECEIPT_TMP" || return 2
  mv -f "$RECEIPT_TMP" "$RECEIPT" || return 1
  RECEIPT_TMP=""
}
write_receipt; WR_RC=$?
if [ "$WR_RC" -eq 2 ]; then
  echo "${PROG}: the gate is green on $(short "$HEAD_SHA") but its receipt could not be SEALED (see the receipt-seal line above)." >&2
  echo "Fix: repair what receipt-seal names (its key under \${ATHENA_SECRETS_ROOT:-~/.config/athena-secrets}/harness, or the gate files it reads; ${IR_SEAL} --help), then re-run integration-gate. Do not merge: an unsealed receipt is refused by every reader, and no INTEGRATION OK was issued." >&2
  exit 5
elif [ "$WR_RC" -ne 0 ]; then
  echo "${PROG}: the gate is green on $(short "$HEAD_SHA") but its receipt could not be written to ${RECEIPT}." >&2
  echo "Fix: make ${RECEIPT_DIR} writable (ls -ld '${RECEIPT_DIR}'; df -h '${COMMON_DIR}') and re-run integration-gate. Do not merge: locked-merge requires this receipt, and no INTEGRATION OK was issued." >&2
  exit 5
fi
echo "${PROG}: receipt ${RECEIPT}"
echo "$OK_LINE"
exit 0
