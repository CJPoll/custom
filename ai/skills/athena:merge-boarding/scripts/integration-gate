#!/usr/bin/env bash
# integration-gate -- assert a branch is safe to land onto a MOVING main.
#
# `origin/main` moves under a fleet mid-run: another fleet, the shipwright
# cron, the owner typing in the main checkout. This script answers the only
# question that changes what the admiral does -- "did the target move since my
# branch point, and is the gate still green once I contain it?" -- and it
# answers it with SHAs, never with a liveness guess about who else is running.
#
# Why the re-gate is the load-bearing half: two MRs with COMPLETELY DISJOINT
# file sets can each be gate-green alone and gate-red merged, because several
# harness checks judge a single global document or number --
# `check-agent-size`'s per-agent line budget, `ai/hooks/registry.json`,
# `ai/inbox/registry.json`. Git sees no conflict and (in a repo with no CI,
# like ~/dev/custom) nothing re-runs the gate after a rebase, so the defect is
# invisible to both git and the forge. This ADDS a check at a moment where none
# ran; it never drops, skips, downgrades, or path-excludes one.
#
# This script is an ASSERTION: it never rebases, commits, pushes, or touches
# the working tree or any ref. A rebase can conflict and is a judgement call,
# so it reports and the admiral acts. Safe to run anywhere, any number of
# times. Its one write is its RECEIPT (DND-965): on INTEGRATION OK, and only
# then, it records the pass at <git common dir>/integration-receipts/<head>.json,
# outside every working tree. locked-merge refuses a head with no such
# receipt, so "the gate passed on this SHA" no longer rests on the caller's
# word (gen_saas #468 merged past a RED gate because a prep script printed
# READY without reading the exit code). Every run that does not end in
# INTEGRATION OK removes any receipt for its head, so a stale pass cannot
# outlive a later RED.
#
# Run: ai/skills/athena:merge-boarding/scripts/integration-gate [--target <ref>]
# Self-test: ai/skills/athena:merge-boarding/test/self-test.sh
set -uo pipefail

PROG="integration-gate"
TARGET="origin/main"
GATE_CMD=""
DO_FETCH=1
WITH_CRITIC=0
SINCE=""
CRITIC_OVERRIDE=""
OVERRIDE_STATE=""
OWNER_APPROVAL=""

usage() {
  cat <<'EOF'
Usage: integration-gate [--target <ref>] [--since <ref>] [--gate '<cmd>']
                        [--no-fetch] [--self-test]

Asserts that HEAD contains the current target ref AND that the local gate is
green on that integrated head. Exits 0 only when both hold.

On exit 0 (and only then) it writes a RECEIPT for the head, atomically, at
  <git common dir>/integration-receipts/<head-sha>.json
recording the head, the target SHA it contained (base), the gate and its
source, any --critic-override / --owner-approval, the blast-radius verdict, the
INTEGRATION OK line, and a UTC timestamp. locked-merge requires it. Any other
outcome removes a receipt for that head. There is no flag that skips it.

  --target <ref>   integration target (default: origin/main)
  --since <ref>    the target SHA your branch was last reviewed/gated against
                   (the "baseline main" in your state log). REQUIRED for a
                   meaningful file-set intersection once you have rebased:
                   after a rebase the original branch point is unrecoverable,
                   so without it the intersection is reported UNAVAILABLE
                   rather than silently empty.
  --gate '<cmd>'   gate command to run at the repo root -- ONLY for a repo that
                   declares no gate. The gate is read from the LANDED target,
                   never from argv or the working tree: the first of
                   bin/prep-commit.sh, ai/bin/harness-gate that exists on
                   <target> is the repo's declared gate and always runs. A
                   --gate that differs from it is refused (exit 2). With no
                   declared gate, --gate is required, and a command that can
                   never fail (true, :, exit 0, echo ..., 'x || true',
                   'x; true', 'x &', an empty string) is refused (exit 2).
                   Every OK line names the gate that ran and where it came
                   from, and marks it EDITED BY THIS BRANCH when the branch
                   changes the gate script itself.
  --no-fetch       skip the fetch; compare against the target ref as-is
  --with-critic    also run the standing judge (critic-review --base <target>)
                   on this head, CONCURRENTLY with the gate, unless a PASS is
                   already recorded for it. It is joined before the verdict
                   step, which then reads the judge's receipt exactly as
                   without the flag, so wall time is max(gate, critic), not
                   the sum. On a RED gate the judge is still joined, so one
                   round returns both sets of findings.
  --critic-override <reason>
                   merge WITHOUT a standing-judge verdict on this head -- and
                   ONLY that: the receipt is read first either way, and a
                   recorded BLOCK is REFUSED with this flag exactly as without
                   it. Covers the ABSENCE of a verdict (never ran / still
                   running / fail-open / unreadable receipt). Requires a reason;
                   the reason AND the state actually overridden are printed into
                   the INTEGRATION OK line for your state log. Bounded to this
                   one invocation.
  --owner-approval 'session:<session-uuid>/<message-uuid> quote:<words>'
                   merge a head whose blast radius is HOT. A VERIFIABLE record
                   of the owner's own words: the reference names the owner's
                   human-typed turn in that Claude Code session's transcript
                   (~/.claude/projects/*/<session-uuid>.jsonl), and the quote
                   must appear in it verbatim. blast-radius verifies it; free
                   text, a rule citation, an architect sign-off or a captain
                   report is refused (exit 2). Printed into the INTEGRATION OK
                   line and the receipt. What holds at all:
                   ~/.claude/CLAUDE.md -> "Owner approval policy".
  --self-test      run the dedicated test suite and exit

Exit codes: 0 integration OK | 1 gate RED on the integrated head
            2 usage / unresolvable ref / branch behind target /
              gate refused (a no-op, or not the gate the target declares) /
              working tree is not HEAD (uncommitted or untracked paths,
              before the gate or left by it; ignored files do not count)
            3 no green critic verdict on the integrated head
            4 merging performs a real-world action -- owner's call, not the
              fleet's (see --owner-approval)
            5 gate green but the receipt could not be written or a stale
              one could not be removed (no INTEGRATION OK is printed)
EOF
}

while [ $# -gt 0 ]; do
  case "$1" in
    --target) TARGET="${2-}"; [ -n "$TARGET" ] || { echo "${PROG}: --target needs a ref." >&2; echo "Fix: pass a ref, e.g. --target origin/main." >&2; exit 2; }; shift 2 ;;
    --since)  SINCE="${2-}"; [ -n "$SINCE" ] || { echo "${PROG}: --since needs a ref." >&2; echo "Fix: pass the target SHA your branch was last gated against, e.g. --since 2e0eff3." >&2; exit 2; }; shift 2 ;;
    --gate)   GATE_CMD="${2-}"; [ -n "$GATE_CMD" ] || { echo "${PROG}: --gate needs a command." >&2; echo "Fix: pass a command, e.g. --gate 'ai/bin/harness-gate'." >&2; exit 2; }; shift 2 ;;
    --no-fetch) DO_FETCH=0; shift ;;
    --with-critic) WITH_CRITIC=1; shift ;;
    --critic-override) CRITIC_OVERRIDE="${2-}"; [ -n "$CRITIC_OVERRIDE" ] || { echo "${PROG}: --critic-override needs a REASON." >&2; echo "Fix: pass why you are merging with no judge verdict, e.g. --critic-override 'model unreachable for 3 re-runs; hotfix cannot wait'. An unrecorded bypass is the exact failure this flag exists to replace. Note it cannot cover a recorded BLOCK -- that is refused with or without the flag." >&2; exit 2; }; shift 2 ;;
    --owner-approval) OWNER_APPROVAL="${2-}"; [ -n "$OWNER_APPROVAL" ] || { echo "${PROG}: --owner-approval needs the OWNER'S AUTHORIZATION." >&2; echo "Fix: pass a verifiable record of the owner's own words: --owner-approval 'session:<session-uuid>/<message-uuid> quote:<the owner's words, verbatim>' (see --help). An empty value is not an approval, and no agent message is ever your user's consent." >&2; exit 2; }; shift 2 ;;
    --self-test)
      HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
      exec bash "$(dirname "${HERE}")/test/self-test.sh" ;;
    -h|--help) usage; exit 0 ;;
    *) echo "${PROG}: unknown argument '$1'." >&2
       echo "Fix: see --help; valid flags are --target, --since, --gate, --no-fetch, --with-critic, --critic-override, --owner-approval, --self-test." >&2
       exit 2 ;;
  esac
done

# --- 1. cwd must be inside a work tree -------------------------------------
if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "${PROG}: '$(pwd)' is not inside a git work tree." >&2
  echo "Fix: run this from the Mission's worktree (the tree holding the branch you intend to merge)." >&2
  exit 2
fi
ROOT="$(git rev-parse --show-toplevel)" || exit 2
cd "$ROOT" || exit 2

# --- 2. fetch --------------------------------------------------------------
if [ "$DO_FETCH" -eq 1 ]; then
  case "$TARGET" in
    */*) REMOTE="${TARGET%%/*}" ;;
    *)   REMOTE="" ;;
  esac
  if [ -n "$REMOTE" ] && grep -qx -- "$REMOTE" <<<"$(git remote)"; then
    git fetch "$REMOTE" >/dev/null 2>&1 || \
      echo "${PROG}: WARN fetch of '${REMOTE}' failed; comparing against the ref as it stands locally." >&2
  fi
fi

# --- 3. resolve the refs ---------------------------------------------------
if ! HEAD_SHA="$(git rev-parse --verify "HEAD^{commit}" 2>/dev/null)"; then
  echo "${PROG}: HEAD does not resolve to a commit (unborn branch?)." >&2
  echo "Fix: check out the Mission branch with at least one commit, then re-run." >&2
  exit 2
fi

# --- 3a. the receipt (DND-965) ---------------------------------------------
# One store per REPO, not per checkout: the git common dir is the same for the
# main checkout and every linked worktree, so locked-merge finds the receipt
# whichever checkout it runs from. --path-format=absolute because plain
# --git-common-dir is cwd-relative (".git") in a main checkout.
if ! command -v jq >/dev/null 2>&1; then
  echo "${PROG}: jq is not on PATH, so a pass could not be recorded as a receipt." >&2
  echo "Fix: install jq and re-run. locked-merge refuses a head with no receipt, so a pass this script cannot record is not a pass." >&2
  exit 2
fi
COMMON_DIR="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"
case "$COMMON_DIR" in
  /*) ;;
  *) echo "${PROG}: git common dir did not resolve to an absolute path (got '${COMMON_DIR}')." >&2
     echo "Fix: run from a normal checkout or linked worktree of the repo with git >= 2.31 (--path-format). The receipt store cannot be located otherwise." >&2
     exit 2 ;;
esac
RECEIPT_DIR="${COMMON_DIR}/integration-receipts"
RECEIPT="${RECEIPT_DIR}/${HEAD_SHA}.json"
RECEIPT_TMP=""
# A run that does not end in INTEGRATION OK leaves no pass for its head. The
# up-front removal covers a run that is killed; the EXIT trap covers a pass
# another run recorded for this head while this one went RED.
if ! rm -f "$RECEIPT" 2>/dev/null; then
  echo "${PROG}: could not remove the earlier receipt ${RECEIPT}." >&2
  echo "Fix: make ${RECEIPT_DIR} writable (ls -ld '${RECEIPT_DIR}') and re-run. A stale pass this run cannot clear would outlive its result." >&2
  exit 5
fi
CRITIC_PGID=""; CRITIC_LOG=""
clear_receipt_on_failure() {
  local rc=$?
  # A --with-critic judge still running when this script leaves must not be
  # orphaned (the PT-919 class). It runs as its own process-group leader, so
  # one group signal reaches critic-review AND the `claude -p` it spawns.
  [ -n "$CRITIC_PGID" ] && kill -TERM -- "-${CRITIC_PGID}" 2>/dev/null
  [ -n "$CRITIC_LOG" ] && rm -f "$CRITIC_LOG" 2>/dev/null
  [ -n "$RECEIPT_TMP" ] && rm -f "$RECEIPT_TMP" 2>/dev/null
  [ "$rc" -ne 0 ] && rm -f "$RECEIPT" 2>/dev/null
  return "$rc"
}
trap clear_receipt_on_failure EXIT

# A target ref that does not resolve is an ERROR, not an empty result: a
# mistyped or never-fetched ref must never read as "nothing to integrate".
if ! TARGET_SHA="$(git rev-parse --verify "${TARGET}^{commit}" 2>/dev/null)"; then
  echo "${PROG}: target ref '${TARGET}' does not resolve to a commit in $(pwd)." >&2
  echo "Fix: name a ref that exists here (git remote -v; git branch -r). A wrong ref must not be mistaken for 'no drift' -- this is an error, not an empty result." >&2
  exit 2
fi
BASE_SHA="$(git merge-base HEAD "$TARGET_SHA" 2>/dev/null)"
if [ -z "$BASE_SHA" ]; then
  echo "${PROG}: HEAD and '${TARGET}' share no merge base (unrelated histories)." >&2
  echo "Fix: confirm you are in the right worktree and that '${TARGET}' is this repo's integration target." >&2
  exit 2
fi

short() { git rev-parse --short "$1"; }

# --- 3b. resolve the gate from the LANDED target (DND-479) ---------------
# The gate command used to be caller-supplied, so `--gate true` turned this
# whole script into a pass that printed INTEGRATION OK exactly like a real run
# (gen_saas PR #337, 2026-09-24). That is ~/dev/custom/CLAUDE.md -> "A check's
# own bar must not live in the diff it is checking", one step removed: the bar
# lived in argv. So a repo's gate is DECLARED by convention -- the first of
# these paths that exists on the target ref, read out of git, never the working
# tree -- and argv cannot replace it. No file in any tenant repo is needed: the
# convention matches what gen_saas (bin/prep-commit.sh, verify-only since
# DND-214) and ~/dev/custom (ai/bin/harness-gate) already ship.
DECLARED_GATES=( bin/prep-commit.sh ai/bin/harness-gate )

trim() { local s="$1"; s="${s#"${s%%[![:space:]]*}"}"; s="${s%"${s##*[![:space:]]}"}"; printf '%s' "$s"; }

# A gate path as git names it: no leading ./, no absolute repo-root prefix.
norm_path() { local p; p="$(trim "$1")"; p="${p#./}"; case "$p" in "$ROOT"/*) p="${p#"$ROOT"/}" ;; esac; printf '%s' "$p"; }

declared_gate_on() { # <sha> -> the declared gate on <sha>, or return 1
  local g
  for g in "${DECLARED_GATES[@]}"; do
    if [ "$(git cat-file -t "${1}:${g}" 2>/dev/null)" = "blob" ]; then printf '%s\n' "$g"; return 0; fi
  done
  return 1
}

# is_noop_simple <command>: one simple command that can never fail. Quote- and
# grouping-unaware ON PURPOSE: a false positive refuses (fails closed), and the
# refusal says how to pass a real gate.
is_noop_simple() {
  local s
  s="$(printf '%s' "$1" | tr -d "'\"(){}" | tr -s '[:space:]' ' ')"; s="$(trim "$s")"
  while :; do
    case "$s" in
      builtin\ *|command\ *|env\ *|exec\ *|nohup\ *|time\ *) s="$(trim "${s#* }")" ;;
      *) break ;;
    esac
  done
  case "$s" in
    ''|:|:\ *|true|true\ *|/bin/true|/bin/true\ *|/usr/bin/true|/usr/bin/true\ *) return 0 ;;
    exit|'exit 0'|return|'return 0'|echo|echo\ *|printf|printf\ *|sleep|sleep\ *) return 0 ;;
    '! false'|'! /bin/false'|'! /usr/bin/false') return 0 ;;
    sh\ -c\ *|bash\ -c\ *|zsh\ -c\ *|dash\ -c\ *) is_noop_cmd "${s#* -c }"; return $? ;;
  esac
  return 1
}

# all_parts_noop <chain>: an `&&` / `|` chain never fails only if no part can.
all_parts_noop() {
  local chain="${1//&&/$'\001'}" part parts
  chain="${chain//|/$'\001'}"
  IFS=$'\001' read -ra parts <<<"$chain"
  for part in "${parts[@]}"; do is_noop_simple "$part" || return 1; done
  return 0
}

# is_noop_cmd <command>: true when the command's exit status is 0 whatever the
# checks inside it do -- a bare no-op, or a real check whose failure is masked
# (`x || true`, `x; true`, `x &`). The exit status is the LAST statement's, and
# an `||` alternative that cannot fail forces that statement green.
is_noop_cmd() {
  local cmd last alt rest
  cmd="$(trim "$(printf '%s' "$1" | tr '\n' ';')")"
  case "$cmd" in *'&&') ;; *'&') return 0 ;; esac
  last="$cmd"
  while :; do last="$(trim "$last")"; case "$last" in *';') last="${last%;}" ;; *) break ;; esac; done
  [ -z "$last" ] && return 0
  last="${last##*;}"
  rest="${last//&&/$'\001'}"; rest="${rest##*&}"; last="${rest//$'\001'/&&}"
  rest="$last"
  while :; do
    alt="${rest%%||*}"
    all_parts_noop "$alt" && return 0
    [ "$rest" = "$alt" ] && break
    rest="${rest#*||}"
  done
  return 1
}

if LANDED_GATE="$(declared_gate_on "$TARGET_SHA")"; then
  if [ -n "$GATE_CMD" ] && [ "$(norm_path "$GATE_CMD")" != "$LANDED_GATE" ]; then
    echo "${PROG}: --gate '${GATE_CMD}' refused -- ${TARGET} ($(short "$TARGET_SHA")) declares this repo's gate as ${LANDED_GATE}, and argv may not replace it." >&2
    echo "Fix: drop --gate; ${LANDED_GATE} (the gate as it stands on ${TARGET}) runs by default. The bar is read from the landed target so neither a caller nor the branch under test can lower it (~/dev/custom/CLAUDE.md -> 'A check's own bar must not live in the diff it is checking'). To change the bar, land that change on ${TARGET} first." >&2
    exit 2
  fi
  GATE_CMD="$LANDED_GATE"
  GATE_SOURCE="declared on ${TARGET}"
else
  if [ -z "$GATE_CMD" ]; then
    echo "${PROG}: ${TARGET} ($(short "$TARGET_SHA")) declares no gate (looked for: ${DECLARED_GATES[*]}) and no --gate was passed." >&2
    echo "Fix: pass this repo's real local gate, e.g. --gate 'mix test' or --gate 'cd backend && mix test'. A gate the branch itself adds is not a declaration -- it must be on ${TARGET} first." >&2
    exit 2
  fi
  if is_noop_cmd "$GATE_CMD"; then
    echo "${PROG}: --gate '${GATE_CMD}' refused -- it can never fail, so it would print INTEGRATION OK without checking anything (DND-479)." >&2
    echo "Fix: pass a command that runs this repo's checks and exits non-zero when they fail, e.g. --gate 'mix test'. Not: true, :, exit 0, echo ..., an empty string, or a real check masked by '|| true', '; true' or a trailing '&'. If this repo has no gate at all, hold the MR and say so -- do not merge on a no-op." >&2
    exit 2
  fi
  GATE_SOURCE="caller-supplied; no gate declared on ${TARGET}"
fi

# A gate the branch EDITS is the same class one step removed: the branch picks
# its own bar. It still runs (a check the branch adds must run on integration,
# and running the landed copy would mean writing it into this tree -- this
# script never writes -- or running it out of place, where its sibling-relative
# paths break). So it is marked, loudly, in the run and in every OK line.
GATE_EDITED=0
GATE_FILE="$(norm_path "$GATE_CMD")"; GATE_FILE="${GATE_FILE%% *}"
if [ -n "$GATE_FILE" ]; then
  landed_blob="$(git rev-parse -q --verify "${TARGET_SHA}:${GATE_FILE}" 2>/dev/null)"
  head_blob="$(git rev-parse -q --verify "${HEAD_SHA}:${GATE_FILE}" 2>/dev/null)"
  if [ -n "${landed_blob}${head_blob}" ]; then
    if [ "$landed_blob" != "$head_blob" ] || ! git diff --quiet HEAD -- "$GATE_FILE" 2>/dev/null; then
      GATE_EDITED=1
      echo "${PROG}: WARN gate '${GATE_FILE}' differs from ${TARGET} ($(short "$TARGET_SHA")) -- this branch (or its working tree) edits the gate that judges it. The copy that runs is the branch's, not the landed one: review that diff (git diff ${TARGET} -- ${GATE_FILE}) before merging." >&2
    fi
  fi
fi
GATE_LABEL="${GATE_CMD} -- ${GATE_SOURCE}"
[ "$GATE_EDITED" -eq 1 ] && GATE_LABEL="${GATE_LABEL}; EDITED BY THIS BRANCH"

# The anchor the file sets are measured from. An unresolvable --since is an
# ERROR, not a silent fallback to the merge-base -- falling back would quietly
# answer a different question than the one asked.
if [ -n "$SINCE" ]; then
  if ! ANCHOR="$(git rev-parse --verify "${SINCE}^{commit}" 2>/dev/null)"; then
    echo "${PROG}: --since ref '${SINCE}' does not resolve to a commit in $(pwd)." >&2
    echo "Fix: pass a resolvable SHA/ref for the baseline your branch was gated against (see your state log's 'baseline main =='), or omit --since." >&2
    exit 2
  fi
else
  ANCHOR="$BASE_SHA"
fi

# --- 4. drift verdict, printed EITHER WAY ----------------------------------
# A no-drift run must never look like a skipped run.
AHEAD="$(git rev-list --count "${BASE_SHA}..${TARGET_SHA}" 2>/dev/null || echo 0)"
if [ "$BASE_SHA" = "$TARGET_SHA" ]; then
  echo "${PROG}: target '${TARGET}' unchanged since branch point ($(short "$TARGET_SHA"))."
else
  echo "${PROG}: target '${TARGET}' advanced $(short "$BASE_SHA") -> $(short "$TARGET_SHA") (${AHEAD} commit(s))."
fi

# --- 5. the three file sets (input to the replay-churn rule) ---------------
# Measured from ANCHOR, printed on BOTH the pass and the exit-2 path so a
# still-behind branch can see what is coming at it.
#
# The intersection is UNAVAILABLE, never "empty", when the anchor has collapsed
# onto the target with no --since supplied: once HEAD contains the target,
# merge-base(HEAD,target) IS the target, so the incoming delta is empty BY
# CONSTRUCTION and says nothing about what actually landed. Reporting that as
# an empty intersection would read as "the incoming delta missed my reviewed
# files -- board it", which is a failed lookup wearing an empty result's
# clothes.
# INCOMING is measured from the ANCHOR (what landed on the target since the
# branch was last gated). MINE is measured from the MERGE-BASE, never the
# anchor: from the anchor, "my" set would also contain every file the branch
# merely INHERITED by rebasing over the target, which then shows up in the
# intersection as a fake overlap and forces a replay nobody needed.
# Both lists name BOTH sides of a rename or copy (DND-770): git's default
# rename detection (diff.renames) lists only the new path, so a branch that
# renamed a file the target had just edited read an empty intersection.
# -z keeps a non-ASCII path verbatim; core.quotePath would C-quote it.
#
# A `git diff` failure here (a corrupt object, a missing merge base) must
# never be swallowed by `2>/dev/null`: that would report an empty file set,
# indistinguishable from "these two refs really touch nothing in common" --
# the exact failed-lookup class this script exists to refuse elsewhere
# (~/dev/custom/ai/CLAUDE.md -> "A failed lookup must never look like an
# empty one"). Both refs were already validated as resolvable commits before
# this point (TARGET/SINCE above), so a failure here is an ERROR -- the repo
# itself, not a bad argument -- and it exits loudly rather than returning "".
changed_paths() {
  # The raw -z output is NUL-delimited and MUST stay in a pipeline, never in
  # a bash variable: `$(...)` capture cannot hold a NUL byte, so a capture-
  # then-check rewrite silently drops every delimiter and runs all the
  # filenames together (caught by this change's own self-test, case 22, on
  # the first attempt). So stdout goes straight to `tr`/`sort` as before;
  # only stderr and the exit status are captured, to a file (a second
  # variable capture of raw diff output would reintroduce the same defect).
  local errfile rc
  errfile="$(mktemp 2>/dev/null)" || { echo "${PROG}: mktemp failed; cannot safely check git diff's exit status." >&2; echo "Fix: ensure \$TMPDIR (or /tmp) is writable and re-run." >&2; return 2; }
  git diff --no-renames -z --name-only "$1" "$2" 2>"$errfile" | tr '\0' '\n' | sort -u
  rc="${PIPESTATUS[0]}"
  if [ "$rc" -ne 0 ]; then
    echo "${PROG}: git diff failed measuring changed paths between '$1' and '$2':" >&2
    sed 's/^/    /' "$errfile" >&2
    rm -f "$errfile"
    echo "Fix: this is a repository fault (a corrupt object, an unreachable commit), not an empty result -- inspect '$1' and '$2' directly (git diff --stat '$1' '$2') and repair the object database (git fsck) before re-running; this run does not proceed on an unmeasurable file set." >&2
    return 2
  fi
  rm -f "$errfile"
}
if ! INCOMING="$(changed_paths "$ANCHOR" "$TARGET_SHA")"; then
  exit 2
fi
if ! MINE="$(changed_paths "$BASE_SHA" HEAD)"; then
  exit 2
fi
OVERLAP="$(comm -12 <(printf '%s\n' "$INCOMING" | sed '/^$/d') <(printf '%s\n' "$MINE" | sed '/^$/d'))"

INTERSECTION_AVAILABLE=1
if [ -z "$SINCE" ] && [ "$ANCHOR" = "$TARGET_SHA" ]; then
  INTERSECTION_AVAILABLE=0
fi

echo "--- incoming delta (${TARGET} since $(short "$ANCHOR"))"
printf '%s\n' "$INCOMING" | sed '/^$/d' | sed 's/^/    /'
echo "--- your branch (its own commits, since $(short "$BASE_SHA"))"
printf '%s\n' "$MINE" | sed '/^$/d' | sed 's/^/    /'
echo "--- intersection (drives the No replay churn coverage-intersection rule)"
if [ "$INTERSECTION_AVAILABLE" -eq 0 ]; then
  echo "    UNAVAILABLE -- HEAD already contains ${TARGET}, so the original branch point is unrecoverable and the incoming delta is empty by construction."
  echo "    Fix: re-run with --since <the target SHA this branch was last gated against> to get a real intersection before deciding replay. Do NOT read this as an empty intersection."
elif [ -z "$OVERLAP" ]; then
  echo "    (empty -- incoming delta is outside your reviewed file set)"
else
  printf '%s\n' "$OVERLAP" | sed 's/^/    /'
fi

# --- 7. shared-global advisory (never a failure by itself) ----------------
# These are judged by existing checks as ONE global document or number, so two
# disjoint branches can draw them down against each other. Advisory: the gate
# below is the judge; this only explains a red.
SHARED_RE='^(ai/bin/check-agent-size|ai/hooks/registry\.json|ai/inbox/registry\.json|ai/agents/.*|ai/blocks/.*)$'
SHARED_HITS="$(printf '%s\n%s\n' "$INCOMING" "$MINE" | sed '/^$/d' | sort -u | grep -E "$SHARED_RE" || true)"
if [ -n "$SHARED_HITS" ]; then
  echo "${PROG}: NOTE shared global(s) touched by one or both sides -- these are judged as a single budget/document, so green-alone does not imply green-merged:"
  printf '%s\n' "$SHARED_HITS" | sed 's/^/    /'
fi

# --- 7. HEAD must CONTAIN the target --------------------------------------
if ! git merge-base --is-ancestor "$TARGET_SHA" HEAD; then
  echo "${PROG}: HEAD ($(short "$HEAD_SHA")) does not contain ${TARGET} ($(short "$TARGET_SHA")). NOT safe to merge." >&2
  echo "Fix: your branch does not contain ${TARGET} ($(short "$TARGET_SHA")). Rebase onto it (git rebase ${TARGET}), resolve conflicts, re-run the local gate, then re-run this script (passing --since $(short "$TARGET_SHA") to keep the intersection meaningful)." >&2
  exit 2
fi

# --- 8. run the gate ON THE INTEGRATED HEAD -------------------------------
# GATE_CMD was resolved in step 3b: the target's declared gate, or a vetted
# caller-supplied one.
#
# The gate runs in the WORKING TREE, but the receipt certifies the committed
# HEAD (DND-1011). So the tree must be exactly HEAD before the gate, and still
# be exactly HEAD after it. Untracked files count: a forgotten `git add` is how
# a head ships broken while its tree passes. Ignored files (build output,
# deps) do not.
tree_dirt() { git -C "$ROOT" status --porcelain 2>&1; }
DIRT="$(tree_dirt)"
if [ -n "$DIRT" ]; then
  echo "${PROG}: the working tree is not HEAD ($(short "$HEAD_SHA")), so a gate run here would not judge the commit being certified. Uncommitted or untracked paths:" >&2
  printf '%s\n' "$DIRT" | head -20 >&2
  echo "Fix: commit the paths above (or remove them, or gitignore build output), then re-run. A pass on uncommitted content is not a pass of $(short "$HEAD_SHA")." >&2
  exit 2
fi
CRITIC="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../bin" 2>/dev/null && pwd)/critic-review"
if [ "$WITH_CRITIC" -eq 1 ]; then
  if [ ! -x "$CRITIC" ]; then
    echo "${PROG}: --with-critic cannot locate critic-review (expected ${CRITIC})." >&2
    echo "Fix: run this script from its committed path under ~/dev/custom, or drop --with-critic and run ~/dev/custom/ai/bin/critic-review yourself." >&2
    exit 3
  fi
  if ! command -v setsid >/dev/null 2>&1; then
    echo "${PROG}: --with-critic needs setsid (util-linux) to run the judge in its own process group." >&2
    echo "Fix: install util-linux, or drop --with-critic and run ~/dev/custom/ai/bin/critic-review yourself before this script." >&2
    exit 2
  fi
  if "$CRITIC" --verdict-for "$HEAD_SHA" >/dev/null 2>&1; then
    echo "${PROG}: --with-critic: a PASS is already recorded for $(short "$HEAD_SHA"); the judge is not re-run."
  else
    CRITIC_LOG="$(mktemp "${TMPDIR:-/tmp}/integration-gate-critic.XXXXXX")"
    # setsid execs in place (a background subshell is not a group leader), so
    # $! is the judge's pid AND its process-group id.
    ( cd "$ROOT" && exec setsid "$CRITIC" --base "$TARGET" ) >"$CRITIC_LOG" 2>&1 &
    CRITIC_PGID=$!
    echo "${PROG}: --with-critic: running the standing judge on $(short "$HEAD_SHA") beside the gate (pgid ${CRITIC_PGID}, log ${CRITIC_LOG})"
  fi
fi
# Joins the concurrent judge and prints its verdict lines. Called on every
# path out of the gate step that reports a result, so a RED gate still returns
# the judge's findings; any other exit stops it through the EXIT trap.
join_critic() {
  [ -n "$CRITIC_PGID" ] || return 0
  wait "$CRITIC_PGID" 2>/dev/null
  CRITIC_PGID=""
  grep -E '^critic-review:|^FINDINGS:' "$CRITIC_LOG" >&2 || tail -5 "$CRITIC_LOG" >&2
}

echo "${PROG}: running gate on the integrated head $(short "$HEAD_SHA"): ${GATE_LABEL}"
if ! ( cd "$ROOT" && eval "$GATE_CMD" ); then
  join_critic
  echo "${PROG}: gate RED on the integrated head $(short "$HEAD_SHA")." >&2
  echo "Fix: the gate is RED on the integrated head $(short "$HEAD_SHA") although your branch passed alone. A disjoint file set does not imply a disjoint gate (shared budgets/registries). Fix it on this branch and re-run; do not merge." >&2
  exit 1
fi
AFTER_SHA="$(git -C "$ROOT" rev-parse --verify HEAD 2>/dev/null)"
DIRT="$(tree_dirt)"
if [ "$AFTER_SHA" != "$HEAD_SHA" ] || [ -n "$DIRT" ]; then
  echo "${PROG}: the gate changed the tree it judged: HEAD $(short "$HEAD_SHA") -> $(short "${AFTER_SHA:-unresolved}")${DIRT:+, with uncommitted paths:}" >&2
  [ -n "$DIRT" ] && printf '%s\n' "$DIRT" | head -20 >&2
  echo "Fix: the green run was of content other than $(short "$HEAD_SHA"), so it certifies nothing. Review what the gate wrote or committed, keep it on this branch if it is right, then re-run integration-gate on the new head." >&2
  exit 2
fi
join_critic

# --- 8b. the standing judge's verdict ON THE HEAD WE ARE DECLARING MERGEABLE -
# A judge that never ran, fail-opened, or had not finished yet used to be
# indistinguishable from one that PASSED, because all three were "exit 0, no
# record". critic-review now writes a per-SHA receipt; this reads it through
# critic-review's OWN reader (never a second copy of the semantics), so the
# same SHA-match discipline as "merge the SHA this script prints" applies to
# the verdict too. A verdict on an earlier commit is not a verdict on this one.
#
# --critic-override covers the ABSENCE of a verdict -- never ran, still
# running, fail-opened, receipt unreadable. It is NOT a way past a recorded
# BLOCK, and the ONLY way to know which of those you are in is to READ THE
# RECEIPT. So the read happens FIRST, unconditionally, and the override is
# applied to its result. It used to short-circuit the read entirely, which
# meant the flag silently also merged past a recorded BLOCK with real findings
# -- while printing "NO standing-judge verdict", the one line the admiral
# copies verbatim into its state log as the attributable record. The record
# then said the opposite of what happened. Reading first is a STRICT
# TIGHTENING: it can only ever REFUSE a merge the flag used to allow.
if [ ! -x "$CRITIC" ]; then
  echo "${PROG}: cannot locate critic-review (expected ${CRITIC})." >&2
  echo "Fix: run this script from its committed path under ~/dev/custom so the judge's verdict reader resolves. A judge that cannot be found is an ERROR, never a pass -- and --critic-override does NOT apply here, because with no reader 'no BLOCK recorded' cannot be told apart from 'nothing was read'." >&2
  exit 3
fi
VERDICT_OUT="$("$CRITIC" --verdict-for "$HEAD_SHA" 2>&1)"
VERDICT_RC=$?
# Same streams as before: the reader's PASS line on stdout, everything else on
# stderr. It is captured only so the override can NAME the state it overrode.
if [ "$VERDICT_RC" -eq 0 ]; then printf '%s\n' "$VERDICT_OUT"; else printf '%s\n' "$VERDICT_OUT" >&2; fi

if [ -n "$CRITIC_OVERRIDE" ]; then
  if [ "$VERDICT_RC" -eq 2 ]; then
    echo "${PROG}: CRITIC OVERRIDE REFUSED for $(short "$HEAD_SHA") -- the standing judge recorded a BLOCK for this exact head. NOT safe to merge." >&2
    echo "Fix: --critic-override covers the ABSENCE of a verdict (never ran / still running / fail-open / unreadable receipt). A recorded BLOCK is information, not missing information, and no flag goes past it. Address the findings named above and re-run ~/dev/custom/ai/bin/critic-review to record a verdict for the new head; or hold this ONE MR and move to the next Mission (athena:merge-boarding -> 'The merge bar', the exit-3 bullet)." >&2
    exit 3
  fi
  # Name the state actually being overridden, READ from the receipt. The exit
  # code is the authority (critic-review's reader is the one place the rules
  # live); its own wording only supplies the label, and an unrecognised wording
  # degrades to "state not named" -- never to a guess.
  if [ "$VERDICT_RC" -eq 0 ]; then
    OVERRIDE_STATE="UNUSED -- a recorded PASS verdict already exists for this head"
  else
    case "$VERDICT_OUT" in
      *"IN PROGRESS"*)          OVERRIDE_STATE="judge run STILL RUNNING" ;;
      *"FAILED OPEN"*)          OVERRIDE_STATE="judge FAILED OPEN (infra/model error)" ;;
      # "no receipt recorded" is a searched-and-missed state, never proof the
      # judge did not run (DND-457: a lookup that only read its own worktree
      # used to print "has NOT run" for a PASS sitting in another checkout).
      *"no receipt recorded"*)  OVERRIDE_STATE="NO RECEIPT for this head in any checkout of this repo" ;;
      *"COULD NOT LOOK"*)       OVERRIDE_STATE="verdict store COULD NOT BE READ (not a miss)" ;;
      *"CONFLICTING"*)          OVERRIDE_STATE="CONFLICTING receipts across checkouts (none is a BLOCK)" ;;
      *"DIRTY working tree"*)   OVERRIDE_STATE="verdict recorded against a DIRTY tree" ;;
      *)                        OVERRIDE_STATE="no green verdict; state not named -- see the critic-review line above" ;;
    esac
  fi
  echo "${PROG}: CRITIC OVERRIDE for $(short "$HEAD_SHA") -- state overridden: ${OVERRIDE_STATE}; reason: ${CRITIC_OVERRIDE}" >&2
  echo "Fix: copy the INTEGRATION OK line below verbatim into your run's state log and name the override in the final report, so this decision is attributable." >&2
elif [ "$VERDICT_RC" -ne 0 ]; then
  echo "${PROG}: no green standing-judge verdict on the integrated head $(short "$HEAD_SHA"). NOT safe to merge." >&2
  echo "Fix: see the critic-review line above — it names WHICH state you are in (no receipt in any checkout / still running / fail-open / dirty tree / conflicting / could not look / block). Get a verdict (re-run ~/dev/custom/ai/bin/critic-review here), or hold this ONE MR and move to the next Mission. If and ONLY IF the state is an ABSENCE of a verdict, merge past it with --critic-override '<reason>'; a recorded BLOCK is refused even with that flag." >&2
  exit 3
fi

# --- 8c. blast radius: what does MERGING this head CAUSE? ------------------
# Every criterion above asks whether the CODE is correct. None of them asks
# what merging DOES. Measured 2026-09-20 (gen_saas PR #256, DND-234): merging
# would have run `terraform apply -auto-approve` and created a real, billable
# AWS KMS key -- and the documented bar would have merged it, because nothing
# in the bar asked. This step asks the missing question. It is ADDITIVE: it can
# only ever REFUSE a merge the old bar allowed, never permit one it refused.
BLAST="$(cd "$(dirname "${BASH_SOURCE[0]}")/../../../bin" 2>/dev/null && pwd)/blast-radius"
if [ ! -x "$BLAST" ]; then
  echo "${PROG}: cannot locate blast-radius (expected ${BLAST})." >&2
  echo "Fix: run this script from its committed path under ~/dev/custom so the blast-radius classifier resolves. A classifier that cannot be found is an ERROR, never a pass -- 'no surface touched' and 'nothing was checked' must never read the same." >&2
  exit 2
fi
BLAST_ARGS=( --base "$TARGET_SHA" --head "$HEAD_SHA" --repo "$ROOT" --gate-ran "$GATE_LABEL" )
if [ -n "$OWNER_APPROVAL" ]; then
  BLAST_ARGS+=( --owner-approval "$OWNER_APPROVAL" )
fi
BLAST_OUT="$("$BLAST" "${BLAST_ARGS[@]}")"
BLAST_RC=$?
[ -n "$BLAST_OUT" ] && printf '%s\n' "$BLAST_OUT"
if [ "$BLAST_RC" -ne 0 ]; then
  echo "${PROG}: NOT safe to merge -- see the BLAST-RADIUS lines above (exit ${BLAST_RC})." >&2
  exit "$BLAST_RC"
fi

# --- 9. confirmed ----------------------------------------------------------
SUFFIX=""
if [ -n "$CRITIC_OVERRIDE" ]; then
  SUFFIX=" (CRITIC OVERRIDE [${OVERRIDE_STATE}]: ${CRITIC_OVERRIDE})"
fi
if [ -n "$OWNER_APPROVAL" ]; then
  SUFFIX="${SUFFIX} (OWNER-APPROVED: ${OWNER_APPROVAL})"
fi
OK_LINE="INTEGRATION OK ${HEAD_SHA} (GATE: ${GATE_LABEL})${SUFFIX}"

# --- 10. record the pass BEFORE announcing it (DND-965) --------------------
# The receipt is what locked-merge requires. Printing INTEGRATION OK without it
# would announce a pass the merge step will refuse, so a failed write is exit 5
# and no OK line. Written to a temp file in the same directory, then renamed,
# so a reader sees a whole receipt or none.
BLAST_LINE="$(grep -m1 '^BLAST-RADIUS ' <<<"$BLAST_OUT")"
[ -n "$BLAST_LINE" ] || BLAST_LINE="(blast-radius printed no BLAST-RADIUS line)"
EDITED_JSON=false; [ "$GATE_EDITED" -eq 1 ] && EDITED_JSON=true
write_receipt() {
  mkdir -p "$RECEIPT_DIR" 2>/dev/null || return 1
  RECEIPT_TMP="$(mktemp "${RECEIPT_DIR}/.${HEAD_SHA}.json.tmp.XXXXXX" 2>/dev/null)" || return 1
  jq -n \
    --arg head "$HEAD_SHA" --arg target_ref "$TARGET" --arg base "$TARGET_SHA" \
    --arg gate "$GATE_CMD" --arg gate_source "$GATE_SOURCE" --argjson edited "$EDITED_JSON" \
    --arg co "$CRITIC_OVERRIDE" --arg co_state "$OVERRIDE_STATE" --arg oa "$OWNER_APPROVAL" \
    --arg blast "$BLAST_LINE" --arg ok_line "$OK_LINE" --arg checkout "$ROOT" \
    --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    'def nul: if . == "" then null else . end;
     {schema: "integration-receipt/1", verdict: "pass", head: $head,
      target_ref: $target_ref, base: $base, gate: $gate, gate_source: $gate_source,
      gate_edited_by_branch: $edited, critic_override: ($co | nul),
      critic_override_state: ($co_state | nul), owner_approval: ($oa | nul),
      blast_radius: $blast, integration_ok_line: $ok_line, checkout: $checkout,
      recorded_at: $at}' > "$RECEIPT_TMP" || return 1
  mv -f "$RECEIPT_TMP" "$RECEIPT" || return 1
  RECEIPT_TMP=""
}
if ! write_receipt; then
  echo "${PROG}: the gate is green on $(short "$HEAD_SHA") but its receipt could not be written to ${RECEIPT}." >&2
  echo "Fix: make ${RECEIPT_DIR} writable (ls -ld '${RECEIPT_DIR}'; df -h '${COMMON_DIR}') and re-run integration-gate. Do not merge: locked-merge requires this receipt, and no INTEGRATION OK was issued." >&2
  exit 5
fi
echo "${PROG}: receipt ${RECEIPT}"
echo "$OK_LINE"
exit 0
