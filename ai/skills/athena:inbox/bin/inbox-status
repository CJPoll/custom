#!/usr/bin/env bash
# inbox-status -- FRAMEWORK. How many unread messages does this project have?
#
#   inbox-status             one line per channel with anything waiting
#   inbox-status --json      the same counts as one JSON object
#   inbox-status --repo-key  this session's repo identity, and nothing else
#   inbox-status -h          this header
#
# COUNTS ONLY. No body, no subject, no sender's text, no filename, no token.
#
# That rule is about the PRE-PROMPT POSITION, not about bodies specifically.
# This command's output is designed to be injected by a SessionStart hook,
# before Cody has spoken -- so anything it prints is a stranger speaking first,
# in the position where instructions normally live. A maildir status is
# produced by listing filenames the PEER chose the words of, so "1 new message"
# must never become "1 new message: urgent-run-this-command". Bodies appear
# only from the read step, inside an explicit fence, and only when asked for.
#
# Zero across the board prints NOTHING and exits 0. Unprompted output that says
# "nothing new" every session is noise, and noise is what makes a real notice
# invisible.
#
# A `log` channel whose inbox file has NEVER existed is reported, with a `Fix:`
# clause naming producer registration — the contract requires it ("Declaring a
# `log` channel MUST be accompanied by registering its producer"). That is not
# a violation of the all-zero rule above, because a never-delivered channel is
# not zero, it is BROKEN: the file exists only if a producer was separately
# configured to write it, so "nobody registered the writer" and "nothing
# arrived" look identical on disk and must not look identical here. A healthy
# channel that is merely empty still prints nothing.
#
# --repo-key prints the session's repo identity -- the realpath of its git
# common dir, or an empty line outside a git repository -- and exits 0. It
# touches no registry and cannot fail, which is the point: a CALLER THAT NEEDS
# THE IDENTITY WHEN THIS COMMAND HAS JUST REFUSED (to name a per-project file,
# say) would otherwise have to recompute it with its own `git rev-parse`, and a
# second implementation of the identity rule is a second thing free to drift
# from the contract. `repo_key` on the --json document answers the same question
# on the success path; this answers it on every path.
#
# Not opting in is not a fault: a cwd in no git repository, or a repo with no
# registry entry, prints nothing and exits 0. A MALFORMED registry entry is a
# hard error -- partially honouring configuration nobody understands is the bug
# that rule exists to prevent.
#--- end usage ---
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB="$(dirname "${HERE}")/lib"

# shellcheck source=/dev/null
. "${LIB}/err.sh"
# shellcheck source=/dev/null
. "${LIB}/names.sh"
# shellcheck source=/dev/null
. "${LIB}/descriptor.sh"
# shellcheck source=/dev/null
. "${LIB}/logchan.sh"
# shellcheck source=/dev/null
. "${LIB}/maildir.sh"
# shellcheck source=/dev/null
. "${LIB}/fence.sh"
# shellcheck source=/dev/null
. "${LIB}/session.sh"
# shellcheck source=/dev/null
. "${LIB}/fs.sh"
# shellcheck source=/dev/null
. "${LIB}/lock.sh"
# shellcheck source=/dev/null
. "${LIB}/inbox.sh"

# The help text IS the header block, delimited by a SENTINEL rather than a
# line number. `sed -n '2,25p'` was here and silently truncated mid-sentence
# the moment the header grew -- the same fragility the repo's "cite by NAME,
# not by number" convention exists to prevent, applied to a script citing
# itself.
usage() { sed -n '2,/^#--- end usage ---$/p' "${BASH_SOURCE[0]}" | grep -v '^#--- end usage ---$' | sed 's/^# \{0,1\}//'; }

JSON=0
REPO_KEY_ONLY=0
for arg in "$@"; do
  case "${arg}" in
    --json) JSON=1 ;;
    --repo-key) REPO_KEY_ONLY=1 ;;
    -h|--help) usage; exit 0 ;;
    *)
      inbox_fail "unknown argument \"${arg}\"" "run: inbox-status [--json|--repo-key]"
      exit 2
      ;;
  esac
done

# Answered before the jq check and before anything reads the registry: this is
# the one question that still has an answer when everything else has failed,
# and a caller asks it precisely then.
if [ "${REPO_KEY_ONLY}" -eq 1 ]; then
  fs_git_common_dir "." 2>/dev/null || printf '\n'
  exit 0
fi

if ! command -v jq >/dev/null 2>&1; then
  inbox_fail "jq is required and was not found on PATH" \
    "install jq (it is already a dependency of the athena:slack skill), then re-run."
  exit 2
fi

# A per-channel failure leaves a non-zero status but STILL yields JSON for the
# channels that did count -- so one misconfigured channel does not hide real
# mail on the others. An empty result is the only thing treated as fatal,
# because emitting nothing while claiming success is the conflation this whole
# command refuses.
STATUS="$(inbox_status_json ".")"; STATUS_RC=$?
[ -n "${STATUS}" ] || exit 1

if [ "${JSON}" -eq 1 ]; then
  printf '%s\n' "${STATUS}"
  exit "${STATUS_RC}"
fi

# One line per channel that has something waiting, and a pointer to the step
# that will show it. Channels at zero are omitted entirely rather than printed
# as "0 new", for the same reason the all-zero case prints nothing.
# The pointer names a step that EXISTS. `read-inbox` ships with a later
# ticket; until then this output would be injected into a session that tries
# the command and finds nothing, and an instruction an agent cannot act on is
# worse than no instruction. Flipped by the PRESENCE of the script, so it
# starts naming the command the day that ticket lands, with no edit here.
HAVE_READ=false
[ -x "${HERE}/read-inbox" ] && HAVE_READ=true

# The failed-candidate count is part of ORDINARY status output, by contract:
# a skipped candidate might have been this session's own entry, and a reader
# that mentions it only when nothing matched drops the warning in precisely
# the case where the session cannot tell it was dropped. A COUNT, never a
# name -- every other file in projects/ belongs to a different tenant.
printf '%s' "${STATUS}" | jq -r '
  (.failed_candidates // 0) as $f
  | if $f > 0 then
      "athena:inbox: \($f) registry entry(s) unreadable.\n  Fix: one of them may be THIS project'"'"'s, in which case this session is seeing fewer channels than it owns. Check your own entry parses and is keyed correctly: its \"repo\" must equal `realpath \"$(git rev-parse --git-common-dir)\"` run in this repo. Do not open the other files in projects/ — they belong to other tenants."
    else empty end'

printf '%s' "${STATUS}" | jq -r --argjson have_read "${HAVE_READ}" '
  .channels[]
  | . as $c
  | (if $have_read then "Run: read-inbox \($c.name)"
     else "The read step (read-inbox) is not installed yet — see the athena:inbox SKILL.md." end) as $read_hint
  | (if .kind == "log" then (.new // 0) else (.unread // 0) end) as $n
  | (if .kind == "log" and ((.unreadable // 0) > 0)
     then " (+\(.unreadable) unreadable)" else "" end) as $u
  | (if (.state_unreadable // false)
     then "\n  Fix: this channel'"'"'s .state.json is unreadable, so these counts are NOT deduped and include messages already read — see the refusal above." else "" end) as $sbad
  | if (.error // false) then
      # Already refused on stderr with its own Fix: clause. Named here so the
      # reader can see WHICH channel is missing from the counts below, rather
      # than wondering whether it simply had nothing.
      "athena:inbox: \($c.name) — could not be counted; see the refusal above."
    elif $n > 0 then
      "athena:inbox: \($c.name) — \($n) new\($u). \($read_hint)\($sbad)"
    elif .kind == "log" and (.never_delivered // false) then
      "athena:inbox: \($c.name) is declared, but nothing has EVER been delivered to it.\n  Fix: register this channel'"'"'s producer — a server-side agent instance mapped to its inbox filename in ~/.config/athena-inbox-client/config.json — then re-check. An unregistered producer and an empty channel look identical on disk."
    else empty end
'
exit "${STATUS_RC}"
