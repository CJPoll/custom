#!/usr/bin/env bash
# inbox-wait -- FRAMEWORK. Block until something arrives, on every channel this
# session owns, in ONE process.
#
#   inbox-wait              block until a doorbell rings, or the budget elapses
#   inbox-wait --dry-run    resolve and provision the doorbells, print them, exit
#   inbox-wait -h           this header
#
# THIS IS THE HOP THAT TURNS THE CHAIN FROM PULL INTO PUSH. Everything else in
# the delivery path is push by construction: the workspace pushes to the
# server, the server pushes to the client, the client appends and rings the
# bell. Without this command the last hop is a session happening to look.
#
# ============================ EXIT STATUS ==================================
#
#   0   a doorbell rang, OR unread mail was already waiting when the waiter
#       armed (`pending-at-arm:`, DND-1428). Run inbox-status, then
#       read-inbox <channel>, then RE-ARM. A rung bell does NOT imply unread
#       mail: an ack by the peer rings the same bell, and so does a doorbell
#       being deleted and recreated.
#   75  the budget elapsed and nothing rang. RE-ARM. This is NOT "all clear" --
#       treating it as one turns a quiet hour into a lost message.
#   2   refused: bad usage, no inotifywait/timeout/mkfifo, an unusable budget,
#       or nothing to watch. Fix what the `Fix:` line names; re-arming will
#       not help.
#   1   the waiter faulted: inotifywait failed, or a channel's unread position
#       could not be read at arm and nothing else was pending. One reason line
#       and a `Fix:` are printed. Re-arm ONCE; if it faults again, surface it
#       rather than looping.
#
# **THE ARM IS LEVEL-TRIGGERED (DND-1428).** It starts the watch, waits for
# inotifywait's "Watches established.", and only then counts unread on every
# channel with the count inbox-status uses. Mail already waiting wakes it at
# once; a delivery after the count rings a bell that is already watched. A
# ring that landed between the consumer's read and this arm is no longer lost.
#
# **75, NOT 0, FOR A QUIET BUDGET.** A waiter that exits 0 on "nothing ever
# arrived" is the worst shape this facility can take: success is what the
# caller reads as "I checked", so the one status that must never be reused is
# the one that means mail is waiting.
#
# **THE TICKET'S TABLE DESCRIBED THE OTHER ARMING FORM, and the two differ.**
# `inotifywait -qq -t "$BUDGET"` exits **2** when the budget elapses;
# `timeout "$BUDGET" inotifywait -qq` -- the form the contract prints, and the
# one used below -- exits **124**. An implementer who writes
# `case $? in 0) read;; 2) rearm;; *) die;; esac` against the `timeout` form
# gets a waiter that dies on its first quiet window. Both are mapped to 75
# here so no caller ever has to know which form was used.
#
# ============================ WHO MAY ARM ==================================
#
# Tenancy and not-a-subagent, both enforced. A subagent never arms a waiter:
# it would wake, consume, finish, and the session that actually reports to
# Cody would find a clean inbox and say nothing.
#
# **THE CONSUMER `flock` IS DELIBERATELY NOT TAKEN, and that is a divergence
# from the ticket, resolved against the contract.** The contract gates
# ADVANCING a channel's consumption state on the lock and requires the holder
# to "hold the descriptor across the whole advance". Arming a waiter advances
# nothing -- it reads no body, moves no message, writes no offset. Holding the
# lock across a wait would break two things outright:
#
#   * it would deny every other session's read and ack for the FULL BUDGET --
#     up to half an hour of a channel refusing to drain because somebody is
#     listening to it;
#   * one process cannot hold the locks of N channels. `inbox_lock_acquire`
#     refuses a second lock by design, because swapping the descriptor would
#     release the first mid-advance. A waiter watches EVERY channel, so a
#     lock-holding waiter is impossible for any session owning more than one.
#
# Nothing is lost by omitting it: if two sessions both arm and both wake, the
# READ is where the lock settles it, and the loser is refused before a single
# body is printed.
#
# ============================ SAFE WAIT ====================================
#
# One blocking call. No poll, no sleep, no re-check loop. The child is
# backgrounded only so its pid can be trapped -- an orphaned waiter is the
# orphaned-spin-loop class (a spin loop reparented to PID 1 pinned this box's load at ~290
# for an hour and flaked neighbouring suites into Postgres 57014 timeouts).
# `wait` blocks on the pid; it does not re-check it. The one `while` is the
# arm's handshake: blocking `read`s of inotifywait's stderr stream, a few
# lines long, ended by "Watches established." or by the stream closing.
#--- end usage ---
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB="$(dirname "${HERE}")/lib"

# shellcheck source=/dev/null
. "${LIB}/err.sh"
# shellcheck source=/dev/null
. "${LIB}/names.sh"
# shellcheck source=/dev/null
. "${LIB}/descriptor.sh"
# shellcheck source=/dev/null
. "${LIB}/logchan.sh"
# shellcheck source=/dev/null
. "${LIB}/maildir.sh"
# shellcheck source=/dev/null
. "${LIB}/fence.sh"
# shellcheck source=/dev/null
. "${LIB}/session.sh"
# shellcheck source=/dev/null
. "${LIB}/fs.sh"
# shellcheck source=/dev/null
. "${LIB}/lock.sh"
# shellcheck source=/dev/null
. "${LIB}/inbox.sh"
# shellcheck source=/dev/null
. "${LIB}/budget.sh"

usage() { sed -n '2,/^#--- end usage ---$/p' "${BASH_SOURCE[0]}" | grep -v '^#--- end usage ---$' | sed 's/^# \{0,1\}//'; }

EX_RANG=0
EX_FAULT=1
EX_REFUSED=2
EX_REARM=75

DRY_RUN=0
for arg in "$@"; do
  case "${arg}" in
    --dry-run) DRY_RUN=1 ;;
    -h|--help) usage; exit 0 ;;
    *)
      # NO --channel FLAG, and no positional channel. One waiter watches all of
      # this session's doorbells, of both kinds; a narrowed waiter looks
      # identical to a complete one and leaves the channels it dropped with
      # nobody listening.
      inbox_fail "unknown argument \"${arg}\"" \
        "run: inbox-wait [--dry-run]. There is no way to wait on one channel: a waiter covers every channel this project declares, because a narrowed one is indistinguishable from a complete one and the channels it left out never wake anybody."
      exit "${EX_REFUSED}"
      ;;
  esac
done

if ! command -v jq >/dev/null 2>&1; then
  inbox_fail "jq is required and was not found on PATH" \
    "install jq (it is already a dependency of the athena:slack skill), then re-run."
  exit "${EX_REFUSED}"
fi

# ============================================================================
# THE BUDGET. Mode-dependent; the policy is lib/budget.sh (domain), which
# carries the measurements it rests on.
#
#   interactive `claude`   default 1800s, ceiling 3600s  -- no background kill
#   headless `claude -p`   default  540s, ceiling  600s  -- the kill at 600s
#   unknown                the headless values, and the mode line says why
#
# Headless: an unattended `claude -p` kills background tasks at its 600s
# background-wait ceiling. A waiter killed there does not report a timeout --
# it vanishes, and the session that armed it waits forever for a notification
# that is never coming. When CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS is set the
# ceiling follows it (ms -> s) and the default stays under it.
#
# Interactive: there is no such kill, and each quiet wake is a notification and
# a re-arm in the transcript, so the budget is 30 minutes (owner, 2026-09-24).
#
# THE MODE IS TOLD BY TWO SIGNALS THAT MUST AGREE: CLAUDE_CODE_ENTRYPOINT=cli
# AND CLAUDE_CODE_SESSION_ATTENDED=1 is interactive. Anything else that is not
# sdk-cli/0 is UNKNOWN and gets the safe headless values -- "could not tell"
# never reads as interactive, and the mode line printed below names what was
# seen, so a miss is observable.
#
# THE OVERRIDE IS BOUNDED, NOT FREE, and a value at or over the mode's ceiling
# is REFUSED rather than clamped. Clamping would mean the caller asked for 900,
# got 540, and was told nothing -- configuration that silently does something
# else is the same silent-failure shape in its quietest form.
# ============================================================================
BUDGET_LINE="$(inbox_wait_budget "${CLAUDE_CODE_ENTRYPOINT:-}" \
  "${CLAUDE_CODE_SESSION_ATTENDED:-}" \
  "${CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS:-}" \
  "${ATHENA_INBOX_WAIT_BUDGET:-}")" || exit "${EX_REFUSED}"
IFS=$'\t' read -r BUDGET_MODE BUDGET BUDGET_CEILING BUDGET_WHY <<< "${BUDGET_LINE}"

# ONE LINE NAMING THE MODE AND WHY, on stderr, on every run (dry-run included,
# so the budget a session WOULD arm with is checkable without arming). stdout
# stays the doorbell list / the wake lines, which are contracts.
printf 'athena:inbox: budget %ss, ceiling %ss, mode %s: %s.\n' \
  "${BUDGET}" "${BUDGET_CEILING}" "${BUDGET_MODE}" "${BUDGET_WHY}" >&2

# ============================================================================
# THE PREREQUISITE. Probed, and named when absent.
#
# Without inotifywait there is no blocking wake at all, and the alternative a
# missing binary invites -- a polling loop -- is the one thing the Hard Rule
# forbids outright. So this refuses and names the package; it never degrades
# to a poll.
# ============================================================================
if ! command -v inotifywait >/dev/null 2>&1; then
  inbox_fail "inotifywait was not found on PATH, so this session cannot be woken by a doorbell" \
    "install inotify-tools (it provides inotifywait; on this machine it lives at /usr/sbin/inotifywait). Do NOT substitute a polling loop: without a blocking waiter the delivery chain's last hop is a session happening to look, and a spin loop is what this harness forbids outright."
  exit "${EX_REFUSED}"
fi
if ! command -v timeout >/dev/null 2>&1; then
  inbox_fail "timeout(1) was not found on PATH, so the waiter's budget cannot be bounded" \
    "install coreutils (it provides timeout). The budget is what bounds the waiter (under the ${BUDGET_CEILING}s ceiling for this ${BUDGET_MODE}-mode session; headless \`claude -p\` kills background tasks past its ceiling); arming without it would be an unbounded wait, which this harness forbids."
  exit "${EX_REFUSED}"
fi
if ! command -v mkfifo >/dev/null 2>&1; then
  inbox_fail "mkfifo(1) was not found on PATH, so the arm cannot learn when its watches are established" \
    "install coreutils (it provides mkfifo). The arm checks for mail already waiting only AFTER inotifywait reports its watches established, over a FIFO; without that handshake a delivery between the check and the watch would be lost (DND-1428)."
  exit "${EX_REFUSED}"
fi

# Tenancy, provisioning, and the refusals -- all in the manager. A zero-channel
# session is refused there rather than armed on nothing.
# THE SESSION'S PROJECT, NOT THE SHELL CWD (DND-1163). The Bash tool keeps a
# `cd` across calls, so "." can be another project's repo; keyed on it, this
# would act on that project's channels with exit 0. inbox_session_dir
# (lib/inbox.sh) names the session's project and refuses a cwd that sits in a
# different registered project. PROJECT_DIR replaces "." everywhere below.
PROJECT_LINE="$(inbox_session_dir)" || exit "${EX_REFUSED}"
PROJECT_DIR="${PROJECT_LINE#*$'\t'}"
DOORBELLS="$(inbox_doorbells "${PROJECT_DIR}")" || exit "${EX_REFUSED}"
mapfile -t EVENT_FILES <<< "${DOORBELLS}"

# --DRY-RUN EXITS HERE, BEFORE THE SUBAGENT GATE, ON PURPOSE. Dry-run does not
# ARM anything -- it only resolves and provisions, which is exactly what a
# caller that just needs the doorbell paths (e.g. an fs.watch fallback learning
# what to watch via `inbox-wait --dry-run`) needs, including from a subagent
# context. The "who may arm" restriction
# below is about not BLOCKING on a wake and consuming it as a subagent -- it
# has nothing to say about listing paths that resolve+provisioning already
# produced. Gating dry-run on the subagent check as well (an earlier ordering
# of this file did) made `armFsWatch` refused-on-arrival for every subagent:
# the one runtime configuration the fallback exists for could never resolve
# its doorbells, exit 2, and permanently stop (critic-review, DND-282 round 6).
if [ "${DRY_RUN}" -eq 1 ]; then
  printf '%s\n' "${EVENT_FILES[@]}"
  exit "${EX_RANG}"
fi

# NOT-A-SUBAGENT. It runs AFTER the step above, which both resolves and
# PROVISIONS -- so a subagent's refused invocation does create this channel's
# missing directories and doorbells on its way to being told no. That ordering
# is deliberate: a misconfigured registry is reported to whoever ran the
# command, whatever kind of session they are, rather than being masked by the
# subagent refusal. The provisioning is idempotent, correctly moded, and no
# longer rings anything (see fs_ensure_doorbell), so the only thing a subagent
# leaves behind is the empty structure the contract says the channel should
# have had. It never reaches the arm.
inbox_refuse_subagent_arm || exit "${EX_REFUSED}"

ERRF="$(mktemp)" || { inbox_fail "could not create a temporary file for inotifywait's stderr" \
  "check that \$TMPDIR is writable, then re-run."; exit "${EX_REFUSED}"; }

# inotifywait's stdout goes here so the wake can NAME which doorbell fired.
# Without `-m` inotifywait reads ONE event and exits, so this holds one line
# (the `--format '%w%f'` path of the doorbell that rang). A read failure here
# never loses a wake: the exit-0 arm falls back to "rang, channel unknown --
# scan every channel", which is louder than a clean success, not quieter.
OUTF="$(mktemp)" || { inbox_fail "could not create a temporary file for inotifywait's stdout" \
  "check that \$TMPDIR is writable, then re-run."; rm -f "${ERRF}"; exit "${EX_REFUSED}"; }

# inotifywait's STDERR goes through this FIFO, because the handshake below
# reads its "Watches established." line as it is written (DND-1428).
FIFO_DIR="$(mktemp -d)" && mkfifo -m 600 "${FIFO_DIR}/stderr" || {
  inbox_fail "could not create the FIFO the arm reads inotifywait's watch handshake from" \
    "check that \$TMPDIR is writable, then re-run."
  rm -f "${ERRF}" "${OUTF}"; [ -n "${FIFO_DIR:-}" ] && rm -rf "${FIFO_DIR}"; exit "${EX_REFUSED}"; }
ERR_FIFO="${FIFO_DIR}/stderr"

# ============================================================================
# CLEANUP AND SIGNALS.
#
# `child` is initialised BEFORE the trap is installed, and the trap BEFORE the
# `&`, because both orderings were wrong and each has a failure:
#
#   * a trap installed after the `&` leaves a window in which a signal orphans
#     the waiter -- the orphaned-spin-loop class, through the gap in its own guard;
#   * a trap referencing an unset `child` under `set -u` ABORTS INSIDE THE
#     TRAP. The `2>/dev/null` silences `kill`, not the unbound-variable error.
#
# INT AND TERM GET THEIR OWN HANDLERS, AND THEY EXIT. A bare
# `trap ... EXIT INT TERM` runs the handler and then RESUMES after `wait`, so a
# deliberate teardown fell through to the fault arm: `RC=143`, a read of the
# temp file the handler had just deleted (a bare bash error carrying no
# `Fix:`), and a refusal telling the caller to re-arm. SKILL.md tells the agent
# to launch this with `run_in_background`, so every stop produced that.
# ============================================================================
child=""
trap 'kill "$child" 2>/dev/null; rm -f "${ERRF}" "${OUTF}"; rm -rf "${FIFO_DIR}"' EXIT
trap 'kill "$child" 2>/dev/null; rm -f "${ERRF}" "${OUTF}"; rm -rf "${FIFO_DIR}"; exit 130' INT
trap 'kill "$child" 2>/dev/null; rm -f "${ERRF}" "${OUTF}"; rm -rf "${FIFO_DIR}"; exit 143' TERM

# ============================================================================
# THE ARM.
#
# `attrib` IS MANDATORY, and leaving it out fails SILENTLY -- the waiter arms,
# blocks, and simply never fires, which is indistinguishable from a healthy
# idle waiter. The two bump mechanisms do not emit the same events:
#
#   touch(1)                    -> ATTRIB, CLOSE_WRITE          (no MODIFY)
#   open+fchmod+ftruncate       -> ATTRIB, MODIFY, CLOSE_WRITE
#
# `touch(1)` sets atime and mtime together, which the kernel reports as ATTRIB
# and not as MODIFY -- so a waiter watching only `modify` never fires for a
# maildir channel, and since ONE waiter serves both kinds, that breaks
# agent-mail outright. No single event type is reliable across a future client
# refactor either, which is the real argument: watch the union.
#
# `delete_self` is in the set because `move_self` covers a rename of the
# watched inode but NOT an unlink-and-recreate -- a manual repair, an `rm`
# during rotation -- which would otherwise leave the waiter blocked forever on
# a dead inode with no further events. (On this kernel an unlink also bumps
# link count and therefore emits ATTRIB, so the two overlap today; the overlap
# is not a guarantee and is not what the waiter relies on.)
# ============================================================================
# NOT `-q`, and NOT `-qq` (DND-1428). Without `-q`, inotifywait writes
# "Setting up watches." and then "Watches established." to stderr once every
# watch is registered -- and that second line is the handshake the level check
# below waits for. `--format '%w%f'` prints the fired doorbell's path to
# stdout. Watching FILES, `%f` is empty and `%w` is the path as passed, so
# `%w%f` is that path; without `-m`, inotifywait reads one event and exits, so
# OUTF holds the single line naming what rang.
# Taken BEFORE the watch starts: it becomes this session's watermark, and the
# next arm treats every delivery since as possibly unannounced (see the level
# check below and lib/inbox.sh -> _INBOX_PENDING_JQ).
WATCH_STARTED="$(inbox_now_epoch)"
timeout "${BUDGET}" inotifywait --format '%w%f' \
  -e attrib,modify,close_write,move_self,delete_self \
  -- "${EVENT_FILES[@]}" >"${OUTF}" 2>"${ERR_FIFO}" &
child=$!

# ============================================================================
# THE LEVEL CHECK (DND-1428). WATCH FIRST, THEN LOOK.
#
# An edge-only arm loses a delivery that rang between the consumer's read and
# this arm: nobody was watching the bell when it rang, and nothing rings it
# again. Measured twice -- an owner @-mention unread 9+ minutes, an owner DM
# missed ~2 minutes. So the arm also asks whether mail is ALREADY waiting.
#
# THE ORDER IS WHAT MAKES IT RACE-FREE. Every writer appends first and rings
# second. The arm (1) starts inotifywait, (2) blocks until inotifywait says
# "Watches established.", and only then (3) counts unread. Take any delivery:
#   * its append landed before (3) -> (3) counts it;
#   * its append landed after (3)  -> its ring comes later still, after (2),
#                                     so the watch catches it.
# There is no third case. Checking BEFORE starting the watch would leave the
# check-to-watch gap open (the 2026-10-02 miss was exactly a delivery between
# a count and the new watch), and a re-check after a sleep would be a guess.
#
# THE HANDSHAKE IS A BLOCKING READ OF A STREAM, NOT A POLL. Each `read` blocks
# on the FIFO until inotifywait writes a line or exits. inotifywait writes a
# few lines at most, and `timeout` bounds its life to the budget, so the
# stream ends no later than the budget. `read -t` is a second cap on a hang
# (the budget plus slack); it is never the thing that decides a verdict.
#
# The FIFO is opened for read only after the child is started, so the child's
# open-for-write and this open rendezvous. fd 3 stays open across the `wait`,
# so a later stderr write cannot SIGPIPE inotifywait.
# ============================================================================
exec 3<"${ERR_FIFO}"
ESTABLISHED=0
HANDSHAKE_LINE=""
while IFS= read -r -t "$(( BUDGET + 10 ))" -u 3 HANDSHAKE_LINE; do
  case "${HANDSHAKE_LINE}" in
    "Watches established.") ESTABLISHED=1; break ;;
    "Setting up watches.") : ;;
    *) printf '%s\n' "${HANDSHAKE_LINE}" >> "${ERRF}" ;;
  esac
done

PENDING_CHANNELS=""
UNREADABLE_CHANNELS=""
if [ "${ESTABLISHED}" -eq 1 ]; then
  # The same count inbox-status reports (lib/inbox.sh -> inbox_pending_at_arm).
  # A channel the session already left unread on purpose (delivered before its
  # previous waiter started watching) does not wake it again: that is what
  # keeps a ticket-lane trigger, unacked while an admiral drains, from waking
  # every arm.
  if PENDING_LINES="$(inbox_pending_at_arm "${PROJECT_DIR}" "${WATCH_STARTED}")"; then
    while IFS=$'\t' read -r VERDICT VCH; do
      [ -n "${VCH:-}" ] || continue
      case "${VERDICT}" in
        pending)    PENDING_CHANNELS="${PENDING_CHANNELS:+${PENDING_CHANNELS} }${VCH}" ;;
        unreadable) UNREADABLE_CHANNELS="${UNREADABLE_CHANNELS:+${UNREADABLE_CHANNELS} }${VCH}" ;;
      esac
    done <<< "${PENDING_LINES}"
  else
    # NO DOCUMENT AT ALL. The registry or the repo identity could not be read
    # (its refusal and Fix: are already on stderr). That is "could not look",
    # never "nothing waiting", so the arm does not block on it.
    kill "${child}" 2>/dev/null; wait "${child}" 2>/dev/null
    inbox_fail "could not count this session's channels at arm, so mail already waiting cannot be ruled out" \
      "fix what the refusal above names, then re-arm ONCE. If it fails again, stop and surface it: blocking here would read \"could not look\" as \"no mail\"."
    exit "${EX_FAULT}"
  fi

  if [ -n "${UNREADABLE_CHANNELS}" ]; then
    # A POSITION THAT CANNOT BE READ IS NOT ZERO UNREAD. Named loudly, on every
    # arm, whether or not something else is pending.
    inbox_fail "could not read the unread position of: ${UNREADABLE_CHANNELS}. Mail may be waiting there that this arm cannot see" \
      "run inbox-status (it names why each channel could not be counted) and inbox-doctor, and repair that channel. Until it is repaired the arm reports it on every arm rather than reading it as quiet."
  fi

  if [ -n "${PENDING_CHANNELS}" ]; then
    # Wake now. Stop the watch first; a ring that landed during the check is
    # still in OUTF and joins the names below.
    kill "${child}" 2>/dev/null; wait "${child}" 2>/dev/null
    RC=0
  elif [ -n "${UNREADABLE_CHANNELS}" ]; then
    # Nothing provably waiting, and a channel nobody could count: the fault
    # status, so the caller re-arms ONCE and then surfaces it -- never a quiet
    # block, which would be the failed lookup that looks empty.
    kill "${child}" 2>/dev/null; wait "${child}" 2>/dev/null
    exit "${EX_FAULT}"
  else
    wait "${child}"; RC=$?
  fi
else
  # No handshake: inotifywait exited (a fault, or the budget) or never came up.
  # Its status decides below; what it printed is already in ERRF.
  wait "${child}"; RC=$?
fi

case "${RC}" in
  0)
    # NAME WHICH DOORBELL RANG. A session watching several channels that is
    # told only "a doorbell rang" reads the channel it expects and can miss the
    # one that actually fired (measured: a walt_ui consumer read only `slack`
    # and nearly missed the first-ever `flaky` event). inotifywait echoed the
    # fired path into OUTF; map each back to its channel name.
    #
    # No `local` here -- this is script top level, not a function.
    RANG_CHANNELS=""
    RANG_PATH=""
    while IFS= read -r RANG_PATH; do
      [ -n "${RANG_PATH}" ] || continue
      RANG_CH="$(inbox_doorbell_channel "${RANG_PATH}" "${PROJECT_DIR}")" || continue
      case " ${RANG_CHANNELS} " in
        *" ${RANG_CH} "*) : ;;                       # already listed
        *) RANG_CHANNELS="${RANG_CHANNELS:+${RANG_CHANNELS} }${RANG_CH}" ;;
      esac
    done < "${OUTF}"

    # PENDING AT ARM (DND-1428) joins the same list: a channel with mail
    # already waiting is read exactly like one whose bell just rang, so the
    # consumer's parser needs no second case.
    for RANG_CH in ${PENDING_CHANNELS}; do
      case " ${RANG_CHANNELS} " in
        *" ${RANG_CH} "*) : ;;
        *) RANG_CHANNELS="${RANG_CHANNELS:+${RANG_CHANNELS} }${RANG_CH}" ;;
      esac
    done

    # COUNTS ONLY, and not even a count in the bodies sense: these lines are the
    # reader's own narration and never carry a byte anybody else wrote. The
    # bodies come later, from read-inbox, inside fences.
    if [ -n "${RANG_CHANNELS}" ]; then
      if [ -n "${PENDING_CHANNELS}" ]; then
        printf 'athena:inbox: unread mail was already waiting when the waiter armed (%s watched). Run inbox-status, then read-inbox <channel>, then re-arm.\n' "${#EVENT_FILES[@]}"
      else
        printf 'athena:inbox: a doorbell rang (%s watched). Run inbox-status, then read-inbox <channel>, then re-arm.\n' "${#EVENT_FILES[@]}"
      fi
      # THE STABLE, MACHINE-READABLE LINE. A consumer greps `^athena:inbox:
      # rang-channels: ` and reads the space-separated channel names after it.
      # This line's shape is a contract (see SKILL.md → bin/inbox-wait).
      printf 'athena:inbox: rang-channels: %s\n' "${RANG_CHANNELS}"
      # Which of those were already unread at arm, on a separate line so the
      # rang-channels line keeps its exact shape.
      [ -z "${PENDING_CHANNELS}" ] || printf 'athena:inbox: pending-at-arm: %s\n' "${PENDING_CHANNELS}"
    else
      # RANG, BUT UNATTRIBUTABLE. This is exit 0 by contract (a bell DID ring),
      # but it must NOT read as "rang, nothing to do": OUTF was empty, or the
      # fired path matched no declared channel (a doorbell repaired/recreated
      # out of band, a registry that changed under the armed waiter). The
      # sentinel keeps the machine line present and parseable while telling the
      # consumer, in the same breath, to scan EVERYTHING.
      printf 'athena:inbox: a doorbell rang (%s watched) but the fired doorbell could not be mapped to a declared channel.\n' "${#EVENT_FILES[@]}" >&2
      printf 'athena:inbox: rang-channels: UNKNOWN\n'
      printf '  Fix: run inbox-status and read-inbox on EVERY channel this project declares; do NOT treat this wake as "nothing new". A doorbell recreated out of band, or a registry change under the armed waiter, produces this. Then re-arm.\n' >&2
    fi
    printf '  Note: a wake does not imply unread mail — a peer acking a message you sent rings the same bell. Zero new is a normal wake, not a fault.\n'
    exit "${EX_RANG}"
    ;;
  124|2)
    # 124 is `timeout`'s; 2 is `inotifywait -t`'s. Both mean the same thing and
    # both are mapped, so a future change of arming form cannot turn a quiet
    # window into a dead waiter.
    printf 'athena:inbox: %ss elapsed with no doorbell (%s watched). Re-arm — this is not "all clear". (the %s-mode budget)\n' \
      "${BUDGET}" "${#EVENT_FILES[@]}" "${BUDGET_MODE}" >&2
    exit "${EX_REARM}"
    ;;
  *)
    # A SIGNAL IS NOT A FAULT. `wait` reports a signalled child as 128+n, and
    # reading that as "inotifywait faulted, re-arm once" turns every deliberate
    # teardown into a spurious error with advice to try again.
    if [ "${RC}" -ge 128 ]; then
      printf 'athena:inbox: the waiter was terminated by signal %s. Nothing was read and nothing was acked.\n' \
        "$(( RC - 128 ))" >&2
      exit "${RC}"
    fi
    # ONE fixed reason line. inotifywait's own stderr is relayed because it is
    # this machine's diagnostic (a watch limit reached, a vanished path), not
    # anybody else's content -- but it is relayed verbatim and never parsed
    # into a decision.
    # The child has exited, so the FIFO's write end is closed: drain what it
    # wrote after the handshake (bounded, in case a stray writer survives).
    timeout 5 cat <&3 >> "${ERRF}" 2>/dev/null
    REASON=""
    [ -f "${ERRF}" ] && REASON="$(tr -d '\000' < "${ERRF}" | head -n 3)"
    inbox_fail "the waiter faulted (exit ${RC})${REASON:+: ${REASON}}" \
      "re-arm ONCE. If it faults again, stop and surface it rather than looping: the usual causes are the inotify watch limit (/proc/sys/fs/inotify/max_user_watches) and a doorbell that vanished between provisioning and the arm. A waiter that re-arms forever on a hard fault is a spin loop with extra steps."
    exit "${EX_FAULT}"
    ;;
esac
