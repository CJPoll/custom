#!/usr/bin/env bash
# send-mail -- FRAMEWORK. Say something back, on a maildir channel.
#
#   send-mail [--local] <channel> <slug> --to <identity> [--re <path-or-url>]
#                              [--thread <message-filename>]
#                              [--body-file <path> | --edit]
#   send-mail [--routed] (--to <machine_id>/<inbox_name> | --to-project <project>[@<machine>])
#             --subject <line> (--re <path-or-url> | --thread <event_id>)...
#             [--body-file <path> | --edit]
#   send-mail -h                 this header
#
# The body comes from stdin, from --body-file, or from $EDITOR (--edit, or by
# default when stdin is a terminal). The body is never printed back.
#
# ============================ WHICH PATH (HG-19) ===========================
#
# Once a send CHOOSES its path it prints that choice FIRST, on stdout, as one
# line:
#   athena:inbox: path: local -- <why>        then  athena:inbox: delivered <file>
#   athena:inbox: path: routed -- <why>       then  the JSON receipt (last line)
#   athena:inbox: path: refused (nothing was sent) -- <why>   (no-flag, exit 2)
# so a maildir delivery and a routed one can never be mistaken for each other.
# The line records the CHOICE: a send refused after it (an unregistered MCP
# under --routed, an undeclared channel under --local) exits non-zero with the
# reason and a Fix on stderr and prints no result line. An argument error is
# refused before any choice and prints no path line.
#
#   --local   the maildir channel named. Refuses a server address.
#   --routed  the athena MCP. Refuses a maildir channel. Never falls back.
#   neither   the D20 rule, applied without guessing:
#     * a maildir address (<channel> <slug> --to <identity>) -> local. Its peer
#       is on THIS machine and reads that maildir.
#     * a server address (--to <machine_id>/<inbox>, --to-project) -> asks
#       machine_reachable {} once, for this machine's reachability AND its own
#       server id (compared with --to's machine). With the MCP registered, the
#       bearer set and the session inbox valid: another machine -> routed;
#       this machine or not proven -> routed on true or unknown (idle, no
#       recent signal: the server holds it until acked), REFUSED on false. A
#       failed lookup is REFUSED, never read as unknown. A recipient that may
#       be on another machine is never written to a local maildir.
#
# --routed (HG-17) sends through the `athena` MCP `session_send` tool instead of
# a maildir: the server stamps `from` = {this machine, this project's
# <project>-session.jsonl} and delivers into the recipient's session inbox, a
# `log` channel. After the path line it prints one JSON receipt as the LAST
# line -- {path:"routed", event_id, delivery_id, status:"pending", to,
# from_inbox} -- and NEVER writes a local maildir. --subject and at least one of --re / --thread are required. It
# refuses (never falls back) when the MCP is not registered for this project
# (Fix: scripts/add-athena-mcp), when ${ATHENA_MCP_BEARER} is unset (launch via
# scripts/athena), or when this project declares no <project>-session.jsonl
# channel. In this mode --thread is the event_id of the message you answer.
#
# ============================ WHAT A SEND IS ===============================
#
# A message is IMMUTABLE once delivered. There is no edit, no append and no
# delete: a correction is a NEW message carrying `thread:` with the filename of
# the one being corrected. `.acked/` is the only durable transcript of the
# collaboration, and a transcript that can be rewritten is not one.
#
# The peer is not a subordinate and this is not a command channel. Write a
# message as a REPORT OR A REQUEST -- never as a directive to the receiving
# harness -- for the same reason the read side treats every incoming imperative
# as a fact rather than an instruction: neither agent supervises the other, and
# a channel that can issue instructions is a channel that can be used to issue
# SOMEONE ELSE'S instructions. Both sides are allowed to disagree; say so in a
# reply rather than expecting compliance.
#
# ============================ THE ORDER, WHICH IS THE POINT ================
#
#   scan <seq> -> build the name -> render -> stage in <write>/tmp/
#              -> link(2) into place -> THEN touch <write>/.event
#
# The doorbell is bumped AFTER the message is in place, never before: a waiter
# woken early finds nothing, goes back to sleep, and the wake is lost. Delivery
# is link(2) rather than rename(2) because rename SILENTLY REPLACES an existing
# destination, and a message destroyed by a name collision is exactly the
# silent loss this facility exists to eliminate.
#
# The scan, the name and the delivery all happen under this channel's
# `.sender.lock` -- deriving <seq> is a scan-then-create with no interlock, so
# two senders scanning at once pick the same value. That lock is NOT the
# consumer lock: a writer may not create one, and under the mirrored model the
# consumer lock in this directory is the PEER's.
#--- end usage ---
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB="$(dirname "${HERE}")/lib"

# shellcheck source=/dev/null
. "${LIB}/err.sh"
# shellcheck source=/dev/null
. "${LIB}/names.sh"
# shellcheck source=/dev/null
. "${LIB}/descriptor.sh"
# shellcheck source=/dev/null
. "${LIB}/logchan.sh"
# shellcheck source=/dev/null
. "${LIB}/maildir.sh"
# shellcheck source=/dev/null
. "${LIB}/fence.sh"
# shellcheck source=/dev/null
. "${LIB}/session.sh"
# shellcheck source=/dev/null
. "${LIB}/fs.sh"
# shellcheck source=/dev/null
. "${LIB}/lock.sh"
# shellcheck source=/dev/null
. "${LIB}/inbox.sh"

usage() { sed -n '2,/^#--- end usage ---$/p' "${BASH_SOURCE[0]}" | grep -v '^#--- end usage ---$' | sed 's/^# \{0,1\}//'; }

CHANNEL=""
SLUG=""
TO=""
ROUTED=0
LOCAL=0
TO_PROJECT=""
SUBJECT=""
RE=""
THREAD=""
BODY_FILE=""
EDIT=0

# The option parser refuses a flag with no value rather than swallowing the
# next positional. `--to --re x` would otherwise set TO="--re" and then fail
# the identity grammar with a message about a name nobody typed.
need_value() {
  local opt="$1" val="${2:-}"
  case "${val}" in
    ""|--*)
      inbox_fail "option \"${opt}\" needs a value" \
        "run: send-mail [--local] <channel> <slug> --to <identity>, or send-mail [--routed] --to <machine_id>/<inbox_name> --subject <line> --re <path-or-url>. Run send-mail -h for the full synopsis."
      exit 2
      ;;
  esac
  return 0
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --to)        need_value --to "${2:-}";        TO="$2";        shift 2 ;;
    --routed)    ROUTED=1; shift ;;
    --local)     LOCAL=1; shift ;;
    --to-project) need_value --to-project "${2:-}"; TO_PROJECT="$2"; shift 2 ;;
    --subject)   need_value --subject "${2:-}";   SUBJECT="$2";   shift 2 ;;
    --re)        need_value --re "${2:-}";        RE="$2";        shift 2 ;;
    --thread)    need_value --thread "${2:-}";    THREAD="$2";    shift 2 ;;
    --body-file) need_value --body-file "${2:-}"; BODY_FILE="$2"; shift 2 ;;
    --edit)      EDIT=1; shift ;;
    -h|--help)   usage; exit 0 ;;
    -*)
      inbox_fail "unknown option \"$1\"" \
        "run: send-mail [--local] <channel> <slug> --to <identity> [--re <path-or-url>] [--thread <message-filename>] [--body-file <path> | --edit], or send-mail [--routed] --to <machine_id>/<inbox_name> --subject <line> --re <path-or-url>. Run send-mail -h for both synopses."
      exit 2
      ;;
    *)
      if   [ -z "${CHANNEL}" ]; then CHANNEL="$1"
      elif [ -z "${SLUG}" ];    then SLUG="$1"
      else
        inbox_fail "too many positional arguments (\"$1\")" \
          "run: send-mail <channel> <slug> --to <identity>. The body is not an argument: pipe it on stdin or pass --body-file."
        exit 2
      fi
      shift
      ;;
  esac
done

# THE TWO MODES DO NOT MIX. A routed send has no channel and no slug (the
# server names the delivery), and a maildir send has no subject and no
# project addressing. A flag from the other mode is refused rather than
# ignored: an ignored --subject on a maildir send would be text the sender
# believes was delivered.
#
# ADDRESS is what the invocation names -- `maildir` (a channel) or `server`
# (--to <machine_id>/<inbox>, --to-project) -- and PATH_REASON is set once the
# path is chosen. With neither flag, the path is decided below, after the
# inputs are known to be well-formed, by inbox_default_path.
if [ "${ROUTED}" -eq 1 ] && [ "${LOCAL}" -eq 1 ]; then
  inbox_fail "both --routed and --local were given" \
    "choose one: --routed sends through the athena MCP, --local on the maildir channel named. Give neither to let send-mail choose, and it prints which it chose."
  exit 2
fi
ADDRESS="maildir"
if [ "${ROUTED}" -eq 1 ]; then
  ADDRESS="server"
elif [ "${LOCAL}" -eq 0 ] && [ -z "${CHANNEL}" ]; then
  # No channel named and no flag: a --to-project, or a --to carrying a "/"
  # (<machine_id>/<inbox>, never a maildir identity), is a SERVER address.
  if [ -n "${TO_PROJECT}" ]; then ADDRESS="server"; fi
  case "${TO}" in */*) ADDRESS="server" ;; esac
fi
PATH_REASON=""

if [ "${ADDRESS}" = "server" ]; then
  if [ -n "${CHANNEL}" ]; then
    inbox_routed_channel_refusal "${CHANNEL}" "."
    exit 2
  fi
  if [ -n "${TO}" ] && [ -n "${TO_PROJECT}" ]; then
    inbox_fail "both --to and --to-project were given" \
      "choose one: --to <machine_id>/<inbox_name>, or --to-project <project>[@<machine>]."
    exit 2
  fi
  if [ -z "${TO}" ] && [ -z "${TO_PROJECT}" ]; then
    inbox_fail "no recipient given" \
      "pass --to <machine_id>/<project>-session.jsonl, or --to-project <project>[@<machine>] to resolve it through list_my_machines."
    exit 2
  fi
  inbox_routed_precheck "${TO}" "${TO_PROJECT}" "${SUBJECT}" "${RE}" "${THREAD}" || exit 2
  [ "${ROUTED}" -eq 0 ] || PATH_REASON="--routed was given"
elif [ -n "${TO_PROJECT}" ] || [ -n "${SUBJECT}" ]; then
  if [ "${LOCAL}" -eq 1 ]; then
    inbox_fail "--to-project and --subject belong to a routed send, and --local sends on a maildir channel" \
      "for the maildir: send-mail --local <channel> <slug> --to <identity>. For the server: drop --local and pass --to-project/--subject (and --re or --thread)."
  else
    inbox_fail "--to-project and --subject belong to a routed send" \
      "add --routed to send through the athena MCP, or drop them for a maildir send (send-mail <channel> <slug> --to <identity>)."
  fi
  exit 2
else
  # A maildir address whose --to is a SERVER address (<machine_id>/<inbox>) is
  # refused here, before a path line is printed or $EDITOR opened: a maildir
  # identity never carries a "/".
  case "${TO}" in
    */*)
      if [ -n "${CHANNEL}" ]; then WHAT="channel \"${CHANNEL}\""; else WHAT="--local"; fi
      inbox_fail "--to is a server address (${TO%%/*}/...), not a maildir peer identity, and this is a maildir send (${WHAT}) -- nothing was sent" \
        "on the maildir: send-mail [--local] <channel> <slug> --to <identity>. To send to <machine_id>/<inbox> on the server, drop the channel and use --routed (or no flag)."
      exit 2 ;;
  esac
  [ "${LOCAL}" -eq 0 ] || PATH_REASON="--local was given"
fi

# EVERY MISSING INPUT IS NAMED SEPARATELY. A single "usage" line for all of
# them would make the commonest mistake -- forgetting --to, which has no
# default and cannot have one -- read as though the whole invocation were
# wrong.
if [ "${ADDRESS}" = "maildir" ] && [ -z "${CHANNEL}" ]; then
  inbox_fail "no channel named" \
    "run: send-mail <channel> <slug> --to <identity>. Run inbox-status to see which channels this project declares."
  exit 2
fi
if [ "${ADDRESS}" = "maildir" ] && [ -z "${SLUG}" ]; then
  inbox_fail "no slug given" \
    "run: send-mail ${CHANNEL} <slug> --to <identity>. The slug is the human-readable tail of the filename the peer will see -- 1 to 48 characters matching ^[a-z0-9][a-z0-9-]*$."
  exit 2
fi
if [ "${ADDRESS}" = "maildir" ] && [ -z "${TO}" ]; then
  # THERE IS NO DEFAULT, AND GUESSING ONE WOULD BE WORSE THAN REFUSING. A
  # registry entry declares only THIS side's `identity`; the peer's name is not
  # in the schema, and an unknown key there is a hard error. Deriving it from
  # the mail already in the read directory would mean taking a `from` -- a
  # label any local process can claim -- as the address to send to.
  inbox_fail "no recipient given" \
    "pass --to with the peer's identity: the name on the other side of this channel, as it appears in the \"from\" of the mail you receive here. A registry entry declares only your own identity, so there is nothing to default to."
  exit 2
fi

if ! command -v jq >/dev/null 2>&1; then
  inbox_fail "jq is required and was not found on PATH" \
    "install jq (it is already a dependency of the athena:slack skill), then re-run."
  exit 2
fi
if [ "${ADDRESS}" = "maildir" ] && ! command -v flock >/dev/null 2>&1; then
  # REFUSED, NOT DEGRADED. Without the lock two senders scanning at once derive
  # the same <seq>; the delivery is non-clobbering so nothing is destroyed, but
  # the contract requires the lock across scan/build/deliver and a send that
  # quietly ran without it would be non-conformant while looking identical.
  inbox_fail "flock is required to send and was not found on PATH" \
    "install util-linux (flock). The sender holds this channel's .sender.lock across scanning for the next sequence number, building the filename and delivering -- without it two senders pick the same number."
  exit 2
fi

# --- the path (HG-19) --------------------------------------------------------
# Decided BEFORE the body is captured, so a refused send never opens $EDITOR
# for a message that will not go anywhere. With a flag the path is the flag's;
# with neither, inbox_default_path applies the D20 rule (and asks the server
# only when its answer decides it).
if [ -z "${PATH_REASON}" ]; then
  if [ "${ADDRESS}" = "server" ]; then DEFAULT_TO="${TO}"; else DEFAULT_TO=""; fi
  DECISION="$(inbox_default_path "${ADDRESS}" "." "${DEFAULT_TO}")" || exit 2
  CHOSEN="${DECISION%%$'\t'*}"; PATH_REASON="${DECISION#*$'\t'}"
  case "${CHOSEN}" in
    local)  ;;
    routed) ROUTED=1 ;;
    refuse)
      routed_path_line refused "${PATH_REASON}"
      inbox_fail "no path was chosen: ${PATH_REASON}" "$(routed_default_refusal_fix)"
      exit 2 ;;
    *)
      inbox_fail "internal: the path decision was not local, routed or refuse (\"${CHOSEN}\")" \
        "report this with the flags you passed; nothing was sent. Meanwhile choose the path yourself with --local or --routed."
      exit 2 ;;
  esac
fi

# --- the body ---------------------------------------------------------------
# Three sources, and ONE capture path through the manager, so the NUL check and
# the regular-file check cannot apply to two of them and miss the third.
#
# Whichever source is used, an EMPTY body is refused downstream: an empty
# message is the missing-input shape of this command (a pipeline that produced
# nothing, an $EDITOR abandoned), and it would be delivered into the peer's
# transcript immutably while the sender was told their text went out.
#
# `--edit` exists so the interactive branch is REACHABLE WITHOUT A TERMINAL.
# Selecting it only by "stdin is a tty" made it untestable by construction, and
# a branch no test can enter is a branch that breaks silently -- which is the
# whole subject of this skill. The tty check remains as the FALLBACK for
# someone who typed the command by hand and passed neither.
BODY=""
if [ -n "${BODY_FILE}" ] && [ "${EDIT}" -eq 1 ]; then
  inbox_fail "both --body-file and --edit were given" \
    "choose one source for the body: --body-file <path>, --edit, or stdin."
  exit 2
fi

# `&&`, NOT `;`, between the capture and the trailing-`X` guard. `$(a; b)` takes
# its exit status from `b` -- here always `printf X`, i.e. always 0 -- so a `;`
# would swallow a capture refusal (NUL byte, missing or symlinked --body-file),
# leave BODY empty, and march on to the downstream empty-body check, which then
# refuses with the WRONG cause ("pipe the body in ...") for a file that existed
# and was rejected. With `&&`, a refusing capture short-circuits before `printf`,
# the substitution carries the capture's non-zero status, `|| exit 1` fires, and
# the accurate refusal inbox_body_capture already printed is the last word.
if [ -n "${BODY_FILE}" ]; then
  BODY="$(inbox_body_capture "${BODY_FILE}" && printf X)" || exit 1
  BODY="${BODY%X}"
elif [ "${EDIT}" -eq 1 ] || [ -t 0 ]; then
  if [ -z "${EDITOR:-}" ]; then
    inbox_fail "no body: no --body-file was given, and \$EDITOR is unset" \
      "pipe the body in (printf '%s\\n' \"...\" | send-mail ...), pass --body-file <path>, or set \$EDITOR to compose interactively."
    exit 2
  fi
  DRAFT="$(mktemp "${TMPDIR:-/tmp}/athena-mail.XXXXXX")" || {
    inbox_fail "cannot create a draft file for \$EDITOR" "check that \$TMPDIR is writable, or pipe the body on stdin instead."
    exit 2
  }
  trap 'rm -f "${DRAFT}"' EXIT
  chmod 0600 "${DRAFT}" 2>/dev/null || true
  # Word-split on purpose -- $EDITOR routinely CARRIES ARGUMENTS (`code -w`,
  # `emacsclient -nw`), and invoked as a single word those fail with "not
  # found", surfacing here as the editor having exited non-zero and sending
  # the reader to look at their draft instead of at their environment.
  #
  # `set -f` around it because an unquoted expansion is word-split AND
  # PATHNAME-EXPANDED: without it an $EDITOR containing a glob character would
  # be expanded against the caller's current directory, so the command run is
  # not the command configured. That is the second half of this repo's own
  # `custom` PR #6 lesson, and it costs one line to close.
  set -f
  sh -c '"$@"' _ ${EDITOR} "${DRAFT}"; EDIT_RC=$?
  set +f
  if [ "${EDIT_RC}" -ne 0 ]; then
    inbox_fail "\$EDITOR exited non-zero; nothing was sent" \
      "re-run and save the draft, or pipe the body on stdin. The draft was discarded rather than delivered, because an editor that failed may have written a partial message."
    exit 1
  fi
  BODY="$(inbox_body_capture "${DRAFT}" && printf X)" || exit 1
  BODY="${BODY%X}"
else
  BODY="$(inbox_body_capture "-" && printf X)" || exit 1
  BODY="${BODY%X}"
fi

# --- send -------------------------------------------------------------------
# THE LOCK IS RELEASED BY THE KERNEL, AND THIS TRAP IS BELT, NOT BRACES.
# `inbox_send_mail` runs inside a command substitution at the end of a pipeline,
# so it executes in a SUBSHELL: this shell's INBOX_LOCK_PATH is never set, and
# the release below is a no-op on the ordinary path. What actually releases the
# lock is the subshell exiting, which closes the descriptor -- `flock(2)` is
# released on close, including on process death, which is the same property
# that makes the contract forbid reaping a "stale" lock. The trap is kept for
# the library caller that sources these files and calls the manager in-process,
# and the draft is removed on every exit path either way.
trap 'inbox_release_consumer; rm -f "${DRAFT:-}" 2>/dev/null || true' EXIT

if [ "${ROUTED}" -eq 1 ]; then
  routed_path_line routed "${PATH_REASON}"
  # THE PATH LINE, THEN THE RECEIPT, AND NOTHING ELSE -- the same rule as the filename below: the
  # body is never echoed back. `event_id` is what a reply's --thread names;
  # `delivery_id` is the handle for the server's delivery status. "pending"
  # is literal: a platform delivery is delivered only on the recipient's ack.
  printf '%s' "${BODY}" | inbox_send_routed "${TO}" "${TO_PROJECT}" "${SUBJECT}" "${RE}" "${THREAD}" "." || exit 1
  exit 0
fi

routed_path_line local "${PATH_REASON}"
NAME="$(printf '%s' "${BODY}" | inbox_send_mail "${CHANNEL}" "${SLUG}" "${TO}" "." "${RE}" "${THREAD}")" || exit 1

# THE PATH LINE, THEN THE FILENAME, AND NOTHING ELSE. Not the body -- echoing it back would put the
# text a second time in the context that composed it, for no information. The
# filename is what the peer will see, what a `thread:` in a later message
# points at, and the only handle this side has on the message afterwards.
printf 'athena:inbox: delivered %s\n' "${NAME}"
