#!/bin/sh
# status <channel_id|#name> <thread_ts> [text] [--clear]
#
# Shows "Athena <text>" under the bot's name in a DM or thread while a session
# works on a message there (assistant.threads.setStatus). Default text is
# "is thinking…". --clear removes it. Flags may come in any position.
#
# thread_ts is the thread's PARENT ts: a message's thread_ts when it is a
# reply, its own ts when it is top-level (a DM message is its own thread).
#
# Slack clears the status by itself when the bot replies in the thread, and
# after about 2 minutes with no new message. So: set it before starting work,
# set it again at least every 2 minutes during long work, and --clear it only
# when ending without a reply.
#
# The text is generic. It NEVER carries message content: anyone in the
# conversation sees it.
#
# A failure exits non-zero with the Slack error and a Fix: line on stderr. A
# caller must log that and carry on: the status is a courtesy, and a failed one
# must never block or delay the reply it announces.
#
# Exit codes: 0 set or cleared; 1 Slack refused it; 2 usage; 4 the message no
# longer exists in Slack (deleted before the call), so there is nothing to
# show a status in.
#
# invalid_thread_ts has two causes, and the Fix: differs (DND-1804, measured
# live 2026-10-02 in the owner DM): a reply's own ts was passed instead of its
# parent's, or the message was deleted. A top-level message with no replies,
# passed by its own ts, is accepted. So on invalid_thread_ts this asks
# conversations.replies about the same key and says which it is. A probe that
# fails, or answers with no message, says it could not tell.
set -eu
SELF_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
. "$SELF_DIR/../lib/slack.sh"
for _arg in "$@"; do
  case "$_arg" in -h|--help) slack_help "$0"; exit 0 ;; esac
done

# Every failure funnels through slack_die (no token, ok:false, a 429 give-up),
# so redefining it after sourcing puts a Fix: on all of them. Functions are
# late-bound, so the lib's own calls resolve to this one.
slack_die() {
  case "$1" in
    *invalid_thread_ts*)
      if [ "${STATUS_PROBING:-}" != 1 ] && [ -n "${CHANNEL:-}" ]; then
        status_explain_invalid_ts "$1"
      fi ;;
  esac
  printf 'athena-slack: status failed: %s\n' "$1" >&2
  case "$1" in
    *invalid_thread_ts*)
      _fix='pass the thread PARENT ts: the message'"'"'s thread_ts when it is a reply, its own ts when it is top-level.' ;;
    *channel_not_found*|*"no channel named"*)
      _fix='pass the id of the DM or channel the message came from (D.../C...); the bot must be a member of it.' ;;
    *method_not_supported_for_channel_type*)
      _fix='this conversation type has no thread status; skip the status and reply as normal.' ;;
    *"no bot token"*|*"not a bot token"*|*invalid_auth*|*not_authed*|*token_revoked*)
      _fix='run athena:slack/bin/whoami to test the bot token (see athena:slack -> Setup); do not rotate it yourself.' ;;
    *)
      _fix='resolve the Slack error above; run athena:slack/bin/whoami to test the token.' ;;
  esac
  printf 'Fix: %s The status is a courtesy: log this failure and send the reply anyway.\n' "$_fix" >&2
  exit 1
}

# status_probe -- asks conversations.replies about the key setStatus refused.
# Prints exactly one of:
#   gone:<slack error>   the message no longer exists (thread_not_found)
#   parent:<ts>          the key is a reply; <ts> is its thread's parent
#   toplevel             the message exists and is its own parent
#   unknown:<why>        the probe failed, or its answer cannot say
# A subshell, so its own slack_die never exits the script.
status_probe() (
  STATUS_PROBING=1
  slack_die() { printf 'error:%s\n' "$1"; exit 1; }
  if ! _pr="$(slack_get conversations.replies \
      "channel=$(slack_urlencode "$CHANNEL")&ts=$(slack_urlencode "$THREAD_TS")&limit=1")"; then
    case "$_pr" in
      *thread_not_found*|*message_not_found*) printf 'gone:%s\n' "${_pr#error:}" ;;
      *) printf 'unknown:%s\n' "${_pr#error:}" ;;
    esac
    exit 0
  fi
  printf '%s' "$_pr" | jq -r --arg t "$THREAD_TS" '
    ((.messages // [])[0]) as $m
    | if $m == null then "unknown:conversations.replies answered with no message"
      elif (($m.ts // "") | tostring) != $t then "unknown:conversations.replies answered about another message"
      elif ((($m.thread_ts // "") | tostring) != "" and (($m.thread_ts | tostring) != $t)) then "parent:\($m.thread_ts)"
      else "toplevel" end' 2>/dev/null \
    || printf 'unknown:conversations.replies answer could not be parsed\n'
)

# status_explain_invalid_ts <slack error> -- names which invalid_thread_ts this
# is, with its own Fix:, and exits. Never returns.
status_explain_invalid_ts() {
  _probe="$(status_probe)"
  _key="$CHANNEL/$THREAD_TS"
  _courtesy='The status is a courtesy: log this failure and send the reply anyway.'
  case "$_probe" in
    gone:*)
      printf 'athena-slack: status not set: message %s no longer exists in Slack (%s; assistant.threads.setStatus answered invalid_thread_ts).\n' \
        "$_key" "${_probe#gone:}" >&2
      printf 'Fix: nothing to set and nothing to retry: the message was deleted, so there is no conversation to show a status in. Reply only if what it asked still needs an answer.\n' >&2
      exit 4 ;;
    parent:*)
      printf 'athena-slack: status failed: %s (%s is a reply in thread %s).\n' "$1" "$_key" "${_probe#parent:}" >&2
      printf 'Fix: pass the thread PARENT ts: status %s %s. %s\n' "$CHANNEL" "${_probe#parent:}" "$_courtesy" >&2
      exit 1 ;;
    toplevel)
      printf 'athena-slack: status failed: %s, though %s still exists as a top-level message.\n' "$1" "$_key" >&2
      printf 'Fix: the ts is right; check the bot is a member of this DM or thread (athena:slack/bin/whoami, then bin/channels --member). %s\n' "$_courtesy" >&2
      exit 1 ;;
    *)
      printf 'athena-slack: status failed: %s, and the check of why could not tell (%s).\n' "$1" "${_probe#unknown:}" >&2
      printf 'Fix: if the message is a reply, pass its thread PARENT ts; if it was deleted, there is nothing to set. %s\n' "$_courtesy" >&2
      exit 1 ;;
  esac
}

usage() {
  printf 'usage: status <channel_id|#name> <thread_ts> [text] [--clear]\n' >&2
  printf 'Fix: %s\n' "$1" >&2
  exit 2
}

slack_need_tools

CLEAR=false
POSITIONAL=0
CHAN_ARG=""; THREAD_TS=""; TEXT=""; HAVE_TEXT=false
while [ "$#" -gt 0 ]; do
  case "$1" in
    --clear) CLEAR=true; shift ;;
    --) shift
        while [ "$#" -gt 0 ]; do
          POSITIONAL=$((POSITIONAL + 1))
          case "$POSITIONAL" in
            1) CHAN_ARG="$1" ;; 2) THREAD_TS="$1" ;; 3) TEXT="$1"; HAVE_TEXT=true ;;
            *) usage "too many arguments; quote the status text as one argument." ;;
          esac
          shift
        done ;;
    -*) usage "unknown flag '$1'; the only flag is --clear." ;;
    *)
      POSITIONAL=$((POSITIONAL + 1))
      case "$POSITIONAL" in
        1) CHAN_ARG="$1" ;; 2) THREAD_TS="$1" ;; 3) TEXT="$1"; HAVE_TEXT=true ;;
        *) usage "too many arguments; quote the status text as one argument." ;;
      esac
      shift ;;
  esac
done

[ "$POSITIONAL" -ge 2 ] || usage "pass the channel id and the thread's parent ts."

# A ts that is malformed for its type is an error here, not a Slack round trip
# that might read as a miss later.
case "$THREAD_TS" in
  *[!0-9.]*|.*|*.|*.*.*|"") usage "thread_ts '$THREAD_TS' is not a Slack ts (digits.digits, e.g. 1790360915.980679)." ;;
  *.*) ;;
  *) usage "thread_ts '$THREAD_TS' is not a Slack ts (digits.digits, e.g. 1790360915.980679)." ;;
esac

if [ "$CLEAR" = true ]; then
  [ "$HAVE_TEXT" = false ] || usage "--clear takes no text; drop the text or drop --clear."
  STATUS=""
else
  if [ "$HAVE_TEXT" = true ]; then STATUS="$TEXT"; else STATUS="is thinking…"; fi
  [ -n "$STATUS" ] || usage "empty text would clear the status; use --clear to clear it."
fi

CHANNEL="$(slack_resolve_channel "$CHAN_ARG")"
slack_post assistant.threads.setStatus \
  "$(jq -n --arg c "$CHANNEL" --arg t "$THREAD_TS" --arg s "$STATUS" \
     '{channel_id: $c, thread_ts: $t, status: $s}')" >/dev/null

if [ "$CLEAR" = true ]; then
  printf 'status cleared on %s/%s\n' "$CHANNEL" "$THREAD_TS"
else
  printf 'status set on %s/%s: %s\n' "$CHANNEL" "$THREAD_TS" "$STATUS"
fi
