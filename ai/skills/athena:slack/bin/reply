#!/bin/sh
# reply <channel_id|#name> <thread_ts> [text] [--broadcast] [--no-claim]
#       [--reroute-of <event_id>]
#
# thread_ts MUST be the ts of the thread's PARENT message. Slack does not
# accept a reply's ts there; passing one either starts a second thread or is
# rejected, and neither failure is obvious from the posted result. Take the
# value from `read-thread`, from `post`'s output, or from a message's
# thread_ts field -- never from a reply's own ts.
#
# --broadcast also shows the reply in the channel (reply_broadcast). Use it
# sparingly: it is a notification to everyone in the channel, not a formatting
# choice.
#
# Then it CLAIMS the thread for this session's project inbox IF the thread is
# unclaimed (DND-1521), so the next reply in it comes back to the session that
# answered rather than to the channel route. The server's first claim wins, so
# a thread another inbox holds stays theirs; only the holder's session_send
# forward moves a claim (SKILL.md -> Forwarding a misroute, DND-1617).
# One more line follows the ts/permalink lines:
#   claim=claimed|already_yours inbox=<inbox> source=<source>      (stdout)
#   claim=already_claimed holder=another-inbox inbox=<inbox> ...    (stdout)
#   claim=skipped                     (--no-claim: no reply expected)
#   claim=FAILED reason=... + Fix:    (stderr) replied, not claimed
# The exit is 0 in every one of those: the reply is posted, and a failed claim
# never fails it (do not re-post; run `claim-thread <channel> <thread_ts>
# --already-claimed-ok` once the cause is fixed). A non-zero exit is a failed
# post, as before.
#
# --reroute-of <event_id> marks the reply as the note a session posts when it
# FORWARDS a misrouted conversation to the session that owns it (DND-1605).
# <event_id> is the one it passed to session_send as reroute_of_event_id. It
# implies --no-claim and prints claim=skipped: a forwarder that claimed the
# thread would get the owner's follow-ups instead of the session it forwarded
# to. The <event_id> is required but not sent anywhere: it makes the command
# say it is a forward note. A missing, empty or flag-shaped <event_id> is a
# usage error, and nothing is sent.
#
# The thread claimed is the one Slack actually threaded the reply into (the
# response's message.thread_ts), falling back to the thread_ts argument when
# the response carries none: a caller that passed a reply's ts by mistake
# never gets a different thread claimed for good.
set -eu
SELF_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
. "$SELF_DIR/../lib/slack.sh"
case "${1:-}" in -h|--help) slack_help "$0"; exit 0 ;; esac
slack_need_tools

usage() {
  slack_usage_die 'reply <channel_id|#name> <thread_ts> [text] [--broadcast] [--no-claim] [--reroute-of <event_id>]'
}

reroute_usage() {
  printf 'reply: --reroute-of needs the event_id of the forwarded conversation (nothing was sent)\n' >&2
  printf 'Fix: pass the event_id you gave session_send as reroute_of_event_id: reply <channel> <thread_ts> <text> --reroute-of <event_id>\n' >&2
  exit 2
}

# Flags may come in any position; the first two positionals are the channel
# and the thread_ts, the third is the text.
CHAN_ARG=""
THREAD_TS=""
TEXT=""
NPOS=0
BROADCAST=false
CLAIM=true
while [ "$#" -gt 0 ]; do
  case "$1" in
    --broadcast) BROADCAST=true; shift ;;
    --no-claim) CLAIM=false; shift ;;
    --reroute-of)
      # A forward note never claims the thread (DND-1605).
      [ "$#" -ge 2 ] || reroute_usage
      case "$2" in ''|-*) reroute_usage ;; esac
      CLAIM=false; shift 2 ;;
    --) shift; TEXT="${1:-}"; break ;;
    -*) usage ;;
    *)
      case "$NPOS" in
        0) CHAN_ARG="$1" ;;
        1) THREAD_TS="$1" ;;
        2) TEXT="$1" ;;
        *) usage ;;
      esac
      NPOS=$((NPOS + 1)); shift ;;
  esac
done
[ "$NPOS" -ge 2 ] || usage
if [ -z "$TEXT" ]; then TEXT="$(cat)"; fi
[ -n "$TEXT" ] || slack_refuse_die 'refusing to send an empty message' 'pass the reply as the text argument or on stdin: reply <channel> <thread_ts> <text>.'

CHANNEL="$(slack_resolve_channel "$CHAN_ARG")"
BODY="$(jq -n --arg c "$CHANNEL" --arg t "$TEXT" --arg tt "$THREAD_TS" \
  --argjson b "$BROADCAST" \
  '{channel: $c, text: $t, thread_ts: $tt} + (if $b then {reply_broadcast: true} else {} end)')"

RESP="$(slack_post chat.postMessage "$BODY")"
TS="$(printf '%s' "$RESP" | jq -r '.ts')"
OUT_CHAN="$(printf '%s' "$RESP" | jq -r '.channel')"
printf 'ts=%s channel=%s thread_ts=%s\n' "$TS" "$OUT_CHAN" "$THREAD_TS"
PERMALINK="$(slack_permalink "$OUT_CHAN" "$TS" || printf '')"
if [ -n "$PERMALINK" ]; then printf 'permalink=%s\n' "$PERMALINK"; fi
CLAIM_TS="$(printf '%s' "$RESP" | jq -r --arg tt "$THREAD_TS" '.message.thread_ts // $tt')"
if [ "$CLAIM" = true ]; then slack_claim_replied_thread "$SELF_DIR" "$OUT_CHAN" "$CLAIM_TS"; fi
printf 'claim=skipped\n'
