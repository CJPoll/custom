#!/bin/sh
# dm <user_id> [text] [--thread_ts <ts>] [--no-claim]
#
# Opens (or reuses) the bot's IM with one user and posts to it. Slack has no
# "post to a user"; conversations.open is what turns a U... into a D... .
#
# ETIQUETTE, NOT A FLAG: do not DM anyone Cody has not cleared. A DM from a bot
# is a notification on someone's phone with no channel context around it, and
# Athena is acting on Cody's behalf -- an unexpected one reads as Cody pinging
# them. Post in a channel or thread by default; DM by exception.
#
# A NEW DM (no --thread_ts) starts a thread, so dm then CLAIMS it for this
# session's project inbox, exactly as `post` does (see post's header for the
# claim=... line; a failed claim prints claim=FAILED and a Fix: line on stderr
# and exits 3 = posted, not claimed). A reply into an existing
# thread (--thread_ts) claims it only IF it is unclaimed, exactly as `reply`
# does (DND-1521; see reply's header): another inbox's thread stays theirs
# (claim=already_claimed), and every claim outcome exits 0 because the reply
# is posted. --no-claim skips the claim and prints claim=skipped.
set -eu
SELF_DIR="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
. "$SELF_DIR/../lib/slack.sh"
case "${1:-}" in -h|--help) slack_help "$0"; exit 0 ;; esac
slack_need_tools

usage() {
  printf 'usage: dm <user_id> [text] [--thread_ts <ts>] [--no-claim]\n' >&2
  exit 2
}

[ "$#" -ge 1 ] || usage
USER_ID="$1"; shift
TEXT=""
THREAD_TS=""
CLAIM=true
while [ "$#" -gt 0 ]; do
  case "$1" in
    --thread_ts) [ "$#" -ge 2 ] || usage; THREAD_TS="$2"; shift 2 ;;
    --no-claim) CLAIM=false; shift ;;
    --) shift; TEXT="${1:-}"; break ;;
    -*) usage ;;
    *) TEXT="$1"; shift ;;
  esac
done
if [ -z "$TEXT" ]; then TEXT="$(cat)"; fi
[ -n "$TEXT" ] || { printf 'dm: refusing to send an empty message\n' >&2; exit 2; }

case "$USER_ID" in
  U*|W*) ;;
  *) printf 'dm: first argument must be a user id (U...), not a name\n' >&2; exit 2 ;;
esac

OPEN="$(slack_post conversations.open "$(jq -n --arg u "$USER_ID" '{users: $u}')")"
CHANNEL="$(printf '%s' "$OPEN" | jq -r '.channel.id')"
[ -n "$CHANNEL" ] || slack_die "conversations.open returned no channel id"

BODY="$(jq -n --arg c "$CHANNEL" --arg t "$TEXT" '{channel: $c, text: $t}')"
if [ -n "$THREAD_TS" ]; then
  BODY="$(printf '%s' "$BODY" | jq --arg tt "$THREAD_TS" '. + {thread_ts: $tt}')"
fi
RESP="$(slack_post chat.postMessage "$BODY")"
TS="$(printf '%s' "$RESP" | jq -r '.ts')"
printf 'ts=%s channel=%s user=%s\n' "$TS" "$CHANNEL" "$USER_ID"
PERMALINK="$(slack_permalink "$CHANNEL" "$TS" || printf '')"
if [ -n "$PERMALINK" ]; then printf 'permalink=%s\n' "$PERMALINK"; fi
if [ "$CLAIM" = true ]; then
  if [ -n "$THREAD_TS" ]; then
    # The thread Slack actually threaded the reply into, as `reply` does.
    slack_claim_replied_thread "$SELF_DIR" "$CHANNEL" \
      "$(printf '%s' "$RESP" | jq -r --arg tt "$THREAD_TS" '.message.thread_ts // $tt')"
  fi
  slack_claim_started_thread "$SELF_DIR" "$CHANNEL" "$TS"
fi
printf 'claim=skipped\n'
