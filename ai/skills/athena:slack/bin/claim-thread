#!/usr/bin/env bash
# claim-thread <channel_id> <thread_ts> [--already-claimed-ok]
#
# Claims a Slack thread for THIS session's project inbox, so the thread's
# replies are routed back here (ai/contracts/athena-events.md -> *Thread
# replies route to the thread's claimant*). `post` and `dm` run it on every
# thread they start, and `reply` and `dm --thread_ts` on the thread they reply
# into (with --already-claimed-ok, below); run it by hand to retry a claim that
# failed, without re-posting.
#
# The inbox is found from the SESSION's project, not the shell's cwd
# (DND-1163): $CLAUDE_PROJECT_DIR, else the Claude Code process's own cwd
# (/proc/$CLAUDE_PID/cwd, which the Bash tool's `cd` never moves), else the cwd
# -> realpath of its git common dir -> this project's entry in the inbox
# registry -> its one Slack `log` channel (no producer, or producer "slack") ->
# that channel's path, e.g. custom-slack.jsonl. A shell cwd inside a DIFFERENT
# registered project is refused (cwd-project-mismatch) rather than claimed for
# either one: a claim cannot be taken back (see SKILL.md -> Thread replies come back to the session that started the thread).
# The bot_id and team_id come from auth.test (cached). The call is the athena
# MCP tool `slack_thread_claim`; the machine token is read from the inbox
# client config and reaches curl only on stdin.
#
# thread_ts is the PARENT message's ts, as post/dm print it.
#
# Every claim is first-claim-wins on the server: a thread another inbox holds
# is never taken. --already-claimed-ok (DND-1521; `reply` and `dm --thread_ts`
# pass it) says the caller wanted the thread only IF it was unclaimed, so the
# server's already_claimed is an outcome, not a failure:
#   claim=already_claimed holder=another-inbox inbox=<inbox> source=<source>
#                                                      (stdout) exit 0
# `inbox=` there is THIS session's inbox, the one that did not get the thread;
# the server never names the holder. Without the flag, already_claimed stays
# claim=FAILED reason=already-claimed, exit 3. Flags may come in any position.
#
# Output (source = project-dir | session-process | cwd: where the project came
# from; project = the directory it names, on a failure once known):
#   claim=claimed inbox=<inbox> source=<source>        (stdout) exit 0
#   claim=already_yours inbox=<inbox> source=<source>  (stdout) exit 0
#   claim=FAILED reason=<token> key=<team>/<channel>/<ts> inbox=<inbox|none>
#     [source=<source> project=<dir>]
#     Fix: <what to do>                  (stderr) exit 3
# A usage error (a malformed channel or ts) is claim=FAILED reason=invalid,
# exit 2, and makes no call. Reasons, each distinct: no-registry-entry,
# registry-error, no-slack-channel, ambiguous-slack-channel, no-identity,
# no-token, mcp-unregistered, mcp-error:<words>, not-found, refused,
# already-claimed, invalid, cwd-project-mismatch, project-unresolved.
# no-registry-entry adds a `lookup:` line naming the repo key that matched
# nothing.
set -uo pipefail

SELF="$(realpath "${BASH_SOURCE[0]}")"
SELF_DIR="$(dirname "${SELF}")"
case "${1:-}" in -h|--help)
  awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "${SELF}"; exit 0 ;;
esac

# Flags in any position; parsed first so every failure line, the
# missing-library one included, names the positional channel and ts.
ALREADY_CLAIMED_OK=false
POSITIONAL=()
BAD_FLAG=""
for arg in "$@"; do
  case "${arg}" in
    --already-claimed-ok) ALREADY_CLAIMED_OK=true ;;
    -*) BAD_FLAG="${arg}" ;;
    *) POSITIONAL+=("${arg}") ;;
  esac
done
CHANNEL="${POSITIONAL[0]:-}"
TS="${POSITIONAL[1]:-}"

SLACK_LIB="${SELF_DIR}/../lib"
INBOX_LIB="${SELF_DIR}/../../athena:inbox/lib"
for f in err.sh names.sh descriptor.sh logchan.sh maildir.sh fence.sh session.sh fs.sh lock.sh inbox.sh; do
  if [ ! -f "${INBOX_LIB}/${f}" ]; then
    printf 'claim=FAILED reason=mcp-error:missing-library key=?/%s/%s inbox=none\n' "${CHANNEL:-?}" "${TS:-?}" >&2
    printf 'Fix: athena:inbox is not beside athena:slack (%s/%s is missing); both skills ship together from ~/dev/custom/ai/skills.\n' "${INBOX_LIB}" "${f}" >&2
    exit 3
  fi
  # shellcheck source=/dev/null
  . "${INBOX_LIB}/${f}"
done
# shellcheck source=/dev/null
. "${SLACK_LIB}/claim.sh"

TEAM="?"
INBOX="none"
SOURCE=""
PROJECT_DIR=""

# fail <reason> [server-words] -- the one failure shape; exits 3 (2 for invalid).
fail() {
  local reason="$1" words="${2:-}" code=3 where=""
  [ -z "${SOURCE}" ] || where=" source=${SOURCE} project=${PROJECT_DIR}"
  printf 'claim=FAILED reason=%s key=%s/%s/%s inbox=%s%s\n' "${reason}" "${TEAM}" \
    "$(claim_oneline "${CHANNEL}")" "$(claim_oneline "${TS}")" "${INBOX}" "${where}" >&2
  [ -z "${words}" ] || printf 'server: %s\n' "${words}" >&2
  if [ "${reason}" = "no-registry-entry" ] && [ -n "${PROJECT_DIR}" ]; then
    printf 'lookup: repo key %s matched no inbox registry entry\n' \
      "$(fs_git_common_dir "${PROJECT_DIR}" 2>/dev/null || printf '(none: %s is in no git repository)' "${PROJECT_DIR}")" >&2
  fi
  printf 'Fix: %s\n' "$(claim_reason_fix "${reason}")" >&2
  [ "${reason}" != "invalid" ] || code=2
  exit "${code}"
}

[ -z "${BAD_FLAG}" ] || fail invalid
[ "${#POSITIONAL[@]}" -eq 2 ] || fail invalid
[[ "${CHANNEL}" =~ ^[CDG][A-Z0-9]+$ ]] || fail invalid
[[ "${TS}" =~ ^[0-9]+\.[0-9]+$ ]] || fail invalid

# The SESSION's project (DND-1163), captured ABSOLUTE here, at the point of
# capture: a relative git common dir resolved later, from another directory,
# matches no entry (athena-inbox.md -> *Repo identity: the git common dir*).
# inbox_session_dir refuses a shell cwd inside a different registered project;
# its own refusal (with its Fix:) is on stderr above the claim=FAILED line.
PROJECT_LINE="$(inbox_session_dir)"
case "$?" in
  0) ;;
  2) fail registry-error ;;
  3) PROJECT_LINE="$(session_project_dir 2>/dev/null)"
     SOURCE="${PROJECT_LINE%%$'\t'*}"; PROJECT_DIR="${PROJECT_LINE#*$'\t'}"
     fail cwd-project-mismatch ;;
  *) fail project-unresolved ;;
esac
SOURCE="${PROJECT_LINE%%$'\t'*}"
PROJECT_DIR="${PROJECT_LINE#*$'\t'}"
INBOX_OR_REASON="$(claim_resolve_inbox "${PROJECT_DIR}")" || fail "${INBOX_OR_REASON}"
INBOX="${INBOX_OR_REASON}"

# The bot identity, in a subshell: slack_die exits, and here it must become
# the no-identity reason, never a bare exit 1.
IDENT="$( . "${SLACK_LIB}/slack.sh" && slack_load_bot_identity >/dev/null \
  && printf '%s\t%s\n' "${SLACK_BOT_BOT_ID}" "${SLACK_BOT_TEAM_ID}" )" || fail no-identity
BOT_ID="${IDENT%%$'\t'*}"
TEAM="${IDENT#*$'\t'}"
[ -n "${BOT_ID}" ] && [ -n "${TEAM}" ] || { TEAM="?"; fail no-identity; }

[ "$(mcp_token_state)" = "present" ] || fail no-token

URL="$(inbox_mcp_registration "${PROJECT_DIR}" 2>/dev/null)"; RC=$?
case "${RC}" in
  0) ;;
  1) fail mcp-unregistered ;;
  2) fail "mcp-error:registration-key" ;;
  *) fail "mcp-error:registration-unreadable" ;;
esac

ARGS="$(jq -n -c --arg b "${BOT_ID}" --arg t "${TEAM}" --arg c "${CHANNEL}" \
  --arg ts "${TS}" --arg i "${INBOX}" \
  '{bot_id: $b, team_id: $t, channel: $c, thread_ts: $ts, inbox_name: $i}')" \
  || fail "mcp-error:could-not-build-arguments"

MSG="$(mcp_call_tool "${URL}" slack_thread_claim "${ARGS}")"; RC=$?
[ "${RC}" -eq 0 ] || fail "mcp-error:$(claim_oneline "${MSG}")"

STATUS="$(claim_parse_result "${MSG}")" || {
  if [ "${STATUS}" = "already-claimed" ] && [ "${ALREADY_CLAIMED_OK}" = true ]; then
    printf 'claim=already_claimed holder=another-inbox inbox=%s source=%s\n' "${INBOX}" "${SOURCE}"
    exit 0
  fi
  fail "${STATUS}" "$(claim_server_words "${MSG}")"
}
printf 'claim=%s inbox=%s source=%s\n' "${STATUS}" "${INBOX}" "${SOURCE}"
exit 0
