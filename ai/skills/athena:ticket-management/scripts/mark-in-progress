#!/usr/bin/ruby
# frozen_string_literal: true

# mark-in-progress -- move a ticket to In Progress and stamp when it first got
# there (DND-1318; the work tracker, DND-1341).
#
# Lead time is captain dispatch -> landed on main (owner decision, Cody,
# 2026-09-30). Dispatch is the ticket's move to In Progress. The Notion API
# keeps no history of a property, so that move is recorded as it happens, in a
# date property on the ticket. ai/bin/lead-time reads it as the START
# (ai/docs/lead-time-tracking.md -> The START marker).
#
# Two trackers (ai/lib/dispatch_trackers.rb):
#   - a DND ticket (DND-N): DND Tickets, date "In Progress at", notion-personal;
#   - a work ticket (<prefix>-N): the work tracker. Its data source, prefix,
#     stamp property and first-dispatch statuses are work values, read from
#     the private overlay (ai/contracts/athena-private-overlay.md). With no
#     overlay, or a key missing, a work ticket is refused (exit 3) with the
#     resolver's line and Fix; nothing is guessed. It uses the notion-work token.
#
# One call does both writes, so the status and the stamp cannot drift apart:
#   - Status -> In Progress;
#   - the stamp -> now (or --at), ONLY when it is empty AND the ticket is
#     moving from one of the tracker's first-dispatch statuses (DND: Todo or
#     Backlog). A re-dispatch keeps its FIRST stamp; an unstamped ticket moving
#     from any other status is not stamped (its first dispatch is unknown here)
#     and says so, with the --backfill fix. Two dispatches of one ticket at the
#     same instant could both see an empty stamp; the later write wins, seconds
#     apart.
# It does not touch Assignee: that stays the admiral's step
# (athena:ticket-management -> Status -> Assignee map).
#
# Telemetry (DND-1476): after a successful write, one local `ticket.dispatched`
# event (ai/contracts/athena-telemetry.md), unit = the ticket ref. Never on a
# refusal, a dry run, or a run that wrote nothing. It fails open: the event
# never changes this tool's exit code or stdout.
#
# Buckets: DOMAIN (MarkInProgress.plan: what to write, pure; DispatchTrackers:
# which tracker), EFFECTS (the Notion transport, the overlay read), MANAGER
# (MarkInProgress.run) and FRAMEWORK (argv). A token is read from its file
# in-process and never reaches argv, the environment, or any output.
#
# Deliberately gem-free (stdlib only).

require "json"
require "net/http"
require "time"
require "uri"
require_relative "../../../lib/strict_argv"
require_relative "../../../lib/next_mission_notion"
require_relative "../../../lib/dispatch_trackers"
require_relative "../../../lib/dispatch_trackers_overlay"

module MarkInProgress
  PROG = "mark-in-progress"
  PROPERTY = DispatchTrackers::DND.property
  STATUS = DispatchTrackers::IN_PROGRESS

  USAGE = <<~TXT
    Usage: mark-in-progress --ref TICKET [--at ISO8601] [--dry-run]
           mark-in-progress --ref TICKET --backfill --at ISO8601 [--dry-run]
           mark-in-progress --help

    Move a ticket to In Progress and, only if it has none yet, stamp its
    dispatch date: the START ai/bin/lead-time measures lead time from
    (DND-1318). A re-dispatched ticket keeps its first stamp. Assignee is not
    touched.

      --ref TICKET  DND-N: DND Tickets, date "In Progress at" (notion-personal).
                    <work prefix>-N: the work tracker (notion-work). Its prefix,
                    database and stamp property come from the private overlay,
                    overlay/notion.json .work.* (DND-1341); with no overlay a
                    work ticket is refused, never guessed.
      --at ISO8601  stamp this time instead of now (a recorded dispatch time;
                    it must carry a time and a zone)
      --backfill    stamp only; leave Status as it is. For a ticket already
                    past In Progress whose dispatch time is on record. Needs --at.
      --dry-run     print what would be written; write nothing
      --help        this text

    Exit: 0 written (or dry run), 2 usage, 3 Notion or the overlay could not be
    read or written, or the ticket or its property is missing.
  TXT

  class Refused < StandardError; end
  class BadUsage < StandardError; end

  module_function

  # DOMAIN. page: the ticket page; at: the ISO time to stamp; status: false
  # for a backfill, which writes the stamp only (at an explicit time).
  # tracker: whose property and first-dispatch statuses apply.
  # -> {properties:, stamp:, kept:, skipped:} or raises Refused naming the fix.
  # properties is empty when there is nothing to write; skipped is the reason
  # a move did not stamp.
  def plan(ref, page, at, status: true, tracker: DispatchTrackers::DND)
    prop = tracker.property
    props = page["properties"] || {}
    unless props.dig(prop, "type") == "date"
      raise Refused, "#{tracker.label} has no date property '#{prop}' " \
                     "(found #{props.dig(prop, 'type').inspect}). " \
                     "Fix: add a date property named '#{prop}' to #{tracker.label}, then re-run."
    end

    existing = props.dig(prop, "date", "start")
    now_status = props.dig("Status", "status", "name")
    write = status ? { "Status" => { "status" => { "name" => STATUS } } } : {}
    skipped = nil
    if existing.nil? && status && !tracker.first_dispatch_from.include?(now_status)
      skipped = "not stamped: it was #{now_status.inspect}, so this is not its first dispatch. " \
                "Fix: stamp its recorded first dispatch with --backfill --at ISO8601"
    elsif existing.nil?
      write[prop] = { "date" => { "start" => at } }
    end
    { properties: write, stamp: existing || (skipped ? nil : at), kept: !existing.nil?, skipped: skipped, ref: ref }
  end

  ZONED_RE = /T.*(Z|[+-]\d\d:?\d\d)\z/.freeze

  def parse_at(text)
    unless text.match?(ZONED_RE)
      raise BadUsage, "--at needs a time with a zone (e.g. 2026-09-30T02:41:00Z). Fix: pass one."
    end

    Time.iso8601(text).utc.iso8601
  rescue ArgumentError
    raise BadUsage, "--at #{text.inspect} is not an ISO 8601 time. Fix: pass e.g. 2026-09-30T02:41:00Z."
  end

  # MANAGER. transport_for: ->(tracker) -> transport answering
  # call(method, path, body) -> Hash (raising NextMissionNotion::ReadError), or
  # raising Refused when its token is missing. work: -> DispatchTrackers::Resolution,
  # called only for a non-DND ref. -> exit code.
  def run(argv, transport_for:, now:, work: -> { DispatchTrackers::Overlay.work }, out: $stdout, err: $stderr)
    opts = StrictArgv.parse(argv, { "--ref" => :value, "--at" => :value, "--dry-run" => :switch,
                                    "--backfill" => :switch })
    ref = opts["--ref"]
    unless ref
      err.puts "#{PROG}: pass one ticket id with --ref, like --ref DND-1318."
      err.puts "Fix: #{PROG} --ref TICKET [--at ISO8601] [--dry-run]"
      return 2
    end
    tracker, why, code = DispatchTrackers.for_ref(ref, work: work)
    unless tracker
      err.puts "#{PROG}: #{why}"
      return code
    end
    backfill = opts.fetch("--backfill", false)
    raise BadUsage, "--backfill needs --at, the recorded dispatch time. Fix: add --at ISO8601." if backfill && !opts["--at"]

    at = opts["--at"] ? parse_at(opts["--at"]) : now.utc.iso8601
    transport = transport_for.call(tracker)
    page = find(transport, tracker, Integer(ref.split("-", 2).last, 10), ref)
    p = plan(ref, page, at, status: !backfill, tracker: tracker)
    unless opts["--dry-run"] || p[:properties].empty?
      transport.call(:patch, "/v1/pages/#{page['id']}", { "properties" => p[:properties] })
      emit_dispatched(ref, tracker, p, at, backfill)
    end
    status_note = backfill ? "Status unchanged" : "Status #{STATUS}"
    stamp_note = if p[:skipped] then "#{tracker.property} #{p[:skipped]}"
                 else "#{tracker.property} #{p[:stamp]} (#{p[:kept] ? 'kept, already stamped' : 'stamped'})"
                 end
    out.puts "#{ref}: #{status_note}; #{stamp_note}#{opts['--dry-run'] ? ' [dry run]' : ''}"
    err.puts "#{PROG}: #{ref} #{p[:skipped]}" if p[:skipped]
    0
  rescue BadUsage => e
    err.puts "#{PROG}: #{e.message}"
    2
  rescue StrictArgv::UsageError => e
    err.puts "#{PROG}: #{e.message}."
    err.puts "Fix: #{PROG} --ref TICKET [--at ISO8601] [--dry-run]"
    2
  rescue Refused => e
    err.puts "#{PROG}: #{e.message}"
    3
  rescue NextMissionNotion::ReadError => e
    err.puts "#{PROG}: Notion could not be reached: #{e.message}"
    err.puts "Fix: check the token at #{tracker&.token_file} and Notion's status, then re-run."
    3
  end

  # DOMAIN. The ticket.dispatched attrs for a write that happened. tracker is
  # dnd or work; first_dispatch is true when this write set the stamp.
  def dispatched_attrs(tracker, plan, backfill)
    { "tracker" => tracker.prefix == DispatchTrackers::DND.prefix ? "dnd" : "work",
      "first_dispatch" => plan[:properties].key?(tracker.property),
      "backfill" => backfill }
  end

  # EFFECTS. One local ticket.dispatched event, after the Notion write
  # returned. at is the dispatch instant: --at when given, else now. Fails
  # open: a missing writer or any error leaves the run as it was.
  def emit_dispatched(ref, tracker, plan, at, backfill)
    require_relative "../../../lib/athena_telemetry"
    AthenaTelemetry.emit("ticket.dispatched", at: Time.iso8601(at), unit: ref,
                                              attrs: dispatched_attrs(tracker, plan, backfill))
  rescue StandardError, LoadError
    nil
  end

  def find(transport, tracker, number, ref)
    body = { "filter" => { "property" => "ID", "unique_id" => { "equals" => number } }, "page_size" => 2 }
    res = transport.call(:post, "/v1/data_sources/#{tracker.data_source}/query", body)
    page = (res["results"] || []).first
    raise Refused, "there is no #{ref} in #{tracker.label}. Fix: check the ticket id." unless page

    page
  end

  # EFFECTS. The tracker's token, read in-process. -> Transport, or raises
  # Refused naming the file.
  def transport_for_token_file(tracker)
    file = tracker.token_file
    token = File.exist?(file) ? File.read(file).strip : ""
    if token.empty?
      raise Refused, "no Notion token at #{file} for #{tracker.label}. " \
                     "Fix: the owner places that integration token there (owner-gated)."
    end

    Transport.new(token)
  end

  # EFFECTS. Notion REST with GET/POST/PATCH; the token stays in-process.
  class Transport
    def initialize(token)
      @token = token
    end

    def call(method, path, body = nil)
      klass = { get: Net::HTTP::Get, post: Net::HTTP::Post, patch: Net::HTTP::Patch }.fetch(method)
      req = klass.new(path)
      req["Authorization"] = "Bearer #{@token}"
      req["Notion-Version"] = NextMissionNotion::NOTION_VERSION
      if body
        req["Content-Type"] = "application/json"
        req.body = JSON.generate(body)
      end
      res = Net::HTTP.start("api.notion.com", 443, use_ssl: true, open_timeout: 15, read_timeout: 30) do |h|
        h.request(req)
      end
      unless res.code.to_i.between?(200, 299)
        raise NextMissionNotion::ReadError, "HTTP #{res.code} on #{method.upcase} #{path}"
      end

      JSON.parse(res.body)
    rescue SocketError, SystemCallError, Timeout::Error, OpenSSL::SSL::SSLError, IOError, Net::HTTPBadResponse,
           JSON::ParserError => e
      raise NextMissionNotion::ReadError, "#{e.class} on #{method.upcase} #{path}: #{e.message}"
    end
  end
end

if $PROGRAM_NAME == __FILE__
  if ARGV.include?("--help") || ARGV.include?("-h")
    puts MarkInProgress::USAGE
    exit 0
  end
  exit MarkInProgress.run(ARGV, transport_for: ->(t) { MarkInProgress.transport_for_token_file(t) }, now: Time.now)
end
