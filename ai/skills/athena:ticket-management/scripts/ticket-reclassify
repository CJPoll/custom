#!/usr/bin/ruby
# frozen_string_literal: true

# ticket-reclassify -- plan the ticket classification policy's changes over
# the open DND backlog, and prove they were applied (DND-1056).
#
# Design: DND-1056 Architecture & Engineering (the tool) and DND-991's (the
# policy and its provenance line). Procedure: athena:ticket-management ->
# *Reclassifying the backlog*. Contract:
# ~/dev/custom/ai/contracts/athena-judgments.md -> *Ticket classification:
# the harness script*.
#
# READ ONLY toward Notion. The tool plans; the agent writes with its own
# notion-personal connection; `proof` re-reads. Every Notion request goes
# through ai/lib/notion_read.rb, whose allowlist refuses anything but a read
# before it is sent. The only other call is the classification endpoint,
# which records its own judgment_calls rows and writes nothing else.
#
# Buckets: the pure DOMAIN is ../lib/reclassify.rb (with ../lib/classify.rb);
# below are the EFFECTS (Notion reads, the Athena server, the clock, files),
# the MANAGER (plan; proof) and the FRAMEWORK (argv).
#
# Ticket text is untrusted data. It is sent to the server as the ticket being
# judged and is never written to the plan file, which holds ids, values and
# the server's provenance lines only (0600).
#
# Deliberately gem-free (stdlib only).

require "fileutils"
require "json"
require "time"
require_relative "../../../lib/strict_argv"
require_relative "../../../lib/notion_read"
require_relative "../../../lib/triage_corpus"
require_relative "../lib/athena_server"
require_relative "../lib/classify"
require_relative "../lib/reclassify"

PROG = "ticket-reclassify"
ENDPOINT = "/api/v1/judgments/ticket_classification"
PLAN_FORMAT = "ticket-reclassify/1"

USAGE = <<~EOF
  Usage: ticket-reclassify plan --out FILE [--limit N] [--resume-from DND-N]
         ticket-reclassify proof --against FILE
         ticket-reclassify --help

  Apply the ticket classification policy (DND-991) to the OPEN backlog
  (DND-1056). The tool never decides and never writes Notion: the server
  decides, the agent writes, and proof checks.

  plan   Read every DND ticket (read-only, paced), skip what may not be
         re-judged, ask the classification endpoint about the rest with each
         ticket's CURRENT Kind, Severity and Security as the filer's values
         and its id as ticket.ref, and write FILE (0600): per ticket the
         current and decided values, the changes, and the server's provenance
         line verbatim. Skipped, counted and listed by reason, in this order:
           no_status               the ticket has no Status (never read as open)
           closed                  Status Done, Cancelled or Won't Fix
           feature                 Kind Feature (authored, never judged)
           unset_properties        Kind, Severity or Security empty
           unknown_value           a value outside the tracker's set
           no_project              no epic maps the ticket to a project
           blank_title             a title the server would refuse
           body_unread             the body could not be read
           unparseable_provenance  the LAST "Jev classification:" line is
                                   broken (never read as absent)
           locked                  a current value differs from that line's
                                   value: someone edited it; the edit wins
           already_classified      that line has the server's model and
                                   versions now, no fault reason, and every
                                   property in mode on or the modes now. No
                                   call is made, except for the first ticket
                                   asked, whose answer is what reports the
                                   server's model, versions and modes
           refused                 the server refused the request (HTTP 422)
           unavailable             the server answered with a fault for this
                                   one call (timeout, overloaded, ...)
         Each answered ticket is one of:
           planned    a decided value differs: write the properties and the
                      provenance line
           unchanged  no change and some mode on: write the provenance line
                      (a later hand edit then locks the ticket)
           inert      no change and no mode on: write nothing
         At most #{Reclassify::TICKETS_PER_MINUTE} tickets a minute. A budget or rate reason, an
         account-wide fault (key, credential, custody, price, our own bug,
         model), a server that cannot be used or an unexpected error stops
         the plan at that ticket: FILE records the cursor and why (exit 3).
         A plan whose tickets include body_unread, refused or unavailable
         ones is INCOMPLETE (exit 3): apply it, then plan again.
    --out FILE            where to write the plan (absolute path; use a new
                          one for each run)
    --limit N             ask about at most N tickets, then stop with a cursor
                          (a partial plan, exit 0)
    --resume-from DND-N   start at this ticket (a plan's cursor; it must be a
                          real ticket id)
  proof  Re-read every ticket the plan writes (planned and unchanged): its
         Kind, Severity and Security must equal the plan's decided values
         and its body's LAST "Jev classification:" line must equal the plan's
         provenance line, byte for byte. A page that cannot be read is a
         mismatch, never a pass.
    --against FILE        the plan to check

  Exit codes:
    0  plan written (complete, or partial by --limit) / proof holds
    1  an input is missing or malformed, Notion could not be read, or a bug
    2  usage
    3  plan stopped early (resume with --resume-from) or INCOMPLETE
    4  proof mismatch

  Every failure prints one line carrying Fix:. The Notion token is the file
  the notion-personal MCP entry names; the Athena server URL is the athena MCP
  entry's origin and its token the inbox client config's. Neither token
  reaches argv or the environment. Environment (optional, tests):
  FLEET_CLAUDE_JSON, ATHENA_INBOX_CLIENT_CONFIG, TICKET_RECLASSIFY_NOTION_API
  (a loopback URL), TICKET_RECLASSIFY_PACE_S (seconds between Notion reads,
  default 0.4), TICKET_RECLASSIFY_CALL_INTERVAL_S (seconds between
  classification calls, default #{format('%.2f', Reclassify::CALL_INTERVAL_S)}; the server's own local
  limit still applies), TICKET_RECLASSIFY_MAX_TIME_S (per server request, default 60).
EOF

class Failure < StandardError
  attr_reader :code

  def initialize(code, message)
    super(message)
    @code = code
  end
end

def fail!(code, what, fix)
  raise Failure.new(code, "#{PROG}: #{what}. Fix: #{fix}")
end

# ── EFFECTS ──────────────────────────────────────────────────────────────────

module Effects
  TICKETS_DATA_SOURCE = "219349da-87fb-8063-8f36-000b362fbd60"
  PROJECTS_DATA_SOURCE = "3e2349da-87fb-809a-a93e-000b167fd855"

  # The tracker, read only, through NotionRead. Raises NotionRead::Error.
  class Notion
    def initialize
      @origin, @token = NotionRead.credentials(ENV["TICKET_RECLASSIFY_NOTION_API"])
    rescue NotionRead::Error => e
      fail!(e.message.start_with?("the Notion API override") ? 2 : 1, e.message.sub("the Notion API override", "TICKET_RECLASSIFY_NOTION_API"), e.fix)
    end

    def pace
      value = ENV["TICKET_RECLASSIFY_PACE_S"].to_s
      /\A\d{1,2}(\.\d{1,3})?\z/.match?(value) ? value.to_f : 0.4
    end

    def query(data_source) = NotionRead.query_all(@origin, @token, data_source, pace: pace)
    def children(page_id) = NotionRead.children_all(@origin, @token, page_id, pace: pace)
    def page(page_id) = NotionRead.page(@origin, @token, page_id, pace: pace)
  end

  # The classification endpoint. post(body) -> {curl_rc:, status:, body:} or
  # {unreachable: why}.
  class Server
    def post(body)
      origin, token = AthenaServer.endpoint
      AthenaServer.post_json(origin, token, ENDPOINT, body, max_time: AthenaServer.max_time("TICKET_RECLASSIFY_MAX_TIME_S"))
    rescue AthenaServer::Unreachable, AthenaServer::UnsafeValue => e
      { unreachable: e.message }
    end
  end

  class Clock
    def now = Process.clock_gettime(Process::CLOCK_MONOTONIC)
    def sleep(seconds) = Kernel.sleep(seconds)
  end

  module_function

  def call_interval
    value = ENV["TICKET_RECLASSIFY_CALL_INTERVAL_S"].to_s
    /\A\d{1,3}(\.\d{1,3})?\z/.match?(value) ? value.to_f : Reclassify::CALL_INTERVAL_S
  end

  def write_private(path, text)
    FileUtils.mkdir_p(File.dirname(path), mode: 0o700)
    File.write("#{path}.tmp", text, perm: 0o600)
    File.chmod(0o600, "#{path}.tmp")
    File.rename("#{path}.tmp", path)
  rescue SystemCallError => e
    fail!(1, "could not write #{path}: #{e.class}", "check that directory is writable")
  end

  def read_plan(path)
    fail!(1, "plan #{path} does not exist", "run #{PROG} plan --out #{path} first") unless File.exist?(path)
    fail!(1, "plan #{path} is not a readable file", "check its permissions") unless File.file?(path) && File.readable?(path)
    doc = begin
      JSON.parse(File.read(path, encoding: "UTF-8"))
    rescue JSON::ParserError
      nil
    end
    unless doc.is_a?(Hash) && doc["format"] == PLAN_FORMAT && doc["entries"].is_a?(Array)
      fail!(1, "plan #{path} is not a #{PLAN_FORMAT} plan", "pass the file #{PROG} plan wrote")
    end
    doc
  end
end

# ── MANAGER ──────────────────────────────────────────────────────────────────

module Manager
  module_function

  def deps
    { notion: Effects::Notion.new, server: Effects::Server.new, clock: Effects::Clock.new, interval: Effects.call_interval,
      progress: $stderr }
  end

  # tickets(notion) -> every DND ticket, by number, each with its project.
  def tickets(notion)
    project_rows = notion.query(Effects::PROJECTS_DATA_SOURCE).map { |r| TriageCorpus.project_row(r) }
    fail!(1, "the DND Projects data source returned no rows", "a failed lookup, not an empty tracker: check the share, then re-run") if project_rows.empty?
    epic_projects = TriageCorpus.epic_projects(project_rows)
    rows = notion.query(Effects::TICKETS_DATA_SOURCE)
    list = rows.filter_map { |r| TriageCorpus.ticket_from_row(r) }
    fail!(1, "the DND Tickets data source returned no ticket with a DND id (#{rows.size} rows)", "a failed lookup, not an empty tracker: check the share, then re-run") if list.empty?
    missing = list.flat_map { |t| t["schema_missing"] }.uniq.sort
    fail!(1, "the tracker rows carry no select property #{missing.join(', ')}", "the DND Tickets schema changed: update TriageCorpus.ticket_from_row and this tool") unless missing.empty?
    # A renamed Status would read nil on every row, and nil is not closed:
    # every closed ticket would be re-judged. That is an error, not "open".
    no_status = rows.count { |r| TriageCorpus.ticket_from_row(r) && !(r.dig("properties", "Status").is_a?(Hash) && r.dig("properties", "Status").key?("status")) }
    fail!(1, "#{no_status} tracker rows carry no Status status property", "the DND Tickets schema changed: update TriageCorpus.ticket_from_row and this tool") if no_status.positive?
    list.each { |t| t["project"] = TriageCorpus.project_of(t, epic_projects) }
    list.sort_by { |t| TriageCorpus.number(t["ref"]) }
  rescue TriageCorpus::InputError => e
    fail!(1, e.message, e.fix)
  rescue NotionRead::Error => e
    fail!(1, e.message, e.fix)
  end

  def read_body(notion, ticket)
    blocks = notion.children(ticket["page_id"])
    ticket["blocks_text"] = blocks.filter_map { |b| TriageCorpus.block_text(b) }
    ticket["body_read"] = true
  rescue NotionRead::Error
    ticket["blocks_text"] = []
    ticket["body_read"] = false
  end

  # plan(opts, out, deps) -> exit code. Writes the plan file.
  def plan(opts, out, deps)
    all = tickets(deps[:notion])
    scope = all
    if opts[:resume_from]
      # A cursor is always a real ticket: a typo must never read as an empty,
      # complete plan.
      fail!(1, "--resume-from #{opts[:resume_from]} matches no ticket", "pass the cursor a plan printed, exactly") unless all.any? { |t| t["ref"] == opts[:resume_from] }
      start = TriageCorpus.number(opts[:resume_from])
      scope = all.select { |t| TriageCorpus.number(t["ref"]) >= start }
    end
    state = { now: nil, entries: [], skipped: Hash.new { |h, k| h[k] = [] }, inert: [], asked: 0,
              stop: nil, cursor: nil, last_call: nil }
    scope.each_with_index do |t, i|
      stopped = if opts[:limit] && state[:asked] >= opts[:limit]
                  "--limit #{opts[:limit]} reached"
                else
                  guarded_consider(t, state, deps)
                end
      deps[:progress]&.puts("#{PROG}: #{i + 1} of #{scope.size} considered, #{state[:asked]} asked") if ((i + 1) % 50).zero?
      next unless stopped

      state[:stop] = stopped
      state[:cursor] = t["ref"]
      state[:not_reached] = scope.size - i
      break
    end
    doc = plan_doc(opts, scope, state)
    check_sum!(doc["counts"])
    Effects.write_private(opts[:out], JSON.pretty_generate(doc) + "\n")
    summary(doc, opts[:out]).each { |l| out.puts l }
    finish(state, doc, out)
  end

  # finish(state, doc, out) -> the exit code, after the line that says why a
  # plan is not whole. Exit 3 for a stop (budget, rate, server) or for
  # tickets that could not be judged; 0 for a whole plan or a --limit stop.
  def finish(state, doc, out)
    if state[:stop] && !state[:stop].start_with?("--limit")
      out.puts "#{PROG}: STOPPED at #{state[:cursor]}: #{state[:stop]}. #{Reclassify::UNAVAILABLE_FIX} (--resume-from #{state[:cursor]}, into a new --out); the entries above it are a valid partial plan."
      return 3
    end
    unjudged = Reclassify::INCOMPLETE_REASONS.flat_map { |r| state[:skipped][r].map { |ref| "#{r} #{ref}" } }
    return 0 if unjudged.empty?

    out.puts "#{PROG}: INCOMPLETE: #{unjudged.size} ticket(s) could not be judged (#{unjudged.join(', ')}). " \
             "Fix: apply this plan, then re-run plan into a new --out to retry them; a refused ticket (HTTP 422) is a request bug to report"
    3
  end

  # check_sum!(counts) -> raises unless every considered ticket is counted
  # exactly once (an accounting bug must never print a false equation).
  def check_sum!(counts)
    sum = counts["skipped"].values.sum + counts["planned"] + counts["unchanged"] + counts["inert"] + counts["not_reached"]
    return if sum == counts["considered"]

    fail!(1, "the plan counts #{sum} tickets but considered #{counts['considered']}", "this is a bug in #{PROG}; report it with the plan's counts")
  end

  # guarded_consider -> consider, with any unexpected error turned into a
  # stop at this ticket, so the answers so far are kept in the plan file.
  def guarded_consider(ticket, state, deps)
    consider(ticket, state, deps)
  rescue Failure
    raise
  rescue StandardError => e
    "UNEXPECTED ERROR: #{e.class}"
  end

  # consider(ticket, state, deps) -> nil, or why the plan stops here.
  def consider(ticket, state, deps)
    reason = Reclassify.property_skip(ticket)
    return skip(state, ticket, reason) if reason

    read_body(deps[:notion], ticket)
    verdict = Reclassify.eligibility(ticket, state[:now])
    return skip(state, ticket, verdict.last.to_s) unless verdict == :eligible

    wait = Reclassify.pace_delay(state[:last_call], deps[:clock].now, deps[:interval])
    deps[:clock].sleep(wait) if wait.positive?
    state[:last_call] = deps[:clock].now
    state[:asked] += 1
    kind, result = Reclassify.read_reply(deps[:server].post(Reclassify.request_body(ticket)), Reclassify.filer(Reclassify.current(ticket)))
    return result if kind == :stop
    return skip(state, ticket, "refused") if kind == :refused
    return skip(state, ticket, "unavailable") if kind == :unavailable

    now = Reclassify.now_of(result)
    if state[:now].nil?
      state[:now] = now
      # The first answer tells us the model, versions and modes; a ticket it
      # shows was already classified is counted so, never re-written.
      verdict = Reclassify.eligibility(ticket, now)
      return skip(state, ticket, verdict.last.to_s) unless verdict == :eligible
    elsif now != state[:now]
      return "the server's model, versions or modes changed during the run (#{describe_now(state[:now])} -> #{describe_now(now)})"
    end
    record(state, ticket, result, now)
    nil
  end

  def skip(state, ticket, reason)
    state[:skipped][reason] << ticket["ref"]
    nil
  end

  def record(state, ticket, result, now)
    entry = Reclassify.plan_entry(ticket, result)
    case Reclassify.outcome(entry["changes"], now["modes"])
    when :inert then state[:inert] << ticket["ref"]
    else state[:entries] << entry
    end
  end

  def plan_doc(opts, scope, state)
    entries = state[:entries]
    planned = entries.reject { |e| e["changes"].empty? }
    changes = planned.flat_map { |e| e["changes"] }.group_by { |c| "#{c['prop']} #{c['from']}->#{c['to']}" }.transform_values(&:size).sort.to_h
    skipped = Reclassify::SKIP_REASONS.to_h { |r| [r, state[:skipped][r].size] }
    counts = { "considered" => scope.size, "skipped" => skipped, "planned" => planned.size,
               "unchanged" => entries.size - planned.size, "inert" => state[:inert].size,
               "not_reached" => state[:not_reached] || 0, "asked" => state[:asked], "changes" => changes }
    { "format" => PLAN_FORMAT, "planned_at" => Time.now.utc.iso8601, "resumed_from" => opts[:resume_from],
      "complete" => state[:stop].nil? && Reclassify::INCOMPLETE_REASONS.none? { |r| state[:skipped][r].any? }, "cursor" => state[:cursor], "stopped_because" => state[:stop],
      "now" => state[:now], "counts" => counts,
      "skipped_refs" => Reclassify::SKIP_REASONS.to_h { |r| [r, state[:skipped][r]] }.reject { |r, _| %w[closed feature].include?(r) },
      "inert_refs" => state[:inert], "entries" => entries }
  end

  def describe_now(now)
    return "unknown (no ticket was asked)" if now.nil?

    modes = now["modes"].map { |k, v| "#{k} #{v}" }.join(", ")
    "model #{now['model']}, versions #{now['versions'].values.join(' ')}, modes #{modes}"
  end

  def refs(list)
    return "0" if list.empty?

    shown = list.first(20).join(", ")
    "#{list.size} (#{shown}#{list.size > 20 ? ', ...' : ''})"
  end

  # summary(doc, path) -> the lines the agent quotes. A plan with no writes
  # says so with its counts; it never reads as a silent success.
  def summary(doc, path)
    c = doc["counts"]
    skips = c["skipped"].map { |r, n| "#{r} #{n}" }.join(", ")
    writes = c["planned"] + c["unchanged"]
    lines = []
    lines << "#{PROG} plan: considered #{c['considered']}#{doc['resumed_from'] ? " (resumed from #{doc['resumed_from']})" : ''}, " \
             "asked #{c['asked']}, #{doc['complete'] ? 'complete' : "PARTIAL (cursor #{doc['cursor']}, not reached #{c['not_reached']})"}"
    lines << "skipped: #{skips}"
    doc["skipped_refs"].each { |r, list| lines << "  #{r}: #{refs(list)}" unless list.empty? }
    lines << "answered: planned #{c['planned']}, unchanged #{c['unchanged']}, inert #{c['inert']}"
    lines << "changes: #{c['changes'].empty? ? 'none' : c['changes'].map { |k, v| "#{k}: #{v}" }.join(', ')}"
    lines << "server now: #{describe_now(doc['now'])}"
    lines << if writes.zero?
               "writes to apply: 0 (0 property writes, 0 provenance lines)#{c['inert'].positive? ? '; every answered ticket is inert (no mode on, nothing changed)' : ''}"
             else
               "writes to apply: #{writes} tickets (#{c['planned']} with property writes, #{writes} provenance lines)"
             end
    lines << "sum check: considered #{c['considered']} = skipped #{c['skipped'].values.sum} + planned #{c['planned']} + unchanged #{c['unchanged']} + inert #{c['inert']} + not reached #{c['not_reached']}"
    lines << "plan: #{path}"
    lines
  end

  # page_values(page) -> {kind, severity, security} from a page's selects.
  def page_values(page)
    Reclassify::PROPS.to_h do |k, name|
      prop = page.dig("properties", name)
      raise NotionRead::Error.new("the page has no #{name} select property", "the DND Tickets schema changed") unless prop.is_a?(Hash) && prop.key?("select")

      [k, prop.dig("select", "name")]
    end
  end

  # proof(opts, out, deps) -> exit code.
  def proof(opts, out, deps)
    doc = Effects.read_plan(opts[:against])
    entries = doc["entries"]
    mismatches = []
    entries.each do |e|
      begin
        values = page_values(deps[:notion].page(e["page_id"]))
        lines = deps[:notion].children(e["page_id"]).filter_map { |b| TriageCorpus.block_text(b) }.flat_map { |t| t.split("\n") }
      rescue NotionRead::Error => err
        mismatches << "#{e['ref']}: could not read (#{err.message})"
        next
      end
      mismatches.concat(Reclassify.proof_mismatches(e, values, lines))
    end
    bad = mismatches.map { |m| m[/\A[A-Z]+-\d+/] }.uniq.size
    c = doc["counts"] || {}
    out.puts "#{PROG} proof: #{entries.size} entries (planned #{c['planned']}, unchanged #{c['unchanged']}), " \
             "#{entries.size - bad} match, #{bad} mismatch#{entries.empty? ? '; the plan holds no writes, nothing to prove' : ''}"
    return 0 if mismatches.empty?

    mismatches.each { |m| out.puts "MISMATCH #{m}" }
    out.puts "#{PROG}: #{bad} of #{entries.size} tickets do not match the plan. Fix: apply the named writes " \
             "(athena:ticket-management -> *Reclassifying the backlog*), then run proof again"
    4
  end
end

# ── FRAMEWORK ────────────────────────────────────────────────────────────────

SPEC = {
  "--out" => :value, "--limit" => :integer, "--resume-from" => :value, "--against" => :value
}.freeze
COMMAND_FLAGS = { "plan" => %w[--out --limit --resume-from], "proof" => %w[--against] }.freeze

# The subcommand may stand anywhere among the flags (order never matters); a
# word that is a value flag's value is not a subcommand.
def split_command(argv)
  commands = []
  rest = []
  i = 0
  while i < argv.length
    arg = argv[i]
    if %i[value integer].include?(SPEC[arg])
      rest.push(arg, *argv[i + 1, 1])
      i += 2
    elsif COMMAND_FLAGS.key?(arg)
      commands << arg
      i += 1
    else
      rest << arg
      i += 1
    end
  end
  fail!(2, "pass exactly one command, plan or proof (got #{commands.empty? ? 'none' : commands.join(', ')})", "run #{PROG} --help") unless commands.size == 1
  [commands.first, rest]
end

def parse_options(argv)
  command, rest = split_command(argv)
  raw = StrictArgv.parse(rest, SPEC)
  extra = raw.keys - COMMAND_FLAGS[command]
  fail!(2, "#{command} does not take #{extra.join(', ')}", "run #{PROG} --help") unless extra.empty?
  if command == "plan"
    fail!(2, "plan needs --out FILE", "pass an absolute path for the plan file") unless raw["--out"]
    fail!(2, "--out must be an absolute path", "pass an absolute path") unless raw["--out"].start_with?("/")
    fail!(2, "--limit must be 1..10000", "pass a ticket count") if raw["--limit"] && !(1..10_000).cover?(raw["--limit"])
    fail!(2, "--resume-from #{raw['--resume-from']} is not a DND ticket id", "pass a plan's cursor, such as DND-412") if raw["--resume-from"] && !/\ADND-\d+\z/.match?(raw["--resume-from"])
    { command: command, out: raw["--out"], limit: raw["--limit"], resume_from: raw["--resume-from"] }
  else
    fail!(2, "proof needs --against FILE", "pass the plan file plan wrote") unless raw["--against"]
    { command: command, against: raw["--against"] }
  end
rescue StrictArgv::UsageError => e
  fail!(2, e.message, "run #{PROG} --help for the flags")
end

def main(argv)
  # --help anywhere wins, before anything else runs (check-bin-help).
  if argv.include?("--help") || argv.include?("-h")
    $stdout.puts USAGE
    return 0
  end

  opts = parse_options(argv)
  deps = Manager.deps
  opts[:command] == "plan" ? Manager.plan(opts, $stdout, deps) : Manager.proof(opts, $stdout, deps.slice(:notion))
rescue Failure => e
  $stderr.puts e.message
  e.code
rescue StandardError => e
  $stderr.puts "#{PROG}: UNEXPECTED ERROR: #{e.class}. Fix: this is a bug in #{PROG}; re-run, and report it if it repeats"
  1
end

exit(main(ARGV)) if $PROGRAM_NAME == __FILE__
