#!/usr/bin/ruby
# frozen_string_literal: true

# ticket-classify -- the Jev-advised Kind, Severity and Security of a ticket
# about to be filed (DND-1054), and for a finding its Path and Blocks edge
# (DND-1057). Normative home: ~/dev/custom/ai/contracts/athena-judgments.md
# -> *Ticket classification: the harness script*. The servers are gen_saas
# Athena.Judgments.TicketClassification (POST
# /api/v1/judgments/ticket_classification, DND-991) and
# Athena.Judgments.TicketBlocking (POST /api/v1/judgments/ticket_blocking,
# DND-1057), which apply the policy and return the DECIDED values. The
# procedure that runs it is athena:ticket-management -> *Filing a ticket*
# (the Classify bullet).
#
# ADVISORY ONLY. It writes nothing anywhere but the server's own call
# records; the filer sets the properties and wires the edge. Its only tracker
# access is --epic's candidate read, through the read-only
# ai/lib/notion_read.rb (a data source query, block lists and one page
# read; any other request is refused before it is sent). It adds no policy of
# its own; it prints what the server decided, or, when a server cannot be
# used, the filer's own values under a heading that says so.
#
# Buckets: DOMAIN (pure: ../lib/classify.rb and ../lib/blocking.rb), EFFECTS
# (the body file; Notion through ai/lib/notion_read.rb; the Athena server
# through ../lib/athena_server.rb), MANAGER (validate, read, post, render)
# and FRAMEWORK (argv).
#
# NO TOKEN TOUCHES ARGV OR THE ENVIRONMENT: athena_server.rb and
# notion_read.rb write each into a curl config that curl reads on STDIN. No
# token is ever printed.
#
# Deliberately gem-free (stdlib only).

require "json"
require_relative "../../../lib/strict_argv"
require_relative "../../../lib/notion_read"
require_relative "../lib/athena_server"
require_relative "../lib/classify"
require_relative "../lib/blocking"
require_relative "../lib/provenance_lines"

PROG = "ticket-classify"
UNAVAILABLE_FIX = "Fix: file the ticket as today; this is advisory."
ENDPOINT = "/api/v1/judgments/ticket_classification"
BLOCKING_ENDPOINT = "/api/v1/judgments/ticket_blocking"
TICKETS_DATA_SOURCE = "219349da-87fb-8063-8f36-000b362fbd60"
EPICS_DATA_SOURCE = "f4231817-18f3-4c2d-ac5b-b1151a5bb020"

USAGE = <<~EOF
  Usage: ticket-classify --title T --body-file F --project P
                         --kind K --severity S --security X
                         [--ref DND-N] [--json] [--lines-out FILE]
         ticket-classify ... --epic EPIC_PAGE_ID [--found-while DND-N] [--blocks DND-N]
         ticket-classify --help

  The Jev-advised classification of a ticket about to be filed (DND-1054),
  and for a finding its Path (DND-1057). You pass the values you would file;
  the server decides by policy and this prints the DECIDED values. ADVISORY
  ONLY: it writes nothing. You set the properties and wire the edge.

    --title T        the ticket's title (at most 300 characters are sent)
    --body-file F    a file holding the ticket's body. Only this path is read;
                     at most 2,000 characters are sent (stderr says when cut).
    --project P      athena | harness | walt_ui | dnd | lms | admiral. The
                     server derives the content domain from it; an unknown
                     project is judged as domain_not_permitted per property.
    --kind K         your Kind: Feature, Bug, Vulnerability, Hardening,
                     Refactor, Test, Flake, Docs or Ops
    --severity S     your Severity: LOW, MEDIUM, HIGH or CRITICAL; `none`
                     only with --kind Feature (a Feature has no Severity)
    --security X     your Security: none, introduced or pre-existing
    --ref DND-N      an existing ticket's id (a reclassification); omit it
                     for a new filing. Not with --epic.
    --json           on exit 0, print the classification server's result as
                     JSON instead of lines. Not with --epic.
    --lines-out FILE also write the Jev lines printed (the "Jev
                     classification:" line, and with --epic the "Jev path:"
                     line), byte for byte, one per line, to FILE (0600;
                     replaced each run). Paste FILE's lines into the ticket
                     body unchanged, then run ticket-provenance-check --ref
                     DND-N --lines-file FILE (DND-1354). On exit 3 with no
                     line printed, FILE is emptied and stderr says so. Not
                     with --json, and never the --body-file.

  For a finding (any Kind but Feature; a Feature's Path is authored). The
  Path part runs after the classification and judges the Kind that is filed:
  the decided Kind, or yours when the classification is unavailable.
    --epic ID        the epic's Notion page id. Its open tickets with Path
                     Critical are read (read-only), by ID ascending, at most
                     #{Blocking::MAX_CANDIDATES}, each with the first #{Blocking::MAX_SUMMARY} characters of its body,
                     and the server decides Path and Blocks.
    --found-while DND-N  the ticket you were working on. With --security
                     introduced it is blocked by rule, never judged.
    --blocks DND-N   the Critical ticket you believe this finding blocks. It
                     must be one of the candidates (else usage, exit 2).

  Output (stdout), exit 0 -- the server's decision, one line per property,
  then its provenance line verbatim (paste that into the ticket body):
    Kind: Bug (jev 0.93)
    Severity: MEDIUM (filer: mode_off)
    Security: none (filer: mode_off)
    Jev classification: {...}
  With --epic, then the candidate count (0 included), Path and Blocks with
  their source, and the path provenance line verbatim (paste it too):
    3 candidates considered (epic <title>, open Critical)
    Path: Blocking (filer: mode_off)
    Blocks: DND-717
    Jev path: {...}
  Set Path, and wire Depends On <-> Blocks onto exactly the printed ticket
  (`Blocks: none` wires no edge onto a Critical ticket).
  The parenthesis is the value's source: `jev <confidence>`, `filer: <reason>`,
  `policy: <reason>` or `rule: introduced_security`. With every mode off (the
  shipped state) each is your own value with `filer: mode_off`, except: a
  Feature's severity is `(none: Feature) (filer: feature)`; a Vulnerability
  filed with Security none is decided `pre-existing (policy:
  vulnerability_floor)`; an unknown project reads `filer: domain_not_permitted`;
  an epic with no open Critical ticket reads `filer: no_candidates`; and
  --security introduced with --found-while blocks that ticket by rule.

  Output, exit 3 -- a part is unavailable. One line ending
  "#{UNAVAILABLE_FIX}", then your own values:
      "COULD NOT REACH SERVER: <why>. #{UNAVAILABLE_FIX}"
      "SERVER REFUSED THE REQUEST: HTTP <status> <error>: <server fix>. #{UNAVAILABLE_FIX}"
      "SERVER FAILED: HTTP <status> <error>. #{UNAVAILABLE_FIX}"   (a 5xx)
      "UNREADABLE SERVER ANSWER: HTTP 200 <what>. #{UNAVAILABLE_FIX}"
      "#{PROG}: UNEXPECTED ERROR: <class>. #{UNAVAILABLE_FIX}"   (a bug here)
    Decided (filer; classification unavailable):
    Kind: Bug
    Severity: MEDIUM
    Security: none
  For the Path part the same lines start "PATH UNAVAILABLE: ", or
      "CANDIDATES UNAVAILABLE: <why>. #{UNAVAILABLE_FIX}"   (the Notion read failed)
  and are followed by
    Decided (filer; path unavailable):
    Path: Blocking
    Blocks: DND-717
  The classification part still prints whatever the Path part does.

  Exit codes:
    0  decided (whatever each value's source)
    1  the decision printed, but --lines-out could not be written: never
       paste or check that file; re-run with a new path
    2  usage (nothing was sent)
    3  a part is unavailable; file that part with your own values

  The Athena server URL is the origin of the `athena` MCP entry in
  ~/.claude.json and its token is read from
  ~/.config/athena-inbox-client/config.json, fed to curl on stdin, never
  argv. The Notion token is the file the notion-personal MCP entry names.
  Environment (optional): ATHENA_INBOX_CLIENT_CONFIG, FLEET_CLAUDE_JSON,
  TICKET_CLASSIFY_MAX_TIME_S (per request, default 60),
  TICKET_CLASSIFY_NOTION_API (a loopback URL, for tests),
  TICKET_CLASSIFY_PACE_S (seconds between Notion reads, default 0.34).
EOF

# A failure that ends a part: exit `code`, printing `line` (stdout for the
# unavailable lines a filer pastes, stderr for usage).
class Failure < StandardError
  attr_reader :code, :stream

  def initialize(code, line, stream: :stdout)
    super(line)
    @code = code
    @stream = stream
  end
end

def usage!(what, fix)
  raise Failure.new(2, "#{PROG}: #{what}. Fix: #{fix}", stream: :stderr)
end

def server_unreachable!(why)
  raise Failure.new(3, "COULD NOT REACH SERVER: #{why}. #{UNAVAILABLE_FIX}")
end

def server_refused!(status, error, fix)
  detail = [error, fix].compact.join(": ")
  raise Failure.new(3, "SERVER REFUSED THE REQUEST: HTTP #{status}#{detail.empty? ? '' : " #{detail}"}. #{UNAVAILABLE_FIX}")
end

def unreadable!(what)
  raise Failure.new(3, "UNREADABLE SERVER ANSWER: HTTP 200 #{what}. #{UNAVAILABLE_FIX}")
end

def candidates_unavailable!(why)
  raise Failure.new(3, "CANDIDATES UNAVAILABLE: #{why}. #{UNAVAILABLE_FIX}")
end

# ── DOMAIN (pure) ────────────────────────────────────────────────────────────

# Classify (the value sets, filer checks, request body, answer check and
# rendering) lives in ../lib/classify.rb, shared with ticket-reclassify.
# Blocking (candidate choice, summaries, the blocking request, answer check
# and rendering) lives in ../lib/blocking.rb.

# ── EFFECTS ──────────────────────────────────────────────────────────────────

module Effects
  module_function

  def read_body_file(path)
    usage!("--body-file #{path} does not exist", "pass the path of a file holding the ticket's body") unless File.exist?(path)
    usage!("--body-file #{path} is not a readable file", "check its permissions") unless File.file?(path) && File.readable?(path)
    File.read(path, encoding: "UTF-8").scrub
  end

  # post(path, body) -> {curl_rc:, status:, body:}, or server_unreachable!.
  def post(path, body)
    origin, token = AthenaServer.endpoint
    AthenaServer.post_json(origin, token, path, body, max_time: AthenaServer.max_time("TICKET_CLASSIFY_MAX_TIME_S"))
  rescue AthenaServer::Unreachable => e
    server_unreachable!(e.message)
  rescue AthenaServer::UnsafeValue => e
    # Nothing was sent: the server cannot be used with this configuration.
    server_unreachable!(e.message)
  end

  def pace
    value = ENV["TICKET_CLASSIFY_PACE_S"].to_s
    /\A\d{1,2}(\.\d{1,3})?\z/.match?(value) ? value.to_f : 0.34
  end

  # epic_candidates(epic_id) -> {chosen: [{ref, page_id, title, summary}],
  # open:, epic_title:}, read only through NotionRead; or
  # candidates_unavailable! naming what failed. Never an empty list for a
  # failed read.
  def epic_candidates(epic_id)
    origin, token = NotionRead.credentials(ENV["TICKET_CLASSIFY_NOTION_API"])
    epic_title = verified_epic_title(origin, token, epic_id)

    rows = NotionRead.query_all(origin, token, TICKETS_DATA_SOURCE, pace: pace, filter: Blocking.query_filter(epic_id)["filter"])
    chosen = Blocking.candidates(rows)
    with_summaries = chosen[:chosen].map do |c|
      page = NotionRead.read(origin, token, "GET", "/v1/blocks/#{c[:page_id]}/children?page_size=100", pace: pace)
      candidates_unavailable!("the block list of #{c[:ref]} has no results array") unless page.is_a?(Hash) && page["results"].is_a?(Array)

      c.merge(summary: Blocking.summary(page["results"]))
    end
    { chosen: with_summaries, open: chosen[:open], epic_title: epic_title }
  rescue NotionRead::Error => e
    candidates_unavailable!("#{e.message} (#{e.fix.sub(/\.\z/, '')})")
  rescue ArgumentError => e
    candidates_unavailable!("a tracker row could not be read: #{e.message}")
  rescue Failure
    raise
  rescue StandardError => e
    candidates_unavailable!("an unexpected #{e.class} reading the candidates")
  end

  # The epic page must be a live page of DND Epics: a wrong id would
  # otherwise read as an epic with 0 candidates.
  def verified_epic_title(origin, token, epic_id)
    page = NotionRead.page(origin, token, epic_id, pace: pace)
    begin
      Blocking.epic_title(page, EPICS_DATA_SOURCE)
    rescue ArgumentError => e
      candidates_unavailable!(e.message)
    end
  end
end

# ── MANAGER ──────────────────────────────────────────────────────────────────

module Manager
  module_function

  def run(opts, out, err)
    body = Effects.read_body_file(opts[:body_file])
    note_truncation(err, "--title", opts[:title], Classify::MAX_TITLE)
    note_truncation(err, "--body-file", body, Classify::MAX_BODY)
    path_part = opts[:epic] && Blocking.judged?(opts[:filer][:kind])
    err.puts "#{PROG}: note: --epic is ignored for a Feature; its Path is authored, never judged" if opts[:epic] && !path_part
    # Candidates are read BEFORE anything is sent, so a --blocks outside
    # them is a usage error with nothing sent.
    candidates = path_part ? read_candidates(opts) : nil
    code, decided = classification(opts, body, out)
    return code unless path_part

    # The Path part runs after the classification and keys on the Kind that
    # is filed (DND-1382): the decided Kind, or the filer's when the
    # classification is unavailable.
    kind = Blocking.filed_kind(decided, opts[:filer])
    unless Blocking.judged?(kind)
      err.puts "#{PROG}: note: the decided Kind is #{kind}; its Path is authored, never judged"
      return code
    end
    [code, path(opts, body, candidates, out)].max
  end

  def note_truncation(err, flag, text, max)
    size = Classify.length(text)
    return unless size > max

    err.puts "#{PROG}: note: #{flag} is #{size} characters; the first #{max} were sent [truncated]"
  end

  # read_candidates(opts) -> the epic's candidates, or {unavailable: line}.
  # Raises the usage Failure when --blocks names none of them.
  def read_candidates(opts)
    found = Effects.epic_candidates(opts[:epic])
    claimed = opts[:claimed_blocks]
    refs = found[:chosen].map { |c| c[:ref] }
    if claimed && !refs.include?(claimed)
      usage!("--blocks #{claimed} is not one of the epic's open Critical tickets considered (#{refs.empty? ? 'none' : refs.join(', ')})",
             "name one of them, or omit --blocks (a finding blocks only a planned Critical ticket of its epic)")
    end
    found
  rescue Failure => e
    raise unless e.code == 3

    { unavailable: e.message }
  end

  # classification(opts, body, out) -> [0, the parsed result] or [3, nil],
  # having printed the decision or the unavailable line and the filer's
  # values.
  def classification(opts, body, out)
    request = Classify.request_body(opts[:title], body, opts[:project], opts[:ref], opts[:filer])
    result = Classify.parse_result(answer(Effects.post(ENDPOINT, request), "ticket_classification", "DND-991"), opts[:filer])
    opts[:json] ? out.puts(JSON.generate(result)) : Classify.decision_lines(result).each { |line| out.puts line }
    [0, result]
  rescue ArgumentError => e
    [unavailable(out, "UNREADABLE SERVER ANSWER: HTTP 200 but #{e.message}. #{UNAVAILABLE_FIX}", Classify.fallback_lines(opts[:filer])), nil]
  rescue Failure => e
    raise unless e.code == 3

    [unavailable(out, e.message, Classify.fallback_lines(opts[:filer])), nil]
  rescue StandardError => e
    [unavailable(out, "#{PROG}: UNEXPECTED ERROR: #{e.class}. #{UNAVAILABLE_FIX}", Classify.fallback_lines(opts[:filer])), nil]
  end

  # path(opts, body, candidates, out) -> 0 or 3, having printed the count,
  # the decided Path and Blocks and the path provenance line, or the
  # unavailable line and the filer's Path.
  def path(opts, body, candidates, out)
    filer = path_filer(opts)
    return unavailable(out, candidates[:unavailable], Blocking.fallback_lines(filer)) if candidates[:unavailable]

    out.puts Blocking.considered_line(candidates[:chosen], candidates[:open], candidates[:epic_title])
    request = Blocking.request_body(opts[:title], body, opts[:project], candidates[:chosen], filer)
    refs = candidates[:chosen].map { |c| c[:ref] }
    result = Blocking.parse_result(answer(Effects.post(BLOCKING_ENDPOINT, request), "ticket_blocking", "DND-1057"), refs, filer)
    Blocking.decision_lines(result).each { |line| out.puts line }
    0
  rescue ArgumentError => e
    unavailable(out, "PATH UNAVAILABLE: UNREADABLE SERVER ANSWER: HTTP 200 but #{e.message}. #{UNAVAILABLE_FIX}", Blocking.fallback_lines(filer))
  rescue Failure => e
    raise unless e.code == 3

    unavailable(out, "PATH UNAVAILABLE: #{e.message}", Blocking.fallback_lines(filer))
  rescue StandardError => e
    unavailable(out, "PATH UNAVAILABLE: #{PROG}: UNEXPECTED ERROR: #{e.class}. #{UNAVAILABLE_FIX}", Blocking.fallback_lines(filer))
  end

  def path_filer(opts)
    { security: opts[:filer][:security], found_while: opts[:found_while], claimed_blocks: opts[:claimed_blocks] }
  end

  def unavailable(out, line, fallback)
    out.puts line
    fallback.each { |l| out.puts l }
    3
  end

  # answer(reply, use_case, ticket) -> the parsed 200 body, or raises the
  # unavailable Failure naming why.
  def answer(reply, use_case, ticket)
    server_unreachable!("curl exit #{reply[:curl_rc]} reaching the Athena server") if reply[:curl_rc] != 0

    doc = begin
      JSON.parse(reply[:body])
    rescue JSON::ParserError, EncodingError
      :not_json
    end
    status = reply[:status]
    if status == 200
      unreadable!("with a body that is not JSON") if doc == :not_json
      return doc
    end
    error = doc.is_a?(Hash) && doc["error"].is_a?(String) ? safe_reason(doc["error"]) : nil
    # A 4xx means the server was reached and refused: never "could not reach".
    server_refused!(status, error, "the machine token was rejected; it is owner-issued, never mint one") if status == 401
    server_refused!(status, error, "this server does not serve #{use_case} (#{ticket} not deployed?)") if status == 404
    server_refused!(status, error, safe_fix(doc)) if (400..499).cover?(status)
    # A 5xx: the server was reached and failed. Anything else (no status, a
    # redirect) is a server we could not use.
    raise Failure.new(3, "SERVER FAILED: HTTP #{status}#{error ? " #{error}" : ''}. #{UNAVAILABLE_FIX}") if (500..599).cover?(status)

    server_unreachable!("the Athena server answered HTTP #{status}#{error ? " #{error}" : ''}")
  end

  # A server fix names a field and position, never the caller's text.
  def safe_fix(doc)
    fix = doc.is_a?(Hash) ? doc["fix"] : nil
    fix.is_a?(String) && fix.length <= 400 && !/[[:cntrl:]]/.match?(fix) ? fix.sub(/\.\z/, "") : nil
  end

  def safe_reason(value)
    value.is_a?(String) && /\A[a-z0-9_:]{1,64}\z/.match?(value) ? value : "unrecognized"
  end
end

# ── FRAMEWORK ────────────────────────────────────────────────────────────────

SPEC = {
  "--help" => :switch, "-h" => :switch, "--title" => :value, "--body-file" => :value,
  "--project" => :value, "--kind" => :value, "--severity" => :value, "--security" => :value,
  "--ref" => :value, "--json" => :switch, "--epic" => :value, "--found-while" => :value,
  "--blocks" => :value, "--lines-out" => :value
}.freeze

REQUIRED = [
  ["--title", "pass the ticket's title"],
  ["--body-file", "pass a file holding the ticket's body"],
  ["--project", "pass one of athena, harness, walt_ui, dnd, lms, admiral"],
  ["--kind", "pass the Kind you would file: #{Classify::KINDS.join(', ')}"],
  ["--severity", "pass the Severity you would file: #{Classify::SEVERITIES.join(', ')}, or none with --kind Feature"],
  ["--security", "pass the Security you would file: #{Classify::SECURITIES.join(', ')}"]
].freeze

def parse_options(argv)
  raw = StrictArgv.parse(argv, SPEC)
  REQUIRED.each { |flag, fix| usage!("#{flag} is required", fix) if raw[flag].nil? }
  title = raw["--title"].dup.force_encoding(Encoding::UTF_8).scrub
  # Blank is judged on what is sent: a title blank in its first 300
  # characters would be refused by the server.
  usage!("--title is blank (in the first #{Classify::MAX_TITLE} characters, which are what is sent)", "pass the ticket's title") if Classify.blank?(Classify.truncate(title, Classify::MAX_TITLE))
  usage!("--project is not a project identifier", "pass one of athena, harness, walt_ui, dnd, lms, admiral") unless Classify::PROJECT.match?(raw["--project"])
  usage!("--ref #{raw['--ref']} is not a ticket id", "pass an id such as DND-991, or omit --ref for a new filing") if raw["--ref"] && !Classify::REF.match?(raw["--ref"])
  filer = { kind: raw["--kind"], severity: raw["--severity"], security: raw["--security"] }
  problem = Classify.filer_error(filer)
  usage!(*problem) if problem
  path = path_options(raw)
  { title: title, body_file: raw["--body-file"], project: raw["--project"], ref: raw["--ref"], json: raw["--json"] == true, filer: filer,
    lines_out: lines_out_option(raw) }.merge(path)
rescue StrictArgv::UsageError => e
  usage!(e.message, "run #{PROG} --help for the flags")
rescue Failure
  raise
rescue StandardError => e
  # Before the filer's values are known there is no fallback to print, so
  # this is a usage failure (exit 2), never an exit 3 without them.
  usage!("could not read the arguments (#{e.class})", "run #{PROG} --help for the flags")
end

# lines_out_option(raw) -> the --lines-out path, or nil. Checked before
# anything is sent: the file must be writable, never the body file.
def lines_out_option(raw)
  path = raw["--lines-out"]
  return nil if path.nil?

  usage!("--lines-out with --json", "drop --json; --lines-out writes the lines the plain output prints") if raw["--json"]
  usage!("--lines-out is the --body-file", "pass a separate file; the draft body must not be overwritten") if File.expand_path(path) == File.expand_path(raw["--body-file"])
  dir = File.dirname(File.expand_path(path))
  usage!("--lines-out #{path}: its directory is missing or not writable", "pass a path in a writable directory") unless File.directory?(dir) && File.writable?(dir)
  usage!("--lines-out #{path} is a directory", "pass a file path") if File.directory?(path)
  # An existing file that cannot be replaced would keep an older filing's
  # lines, which the check would then tell the filer to paste.
  usage!("--lines-out #{path} is not writable", "pass a new path, or make it writable") if File.exist?(path) && !File.writable?(path)
  path
end

# path_options(raw) -> {epic:, found_while:, claimed_blocks:}. --found-while
# and --blocks belong to --epic; --epic is a new finding's, never a
# reclassification's (--ref) and never --json's.
def path_options(raw)
  epic_raw = raw["--epic"]
  %w[--found-while --blocks].each { |flag| usage!("#{flag} needs --epic", "pass the epic's Notion page id with --epic") if raw[flag] && epic_raw.nil? }
  return { epic: nil, found_while: nil, claimed_blocks: nil } if epic_raw.nil?

  usage!("--epic with --ref: a reclassification never judges Path", "drop --epic (Path is not reclassified)") if raw["--ref"]
  usage!("--epic with --json", "drop --json; the Path lines are the output") if raw["--json"]
  epic = Blocking.epic_id(epic_raw)
  usage!("--epic #{epic_raw} is not a Notion page id", "pass the epic's page id (32 hex digits, dashed or not)") if epic.nil?
  %w[--found-while --blocks].each do |flag|
    usage!("#{flag} #{raw[flag]} is not a ticket id", "pass an id such as DND-717") if raw[flag] && !Classify::REF.match?(raw[flag])
  end
  { epic: epic, found_while: raw["--found-while"], claimed_blocks: raw["--blocks"] }
end

def main(argv)
  # --help anywhere wins, before anything else runs.
  if argv.include?("--help") || argv.include?("-h")
    $stdout.puts USAGE
    return 0
  end

  opts = nil
  tap = LineTap.new($stdout)
  code = begin
    opts = parse_options(argv)
    Manager.run(opts, tap, $stderr)
  rescue Failure => e
    (e.stream == :stderr ? $stderr : $stdout).puts e.message
    fallback(opts) if e.code == 3
    e.code
  rescue StandardError => e
    $stdout.puts "#{PROG}: UNEXPECTED ERROR: #{e.class}. #{UNAVAILABLE_FIX}"
    fallback(opts)
    3
  end
  # A usage exit sent nothing: leave the file alone. A file that could not
  # be written is exit 1: its content must never be pasted or checked.
  return code unless opts&.dig(:lines_out) && code != 2

  write_lines_out(opts[:lines_out], ProvenanceLines.select(tap.lines)) ? code : 1
end

# LineTap -- stdout that also keeps each line printed, for --lines-out.
class LineTap
  attr_reader :lines

  def initialize(io)
    @io = io
    @lines = []
  end

  def puts(*args)
    args.flatten.each { |a| @lines.concat(a.to_s.split("\n")) }
    @io.puts(*args)
  end
end

# write_lines_out(path, lines) -> true after writing the Jev lines (0600),
# or emptying the file and saying so: a stale line from an earlier run must
# never be checked against this filing. false (said on stderr) when the
# file could not be written.
def write_lines_out(path, lines)
  File.open(path, File::WRONLY | File::CREAT | File::TRUNC, 0o600) { |f| lines.each { |l| f.puts(l) } }
  File.chmod(0o600, path)
  if lines.empty?
    $stderr.puts "#{PROG}: --lines-out: no Jev line was printed (a part was unavailable); #{path} is now empty. " \
                 "Fix: paste the unavailable line printed above into the body instead; there is no line to check"
  end
  true
rescue SystemCallError => e
  $stderr.puts "#{PROG}: --lines-out #{path} could not be written (#{e.class}); never paste or check that file. " \
               "Fix: re-run with a new --lines-out path; the decision printed above stands"
  false
end

# The filer's own values, after an unavailable line: the filer files these.
def fallback(opts)
  Classify.fallback_lines(opts[:filer]).each { |line| $stdout.puts line } if opts
end

exit(main(ARGV)) if $PROGRAM_NAME == __FILE__
