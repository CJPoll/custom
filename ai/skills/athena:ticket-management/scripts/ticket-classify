#!/usr/bin/ruby
# frozen_string_literal: true

# ticket-classify -- the Jev-advised Kind, Severity and Security of a ticket
# about to be filed (DND-1054). Normative home:
# ~/dev/custom/ai/contracts/athena-judgments.md -> *Ticket classification: the
# harness script*. The server is gen_saas Athena.Judgments.TicketClassification
# (POST /api/v1/judgments/ticket_classification, DND-991), which applies the
# policy and returns the DECIDED values. The procedure that runs it is
# athena:ticket-management -> *Filing a ticket* (the Classify bullet).
#
# ADVISORY ONLY. This script has no tracker client: it reads no ticket and
# writes nothing anywhere but the server's own call records. The filer sets
# the properties. It adds no policy of its own; it prints what the server
# decided, or, when the server cannot be used, the filer's own values under a
# heading that says so.
#
# Buckets: DOMAIN (pure: filer checks, the request body, reading and rendering
# the answer), EFFECTS (the body file; the Athena server through
# ../lib/athena_server.rb), MANAGER (validate, post, render) and FRAMEWORK
# (argv).
#
# THE TOKEN NEVER TOUCHES ARGV OR THE ENVIRONMENT: athena_server.rb writes it
# into a curl config that curl reads on STDIN. No token is ever printed.
#
# Deliberately gem-free (stdlib only).

require "json"
require_relative "../../../lib/strict_argv"
require_relative "../lib/athena_server"

PROG = "ticket-classify"
UNAVAILABLE_FIX = "Fix: file the ticket as today; this is advisory."
ENDPOINT = "/api/v1/judgments/ticket_classification"

USAGE = <<~EOF
  Usage: ticket-classify --title T --body-file F --project P
                         --kind K --severity S --security X
                         [--ref DND-N] [--json]
         ticket-classify --help

  The Jev-advised classification of a ticket about to be filed (DND-1054).
  You pass the values you would file; the server decides by policy and this
  prints the DECIDED values. ADVISORY ONLY: it reads no tracker and writes
  nothing. You set the properties.

    --title T        the ticket's title (at most 300 characters are sent)
    --body-file F    a file holding the ticket's body. Only this path is read;
                     at most 2,000 characters are sent (stderr says when cut).
    --project P      athena | harness | walt_ui | dnd | lms | admiral. The
                     server derives the content domain from it; an unknown
                     project is judged as domain_not_permitted per property.
    --kind K         your Kind: Feature, Bug, Vulnerability, Hardening,
                     Refactor, Test, Flake, Docs or Ops
    --severity S     your Severity: LOW, MEDIUM, HIGH or CRITICAL; `none`
                     only with --kind Feature (a Feature has no Severity)
    --security X     your Security: none, introduced or pre-existing
    --ref DND-N      an existing ticket's id (a reclassification); omit it
                     for a new filing
    --json           print the server's result as JSON instead of lines

  Output (stdout), exit 0 -- the server's decision, one line per property,
  then its provenance line verbatim (paste that into the ticket body):
    Kind: Bug (jev 0.93)
    Severity: MEDIUM (filer: mode_off)
    Security: none (filer: mode_off)
    Jev classification: {...}
  The parenthesis is the value's source: `jev <confidence>`, `filer: <reason>`
  or `policy: <reason>`. With every mode off (the shipped state) each is
  `filer: mode_off`: your own values, unchanged.

  Output, exit 3 -- the classification is unavailable. One line ending
  "#{UNAVAILABLE_FIX}", then your own values:
      "COULD NOT REACH SERVER: <why>. #{UNAVAILABLE_FIX}"
      "SERVER REFUSED THE REQUEST: HTTP <status> <error>: <server fix>. #{UNAVAILABLE_FIX}"
      "UNREADABLE SERVER ANSWER: HTTP 200 <what>. #{UNAVAILABLE_FIX}"
    Decided (filer; classification unavailable):
    Kind: Bug
    Severity: MEDIUM
    Security: none

  Exit codes:
    0  decided (whatever each property's source)
    2  usage
    3  unavailable; file the ticket with your own values

  The Athena server URL is the origin of the `athena` MCP entry in
  ~/.claude.json and its token is read from
  ~/.config/athena-inbox-client/config.json, fed to curl on stdin, never
  argv. Environment (optional): ATHENA_INBOX_CLIENT_CONFIG, FLEET_CLAUDE_JSON,
  TICKET_CLASSIFY_MAX_TIME_S (per request, default 60).
EOF

# A failure that ends the run: exit `code`, printing `line` (stdout for the
# unavailable lines a filer pastes, stderr for usage).
class Failure < StandardError
  attr_reader :code, :stream

  def initialize(code, line, stream: :stdout)
    super(line)
    @code = code
    @stream = stream
  end
end

def usage!(what, fix)
  raise Failure.new(2, "#{PROG}: #{what}. Fix: #{fix}", stream: :stderr)
end

def server_unreachable!(why)
  raise Failure.new(3, "COULD NOT REACH SERVER: #{why}. #{UNAVAILABLE_FIX}")
end

def server_refused!(status, error, fix)
  detail = [error, fix].compact.join(": ")
  raise Failure.new(3, "SERVER REFUSED THE REQUEST: HTTP #{status}#{detail.empty? ? '' : " #{detail}"}. #{UNAVAILABLE_FIX}")
end

def unreadable!(what)
  raise Failure.new(3, "UNREADABLE SERVER ANSWER: HTTP 200 #{what}. #{UNAVAILABLE_FIX}")
end

# ── DOMAIN (pure) ────────────────────────────────────────────────────────────

module Classify
  module_function

  # The tracker's values (athena:ticket-management -> *Ticket properties*),
  # in its spelling. The server's input schema holds the same sets.
  KINDS = %w[Feature Bug Vulnerability Hardening Refactor Test Flake Docs Ops].freeze
  SEVERITIES = %w[LOW MEDIUM HIGH CRITICAL].freeze
  SECURITIES = %w[none introduced pre-existing].freeze
  SOURCES = %w[jev filer policy].freeze
  PROPERTIES = { "kind" => "Kind", "severity" => "Severity", "security" => "Security" }.freeze
  PROJECT = /\A[a-z0-9_]{1,32}\z/
  REF = /\A[A-Z]+-[0-9]+\z/
  REASON = /\A[a-z0-9_]{1,64}\z/
  PREFIX = "Jev classification: "
  MAX_TITLE = 300
  MAX_BODY = 2_000
  NO_SEVERITY = "(none: Feature)"

  # filer_error(filer) -> [what, fix] when the filer's three values cannot be
  # sent, or nil.
  def filer_error(filer)
    kind, severity, security = filer.values_at(:kind, :severity, :security)
    severities = "pass one of #{SEVERITIES.join(', ')} (tracker spelling), or none with --kind Feature"
    return ["--kind #{kind} is not a Kind", "pass one of #{KINDS.join(', ')}"] unless KINDS.include?(kind)
    return ["--security #{security} is not a Security value", "pass one of #{SECURITIES.join(', ')}"] unless SECURITIES.include?(security)
    return ["--kind Feature takes --severity none (a Feature has no Severity)", "pass --severity none"] if kind == "Feature" && severity != "none"
    return ["--severity none is only for --kind Feature", severities] if kind != "Feature" && severity == "none"
    return ["--severity #{severity} is not a Severity", severities] unless severity == "none" || SEVERITIES.include?(severity)

    nil
  end

  # blank?(text) -> true for "" and Unicode whitespace only (the server
  # trims Unicode whitespace, so an ASCII-only strip would send a title it
  # refuses).
  def blank?(text)
    text.to_s.gsub(/[[:space:]​﻿]/, "").empty?
  end

  def truncate(text, max)
    text.length > max ? text[0, max] : text
  end

  # request_body(...) -> the closed body the server's schema accepts: the
  # ticket (ref only when given) and the filer's values (`none` severity is
  # null). Nothing else, and no identity field: the owner is the token's.
  def request_body(title, body, project, ref, filer)
    ticket = { "title" => truncate(title, MAX_TITLE), "body" => truncate(body, MAX_BODY), "project" => project }
    ticket["ref"] = ref if ref
    severity = filer[:severity] == "none" ? nil : filer[:severity]
    { "ticket" => ticket, "filer" => { "kind" => filer[:kind], "severity" => severity, "security" => filer[:security] } }
  end

  # parse_result(doc) -> doc, when it is the contract's judged shape; raises
  # ArgumentError naming the first field at fault (never its value).
  def parse_result(doc)
    raise ArgumentError, "is not a JSON object" unless doc.is_a?(Hash)
    raise ArgumentError, "status is not \"judged\"" unless doc["status"] == "judged"

    props = doc["properties"]
    raise ArgumentError, "properties is missing or not an object" unless props.is_a?(Hash)

    PROPERTIES.each_key { |name| check_property(name, props[name]) }
    check_decided(props)
    line = doc["provenance_line"]
    unless line.is_a?(String) && line.start_with?(PREFIX) && !/[[:cntrl:]]/.match?(line)
      raise ArgumentError, "provenance_line is missing, lacks the \"#{PREFIX}\" prefix, or holds a control character"
    end

    doc
  end

  def check_property(name, prop)
    where = "properties.#{name}"
    raise ArgumentError, "#{where} is missing or not an object" unless prop.is_a?(Hash)
    raise ArgumentError, "#{where}.source is not jev, filer or policy" unless SOURCES.include?(prop["source"])
    raise ArgumentError, "#{where}.reason is not an identifier" unless prop["reason"].nil? || (prop["reason"].is_a?(String) && REASON.match?(prop["reason"]))

    judged = prop["judged"]
    return if judged.nil? || (judged.is_a?(Hash) && judged["confidence"].is_a?(Numeric))

    raise ArgumentError, "#{where}.judged has no numeric confidence"
  end

  # The decided values must be the tracker's, and an empty severity is only a
  # Feature's: an empty value is never read as a decision.
  def check_decided(props)
    kind = props["kind"]["decided"]
    raise ArgumentError, "properties.kind.decided is not one of the tracker's values" unless KINDS.include?(kind)
    raise ArgumentError, "properties.security.decided is not one of the tracker's values" unless SECURITIES.include?(props["security"]["decided"])

    severity = props["severity"]["decided"]
    if severity.nil?
      raise ArgumentError, "properties.severity.decided is empty but the decided kind is not Feature" unless kind == "Feature"
    elsif !SEVERITIES.include?(severity)
      raise ArgumentError, "properties.severity.decided is not one of the tracker's values"
    end
  end

  # decision_lines(result) -> one line per property with its source, then the
  # provenance line verbatim.
  def decision_lines(result)
    props = result["properties"]
    PROPERTIES.map { |name, label| "#{label}: #{shown(props[name]['decided'])} (#{source_note(props[name])})" } +
      [result["provenance_line"]]
  end

  def shown(value)
    value.nil? ? NO_SEVERITY : value
  end

  def source_note(prop)
    if prop["source"] == "jev"
      confidence = prop.dig("judged", "confidence")
      confidence.is_a?(Numeric) ? format("jev %.2f", confidence) : "jev"
    else
      prop["reason"] ? "#{prop['source']}: #{prop['reason']}" : prop["source"]
    end
  end

  # fallback_lines(filer) -> the filer's own values under a heading that says
  # the classification was unavailable (never a provenance line).
  def fallback_lines(filer)
    severity = filer[:severity] == "none" ? NO_SEVERITY : filer[:severity]
    ["Decided (filer; classification unavailable):", "Kind: #{filer[:kind]}", "Severity: #{severity}", "Security: #{filer[:security]}"]
  end
end

# ── EFFECTS ──────────────────────────────────────────────────────────────────

module Effects
  module_function

  def read_body_file(path)
    usage!("--body-file #{path} does not exist", "pass the path of a file holding the ticket's body") unless File.exist?(path)
    usage!("--body-file #{path} is not a readable file", "check its permissions") unless File.file?(path) && File.readable?(path)
    File.read(path, encoding: "UTF-8").scrub
  end

  # post(body) -> {curl_rc:, status:, body:}, or server_unreachable!.
  def post(body)
    origin, token = AthenaServer.endpoint
    AthenaServer.post_json(origin, token, ENDPOINT, body, max_time: AthenaServer.max_time("TICKET_CLASSIFY_MAX_TIME_S"))
  rescue AthenaServer::Unreachable => e
    server_unreachable!(e.message)
  rescue AthenaServer::UnsafeValue => e
    raise Failure.new(3, "#{PROG}: #{e.message}. #{UNAVAILABLE_FIX}")
  end
end

# ── MANAGER ──────────────────────────────────────────────────────────────────

module Manager
  module_function

  def run(opts, out, err)
    body = Effects.read_body_file(opts[:body_file])
    note_truncation(err, "--title", opts[:title], Classify::MAX_TITLE)
    note_truncation(err, "--body-file", body, Classify::MAX_BODY)
    request = Classify.request_body(opts[:title], body, opts[:project], opts[:ref], opts[:filer])
    result = classify(Effects.post(request))
    if opts[:json]
      out.puts JSON.generate(result)
    else
      Classify.decision_lines(result).each { |line| out.puts line }
    end
    0
  end

  def note_truncation(err, flag, text, max)
    return unless text.length > max

    err.puts "#{PROG}: note: #{flag} is #{text.length} characters; the first #{max} were sent [truncated]"
  end

  # classify(reply) -> the judged result, or raises the unavailable Failure.
  def classify(reply)
    server_unreachable!("curl exit #{reply[:curl_rc]} reaching the Athena server") if reply[:curl_rc] != 0

    doc = begin
      JSON.parse(reply[:body])
    rescue JSON::ParserError
      :not_json
    end
    status = reply[:status]
    if status == 200
      unreadable!("with a body that is not JSON") if doc == :not_json
      begin
        return Classify.parse_result(doc)
      rescue ArgumentError => e
        unreadable!("but #{e.message}")
      end
    end
    error = doc.is_a?(Hash) && doc["error"].is_a?(String) ? safe_reason(doc["error"]) : nil
    # A 4xx means the server was reached and refused: never "could not reach".
    server_refused!(status, error, "the machine token was rejected; it is owner-issued, never mint one") if status == 401
    server_refused!(status, error, "this server does not serve ticket_classification (DND-991 not deployed?)") if status == 404
    server_refused!(status, error, safe_fix(doc)) if (400..499).cover?(status)
    server_unreachable!("the Athena server answered HTTP #{status}#{error ? " #{error}" : ''}")
  end

  # A server fix names a field and position, never the caller's text.
  def safe_fix(doc)
    fix = doc.is_a?(Hash) ? doc["fix"] : nil
    fix.is_a?(String) && fix.length <= 400 && !/[[:cntrl:]]/.match?(fix) ? fix.sub(/\.\z/, "") : nil
  end

  def safe_reason(value)
    value.is_a?(String) && /\A[a-z0-9_:]{1,64}\z/.match?(value) ? value : "unrecognized"
  end
end

# ── FRAMEWORK ────────────────────────────────────────────────────────────────

SPEC = {
  "--help" => :switch, "-h" => :switch, "--title" => :value, "--body-file" => :value,
  "--project" => :value, "--kind" => :value, "--severity" => :value, "--security" => :value,
  "--ref" => :value, "--json" => :switch
}.freeze

REQUIRED = [
  ["--title", "pass the ticket's title"],
  ["--body-file", "pass a file holding the ticket's body"],
  ["--project", "pass one of athena, harness, walt_ui, dnd, lms, admiral"],
  ["--kind", "pass the Kind you would file: #{Classify::KINDS.join(', ')}"],
  ["--severity", "pass the Severity you would file: #{Classify::SEVERITIES.join(', ')}, or none with --kind Feature"],
  ["--security", "pass the Security you would file: #{Classify::SECURITIES.join(', ')}"]
].freeze

def parse_options(argv)
  raw = StrictArgv.parse(argv, SPEC)
  REQUIRED.each { |flag, fix| usage!("#{flag} is required", fix) if raw[flag].nil? }
  title = raw["--title"].dup.force_encoding(Encoding::UTF_8).scrub
  usage!("--title is blank", "pass the ticket's title") if Classify.blank?(title)
  usage!("--project is not a project identifier", "pass one of athena, harness, walt_ui, dnd, lms, admiral") unless Classify::PROJECT.match?(raw["--project"])
  usage!("--ref #{raw['--ref']} is not a ticket id", "pass an id such as DND-991, or omit --ref for a new filing") if raw["--ref"] && !Classify::REF.match?(raw["--ref"])
  filer = { kind: raw["--kind"], severity: raw["--severity"], security: raw["--security"] }
  problem = Classify.filer_error(filer)
  usage!(*problem) if problem
  { title: title, body_file: raw["--body-file"], project: raw["--project"], ref: raw["--ref"], json: raw["--json"] == true, filer: filer }
rescue StrictArgv::UsageError => e
  usage!(e.message, "run #{PROG} --help for the flags")
end

def main(argv)
  # --help anywhere wins, before anything else runs.
  if argv.include?("--help") || argv.include?("-h")
    $stdout.puts USAGE
    return 0
  end

  opts = nil
  begin
    opts = parse_options(argv)
    Manager.run(opts, $stdout, $stderr)
  rescue Failure => e
    (e.stream == :stderr ? $stderr : $stdout).puts e.message
    fallback(opts) if e.code == 3
    e.code
  rescue StandardError => e
    $stdout.puts "#{PROG}: UNEXPECTED ERROR: #{e.class}. #{UNAVAILABLE_FIX}"
    fallback(opts)
    3
  end
end

# The filer's own values, after an unavailable line: the filer files these.
def fallback(opts)
  Classify.fallback_lines(opts[:filer]).each { |line| $stdout.puts line } if opts
end

exit(main(ARGV)) if $PROGRAM_NAME == __FILE__
