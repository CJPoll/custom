#!/usr/bin/ruby
# frozen_string_literal: true

# unmeasurable -- count the improver runs on which a repo's biggest
# lead-time phase cannot be measured, and escalate its hand-off ticket once
# per episode (DND-1806). A skill-local helper: athena:lead-time-improve
# step 4 calls it on every improve repo.
#
# Buckets: FRAMEWORK (argv, output) and the real alert port here; MANAGER in
# ../lib/unmeasurable_manager.rb; DOMAIN in ../lib/unmeasurable.rb; SIDE
# EFFECTS in ../lib/unmeasurable_store.rb, ../lib/unmeasurable_notion.rb and
# ai/lib/harness-alert-send.sh.
#
# The per-run observe record (DND-1820): observe and ingest-failed write it,
# check reads it; the store is ../lib/unmeasurable_marker.rb. The cron runner
# (scripts/athena-leadtime-run.sh) runs check per improve repo after the
# session, so a session that skips observe is a failed tick.
#
# Deliberately gem-free (stdlib only).

require "json"
require "open3"
require "tempfile"
require_relative "../../../lib/strict_argv"
require_relative "../lib/unmeasurable"
require_relative "../lib/unmeasurable_store"
require_relative "../lib/unmeasurable_manager"
require_relative "../lib/unmeasurable_notion"
require_relative "../lib/unmeasurable_marker"

CHECKOUT = File.expand_path("../../../..", __dir__)
U = LeadTimeUnmeasurable
M = LeadTimeUnmeasurableManager

HELP = <<~TXT
  Usage:
    unmeasurable observe --repo R --run ID --summary-file F
    unmeasurable handoff --repo R --phase P --ticket DND-N
    unmeasurable status [--repo R]
    unmeasurable ingest-failed --repo R --run ID --step ingest|summary --exit N --reason TEXT
    unmeasurable check --repo R --run ID
    unmeasurable --help

  The lead-time improver's escalation for a phase it cannot measure
  (DND-1806). State: <state>/unmeasurable.json, the run count per repo and
  phase (with <state>/unmeasurable.json.lock).

  observe   one run's look at R. F is `ai/bin/lead-time-phases --summary
            --repo R --json`, saved to a file. ID is this run's id (the cron
            lane's run-<utc>-<pid>, from your brief); the same ID twice
            counts once. A phase is unmeasurable when n_na > n. A run counts
            a phase that is unmeasurable and either the biggest or dark (no
            measured row, so it can never be the biggest). A run that does
            not count it holds the count; a measurable run resets it. On a
            counted run with a hand-off ticket recorded, it reads the ticket
            from DND Tickets. At #{U::THRESHOLD} counted runs with the ticket open,
            ONCE per episode: Path = Promoted, a note on the ticket, and ONE
            harness-alerts message (slug #{U::SLUG}, re: a record in
            <state>/runs/). The episode ends when the ticket lands (Done or
            Ready for Release) or the phase becomes measurable. A landed
            ticket that left the phase unmeasurable for #{U::THRESHOLD} more runs is
            NO-HANDOFF: a new hand-off is owed.
  handoff   record the ticket a run handed R's phase off to (P is one of
            #{U::PHASES.join(', ')}). A new ticket opens a new episode.
  status    print the state, as JSON. Read-only.
  ingest-failed
            R has no summary to observe this run: `lead-time-phases
            --ingest` (step ingest) or `--summary` (step summary) exited N,
            not 0. TEXT is its error line. Records that outcome for run ID
            (DND-1820), never an observation. Refused once ID has observed R.
  check     what run ID recorded for R, for the cron runner after the
            session. Read-only. Prints one line:
              observe: repo=R run=ID result=observed exit=E outcomes=O,...
              observe: repo=R run=ID result=ingest-failed step=S exit=N reason="T"
              observe: repo=R run=ID result=observe-failed exit=N reason="T"
              observe: repo=R run=ID result=not-recorded record=<path>
              observe: repo=R run=ID result=could-not-look reason="T"

  The per-run record (DND-1820) is <state>/runs/<ID>.observe.<R>.json, mode
  0600. observe writes it (kind observed, with its exit and outcomes) after
  the count is saved, on exit 0 or 3. An observe that fails before that
  (a refused summary, a state file it cannot read or write: exit 1, 2 or
  3) writes kind observe-failed, with its exit and error, unless this run
  already observed R; the session did call it, so it is never
  not-recorded. ingest-failed writes kind ingest-failed. Only a missing file is
  not-recorded; one that cannot be read, is not JSON, or names another run
  or repo is could-not-look.

  observe prints, per phase it judged:
    unmeasurable: repo=R phase=P runs=N ticket=T status="S" outcome=O
      journal: <the line to put in the run's journal>
  Outcomes: COUNTING, NO-HANDOFF, ESCALATED, ESCALATED-EARLIER,
  HANDOFF-LANDED, HANDOFF-CLOSED, COULD-NOT-LOOK, MEASURABLE, MEASURED,
  NO-ROWS, NO-PHASE.

  Environment:
    LEAD_TIME_STATE_DIR               the state dir (default <main checkout>/ai-artifacts/lead-time)
    LEADTIME_UNMEASURABLE_NOTION_API  a loopback Notion for tests
    LEADTIME_SEND_MAIL                the send-mail to alert with (tests)
    FLEET_CLAUDE_JSON                 where the notion-personal MCP entry is (tests)

  Exit: 0 ok; 1 a tool or state write error, including an observe whose
  count was saved but whose run record could not be written; 2 a usage
  error or a refused input (a summary for another repo, a missing phase, a
  non-DND ticket, an ingest-failed after this run observed R); 3 could not
  look (a ticket Notion could not read or promote, an alert not delivered,
  or a state file or run record that cannot be read). Exit 3 is never
  "already handed off": journal its line as could not look. check alone:
  0 observed, 4 ingest-failed, 6 observe-failed, 5 not-recorded,
  3 could-not-look.
TXT

SPECS = {
  "observe" => { "--repo" => :value, "--run" => :value, "--summary-file" => :value },
  "handoff" => { "--repo" => :value, "--phase" => :value, "--ticket" => :value },
  "status" => { "--repo" => :value },
  "ingest-failed" => { "--repo" => :value, "--run" => :value, "--step" => :value, "--exit" => :value, "--reason" => :value },
  "check" => { "--repo" => :value, "--run" => :value }
}.freeze
REQUIRED = { "observe" => %w[--repo --run --summary-file], "handoff" => %w[--repo --phase --ticket], "status" => [],
             "ingest-failed" => %w[--repo --run --step --exit --reason], "check" => %w[--repo --run] }.freeze
CHECK_EXIT = { observed: 0, ingest_failed: 4, observe_failed: 6, not_recorded: 5, could_not_look: 3 }.freeze

class Refusal < StandardError
  attr_reader :code, :fix

  def initialize(code, message, fix)
    super(message)
    @code = code
    @fix = fix
  end
end

# SIDE EFFECTS: one harness-alerts message through the shared helper
# (ai/lib/harness-alert-send.sh), on the detector side like every other
# harness-alerts sender. -> the delivered name, or raises PortError.
class AlertPort
  def initialize(env)
    @send_mail = env["LEADTIME_SEND_MAIL"].to_s.empty? ? File.join(CHECKOUT, "ai/skills/athena:inbox/bin/send-mail") : env["LEADTIME_SEND_MAIL"]
    @helper = File.join(CHECKOUT, "ai/lib/harness-alert-send.sh")
  end

  def send_alert(slug, record, body)
    Tempfile.create("leadtime-unmeasurable-") do |f|
      File.chmod(0o600, f.path)
      f.write(body)
      f.flush
      # Exit 9: the helper itself would not load (harness_alert_deliver's own
      # codes are 0, 4, 5 and send-mail's).
      script = 'set -u; . "$1" || { echo "cannot load $1" >&2; exit 9; }; shift; harness_alert_deliver "$@"'
      out, err, st = Open3.capture3("bash", "-c", script, "unmeasurable-alert", @helper, @send_mail, CHECKOUT, "20", "3",
                                    "--local", "harness-alerts-detector", slug, "--to", "custom", "--re", record,
                                    "--body-file", f.path, stdin_data: "")
      unless st.success?
        how = st.exitstatus.nil? ? "was killed by signal #{st.termsig}" : "exited #{st.exitstatus}"
        raise M::PortError, "harness-alerts send #{how}: #{err.lines.first(2).join(' ').strip}"
      end

      name = out.lines.last.to_s.strip
      raise M::PortError, "harness-alerts send printed no delivered name" if name.empty?

      name
    end
  end
end

def state_dir(env)
  dir = env["LEAD_TIME_STATE_DIR"].to_s
  return dir unless dir.empty?

  out, st = Open3.capture2e("git", "-C", CHECKOUT, "rev-parse", "--path-format=absolute", "--git-common-dir")
  raise Refusal.new(1, "cannot resolve the state dir: git rev-parse failed in #{CHECKOUT}", "set LEAD_TIME_STATE_DIR, or run from a checkout of ~/dev/custom") unless st.success?

  File.join(File.dirname(out.strip), "ai-artifacts", "lead-time")
end

def manager(env)
  state = state_dir(env)
  raise Refusal.new(1, "the state dir #{state} does not exist", "run from a machine whose lead-time state dir exists, or set LEAD_TIME_STATE_DIR") unless Dir.exist?(state)

  M.new(store: LeadTimeUnmeasurableStore.new(File.join(state, "unmeasurable.json")), runs_dir: File.join(state, "runs"),
        notion: LeadTimeUnmeasurableNotion.new(env: env), alert: AlertPort.new(env),
        markers: LeadTimeObserveMarkers.new(File.join(state, "runs")))
end

def read_summary(path)
  JSON.parse(File.read(path))
rescue SystemCallError => e
  raise Refusal.new(2, "cannot read the summary file #{path}: #{e.message}", "save `ai/bin/lead-time-phases --summary --repo R --json` to a file and pass it")
rescue JSON::ParserError
  raise Refusal.new(2, "the summary file #{path} is not JSON", "pass the output of `ai/bin/lead-time-phases --summary --repo R --json`, read only on its exit 0")
end

def print_line(l)
  status = l[:status] ? %( status="#{l[:status]}") : ""
  puts "unmeasurable: repo=#{l[:repo]} phase=#{l[:phase]} runs=#{l[:runs]} ticket=#{l[:ticket] || 'none'}#{status} outcome=#{l[:outcome]}"
  puts "  journal: #{l[:journal]}"
end

# A value for a key="value" field: one line, with \ and " escaped.
def quote(text)
  %("#{text.to_s.gsub(/[[:cntrl:]]+/, ' ').gsub('\\') { '\\\\' }.gsub('"') { '\\"' }}")
end

# One line for the runner's .run record; -> the check exit.
def print_check(repo, run, chk)
  head = "observe: repo=#{repo} run=#{run}"
  case chk[:result]
  when :observed
    puts "#{head} result=observed exit=#{chk[:exit]} outcomes=#{chk[:outcomes].empty? ? 'none' : chk[:outcomes].join(',')}"
  when :ingest_failed
    puts "#{head} result=ingest-failed step=#{chk[:step]} exit=#{chk[:exit]} reason=#{quote(chk[:reason])}"
  when :observe_failed
    puts "#{head} result=observe-failed exit=#{chk[:exit]} reason=#{quote(chk[:reason])}"
    warn "unmeasurable: run #{run} called observe for #{repo}, and it failed (exit #{chk[:exit]}): #{chk[:reason]}"
    warn "Fix: read the reason; fix what observe refused or could not read or write, and the next run observes again"
  when :not_recorded
    puts "#{head} result=not-recorded record=#{chk[:path]}"
    warn "unmeasurable: run #{run} recorded neither observe nor ingest-failed for #{repo}: there is no #{chk[:path]}"
    warn "Fix: athena:lead-time-improve -> Escalate what stays unmeasurable: every run observes every improve repo, or records ingest-failed for it"
  when :could_not_look
    puts "#{head} result=could-not-look reason=#{quote(chk[:reason])}"
    warn "unmeasurable: could not look at run #{run}'s observe record for #{repo}: #{chk[:reason]}"
    warn "Fix: read or move aside #{chk[:path]} by hand; it is never read as not recorded"
  end
  CHECK_EXIT.fetch(chk[:result])
end

def run(sub, opts, env)
  mgr = manager(env)
  case sub
  when "observe"
    observe(mgr, opts)
  when "ingest-failed"
    mgr.ingest_failed(repo: opts["--repo"], run: opts["--run"], step: opts["--step"], exit_code: opts["--exit"], reason: opts["--reason"])
    puts "unmeasurable: ingest-failed repo=#{opts['--repo']} run=#{opts['--run']} step=#{opts['--step']} recorded"
    0
  when "check"
    print_check(opts["--repo"], opts["--run"], mgr.check(repo: opts["--repo"], run: opts["--run"]))
  when "handoff"
    what = mgr.handoff(repo: opts["--repo"], phase: opts["--phase"], ticket: opts["--ticket"])
    puts "unmeasurable: handoff repo=#{opts['--repo']} phase=#{opts['--phase']} ticket=#{opts['--ticket']} #{what}"
    0
  when "status"
    puts JSON.pretty_generate(mgr.status(repo: opts["--repo"]))
    0
  end
end

OBSERVE_ERRORS = [Refusal, U::Invalid, LeadTimeUnmeasurableStore::Unreadable, LeadTimeObserveMarkers::Unreadable,
                  SystemCallError, JSON::GeneratorError].freeze

# observe, and on its error path the observe-failed record (DND-1820): the
# session did call observe, so the runner must not read it as skipped. The
# error then reaches main's handling as before.
def observe(mgr, opts)
  begin
    result = mgr.observe(repo: opts["--repo"], run: opts["--run"], summary: read_summary(opts["--summary-file"]))
  rescue *OBSERVE_ERRORS => e
    record_observe_failure(mgr, opts, e)
    raise
  end
  result[:lines].each { |l| print_line(l) }
  if result[:code] == 3
    warn "unmeasurable: could not look; journal the COULD-NOT-LOOK line as written, never as already handed off"
    warn "Fix: read the line's reason (a Notion read or write, or the harness-alerts send); the next run retries the step that failed"
  end
  # Exit 1 wins over 3 here: without its record the runner fails the tick,
  # which matters more than the could-not-look the line already says.
  if result[:marker_error]
    warn "unmeasurable: the count was saved, but this run's observe record was not: #{result[:marker_error]}"
    warn "Fix: check the state dir's runs/ is writable and the disk is not full, then run this observe again " \
         "(the same run id counts once); until then the runner reads #{opts['--repo']} as not observed this run"
    return 1
  end
  result[:code]
end

def record_observe_failure(mgr, opts, err)
  code = case err
         when Refusal then err.code
         when U::Invalid then 2
         when LeadTimeUnmeasurableStore::Unreadable, LeadTimeObserveMarkers::Unreadable then 3
         else 1
         end
  what = mgr.observe_failed(repo: opts["--repo"], run: opts["--run"], exit_code: code.to_s, reason: err.message)
  warn "unmeasurable: observe failed (exit #{code}); this run's record says observe-failed (#{what}), so the runner reads it as a failed observe, not a skipped one"
rescue StandardError => e
  warn "unmeasurable: observe failed, and its observe-failed record could not be written either (#{e.message}); " \
       "the runner reads #{opts['--repo']} as not observed this run"
end

def main(argv, env)
  if argv.include?("--help") || argv.include?("-h")
    puts HELP
    return 0
  end
  sub = argv.first
  unless SPECS.key?(sub)
    warn "unmeasurable: usage error: #{sub.nil? ? 'no subcommand' : "unknown subcommand #{sub.inspect}"}"
    warn "Fix: run unmeasurable observe|handoff|status|ingest-failed|check (unmeasurable --help)"
    return 2
  end
  opts = StrictArgv.parse(argv.drop(1), SPECS[sub])
  missing = REQUIRED[sub] - opts.keys
  raise Refusal.new(2, "usage error: #{sub} needs #{missing.join(', ')}", "unmeasurable --help lists each flag") unless missing.empty?

  run(sub, opts, env)
rescue StrictArgv::UsageError => e
  warn "unmeasurable: usage error: #{e.message}"
  warn "Fix: unmeasurable --help lists each subcommand's flags"
  2
rescue Refusal => e
  warn "unmeasurable: #{e.message}"
  warn "Fix: #{e.fix}"
  e.code
rescue U::Invalid => e
  warn "unmeasurable: refused: #{e.message}"
  warn "Fix: pass the summary for this repo (lead-time-phases --summary --repo R --json, on its exit 0), a DND ticket, a phase, " \
       "and for ingest-failed a step, the tool's non-zero exit and its error line, as unmeasurable --help lists; nothing was counted or recorded"
  2
rescue LeadTimeUnmeasurableStore::Unreadable => e
  warn "unmeasurable: could not look: #{e.message}"
  warn "Fix: repair or move that file aside by hand (it holds the run counts); this tool never reads it as empty"
  3
rescue LeadTimeObserveMarkers::Unreadable => e
  warn "unmeasurable: could not look: #{e.message}"
  warn "Fix: read or move aside that observe record (runs/<run id>.observe.<repo>.json) by hand; it is never read as not recorded"
  3
rescue SystemCallError, JSON::GeneratorError => e
  warn "unmeasurable: #{e.class}: #{e.message}"
  warn "Fix: check the state dir and its files are readable and writable, then re-run"
  1
end

exit(main(ARGV, ENV)) if $PROGRAM_NAME == __FILE__
