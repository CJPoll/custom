#!/usr/bin/ruby
# frozen_string_literal: true

# experiment -- record and judge athena:lead-time-improve's before/after
# experiments (DND-1478; design: ai/docs/lead-time-improver.md ->
# *The improvement procedure*). A skill-local helper: only that skill uses it.
#
#   record  one landed change or instrumentation change, with its baseline;
#           --change-repo for a change that landed in another repo (DND-1528)
#   judge   every pending experiment of a repo: keep | revert | pending |
#           inconclusive, with the before/after numbers; appends a status
#           row only when the verdict changed (re-running is idempotent);
#           and every owed revert: `reverted` once main carries it; a change
#           another experiment's Lead-time-experiment trailer on the same
#           phase confounds is `confounded` (DND-1529), as is any experiment
#           whose window holds a declared series break (DND-1810)
#   list    every experiment and its latest status
#   decline record that an owed revert will not land because the hard
#           constraint forbids it (DND-1547); only this verb writes `declined`
#   settling  read-only: would a change on a phase landed now get a clean
#           baseline, or would judge confound it (DND-1622)
#
# It reads the lead-time-phases ledger (DND-1477) and git (read-only: is a
# commit on main, reverts on main, which test paths a commit added lines to,
# a commit's message and the trailers on main), and writes only
# <state>/experiments.jsonl.
#
# Buckets: FRAMEWORK (argv, output) and MANAGER (Record, Judge, List, Decline,
# Live, Confound, Breaks, Settling) here;
# DOMAIN in ../lib/experiment.rb; SIDE EFFECTS in ../lib/experiment_store.rb,
# ../lib/experiment_git.rb and ai/lib/lead_time_phases_io.rb (the ledger).
#
# Environment:
#   LEAD_TIME_STATE_DIR        the state dir (default: <main checkout>/ai-artifacts/lead-time);
#                              a run whose brief names another state dir sets it
#   ATHENA_LEADTIME_CONFIG     the repo list (see ai/bin/lead-time-repos --help)
#   LEAD_TIME_EXPERIMENT_NOW   "now", RFC 3339 (tests)
#
# The series-break registry (DND-1810) has no override: it is read as
# landed on the harness repo's main (Breaks).
#
# Exit: 0 ok; 1 a tool or state error; 2 a usage error or a refusal;
# 3 could not look (no ledger; git could not say whether a commit is on main;
# the series-break registry could not be judged; the config could not be
# read); 4 the --repo is configured but skipped on
# this machine.

require "json"
require "time"
require_relative "../../../lib/strict_argv"
require_relative "../../../lib/lead_time_phases"
require_relative "../../../lib/lead_time_phases_io"
require_relative "../../../lib/lead_time_config_io"
require_relative "../../../lib/lead_time_trailer"
require_relative "../lib/experiment"
require_relative "../lib/experiment_store"
require_relative "../lib/experiment_git"

AI_DIR = File.expand_path("../../..", __dir__)
X = LeadTimeExperiment
XG = LeadTimeExperimentGit
TEXT_MAX = 2000

HELP = <<~TXT
  Usage:
    experiment record --repo R [--change-repo C] --phase P --metric M --commit SHA --kind K --hypothesis-file F
    experiment judge --repo R
    experiment list [--repo R]
    experiment decline --repo R --id ID --constraint <safety-checks|bug-fix> --reason-file F
    experiment settling --repo R --phase P [--metric M] [--json]

  Before/after experiments for athena:lead-time-improve (DND-1478), judged
  on the lead-time-phases ledger (ai/bin/lead-time-phases, DND-1477).

  record   Record one LANDED change. --commit is the 40-hex SHA as it landed
           on main (after any rebase); it is refused when git does not show
           it on the repo's main. It also stores the test paths the commit
           added lines to (revert_deletes_tests), or why git could not
           tell, the tools whose inline self-test block gained lines
           (revert_inline_tests, DND-1577; or _na), and the added paths
           it could classify as neither source nor test (revert_unclassified, DND-1634: a test-like layout
           with no test word, such as features/, __mocks__/, fixtures/
           or a *.feature file); record and every revert line name them.
           They hold nothing. The baseline is the last K=10 comparable
           landings before that landing. Refused (exit 2, naming the
           blocking experiment) while a `change` on the same phase is
           pending or owes a revert; `instrumentation` is exempt.
           --change-repo C (DND-1528): the commit landed in repo C, not in
           R (a harness change in custom measured on gen_saas). It must be
           on C's main; the split point is live_at, when it went live
           there: the landed_at (push or merge time) of C's first ledger
           row whose landed commit carries it (live_at_source=ledger), else,
           until such a row is ingested, the committer time of its
           first-parent landing commit (live_at_source=committer, which a
           fast-forward push follows later; judge moves to the ledger time
           once a row carries it). Never the author date. R's landings
           before live_at are the before-set, those after it the after-set;
           no landing is excluded. The row records change_repo, commit,
           live_at and live_at_source; judge and list print them. The test-additions
           read and the owed revert use C's git: a revert is of that commit
           in C. Default: R (same-repo, unchanged).
           The commit must carry the trailer line (DND-1529)
             Lead-time-experiment: <R> <P> <M>
           naming this record's repo, phase and metric, change and
           instrumentation alike; without it record refuses (exit 2), and
           a message git cannot show is exit 3. Records already in the
           store are not re-validated.
           When a same-phase trailer already sits inside the record's
           confound window (as judge computes it from the ledger so far),
           record still records and prints one warning line naming it:
           judge will read the change confounded (DND-1622). The same
           warning names a declared series break on the phase inside that
           window, for instrumentation too (DND-1810). A log or a
           series-break registry it cannot read is a warning too; the
           record stands.
           --phase tail (DND-1613): a product change (R's own CI/CD and
           deploy, lever product) judged on tail, landing -> post-merge run,
           with --metric phase only. A landing counts on tail only when
           lead-time found a post-merge run that concluded (tail_end deploy
           or pipeline, or a nonzero tail on a row ingested before
           tail_end, which only such an end gives); a landing with none
           (tail_end merge), or a 0 on a row ingested before tail_end, is
           excluded with its reason, never a measured 0. --change-repo is
           refused on tail: a tail change lands in R itself. Landings
           worked on another machine (origin foreign)
           count: their tail is read from the forge. Refused (exit 2) when
           none of the config window's last landings has a measured tail;
           exit 3 when none carries tail_end at all. Its revert is a revert
           PR in R through R's own bar (the product lane, DND-1540).
  judge    Judge every pending experiment of the repo and print one line
           per experiment: keep | revert | pending | inconclusive |
           confounded, with the
           before and after n, median and p90 (n/a share for
           instrumentation) and the guards. A REVERT line repeats each run
           until main carries the revert; judge then records `reverted`.
           A revert of a commit that added test lines (a test/, tests/, spec/
           or __tests__/ path, a *_test.*, *.spec.* or *.self-test.sh file;
           DND-1630; or lines inside a tool's own inline self-test block,
           DND-1577), or one where git could not tell, prints
           REVERT HELD instead (DND-1549): a plain git revert would delete
           the tests, so the Fix names a partial revert (which keeps git's
           "This reverts commit <sha>." line, so judge still records
           `reverted`) or decline. The status stays revert; a fresh revert's
           status row carries `held`; the tally counts held on its own.
           Every revert line, held or not, also names the commit's
           unclassified additions (DND-1634; see record), which hold
           nothing.
           A pending change is CONFOUNDED (DND-1529) when another commit
           on the harness repo's main (custom, the runner's own repo; and
           R's main when R is another repo) carries a Lead-time-experiment
           trailer for the same phase, from any machine and any measured
           repo, committed inside the window: the before-set's first
           landing to the after-set's last. Its own commit and a revert of
           it do not count. Instrumentation is exempt both ways, as it is
           from the one-pending-change rule: an na_share trailer confounds
           nothing, and no trailer confounds an instrumentation experiment
           (a series break does: see A DECLARED SERIES BREAK). The line
           names each
           other commit; the status is recorded, terminal, and treated as
           inconclusive: never keep, never revert. A log that cannot be
           read is exit 3, never "no confounder"; nothing is written.
           It reads origin/main as this clone last fetched it: a trailer
           pushed since is not seen until the next fetch (a missed
           confounder, never a wrong one). A REVERT line names the trailer
           line its revert lands with, and, for a product change (on tail,
           or one that landed in a repo other than the harness repo), that
           it lands as a revert PR in that repo through its own bar.
           A DECLARED SERIES BREAK confounds too (DND-1810): a landing that
           changed how a phase is measured, declared in the registry
           ai/config/lead-time-series-breaks.json (the one place to declare
           one), read as LANDED on the harness repo's main, never from a
           working tree: an unlanded row is named as pending and applies
           to nothing. One whose phases name the experiment's phase and whose
           landing (the committer time of its first-parent landing on the
           harness repo's main) is inside the window makes the verdict
           CONFOUNDED, naming the break. Instrumentation is NOT exempt: a
           break changes what n/a means, which is what na_share compares.
           A revert a worse guard drove stands: a guard is read from
           counters, not from the phase, so the REVERT line names the
           break and the revert is still owed.
           Judge also re-checks every settled keep and every owed revert
           not yet on main against the registry, so a break declared after
           the verdict re-marks it confounded through judge's own append.
           A registry that cannot be read, is not JSON, is malformed, names
           an unknown phase, or names a commit that is not on main is exit
           3 ("could not judge"), never "no break"; nothing is written. The
           summary names the registry and how many breaks it declares.
           Landings inside the window whose metric is n/a are named with
           their reasons and counts ("excluded N landing(s) ..."), never
           read as 0; record prints the same for its baseline (DND-1613).
           On --metric phase and n/a share (not tail), landings worked on
           another machine (origin foreign, DND-1531) are left out of both
           sides, as lead-time-phases --summary leaves them out, and
           counted ("left out N landing(s) worked on another machine"; one
           with an undecided origin counts as before) (DND-1628).
           Appends a status row only when the verdict changed, so a re-run
           with the same inputs writes nothing.
  list     Every experiment and its latest status (DECLINED with its
           constraint and reason; CONFOUNDED with its confounders and
           series breaks).
  decline  Record that an owed revert will not land because the hard
           constraint (ai/blocks/ops/safety-checks.md) outranks the
           experiment rule. Appends one `declined` status row, which is
           terminal and no longer blocks the phase. Judge never writes
           `declined`: only this verb does. Refused (exit 2, nothing
           written) when:
             - the experiment's latest status is not `revert` (pending: not
               judged yet; keep, inconclusive, reverted; or already declined);
             - the revert verdict came from a worse guard (critic BLOCK rate,
               gate red rate, reverts): land the revert, or a fix-forward
               ticketed by an architect. Decline covers a median-only
               revert, never a quality regression;
             - a guard is unmeasured, or the revert row carries no guards:
               only a revert whose guards are all measured and not worse is
               median-only;
             - the id is unknown (the refusal lists the repo's ids);
             - --constraint is not one of the two below, or the reason file
               is missing, empty or not UTF-8.
           A declined experiment is never reported as a gain.
  settling Read-only (DND-1622): before a change on --phase lands, would
           judge confound it? It builds the before-set a change recorded
           now would get (the last K=10 comparable landings of R on the
           metric, default phase) and looks for confounders exactly as
           judge does, in the window from that before-set's first landing
           to now (or to the latest ledgered landing after now, as judge's
           window reaches). One verdict:
             CLEAN     a full before-set and no same-phase trailer in it
             SETTLING  a same-phase trailer (a change or a revert, any
                       measured repo), or a declared series break on the
                       phase (DND-1810), sits inside it: names each one, the
                       comparable landings after the latest, and "clean
                       after N more comparable landings". A change landed
                       now would read confounded.
             SHORT     fewer than K comparable landings: judge cannot settle
                       such a baseline but inconclusive. Any confounder is
                       still named.
           Only CLEAN is a change target (DND-1674): --json carries
           "target" (true only for CLEAN) and the verdict line ends with
           "change target: yes" or "change target: no (<verdict>[, short
           by N])". SHORT is never a target: its before-set is frozen at
           landing, so no later landing can fill it. An unreadable input
           is exit 3 and prints no target.
           A malformed trailer is named, never counted. --metric na_share
           (an instrumentation change) is checked for series breaks only:
           a trailer confounds no instrumentation. Exit 0 for any verdict;
           --json prints the verdict as one JSON object. A log, ledger or
           series-break registry it cannot read is exit 3, never CLEAN.
           Writes nothing.

  Rules (ai/docs/lead-time-improver.md, Decision 8):
    comparable  same repo, improve-mode rows, one row per landing; the
                metric measured (null rows, e.g. landings before a phase's
                emitter, never count); the experiment's own landing
                excluded. A metric with no measured landing before the
                experiment has NO before-set: pending, never a gain. On
                tail, only landings whose post-merge run concluded.
    keep        median down >= 10% (a 0s baseline never qualifies), p90 not
                up, every guard (critic BLOCK rate, gate red rate, reverts on
                main other than reverts of experiments) measured on both
                sides and none worse
    revert      median up, or any guard worse
    pending     a side short of K=10, or neither keep nor revert
    inconclusive  still pending 7 days after it was recorded
    confounded  another experiment's change on the same phase, or a
                declared series break on it (any kind), landed inside the
                window; settled as inconclusive
    instrumentation  keep when its phase's n/a share falls; never reverted
                for a share that did not fall

  Options:
    --repo R             an `improve` repo in this machine's lead-time repo
                         list (ai/bin/lead-time-repos)
    --change-repo C      the repo the commit landed in (default: R). Resolved
                         as ai/bin/lead-time-repos --repo-path C does: a
                         configured repo, or the runner's own repo (custom)
                         even where it is not configured (custom: the basename
                         of the runner's main checkout). Unresolvable: exit 2
    --phase P            implement | verify | queue | integrate | merge | tail
                         (tail takes --metric phase only)
    --metric M           phase | lead | code | counter:<name> | check:<label> | na_share
                         (instrumentation measures na_share; a change does not).
                         check:<label> is one harness-gate check's wall on each
                         landing's gated head, as the gate labels it (DND-1548):
                         record a change whose mechanism is one check on it. A
                         label on none of the config window's landings with
                         check_walls is refused (exit 2, naming the closest
                         labels); no landing with check_walls is exit 3. Judge
                         prints the phase median beside it as context only.
    --commit SHA         the experiment's commit as landed on main (40 hex)
    --kind K             change | instrumentation
    --hypothesis-file F  a UTF-8 text file: what the change should move, and why
    --id ID              an experiment id, as experiment list prints it
    --constraint C       safety-checks: the revert would delete, skip or
                         weaken a check or test; bug-fix: the revert would
                         reinstate a defect the commit fixed
    --reason-file F      a UTF-8 text file: why the revert is declined (the
                         hypothesis file's rules: non-empty, first 2000
                         characters kept)
    --json               settling only: print the verdict as JSON
    --help               this text

  State: <main checkout>/ai-artifacts/lead-time/experiments.jsonl
  (gitignored), or LEAD_TIME_STATE_DIR.
  Series breaks: ai/config/lead-time-series-breaks.json AS LANDED on the
  harness repo's main (origin/main, else main), read out of git, never from
  a working tree; a row only in the local copy is named as pending and not
  applied. Judge's summary names the ref it read.

  Exit: 0 ok; 1 tool or state error; 2 usage error or refusal; 3 could not
  look (no ledger: run ai/bin/lead-time-phases --ingest first; git could
  not say whether the commit is on main, or show its message; a log judge
  or settling reads for confounders could not be read; the series-break
  registry could not be judged; or the config could not be read);
  4 the --repo is configured but skipped on this machine (its checkout is
  missing).
TXT

SPECS = {
  "record" => { "--repo" => :value, "--change-repo" => :value, "--phase" => :value, "--metric" => :value, "--commit" => :value,
                "--kind" => :value, "--hypothesis-file" => :value },
  "judge" => { "--repo" => :value },
  "list" => { "--repo" => :value },
  "decline" => { "--repo" => :value, "--id" => :value, "--constraint" => :value, "--reason-file" => :value },
  "settling" => { "--repo" => :value, "--phase" => :value, "--metric" => :value, "--json" => :switch },
}.freeze
REQUIRED = {
  "record" => %w[--repo --phase --metric --commit --kind --hypothesis-file],
  "judge" => %w[--repo],
  "list" => [],
  "decline" => %w[--repo --id --constraint --reason-file],
  "settling" => %w[--repo --phase],
}.freeze

class Refusal < StandardError
  attr_reader :code, :fix

  def initialize(code, what, fix)
    super(what)
    @code = code
    @fix = fix
  end
end

def refuse(code, what, fix) = raise(Refusal.new(code, what, fix))

def fmt(sec) = sec.nil? ? "n/a" : "#{sec}s"

def short(sha) = sha.to_s[0, 12]

# ── MANAGER: shared setup ────────────────────────────────────────────────────

module Setup
  module_function

  def now(env)
    raw = env["LEAD_TIME_EXPERIMENT_NOW"].to_s
    raw.empty? ? Time.now.utc : Time.iso8601(raw).utc
  rescue ArgumentError
    refuse(2, "LEAD_TIME_EXPERIMENT_NOW=#{raw.inspect} is not RFC 3339", "unset it, or give an RFC 3339 time")
  end

  # The one lead-time repo resolution (DND-1526). A caller that also needs
  # its window (DND-1548) resolves once and passes it to repo/improve_repo.
  def resolution(env) = config { LeadTimeConfigIO.resolve(env) }

  def repo(env, name, res = nil) = config { (res || resolution(env)).find(name) }

  def config
    yield
  rescue LeadTimeConfig::Skipped => e
    refuse(4, e.message, e.fix)
  rescue LeadTimeConfig::CouldNotLook => e
    refuse(3, "could not look: #{e.message}", e.fix)
  rescue LeadTimeConfig::Error => e
    refuse(2, "config: #{e.message}", e.fix)
  end

  # A change repo's path (DND-1528), as lead-time-repos --repo-path prints
  # it. Unresolvable is exit 2; could not look is exit 3.
  def change_repo_path(res, name)
    LeadTimeConfigIO.repo_path(res, name)
  rescue LeadTimeConfig::CouldNotLook => e
    refuse(3, "could not look: change repo: #{e.message}", e.fix)
  rescue LeadTimeConfig::Error => e
    refuse(2, "change repo: #{e.message}", e.fix)
  end

  def improve_repo(env, name, res = nil)
    r = repo(env, name, res)
    return r if r.mode == "improve"

    refuse(2, "repo #{name} is in #{r.mode} mode; experiments run on improve repos only",
           "pass an improve repo, or move #{name} to improve in this machine's repo list (ai/bin/lead-time-repos names the file)")
  end

  # <main checkout>/ai-artifacts/lead-time, resolved from this tool's own git
  # common dir (absolute), so a worktree's copy reads the one state dir.
  def state_dir(env)
    dir = env["LEAD_TIME_STATE_DIR"].to_s
    return dir unless dir.empty?

    common, why = LeadTimePhasesIO::Git.common_dir(AI_DIR)
    refuse(1, "cannot resolve the state dir: #{why}", "set LEAD_TIME_STATE_DIR, or run from a checkout of ~/dev/custom") unless common
    File.join(File.dirname(common), "ai-artifacts", "lead-time")
  end

  def store(state) = LeadTimeExperimentStore.new(File.join(state, "experiments.jsonl"))

  # The named repo's ledger rows, batches folded once. A missing ledger is
  # "could not look" (exit 3), never "0 landings".
  def ledger_rows(state, name)
    ledger = LeadTimePhasesIO::LedgerStore.new(File.join(state, "ledger.jsonl"))
    unless ledger.exist?
      refuse(3, "could not look: no ledger at #{ledger.path}",
             "run ai/bin/lead-time-phases --ingest --repo #{name} first; this is not an empty ledger")
    end
    rows, bad = ledger.read
    warn "experiment: #{bad} malformed ledger line(s) skipped" if bad.positive?
    LeadTimePhases::Batch.dedupe(rows.select { |r| r["repo"] == name }).first
  rescue SystemCallError => e
    refuse(1, "cannot read #{ledger.path} (#{e.class.name.split('::').last})", "check the state dir's permissions")
  end

  # The folded experiments; every row it could not fold is reported.
  def experiments(rows)
    f = X.fold_all(rows)
    f[:malformed].each do |id, why|
      warn "experiment: record #{id.inspect} is malformed and was not judged: #{why}"
      warn "Fix: correct or remove that line in experiments.jsonl by hand; experiment list shows the rest"
    end
    f[:bad_status].each { |id, st| warn "experiment: #{id}: unknown status #{st.inspect} ignored (known: #{X::STATUSES.join(', ')})" }
    warn "experiment: status row(s) for unknown experiment(s) ignored: #{f[:orphans].join(', ')}" unless f[:orphans].empty?
    f[:experiments]
  end

  def read_store(store)
    rows, bad = store.read
    warn "experiment: #{bad} malformed experiments line(s) skipped" if bad.positive?
    rows
  rescue SystemCallError => e
    refuse(1, "cannot read #{store.path} (#{e.class.name.split('::').last})", "check the state dir's permissions")
  end

  def append(store, &block)
    store.append(&block)
  rescue SystemCallError => e
    refuse(1, "cannot write #{store.path} (#{e.class.name.split('::').last})",
           "check that the state dir exists and is writable; nothing was recorded")
  end

  # A --<what>-file's text: UTF-8, non-empty after strip, the first TEXT_MAX
  # characters kept. Missing, unreadable, empty or not UTF-8 is exit 2.
  def read_text(path, what, empty_fix)
    text = File.read(path, encoding: "UTF-8")
    refuse(2, "the #{what} file #{path} is not valid UTF-8", "save it as UTF-8 text") unless text.valid_encoding?
    text = text.strip
    refuse(2, "the #{what} file #{path} is empty", empty_fix) if text.empty?
    warn "experiment: the #{what} is #{text.size} characters; kept the first #{TEXT_MAX}" if text.size > TEXT_MAX
    text[0, TEXT_MAX]
  rescue SystemCallError => e
    refuse(2, "cannot read the #{what} file #{path} (#{e.class.name.split('::').last})",
           "write the #{what} to a file and pass its path")
  end
end

# ── MANAGER: live_at (DND-1528) ──────────────────────────────────────────────

# When a cross-repo change went live. The change repo's ledger row whose
# landed commit carries it gives the push or merge time (live_at_source
# "ledger"); until one is ingested, the committer time of its first-parent
# landing commit stands in ("committer"), which a fast-forward push follows
# later. A ledger that cannot be read, or a carrier git cannot check, falls
# back too, and says why on stderr.
module Live
  module_function

  # -> {"live_at" => RFC 3339, "live_at_source" => "ledger" | "committer"}
  def resolve(state, change, path, commit, committed_at)
    row, why = carrier(state, change, path, commit, committed_at)
    return { "live_at" => X.at(row).utc.iso8601, "live_at_source" => "ledger" } if row

    warn "experiment: live_at for #{short(commit)} is its committer time on #{change}'s main: #{why}; " \
         "judge uses #{change}'s ledger landing once one carries it"
    { "live_at" => committed_at.utc.iso8601, "live_at_source" => "committer" }
  end

  # -> [ledger row, nil] or [nil, why not]
  def carrier(state, change, path, commit, committed_at)
    rows = change_rows(state, change)
    return [nil, rows] if rows.is_a?(String)

    cands = X.ledger_live_candidates(rows, committed_at: committed_at)
    cands.each do |r|
      src = XG.contains?(path, commit, r["landed_commit"])
      return [nil, "could not look whether #{short(r['landed_commit'])} carries it: #{src.reason}"] if src.could_not_look?
      return [r, nil] if src.items.first
    end
    [nil, "none of #{change}'s #{cands.size} ledger landing(s) since #{(committed_at - X::LIVE_SKEW_S).utc.iso8601} carries it yet"]
  end

  # The change repo's ledger rows, or why they could not be read (a String).
  def change_rows(state, change)
    Setup.ledger_rows(state, change)
  rescue Refusal => e
    "#{change}'s ledger could not be read (#{e.message})"
  end

  # A pending cross-repo experiment recorded on the committer fallback:
  # judge looks again, and splits at the ledger landing once one carries it.
  # The record is not rewritten; the line prints the source used.
  def upgrade(exp, state, repo, res)
    return exp unless X.cross_repo?(exp) && exp["live_at_source"] == "committer"

    committed = LeadTimePhases::Util.time(exp["live_at"])
    path = Judge.in_change_repo(exp, repo, res) { |p| p }
    return exp unless committed && path.is_a?(String)

    row, = carrier(state, exp["change_repo"], path, exp["commit"], committed)
    row ? exp.merge("live_at" => X.at(row).utc.iso8601, "live_at_source" => "ledger") : exp
  end
end

# ── MANAGER: record ──────────────────────────────────────────────────────────

module Record
  module_function

  def run(opts, env)
    now = Setup.now(env)
    res = Setup.resolution(env)
    repo = Setup.improve_repo(env, opts["--repo"], res)
    metric = parse_metric(opts)
    commit = opts["--commit"]
    refuse(2, "--commit #{commit.inspect} is not a 40-hex SHA", "pass the full SHA as landed on main (git rev-parse)") unless X::SHA_RE.match?(commit)
    hypothesis = read_hypothesis(opts["--hypothesis-file"])
    state = Setup.state_dir(env)
    change = opts["--change-repo"] || repo.name
    if (why = X.tail_change_repo_error(metric.phase, repo.name, change))
      refuse(2, why, "record a tail change with --repo #{repo.name} and no --change-repo; a harness change in " \
                     "#{change} is recorded on the harness phase it moves")
    end
    change_path = change == repo.name ? repo.path : Setup.change_repo_path(res, change)
    rows = Setup.ledger_rows(state, repo.name)
    check_label!(rows, metric, repo, res.window) if metric.check?
    tail!(rows, repo, res.window) if metric.tail?
    on_main!(change, change_path, commit)
    trailer!(change, change_path, commit, repo, metric)
    cross = change == repo.name ? {} : { "change_repo" => change }.merge(Live.resolve(state, change, change_path, commit, live_at!(change, change_path, commit)))
    src = XG.numstat(change_path, commit)
    inline = X.inline_fields_from(src) { |file| XG.file_additions(change_path, commit, file) }
    tests = X.layout_fields(src).merge(inline)
    row = build(repo, metric, opts["--kind"], commit, hypothesis, now, rows, cross).merge(tests)
    Setup.append(Setup.store(state)) { |existing| admit!(X.fold(existing), row) }
    xtext = X.cross_text(row)
    puts "experiment: recorded #{row['id']} kind=#{row['kind']} metric=#{row['metric']} phase=#{row['phase']} " \
         "#{xtext ? "#{xtext} " : ''}baseline #{describe_baseline(row['baseline'])}#{describe_tests(tests)}"
    warn_confounded(row, rows, repo, res, now)
    0
  end

  # One warning line when a same-phase trailer, or a declared series break
  # on the phase (DND-1810), already sits inside the record's confound
  # window, as judge computes it from the ledger so far (DND-1622): judge
  # will read it confounded. One in the before-set is what `experiment
  # settling` names before a change lands. The record stands either way:
  # refusing after the landing only leaves an unrecorded change. Judge's own
  # split, sides, window, confounders and breaks. Instrumentation is checked
  # for breaks only, as judge checks it.
  def warn_confounded(row, rows, repo, res, now)
    split = X.split(row, rows)
    boundary = split ? split[:boundary] : now
    metric = X::Metric.parse(row["metric"], phase: row["phase"])
    exclude = split ? split[:exclude] : [row["commit"]]
    from, to = X.window(X.sides(rows, metric: metric, exclude: exclude, boundary: boundary), boundary)
    confs = row["kind"] == "instrumentation" ? [] : X.confounders(row, Confound.commits(repo, res, from), from: from, to: to)[:confounders]
    # The registry read is its own step, so a bad one does not hide a
    # trailer confounder already found.
    brks, unknown = record_breaks(repo, res, row, from, to)
    parts = []
    parts << confs.map { |c| X.confounder_text(c) }.join(", ") unless confs.empty?
    parts << "a declared series break on #{row['phase']}: #{brks.map { |b| X.break_text(b) }.join(', ')}" unless brks.empty?
    unless parts.empty?
      warn "experiment: warning: #{row['id']} will read confounded: #{parts.join('; ')} " \
           "inside its window (the before-set's first landing to the after-set's last)"
    end
    warn "experiment: warning: #{row['id']} is recorded, but whether its baseline is clean is unknown: #{unknown}" if unknown
  rescue StandardError => e
    # The row is already appended: nothing here may change record's exit.
    warn "experiment: warning: #{row['id']} is recorded, but whether its baseline is clean is unknown: #{e.message}"
  end

  # -> [breaks inside the record's window, nil] or [[], why the registry
  # could not be judged].
  def record_breaks(repo, res, row, from, to)
    breaks, = Breaks.load(repo, res)
    [X.breaks_inside(row, breaks, from: from, to: to), nil]
  rescue Refusal => e
    [[], e.message]
  end

  def parse_metric(opts)
    metric = X::Metric.parse(opts["--metric"], phase: opts["--phase"])
    why = X.kind_error(opts["--kind"], metric.name)
    refuse(2, why, "use --kind instrumentation with --metric na_share, or --kind change with a duration metric") if why
    metric
  rescue X::UsageError => e
    refuse(2, e.message, "see experiment --help for the phases and metrics")
  end

  # A check:<label> that matches no check is the failed-lookup class: it
  # would judge nothing for 7 days. Refuse it unless the label ran on at
  # least one of the window's landings that carry check_walls.
  def check_label!(rows, metric, repo, window)
    err = X.check_label_error(rows, metric.check_label, window: window)
    return unless err

    if err[:state] == :could_not_look
      refuse(3, "could not look: none of #{repo.name}'s #{rows.size} ledgered landing(s) carries a non-empty check_walls " \
                "(rows ingested before DND-1548 have none), so check #{metric.check_label.inspect} cannot be looked up",
             "run ai/bin/lead-time-phases --ingest --repo #{repo.name} after a landing whose gate ran; " \
             "this is not an unknown label")
    end
    refuse(2, "check #{metric.check_label.inspect} appears on none of #{err[:n]} landings with check_walls " \
              "(the last #{window}); closest: #{err[:closest].map(&:inspect).join(', ')}",
           "copy the label exactly from harness-gate's timings.jsonl ($XDG_STATE_HOME/athena/harness-gate/, " \
           "default ~/.local/state/athena/harness-gate/; " \
           "its \"label\" field) or the gate's output, then re-run record")
  end

  # A tail experiment on a repo where no recent landing has a measured tail
  # (no post-merge run concluded) would judge nothing for 7 days and block
  # tail meanwhile: refuse it (DND-1613). Rows that predate tail_end are
  # could not look, never "no post-merge CI".
  def tail!(rows, repo, window)
    err = X.tail_error(rows, window: window)
    return unless err

    if err[:state] == :could_not_look
      refuse(3, "could not look: none of #{repo.name}'s last #{window} landing(s) (#{err[:n]} in the ledger window) " \
                "carries lead-time's end kind (tail_end, DND-1532), so a 0 tail cannot be told from a landing with " \
                "no post-merge run",
             "run ai/bin/lead-time-phases --ingest --repo #{repo.name} after a landing; this is not a repo without " \
             "post-merge CI")
    end
    reasons = err[:reasons].map { |r| "#{r['reason']} (#{r['count']})" }.join("; ")
    refuse(2, "none of #{repo.name}'s last #{window} landing(s) has a measured tail (#{err[:n]} read: #{reasons}), " \
              "so a change on tail cannot be judged there",
           "record a change on tail only in a repo whose post-merge runs conclude (lead-time-phases --summary: " \
           "biggest.tail_candidate); otherwise work the largest measurable phase")
  end

  def read_hypothesis(path) = Setup.read_text(path, "hypothesis", "write what the change should move, and why")

  # A SHA that is not on main would never appear in the ledger and would
  # block its phase for 7 days as "not ingested yet": refuse it here.
  # name/path: the repo the commit landed in (the change repo; --repo when
  # it is same-repo).
  def on_main!(name, path, commit)
    src = XG.on_main(path, commit)
    if src.could_not_look?
      refuse(3, "could not look whether #{short(commit)} is on #{name}'s main: #{src.reason}",
             "run from a machine where #{path} is checked out with main fetched")
    end
    return if src.items.first

    refuse(2, "#{short(commit)} is not on #{name}'s main (a pre-rebase SHA, or not landed yet)",
           "record the experiment after it lands, with the SHA as it is on main (git log origin/main)")
  end

  # The commit must carry `Lead-time-experiment: <repo> <phase> <metric>`
  # (DND-1529), so another machine's judge sees this change on its phase.
  # Instrumentation too. Records already in the store are not re-validated.
  def trailer!(name, path, commit, repo, metric)
    src = XG.message(path, commit)
    if src.could_not_look?
      refuse(3, "could not look at #{short(commit)}'s message in #{name}: #{src.reason}",
             "run from a machine where #{path} is checked out with main fetched")
    end
    what, fix = X.trailer_error(src.items.first, sha: commit, repo: repo.name, phase: metric.phase, metric: metric.name)
    refuse(2, what, fix) if what
  end

  # The committer time of the commit's first-parent landing on the change
  # repo's main (DND-1528): the earliest it can have gone live, and the
  # fallback live_at (Live.resolve). Never the author date.
  def live_at!(name, path, commit)
    src = XG.landed_at(path, commit)
    if src.could_not_look?
      refuse(3, "could not look when #{short(commit)} landed on #{name}'s main: #{src.reason}",
             "run from a machine where #{path} is checked out with main fetched")
    end
    landing = src.items.first
    unless landing
      refuse(2, "#{short(commit)} has no first-parent landing on #{name}'s main",
             "record the experiment with the SHA as it landed on #{name}'s main (git log --first-parent origin/main)")
    end
    landing.last.utc
  end

  # cross: {} (same-repo), or change_repo and live_at (DND-1528), which the
  # split reads; a same-repo row gains no key.
  def build(repo, metric, kind, commit, hypothesis, now, rows, cross = {})
    split = X.split({ "repo" => repo.name, "commit" => commit }.merge(cross), rows)
    boundary = split ? split[:boundary] : now
    baseline = baseline(rows, metric, split ? split[:exclude] : [commit], boundary, repo)
    baseline["provisional"] = "landing not in the ledger yet: judge recomputes it from the landing time" unless split
    { "type" => "record", "schema" => X::SCHEMA, "id" => X.id_for(repo.name, metric.phase, commit),
      "repo" => repo.name, "phase" => metric.phase, "metric" => metric.name, "kind" => kind, "commit" => commit }
      .merge(cross)
      .merge("hypothesis" => hypothesis, "recorded_at" => now.iso8601, "baseline" => baseline)
  end

  def baseline(rows, metric, exclude, boundary, repo)
    return { "n" => 0, "na_reason" => "0 landings in the ledger for #{repo.name}" } if rows.empty?

    s = X.sides(rows, metric: metric, exclude: exclude, boundary: boundary)
    return { "n" => 0, "na_reason" => s[:before_na] } if s[:before].nil?

    out = X.stats(s[:before], metric).merge("from" => s[:before].first["landed_at"], "to" => s[:before].last["landed_at"])
    ex = X.excluded(rows, metric: metric, exclude: exclude, from: X.at(s[:before].first), to: boundary)
    out = out.merge("excluded" => ex) unless ex.empty?
    fx = X.foreign_excluded(rows, metric: metric, exclude: exclude, from: X.at(s[:before].first), to: boundary)
    fx.zero? ? out : out.merge("foreign_excluded" => fx)
  end

  # What a plain revert of the commit would delete (DND-1549).
  # Plus its unclassified additions (DND-1634), named or n/a.
  def describe_tests(tests)
    paths = (tests["revert_deletes_tests"].to_a + tests["revert_inline_tests"].to_a).uniq.sort
    out = if tests["revert_deletes_tests_na"]
            "; revert_deletes_tests n/a (#{tests['revert_deletes_tests_na']}): a revert verdict on it is held"
          elsif tests["revert_inline_tests_na"]
            "; revert_inline_tests n/a (#{tests['revert_inline_tests_na']}): a revert verdict on it is held"
          elsif paths.empty? then ""
          else "; a plain revert would delete test additions in #{paths.join(', ')}"
          end
    note = X.unclassified_text(tests)
    note ? "#{out}; #{note}" : out
  end

  def describe_baseline(b)
    out = if b["na_reason"] then "n/a (#{b['na_reason']})"
          elsif b.key?("na_share") then "n=#{b['n']} n/a share=#{b['na_share']}"
          else "n=#{b['n']} median=#{fmt(b['median'])} p90=#{fmt(b['p90'])}"
          end
    ex = X.excluded_text(b["excluded"])
    out = "#{out}; #{ex}" if ex
    fx = X.foreign_text(b["foreign_excluded"])
    out = "#{out}; #{fx}" if fx
    b["provisional"] ? "#{out} (provisional: #{b['provisional']})" : out
  end

  # Runs under the store's lock: refuse a duplicate or a blocked phase.
  def admit!(existing, row)
    dup = existing.find { |e| e["id"] == row["id"] }
    refuse(2, "experiment #{row['id']} is already recorded (status #{dup['status']})", "experiment list shows it; record a different commit") if dup
    blocker = X.blocker(existing.select { |e| e["repo"] == row["repo"] }, phase: row["phase"], kind: row["kind"])
    return [row] unless blocker

    state = blocker["status"] == "revert" ? "owes a revert that has not landed" : "is still pending"
    refuse(2, "a change on #{row['phase']} #{state}: #{blocker['id']} (commit #{short(blocker['commit'])}, " \
              "recorded #{blocker['recorded_at']}); two changes on one phase confound each other",
           "let experiment judge settle #{blocker['id']} (land its revert if it owes one), " \
           "or pick another phase, or make this an instrumentation change")
  end
end

# ── MANAGER: confounds (DND-1529) ────────────────────────────────────────────

# Another experiment's change on the same phase, from any machine, inside an
# experiment's window. It reads the trailers on the harness repo's main (the
# runner's own repo, custom: every harness change lands there, whichever
# machine measured it) and, when the measured repo is another, that repo's
# main too (a product-repo change, DND-1540). Either log unreadable is exit
# 3, never "no confounder".
module Confound
  module_function

  # Main may hold a commit a little older than the window by its committer
  # clock; git's --since cut is widened, the domain cuts exactly.
  SLACK_S = 86_400

  # -> [confounder]
  def find(exp, repo, res, from, to)
    found = X.confounders(exp, commits(repo, res, from), from: from, to: to)
    found[:malformed].each do |sha, v, why|
      warn "experiment: #{exp['id']}: #{short(sha)} has a malformed #{LeadTimeTrailer::KEY} trailer #{v.inspect} (#{why}); " \
           "it names no phase, so it is not counted as a confounder"
    end
    found[:confounders]
  end

  # [[sha, Time, message]] from every log a confound reads, since `from`
  # (less SLACK_S). A log it cannot read refuses with exit 3.
  def commits(repo, res, from) = paths(repo, res).flat_map { |name, path| log(name, path, from) }

  # [[name, path]]: the harness repo, then the measured repo when it differs.
  def paths(repo, res)
    own = LeadTimeConfigIO.own_repo
    refuse(3, "could not look for confounders: the harness repo cannot be found: #{own.error}", "run from a checkout of ~/dev/custom") if own.error
    begin
      harness = LeadTimeConfigIO.repo_path(res, own.label, own: own)
    rescue LeadTimeConfig::Error => e
      refuse(3, "could not look for confounders: #{own.label}: #{e.message}", e.fix)
    end
    out = [[own.label, harness]]
    out << [repo.name, repo.path] unless File.expand_path(repo.path) == File.expand_path(harness)
    out
  end

  def log(name, path, from)
    src = XG.trailer_commits(path, (from - SLACK_S).utc.iso8601)
    return src.items unless src.could_not_look?

    refuse(3, "could not look for confounders: #{name}'s log cannot be read: #{src.reason}",
           "run from a machine where #{path} is checked out with main fetched; this is not \"no confounder\"")
  end
end

# ── MANAGER: declared series breaks (DND-1810) ───────────────────────────────

# The registry of landings that changed how a phase is measured
# (ai/config/lead-time-series-breaks.json, the one place a break is
# declared). It is read AS LANDED, out of the harness repo's main
# (origin/main, else main), never from a working tree: a row a lane or a
# branch adds is not applied until it lands, so no unlanded edit can
# confound (and so cancel) a verdict (~/dev/custom/CLAUDE.md -> *A check's
# own bar must not live in the diff it is checking*). A row only in the
# local copy is named as pending. Each break's commit must be on that main;
# its time is the committer time of its first-parent landing there, the
# clock the trailer confound reads. A registry main does not carry, that is
# not JSON, is malformed, or names a commit that is not on main is "could
# not judge" (exit 3), never "no break": a wrongly computed key and a
# registry that declares nothing must not read the same.
module Breaks
  module_function

  REL = "ai/config/lead-time-series-breaks.json"
  LOCAL = File.join(AI_DIR, "config", "lead-time-series-breaks.json")
  FIX = "land a well-formed #{REL} on main (rows of ticket, commit as landed, phases, what), or correct the row " \
        "it names, then fetch main; nothing was judged or written"

  # -> [breaks with "at", where (e.g. "custom's origin/main:<REL>"), pending]
  # pending: "ticket sha12" of each local-copy row main does not carry.
  def load(repo, res)
    name, harness = Confound.paths(repo, res).first
    src = XG.landed_file(harness, REL)
    refuse(3, "could not judge: the series-break registry: #{src.reason}; this is not \"no break\"", FIX) if src.could_not_look?

    text, ref = src.items
    where = "#{name}'s #{ref}:#{REL}"
    breaks, why = X.series_breaks(parse(text, where))
    refuse(3, "could not judge: the series-break registry #{where} is malformed: #{why}; this is not \"no break\"", FIX) if why

    [breaks.map { |b| b.merge("at" => landed!(where, name, harness, b)) }, where, pending(breaks)]
  end

  # load, or the Refusal it raised: each caller applies it where it needs
  # breaks (Judge: a pending verdict re-raises it; a settled one is counted
  # as not re-checked).
  def try_load(repo, res)
    load(repo, res)
  rescue Refusal => e
    e
  end

  def parse(text, where)
    JSON.parse(text)
  rescue JSON::ParserError => e
    refuse(3, "could not judge: the series-break registry #{where} is not JSON (#{e.message.lines.first.to_s.strip[0, 120]}); " \
              "this is not \"no break\"", FIX)
  end

  # The local copy's rows main does not carry (a branch's or a lane's
  # unlanded edit): named, never applied. A local copy that is missing,
  # unreadable or malformed has none to name.
  def pending(landed)
    have = landed.map { |b| [b["ticket"], b["commit"]] }
    local, = X.series_breaks(JSON.parse(File.read(LOCAL, encoding: "UTF-8")))
    (local || []).reject { |b| have.include?([b["ticket"], b["commit"]]) }.map { |b| "#{b['ticket']} #{short(b['commit'])}" }
  rescue SystemCallError, JSON::ParserError
    []
  end

  # The committer time of the break's first-parent landing on the harness
  # repo's main, RFC 3339.
  def landed!(where, name, harness, b)
    what = "series break #{b['ticket']} #{short(b['commit'])} in #{where}"
    on = XG.on_main(harness, b["commit"])
    refuse(3, "could not judge: could not look whether #{what} is on #{name}'s main: #{on.reason}", FIX) if on.could_not_look?
    unless on.items.first
      refuse(3, "could not judge: #{what} is not on #{name}'s main (a wrongly computed key: a pre-rebase SHA, a typo, " \
                "or a main this clone has not fetched)",
             "set its commit to the SHA as landed (git log origin/main), or fetch main; nothing was judged or written")
    end
    src = XG.landed_at(harness, b["commit"])
    refuse(3, "could not judge: could not look when #{what} landed on #{name}'s main: #{src.reason}", FIX) if src.could_not_look?
    landing = src.items.first
    refuse(3, "could not judge: #{what} has no first-parent landing on #{name}'s main", FIX) unless landing

    landing.last.utc.iso8601
  end
end

# ── MANAGER: judge ───────────────────────────────────────────────────────────

module Judge
  module_function

  def run(opts, env)
    now = Setup.now(env)
    res = Setup.resolution(env)
    repo = Setup.improve_repo(env, opts["--repo"], res)
    state = Setup.state_dir(env)
    rows = Setup.ledger_rows(state, repo.name)
    store = Setup.store(state)
    unless store.exist?
      puts "experiment judge: #{repo.name}: no experiments file at #{store.path} (none recorded yet); #{rows.size} landing(s) in the ledger"
      return 0
    end

    all = Setup.experiments(Setup.read_store(store))
    mine = all.select { |e| e["repo"] == repo.name }
    shas = all.map { |e| e["commit"] }
    # Before any write: a registry it cannot read refuses (exit 3).
    # The registry, or the Refusal reading it raised. A pending verdict that
    # needs breaks re-raises it (exit 3, nothing written: verdict); a
    # settled verdict is then not re-checked, and the summary counts it.
    loaded = Breaks.try_load(repo, res)
    refused = loaded.is_a?(Refusal)
    breaks = refused ? loaded : loaded[0]
    if !refused && !loaded[2].empty?
      warn "experiment: #{loaded[2].size} series break row(s) in #{Breaks::LOCAL} are not on main yet, so judge " \
           "does not apply them until they land: #{loaded[2].join(', ')}"
    end
    # Settled verdicts judge cannot re-check (their landing is not in the
    # ledger, or the registry could not be judged): counted in the summary,
    # never read as "no break".
    rechecked = mine.select { |e| X::RECHECKED.include?(e["status"]) }
    unchecked = refused ? rechecked.size : rechecked.count { |e| X.split(e, rows).nil? }
    # [experiment, verdict, phase context (check metrics only; printed, never judged)]
    pending = mine.select { |e| e["status"] == "pending" }.map { |e| Live.upgrade(e, state, repo, res) }
    results = pending.map { |e| [e, *verdict(e, rows, repo, shas, now, res, breaks)] }
    results += mine.select { |e| e["status"] == "revert" }.map { |e| [e, owed(e, repo, res, rows, breaks), nil] }
    # A settled keep re-checked for a break declared after it (DND-1810):
    # listed only when one confounds it.
    results += mine.select { |e| e["status"] == "keep" }.filter_map { |e| (v = broken(e, rows, breaks)) && [e, v, nil] }
    # + the HELD explanation (DND-1549), nil unless a revert verdict is held
    harness = harness_name
    results = results.map { |e, v, ctx| held(e, v, ctx, repo, res, harness: harness) }
    appended = Setup.append(store) { |existing| fresh_rows(existing, results, now) }
    results.each { |e, v, ctx, why, note| puts line(e, v, ctx, why, route: X.revert_route(e, harness: harness), note: note) }
    judged = results.map { |_, v| v["status"] }
    tally = (X::JUDGED - %w[confounded]).map { |s| "#{judged.count(s)} #{s}" }.join(", ")
    declined = mine.count { |e| e["status"] == "declined" }
    held_count = results.count { |_, v| v["held"] }
    puts "experiment judge: #{repo.name}: #{results.size} judged (#{tally}); #{appended.size} status row(s) appended; " \
         "#{rows.size} landing(s) in the ledger; #{declined} declined (a revert the hard constraint forbids; not judged); " \
         "#{held_count} held (a revert whose plain git revert would delete test additions, or could not tell); " \
         "#{judged.count('confounded')} confounded (another experiment's change, or a declared series break, on the same " \
         "phase landed inside the window; treated as inconclusive); #{breaks_text(loaded)}" \
         "#{unchecked.zero? ? '' : "; #{unchecked} settled verdict(s) NOT re-checked for series breaks"}"
    if refused
      warn "experiment: #{loaded.message}"
      warn "Fix: #{loaded.fix}"
    end
    0
  end

  def breaks_text(loaded)
    return "series breaks could not be judged (the registry refused: see stderr)" if loaded.is_a?(Refusal)

    "#{loaded[0].size} series break(s) declared in #{loaded[1]}"
  end

  # A settled verdict (keep, or an owed revert) whose window, recomputed from
  # the ledger, holds a declared break on its phase: the confounded verdict,
  # naming the break and what it read. nil when none does, when a worse
  # guard drove the revert (X.guard_revert?: it stands), or when its landing
  # is no longer in the ledger (counted in judge's summary, never "no break").
  def broken(exp, rows, breaks)
    return nil if breaks.is_a?(Refusal)

    split = X.split(exp, rows)
    return nil unless split

    metric = X::Metric.parse(exp["metric"], phase: exp["phase"])
    from, to = X.window(X.sides(rows, metric: metric, exclude: split[:exclude], boundary: split[:boundary]), split[:boundary])
    found = X.breaks_inside(exp, breaks, from: from, to: to)
    return nil if found.empty?

    v = X.confound(X.last_verdict(exp), [], phase: exp["phase"], breaks: found)
    v["status"] == "confounded" ? v : nil
  end

  # -> [exp, verdict, ctx, why, note]. A revert verdict (fresh or owed) whose
  # commit added test lines, or whose answer is unknown, is held: the
  # verdict gains a `held` field and stays revert; why is the line's text.
  # note (DND-1634): a revert verdict's unclassified additions, named
  # whether or not it is held; it never holds anything.
  def held(exp, v, ctx, repo, res, harness: nil)
    return [exp, v, ctx, nil, nil] unless v["status"] == "revert"

    fields = layout_fields(exp, repo, res)
    note = X.unclassified_text(fields)
    hold = X.hold(v["status"], fields)
    return [exp, v, ctx, nil, note] unless hold

    refusal, = X.decline_error(exp.merge("status" => "revert", "last" => v))
    change = X.cross_repo?(exp) ? exp["change_repo"] : nil
    [exp, v.merge("held" => hold), ctx, X.hold_text(repo.name, exp["id"], exp["commit"], hold, refusal, change_repo: change, trailer: trailer_line(exp),
                                             route: X.revert_route(exp, harness: harness)), note]
  end

  # The harness repo's name (the runner's own repo), which tells a product
  # revert from a harness one (X.revert_route, DND-1613); nil, warned, when
  # it cannot be found: then only a product-lever phase (tail) is routed.
  def harness_name
    own = LeadTimeConfigIO.own_repo
    return own.label unless own.error

    warn "experiment: the harness repo cannot be found (#{own.error}); a revert route is named for tail only"
    nil
  end

  # The revert's trailer line (DND-1529), or nil for a record whose parts do
  # not build one (stored records are not re-validated): warned, never fatal.
  def trailer_line(exp)
    LeadTimeTrailer.line(exp["repo"], exp["phase"], exp["metric"])
  rescue LeadTimeTrailer::Error => e
    warn "experiment: #{exp['id']}: #{e.message}"
    nil
  end

  # Runs a git reader against the repo the experiment's commit landed in:
  # the change repo for a cross-repo experiment (DND-1528), else the repo.
  # A change repo that cannot be resolved now is could not look, never
  # "no revert" or "no tests".
  def in_change_repo(exp, repo, res)
    return yield(repo.path) unless X.cross_repo?(exp)

    path = begin
      LeadTimeConfigIO.repo_path(res, exp["change_repo"])
    rescue LeadTimeConfig::Error => e
      return LeadTimePhases::Source.could_not_look("change repo #{exp['change_repo']} cannot be resolved: #{e.message}")
    end
    yield path
  end

  # The record's revert_deletes_tests, revert_inline_tests (DND-1577) and
  # revert_unclassified (DND-1634) lists; each one missing is computed now from
  # ONE numstat read (plus the inline self-test reads) with the same adapter:
  # for a record written before DND-1549, DND-1577 or DND-1634 (no field), and
  # for one whose git could not look at record time (_na), so a one-off git
  # failure does not hold the revert for good. Still unknown stays _na, which
  # X.hold holds. X.hold reads the tests and inline fields; the unclassified
  # ones feed only the line's text.
  def layout_fields(exp, repo, res)
    tests = exp["revert_deletes_tests"].is_a?(Array)
    inline = exp["revert_inline_tests"].is_a?(Array)
    unclassified = exp["revert_unclassified"].is_a?(Array)
    return exp if tests && inline && unclassified

    src, read = in_change_repo(exp, repo, res) do |path|
      numstat = XG.numstat(path, exp["commit"])
      [numstat, X.inline_fields_from(numstat) { |file| XG.file_additions(path, exp["commit"], file) }]
    end
    # in_change_repo hands back a could-not-look Source when the change repo
    # cannot be resolved; the inline read is then unknown for the same reason.
    read ||= X.inline_fields_from(src)
    (tests ? exp.slice("revert_deletes_tests") : X.deletes_tests_fields(src))
      .merge(inline ? exp.slice("revert_inline_tests") : read)
      .merge(unclassified ? exp.slice("revert_unclassified") : X.unclassified_fields(src))
  end

  # Under the lock: only experiments whose status is still the one judged
  # from (another judge may have settled one meanwhile), and only a changed
  # verdict.
  def fresh_rows(existing, results, now)
    latest = X.fold(existing).to_h { |e| [e["id"], e] }
    results.filter_map do |e, v|
      cur = latest[e["id"]]
      next unless cur && cur["status"] == e["status"]
      next if e["status"] == "revert" && v["status"] == "revert" # still owed: nothing new to record
      next unless X.changed?(cur["last"], v)

      X.status_row(e, v, now)
    end
  end

  # -> [verdict, context]. context: for a check metric, the phase's own
  # stats over the same two sides, else nil. It is printed, never judged.
  def verdict(exp, rows, repo, shas, now, res, breaks)
    split = X.split(exp, rows)
    return [unlanded(exp, repo, now), nil] unless split

    metric = X::Metric.parse(exp["metric"], phase: exp["phase"])
    s = X.sides(rows, metric: metric, exclude: split[:exclude], boundary: split[:boundary])
    v = X.judge(exp, before: s[:before], after: s[:after], guards_before: guards(s[:before], repo, shas),
                     guards_after: guards(s[:after], repo, shas), now: now)
    from, to = X.window(s, split[:boundary])
    # Landings in the window the metric could not compare (DND-1613): named,
    # never read as 0. Printed fresh each run and kept on the status row as
    # written; never judged, and not in X::COMPARED, so a change in it alone
    # appends no row.
    ex = X.excluded(rows, metric: metric, exclude: split[:exclude], from: from, to: to)
    v = v.merge("excluded" => ex) unless ex.empty?
    # Foreign landings the metric left out (DND-1628): counted, named, never judged.
    fx = X.foreign_excluded(rows, metric: metric, exclude: split[:exclude], from: from, to: to)
    v = v.merge("foreign_excluded" => fx) unless fx.zero?
    # Instrumentation is never confounded by a trailer (X.confounders), so
    # its logs are not read; a declared series break confounds every kind.
    confs = exp["kind"] == "instrumentation" ? [] : Confound.find(exp, repo, res, from, to)
    raise breaks if breaks.is_a?(Refusal) # could not judge: exit 3, before any write
    v = X.confound(v, confs, phase: exp["phase"], breaks: X.breaks_inside(exp, breaks, from: from, to: to))
    [v, metric.check? ? X.phase_context(s[:before], s[:after], phase: exp["phase"]) : nil]
  end

  # Not in the ledger: say whether it is on main (ingest lag) or not.
  def unlanded(exp, repo, now)
    v = X.unlanded(exp, now: now)
    src = XG.on_main(repo.path, exp["commit"])
    why = if src.could_not_look? then "could not look whether it is on main: #{src.reason}"
          elsif src.items.first then "it is on main: run lead-time-phases --ingest"
          else "it is NOT on main: recorded with a SHA that never landed (a pre-rebase SHA?)"
          end
    v.merge("reason" => "#{v['reason']}; #{why}")
  end

  # A revert verdict owes a revert until main carries one: the change
  # repo's main for a cross-repo experiment (DND-1528). One not yet landed
  # whose window holds a declared series break (DND-1810) is confounded
  # instead: the verdict compared two measurements, so it is never acted on.
  def owed(exp, repo, res, rows, breaks)
    src = in_change_repo(exp, repo, res) { |path| XG.reverted?(path, exp["commit"]) }
    main = X.cross_repo?(exp) ? "#{exp['change_repo']}'s main" : "main"
    last = exp["last"] || {}
    keep = { "before" => last["before"], "after" => last["after"], "guards" => last["guards"] }
    if !src.could_not_look? && src.items.first
      return { "status" => "reverted", "reason" => "#{main} carries a revert of #{short(exp['commit'])}" }.merge(keep)
    end
    if (v = broken(exp, rows, breaks))
      return v
    end

    seen = src.could_not_look? ? "could not look for it: #{src.reason}" : "#{main} has no revert of it yet"
    { "status" => "revert", "reason" => "REVERT OWED: #{last['reason']}; #{seen}" }.merge(keep)
  end

  def guards(side, repo, shas)
    return nil if side.nil? || side.empty?

    times = side.map { |r| X.at(r) }
    reverts = XG.reverts(repo.path, times.min.iso8601, times.max.iso8601, shas)
    LeadTimePhases::Guards.compute(side, reverts: reverts)
  end

  def side(s)
    return "n/a" if s.nil?
    return "n=#{s['n']} n/a share=#{s['na_share'].nil? ? 'n/a' : s['na_share']}" if s.key?("na_share")

    "n=#{s['n']} median=#{fmt(s['median'])} p90=#{fmt(s['p90'])}"
  end

  # A held revert reads REVERT HELD instead of REVERT / REVERT OWED.
  # route: X.revert_route's text for a product revert (DND-1613), else nil.
  # note: X.unclassified_text for a revert verdict (DND-1634), else nil.
  def line(exp, v, ctx = nil, held_why = nil, route: nil, note: nil)
    g = v["guards"]&.map { |name, d| "#{name} #{d['before'].nil? ? 'n/a' : d['before']}->#{d['after'].nil? ? 'n/a' : d['after']} #{d['state']}" }
    phase = ctx ? " | phase (context, not judged): before #{side(ctx['before'])} | after #{side(ctx['after'])}" : ""
    status = held_why ? "REVERT HELD" : v["status"].upcase
    reason = held_why ? "#{v['reason'].to_s.sub(/\AREVERT OWED: /, 'owed: ')} | #{held_why}" : v["reason"]
    # A revert lands with its experiment's trailer (DND-1529), so another
    # machine sees the phase move back.
    trailer = !held_why && v["status"] == "revert" ? trailer_line(exp) : nil
    if !held_why && v["status"] == "revert" && (trailer || route)
      reason = "#{reason} | land the revert#{route ? " #{route}" : ''}#{trailer ? " with the trailer line `#{trailer}`" : ''}"
    end
    ex = X.excluded_text(v["excluded"])
    reason = "#{reason} | #{ex}" if ex
    fx = X.foreign_text(v["foreign_excluded"])
    reason = "#{reason} | #{fx}" if fx
    reason = "#{reason} | #{note}" if note
    xtext = X.cross_text(exp)
    "experiment: #{exp['id']} #{status} kind=#{exp['kind']} metric=#{exp['metric']}#{xtext ? " #{xtext}" : ''} | " \
      "before #{side(v['before'])} | after #{side(v['after'])} | guards #{g ? g.join(', ') : 'n/a'} | #{reason}#{phase}"
  end
end

# ── MANAGER: list ────────────────────────────────────────────────────────────

module List
  module_function

  def run(opts, env)
    Setup.repo(env, opts["--repo"]) if opts["--repo"]
    store = Setup.store(Setup.state_dir(env))
    unless store.exist?
      puts "experiment list: no experiments file at #{store.path} (none recorded yet)"
      return 0
    end

    all = Setup.experiments(Setup.read_store(store))
    mine = opts["--repo"] ? all.select { |e| e["repo"] == opts["--repo"] } : all
    mine.each { |e| puts line(e) }
    scope = opts["--repo"] ? " for #{opts['--repo']}" : ""
    puts "experiment list: #{mine.size} experiment(s)#{scope} of #{all.size} recorded"
    0
  end

  def line(e)
    b = e["baseline"].is_a?(Hash) ? e["baseline"] : {}
    base = b["na_reason"] ? "n/a (#{b['na_reason']})" : Judge.side(b)
    declined = e["status"] == "declined"
    tag = declined ? " constraint=#{e.dig('last', 'constraint')}" : ""
    was = declined ? " (revert verdict was: #{e.dig('last', 'prior_reason')})" : ""
    xtext = X.cross_text(e)
    confs = e.dig("last", "confounders")
    ctext = confs.is_a?(Array) && !confs.empty? ? " | confounders: #{confs.map { |c| X.confounder_text(c) }.join(', ')}" : ""
    brks = e.dig("last", "breaks")
    btext = brks.is_a?(Array) && !brks.empty? ? " | breaks: #{brks.map { |b| X.break_text(b) }.join(', ')}" : ""
    "experiment: #{e['id']} #{e['status'].upcase}#{tag} kind=#{e['kind']} metric=#{e['metric']}#{xtext ? " #{xtext}" : ''} " \
      "recorded #{e['recorded_at']} | baseline #{base}#{e['last'] ? " | #{e['last']['reason']}#{was}" : ''}#{ctext}#{btext}"
  end
end

# ── MANAGER: decline ─────────────────────────────────────────────────────────

module Decline
  module_function

  def run(opts, env)
    now = Setup.now(env)
    constraint = opts["--constraint"]
    if (why = X.constraint_error(constraint))
      refuse(2, "--constraint: #{why}",
             "safety-checks when the revert would delete, skip or weaken a check or test; " \
             "bug-fix when it would reinstate a defect the commit fixed")
    end
    reason = Setup.read_text(opts["--reason-file"], "reason", "write why the revert is declined")
    repo = Setup.improve_repo(env, opts["--repo"])
    store = Setup.store(Setup.state_dir(env))
    unless store.exist?
      refuse(2, "no experiments file at #{store.path}: nothing to decline", "experiment list shows what is recorded")
    end

    row = Setup.append(store) { |existing| [admit!(existing, repo, opts["--id"], constraint, reason, now)] }.first
    puts "experiment: declined #{row['id']} (constraint #{constraint}); its phase admits a new change. " \
         "Revert verdict kept as prior_reason: #{row['prior_reason']}"
    0
  end

  # Under the store's lock: the experiment's latest status is re-read here,
  # so a judge or another decline that settled it meanwhile is seen.
  def admit!(existing, repo, id, constraint, reason, now)
    mine = X.fold(existing).select { |e| e["repo"] == repo.name }
    exp = mine.find { |e| e["id"] == id }
    unless exp
      ids = mine.map { |e| e["id"] }
      refuse(2, "no experiment #{id.inspect} for #{repo.name} (its ids: #{ids.empty? ? 'none' : ids.join(', ')})",
             "pass an id as experiment list --repo #{repo.name} prints it")
    end
    why, fix = X.decline_error(exp)
    refuse(2, "cannot decline: #{why}", fix) if why

    X.decline_row(exp, constraint: constraint, reason: reason, now: now)
  end
end

# ── MANAGER: settling (DND-1622) ─────────────────────────────────────────────

# Read-only: would a change on --phase landed now be confounded? The verdict
# is the domain's (X.settling); this reads the ledger and the same logs judge
# reads for confounders. Exit 0 for any verdict; could not look is exit 3.
module Settling
  module_function

  def run(opts, env)
    now = Setup.now(env)
    res = Setup.resolution(env)
    repo = Setup.improve_repo(env, opts["--repo"], res)
    metric = opts["--metric"] || "phase"
    phase = opts["--phase"]
    usage { X.settling_metric(phase, metric) } # before any read
    rows = Setup.ledger_rows(Setup.state_dir(env), repo.name)
    from, = X.settling_window(rows, phase: phase, metric: metric, now: now)
    # No trailer confounds instrumentation, so na_share reads no log.
    commits = metric == X::NA_SHARE ? [] : Confound.commits(repo, res, from)
    breaks, = Breaks.load(repo, res)
    s = X.settling(rows, commits, phase: phase, metric: metric, now: now, breaks: breaks)
    puts opts["--json"] ? JSON.generate({ "repo" => repo.name, "now" => now.utc.iso8601 }.merge(s)) : X.settling_text(repo.name, s)
    0
  end

  def usage
    yield
  rescue X::UsageError => e
    refuse(2, e.message, "see experiment --help for the phases and metrics; settling checks a change's duration metric")
  end
end

# ── FRAMEWORK ────────────────────────────────────────────────────────────────

def main(argv, env)
  if argv.include?("--help") || argv.include?("-h")
    puts HELP
    return 0
  end
  sub = argv.first
  unless SPECS.key?(sub)
    warn "experiment: usage error: #{sub.nil? ? 'no subcommand' : "unknown subcommand #{sub.inspect}"}"
    warn "Fix: run experiment record|judge|list|decline|settling (experiment --help)"
    return 2
  end
  opts = StrictArgv.parse(argv.drop(1), SPECS[sub])
  missing = REQUIRED[sub] - opts.keys
  refuse(2, "usage error: #{sub} needs #{missing.join(', ')}", "experiment --help lists each flag") unless missing.empty?
  { "record" => Record, "judge" => Judge, "list" => List, "decline" => Decline, "settling" => Settling }.fetch(sub).run(opts, env)
rescue StrictArgv::UsageError => e
  warn "experiment: usage error: #{e.message}"
  warn "Fix: experiment --help lists each subcommand's flags"
  2
rescue Refusal => e
  warn "experiment: #{e.message}"
  warn "Fix: #{e.fix}"
  e.code
rescue X::UsageError => e
  # A domain invariant tripped past the CLI's own checks (e.g. judge asked to
  # write a status only the decline verb writes): a tool bug, not a usage one.
  warn "experiment: internal error: #{e.message}"
  warn "Fix: nothing was written by the failing step; file a ticket against scripts/experiment with this line"
  1
rescue SystemCallError, JSON::GeneratorError => e
  warn "experiment: #{e.class}: #{e.message}"
  warn "Fix: check the state dir and its files are readable and writable, then re-run"
  1
end

exit(main(ARGV, ENV)) if $PROGRAM_NAME == __FILE__
