#!/usr/bin/ruby
# frozen_string_literal: true

# experiment -- record and judge athena:lead-time-improve's before/after
# experiments (DND-1478; design: ai/docs/lead-time-improver.md ->
# *The improvement procedure*). A skill-local helper: only that skill uses it.
#
#   record  one landed change or instrumentation change, with its baseline;
#           --change-repo for a change that landed in another repo (DND-1528)
#   judge   every pending experiment of a repo: keep | revert | pending |
#           inconclusive, with the before/after numbers; appends a status
#           row only when the verdict changed (re-running is idempotent);
#           and every owed revert: `reverted` once main carries it
#   list    every experiment and its latest status
#   decline record that an owed revert will not land because the hard
#           constraint forbids it (DND-1547); only this verb writes `declined`
#
# It reads the lead-time-phases ledger (DND-1477) and git (read-only: is a
# commit on main, reverts on main, which test paths a commit added lines to),
# and writes only <state>/experiments.jsonl.
#
# Buckets: FRAMEWORK (argv, output) and MANAGER (Record, Judge, List, Decline) here;
# DOMAIN in ../lib/experiment.rb; SIDE EFFECTS in ../lib/experiment_store.rb,
# ../lib/experiment_git.rb and ai/lib/lead_time_phases_io.rb (the ledger).
#
# Environment:
#   LEAD_TIME_STATE_DIR        the state dir (default: <main checkout>/ai-artifacts/lead-time);
#                              a run whose brief names another state dir sets it
#   ATHENA_LEADTIME_CONFIG     the repo list (see ai/bin/lead-time-repos --help)
#   LEAD_TIME_EXPERIMENT_NOW   "now", RFC 3339 (tests)
#
# Exit: 0 ok; 1 a tool or state error; 2 a usage error or a refusal;
# 3 could not look (no ledger; git could not say whether a commit is on main;
# the config could not be read); 4 the --repo is configured but skipped on
# this machine.

require "json"
require "time"
require_relative "../../../lib/strict_argv"
require_relative "../../../lib/lead_time_phases"
require_relative "../../../lib/lead_time_phases_io"
require_relative "../../../lib/lead_time_config_io"
require_relative "../lib/experiment"
require_relative "../lib/experiment_store"
require_relative "../lib/experiment_git"

AI_DIR = File.expand_path("../../..", __dir__)
X = LeadTimeExperiment
XG = LeadTimeExperimentGit
TEXT_MAX = 2000

HELP = <<~TXT
  Usage:
    experiment record --repo R [--change-repo C] --phase P --metric M --commit SHA --kind K --hypothesis-file F
    experiment judge --repo R
    experiment list [--repo R]
    experiment decline --repo R --id ID --constraint <safety-checks|bug-fix> --reason-file F

  Before/after experiments for athena:lead-time-improve (DND-1478), judged
  on the lead-time-phases ledger (ai/bin/lead-time-phases, DND-1477).

  record   Record one LANDED change. --commit is the 40-hex SHA as it landed
           on main (after any rebase); it is refused when git does not show
           it on the repo's main. It also stores the test paths the commit
           added lines to (revert_deletes_tests), or why git could not
           tell. The baseline is the last K=10 comparable landings before
           that landing. Refused (exit 2, naming the
           blocking experiment) while a `change` on the same phase is
           pending or owes a revert; `instrumentation` is exempt.
           --change-repo C (DND-1528): the commit landed in repo C, not in
           R (a harness change in custom measured on gen_saas). It must be
           on C's main; the split point is live_at, when it went live
           there: the landed_at (push or merge time) of C's first ledger
           row whose landed commit carries it (live_at_source=ledger), else,
           until such a row is ingested, the committer time of its
           first-parent landing commit (live_at_source=committer, which a
           fast-forward push follows later; judge moves to the ledger time
           once a row carries it). Never the author date. R's landings
           before live_at are the before-set, those after it the after-set;
           no landing is excluded. The row records change_repo, commit,
           live_at and live_at_source; judge and list print them. The test-additions
           read and the owed revert use C's git: a revert is of that commit
           in C. Default: R (same-repo, unchanged).
  judge    Judge every pending experiment of the repo and print one line
           per experiment: keep | revert | pending | inconclusive, with the
           before and after n, median and p90 (n/a share for
           instrumentation) and the guards. A REVERT line repeats each run
           until main carries the revert; judge then records `reverted`.
           A revert of a commit that added test lines (a test/ path or a
           *.self-test.sh), or one where git could not tell, prints
           REVERT HELD instead (DND-1549): a plain git revert would delete
           the tests, so the Fix names a partial revert (which keeps git's
           "This reverts commit <sha>." line, so judge still records
           `reverted`) or decline. The status stays revert; a fresh revert's
           status row carries `held`; the tally counts held on its own.
           Appends a status row only when the verdict changed, so a re-run
           with the same inputs writes nothing.
  list     Every experiment and its latest status (DECLINED with its
           constraint and reason).
  decline  Record that an owed revert will not land because the hard
           constraint (ai/blocks/ops/safety-checks.md) outranks the
           experiment rule. Appends one `declined` status row, which is
           terminal and no longer blocks the phase. Judge never writes
           `declined`: only this verb does. Refused (exit 2, nothing
           written) when:
             - the experiment's latest status is not `revert` (pending: not
               judged yet; keep, inconclusive, reverted; or already declined);
             - the revert verdict came from a worse guard (critic BLOCK rate,
               gate red rate, reverts): land the revert, or a fix-forward
               ticketed by an architect. Decline covers a median-only
               revert, never a quality regression;
             - a guard is unmeasured, or the revert row carries no guards:
               only a revert whose guards are all measured and not worse is
               median-only;
             - the id is unknown (the refusal lists the repo's ids);
             - --constraint is not one of the two below, or the reason file
               is missing, empty or not UTF-8.
           A declined experiment is never reported as a gain.

  Rules (ai/docs/lead-time-improver.md, Decision 8):
    comparable  same repo, improve-mode rows, one row per landing; the
                metric measured (null rows, e.g. landings before a phase's
                emitter, never count); the experiment's own landing
                excluded. A metric with no measured landing before the
                experiment has NO before-set: pending, never a gain.
    keep        median down >= 10% (a 0s baseline never qualifies), p90 not
                up, every guard (critic BLOCK rate, gate red rate, reverts on
                main other than reverts of experiments) measured on both
                sides and none worse
    revert      median up, or any guard worse
    pending     a side short of K=10, or neither keep nor revert
    inconclusive  still pending 7 days after it was recorded
    instrumentation  keep when its phase's n/a share falls; never reverted
                for a share that did not fall

  Options:
    --repo R             an `improve` repo in this machine's lead-time repo
                         list (ai/bin/lead-time-repos)
    --change-repo C      the repo the commit landed in (default: R). Resolved
                         as ai/bin/lead-time-repos --repo-path C does: a
                         configured repo, or the runner's own repo (custom)
                         even where it is not configured (custom: the basename
                         of the runner's main checkout). Unresolvable: exit 2
    --phase P            implement | verify | queue | integrate | merge
    --metric M           phase | lead | code | counter:<name> | check:<label> | na_share
                         (instrumentation measures na_share; a change does not).
                         check:<label> is one harness-gate check's wall on each
                         landing's gated head, as the gate labels it (DND-1548):
                         record a change whose mechanism is one check on it. A
                         label on none of the config window's landings with
                         check_walls is refused (exit 2, naming the closest
                         labels); no landing with check_walls is exit 3. Judge
                         prints the phase median beside it as context only.
    --commit SHA         the experiment's commit as landed on main (40 hex)
    --kind K             change | instrumentation
    --hypothesis-file F  a UTF-8 text file: what the change should move, and why
    --id ID              an experiment id, as experiment list prints it
    --constraint C       safety-checks: the revert would delete, skip or
                         weaken a check or test; bug-fix: the revert would
                         reinstate a defect the commit fixed
    --reason-file F      a UTF-8 text file: why the revert is declined (the
                         hypothesis file's rules: non-empty, first 2000
                         characters kept)
    --help               this text

  State: <main checkout>/ai-artifacts/lead-time/experiments.jsonl
  (gitignored), or LEAD_TIME_STATE_DIR.

  Exit: 0 ok; 1 tool or state error; 2 usage error or refusal; 3 could not
  look (no ledger: run ai/bin/lead-time-phases --ingest first; git could
  not say whether the commit is on main; or the config could not be read);
  4 the --repo is configured but skipped on this machine (its checkout is
  missing).
TXT

SPECS = {
  "record" => { "--repo" => :value, "--change-repo" => :value, "--phase" => :value, "--metric" => :value, "--commit" => :value,
                "--kind" => :value, "--hypothesis-file" => :value },
  "judge" => { "--repo" => :value },
  "list" => { "--repo" => :value },
  "decline" => { "--repo" => :value, "--id" => :value, "--constraint" => :value, "--reason-file" => :value },
}.freeze
REQUIRED = {
  "record" => %w[--repo --phase --metric --commit --kind --hypothesis-file],
  "judge" => %w[--repo],
  "list" => [],
  "decline" => %w[--repo --id --constraint --reason-file],
}.freeze

class Refusal < StandardError
  attr_reader :code, :fix

  def initialize(code, what, fix)
    super(what)
    @code = code
    @fix = fix
  end
end

def refuse(code, what, fix) = raise(Refusal.new(code, what, fix))

def fmt(sec) = sec.nil? ? "n/a" : "#{sec}s"

def short(sha) = sha.to_s[0, 12]

# ── MANAGER: shared setup ────────────────────────────────────────────────────

module Setup
  module_function

  def now(env)
    raw = env["LEAD_TIME_EXPERIMENT_NOW"].to_s
    raw.empty? ? Time.now.utc : Time.iso8601(raw).utc
  rescue ArgumentError
    refuse(2, "LEAD_TIME_EXPERIMENT_NOW=#{raw.inspect} is not RFC 3339", "unset it, or give an RFC 3339 time")
  end

  # The one lead-time repo resolution (DND-1526). A caller that also needs
  # its window (DND-1548) resolves once and passes it to repo/improve_repo.
  def resolution(env) = config { LeadTimeConfigIO.resolve(env) }

  def repo(env, name, res = nil) = config { (res || resolution(env)).find(name) }

  def config
    yield
  rescue LeadTimeConfig::Skipped => e
    refuse(4, e.message, e.fix)
  rescue LeadTimeConfig::CouldNotLook => e
    refuse(3, "could not look: #{e.message}", e.fix)
  rescue LeadTimeConfig::Error => e
    refuse(2, "config: #{e.message}", e.fix)
  end

  # A change repo's path (DND-1528), as lead-time-repos --repo-path prints
  # it. Unresolvable is exit 2; could not look is exit 3.
  def change_repo_path(res, name)
    LeadTimeConfigIO.repo_path(res, name)
  rescue LeadTimeConfig::CouldNotLook => e
    refuse(3, "could not look: change repo: #{e.message}", e.fix)
  rescue LeadTimeConfig::Error => e
    refuse(2, "change repo: #{e.message}", e.fix)
  end

  def improve_repo(env, name, res = nil)
    r = repo(env, name, res)
    return r if r.mode == "improve"

    refuse(2, "repo #{name} is in #{r.mode} mode; experiments run on improve repos only",
           "pass an improve repo, or move #{name} to improve in this machine's repo list (ai/bin/lead-time-repos names the file)")
  end

  # <main checkout>/ai-artifacts/lead-time, resolved from this tool's own git
  # common dir (absolute), so a worktree's copy reads the one state dir.
  def state_dir(env)
    dir = env["LEAD_TIME_STATE_DIR"].to_s
    return dir unless dir.empty?

    common, why = LeadTimePhasesIO::Git.common_dir(AI_DIR)
    refuse(1, "cannot resolve the state dir: #{why}", "set LEAD_TIME_STATE_DIR, or run from a checkout of ~/dev/custom") unless common
    File.join(File.dirname(common), "ai-artifacts", "lead-time")
  end

  def store(state) = LeadTimeExperimentStore.new(File.join(state, "experiments.jsonl"))

  # The named repo's ledger rows, batches folded once. A missing ledger is
  # "could not look" (exit 3), never "0 landings".
  def ledger_rows(state, name)
    ledger = LeadTimePhasesIO::LedgerStore.new(File.join(state, "ledger.jsonl"))
    unless ledger.exist?
      refuse(3, "could not look: no ledger at #{ledger.path}",
             "run ai/bin/lead-time-phases --ingest --repo #{name} first; this is not an empty ledger")
    end
    rows, bad = ledger.read
    warn "experiment: #{bad} malformed ledger line(s) skipped" if bad.positive?
    LeadTimePhases::Batch.dedupe(rows.select { |r| r["repo"] == name }).first
  rescue SystemCallError => e
    refuse(1, "cannot read #{ledger.path} (#{e.class.name.split('::').last})", "check the state dir's permissions")
  end

  # The folded experiments; every row it could not fold is reported.
  def experiments(rows)
    f = X.fold_all(rows)
    f[:malformed].each do |id, why|
      warn "experiment: record #{id.inspect} is malformed and was not judged: #{why}"
      warn "Fix: correct or remove that line in experiments.jsonl by hand; experiment list shows the rest"
    end
    f[:bad_status].each { |id, st| warn "experiment: #{id}: unknown status #{st.inspect} ignored (known: #{X::STATUSES.join(', ')})" }
    warn "experiment: status row(s) for unknown experiment(s) ignored: #{f[:orphans].join(', ')}" unless f[:orphans].empty?
    f[:experiments]
  end

  def read_store(store)
    rows, bad = store.read
    warn "experiment: #{bad} malformed experiments line(s) skipped" if bad.positive?
    rows
  rescue SystemCallError => e
    refuse(1, "cannot read #{store.path} (#{e.class.name.split('::').last})", "check the state dir's permissions")
  end

  def append(store, &block)
    store.append(&block)
  rescue SystemCallError => e
    refuse(1, "cannot write #{store.path} (#{e.class.name.split('::').last})",
           "check that the state dir exists and is writable; nothing was recorded")
  end

  # A --<what>-file's text: UTF-8, non-empty after strip, the first TEXT_MAX
  # characters kept. Missing, unreadable, empty or not UTF-8 is exit 2.
  def read_text(path, what, empty_fix)
    text = File.read(path, encoding: "UTF-8")
    refuse(2, "the #{what} file #{path} is not valid UTF-8", "save it as UTF-8 text") unless text.valid_encoding?
    text = text.strip
    refuse(2, "the #{what} file #{path} is empty", empty_fix) if text.empty?
    warn "experiment: the #{what} is #{text.size} characters; kept the first #{TEXT_MAX}" if text.size > TEXT_MAX
    text[0, TEXT_MAX]
  rescue SystemCallError => e
    refuse(2, "cannot read the #{what} file #{path} (#{e.class.name.split('::').last})",
           "write the #{what} to a file and pass its path")
  end
end

# ── MANAGER: live_at (DND-1528) ──────────────────────────────────────────────

# When a cross-repo change went live. The change repo's ledger row whose
# landed commit carries it gives the push or merge time (live_at_source
# "ledger"); until one is ingested, the committer time of its first-parent
# landing commit stands in ("committer"), which a fast-forward push follows
# later. A ledger that cannot be read, or a carrier git cannot check, falls
# back too, and says why on stderr.
module Live
  module_function

  # -> {"live_at" => RFC 3339, "live_at_source" => "ledger" | "committer"}
  def resolve(state, change, path, commit, committed_at)
    row, why = carrier(state, change, path, commit, committed_at)
    return { "live_at" => X.at(row).utc.iso8601, "live_at_source" => "ledger" } if row

    warn "experiment: live_at for #{short(commit)} is its committer time on #{change}'s main: #{why}; " \
         "judge uses #{change}'s ledger landing once one carries it"
    { "live_at" => committed_at.utc.iso8601, "live_at_source" => "committer" }
  end

  # -> [ledger row, nil] or [nil, why not]
  def carrier(state, change, path, commit, committed_at)
    rows = change_rows(state, change)
    return [nil, rows] if rows.is_a?(String)

    cands = X.ledger_live_candidates(rows, committed_at: committed_at)
    cands.each do |r|
      src = XG.contains?(path, commit, r["landed_commit"])
      return [nil, "could not look whether #{short(r['landed_commit'])} carries it: #{src.reason}"] if src.could_not_look?
      return [r, nil] if src.items.first
    end
    [nil, "none of #{change}'s #{cands.size} ledger landing(s) since #{(committed_at - X::LIVE_SKEW_S).utc.iso8601} carries it yet"]
  end

  # The change repo's ledger rows, or why they could not be read (a String).
  def change_rows(state, change)
    Setup.ledger_rows(state, change)
  rescue Refusal => e
    "#{change}'s ledger could not be read (#{e.message})"
  end

  # A pending cross-repo experiment recorded on the committer fallback:
  # judge looks again, and splits at the ledger landing once one carries it.
  # The record is not rewritten; the line prints the source used.
  def upgrade(exp, state, repo, res)
    return exp unless X.cross_repo?(exp) && exp["live_at_source"] == "committer"

    committed = LeadTimePhases::Util.time(exp["live_at"])
    path = Judge.in_change_repo(exp, repo, res) { |p| p }
    return exp unless committed && path.is_a?(String)

    row, = carrier(state, exp["change_repo"], path, exp["commit"], committed)
    row ? exp.merge("live_at" => X.at(row).utc.iso8601, "live_at_source" => "ledger") : exp
  end
end

# ── MANAGER: record ──────────────────────────────────────────────────────────

module Record
  module_function

  def run(opts, env)
    now = Setup.now(env)
    res = Setup.resolution(env)
    repo = Setup.improve_repo(env, opts["--repo"], res)
    metric = parse_metric(opts)
    commit = opts["--commit"]
    refuse(2, "--commit #{commit.inspect} is not a 40-hex SHA", "pass the full SHA as landed on main (git rev-parse)") unless X::SHA_RE.match?(commit)
    hypothesis = read_hypothesis(opts["--hypothesis-file"])
    state = Setup.state_dir(env)
    change = opts["--change-repo"] || repo.name
    change_path = change == repo.name ? repo.path : Setup.change_repo_path(res, change)
    rows = Setup.ledger_rows(state, repo.name)
    check_label!(rows, metric, repo, res.window) if metric.check?
    on_main!(change, change_path, commit)
    cross = change == repo.name ? {} : { "change_repo" => change }.merge(Live.resolve(state, change, change_path, commit, live_at!(change, change_path, commit)))
    tests = X.deletes_tests_fields(XG.numstat(change_path, commit))
    row = build(repo, metric, opts["--kind"], commit, hypothesis, now, rows, cross).merge(tests)
    Setup.append(Setup.store(state)) { |existing| admit!(X.fold(existing), row) }
    xtext = X.cross_text(row)
    puts "experiment: recorded #{row['id']} kind=#{row['kind']} metric=#{row['metric']} phase=#{row['phase']} " \
         "#{xtext ? "#{xtext} " : ''}baseline #{describe_baseline(row['baseline'])}#{describe_tests(tests)}"
    0
  end

  def parse_metric(opts)
    metric = X::Metric.parse(opts["--metric"], phase: opts["--phase"])
    why = X.kind_error(opts["--kind"], metric.name)
    refuse(2, why, "use --kind instrumentation with --metric na_share, or --kind change with a duration metric") if why
    metric
  rescue X::UsageError => e
    refuse(2, e.message, "see experiment --help for the phases and metrics")
  end

  # A check:<label> that matches no check is the failed-lookup class: it
  # would judge nothing for 7 days. Refuse it unless the label ran on at
  # least one of the window's landings that carry check_walls.
  def check_label!(rows, metric, repo, window)
    err = X.check_label_error(rows, metric.check_label, window: window)
    return unless err

    if err[:state] == :could_not_look
      refuse(3, "could not look: none of #{repo.name}'s #{rows.size} ledgered landing(s) carries a non-empty check_walls " \
                "(rows ingested before DND-1548 have none), so check #{metric.check_label.inspect} cannot be looked up",
             "run ai/bin/lead-time-phases --ingest --repo #{repo.name} after a landing whose gate ran; " \
             "this is not an unknown label")
    end
    refuse(2, "check #{metric.check_label.inspect} appears on none of #{err[:n]} landings with check_walls " \
              "(the last #{window}); closest: #{err[:closest].map(&:inspect).join(', ')}",
           "copy the label exactly from harness-gate's timings.jsonl ($XDG_STATE_HOME/athena/harness-gate/, " \
           "default ~/.local/state/athena/harness-gate/; " \
           "its \"label\" field) or the gate's output, then re-run record")
  end

  def read_hypothesis(path) = Setup.read_text(path, "hypothesis", "write what the change should move, and why")

  # A SHA that is not on main would never appear in the ledger and would
  # block its phase for 7 days as "not ingested yet": refuse it here.
  # name/path: the repo the commit landed in (the change repo; --repo when
  # it is same-repo).
  def on_main!(name, path, commit)
    src = XG.on_main(path, commit)
    if src.could_not_look?
      refuse(3, "could not look whether #{short(commit)} is on #{name}'s main: #{src.reason}",
             "run from a machine where #{path} is checked out with main fetched")
    end
    return if src.items.first

    refuse(2, "#{short(commit)} is not on #{name}'s main (a pre-rebase SHA, or not landed yet)",
           "record the experiment after it lands, with the SHA as it is on main (git log origin/main)")
  end

  # The committer time of the commit's first-parent landing on the change
  # repo's main (DND-1528): the earliest it can have gone live, and the
  # fallback live_at (Live.resolve). Never the author date.
  def live_at!(name, path, commit)
    src = XG.landed_at(path, commit)
    if src.could_not_look?
      refuse(3, "could not look when #{short(commit)} landed on #{name}'s main: #{src.reason}",
             "run from a machine where #{path} is checked out with main fetched")
    end
    landing = src.items.first
    unless landing
      refuse(2, "#{short(commit)} has no first-parent landing on #{name}'s main",
             "record the experiment with the SHA as it landed on #{name}'s main (git log --first-parent origin/main)")
    end
    landing.last.utc
  end

  # cross: {} (same-repo), or change_repo and live_at (DND-1528), which the
  # split reads; a same-repo row gains no key.
  def build(repo, metric, kind, commit, hypothesis, now, rows, cross = {})
    split = X.split({ "repo" => repo.name, "commit" => commit }.merge(cross), rows)
    boundary = split ? split[:boundary] : now
    baseline = baseline(rows, metric, split ? split[:exclude] : [commit], boundary, repo)
    baseline["provisional"] = "landing not in the ledger yet: judge recomputes it from the landing time" unless split
    { "type" => "record", "schema" => X::SCHEMA, "id" => X.id_for(repo.name, metric.phase, commit),
      "repo" => repo.name, "phase" => metric.phase, "metric" => metric.name, "kind" => kind, "commit" => commit }
      .merge(cross)
      .merge("hypothesis" => hypothesis, "recorded_at" => now.iso8601, "baseline" => baseline)
  end

  def baseline(rows, metric, exclude, boundary, repo)
    return { "n" => 0, "na_reason" => "0 landings in the ledger for #{repo.name}" } if rows.empty?

    s = X.sides(rows, metric: metric, exclude: exclude, boundary: boundary)
    return { "n" => 0, "na_reason" => s[:before_na] } if s[:before].nil?

    X.stats(s[:before], metric).merge("from" => s[:before].first["landed_at"], "to" => s[:before].last["landed_at"])
  end

  # What a plain revert of the commit would delete (DND-1549).
  def describe_tests(tests)
    if tests["revert_deletes_tests_na"]
      return "; revert_deletes_tests n/a (#{tests['revert_deletes_tests_na']}): a revert verdict on it is held"
    end
    return "" if tests["revert_deletes_tests"].empty?

    "; a plain revert would delete test additions in #{tests['revert_deletes_tests'].join(', ')}"
  end

  def describe_baseline(b)
    out = if b["na_reason"] then "n/a (#{b['na_reason']})"
          elsif b.key?("na_share") then "n=#{b['n']} n/a share=#{b['na_share']}"
          else "n=#{b['n']} median=#{fmt(b['median'])} p90=#{fmt(b['p90'])}"
          end
    b["provisional"] ? "#{out} (provisional: #{b['provisional']})" : out
  end

  # Runs under the store's lock: refuse a duplicate or a blocked phase.
  def admit!(existing, row)
    dup = existing.find { |e| e["id"] == row["id"] }
    refuse(2, "experiment #{row['id']} is already recorded (status #{dup['status']})", "experiment list shows it; record a different commit") if dup
    blocker = X.blocker(existing.select { |e| e["repo"] == row["repo"] }, phase: row["phase"], kind: row["kind"])
    return [row] unless blocker

    state = blocker["status"] == "revert" ? "owes a revert that has not landed" : "is still pending"
    refuse(2, "a change on #{row['phase']} #{state}: #{blocker['id']} (commit #{short(blocker['commit'])}, " \
              "recorded #{blocker['recorded_at']}); two changes on one phase confound each other",
           "let experiment judge settle #{blocker['id']} (land its revert if it owes one), " \
           "or pick another phase, or make this an instrumentation change")
  end
end

# ── MANAGER: judge ───────────────────────────────────────────────────────────

module Judge
  module_function

  def run(opts, env)
    now = Setup.now(env)
    res = Setup.resolution(env)
    repo = Setup.improve_repo(env, opts["--repo"], res)
    state = Setup.state_dir(env)
    rows = Setup.ledger_rows(state, repo.name)
    store = Setup.store(state)
    unless store.exist?
      puts "experiment judge: #{repo.name}: no experiments file at #{store.path} (none recorded yet); #{rows.size} landing(s) in the ledger"
      return 0
    end

    all = Setup.experiments(Setup.read_store(store))
    mine = all.select { |e| e["repo"] == repo.name }
    shas = all.map { |e| e["commit"] }
    # [experiment, verdict, phase context (check metrics only; printed, never judged)]
    pending = mine.select { |e| e["status"] == "pending" }.map { |e| Live.upgrade(e, state, repo, res) }
    results = pending.map { |e| [e, *verdict(e, rows, repo, shas, now)] }
    results += mine.select { |e| e["status"] == "revert" }.map { |e| [e, owed(e, repo, res), nil] }
    # + the HELD explanation (DND-1549), nil unless a revert verdict is held
    results = results.map { |e, v, ctx| held(e, v, ctx, repo, res) }
    appended = Setup.append(store) { |existing| fresh_rows(existing, results, now) }
    results.each { |e, v, ctx, why| puts line(e, v, ctx, why) }
    judged = results.map { |_, v| v["status"] }
    tally = X::JUDGED.map { |s| "#{judged.count(s)} #{s}" }.join(", ")
    declined = mine.count { |e| e["status"] == "declined" }
    held_count = results.count { |_, v| v["held"] }
    puts "experiment judge: #{repo.name}: #{results.size} judged (#{tally}); #{appended.size} status row(s) appended; " \
         "#{rows.size} landing(s) in the ledger; #{declined} declined (a revert the hard constraint forbids; not judged); " \
         "#{held_count} held (a revert whose plain git revert would delete test additions, or could not tell)"
    0
  end

  # -> [exp, verdict, ctx, why]. A revert verdict (fresh or owed) whose
  # commit added test lines, or whose answer is unknown, is held: the
  # verdict gains a `held` field and stays revert; why is the line's text.
  def held(exp, v, ctx, repo, res)
    return [exp, v, ctx, nil] unless v["status"] == "revert"

    hold = X.hold(v["status"], tests_fields(exp, repo, res))
    return [exp, v, ctx, nil] unless hold

    refusal, = X.decline_error(exp.merge("status" => "revert", "last" => v))
    change = X.cross_repo?(exp) ? exp["change_repo"] : nil
    [exp, v.merge("held" => hold), ctx, X.hold_text(repo.name, exp["id"], exp["commit"], hold, refusal, change_repo: change)]
  end

  # Runs a git reader against the repo the experiment's commit landed in:
  # the change repo for a cross-repo experiment (DND-1528), else the repo.
  # A change repo that cannot be resolved now is could not look, never
  # "no revert" or "no tests".
  def in_change_repo(exp, repo, res)
    return yield(repo.path) unless X.cross_repo?(exp)

    path = begin
      LeadTimeConfigIO.repo_path(res, exp["change_repo"])
    rescue LeadTimeConfig::Error => e
      return LeadTimePhases::Source.could_not_look("change repo #{exp['change_repo']} cannot be resolved: #{e.message}")
    end
    yield path
  end

  # The record's revert_deletes_tests list, else the same answer computed
  # now with the same adapter: for a record written before DND-1549 (no
  # field), and for one whose git could not look at record time (_na), so a
  # one-off git failure does not hold the revert for good. Still unknown
  # stays _na, which X.hold holds.
  def tests_fields(exp, repo, res)
    return exp if exp["revert_deletes_tests"].is_a?(Array)

    X.deletes_tests_fields(in_change_repo(exp, repo, res) { |path| XG.numstat(path, exp["commit"]) })
  end

  # Under the lock: only experiments whose status is still the one judged
  # from (another judge may have settled one meanwhile), and only a changed
  # verdict.
  def fresh_rows(existing, results, now)
    latest = X.fold(existing).to_h { |e| [e["id"], e] }
    results.filter_map do |e, v|
      cur = latest[e["id"]]
      next unless cur && cur["status"] == e["status"]
      next if e["status"] == "revert" && v["status"] == "revert" # still owed: nothing new to record
      next unless X.changed?(cur["last"], v)

      X.status_row(e, v, now)
    end
  end

  # -> [verdict, context]. context: for a check metric, the phase's own
  # stats over the same two sides, else nil. It is printed, never judged.
  def verdict(exp, rows, repo, shas, now)
    split = X.split(exp, rows)
    return [unlanded(exp, repo, now), nil] unless split

    metric = X::Metric.parse(exp["metric"], phase: exp["phase"])
    s = X.sides(rows, metric: metric, exclude: split[:exclude], boundary: split[:boundary])
    v = X.judge(exp, before: s[:before], after: s[:after], guards_before: guards(s[:before], repo, shas),
                     guards_after: guards(s[:after], repo, shas), now: now)
    [v, metric.check? ? X.phase_context(s[:before], s[:after], phase: exp["phase"]) : nil]
  end

  # Not in the ledger: say whether it is on main (ingest lag) or not.
  def unlanded(exp, repo, now)
    v = X.unlanded(exp, now: now)
    src = XG.on_main(repo.path, exp["commit"])
    why = if src.could_not_look? then "could not look whether it is on main: #{src.reason}"
          elsif src.items.first then "it is on main: run lead-time-phases --ingest"
          else "it is NOT on main: recorded with a SHA that never landed (a pre-rebase SHA?)"
          end
    v.merge("reason" => "#{v['reason']}; #{why}")
  end

  # A revert verdict owes a revert until main carries one: the change
  # repo's main for a cross-repo experiment (DND-1528).
  def owed(exp, repo, res)
    src = in_change_repo(exp, repo, res) { |path| XG.reverted?(path, exp["commit"]) }
    main = X.cross_repo?(exp) ? "#{exp['change_repo']}'s main" : "main"
    last = exp["last"] || {}
    keep = { "before" => last["before"], "after" => last["after"], "guards" => last["guards"] }
    if !src.could_not_look? && src.items.first
      return { "status" => "reverted", "reason" => "#{main} carries a revert of #{short(exp['commit'])}" }.merge(keep)
    end

    seen = src.could_not_look? ? "could not look for it: #{src.reason}" : "#{main} has no revert of it yet"
    { "status" => "revert", "reason" => "REVERT OWED: #{last['reason']}; #{seen}" }.merge(keep)
  end

  def guards(side, repo, shas)
    return nil if side.nil? || side.empty?

    times = side.map { |r| X.at(r) }
    reverts = XG.reverts(repo.path, times.min.iso8601, times.max.iso8601, shas)
    LeadTimePhases::Guards.compute(side, reverts: reverts)
  end

  def side(s)
    return "n/a" if s.nil?
    return "n=#{s['n']} n/a share=#{s['na_share'].nil? ? 'n/a' : s['na_share']}" if s.key?("na_share")

    "n=#{s['n']} median=#{fmt(s['median'])} p90=#{fmt(s['p90'])}"
  end

  # A held revert reads REVERT HELD instead of REVERT / REVERT OWED.
  def line(exp, v, ctx = nil, held_why = nil)
    g = v["guards"]&.map { |name, d| "#{name} #{d['before'].nil? ? 'n/a' : d['before']}->#{d['after'].nil? ? 'n/a' : d['after']} #{d['state']}" }
    phase = ctx ? " | phase (context, not judged): before #{side(ctx['before'])} | after #{side(ctx['after'])}" : ""
    status = held_why ? "REVERT HELD" : v["status"].upcase
    reason = held_why ? "#{v['reason'].to_s.sub(/\AREVERT OWED: /, 'owed: ')} | #{held_why}" : v["reason"]
    xtext = X.cross_text(exp)
    "experiment: #{exp['id']} #{status} kind=#{exp['kind']} metric=#{exp['metric']}#{xtext ? " #{xtext}" : ''} | " \
      "before #{side(v['before'])} | after #{side(v['after'])} | guards #{g ? g.join(', ') : 'n/a'} | #{reason}#{phase}"
  end
end

# ── MANAGER: list ────────────────────────────────────────────────────────────

module List
  module_function

  def run(opts, env)
    Setup.repo(env, opts["--repo"]) if opts["--repo"]
    store = Setup.store(Setup.state_dir(env))
    unless store.exist?
      puts "experiment list: no experiments file at #{store.path} (none recorded yet)"
      return 0
    end

    all = Setup.experiments(Setup.read_store(store))
    mine = opts["--repo"] ? all.select { |e| e["repo"] == opts["--repo"] } : all
    mine.each { |e| puts line(e) }
    scope = opts["--repo"] ? " for #{opts['--repo']}" : ""
    puts "experiment list: #{mine.size} experiment(s)#{scope} of #{all.size} recorded"
    0
  end

  def line(e)
    b = e["baseline"].is_a?(Hash) ? e["baseline"] : {}
    base = b["na_reason"] ? "n/a (#{b['na_reason']})" : Judge.side(b)
    declined = e["status"] == "declined"
    tag = declined ? " constraint=#{e.dig('last', 'constraint')}" : ""
    was = declined ? " (revert verdict was: #{e.dig('last', 'prior_reason')})" : ""
    xtext = X.cross_text(e)
    "experiment: #{e['id']} #{e['status'].upcase}#{tag} kind=#{e['kind']} metric=#{e['metric']}#{xtext ? " #{xtext}" : ''} " \
      "recorded #{e['recorded_at']} | baseline #{base}#{e['last'] ? " | #{e['last']['reason']}#{was}" : ''}"
  end
end

# ── MANAGER: decline ─────────────────────────────────────────────────────────

module Decline
  module_function

  def run(opts, env)
    now = Setup.now(env)
    constraint = opts["--constraint"]
    if (why = X.constraint_error(constraint))
      refuse(2, "--constraint: #{why}",
             "safety-checks when the revert would delete, skip or weaken a check or test; " \
             "bug-fix when it would reinstate a defect the commit fixed")
    end
    reason = Setup.read_text(opts["--reason-file"], "reason", "write why the revert is declined")
    repo = Setup.improve_repo(env, opts["--repo"])
    store = Setup.store(Setup.state_dir(env))
    unless store.exist?
      refuse(2, "no experiments file at #{store.path}: nothing to decline", "experiment list shows what is recorded")
    end

    row = Setup.append(store) { |existing| [admit!(existing, repo, opts["--id"], constraint, reason, now)] }.first
    puts "experiment: declined #{row['id']} (constraint #{constraint}); its phase admits a new change. " \
         "Revert verdict kept as prior_reason: #{row['prior_reason']}"
    0
  end

  # Under the store's lock: the experiment's latest status is re-read here,
  # so a judge or another decline that settled it meanwhile is seen.
  def admit!(existing, repo, id, constraint, reason, now)
    mine = X.fold(existing).select { |e| e["repo"] == repo.name }
    exp = mine.find { |e| e["id"] == id }
    unless exp
      ids = mine.map { |e| e["id"] }
      refuse(2, "no experiment #{id.inspect} for #{repo.name} (its ids: #{ids.empty? ? 'none' : ids.join(', ')})",
             "pass an id as experiment list --repo #{repo.name} prints it")
    end
    why, fix = X.decline_error(exp)
    refuse(2, "cannot decline: #{why}", fix) if why

    X.decline_row(exp, constraint: constraint, reason: reason, now: now)
  end
end

# ── FRAMEWORK ────────────────────────────────────────────────────────────────

def main(argv, env)
  if argv.include?("--help") || argv.include?("-h")
    puts HELP
    return 0
  end
  sub = argv.first
  unless SPECS.key?(sub)
    warn "experiment: usage error: #{sub.nil? ? 'no subcommand' : "unknown subcommand #{sub.inspect}"}"
    warn "Fix: run experiment record|judge|list|decline (experiment --help)"
    return 2
  end
  opts = StrictArgv.parse(argv.drop(1), SPECS[sub])
  missing = REQUIRED[sub] - opts.keys
  refuse(2, "usage error: #{sub} needs #{missing.join(', ')}", "experiment --help lists each flag") unless missing.empty?
  { "record" => Record, "judge" => Judge, "list" => List, "decline" => Decline }.fetch(sub).run(opts, env)
rescue StrictArgv::UsageError => e
  warn "experiment: usage error: #{e.message}"
  warn "Fix: experiment --help lists each subcommand's flags"
  2
rescue Refusal => e
  warn "experiment: #{e.message}"
  warn "Fix: #{e.fix}"
  e.code
rescue X::UsageError => e
  # A domain invariant tripped past the CLI's own checks (e.g. judge asked to
  # write a status only the decline verb writes): a tool bug, not a usage one.
  warn "experiment: internal error: #{e.message}"
  warn "Fix: nothing was written by the failing step; file a ticket against scripts/experiment with this line"
  1
rescue SystemCallError, JSON::GeneratorError => e
  warn "experiment: #{e.class}: #{e.message}"
  warn "Fix: check the state dir and its files are readable and writable, then re-run"
  1
end

exit(main(ARGV, ENV)) if $PROGRAM_NAME == __FILE__
