#!/bin/bash
# Worktree-from-fresh-main preflight for a fleet lane.
#   usage: wt-preflight [--repo <path-or-name>] [--dry-run] <branch-name>
#          wt-preflight <branch-name> [<repo-path-or-name>]
# Refuses to leave a worktree branched off a STALE local main.
# Fleet rule (Vanta-lane incident, 2026-08-27): `wt create` branches from the LOCAL
# main, which can be two merges behind origin. Verified, not assumed.
#
# Repo selection (SHIP-2026-09-16: was hardcoded to walt_ui; a gen_saas admiral run
# had to replicate this logic by hand — parameterized so any fleet can call it):
#   - default is /home/cjpoll/dev/walt_ui, so `wt-preflight <branch>` is unchanged.
#   - override with `--repo <val>`, a 2nd positional, or $WT_PREFLIGHT_REPO.
#   - a value with no `/` is treated as a project name under $HOME/dev/<name>.
#   - the worktree lands at $HOME/.local/worktrees/<basename REPO>/<branch>.
set -uo pipefail

usage() {
  sed -n '2,4p' "$0" | sed 's/^# \{0,1\}//'
}

DRYRUN=0
BRANCH=""
REPO_ARG="${WT_PREFLIGHT_REPO:-}"

while [ $# -gt 0 ]; do
  case "$1" in
    --repo) REPO_ARG="${2:?--repo needs a value}"; shift 2 ;;
    --repo=*) REPO_ARG="${1#--repo=}"; shift ;;
    --dry-run) DRYRUN=1; shift ;;
    -h|--help) usage; exit 0 ;;
    -*) echo "FAIL: unknown flag $1"; echo "Fix: use only --repo <path-or-name> or --dry-run (see usage)"; usage; exit 1 ;;
    *)
      if [ -z "$BRANCH" ]; then BRANCH="$1"
      elif [ -z "$REPO_ARG" ]; then REPO_ARG="$1"
      else echo "FAIL: unexpected extra argument $1"; echo "Fix: pass at most <branch-name> and one repo (see usage)"; usage; exit 1
      fi
      shift ;;
  esac
done

[ -n "$BRANCH" ] || { echo "FAIL: missing <branch-name>"; echo "Fix: pass the branch to create, e.g. wt-preflight dnd-123-thing"; usage; exit 1; }

# Resolve the repo: bare name -> $HOME/dev/<name>; path -> as given; default walt_ui.
if [ -z "$REPO_ARG" ]; then
  REPO=/home/cjpoll/dev/walt_ui
elif [ "${REPO_ARG#*/}" = "$REPO_ARG" ]; then
  REPO="$HOME/dev/$REPO_ARG"
else
  REPO="$REPO_ARG"
fi
PROJECT=$(basename "$REPO")
WT="$HOME/.local/worktrees/$PROJECT/$BRANCH"

if [ "$DRYRUN" = "1" ]; then
  echo "DRY RUN — resolution only, no git operations"
  echo "  repo:     $REPO"
  echo "  project:  $PROJECT"
  echo "  branch:   $BRANCH"
  echo "  worktree: $WT"
  [ -d "$REPO/.git" ] || [ -f "$REPO/.git" ] || echo "  WARN: $REPO is not a git repo"
  exit 0
fi

[ -d "$REPO/.git" ] || [ -f "$REPO/.git" ] || { echo "FAIL: $REPO is not a git repo"; echo "Fix: pass --repo <name under ~/dev or an absolute repo path>; run with --dry-run to see what resolved"; exit 1; }

echo "== 1. refresh local main ($PROJECT) =="
git -C "$REPO" pull --ff-only || { echo "FAIL: pull --ff-only refused (local main diverged?) — resolve before dispatching"; echo "Fix: inspect git -C $REPO log origin/main..main; reconcile local main with origin/main (never force), then re-run"; exit 1; }
git -C "$REPO" fetch origin --quiet
ORIGIN=$(git -C "$REPO" rev-parse origin/main)
LOCAL=$(git -C "$REPO" rev-parse main)
echo "   origin/main $ORIGIN"
echo "   local  main $LOCAL"
[ "$ORIGIN" = "$LOCAL" ] || { echo "FAIL: local main != origin/main after ff-only pull"; echo "Fix: check $REPO is on main (git -C $REPO status) and that origin/main is fetched, then re-run"; exit 1; }

echo "== 2. create worktree =="
cd "$REPO" || exit 2  # wt defaults --parent to the CALLER's current branch; never run it from another worktree
"$HOME/dev/custom/scripts/wt" create "$BRANCH" --parent main || { echo "FAIL: wt create"; echo "Fix: read the wt error above (an existing branch or worktree named $BRANCH is the usual cause); pick a new branch name or remove the stale worktree"; exit 1; }
[ -d "$WT" ] || { echo "FAIL: worktree not at $WT"; echo "Fix: find where wt put it (git -C $REPO worktree list) and remove it; wt-preflight expects ~/.local/worktrees/<project>/<branch>"; exit 1; }

echo "== 3. VERIFY the new branch descends from origin/main =="
git -C "$REPO" fetch origin --quiet
if git -C "$WT" merge-base --is-ancestor origin/main HEAD; then
  echo "   OK: origin/main is an ancestor of $BRANCH"
else
  echo "   STALE BASE DETECTED — repairing"
  OWN=$(git -C "$WT" rev-list --count origin/main..HEAD 2>/dev/null || echo "?")
  echo "   own commits on branch: $OWN"
  if [ "$OWN" = "0" ]; then
    git -C "$WT" reset --hard origin/main || { echo "FAIL: reset"; echo "Fix: read the git error above, resolve it in $WT, then re-run"; exit 1; }
    echo "   repaired by reset --hard origin/main (branch had no own commits)"
  else
    echo "   FAIL: branch has $OWN own commits — do NOT reset. Merge main forward instead."; echo "   Fix: git -C $WT merge origin/main (or rebase onto it), then re-run"; exit 1
  fi
  git -C "$WT" merge-base --is-ancestor origin/main HEAD || { echo "FAIL: still not descended"; echo "Fix: git -C $WT merge origin/main, then re-run"; exit 1; }
fi

echo "== 4. report =="
echo "   worktree: $WT"
echo "   HEAD:     $(git -C "$WT" log --oneline -1)"
echo "PREFLIGHT OK"
