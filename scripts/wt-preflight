#!/bin/bash
# Worktree-from-fresh-main preflight for a fleet lane.
#   usage: wt-preflight [--repo <path-or-name>] [--dry-run] [--lock-retries N] <branch-name>
#          wt-preflight <branch-name> [<repo-path-or-name>]
# Refuses to leave a worktree branched off a STALE local main.
# Fleet rule (Vanta-lane incident, 2026-08-27): `wt create` branches from the LOCAL
# main, which can be two merges behind origin. Verified, not assumed.
#
# Repo selection (SHIP-2026-09-16: was hardcoded to walt_ui; a gen_saas admiral run
# had to replicate this logic by hand — parameterized so any fleet can call it):
#   - default is /home/cjpoll/dev/walt_ui, so `wt-preflight <branch>` is unchanged.
#   - override with `--repo <val>`, a 2nd positional, or $WT_PREFLIGHT_REPO.
#   - a value with no `/` is treated as a project name under $HOME/dev/<name>.
#   - the worktree lands at $HOME/.local/worktrees/<basename REPO>/<branch>.
#
# Step 1's pull failure is classified before it is named (DND-1509): a lock held
# by another git (a cron fetching the same main checkout) is retried up to
# --lock-retries times (default 10), one second apart, re-running the pull only
# once the named lock is gone; a real divergence keeps its own message; anything
# else prints git's error with a generic Fix:.
set -uo pipefail

usage() {
  sed -n '2,4p' "$0" | sed 's/^# \{0,1\}//'
}

DRYRUN=0
BRANCH=""
REPO_ARG="${WT_PREFLIGHT_REPO:-}"
LOCK_RETRIES=10

while [ $# -gt 0 ]; do
  case "$1" in
    --repo) REPO_ARG="${2:?--repo needs a value}"; shift 2 ;;
    --repo=*) REPO_ARG="${1#--repo=}"; shift ;;
    --lock-retries)
      [ $# -ge 2 ] || { echo "FAIL: --lock-retries needs a value"; echo "Fix: pass a whole number of retries, e.g. --lock-retries 10"; exit 1; }
      LOCK_RETRIES="$2"; shift 2 ;;
    --lock-retries=*) LOCK_RETRIES="${1#--lock-retries=}"; shift ;;
    --dry-run) DRYRUN=1; shift ;;
    -h|--help) usage; exit 0 ;;
    -*) echo "FAIL: unknown flag $1"; echo "Fix: use only --repo <path-or-name>, --dry-run or --lock-retries N (see usage)"; usage; exit 1 ;;
    *)
      if [ -z "$BRANCH" ]; then BRANCH="$1"
      elif [ -z "$REPO_ARG" ]; then REPO_ARG="$1"
      else echo "FAIL: unexpected extra argument $1"; echo "Fix: pass at most <branch-name> and one repo (see usage)"; usage; exit 1
      fi
      shift ;;
  esac
done

[ -n "$BRANCH" ] || { echo "FAIL: missing <branch-name>"; echo "Fix: pass the branch to create, e.g. wt-preflight dnd-123-thing"; usage; exit 1; }
case "$LOCK_RETRIES" in
  ''|*[!0-9]*) echo "FAIL: --lock-retries must be a whole number, got '$LOCK_RETRIES'"; echo "Fix: pass a whole number of retries, e.g. --lock-retries 10 (0 reports a held lock at once)"; exit 1 ;;
esac

# Resolve the repo: bare name -> $HOME/dev/<name>; path -> as given; default walt_ui.
if [ -z "$REPO_ARG" ]; then
  REPO=/home/cjpoll/dev/walt_ui
elif [ "${REPO_ARG#*/}" = "$REPO_ARG" ]; then
  REPO="$HOME/dev/$REPO_ARG"
else
  REPO="$REPO_ARG"
fi
PROJECT=$(basename "$REPO")
WT="$HOME/.local/worktrees/$PROJECT/$BRANCH"

if [ "$DRYRUN" = "1" ]; then
  echo "DRY RUN — resolution only, no git operations"
  echo "  repo:     $REPO"
  echo "  project:  $PROJECT"
  echo "  branch:   $BRANCH"
  echo "  worktree: $WT"
  [ -d "$REPO/.git" ] || [ -f "$REPO/.git" ] || echo "  WARN: $REPO is not a git repo"
  exit 0
fi

[ -d "$REPO/.git" ] || [ -f "$REPO/.git" ] || { echo "FAIL: $REPO is not a git repo"; echo "Fix: pass --repo <name under ~/dev or an absolute repo path>; run with --dry-run to see what resolved"; exit 1; }

# Every fleet dispatch passes here, so the address-pool gate lives here
# (DND-864): a repo that runs compose stacks gets no new worktree while
# docker's pool is nearly out. pool-headroom names the stacks to reclaim.
echo "== 0. docker address-pool headroom ($PROJECT) =="
POOL_HEADROOM="$(cd "$(dirname "$0")/.." && pwd)/ai/bin/pool-headroom"
# Every read of origin goes through Athena's forge route (DND-1977), never the
# owner's SSH key: wt-preflight runs in every unattended fleet dispatch.
FORGE_GIT="$(cd "$(dirname "$0")/.." && pwd)/ai/bin/forge-git"
"$POOL_HEADROOM" --repo "$REPO" || { echo "FAIL: pool-headroom refused (exit $?) — a new $PROJECT stack may not get a subnet"; echo "Fix: follow pool-headroom's Fix: above (tear down your fleet's MERGED-BUT-UP stacks it names, ask other fleets' admirals about theirs, prune idle networks), then re-run wt-preflight"; exit 1; }

echo "== 1. refresh local main ($PROJECT) =="
# DND-1509: a failed pull is classified before it is named. Before this, every
# failure read "local main diverged?", so a lock held by a cron's fetch sent the
# agent to reconcile a divergence that did not exist.
# LC_ALL=C: the classifier reads git's English messages; a translated locale
# would drop every lock into the generic branch.
pull_main() {
  # --no-rebase: the forge wrapper refuses a pull that rebases, and a
  # pull.rebase=true config would make this one do so.
  PULL_OUT=$(LC_ALL=C "$FORGE_GIT" -C "$REPO" pull --ff-only --no-rebase 2>&1); PULL_RC=$?
  printf '%s\n' "$PULL_OUT"
}
# The lock file git names in its error, or "" when it names none. git prints
# lock paths absolute, so the -e test below does not depend on our cwd.
pull_lock() {
  printf '%s\n' "$PULL_OUT" | sed -n "s/.*Unable to create '\(.*\.lock\)': File exists.*/\1/p" | head -n 1
}
# A named lock file, or a ref update that raced another git ("cannot lock ref
# ...: is at X but expected Y"), which names no file.
pull_is_lock() { [ -n "$(pull_lock)" ] || grep -q "cannot lock ref" <<<"$PULL_OUT"; }
# Diverged means both sides hold commits the other lacks, read from the refs,
# not guessed from the failure. Exit 0 diverged, 1 not diverged, 2 could not
# check (no main or no origin/main to count), kept apart so "not diverged" is
# never claimed for a check that did not run.
main_diverged() {
  local counts ahead behind
  counts=$(git -C "$REPO" rev-list --left-right --count main...origin/main 2>/dev/null) || return 2
  read -r ahead behind <<<"$counts"
  [ "${ahead:-0}" -gt 0 ] && [ "${behind:-0}" -gt 0 ]
}

pull_main
TRIES=0
while [ "$PULL_RC" -ne 0 ] && pull_is_lock && [ "$TRIES" -lt "$LOCK_RETRIES" ]; do
  TRIES=$((TRIES + 1))
  LOCK=$(pull_lock)
  echo "   lock held: ${LOCK:-a ref lock}; waiting for it to clear (retry $TRIES/$LOCK_RETRIES)"
  sleep 1
  # Still held: spend the retry without re-running the pull.
  [ -n "$LOCK" ] && [ -e "$LOCK" ] && continue
  pull_main
done
if [ "$PULL_RC" -ne 0 ]; then
  [ "$TRIES" = 1 ] && RETRY_WORD="retry" || RETRY_WORD="retries"
  ON_BRANCH=$(git -C "$REPO" symbolic-ref --short -q HEAD)
  main_diverged; DIVERGED=$?
  if pull_is_lock && [ -n "$(pull_lock)" ]; then
    LOCK=$(pull_lock)
    echo "FAIL: pull --ff-only blocked: $LOCK is held by another git process (still held after $TRIES $RETRY_WORD)"
    echo "Fix: this is lock contention, not a divergence; do not reconcile main. Another git is writing $REPO (often a cron fetching the main checkout): re-run wt-preflight once it finishes. If no git process is working in $REPO (pgrep -a git, and look for $REPO in what it lists), the lock is stale from a crashed git: remove $LOCK, then re-run."
  elif pull_is_lock; then
    echo "FAIL: pull --ff-only blocked: a ref update in $REPO raced another git process (still racing after $TRIES $RETRY_WORD)"
    echo "Fix: this is contention, not a divergence; do not reconcile main. Re-run wt-preflight once the other git writing $REPO (often a cron fetching the main checkout) finishes."
  elif [ "$ON_BRANCH" != main ]; then
    echo "FAIL: pull --ff-only failed in $REPO, which is on '${ON_BRANCH:-a detached HEAD}', not main, so the pull was not main's; git's error is above"
    echo "Fix: git -C $REPO switch main (commit or move any work on the current branch first), then re-run"
  elif [ "$DIVERGED" = 0 ] || grep -q "Not possible to fast-forward" <<<"$PULL_OUT"; then
    echo "FAIL: pull --ff-only refused (local main diverged?) — resolve before dispatching"
    echo "Fix: inspect git -C $REPO log origin/main..main; reconcile local main with origin/main (never force), then re-run"
  else
    [ "$DIVERGED" = 2 ] && DIV_NOTE="divergence could not be checked (main or origin/main unreadable)" || DIV_NOTE="no divergence between main and origin/main"
    echo "FAIL: pull --ff-only failed (exit $PULL_RC), not on a lock; $DIV_NOTE; git's error is above"
    echo "Fix: fix the cause git names above in $REPO (an unreachable remote, local changes in the way), then re-run"
  fi
  exit 1
fi
"$FORGE_GIT" -C "$REPO" fetch origin --quiet
ORIGIN=$(git -C "$REPO" rev-parse origin/main)
LOCAL=$(git -C "$REPO" rev-parse main)
echo "   origin/main $ORIGIN"
echo "   local  main $LOCAL"
[ "$ORIGIN" = "$LOCAL" ] || { echo "FAIL: local main != origin/main after ff-only pull"; echo "Fix: check $REPO is on main (git -C $REPO status) and that origin/main is fetched, then re-run"; exit 1; }

echo "== 2. create worktree =="
cd "$REPO" || exit 2  # wt defaults --parent to the CALLER's current branch; never run it from another worktree
"$HOME/dev/custom/scripts/wt" create "$BRANCH" --parent main || { echo "FAIL: wt create"; echo "Fix: read the wt error above (an existing branch or worktree named $BRANCH is the usual cause); pick a new branch name or remove the stale worktree"; exit 1; }
[ -d "$WT" ] || { echo "FAIL: worktree not at $WT"; echo "Fix: find where wt put it (git -C $REPO worktree list) and remove it; wt-preflight expects ~/.local/worktrees/<project>/<branch>"; exit 1; }

echo "== 3. VERIFY the new branch descends from origin/main =="
"$FORGE_GIT" -C "$REPO" fetch origin --quiet
if git -C "$WT" merge-base --is-ancestor origin/main HEAD; then
  echo "   OK: origin/main is an ancestor of $BRANCH"
else
  echo "   STALE BASE DETECTED — repairing"
  OWN=$(git -C "$WT" rev-list --count origin/main..HEAD 2>/dev/null || echo "?")
  echo "   own commits on branch: $OWN"
  if [ "$OWN" = "0" ]; then
    git -C "$WT" reset --hard origin/main || { echo "FAIL: reset"; echo "Fix: read the git error above, resolve it in $WT, then re-run"; exit 1; }
    echo "   repaired by reset --hard origin/main (branch had no own commits)"
  else
    echo "   FAIL: branch has $OWN own commits — do NOT reset. Merge main forward instead."; echo "   Fix: git -C $WT merge origin/main (or rebase onto it), then re-run"; exit 1
  fi
  git -C "$WT" merge-base --is-ancestor origin/main HEAD || { echo "FAIL: still not descended"; echo "Fix: git -C $WT merge origin/main, then re-run"; exit 1; }
fi

echo "== 4. report =="
echo "   worktree: $WT"
echo "   HEAD:     $(git -C "$WT" log --oneline -1)"
echo "PREFLIGHT OK"
