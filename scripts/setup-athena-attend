#!/usr/bin/env bash
#
# setup-athena-attend — install (or remove) the user-crontab entries that keep
# the Athena attendant alive on this OpenRC host.
#
# The standing channel session (scripts/athena-channel-session.sh) is the
# supervisor for a project's Athena inbox: it launches an interactive `claude`
# in tmux with --dangerously-load-development-channels so the inbox channel shim
# pushes unread-count wakes straight into it, answers the one dev-channels
# dialog, asserts the registration notice, and rotates/restarts under bounds.
# Nothing runs until these entries are installed — shipping the launcher starts
# no always-on session; this installer is the deliberate switch. It also runs
# the live SDK wire-conformance check before installing, so a shim that has
# drifted from the pinned SDK never reaches live registration.
#
# There is no `systemd --user` here, and an /etc/init.d service is a system-level
# change that belongs to Cody, not to an agent. The user crontab (cronie) is the
# only user-level scheduler available; this script mirrors
# scripts/setup-athena-inbox-client deliberately.
#
# Two entries are installed, both pointing at the MAIN CHECKOUT's
# scripts/athena-channel-session.sh — never a worktree's copy, even when this
# installer is run from one. A worktree path vanishes when `wt` cleans the
# branch up, and cron would go on firing a job pointing at a file that no longer
# exists: silently, forever, with nothing attending the inbox. Same failure
# class, same resolver, as scripts/setup-hooks and setup-athena-inbox-client.
#
# The two entries are (for the project named by --project, default ~/dev/walt_ui):
#
#   @reboot          [ATHENA_ATTEND_OWNER_SLACK_ID=<id>] <runner> --project <abs dir>
#   */5 * * * *      [ATHENA_ATTEND_OWNER_SLACK_ID=<id>] <runner> --project <abs dir>
#
# The optional VAR=value prefix is baked in only when ATHENA_ATTEND_OWNER_SLACK_ID
# is set in THIS installer's own env at --install time — see the env var below.
# It sits before <runner> so idempotency's find/remove match (below) still finds
# the line whether or not an id is baked in.
#
# The */5 entry costs nothing while the attendant is healthy: the runner takes
# an flock on its pidfile and a second invocation exits immediately without
# starting anything. It is a paced, bounded external poll — not a spin loop.
#
# Per-project. The entries name the project, so a second project's attendant is
# installed and removed independently; installing walt_ui's never disturbs
# another project's entry (matching is on the runner path AND that project's
# absolute dir).
#
# Idempotent. The crontab is edited read-modify-write: every line mentioning THIS
# project's entry is filtered out and the two canonical entries re-appended.
# Unrelated entries — the shipwright's hourly line, the inbox client's, another
# project's attendant — survive verbatim. Blank lines are dropped (the filter
# normalises whitespace-only lines away).
#
# Usage:
#   setup-athena-attend [--install] [--project DIR] [--dry-run]
#   setup-athena-attend --check   [--project DIR]
#   setup-athena-attend --remove  [--project DIR] [--dry-run]
#   setup-athena-attend --self-test
#   setup-athena-attend --help
#
# Options:
#   --install    Install both crontab entries (the default when no mode is given).
#                DENIES BY DEFAULT (exit 2, crontab left byte-identical, a Fix:
#                line) unless ATHENA_ATTEND_OWNER_SLACK_ID is set to a valid
#                Slack user id (^U[A-Z0-9]{8,}$) or --no-owner-dm is passed
#                explicitly (DND-288 build 2) — see ATHENA_ATTEND_OWNER_SLACK_ID
#                below for why a reminder alone is not enough.
#   --project D  Project whose inbox to attend (default ~/dev/walt_ui)
#   --no-owner-dm  Install without a validated owner Slack id. The ONLY way
#                past the deny-by-default refusal above. Prints a loud WARNING
#                naming what goes silent (wedge/dark/version-pin alerts), and
#                the choice is recorded in the crontab entry itself (a trailing
#                comment), never silently.
#   --check      Read-only: report whether both entries are live. OK + the lines
#                and exit 0, or MISSING + a Fix: line and exit 1. When the entries
#                are live, also reports the owner-DM state: persisted (the id,
#                masked to its first 3 chars), disabled (--no-owner-dm was used),
#                or — for a T3-era bare line — a WARNING "NOT PERSISTED (installed
#                before DND-288)" + Fix:. These three states never read the same.
#   --dry-run    Print what would happen; change nothing
#   --remove     Remove this project's crontab entries and exit
#   --self-test  Run scripts/test/athena-channel-session/self-test.sh on a temp crontab
#   --help       Show this help
#
# Options are order-independent.
#
# Environment (all optional; defaults are the production values):
#   ATHENA_ATTEND_PROJECT_DIR   default project when --project is not given
#   ATHENA_ATTEND_RUNNER_DIR    dir holding the runner to schedule. Defaults to
#                               the MAIN CHECKOUT's scripts/ (see above); a test
#                               seam, not something an operator should need.
#   ATHENA_ATTEND_INBOX_BIN_DIR dir holding inbox-wait, for the preflight that
#                               refuses to install an attendant for a project
#                               with no channels (a test seam; defaults to the
#                               main checkout's athena:inbox bin).
#   ATHENA_ATTEND_OWNER_SLACK_ID  required at --install time (or pass
#                               --no-owner-dm explicitly). Baked directly into
#                               the written crontab entries (VAR=value BEFORE
#                               the runner path) so a cron-launched session —
#                               which runs with a minimal, mostly empty
#                               environment — still has it. Without this,
#                               athena-channel-session.sh's dm_owner silently
#                               no-ops on every wedge/dark/version-pin event
#                               under cron: the exact silent-failure class this
#                               installer exists to catch, which is why an
#                               unset or malformed id (not matching
#                               ^U[A-Z0-9]{8,}$) REFUSES the install rather
#                               than falling back to a bare, unannounced entry.
#
# Exit codes: 0 ok · 1 usage/arg error, or --check found entries missing
#             · 2 missing prerequisite (no crontab, runner not in main checkout,
#               project not a git repo, inbox-wait refuses for that project, or
#               ATHENA_ATTEND_OWNER_SLACK_ID is unset/malformed and --no-owner-dm
#               was not passed)

set -uo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd -P)"

main_checkout_dir() {
  local common parent
  common="$(git -C "$SCRIPT_DIR" rev-parse --git-common-dir 2>/dev/null)" \
    || { printf '%s\n' "$SCRIPT_DIR"; return 0; }
  [ -n "$common" ] || { printf '%s\n' "$SCRIPT_DIR"; return 0; }
  case "$common" in /*) ;; *) common="${SCRIPT_DIR}/${common}" ;; esac
  parent="$(dirname -- "$common")"
  if [ -d "${parent}/scripts" ]; then (cd -- "${parent}/scripts" && pwd -P); else printf '%s\n' "$SCRIPT_DIR"; fi
}

usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,"");print;next} {exit}' "$0"; }

MODE="install"
DRY_RUN=0
PROJECT_ARG=""
NO_OWNER_DM=0
while [ $# -gt 0 ]; do
  case "$1" in
    --install)      MODE="install" ;;
    --check)        MODE="check" ;;
    --remove)       MODE="remove" ;;
    --self-test)    MODE="self-test" ;;
    --dry-run)      DRY_RUN=1 ;;
    --no-owner-dm)  NO_OWNER_DM=1 ;;
    --project)   shift; PROJECT_ARG="${1:-}"
                 [ -n "$PROJECT_ARG" ] || { echo "error: --project needs a directory argument" >&2
                   echo "  Fix: run 'setup-athena-attend --project /path/to/project'." >&2; exit 1; } ;;
    -h|--help)   usage; exit 0 ;;
    *) echo "error: unknown argument: $1" >&2
       echo "  Fix: use --install (default), --check, --remove, --self-test, --project DIR, --dry-run," \
            "--no-owner-dm, --help." >&2
       exit 1 ;;
  esac
  shift
done

RUNNER_DIR="${ATHENA_ATTEND_RUNNER_DIR:-$(main_checkout_dir)}"
RUNNER="${RUNNER_DIR}/athena-channel-session.sh"
SELF_TEST="${SCRIPT_DIR}/test/athena-channel-session/self-test.sh"

# The channel dir whose SDK wire-conformance must pass live before we install
# the entries that start the session that registers the server (DND-283 ruling
# 1d). Defaults to the MAIN checkout's copy; seams (NPM/NODE/CHANNEL_DIR) let
# the self-test drive it with fakes.
main_channel_dir() {
  local common parent
  common="$(git -C "$SCRIPT_DIR" rev-parse --git-common-dir 2>/dev/null)" || { printf '%s' ""; return; }
  [ -n "$common" ] || { printf '%s' ""; return; }
  case "$common" in /*) ;; *) common="${SCRIPT_DIR}/${common}" ;; esac
  parent="$(dirname -- "$common")"
  printf '%s' "${parent}/ai/skills/athena:inbox/channel"
}
CHANNEL_DIR="${ATHENA_ATTEND_CHANNEL_DIR:-$(main_channel_dir)}"
NPM="${ATHENA_ATTEND_NPM:-npm}"
NODE="${ATHENA_ATTEND_NODE:-node}"

# run_sdk_conformance <install:0|1> -- run `sdk-conformance.mjs --live` in
# CHANNEL_DIR. With arg 1 (the --install path) it first runs `npm ci --omit=dev`
# so the SDK is present, then the live check; a non-zero exit (INCLUDING the
# exit-3 skip) is a refusal. With arg 0 (the --check path, which the header
# promises is READ-ONLY) it runs NEITHER npm ci NOR any filesystem mutation: it
# only reports the live result against whatever node_modules is already there,
# and the check's own exit-3 "LIVE SKIPPED -- node_modules absent" stands in for
# "not installed yet". It is the FIRED interop mechanism before live
# registration: an SDK protocol drift refuses the install rather than
# registering a shim the SDK cannot talk to.
run_sdk_conformance() {
  local do_install="${1:-1}"
  if [ -z "${CHANNEL_DIR}" ] || [ ! -d "${CHANNEL_DIR}" ]; then
    echo "error: channel dir not found: ${CHANNEL_DIR:-<unresolved>}" >&2
    echo "  Fix: run from the custom repo so the main checkout resolves, or set ATHENA_ATTEND_CHANNEL_DIR." >&2
    return 2
  fi
  if [ "${do_install}" = "1" ]; then
    if ! ( cd -- "${CHANNEL_DIR}" && "${NPM}" ci --omit=dev ) >/dev/null 2>&1; then
      echo "error: 'npm ci --omit=dev' failed in ${CHANNEL_DIR}" >&2
      echo "  Fix: run it there by hand to see why (it needs network and the committed package-lock.json); the SDK must install before live registration." >&2
      return 2
    fi
  fi
  local out rc
  out="$( cd -- "${CHANNEL_DIR}" && "${NODE}" test/sdk-conformance.mjs --live 2>&1 )"; rc=$?
  printf '%s\n' "${out}"
  return "${rc}"
}

say()  { printf '%s\n' "$*"; }
step() { printf '\n== %s\n' "$*"; }

# ---- self-test path --------------------------------------------------------
if [ "$MODE" = "self-test" ]; then
  if [ ! -x "$SELF_TEST" ]; then
    echo "error: self-test suite not found or not executable: $SELF_TEST" >&2
    echo "  Fix: restore scripts/test/athena-channel-session/self-test.sh and chmod +x it." >&2
    exit 2
  fi
  if bash "$SELF_TEST"; then say "ALL CASES PASS"; exit 0; fi
  echo "SELF-TEST FAILED" >&2
  echo "  Fix: read the failing case above, repair scripts/athena-channel-session.sh or this" \
       "installer, then re-run 'scripts/setup-athena-attend --self-test'." >&2
  exit 1
fi

# ---- resolve the project (absolute) ----------------------------------------
PROJECT_DIR="${PROJECT_ARG:-${ATHENA_ATTEND_PROJECT_DIR:-${HOME}/dev/walt_ui}}"
case "$PROJECT_DIR" in
  /*) PROJECT_ABS="$PROJECT_DIR" ;;
  *)  PROJECT_ABS="$(cd -- "$PROJECT_DIR" 2>/dev/null && pwd -P)" || PROJECT_ABS="$PROJECT_DIR" ;;
esac

# Bake the owner Slack id into the crontab entries themselves when it is set
# at install time (read from THIS process's own env, e.g. the §9.7 owner step).
# Cron runs a job with a minimal environment, so an id that lives only in the
# operator's interactive shell never reaches the cron-launched session, and
# athena-channel-session.sh's dm_owner silently no-ops
# (`[ -n "${ATHENA_ATTEND_OWNER_SLACK_ID:-}" ] || … return 0`) — the exact
# wedge/dark-attendant-never-alerts-the-owner class this installer exists to
# prevent. The VAR=value prefix goes BEFORE ${RUNNER} so the line still
# contains $MATCH (defined below) intact: the existing find/remove/idempotency
# logic keeps working unchanged whether an id is baked in, absent, or the
# --no-owner-dm marker comment is present instead.
#
# DND-288 build 2 (deny by default): a reminder that the operator SHOULD set
# this is not enforcement -- the T3 install let an unset id through silently,
# which is the same defect this whole ticket exists to close, one layer up.
# --install now REFUSES (below) unless the id validates or --no-owner-dm was
# passed explicitly; --check/--remove never enforce this (they take no id).
OWNER_SLACK_ID="${ATHENA_ATTEND_OWNER_SLACK_ID:-}"
OWNER_ID_RE='^U[A-Z0-9]{8,}$'
OWNER_ID_VALID=0
if [ -n "$OWNER_SLACK_ID" ] && printf '%s' "$OWNER_SLACK_ID" | grep -Eq -- "$OWNER_ID_RE"; then
  OWNER_ID_VALID=1
fi
NO_OWNER_DM_MARKER=" # ATHENA-NO-OWNER-DM (DND-288: owner DM explicitly disabled at install)"

if [ "$MODE" = "install" ]; then
  if [ -n "$OWNER_SLACK_ID" ] && [ "$OWNER_ID_VALID" -ne 1 ]; then
    echo "error: ATHENA_ATTEND_OWNER_SLACK_ID is malformed: '${OWNER_SLACK_ID}' (expected a Slack user id" \
         "matching ^U[A-Z0-9]{8,}\$). NOTHING was installed." >&2
    echo "  Fix: export a valid ATHENA_ATTEND_OWNER_SLACK_ID and re-run --install, or pass --no-owner-dm to" \
         "install without owner DMs (a loud warning is printed; wedge/dark/version-pin alerts go silent)." >&2
    exit 2
  fi
  if [ -z "$OWNER_SLACK_ID" ] && [ "$NO_OWNER_DM" -ne 1 ]; then
    echo "error: ATHENA_ATTEND_OWNER_SLACK_ID is unset — refusing to install. NOTHING was installed." >&2
    echo "  Fix: export ATHENA_ATTEND_OWNER_SLACK_ID=<your Slack user id> and re-run --install; the" \
         "attendant's wedge/dark/version-pin paths DM this id and cannot fire under cron without it." \
         "Pass --no-owner-dm to install anyway (a loud warning is printed; those DMs will be silent)." >&2
    exit 2
  fi
  if [ "$OWNER_ID_VALID" -ne 1 ] && [ "$NO_OWNER_DM" -eq 1 ]; then
    say "WARNING: installing with --no-owner-dm — wedge, dark-channel, and version-pin alerts will NOT" \
        "reach anyone. This is a deliberate, explicit choice; it is recorded in the crontab entry itself."
  fi
fi

if [ "$OWNER_ID_VALID" -eq 1 ]; then
  REBOOT_LINE="@reboot ATHENA_ATTEND_OWNER_SLACK_ID=${OWNER_SLACK_ID} ${RUNNER} --project ${PROJECT_ABS}"
  RELAUNCH_LINE="*/5 * * * * ATHENA_ATTEND_OWNER_SLACK_ID=${OWNER_SLACK_ID} ${RUNNER} --project ${PROJECT_ABS}"
elif [ "$NO_OWNER_DM" -eq 1 ]; then
  REBOOT_LINE="@reboot ${RUNNER} --project ${PROJECT_ABS}${NO_OWNER_DM_MARKER}"
  RELAUNCH_LINE="*/5 * * * * ${RUNNER} --project ${PROJECT_ABS}${NO_OWNER_DM_MARKER}"
else
  REBOOT_LINE="@reboot ${RUNNER} --project ${PROJECT_ABS}"
  RELAUNCH_LINE="*/5 * * * * ${RUNNER} --project ${PROJECT_ABS}"
fi

# ---- crontab access --------------------------------------------------------
command -v crontab >/dev/null 2>&1 || {
  echo "error: crontab not installed (need cronie/dcron)." >&2
  echo "  Fix: install cronie (Cody, as root: sudo emerge sys-process/cronie), then re-run." >&2
  exit 2
}
read_crontab() { crontab -l 2>/dev/null || true; }
put_crontab() {
  if [ "$DRY_RUN" -eq 1 ]; then
    say "  [dry-run] resulting crontab would be:"
    printf '%s\n' "$1" | sed 's/^/    /'
    return 0
  fi
  if printf '%s\n' "$1" | crontab -; then return 0; fi
  echo "error: writing the crontab failed — nothing was installed or removed." >&2
  echo "  Fix: the per-user spool dir is the usual cause. scripts/setup-shipwright-cron owns" \
       "the root repair for it; run that once (needs sudo, Cody's to run), then re-run and" \
       "confirm with 'scripts/setup-athena-attend --check'." >&2
  exit 2
}
# Match on the runner path AND this project's dir, so a second project's
# attendant entry is never touched.
MATCH="${RUNNER} --project ${PROJECT_ABS}"
without_our_entries() { printf '%s\n' "$1" | grep -vF -- "$MATCH" | sed '/^[[:space:]]*$/d'; }

# ---- check path (read-only) ------------------------------------------------
if [ "$MODE" = "check" ]; then
  current="$(read_crontab)"
  # Match by MATCH substring (RUNNER + project), not by exact line equality
  # against REBOOT_LINE/RELAUNCH_LINE: those are built from THIS invocation's
  # own ATHENA_ATTEND_OWNER_SLACK_ID env, which --check has no reason to share
  # with whatever was set at install time. An exact-line compare would report
  # a persisted-id entry as MISSING whenever --check runs with the id unset
  # (or a different id) in its own env — a false negative on the very state
  # this check exists to verify.
  reboot_actual="$(printf '%s\n' "$current" | grep -F -- "$MATCH" | grep -F -- '@reboot ' | head -1)"
  relaunch_actual="$(printf '%s\n' "$current" | grep -F -- "$MATCH" | grep -F -- '*/5 * * * *' | head -1)"
  have_reboot=0; have_relaunch=0
  [ -n "$reboot_actual" ]   && have_reboot=1
  [ -n "$relaunch_actual" ] && have_relaunch=1
  if [ "$have_reboot" -eq 1 ] && [ "$have_relaunch" -eq 1 ]; then
    say "OK — both channel-session crontab entries are installed for ${PROJECT_ABS}:"
    printf '%s\n' "$current" | grep -F -- "$MATCH" | sed 's/^/  /'
    # Three states, and they must never read the same (DND-288 build 3):
    # persisted (id baked in, shown masked), disabled (--no-owner-dm was used,
    # an explicit owner choice, not a warning), or NOT PERSISTED (a T3-era bare
    # line — a wedged/dark/version-pin DM will silently go nowhere under cron).
    if printf '%s\n%s\n' "$reboot_actual" "$relaunch_actual" | grep -q 'ATHENA_ATTEND_OWNER_SLACK_ID='; then
      found_id="$(printf '%s\n' "$reboot_actual" | grep -oE 'ATHENA_ATTEND_OWNER_SLACK_ID=[^ ]+' | cut -d= -f2)"
      say "  owner DM: persisted (id ${found_id%"${found_id#???}"}...) — wedge/dark/version-pin DMs can reach the owner under cron."
    elif printf '%s\n%s\n' "$reboot_actual" "$relaunch_actual" | grep -q 'ATHENA-NO-OWNER-DM'; then
      say "  owner DM: disabled (--no-owner-dm was used at install) — an explicit choice, not a fault."
    else
      {
        echo "WARNING — owner DM: NOT PERSISTED (installed before DND-288)."
        echo "  Cron runs with a minimal environment, so a wedged or dark attendant launched by" \
             "@reboot/*/5 will silently skip the owner DM (dm_owner no-ops when the var is unset) —" \
             "a wedge, dark, or version-pin fault will alert no one."
        echo "  Fix: re-run --install with ATHENA_ATTEND_OWNER_SLACK_ID set."
      } >&2
    fi
    # Report the live SDK interop result too (DND-283 ruling 1d). READ-ONLY on
    # --check (arg 0): NO npm ci, no filesystem mutation -- it reports against
    # whatever node_modules is already installed, and the check's exit-3 "LIVE
    # SKIPPED -- node_modules absent" stands in for "not installed yet". It is
    # informational: it never changes the crontab verdict.
    step "SDK wire-conformance (live, read-only) — informational"
    conf_out="$(run_sdk_conformance 0)"; conf_rc=$?
    if [ "${conf_rc}" -eq 0 ]; then
      printf '%s\n' "$conf_out" | sed 's/^/  /'
    elif [ "${conf_rc}" -eq 3 ]; then
      printf '%s\n' "$conf_out" | sed 's/^/  /'
      say "  (SDK not installed here yet; --install runs 'npm ci' then this check before registering)"
    else
      printf '%s\n' "$conf_out" | sed 's/^/  /' >&2
      say "  (the channel would REFUSE live registration until this passes)"
    fi
    exit 0
  fi
  {
    echo "MISSING — the Athena attendant is not durably scheduled for ${PROJECT_ABS}; nothing restarts it."
    [ "$have_reboot" -eq 1 ]   || echo "  missing: ${REBOOT_LINE}"
    [ "$have_relaunch" -eq 1 ] || echo "  missing: ${RELAUNCH_LINE}"
    echo "  Fix: run 'scripts/setup-athena-attend --project ${PROJECT_ABS}' to install both entries."
  } >&2
  exit 1
fi

# ---- remove path -----------------------------------------------------------
if [ "$MODE" = "remove" ]; then
  step "Removing the Athena attendant crontab entries for ${PROJECT_ABS}"
  current="$(read_crontab)"
  put_crontab "$(without_our_entries "$current")"
  say "Done. Any attendant already running is left alone; it simply will not be relaunched."
  say "Stop a running attendant by killing the pid in ~/.local/state/athena-attend/$(basename -- "$PROJECT_ABS")/attend.pid."
  exit 0
fi

# ---- install path — prerequisites ------------------------------------------
[ -x "$RUNNER" ] || {
  echo "error: runner not found or not executable in the main checkout: $RUNNER" >&2
  echo "  Fix: this branch's runner has not merged yet, or it is not chmod +x. Install after" \
       "the merge (the entry must name the main checkout, never a worktree), from anywhere." >&2
  exit 2
}
git -C "$PROJECT_ABS" rev-parse --git-dir >/dev/null 2>&1 || {
  echo "error: project dir is not a git repository: $PROJECT_ABS" >&2
  echo "  Fix: pass --project with the project's checkout. Inbox tenancy resolves from the" \
       "repo's git common dir, so a non-repo has no channels to attend." >&2
  exit 2
}
# Refuse to install an attendant for a project with no channels — that is the
# silent-dark class, and the installer is the earliest place to catch it.
INBOX_BIN_DIR="${ATHENA_ATTEND_INBOX_BIN_DIR:-$(cd -- "$(dirname -- "$RUNNER")/../ai/skills/athena:inbox/bin" 2>/dev/null && pwd -P || true)}"
if [ -n "$INBOX_BIN_DIR" ] && [ -x "${INBOX_BIN_DIR}/inbox-wait" ]; then
  if ! (cd -- "$PROJECT_ABS" && "${INBOX_BIN_DIR}/inbox-wait" --dry-run >/dev/null 2>&1); then
    echo "error: inbox-wait --dry-run refused for ${PROJECT_ABS} — it has no inbox channels." >&2
    echo "  Fix: opt the project into the Athena inbox first (a machine-local registry entry" \
         "under \$ATHENA_INBOX_ROOT/projects/; see scripts/setup-inbox-registry), then re-run." >&2
    exit 2
  fi
else
  say "note: could not locate inbox-wait to preflight ${PROJECT_ABS}'s channels; installing anyway."
fi

# SDK wire-conformance BEFORE the crontab entries that would start the session
# that registers the server live (DND-283 ruling 1d). npm ci + a real SDK
# handshake against server.mjs; a non-zero exit (incl. the exit-3 skip)
# ABORTS the install and registers nothing, with the check's own Fix: line.
step "SDK wire-conformance (live) — gate before install"
if conf_out="$(run_sdk_conformance)"; then
  printf '%s\n' "$conf_out" | sed 's/^/  /'
else
  conf_rc=$?
  printf '%s\n' "$conf_out" | sed 's/^/  /' >&2
  echo "error: SDK wire-conformance did not pass (exit ${conf_rc}); NOTHING was installed." >&2
  echo "  Fix: resolve the conformance failure above (regenerate the golden if the SDK pin" \
       "changed, or fix the shim), then re-run 'scripts/setup-athena-attend --install'." >&2
  exit 2
fi

step "Cron daemon"
if pgrep -x crond >/dev/null 2>&1 || pgrep -x cron >/dev/null 2>&1; then
  say "  running."
else
  say "  NOT running — the entries will install but nothing will fire them."
  say "  These need root, so they are Cody's to run:"
  say "    sudo rc-update add cronie default && sudo rc-service cronie start"
fi

step "Crontab entries"
current="$(read_crontab)"
kept="$(without_our_entries "$current")"
if [ -n "$kept" ]; then
  new_crontab="$(printf '%s\n%s\n%s' "$kept" "$REBOOT_LINE" "$RELAUNCH_LINE")"
else
  new_crontab="$(printf '%s\n%s' "$REBOOT_LINE" "$RELAUNCH_LINE")"
fi
put_crontab "$new_crontab"
if [ "$DRY_RUN" -eq 1 ]; then say "  [dry-run] would install:"; else say "  installed:"; fi
say "    ${REBOOT_LINE}"
say "    ${RELAUNCH_LINE}"
if [ -n "$kept" ]; then
  say "  preserved $(printf '%s\n' "$kept" | wc -l | tr -d ' ') unrelated crontab entr(y/ies)."
fi

step "Done"
say "Verify:    scripts/setup-athena-attend --check --project ${PROJECT_ABS}"
say "Start now: ${RUNNER} --project ${PROJECT_ABS}    (blocks; it is the standing channel session)"
say "           or wait for the */5 entry to pick it up."
