#!/usr/bin/env bash
#
# setup-athena.sh — provision the `athena` system user on this Gentoo box.
#
#   * user `athena`, home /home/athena, shell /bin/bash, NO sudo/wheel
#   * home is a dedicated btrfs subvolume with a 250 GB quota cap
#   * total RAM capped at 16 GB via cgroup v2 (hard cap, OOM-kill on exceed),
#     auto-enforced at login through libcgroup's cgrulesengd
#
# Run as root:  sudo ./setup-athena.sh
# Safe to re-run: every step checks current state before changing anything.

set -euo pipefail

# ---- tunables ---------------------------------------------------------------
USER_NAME="athena"
USER_HOME="/home/athena"
USER_SHELL="/bin/bash"
BTRFS_MOUNT="/home"          # the btrfs filesystem athena's home lives on
DISK_QUOTA="250G"            # hard cap on athena's home subvolume
RAM_MAX="16G"               # cgroup v2 memory.max (hard cap)
# -----------------------------------------------------------------------------

log()  { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[!]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[x]\033[0m %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die "must run as root (use sudo)"

# --- sanity: this script assumes btrfs + cgroup v2, as detected on this host ---
[ "$(stat -fc %T /sys/fs/cgroup)" = "cgroup2fs" ] \
  || die "/sys/fs/cgroup is not cgroup v2 (unified) — this script targets cgroup v2"
[ "$(findmnt -no FSTYPE --target "$BTRFS_MOUNT")" = "btrfs" ] \
  || die "$BTRFS_MOUNT is not btrfs — quota step assumes btrfs subvolumes"

# =============================================================================
# 1. btrfs subvolume for athena's home (must exist before useradd)
# =============================================================================
if btrfs subvolume show "$USER_HOME" >/dev/null 2>&1; then
  log "subvolume $USER_HOME already exists — skipping create"
elif [ -e "$USER_HOME" ]; then
  die "$USER_HOME exists but is NOT a btrfs subvolume — remove/rename it first"
else
  log "creating btrfs subvolume $USER_HOME"
  btrfs subvolume create "$USER_HOME"
fi

# =============================================================================
# 2. the user account (no wheel, no sudo)
# =============================================================================
if getent passwd "$USER_NAME" >/dev/null; then
  log "user $USER_NAME already exists — skipping useradd"
else
  log "creating user $USER_NAME (home=$USER_HOME, shell=$USER_SHELL, no sudo)"
  # -d points at the existing subvolume; NO -m so useradd doesn't clobber it.
  useradd -d "$USER_HOME" -s "$USER_SHELL" "$USER_NAME"
fi

# seed dotfiles only if the home looks empty (don't stomp an existing setup)
if [ -z "$(ls -A "$USER_HOME" 2>/dev/null)" ]; then
  log "seeding $USER_HOME from /etc/skel"
  cp -aT /etc/skel "$USER_HOME"
fi
chown -R "$USER_NAME":"$USER_NAME" "$USER_HOME"
chmod 700 "$USER_HOME"

# guard rail: make sure we did NOT grant sudo
if id -nG "$USER_NAME" | tr ' ' '\n' | grep -qxE 'wheel|sudo'; then
  die "$USER_NAME is in wheel/sudo — that should not happen; investigate"
fi
log "confirmed $USER_NAME has no sudo/wheel membership: $(id -nG "$USER_NAME")"

# =============================================================================
# 3. 250 GB disk quota via btrfs qgroup
# =============================================================================
# `quota enable` scans the whole filesystem; on a heavily-used fs this can take
# a while and add I/O load. It is idempotent, so re-running is harmless.
if btrfs qgroup show "$BTRFS_MOUNT" >/dev/null 2>&1; then
  log "btrfs quota already enabled on $BTRFS_MOUNT"
else
  log "enabling btrfs quota on $BTRFS_MOUNT (this scans the fs — may take a bit)"
  btrfs quota enable "$BTRFS_MOUNT"
fi

log "setting $DISK_QUOTA quota on $USER_HOME"
btrfs qgroup limit "$DISK_QUOTA" "$USER_HOME"
btrfs qgroup show -re "$USER_HOME" | sed 's/^/    /'

# =============================================================================
# 4. 16 GB RAM cap via cgroup v2 + libcgroup (cgrulesengd auto-placement)
# =============================================================================
# No systemd on this box, so there is no automatic per-user slice. libcgroup's
# cgrulesengd watches for processes owned by athena and drops them into a
# memory-limited cgroup v2 group.

if ! command -v cgrulesengd >/dev/null 2>&1; then
  log "installing dev-libs/libcgroup (provides cgconfigparser + cgrulesengd)"
  emerge --noreplace dev-libs/libcgroup
fi

log "writing /etc/cgconfig.conf (memory.max = $RAM_MAX for group '$USER_NAME')"
cat > /etc/cgconfig.conf <<EOF
# Managed by setup-athena.sh — cgroup v2 memory cap for $USER_NAME
group $USER_NAME {
    memory {
        memory.max = "$RAM_MAX";
    }
}
EOF

log "writing /etc/cgrules.conf (place $USER_NAME's processes into '$USER_NAME/')"
cat > /etc/cgrules.conf <<EOF
# Managed by setup-athena.sh
# <user>            <controllers>   <cgroup>
$USER_NAME          memory          $USER_NAME/
EOF

# apply the group definition now, then enable the daemon at boot
log "applying cgconfig and enabling services"
cgconfigparser -l /etc/cgconfig.conf || warn "cgconfigparser failed — check libcgroup version supports cgroup v2"

for svc in cgconfig cgrulesengd cgred; do
  if rc-service --exists "$svc" 2>/dev/null; then
    rc-update add "$svc" default 2>/dev/null || true
    rc-service "$svc" restart 2>/dev/null || rc-service "$svc" start 2>/dev/null || true
    log "service '$svc' enabled/started"
  fi
done

# =============================================================================
# 5. password (interactive only)
# =============================================================================
if passwd -S "$USER_NAME" 2>/dev/null | grep -q ' L '; then
  if [ -t 0 ]; then
    log "set a password for $USER_NAME:"
    passwd "$USER_NAME"
  else
    warn "account $USER_NAME has no password. Run:  passwd $USER_NAME"
  fi
fi

log "done."
cat <<EOF

Verify:
  groups $USER_NAME                              # -> only 'athena', no wheel/sudo
  btrfs qgroup show -re $USER_HOME               # -> max_rfer 250.00GiB
  # After athena logs in, from a root shell:
  cat /sys/fs/cgroup/$USER_NAME/memory.max       # -> $(numfmt --from=iec $RAM_MAX 2>/dev/null || echo "$RAM_MAX")
  cat /sys/fs/cgroup/$USER_NAME/cgroup.procs     # -> athena's PIDs appear here

Note: the 250 GB quota is a ceiling — athena can only use what is physically
free on $BTRFS_MOUNT ($(findmnt -no AVAIL --target "$BTRFS_MOUNT") available right now).
EOF
