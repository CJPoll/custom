#!/usr/bin/env bash
#
# setup-athena-docker — give the athena user ROOTLESS Docker (always-on).
#
# Rootless was chosen deliberately: athena must NOT have root. This does NOT
# add her to the `docker` group (that is root-equivalent). Instead she runs her
# own dockerd under her UID, launched at boot by an OpenRC service.
#
# Root, one-time. Run as root:  sudo ./setup-athena-docker  [--dry-run]
# Idempotent; safe to re-run. Prerequisite: run setup-athena-user first.
#
# What it does:
#   1. Accepts the ~amd64 keyword for sys-apps/rootlesskit (testing keyword).
#   2. Emerges rootlesskit + slirp4netns + fuse-overlayfs (the missing deps).
#   3. Ensures /etc/subuid + /etc/subgid ranges for athena.
#   4. `loginctl enable-linger athena` so /run/user/<uid> persists at boot.
#   5. Installs the docker-rootless-athena OpenRC service from system-files/.
#   6. Adds DOCKER_HOST / PATH to athena's ~/.bashrc so her CLI finds the socket.

set -euo pipefail

USER_NAME="athena"
SERVICE_NAME="docker-rootless-athena"
KEYWORD_ATOM="sys-apps/rootlesskit"
DEPS=(sys-apps/rootlesskit app-containers/slirp4netns sys-fs/fuse-overlayfs)
DRY_RUN=false

for arg in "$@"; do
  case "$arg" in
    --dry-run) DRY_RUN=true ;;
    -h|--help) sed -n '2,20p' "$0"; exit 0 ;;
    *) echo "unknown argument: $arg" >&2; exit 1 ;;
  esac
done

log()  { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[!]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[x]\033[0m %s\n' "$*" >&2; exit 1; }
run()  { if $DRY_RUN; then printf '    + %s\n' "$*"; else "$@"; fi; }

# system-files lives next to this script's repo checkout
SYSTEM_FILES="$(cd "$(dirname "${BASH_SOURCE[0]}")/../system-files" && pwd)" \
  || die "cannot locate system-files/ — run this from the custom repo checkout"
[ -f "$SYSTEM_FILES/$SERVICE_NAME.initd" ] \
  || die "missing $SYSTEM_FILES/$SERVICE_NAME.initd — run from the custom repo checkout"

[ "$(id -u)" -eq 0 ] || die "must run as root (use sudo)"
getent passwd "$USER_NAME" >/dev/null \
  || die "user $USER_NAME does not exist — run setup-athena-user first"
command -v loginctl >/dev/null || die "loginctl (elogind) not found — needed for linger"

# Guard the whole point of rootless: athena must not be in the docker group.
if grep -qx docker <<<"$(id -nG "$USER_NAME" | tr ' ' '\n')"; then
  die "$USER_NAME is in the 'docker' group — that is root-equivalent and defeats
      rootless mode. Remove her first:  gpasswd -d $USER_NAME docker"
fi

# --- 1. accept the ~amd64 keyword for rootlesskit ----------------------------
KW_DIR="/etc/portage/package.accept_keywords"
if [ -d "$KW_DIR" ]; then
  KW_FILE="$KW_DIR/athena-docker"
else
  KW_FILE="$KW_DIR"   # single-file form
fi
if [ -e "$KW_FILE" ] && grep -qE "^\s*${KEYWORD_ATOM//\//\\/}\s+~amd64" "$KW_FILE" 2>/dev/null; then
  log "keyword for $KEYWORD_ATOM already accepted"
else
  log "accepting ~amd64 keyword for $KEYWORD_ATOM in $KW_FILE"
  if $DRY_RUN; then
    printf '    + echo "%s ~amd64" >> %s\n' "$KEYWORD_ATOM" "$KW_FILE"
  else
    printf '%s ~amd64\n' "$KEYWORD_ATOM" >> "$KW_FILE"
  fi
fi

# --- 2. emerge the missing rootless dependencies -----------------------------
missing=()
command -v rootlesskit    >/dev/null || missing+=("sys-apps/rootlesskit")
command -v slirp4netns    >/dev/null || missing+=("app-containers/slirp4netns")
command -v fuse-overlayfs >/dev/null || missing+=("sys-fs/fuse-overlayfs")
if [ "${#missing[@]}" -eq 0 ]; then
  log "rootless deps already installed (rootlesskit, slirp4netns, fuse-overlayfs)"
else
  log "emerging: ${missing[*]}"
  run emerge --verbose --noreplace "${missing[@]}"
fi

# --- 3. subuid / subgid ranges ------------------------------------------------
for f in /etc/subuid /etc/subgid; do
  if grep -q "^${USER_NAME}:" "$f" 2>/dev/null; then
    log "$(basename "$f") already has a range for $USER_NAME"
  else
    log "adding $USER_NAME range to $f"
    run sh -c "printf '%s:165536:65536\n' '$USER_NAME' >> '$f'"
  fi
done

# --- 4. persistent runtime dir via linger ------------------------------------
if grep -q 'Linger=yes' <<<"$(loginctl show-user "$USER_NAME" -p Linger 2>/dev/null)"; then
  log "lingering already enabled for $USER_NAME"
else
  log "enabling linger for $USER_NAME (creates /run/user/<uid> at boot)"
  run loginctl enable-linger "$USER_NAME"
fi

# --- 5. install the OpenRC service -------------------------------------------
log "installing /etc/init.d/$SERVICE_NAME"
run install -m 755 "$SYSTEM_FILES/$SERVICE_NAME.initd" "/etc/init.d/$SERVICE_NAME"
if [ -e "/etc/conf.d/$SERVICE_NAME" ]; then
  log "keeping existing /etc/conf.d/$SERVICE_NAME"
else
  run install -m 644 "$SYSTEM_FILES/$SERVICE_NAME.confd" "/etc/conf.d/$SERVICE_NAME"
fi
run rc-update add "$SERVICE_NAME" default
if $DRY_RUN; then
  printf '    + rc-service %s restart\n' "$SERVICE_NAME"
elif rc-service "$SERVICE_NAME" status >/dev/null 2>&1; then
  rc-service "$SERVICE_NAME" restart
else
  rc-service "$SERVICE_NAME" start || warn "service did not start yet — check: rc-service $SERVICE_NAME status"
fi

# --- 6. athena's shell env (so her `docker` CLI targets her rootless socket) --
BASHRC="/home/$USER_NAME/.bashrc"
MARKER="# >>> rootless docker (setup-athena-docker) >>>"
if [ -e "$BASHRC" ] && grep -qF "$MARKER" "$BASHRC"; then
  log "rootless docker env already present in $BASHRC"
else
  log "adding rootless docker env to $BASHRC"
  if $DRY_RUN; then
    printf '    + append DOCKER_HOST/PATH block to %s\n' "$BASHRC"
  else
    cat >> "$BASHRC" <<'EOF'

# >>> rootless docker (setup-athena-docker) >>>
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DOCKER_HOST="unix://${XDG_RUNTIME_DIR}/docker.sock"
export PATH="/usr/sbin:/usr/bin:$PATH"
# <<< rootless docker (setup-athena-docker) <<<
EOF
    chown "$USER_NAME":"$USER_NAME" "$BASHRC"
  fi
fi

log "done."
cat <<EOF

Verify (once the service is up):
  rc-service $SERVICE_NAME status
  ls -l /run/user/$(id -u "$USER_NAME" 2>/dev/null)/docker.sock   # owned by $USER_NAME
  # as athena (fresh login so ~/.bashrc is sourced):
  docker info | grep -i 'rootless\\|Cgroup'                       # 'rootless: true'
  docker run --rm hello-world

Notes:
  * athena is intentionally NOT in the 'docker' group — she cannot touch the
    system root daemon. Her containers run under her UID only.
  * Without cgroup v2 delegation, per-container cpu/mem limits are disabled
    (a dockerd warning). Her total footprint is still bounded by the 16 GB
    user cgroup from setup-athena-user.
EOF
