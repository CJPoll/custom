#!/usr/bin/env bash
#
# setup-github-runner — install the self-hosted GitHub Actions runner agent for
# the `github-runner` user and its OpenRC service. Does NOT register (that needs
# a repo token, which is yours to mint) and does NOT start (the service refuses
# to start until registered).
#
# Run as root:  sudo scripts/setup-github-runner  [--dry-run] [--url <repo-url>]
# Idempotent. Prerequisites: setup-github-runner-user, setup-github-runner-docker.
#
# Steps: resolve the latest linux-x64 runner release; download + checksum +
# unpack it into ~github-runner/actions-runner (owned by github-runner); add the
# .NET invariant-globalization export to the user's ~/.bashrc so config.sh works
# on Gentoo without ICU; install the github-runner OpenRC service; rc-update add
# (not start). Then it prints the exact register + start commands.

set -euo pipefail

USER_NAME="github-runner"
RUNNER_DIR="/home/github-runner/actions-runner"
SERVICE_NAME="github-runner"
REPO_URL="https://github.com/CJPoll/gen_saas"
DRY_RUN=false

usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,"");print;next} {exit}' "$0"; }
while [ $# -gt 0 ]; do case "$1" in
  --dry-run) DRY_RUN=true ;;
  --url) shift; REPO_URL="${1:?--url needs a value}" ;;
  --url=*) REPO_URL="${1#*=}" ;;
  -h|--help) usage; exit 0 ;;
  *) echo "unknown argument: $1" >&2; usage >&2; exit 1 ;;
esac; shift; done

log()  { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[!]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[x]\033[0m %s\n' "$*" >&2; exit 1; }
run()  { if $DRY_RUN; then printf '    + %s\n' "$*"; else "$@"; fi; }

SYSTEM_FILES="$(cd "$(dirname "${BASH_SOURCE[0]}")/../system-files" && pwd)" \
  || die "cannot locate system-files/ — run from the custom repo checkout"
[ -f "$SYSTEM_FILES/$SERVICE_NAME.initd" ] \
  || die "missing $SYSTEM_FILES/$SERVICE_NAME.initd — run from the custom repo checkout"

[ "$(id -u)" -eq 0 ] || die "must run as root (use sudo)"
getent passwd "$USER_NAME" >/dev/null \
  || die "user $USER_NAME does not exist — run setup-github-runner-user first"
command -v curl >/dev/null || die "curl not found"
command -v tar  >/dev/null || die "tar not found"

# --- 1. resolve latest linux-x64 runner release ------------------------------
log "resolving latest actions/runner release"
json="$(curl -fsSL https://api.github.com/repos/actions/runner/releases/latest)" \
  || die "could not query the actions/runner releases API"
url="$(printf '%s' "$json" | grep -Eo 'https://[^"]*actions-runner-linux-x64-[0-9.]+\.tar\.gz' | head -1)"
[ -n "$url" ] || die "could not find a linux-x64 asset in the latest release"
ver="$(printf '%s' "$url" | sed -E 's#.*linux-x64-([0-9.]+)\.tar\.gz#\1#')"
log "latest runner: $ver"

if [ -x "$RUNNER_DIR/run.sh" ] && [ -f "$RUNNER_DIR/.runner" ]; then
  log "runner already installed AND registered at $RUNNER_DIR — leaving as-is"
  installed=true
else
  installed=false
  tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
  tarball="$tmp/actions-runner-linux-x64-${ver}.tar.gz"
  log "downloading $url"
  run curl -fsSL -o "$tarball" "$url"
  if ! $DRY_RUN; then
    log "sha256: $(sha256sum "$tarball" | cut -d' ' -f1)  (compare with GitHub's published hash if you want)"
  fi
  log "unpacking into $RUNNER_DIR (owned by $USER_NAME)"
  run install -d -o "$USER_NAME" -g "$USER_NAME" "$RUNNER_DIR"
  run tar xzf "$tarball" -C "$RUNNER_DIR"
  run chown -R "$USER_NAME":"$USER_NAME" "$RUNNER_DIR"
fi

# --- 2. .NET invariant export so config.sh/run.sh work on Gentoo w/o ICU -----
BASHRC="/home/$USER_NAME/.bashrc"
MARKER="# >>> github runner (.NET invariant) >>>"
if [ -e "$BASHRC" ] && grep -qF "$MARKER" "$BASHRC"; then
  log "invariant-globalization env already present in $BASHRC"
else
  log "adding DOTNET_SYSTEM_GLOBALIZATION_INVARIANT to $BASHRC"
  if $DRY_RUN; then printf '    + append DOTNET invariant export to %s\n' "$BASHRC"
  else
    cat >> "$BASHRC" <<'EOF'

# >>> github runner (.NET invariant) >>>
export DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1
# <<< github runner (.NET invariant) <<<
EOF
    chown "$USER_NAME":"$USER_NAME" "$BASHRC"
  fi
fi

# --- 3. install the OpenRC service (do NOT start until registered) -----------
log "installing /etc/init.d/$SERVICE_NAME"
run install -m 755 "$SYSTEM_FILES/$SERVICE_NAME.initd" "/etc/init.d/$SERVICE_NAME"
if [ -e "/etc/conf.d/$SERVICE_NAME" ]; then
  log "keeping existing /etc/conf.d/$SERVICE_NAME"
else
  run install -m 644 "$SYSTEM_FILES/$SERVICE_NAME.confd" "/etc/conf.d/$SERVICE_NAME"
fi
run rc-update add "$SERVICE_NAME" default

log "done."
cat <<EOF

Runner installed at $RUNNER_DIR (not yet registered). To finish:

  1. Mint a registration token (as your normal user, with gh auth):
       TOKEN=\$(gh api --method POST repos/CJPoll/gen_saas/actions/runners/registration-token --jq .token)
     (or: repo → Settings → Actions → Runners → New self-hosted runner)

  2. Register AS the runner user:
       sudo -u $USER_NAME env DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1 \\
         $RUNNER_DIR/config.sh --url $REPO_URL \\
         --token "\$TOKEN" --labels self-hosted,linux,x64 --unattended

  3. Start it (and it will boot from now on):
       sudo rc-service $SERVICE_NAME start
       sudo rc-service $SERVICE_NAME status

Then the runner shows "idle" under the repo's Settings → Actions → Runners, and
Phase 3 (flipping the workflows to runs-on: [self-hosted, linux, x64]) can land.

Note: GitHub's ./bin/installdependencies.sh is apt/yum-based and does NOT work on
Gentoo. The service runs .NET in invariant mode to avoid ICU; if config.sh still
complains about a missing shared library, emerge that lib and retry.
EOF
