#!/usr/bin/env bash
#
# setup-github-runner-docker — give the `github-runner` user ROOTLESS Docker.
#
# The self-hosted Actions runner's jobs are Docker-heavy (build/push image,
# then run the gate inside it). github-runner runs its OWN dockerd under its
# UID — NOT the root-equivalent `docker` group. Mirrors setup-athena-docker.
#
# Run as root:  sudo scripts/setup-github-runner-docker  [--dry-run]
# Idempotent; safe to re-run. Prerequisite: run setup-github-runner-user first.
#
# Steps: accept ~amd64 for rootlesskit; emerge rootlesskit + slirp4netns +
# fuse-overlayfs (skipped if already present from another rootless user);
# ensure /etc/subuid + /etc/subgid ranges; loginctl enable-linger; install the
# docker-rootless-github-runner OpenRC service; add DOCKER_HOST to the user's
# ~/.bashrc.

set -euo pipefail

USER_NAME="github-runner"
SERVICE_NAME="docker-rootless-github-runner"
KEYWORD_ATOM="sys-apps/rootlesskit"
SUBID_RANGE="231072:65536"   # next 64K block after athena's 165536:65536 (no overlap)
DRY_RUN=false

usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,"");print;next} {exit}' "$0"; }
for a in "$@"; do case "$a" in
  --dry-run) DRY_RUN=true ;;
  -h|--help) usage; exit 0 ;;
  *) echo "unknown argument: $a" >&2; usage >&2; exit 1 ;;
esac; done

log()  { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[!]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[x]\033[0m %s\n' "$*" >&2; exit 1; }
run()  { if $DRY_RUN; then printf '    + %s\n' "$*"; else "$@"; fi; }

SYSTEM_FILES="$(cd "$(dirname "${BASH_SOURCE[0]}")/../system-files" && pwd)" \
  || die "cannot locate system-files/ — run from the custom repo checkout"
[ -f "$SYSTEM_FILES/$SERVICE_NAME.initd" ] \
  || die "missing $SYSTEM_FILES/$SERVICE_NAME.initd — run from the custom repo checkout"

[ "$(id -u)" -eq 0 ] || die "must run as root (use sudo)"
getent passwd "$USER_NAME" >/dev/null \
  || die "user $USER_NAME does not exist — run setup-github-runner-user first"
command -v loginctl >/dev/null || die "loginctl (elogind) not found — needed for linger"

if grep -qx docker <<<"$(id -nG "$USER_NAME" | tr ' ' '\n')"; then
  die "$USER_NAME is in the 'docker' group — root-equivalent, defeats rootless.
      Remove it:  gpasswd -d $USER_NAME docker"
fi

# --- 1. accept ~amd64 keyword for rootlesskit --------------------------------
KW_DIR="/etc/portage/package.accept_keywords"
if [ -d "$KW_DIR" ]; then KW_FILE="$KW_DIR/github-runner-docker"; else KW_FILE="$KW_DIR"; fi
if [ -e "$KW_FILE" ] && grep -qE "^\s*${KEYWORD_ATOM//\//\\/}\s+~amd64" "$KW_FILE" 2>/dev/null; then
  log "keyword for $KEYWORD_ATOM already accepted"
else
  log "accepting ~amd64 keyword for $KEYWORD_ATOM in $KW_FILE"
  if $DRY_RUN; then printf '    + echo "%s ~amd64" >> %s\n' "$KEYWORD_ATOM" "$KW_FILE"
  else printf '%s ~amd64\n' "$KEYWORD_ATOM" >> "$KW_FILE"; fi
fi

# --- 2. emerge rootless deps (skipped if already present) --------------------
missing=()
command -v rootlesskit    >/dev/null || missing+=("sys-apps/rootlesskit")
command -v slirp4netns    >/dev/null || missing+=("app-containers/slirp4netns")
command -v fuse-overlayfs >/dev/null || missing+=("sys-fs/fuse-overlayfs")
if [ "${#missing[@]}" -eq 0 ]; then
  log "rootless deps already installed"
else
  log "emerging: ${missing[*]}"
  run emerge --verbose --noreplace "${missing[@]}"
fi

# --- 3. subuid / subgid ranges (non-overlapping) -----------------------------
for f in /etc/subuid /etc/subgid; do
  if grep -q "^${USER_NAME}:" "$f" 2>/dev/null; then
    log "$(basename "$f") already has a range for $USER_NAME"
  else
    log "adding $USER_NAME range ($SUBID_RANGE) to $f"
    run sh -c "printf '%s:%s\n' '$USER_NAME' '$SUBID_RANGE' >> '$f'"
  fi
done

# --- 4. persistent runtime dir via linger ------------------------------------
if grep -q 'Linger=yes' <<<"$(loginctl show-user "$USER_NAME" -p Linger 2>/dev/null)"; then
  log "lingering already enabled for $USER_NAME"
else
  log "enabling linger for $USER_NAME (creates /run/user/<uid> at boot)"
  run loginctl enable-linger "$USER_NAME"
fi

# --- 5. install the OpenRC service -------------------------------------------
log "installing /etc/init.d/$SERVICE_NAME"
run install -m 755 "$SYSTEM_FILES/$SERVICE_NAME.initd" "/etc/init.d/$SERVICE_NAME"
if [ -e "/etc/conf.d/$SERVICE_NAME" ]; then
  log "keeping existing /etc/conf.d/$SERVICE_NAME"
else
  run install -m 644 "$SYSTEM_FILES/$SERVICE_NAME.confd" "/etc/conf.d/$SERVICE_NAME"
fi
run rc-update add "$SERVICE_NAME" default
if $DRY_RUN; then printf '    + rc-service %s restart\n' "$SERVICE_NAME"
elif rc-service "$SERVICE_NAME" status >/dev/null 2>&1; then rc-service "$SERVICE_NAME" restart
else rc-service "$SERVICE_NAME" start || warn "not started yet — check: rc-service $SERVICE_NAME status"; fi

# --- 6. user's shell env (so its `docker` CLI targets its rootless socket) ----
BASHRC="/home/$USER_NAME/.bashrc"
MARKER="# >>> rootless docker (setup-github-runner-docker) >>>"
if [ -e "$BASHRC" ] && grep -qF "$MARKER" "$BASHRC"; then
  log "rootless docker env already present in $BASHRC"
else
  log "adding rootless docker env to $BASHRC"
  if $DRY_RUN; then printf '    + append DOCKER_HOST/PATH block to %s\n' "$BASHRC"
  else
    cat >> "$BASHRC" <<'EOF'

# >>> rootless docker (setup-github-runner-docker) >>>
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
export DOCKER_HOST="unix://${XDG_RUNTIME_DIR}/docker.sock"
export PATH="/usr/sbin:/usr/bin:$PATH"
# <<< rootless docker (setup-github-runner-docker) <<<
EOF
    chown "$USER_NAME":"$USER_NAME" "$BASHRC"
  fi
fi

log "done. Next: sudo scripts/setup-github-runner"
cat <<EOF

Verify (once the service is up):
  rc-service $SERVICE_NAME status
  ls -l /run/user/$(id -u "$USER_NAME" 2>/dev/null)/docker.sock   # owned by $USER_NAME
EOF
