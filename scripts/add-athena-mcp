#!/usr/bin/env bash
# add-athena-mcp - Register the hosted Athena MCP server (gen_saas apps/athena,
#                  HG-3 / DND-295) for the CURRENT project, at local scope.
#
# The server is HTTP (Streamable HTTP), mounted at /mcp on the Athena endpoint
# (decision D5: server-hosted, not a local stdio shim). Authentication is the
# machine token the inbox client already holds — there is NEVER a second copy of
# the token. The registered config references the token through the environment
# variable ${ATHENA_MCP_BEARER}, expanded by Claude Code at MCP-connect time, so
# the literal token is not written into ~/.claude.json. The one source of truth
# for the token stays ~/.config/athena-inbox-client/config.json; the claude
# launcher `scripts/athena` exports ${ATHENA_MCP_BEARER} from that file, scoped
# to the launch (not a shell profile), so the token is not in every shell's env.
#
# Local scope keys off the current directory, so run this from the project's
# MAIN checkout (where you start `claude`), not from a worktree.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# The single source of truth for the machine token: the inbox client's config.
INBOX_CONFIG="$HOME/.config/athena-inbox-client/config.json"

# The env var the registered header references. Named generically (no
# TOKEN/KEY/SECRET/API): Claude Code is REPORTED to refuse expanding
# credential-shaped variable names into MCP config (per the claude-code-guide,
# DND-295 — NOT independently verified against live MCP-connect behavior; HG-4
# is to confirm). If that refusal turns out not to apply, this naming is moot
# but harmless; either way an UNexpanded header reaches the server as a literal
# and is answered 401 (a loud failure, never a silent-dark channel).
ENV_VAR="ATHENA_MCP_BEARER"

SERVER="athena"
DEFAULT_URL="https://athena.cjpoll.me/mcp"

MCP_URL=""
DRY_RUN=false

die() { echo "add-athena-mcp: $*" >&2; exit 1; }

usage() {
    cat <<'EOF'
add-athena-mcp - register the hosted Athena MCP server for the current project

Usage:
  add-athena-mcp [--url URL] [--dry-run] [-h|--help]

Options:
  --url URL   Override the /mcp URL. Default is derived from the inbox client's
              server_url, else https://athena.cjpoll.me/mcp.
  --dry-run   Print the claude mcp command that would run, without running it.
  -h, --help  Show this help.

How the token is handled (never a second copy):
  * The server authenticates with the machine token in
    ~/.config/athena-inbox-client/config.json (the SAME token the inbox client
    uses). This script does NOT copy it into ~/.claude.json.
  * The registered header is:  Authorization: Bearer ${ATHENA_MCP_BEARER}
    Claude Code expands ${ATHENA_MCP_BEARER} from the environment at connect
    time. The claude launcher `scripts/athena` already exports it from the config
    file, scoped to the launch (NOT a shell profile), so the token stays out of
    every interactive shell's environment. If you launch claude another way,
    export it yourself from that one source of truth:

      export ATHENA_MCP_BEARER="$(jq -r .token "$HOME/.config/athena-inbox-client/config.json")"

Notes:
  * Adds the server at LOCAL scope (this project only), keyed by current dir.
    Run it from the project's MAIN checkout, not a worktree.
  * Re-running replaces the existing local entry (safe to run again to update).
  * A running Claude session must be restarted to pick up the new server.
  * Launch claude via `scripts/athena`, which exports ${ATHENA_MCP_BEARER} from
    the inbox config (and hard-fails loudly if the token is missing). If it is
    unset at connect time the server answers 401 (a loud failure, not a
    silent-dark channel).

Exit codes:
  0  success        1  usage / missing config / setup error
EOF
}

# ---- parse args (order-independent). --help does nothing else. ----
while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)  usage; exit 0 ;;
        --dry-run)  DRY_RUN=true ;;
        --url)      shift; [ $# -gt 0 ] || die "--url needs a value"; MCP_URL="$1" ;;
        --url=*)    MCP_URL="${1#--url=}" ;;
        *)          die "unknown argument: $1 (see --help)" ;;
    esac
    shift
done

# ---- resolve the /mcp URL: --url wins, else derive from the inbox config, else default ----
derive_url_from_config() {
    # server_url looks like wss://athena.cjpoll.me/machine/websocket?vsn=2.0.0
    # -> https://<host>/mcp
    [ -r "$INBOX_CONFIG" ] || return 1
    local host
    if command -v jq >/dev/null 2>&1; then
        host="$(jq -r '.server_url // empty' "$INBOX_CONFIG" 2>/dev/null \
            | sed -E 's#^[a-z]+://##; s#[/?].*$##')"
    else
        host="$(grep -oE '"server_url"[[:space:]]*:[[:space:]]*"[^"]+"' "$INBOX_CONFIG" \
            | sed -E 's#.*://##; s#[/?"].*$##')"
    fi
    [ -n "$host" ] || return 1
    printf 'https://%s/mcp' "$host"
}

if [ -z "$MCP_URL" ]; then
    MCP_URL="$(derive_url_from_config || true)"
    [ -n "$MCP_URL" ] || MCP_URL="$DEFAULT_URL"
fi

HEADER="Authorization: Bearer \${${ENV_VAR}}"

# ---- dry run: print exactly what would be written, resolve nothing secret ----
if $DRY_RUN; then
    echo "# would run (in $(pwd)):"
    echo "claude mcp remove $SERVER -s local        # ignore error if not present"
    echo "claude mcp add --transport http $SERVER $MCP_URL --header '$HEADER'"
    echo
    echo "# token is referenced via \${${ENV_VAR}} (never written to config)."
    echo "# The claude launcher scripts/athena exports it from the inbox config, scoped"
    echo "# to the launch. To launch claude another way, export it yourself:"
    echo "export ${ENV_VAR}=\"\$(jq -r .token \"$INBOX_CONFIG\")\""
    exit 0
fi

# ---- sanity checks (only for a real apply) ----
command -v claude >/dev/null 2>&1 || die "'claude' CLI not found on PATH"
[ -r "$INBOX_CONFIG" ] || die "inbox client config missing/unreadable: $INBOX_CONFIG
  The Athena MCP reuses the machine token the inbox client holds. Set the inbox
  client up first (scripts/setup-athena-inbox-client)."

# Verify a token is actually present so we fail loudly now, not at connect time.
if command -v jq >/dev/null 2>&1; then
    tok="$(jq -r '.token // empty' "$INBOX_CONFIG" 2>/dev/null || true)"
    [ -n "$tok" ] || die "no .token in $INBOX_CONFIG (cannot authenticate the MCP server)"
    unset tok
fi

if [ -f .git ]; then
    echo "add-athena-mcp: warning: current directory looks like a git worktree." >&2
    echo "            Local scope keys off this path; sessions usually launch" >&2
    echo "            from the MAIN checkout. Continuing anyway." >&2
fi

# ---- apply (idempotent: drop any existing local entry, then add fresh) ----
claude mcp remove "$SERVER" -s local >/dev/null 2>&1 || true
claude mcp add --transport http "$SERVER" "$MCP_URL" --header "$HEADER"

echo
echo "Added '$SERVER' -> $MCP_URL"
echo "  project: $(pwd)"
echo "  auth:    Authorization: Bearer \${${ENV_VAR}}  (token NOT stored in config)"
echo
echo "The launcher scripts/athena exports ${ENV_VAR} from the inbox config (scoped"
echo "to the launch). To launch claude another way, export it yourself:"
echo "  export ${ENV_VAR}=\"\$(jq -r .token \"$INBOX_CONFIG\")\""
echo
echo "Status:"
claude mcp get "$SERVER" 2>&1 | sed 's/^/  /' || true
echo
echo "Note: restart a running Claude session (via scripts/athena) to load the new"
echo "      server, so ${ENV_VAR} is present in that session's environment."
