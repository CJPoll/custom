#!/usr/bin/env bash
#
# setup-clustering-cron — install, check or remove the 12h epic-clustering cron
# entry, which runs scripts/athena-clustering-run.sh (DND-983).
#
# Idempotent: re-running updates the schedule in place and never duplicates the
# line. It changes only its own line; every other crontab line is kept, a
# commented-out entry or a longer path such as <runner>.bak included. It
# always installs the MAIN checkout's runner path, even when run from a
# worktree, because a worktree path vanishes on cleanup. It needs no root.
#
# Usage:
#   setup-clustering-cron [--schedule "<cron expr>"] [--dry-run]
#   setup-clustering-cron --check          read-only: exit 0 if the entry is live and a tick could
#                                          start (the skill is in the main checkout, the MCP
#                                          preflight passes, and the runner's own --dry-run
#                                          passes); 1 if the entry is not live, 2 skill missing,
#                                          NOT REGISTERED, or the runner's --dry-run refuses,
#                                          4 COULD NOT LOOK
#   setup-clustering-cron --remove [--dry-run]
#   setup-clustering-cron --backup <file>  snapshot the current crontab to <file>
#   setup-clustering-cron --help
#
# Schedule: default "0 7,19 * * *". Cron reads it in the machine's local time,
# which here is America/Denver, so the runs are 07:00 (the morning run, which
# also sends the daily digest) and 19:00 Denver all year. cronie follows DST:
# that is 13:00 and 01:00 UTC under MDT (March to November) and 14:00 and 02:00
# UTC under MST. Neither time falls in the 02:00 changeover hour, so no run is
# skipped or doubled on a DST day. On a machine in another timezone, pass a
# --schedule that lands a run in the Denver morning; the runner decides the
# digest from the Denver clock itself.
#
# The MCP preflight (DND-1571). --check, the install and --dry-run run the
# runner's own MCP preflight, scripts/lib/mcp-preflight.sh, the function its
# preconditions call: notion-personal and athena registered for the main
# checkout in Claude Code's config (CLUSTERING_CLAUDE_JSON, default
# ~/.claude.json). NOT REGISTERED (exit 2) names each missing server and the
# command that registers it; COULD NOT LOOK (exit 4) is jq missing, or the
# config missing, unreadable or not valid JSON. The install refuses before any
# write. --remove and --backup never run it.
#
# The runner's own --dry-run (DND-1728). After those checks pass, --check, the
# install and --dry-run run the main checkout's runner with --dry-run
# (read-only) and refuse with exit 2 when it refuses, quoting its reason and
# its Fix:. It checks what this installer does not, such as the scripts/lib
# files a tick loads (dbus-env.sh). --remove and --backup never run it.
#
# Environment: CLUSTERING_CLAUDE_JSON  Claude Code's config (the runner's seam)
#
# Exit codes: 0 ok · 1 entry missing (--check) or usage error · 2 a prerequisite
# is missing (an MCP server NOT REGISTERED included), the runner's own
# --dry-run refuses, or the current crontab could not be read · 4 COULD NOT LOOK: the MCP preflight could not read Claude
# Code's config (or jq, or the preflight library, is missing)

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd -P)"
SCHEDULE="0 7,19 * * *"
DRY_RUN=0; REMOVE=0; CHECK=0; BACKUP_FILE=""

usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,"");print;next} {exit}' "$0"; }
die() { # <exit> <message> <fix>
  echo "setup-clustering-cron: $2" >&2
  echo "  Fix: $3" >&2
  exit "$1"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --schedule) shift; [ $# -gt 0 ] || die 1 "--schedule needs a value" 'pass five cron fields, e.g. --schedule "0 7,19 * * *"'; SCHEDULE="$1" ;;
    --schedule=*) SCHEDULE="${1#*=}" ;;
    --remove)  REMOVE=1 ;;
    --check)   CHECK=1 ;;
    --backup)  shift; [ $# -gt 0 ] || die 1 "--backup needs a file path" "pass a path outside git, e.g. --backup ~/crontab.bak"; BACKUP_FILE="$1" ;;
    --backup=*) BACKUP_FILE="${1#*=}" ;;
    --dry-run) DRY_RUN=1 ;;
    -h|--help) usage; exit 0 ;;
    *) die 1 "unknown argument: $1" "run with --help for the accepted flags." ;;
  esac
  shift
done

# shellcheck disable=SC2086
set -f; set -- ${SCHEDULE}; set +f
[ $# -eq 5 ] || die 1 "--schedule '${SCHEDULE}' is not five cron fields" 'pass five fields, e.g. --schedule "0 7,19 * * *"'

command -v crontab >/dev/null 2>&1 || die 2 "crontab is not installed" "install cronie (the shipwright cron uses it too)."

# The shared crontab helpers: which lines are ours (DND-1503), the one crontab
# reader (DND-1638) and the main-checkout resolver (DND-1639, DND-1642). This
# installer's own copy; sourced before the resolver runs.
CRON_ENTRY_LIB="${SCRIPT_DIR}/lib/cron-entry.sh"
[ -r "${CRON_ENTRY_LIB}" ] || die 2 "${CRON_ENTRY_LIB} is missing; without it no crontab line can be told apart as ours" \
  "restore scripts/lib/cron-entry.sh (fast-forward this checkout to a main that has it), then re-run. Nothing was written."
# shellcheck source=scripts/lib/cron-entry.sh
. "${CRON_ENTRY_LIB}"

# The main checkout's runner. A resolution failure exits 2 with a Fix: at its
# source (cron_main_checkout), never a relative path found later.
cron_main_checkout "${SCRIPT_DIR}" setup-clustering-cron || exit 2
MAIN_CHECKOUT="${CRON_MAIN_CHECKOUT}"
RUNNER="${MAIN_CHECKOUT}/scripts/athena-clustering-run.sh"
SKILL_FILE="${MAIN_CHECKOUT}/ai/skills/athena:epic-clustering/SKILL.md"
SKILL_MISSING_WHY="the athena:epic-clustering skill is not in the main checkout (${SKILL_FILE})"
SKILL_MISSING_FIX="land DND-982 on main and fast-forward ${MAIN_CHECKOUT} first. Without the skill every tick fails."
CLAUDE_JSON="${CLUSTERING_CLAUDE_JSON:-${HOME}/.claude.json}"
# The MAIN checkout's copy: the one the cron runner sources, whichever tree
# this installer runs from (a branch's copy may hold other rules).
PREFLIGHT_LIB="${MAIN_CHECKOUT}/scripts/lib/mcp-preflight.sh"

# mcp_check — the runner's own MCP preflight (scripts/lib/mcp-preflight.sh,
# DND-1571): the function its preconditions and its --dry-run call, never a
# copy of its rules. Sets MCP_PF_* and returns non-zero when a tick would exit
# 78 on it. Sourced here, not at the top, so --remove and --backup work on a
# checkout that lost the library.
mcp_check() {
  if [ ! -r "${PREFLIGHT_LIB}" ]; then
    MCP_PF_RESULT="could-not-look"
    MCP_PF_WHY="${PREFLIGHT_LIB} is missing from the main checkout, so the runner's MCP preflight cannot run (the runner exits 78 on it)."
    MCP_PF_FIX="land scripts/lib/mcp-preflight.sh (DND-1571) on main and fast-forward ${MAIN_CHECKOUT}."
    return 1
  fi
  # shellcheck source=scripts/lib/mcp-preflight.sh
  . "${PREFLIGHT_LIB}"
  clustering_mcp_preflight "${CLAUDE_JSON}" "${MAIN_CHECKOUT}"
}
# mcp_label — NOT REGISTERED (the config was read and a server is not there)
# or COULD NOT LOOK (it could not be read).
mcp_label() { if [ "${MCP_PF_RESULT}" = "not-registered" ]; then echo "NOT REGISTERED"; else echo "COULD NOT LOOK"; fi; }
# mcp_fail — exit 2 (not registered) or 4 (could not look).
mcp_fail() {
  local rc=4
  [ "${MCP_PF_RESULT}" = "not-registered" ] && rc=2
  die "${rc}" "$(mcp_label): ${MCP_PF_WHY%.}; every tick would exit 78." "${MCP_PF_FIX} Nothing was written."
}
mcp_ok_line() {
  echo "MCP: ${CLUSTERING_MCP_REQUIRED} registered for ${MAIN_CHECKOUT} in ${CLAUDE_JSON} (the runner's preflight passes)."
}

# read_crontab — the current crontab on stdout. "no crontab for <user>" is an
# empty crontab. Any other failure exits 2: writing after a failed read would
# replace every other entry with ours. The reader is scripts/lib/cron-entry.sh's
# cron_read_crontab (DND-1638), shared by every cron installer.
read_crontab() { cron_read_crontab setup-clustering-cron || exit 2; }

# live_lines — the crontab lines on stdin that are ours.
live_lines() { cron_entry_lines "${RUNNER}" ours; }

put_crontab() {
  if [ "${DRY_RUN}" -eq 1 ]; then
    echo "  [dry-run] the crontab would become:"; printf '%s\n' "$1" | sed 's/^/    /'
    return 0
  fi
  printf '%s\n' "$1" | crontab -
}

if [ "${CHECK}" -eq 1 ]; then
  current="$(read_crontab)"
  live="$(printf '%s\n' "${current}" | live_lines)"
  # A live entry is not enough: --check is green only when a tick could start,
  # so it runs the runner's own preconditions too (DND-1571).
  mcp_rc=0; mcp_check || mcp_rc=1
  if [ -n "${live}" ] && [ -x "${RUNNER}" ]; then
    [ -r "${SKILL_FILE}" ] || die 2 "${SKILL_MISSING_WHY}; every tick would exit 78" "${SKILL_MISSING_FIX}"
    [ "${mcp_rc}" -eq 0 ] || mcp_fail
    cron_runner_dry_run "${RUNNER}" || die 2 "${CRON_DRY_WHY%.}; a tick would not start." "${CRON_DRY_FIX}"
    echo "OK: the epic-clustering cron entry is installed:"
    printf '%s\n' "${live}" | sed 's/^/  /'
    mcp_ok_line
    exit 0
  fi
  if [ ! -r "${SKILL_FILE}" ]; then
    echo "setup-clustering-cron: ${SKILL_MISSING_WHY} either." >&2
    echo "  Fix: ${SKILL_MISSING_FIX}" >&2
  fi
  if [ "${mcp_rc}" -ne 0 ]; then
    echo "$(mcp_label): ${MCP_PF_WHY}" >&2
    echo "  Fix: ${MCP_PF_FIX}" >&2
  fi
  if [ -z "${live}" ]; then
    echo "MISSING: no live crontab entry runs ${RUNNER}; the 12h clustering pass and the daily digest are not scheduled." >&2
  else
    echo "MISSING: the crontab runs ${RUNNER}, but that file is absent or not executable." >&2
  fi
  echo "  Fix: from ${MAIN_CHECKOUT}, run scripts/setup-clustering-cron (or restore your --backup file)." >&2
  exit 1
fi

if [ -n "${BACKUP_FILE}" ]; then
  current="$(read_crontab)"
  ( umask 077; printf '%s\n' "${current}" >"${BACKUP_FILE}" ) \
    || die 2 "could not write ${BACKUP_FILE}" "pick a writable path outside git."
  echo "Backed up the current crontab to ${BACKUP_FILE}"
  exit 0
fi

current="$(read_crontab)"
kept="$(printf '%s\n' "${current}" | cron_entry_lines "${RUNNER}" notours)"

# --remove works whether or not the runner exists: a missing runner is when
# its entry most needs removing.
if [ "${REMOVE}" -eq 1 ]; then
  put_crontab "${kept}"
  echo "Removed the epic-clustering cron entry."
  exit 0
fi

[ -x "${RUNNER}" ] || die 2 "the runner ${RUNNER} is absent or not executable in the main checkout" \
  "land DND-983 on main and fast-forward ${MAIN_CHECKOUT} first. An entry pointing at a missing runner fails every tick."
[ -r "${SKILL_FILE}" ] || die 2 "${SKILL_MISSING_WHY}" "${SKILL_MISSING_FIX}"
# The runner's MCP preflight, before any write: an entry whose every tick
# exits 78 is not an install (DND-1571).
mcp_check || mcp_fail
mcp_ok_line
# The runner's own --dry-run, last: it also checks what this installer does
# not, such as the scripts/lib files a tick loads (DND-1728).
cron_runner_dry_run "${RUNNER}" || die 2 "${CRON_DRY_WHY%.}; a tick would not start." "${CRON_DRY_FIX} Nothing was written."

line="${SCHEDULE} ${RUNNER}"
if [ -n "${kept}" ]; then new="$(printf '%s\n%s' "${kept}" "${line}")"; else new="${line}"; fi
put_crontab "${new}"
if [ "${DRY_RUN}" -eq 1 ]; then echo "[dry-run] would install: ${line}"; else echo "Installed: ${line}"; fi

tz_note="machine local time is $(date +%Z) (UTC$(date +%z))"
if [ "$(date +%z)" != "$(TZ=America/Denver date +%z)" ]; then
  tz_note="${tz_note}. WARNING: not America/Denver; the default times are not the owner's morning. Fix: re-run with a --schedule in this machine's time"
fi
echo "Times are cron's local time: ${tz_note}."
echo "Default schedule in UTC: 13:00 and 01:00 under MDT, 14:00 and 02:00 under MST."
echo "Verify: scripts/setup-clustering-cron --check"
echo "Smoke:  env -i HOME=\"\$HOME\" SHELL=/bin/sh ${RUNNER} --dry-run"
