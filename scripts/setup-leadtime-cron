#!/usr/bin/env bash
#
# setup-leadtime-cron — install, check or remove the hourly lead-time improver
# cron entry, which runs scripts/athena-leadtime-run.sh (DND-1480; design:
# ai/docs/lead-time-improver.md, Decision 1).
#
# Idempotent: re-running updates the schedule in place and never duplicates the
# line. It changes only its own line; every other crontab line is kept byte for
# byte. The entry always names the MAIN checkout's runner, and --install and
# --remove refuse to run from a linked worktree: run them from the main
# checkout. It needs no root.
#
# Usage:
#   setup-leadtime-cron [--install] [--schedule "<cron expr>"] [--dry-run]
#   setup-leadtime-cron --check          read-only: exit 0 if exactly one live entry runs the runner
#                                        and a tick could start: the skill is in the main checkout,
#                                        the repo list resolves, and the MCP preflight passes;
#                                        prints that list and the MCP line
#   setup-leadtime-cron --remove [--dry-run]
#   setup-leadtime-cron --backup <file>  snapshot the current crontab to <file> (mode 600)
#   setup-leadtime-cron --help
#
# Schedule: default "30 * * * *", hourly at :30, half an hour off the
# shipwright's ":00" so the two hourly loops never start together.
#
# Which lines are ours: an uncommented line with a whitespace-separated field
# that IS the main checkout's runner path. A commented line, or a longer path
# such as <runner>.bak, is not ours and is kept. A line running some OTHER
# .../scripts/athena-leadtime-run.sh (a removed worktree's copy) is STALE: it
# is kept, named in a warning, and keeps --check red until deleted by hand.
#
# The repo list. --install and --check read it only through the main
# checkout's ai/bin/lead-time-repos (DND-1526), the one resolver and the one
# schema: the tracked ai/config/lead-time-repos.json, or this machine's
# override (see its --help). Both print the resolved list, its source, and
# each skipped repo by name. A list that does not resolve (any non-zero
# resolver exit, zero repos included) is exit 2 and leaves the crontab and
# every cursor unchanged.
#
# The MCP preflight (DND-1571). --check, --install and --dry-run run the
# runner's own MCP preflight, scripts/lib/mcp-preflight.sh, the function its
# preconditions call: notion-personal registered for the main checkout in
# Claude Code's config (LEADTIME_CLAUDE_JSON, default ~/.claude.json). Two
# failures, with distinct words and exits: NOT REGISTERED (exit 2: the config
# was read and the server is not there; the Fix: names the server and the
# command that registers it) and COULD NOT LOOK (exit 4: jq missing, or the
# config missing, unreadable or not valid JSON). --install refuses before any
# write. --remove and --backup never run it.
#
# Cursor seeding (--install only; --dry-run prints the plan). Before the entry
# is written, each RESOLVED repo gets its first cursor in <main
# checkout>/ai-artifacts/lead-time, unless one is already there (an existing
# cursor is never overwritten); a skipped repo gets none:
#   watch repos    watch-cursor.<repo>.txt, copied from the shipwright's own
#                  ai-artifacts/shipwright/lead-cursor.<repo>.txt, so the first
#                  watch run resumes where the shipwright stopped. No shipwright
#                  cursor: left absent, and the first run scans its default
#                  48h window (said in the output). A malformed one is named
#                  and not copied.
#   improve repos  cursor.<repo>.txt = now minus 14 days (lead-time-phases'
#                  own backfill), pinned at install time.
#
# Environment (test seams):
#   LEADTIME_CRONTAB  the crontab program (default: crontab on PATH)
#   LEADTIME_NOW      epoch seconds to treat as now, for the improve cursor
#   LEADTIME_CLAUDE_JSON  Claude Code's config holding the MCP servers (the runner's seam)
#   ATHENA_LEADTIME_CONFIG, XDG_CONFIG_HOME  read by ai/bin/lead-time-repos
#
# Exit codes: 0 ok · 1 entry missing, duplicated or stale (--check), or a usage
# error · 2 a prerequisite is missing, the repo list does not resolve, an MCP
# server is NOT REGISTERED, the crontab could not be read or written, or a
# cursor could not be written · 3 refused: --install or --remove run from a
# linked worktree · 4 COULD NOT LOOK: the MCP preflight could not read Claude
# Code's config (or jq, or the preflight library, is missing)

set -euo pipefail

ME="setup-leadtime-cron"
SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd -P)"
SCHEDULE="30 * * * *"
MODE="install"; MODE_FLAG=""; DRY_RUN=0; BACKUP_FILE=""
CRONTAB="${LEADTIME_CRONTAB:-crontab}"
BACKFILL_DAYS=14

usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,"");print;next} {exit}' "$0"; }
die() { # <exit> <message> <fix>
  echo "${ME}: $2" >&2
  echo "  Fix: $3" >&2
  exit "$1"
}
set_mode() { # <mode> <flag>: one mode per run; a second, different one is refused
  if [ -n "${MODE_FLAG}" ] && [ "${MODE}" != "$1" ]; then
    die 1 "${MODE_FLAG} and $2 cannot be combined" "pass one of --install, --check, --remove or --backup."
  fi
  MODE="$1"; MODE_FLAG="$2"
}

while [ $# -gt 0 ]; do
  case "$1" in
    --install) set_mode install --install ;;
    --schedule) shift; [ $# -gt 0 ] || die 1 "--schedule needs a value" 'pass five cron fields, e.g. --schedule "30 * * * *"'; SCHEDULE="$1" ;;
    --schedule=*) SCHEDULE="${1#*=}" ;;
    --remove)  set_mode remove --remove ;;
    --check)   set_mode check --check ;;
    --backup)  shift; [ $# -gt 0 ] || die 1 "--backup needs a file path" "pass a path outside git, e.g. --backup ai-artifacts/lead-time/crontab.before"; set_mode backup --backup; BACKUP_FILE="$1" ;;
    --backup=*) set_mode backup --backup; BACKUP_FILE="${1#*=}" ;;
    --dry-run) DRY_RUN=1 ;;
    -h|--help) usage; exit 0 ;;
    *) die 1 "unknown argument: $1" "run with --help for the accepted flags." ;;
  esac
  shift
done

# shellcheck disable=SC2086
set -f; set -- ${SCHEDULE}; set +f
[ $# -eq 5 ] || die 1 "--schedule '${SCHEDULE}' is not five cron fields" 'pass five fields, e.g. --schedule "30 * * * *"'

command -v "${CRONTAB}" >/dev/null 2>&1 || die 2 "crontab (${CRONTAB}) is not installed" "install cronie (the shipwright cron uses it too)."

# The main checkout, resolved through git's common dir; and whether THIS copy
# runs from a linked worktree (its git dir differs from the common dir).
common="$(git -C "${SCRIPT_DIR}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
gitdir="$(git -C "${SCRIPT_DIR}" rev-parse --path-format=absolute --git-dir 2>/dev/null || true)"
case "${common}" in
  /*) ;;
  *) die 2 "${SCRIPT_DIR} is not inside a git checkout (git common dir '${common}')" "run the copy in ~/dev/custom/scripts/." ;;
esac
MAIN_CHECKOUT="$(dirname -- "$(cd -- "${common}" && pwd -P)")"
IN_WORKTREE=0
[ "$(cd -- "${gitdir}" && pwd -P)" = "$(cd -- "${common}" && pwd -P)" ] || IN_WORKTREE=1
RUNNER="${MAIN_CHECKOUT}/scripts/athena-leadtime-run.sh"
LT_STATE="${MAIN_CHECKOUT}/ai-artifacts/lead-time"
SW_STATE="${MAIN_CHECKOUT}/ai-artifacts/shipwright"
RESOLVER="${MAIN_CHECKOUT}/ai/bin/lead-time-repos"
SKILL_FILE="${MAIN_CHECKOUT}/ai/skills/athena:lead-time-improve/SKILL.md"
CLAUDE_JSON="${LEADTIME_CLAUDE_JSON:-${HOME}/.claude.json}"
PREFLIGHT_LIB="${SCRIPT_DIR}/lib/mcp-preflight.sh"

# mcp_check — the runner's own MCP preflight (scripts/lib/mcp-preflight.sh,
# DND-1571): the function its preconditions and its --dry-run call, never a
# copy of its rules. Sets MCP_PF_* and returns non-zero when a tick would exit
# 78 on it. Sourced here, not at the top, so --remove and --backup work on a
# checkout that lost the library.
mcp_check() {
  if [ ! -r "${PREFLIGHT_LIB}" ]; then
    MCP_PF_RESULT="could-not-look"
    MCP_PF_WHY="${PREFLIGHT_LIB} is missing, so the runner's MCP preflight cannot run."
    MCP_PF_FIX="restore scripts/lib/mcp-preflight.sh (git checkout -- scripts/lib), or fast-forward this checkout to main."
    return 1
  fi
  # shellcheck source=scripts/lib/mcp-preflight.sh
  . "${PREFLIGHT_LIB}"
  leadtime_mcp_preflight "${CLAUDE_JSON}" "${MAIN_CHECKOUT}"
}
# mcp_label — the result's word for a reader: NOT REGISTERED (the config was
# read and the server is not there) or COULD NOT LOOK (it could not be read).
mcp_label() { if [ "${MCP_PF_RESULT}" = "not-registered" ]; then echo "NOT REGISTERED"; else echo "COULD NOT LOOK"; fi; }
# mcp_fail — exit 2 (not registered) or 4 (could not look), naming both lines.
mcp_fail() {
  local rc=4
  [ "${MCP_PF_RESULT}" = "not-registered" ] && rc=2
  die "${rc}" "$(mcp_label): ${MCP_PF_WHY%.}; every tick would exit 78." "${MCP_PF_FIX} Nothing was written."
}
mcp_ok_line() {
  echo "MCP: ${LEADTIME_MCP_REQUIRED} registered for ${MAIN_CHECKOUT} in ${CLAUDE_JSON} (the runner's preflight passes)."
}
SKILL_MISSING_WHY="the athena:lead-time-improve skill is not in the main checkout (${SKILL_FILE})"
SKILL_MISSING_FIX="land DND-1478 on main and fast-forward ${MAIN_CHECKOUT} first. Without it every tick exits 78."

# resolve_repos — this machine's repo list, through the one resolver
# (ai/bin/lead-time-repos, DND-1526); never a second parse of the config.
# Sets RES_RC (0 ok; the resolver's exit, or 127 when it or jq is missing),
# RES_ERR (its stderr, Fix: included), RES_TSV ("<name>\t<mode>" per repo) and
# RES_TEXT (the printable list: source, each repo, each skip by name, counts).
# RES_RAN is "exit <n>" once the resolver ran, else "not run"; RES_FIX is this
# script's own Fix: for its own fault, preferred over the resolver's.
RES_RC=0; RES_RAN="not run"; RES_FIX=""; RES_ERR=""; RES_TSV=""; RES_TEXT=""
resolve_repos() {
  local out err_file
  if [ ! -x "${RESOLVER}" ]; then
    RES_RC=127; RES_ERR="${RESOLVER} is absent or not executable in the main checkout"
    RES_FIX="land ai/bin/lead-time-repos (DND-1526) on main and fast-forward ${MAIN_CHECKOUT} first."
    return 0
  fi
  if ! command -v jq >/dev/null 2>&1; then
    RES_RC=127; RES_ERR="jq is not installed, so the resolver's --json cannot be read"
    RES_FIX="install jq, then re-run."
    return 0
  fi
  err_file="$(mktemp)" || {
    RES_RC=73; RES_ERR="mktemp failed, so the resolver could not be run"
    RES_FIX="check that \${TMPDIR:-/tmp} is writable and the disk is not full, then re-run."
    return 0
  }
  out="$("${RESOLVER}" --json 2>"${err_file}" </dev/null)" || RES_RC=$?
  RES_RAN="exit ${RES_RC}"
  RES_ERR="$(cat -- "${err_file}")"; rm -f -- "${err_file}"
  [ "${RES_RC}" -eq 0 ] || return 0
  local bad
  if ! RES_TSV="$(jq -r '
        if (.repos | type) != "array" or (.repos | length) == 0 then error("no resolved repos") else . end
        | .repos[] | "\(.name)\t\(.mode)"' <<<"${out}" 2>&1)" \
     || ! RES_TEXT="$(jq -r '
        def one: tostring | gsub("[\n\r]"; " ");
        "Repos (ai/bin/lead-time-repos: source=\(.source | one) \(.path | one)):",
        (.repos[] | "  \(.name | one | . + (" " * ([10 - length, 1] | max)))\(.mode | one | . + (" " * ([8 - length, 1] | max)))\(.path | one)"),
        ((.skipped // [])[] | "  skipped \(.name | one): \(.reason | one)"),
        "  \(.considered) considered, \(.repos | length) resolved, \((.skipped // []) | length) skipped"' <<<"${out}" 2>&1)"; then
    bad="${RES_TSV}${RES_TEXT}"
    RES_RC=1; RES_ERR="the resolver exited 0 but its --json is unreadable or lists no repo (${bad})"; RES_TSV=""; RES_TEXT=""
    RES_FIX="run ${RESOLVER} --json by hand and compare it with its --help; this is a resolver or installer bug."
  fi
  return 0
}
# res_fail <exit> — the list did not resolve: say why, with this script's own
# Fix: for its own fault, else the resolver's.
res_fail() {
  local fix="${RES_FIX}" why
  [ -n "${fix}" ] || fix="$(printf '%s\n' "${RES_ERR}" | sed -n 's/^Fix: //p' | head -n1)"
  why="$(printf '%s\n' "${RES_ERR}" | grep -v '^Fix: ' | grep -v '^[[:space:]]*$' | head -n1 || true)"
  die "$1" "the repo list does not resolve on this machine (ai/bin/lead-time-repos ${RES_RAN}): ${why}; every tick would exit 78" \
    "${fix:-run ${RESOLVER} by hand to see why.} Nothing was written."
}

# read_crontab — the current crontab on stdout. "no crontab for <user>" is an
# empty crontab. Any other failure exits 2: writing after a failed read would
# replace every other entry with ours.
read_crontab() {
  local out err rc=0
  err="$(mktemp)"
  out="$("${CRONTAB}" -l 2>"${err}")" || rc=$?
  if [ "${rc}" -ne 0 ]; then
    if grep -q 'no crontab for' "${err}"; then rm -f "${err}"; return 0; fi
    local msg; msg="$(tr '\n' ' ' <"${err}")"; rm -f "${err}"
    die 2 "could not read the current crontab (crontab -l exit ${rc}: ${msg})" \
      "fix the crontab spool first (scripts/setup-shipwright-cron repairs it), then re-run. Nothing was written."
  fi
  rm -f "${err}"
  printf '%s\n' "${out}"
}

# lines_of <class> — the crontab lines on stdin of one class, printed byte for
# byte (see "Which lines are ours" above). ONE classifier serves --check,
# --install and --remove, so what is counted as ours is exactly what is
# replaced or removed. Classes: ours, stale, notours (stale + everything else).
lines_of() {
  awk -v r="${RUNNER}" -v want="$1" '{
    cls = "other"
    if ($0 !~ /^[[:space:]]*#/) {
      for (i = 1; i <= NF; i++) {
        if ($i == r) { cls = "ours"; break }
        if ($i ~ /\/scripts\/athena-leadtime-run\.sh$/) cls = "stale"
      }
    }
    if (cls == want || (want == "notours" && cls != "ours")) print
  }'
}
count_lines() { if [ -z "$1" ]; then echo 0; else printf '%s\n' "$1" | wc -l | tr -d ' '; fi; }

put_crontab() {
  if [ "${DRY_RUN}" -eq 1 ]; then
    echo "  [dry-run] the crontab would become:"; printf '%s\n' "$1" | sed 's/^/    /'
    return 0
  fi
  printf '%s\n' "$1" | "${CRONTAB}" - \
    || die 2 "could not write the crontab (${CRONTAB} - failed)" \
      "fix the crontab spool (scripts/setup-shipwright-cron repairs it), then re-run; it is idempotent, and any cursor it seeded is kept."
}

if [ "${MODE}" = "check" ]; then
  current="$(read_crontab)"
  live="$(printf '%s\n' "${current}" | lines_of ours)"
  stale="$(printf '%s\n' "${current}" | lines_of stale)"
  n="$(count_lines "${live}")"
  # The resolved list is printed either way; one that does not resolve is red
  # even with a healthy entry, because every tick would then exit 78.
  resolve_repos
  # A healthy entry is not enough: --check is green only when a tick could
  # start, so it runs the runner's own preconditions too (DND-1571).
  mcp_rc=0; mcp_check || mcp_rc=1
  if [ "${n}" -eq 1 ] && [ -z "${stale}" ] && [ -x "${RUNNER}" ]; then
    [ -r "${SKILL_FILE}" ] || die 2 "${SKILL_MISSING_WHY}; every tick would exit 78" "${SKILL_MISSING_FIX}"
    [ "${RES_RC}" -eq 0 ] || res_fail 2
    [ "${mcp_rc}" -eq 0 ] || mcp_fail
    echo "OK: the lead-time improver cron entry is installed:"
    printf '%s\n' "${live}" | sed 's/^/  /'
    printf '%s\n' "${RES_TEXT}"
    mcp_ok_line
    exit 0
  fi
  if [ "${RES_RC}" -eq 0 ]; then
    printf '%s\n' "${RES_TEXT}" >&2
  else
    echo "${ME}: the repo list does not resolve either (ai/bin/lead-time-repos ${RES_RAN})." >&2
    echo "  Fix: ${RES_FIX:-run ${RESOLVER} by hand to see why.}" >&2
  fi
  if [ ! -r "${SKILL_FILE}" ]; then
    echo "${ME}: ${SKILL_MISSING_WHY} either." >&2
    echo "  Fix: ${SKILL_MISSING_FIX}" >&2
  fi
  if [ "${mcp_rc}" -ne 0 ]; then
    echo "$(mcp_label): ${MCP_PF_WHY}" >&2
    echo "  Fix: ${MCP_PF_FIX}" >&2
  fi
  if [ -n "${stale}" ]; then
    echo "STALE: the crontab runs a lead-time runner that is not ${RUNNER}:" >&2
    printf '%s\n' "${stale}" | sed 's/^/  /' >&2
    echo "  Fix: delete those lines by hand (crontab -e); then, from ${MAIN_CHECKOUT}, run scripts/setup-leadtime-cron --install." >&2
  fi
  if [ "${n}" -eq 0 ]; then
    echo "MISSING: no live crontab entry runs ${RUNNER}; the lead-time improver loop is not scheduled." >&2
    echo "  Fix: from ${MAIN_CHECKOUT}, run scripts/setup-leadtime-cron --install (or restore your --backup file)." >&2
  elif [ "${n}" -gt 1 ]; then
    echo "DUPLICATE: ${n} live crontab entries run ${RUNNER}; each tick would start ${n} runs." >&2
    printf '%s\n' "${live}" | sed 's/^/  /' >&2
    echo "  Fix: from ${MAIN_CHECKOUT}, run scripts/setup-leadtime-cron --install; it rewrites them as one entry." >&2
  elif [ ! -x "${RUNNER}" ]; then
    echo "MISSING: the crontab runs ${RUNNER}, but that file is absent or not executable; every tick fails." >&2
    echo "  Fix: fast-forward ${MAIN_CHECKOUT} to a main that carries the runner, or run scripts/setup-leadtime-cron --remove." >&2
  fi
  exit 1
fi

if [ "${MODE}" = "backup" ]; then
  current="$(read_crontab)"
  ( umask 077; printf '%s\n' "${current}" >"${BACKUP_FILE}" && chmod 600 -- "${BACKUP_FILE}" ) \
    || die 2 "could not write ${BACKUP_FILE}" "pick a writable path outside git."
  echo "Backed up the current crontab to ${BACKUP_FILE}"
  exit 0
fi

if [ "${IN_WORKTREE}" -eq 1 ] && [ "${DRY_RUN}" -eq 0 ]; then
  die 3 "--${MODE} refused: this copy runs from a linked worktree (${SCRIPT_DIR}), not the main checkout" \
    "run it from the main checkout: cd ${MAIN_CHECKOUT} && scripts/setup-leadtime-cron --${MODE}. Nothing was written."
fi

current="$(read_crontab)"
kept="$(printf '%s\n' "${current}" | lines_of notours)"
ours="$(printf '%s\n' "${current}" | lines_of ours)"
stale="$(printf '%s\n' "${current}" | lines_of stale)"
warn_stale() { # stale lines are kept (not this checkout's), but never silently
  [ -n "${stale}" ] || return 0
  echo "${ME}: WARNING: the crontab also runs a lead-time runner that is not ${RUNNER}; left as is:" >&2
  printf '%s\n' "${stale}" | sed 's/^/  /' >&2
  echo "  Fix: delete those lines by hand (crontab -e), or each tick starts a second run; --check stays red (STALE) until then." >&2
}

# --remove works whether or not the runner exists: a missing runner is when
# its entry most needs removing.
if [ "${MODE}" = "remove" ]; then
  if [ -z "${ours}" ]; then
    echo "No lead-time improver cron entry runs ${RUNNER}; nothing removed."
  else
    put_crontab "${kept}"
    echo "Removed the lead-time improver cron entry ($(count_lines "${ours}") line(s))."
  fi
  warn_stale
  exit 0
fi

# --- install ---------------------------------------------------------------
[ -x "${RUNNER}" ] || die 2 "the runner ${RUNNER} is absent or not executable in the main checkout" \
  "land DND-1479 on main and fast-forward ${MAIN_CHECKOUT} first. An entry pointing at a missing runner fails every tick."
[ -r "${SKILL_FILE}" ] || die 2 "${SKILL_MISSING_WHY}" "${SKILL_MISSING_FIX}"
NOW="${LEADTIME_NOW:-$(date -u +%s)}"
case "${NOW}" in
  ''|*[!0-9]*) die 1 "LEADTIME_NOW='${NOW}' is not epoch seconds" "unset it, or set it to a whole number of seconds." ;;
esac

# This machine's resolved repos as "<name><TAB><mode>". The resolver owns the
# schema (a name is a plain label, a mode is improve or watch) and skips a repo
# not checked out here, by name; any refusal is reported before any write.
resolve_repos
[ "${RES_RC}" -eq 0 ] || res_fail 2
# The runner's MCP preflight, before any write: an entry whose every tick
# exits 78 is not an install (DND-1571).
mcp_check || mcp_fail
printf '%s\n' "${RES_TEXT}"
mcp_ok_line
repos="${RES_TSV}"

RFC3339_RE='^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$'
is_rfc3339() { # <text>: an RFC 3339 time GNU date can read
  [[ "$1" =~ ${RFC3339_RE} ]] && date -u -d "$1" +%s >/dev/null 2>&1
}
keep_cursor() { # <file>: an existing cursor is never overwritten, but a bad one is named
  local v; v="$(head -n1 -- "$1" | tr -d '[:space:]')"
  if is_rfc3339 "${v}"; then echo "  kept $(basename -- "$1") = ${v}"; return 0; fi
  echo "${ME}: WARNING: kept $1, but it holds '${v}', not an RFC 3339 time; its reader will refuse it." >&2
  echo "  Fix: write an RFC 3339 time to it by hand, or delete it and re-run --install to seed it." >&2
}
write_cursor() { # <file> <value>
  if [ "${DRY_RUN}" -eq 1 ]; then echo "  [dry-run] would seed $(basename -- "$1") = $2"; return 0; fi
  mkdir -p -- "${LT_STATE}" 2>/dev/null \
    || die 2 "could not create ${LT_STATE}" "make ${LT_STATE} writable, then re-run. The crontab was not changed."
  local tmp="$1.tmp.$$"
  { printf '%s\n' "$2" >"${tmp}" && mv -f -- "${tmp}" "$1"; } 2>/dev/null \
    || { rm -f -- "${tmp}"; die 2 "could not write $1" "make ${LT_STATE} writable, then re-run. The crontab was not changed."; }
  echo "  seeded $(basename -- "$1") = $2"
}

echo "Cursors (${LT_STATE}):"
improve_since="$(date -u -d "@$((NOW - BACKFILL_DAYS * 86400))" +%Y-%m-%dT%H:%M:%SZ)"
while IFS="$(printf '\t')" read -r name mode; do
  if [ "${mode}" = "improve" ]; then
    dst="${LT_STATE}/cursor.${name}.txt"
    if [ -e "${dst}" ]; then keep_cursor "${dst}"; continue; fi
    write_cursor "${dst}" "${improve_since}"
    continue
  fi
  dst="${LT_STATE}/watch-cursor.${name}.txt"
  if [ -e "${dst}" ]; then keep_cursor "${dst}"; continue; fi
  src="${SW_STATE}/lead-cursor.${name}.txt"
  if [ ! -e "${src}" ]; then
    echo "  ${name}: no shipwright cursor (${src}); watch-cursor.${name}.txt left absent, so the first watch run scans its default 48h window."
    continue
  fi
  value="$(head -n1 -- "${src}" | tr -d '[:space:]')"
  if ! is_rfc3339 "${value}"; then
    echo "${ME}: WARNING: ${src} holds '${value}', not an RFC 3339 time; watch-cursor.${name}.txt left absent, so the first ${name} watch run scans its default 48h window." >&2
    echo "  Fix: nothing to do unless that window is too short; then write an RFC 3339 time to ${dst} by hand." >&2
    continue
  fi
  write_cursor "${dst}" "${value}"
done <<<"${repos}"

line="${SCHEDULE} ${RUNNER}"
if [ -n "${kept}" ]; then new="$(printf '%s\n%s' "${kept}" "${line}")"; else new="${line}"; fi
put_crontab "${new}"
if [ "${DRY_RUN}" -eq 1 ]; then echo "[dry-run] would install: ${line}"; else echo "Installed: ${line}"; fi
warn_stale
echo "Times are cron's local time: machine local time is $(date +%Z) (UTC$(date +%z))."
echo "Verify: scripts/setup-leadtime-cron --check"
echo "Smoke:  ${RUNNER} --dry-run"
