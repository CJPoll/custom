#!/usr/bin/env bash
#
# setup-gitlab-runner — install the self-hosted GitLab Runner binary for the
# `gitlab-runner` user and its OpenRC service. Does NOT register (that needs a
# `glrt-` authentication token you create in GitLab) and does NOT start (the
# service refuses to start until a runner is registered).
#
# Run as root:  sudo scripts/setup-gitlab-runner  [--dry-run]
# Idempotent. Prerequisites: setup-gitlab-runner-user, setup-gitlab-runner-docker.
#
# Steps: download the gitlab-runner linux-amd64 binary to /usr/local/bin; install
# the gitlab-runner OpenRC service; rc-update add (NOT start). Then print the exact
# create-runner + register + concurrency + start sequence, including the walt_ui
# buildctl-MR ordering caveat (see system-files/gitlab-runner-runbook.md).
#
# Unlike the GitHub runner there is NO host toolchain (node/jq) and NO .NET/ICU
# workaround: GitLab's docker executor runs each job inside its own container, so
# the runner host needs only the gitlab-runner binary + rootless docker.

set -euo pipefail

USER_NAME="gitlab-runner"
CONFIG="/home/gitlab-runner/.gitlab-runner/config.toml"
SERVICE_NAME="gitlab-runner"
BIN="/usr/local/bin/gitlab-runner"
DL_URL="https://gitlab-runner-downloads.s3.amazonaws.com/latest/binaries/gitlab-runner-linux-amd64"
DRY_RUN=false

usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,"");print;next} {exit}' "$0"; }
while [ $# -gt 0 ]; do case "$1" in
  --dry-run) DRY_RUN=true ;;
  -h|--help) usage; exit 0 ;;
  *) echo "unknown argument: $1" >&2; usage >&2; exit 1 ;;
esac; shift; done

log()  { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[!]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[x]\033[0m %s\n' "$*" >&2; exit 1; }
run()  { if $DRY_RUN; then printf '    + %s\n' "$*"; else "$@"; fi; }

SYSTEM_FILES="$(cd "$(dirname "${BASH_SOURCE[0]}")/../system-files" && pwd)" \
  || die "cannot locate system-files/ — run from the custom repo checkout"
[ -f "$SYSTEM_FILES/$SERVICE_NAME.initd" ] \
  || die "missing $SYSTEM_FILES/$SERVICE_NAME.initd — run from the custom repo checkout"
[ -f "$SYSTEM_FILES/lib/initd-proc-tree.sh" ] \
  || die "missing $SYSTEM_FILES/lib/initd-proc-tree.sh — run from the custom repo checkout"

[ "$(id -u)" -eq 0 ] || die "must run as root (use sudo)"
getent passwd "$USER_NAME" >/dev/null \
  || die "user $USER_NAME does not exist — run setup-gitlab-runner-user first"
command -v curl >/dev/null || die "curl not found"

# --- 1. download the gitlab-runner binary ------------------------------------
if [ -x "$BIN" ]; then
  log "gitlab-runner already installed at $BIN ($("$BIN" --version 2>/dev/null | head -1))"
else
  tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
  log "downloading gitlab-runner-linux-amd64 -> $BIN"
  run curl -fsSL -o "$tmp/gitlab-runner" "$DL_URL"
  if ! $DRY_RUN; then
    log "sha256: $(sha256sum "$tmp/gitlab-runner" | cut -d' ' -f1)  (compare with $DL_URL.sha256 if you want)"
  fi
  run install -m 755 -o root -g root "$tmp/gitlab-runner" "$BIN"
fi

# --- 2. install the OpenRC service (do NOT start until registered) -----------
log "installing /etc/init.d/$SERVICE_NAME"
# The initd sources this to end its whole process tree on stop (DND-812).
run install -D -m 644 "$SYSTEM_FILES/lib/initd-proc-tree.sh" "/usr/local/lib/athena/initd-proc-tree.sh"
run install -m 755 "$SYSTEM_FILES/$SERVICE_NAME.initd" "/etc/init.d/$SERVICE_NAME"
if [ -e "/etc/conf.d/$SERVICE_NAME" ]; then
  log "keeping existing /etc/conf.d/$SERVICE_NAME"
else
  run install -m 644 "$SYSTEM_FILES/$SERVICE_NAME.confd" "/etc/conf.d/$SERVICE_NAME"
fi
run rc-update add "$SERVICE_NAME" default

log "done."
cat <<EOF

GitLab Runner binary at $BIN (not yet registered). To finish:

  1. Create the runner in GitLab: walt_ui -> Settings -> CI/CD -> Runners ->
     New project runner.
       * Turn ON "Run untagged jobs"  (so it grabs the untagged pipeline; that
         is what gives self-hosted-when-up / SaaS-when-down fallback).
       * Leave Tags EMPTY  (image-build jobs stay UNTAGGED so SaaS can also run
         them — the non-negotiable build fallback; see the runbook).
       * Copy the 'glrt-...' authentication token.

  2. Register AS the runner user (the --docker-security-opt flags set the
     rootless-BuildKit block inline; privileged stays false):
       sudo -u $USER_NAME $BIN register --non-interactive \\
         --url https://gitlab.com --token glrt-... \\
         --executor docker --docker-image alpine:3.20 \\
         --docker-security-opt seccomp:unconfined \\
         --docker-security-opt apparmor:unconfined \\
         --docker-volumes /cache \\
         --config $CONFIG

  3. Set global concurrency: edit $CONFIG, set the top-level  concurrent = 3
     (compare the whole file against system-files/gitlab-runner-config.toml.example).

  4. DO NOT START YET. Image-build jobs are untagged, so the runner would grab
     them the instant it starts — but until walt_ui's buildctl-rewrite MR is
     merged those jobs still use privileged dind and would FAIL RED here. Land
     that MR first (full spec in system-files/gitlab-runner-runbook.md), THEN:
       sudo rc-service $SERVICE_NAME start
       sudo rc-service $SERVICE_NAME status

  The runner then shows online under walt_ui -> Settings -> CI/CD -> Runners; it
  grabs untagged jobs while up, and gitlab.com shared runners handle them when it
  is stopped (the fallback). Force SaaS at any time: sudo rc-service $SERVICE_NAME stop.
EOF
