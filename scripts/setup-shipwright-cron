#!/usr/bin/env bash
#
# setup-shipwright-cron — install (or remove) the athena-shipwright cron job.
#
# This machine is OpenRC + cronie. This script:
#   1. ensures the per-user crontab spool dir exists (one root step, via sudo)
#   2. checks the cron daemon is running
#   3. installs an idempotent crontab entry that runs athena-shipwright-run.sh
#
# Idempotent: re-running updates the schedule in place (never duplicates the
# line). The only root-needing step is creating the spool dir the first time;
# once it exists, no root is needed again.
#
# The entry always names the MAIN checkout's runner, resolved through git's
# common dir, and --install and --remove refuse to run from a linked worktree
# (exit 4): a worktree's runner vanishes on cleanup, and the hourly shipwright
# would silently stop (DND-1639). --check, --backup and --dry-run run anywhere.
# A line running some OTHER .../scripts/athena-shipwright-run.sh (a worktree's
# copy, as installed before DND-1639) is STALE: --install and --remove keep it
# and name it in a warning, and --check is red (STALE) until it is deleted by
# hand.
#
# Which lines are ours: an uncommented line with a whitespace-separated field
# that IS the runner path (scripts/lib/cron-entry.sh, DND-1503). A commented
# line, or a longer path such as <runner>.bak, is not ours: --install and
# --remove keep it, and --check does not count it as live.
#
# Usage:
#   setup-shipwright-cron [--schedule "<cron expr>"] [--dry-run]
#   setup-shipwright-cron --check
#   setup-shipwright-cron --remove [--dry-run]
#   setup-shipwright-cron --backup <file>
#   setup-shipwright-cron --help
#
# Options:
#   --schedule "<expr>"  Five-field cron schedule (default: "0 * * * *" = hourly)
#   --check              Read-only: exit 0 if the entry is live, 1 if it is not
#   --remove             Remove the shipwright crontab entry and exit
#   --backup <file>      Snapshot the current crontab to <file> (mode 600)
#   --dry-run            Print what would happen; change nothing
#   --help               Show this help
#
# A crontab that cannot be read is never written, and never read as empty:
# only "no crontab for <user>" is an empty crontab. Any other `crontab -l`
# failure (a permission error, a broken spool) is exit 2 with a Fix: in every
# mode (DND-1638); the crontab and any --backup file are not written. The one
# write that can come first is the root spool repair --install runs (below).
# --dry-run skips that repair, so on a broken spool it exits 2 on the read
# rather than previewing a crontab it could not read.
#
# Exit codes: 0 ok · 1 usage/arg error, or --check found the entry missing or
#               a STALE line
#             · 2 missing prerequisite (outside a git checkout included), or
#               the current crontab could not be read, or the --backup file
#               could not be written · 3 need root
#             · 4 refused: --install or --remove run from a linked worktree
#               (setup-leadtime-cron uses 3 for that refusal; here 3 already
#               means "need root")

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd -P)"
CRON_ENTRY_LIB="${SCRIPT_DIR}/lib/cron-entry.sh"
SPOOL_DIR="${CRON_SPOOL_DIR:-/var/spool/cron/crontabs}"
SCHEDULE="0 * * * *"   # hourly
DRY_RUN=0
REMOVE=0

# Print the leading comment block (everything from line 2 up to the first
# non-comment line), with the leading "# " stripped.
usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,"");print;next} {exit}' "$0"; }

# ---- args (order-independent) ----------------------------------------------
while [ $# -gt 0 ]; do
  case "$1" in
    --schedule) shift; [ $# -gt 0 ] || { echo "error: --schedule needs a value" >&2; exit 1; }; SCHEDULE="$1" ;;
    --schedule=*) SCHEDULE="${1#*=}" ;;
    --remove)  REMOVE=1 ;;
    --check)   CHECK=1 ;;
    --backup)  shift; [ $# -gt 0 ] || { echo "error: --backup needs a file path" >&2; exit 1; }; BACKUP_FILE="$1" ;;
    --backup=*) BACKUP_FILE="${1#*=}" ;;
    --dry-run) DRY_RUN=1 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "error: unknown argument: $1" >&2; usage >&2; exit 1 ;;
  esac
  shift
done

say()  { printf '%s\n' "$*"; }
step() { printf '\n== %s\n' "$*"; }

# Run a command that needs root, honoring --dry-run.
run_root() {
  if [ "$DRY_RUN" -eq 1 ]; then say "  [dry-run] would run (root): $*"; return 0; fi
  if [ "$(id -u)" -eq 0 ]; then "$@"; return; fi
  if command -v sudo >/dev/null 2>&1; then say "  (sudo) $*"; sudo "$@"; return; fi
  echo "error: this step needs root and sudo is not available: $*" >&2; exit 3
}

# Replace the current crontab with $1 (or preview it under --dry-run).
put_crontab() {
  if [ "$DRY_RUN" -eq 1 ]; then
    say "  [dry-run] resulting crontab would be:"; printf '%s\n' "$1" | sed 's/^/    /'
    return 0
  fi
  printf '%s\n' "$1" | crontab -
}

# ---- preflight -------------------------------------------------------------
command -v crontab >/dev/null 2>&1 || { echo "error: crontab not installed (need cronie/dcron)" >&2; exit 2; }
[ -r "$CRON_ENTRY_LIB" ] || {
  echo "error: $CRON_ENTRY_LIB is missing; without it no crontab line can be told apart as ours." >&2
  echo "  Fix: restore scripts/lib/cron-entry.sh (fast-forward this checkout to a main that has it), then re-run." >&2
  exit 2
}
# shellcheck source=scripts/lib/cron-entry.sh
. "$CRON_ENTRY_LIB"

# The runner is the MAIN checkout's, never this copy's when it runs from a
# linked worktree (DND-1639). The resolver is shared: scripts/lib/cron-entry.sh.
cron_main_checkout "$SCRIPT_DIR" setup-shipwright-cron || exit 2
MAIN_CHECKOUT="$CRON_MAIN_CHECKOUT"
RUNNER="${MAIN_CHECKOUT}/scripts/athena-shipwright-run.sh"
STALE_SUFFIX="/scripts/athena-shipwright-run.sh"

# stale_lines — the crontab lines on stdin that run another copy of the runner.
stale_lines() { cron_entry_lines "$RUNNER" stale "$STALE_SUFFIX"; }

# warn_stale <crontab> — stale lines are kept (not this checkout's), never
# silently.
warn_stale() {
  local stale
  stale="$(printf '%s\n' "$1" | stale_lines)"
  [ -n "$stale" ] || return 0
  echo "WARNING: the crontab also runs a shipwright runner that is not $RUNNER; left as is:" >&2
  printf '%s\n' "$stale" | sed 's/^/  /' >&2
  echo "  Fix: delete those lines by hand (crontab -e); a removed worktree's runner fails every tick. --check stays red (STALE) until then." >&2
}

# ---- check path (read-only): is the shipwright entry live? ------------------
# Read-only; safe for an agent/CI to run. Exit 0 if the entry is present, 1 if
# missing, with an actionable Fix.
if [ "${CHECK:-0}" -eq 1 ]; then
  current="$(cron_read_crontab setup-shipwright-cron)" || exit 2
  live="$(printf '%s\n' "$current" | cron_entry_lines "$RUNNER" ours)"
  stale="$(printf '%s\n' "$current" | stale_lines)"
  if [ -n "$live" ] && [ -z "$stale" ]; then
    say "OK — the athena-shipwright cron entry is installed:"
    printf '%s\n' "$live" | sed 's/^/  /'
    exit 0
  fi
  if [ -n "$stale" ]; then
    echo "STALE — the crontab runs a shipwright runner that is not $RUNNER:" >&2
    printf '%s\n' "$stale" | sed 's/^/  /' >&2
    echo "  Fix: delete those lines by hand (crontab -e); then, from ${MAIN_CHECKOUT}, run 'scripts/setup-shipwright-cron' if the entry is missing." >&2
    [ -z "$live" ] || exit 1
  fi
  echo "MISSING — no live crontab entry runs $RUNNER; the hourly cross-session loop is not scheduled." >&2
  echo "  Fix: from ${MAIN_CHECKOUT}, run 'scripts/setup-shipwright-cron' (or restore from your --backup file) to reinstall it." >&2
  exit 1
fi

# ---- backup path (read-only snapshot of the live crontab) -------------------
# Writes the CURRENT crontab to a file so a spool reset can be restored. The
# committed installer is the canonical source of the entry; this snapshots the
# live state (which may hold other personal entries) for the operator, so keep
# the target OUT of git (a local/gitignored path).
if [ -n "${BACKUP_FILE:-}" ]; then
  current="$(cron_read_crontab setup-shipwright-cron)" || exit 2
  ( umask 077; printf '%s\n' "$current" >"$BACKUP_FILE" && chmod 600 -- "$BACKUP_FILE" ) || {
    echo "error: could not write the backup file $BACKUP_FILE." >&2
    echo "  Fix: pick a writable path outside git, e.g. --backup ai-artifacts/shipwright/crontab.before." >&2
    exit 2
  }
  say "Backed up current crontab to $BACKUP_FILE"
  exit 0
fi

# Writes run from the main checkout only. Nothing has been written yet: not
# the crontab, and not the spool repair below.
if [ "$CRON_IN_WORKTREE" -eq 1 ] && [ "$DRY_RUN" -eq 0 ]; then
  mode="install"; [ "$REMOVE" -eq 1 ] && mode="remove"
  echo "error: ${mode} refused: this copy runs from a linked worktree (${SCRIPT_DIR}), not the main checkout." >&2
  echo "  Fix: run it from the main checkout: cd ${MAIN_CHECKOUT} && scripts/setup-shipwright-cron$([ "$REMOVE" -eq 1 ] && printf ' --remove'). Nothing was written." >&2
  exit 4
fi

[ -x "$RUNNER" ] || {
  echo "error: runner not found or not executable in the main checkout: $RUNNER" >&2
  echo "  Fix: fast-forward ${MAIN_CHECKOUT} to a main that carries scripts/athena-shipwright-run.sh, then re-run." >&2
  exit 2
}

# ---- remove path -----------------------------------------------------------
if [ "$REMOVE" -eq 1 ]; then
  step "Removing the athena-shipwright crontab entry"
  current="$(cron_read_crontab setup-shipwright-cron)" || exit 2
  kept="$(printf '%s\n' "$current" | cron_entry_lines "$RUNNER" notours | sed '/^[[:space:]]*$/d')"
  put_crontab "$kept"
  warn_stale "$current"
  say "Done. (Any spool dir and the cron daemon are left as-is.)"
  exit 0
fi

# ---- 1. ensure the crontab spool dir is present AND usable -----------------
# Probe by actually asking crontab. "no crontab for user" (empty) is usable;
# "is not a directory, bailing out" means the spool tree is broken.
step "Crontab spool dir ($SPOOL_DIR)"
spool_err="$(crontab -l 2>&1 >/dev/null || true)"
case "$spool_err" in
  *"not a directory"*|*"bailing out"*|*"No such file"*|*[Cc]"annot"*)
    say "  spool not usable — repairing (needs root)."
    # The crontab binary is setgid to a group (often "crontab", NOT "cron"):
    # the spool dir must belong to THAT group for the setgid client to write
    # it, and every parent must be traversable by it.
    crontab_bin="$(command -v crontab)"
    spool_group="$(stat -c '%G' "$crontab_bin" 2>/dev/null || echo crontab)"
    parent="$(dirname "$SPOOL_DIR")"
    run_root mkdir -p "$SPOOL_DIR"
    run_root chown "root:${spool_group}" "$SPOOL_DIR"
    run_root chmod 1730 "$SPOOL_DIR"
    run_root chmod o+x "$parent"   # let the setgid-crontab client traverse in
    say "  set $SPOOL_DIR to root:${spool_group} 1730; made $parent traversable."
    ;;
  *)
    say "  usable."
    ;;
esac

# ---- 2. check the cron daemon ----------------------------------------------
step "Cron daemon"
if pgrep -x crond >/dev/null 2>&1 || pgrep -x cron >/dev/null 2>&1; then
  say "  running."
else
  say "  NOT running. Start it (root), e.g. on OpenRC:"
  say "    sudo rc-update add cronie default && sudo rc-service cronie start"
fi

# ---- 3. install the crontab entry (idempotent) -----------------------------
step "Crontab entry ($SCHEDULE)"
line="${SCHEDULE} ${RUNNER}"
current="$(cron_read_crontab setup-shipwright-cron)" || exit 2
kept="$(printf '%s\n' "$current" | cron_entry_lines "$RUNNER" notours | sed '/^[[:space:]]*$/d')"
if [ -n "$kept" ]; then
  new_crontab="$(printf '%s\n%s' "$kept" "$line")"
else
  new_crontab="$line"
fi
put_crontab "$new_crontab"
if [ "$DRY_RUN" -eq 1 ]; then say "  [dry-run] would install: $line"; else say "  installed: $line"; fi
warn_stale "$current"

# ---- next steps ------------------------------------------------------------
step "Done"
say "Verify:      crontab -l"
say "Smoke-test:  env -i HOME=\"\$HOME\" SHELL=/bin/sh $RUNNER"
say "             then read the newest ~/dev/custom/ai-artifacts/shipwright/runs/*.log"
say "Note: git push under cron uses SSH with no agent — a passphraseless key at a"
say "      default path just works; otherwise the run still commits locally and journals."
