#!/usr/bin/env bash

# Subagents default to a 5-minute prompt-cache TTL (only the main conversation
# on a subscription gets 1h). A long-running admiral that resumes after a >5min
# wait then re-pays cache CREATION on its whole transcript instead of a ~0.1x
# read — the dominant token-burn source for the fleet. Force 1h for subagents so
# the cache stays warm across resume gaps. An explicit override still wins.
# (Ref: Claude Code prompt-caching docs; verified 2026-09-21.)
export CLAUDE_CODE_SUBAGENT_PROMPT_CACHE_TTL="${CLAUDE_CODE_SUBAGENT_PROMPT_CACHE_TTL:-1h}"

# The Athena MCP server (/mcp, DND-295) authenticates with the machine token the
# inbox client holds in ~/.config/athena-inbox-client/config.json (0600). The
# token NEVER enters this process's environment (DND-839): Claude Code passes
# its environment to every Bash tool child, so an exported token reached every
# command an agent ran, and an env dump put it in a transcript. Instead
# `add-athena-mcp` registers `scripts/athena-mcp-headers` as the MCP entry's
# `headersHelper`; Claude Code runs it on each MCP connect and it reads the
# token from the config file itself.
#
# So the launcher only SCRUBS: a caller that exported ATHENA_MCP_BEARER (the
# pre-DND-839 recipe) does not get it into the session.
unset ATHENA_MCP_BEARER

# Preflight, reading no token. A MISSING inbox config means the inbox client is
# not provisioned here: not an Athena-MCP environment, so skip silently rather
# than break an unrelated `claude` launch (environment-safe). A PRESENT config
# IS the Athena environment, so a broken/tokenless one is a loud HARD FAIL,
# never a silent launch whose MCP connect then fails (owner:
# hard-fail-on-required-inputs). Detect by EXISTENCE (-e), not readability: a
# present-but-unreadable config is a broken required input, not "some other
# machine".
athena_inbox_config="${ATHENA_INBOX_CLIENT_CONFIG:-${XDG_CONFIG_HOME:-${HOME}/.config}/athena-inbox-client/config.json}"
if [ -e "${athena_inbox_config}" ]; then
  if ! command -v jq >/dev/null 2>&1; then
    echo "athena: jq is required to check the machine token in ${athena_inbox_config}" \
         "but is not on PATH." >&2
    echo "Fix: install jq (the athena MCP headersHelper needs it too)." >&2
    exit 1
  fi

  if [ ! -r "${athena_inbox_config}" ]; then
    echo "athena: inbox-client config exists but is not readable: ${athena_inbox_config}" >&2
    echo "Fix: fix its permissions (0600, owned by you)." >&2
    exit 1
  fi

  # A boolean test only: the token is never read into this shell.
  if ! jq -e '(.token | type) == "string" and (.token | length) > 0' \
       "${athena_inbox_config}" >/dev/null 2>&1; then
    echo "athena: no .token in ${athena_inbox_config} (the Athena MCP server would 401)." >&2
    echo "Fix: the inbox-client config must carry the machine token under .token;" \
         "re-run scripts/setup-athena-inbox-client." >&2
    exit 1
  fi

  # A registration made before DND-839 names ${ATHENA_MCP_BEARER} in a static
  # header. With the variable scrubbed above that header can no longer
  # authenticate, so say so here rather than let /mcp show a bare 401. The
  # launch still proceeds: everything but the athena MCP works.
  if [ -r "${HOME}/.claude.json" ] && jq -e --arg a "${PWD}" --arg b "$(pwd -P)" '
        [(.projects[$a]?.mcpServers?.athena?), (.projects[$b]?.mcpServers?.athena?), (.mcpServers?.athena?)]
        | map(select(type == "object" and (.headers? | tostring | contains("ATHENA_MCP_BEARER"))))
        | length > 0' "${HOME}/.claude.json" >/dev/null 2>&1; then
    echo "athena: the athena MCP registered for this directory still uses the retired" \
         "\${ATHENA_MCP_BEARER} header (DND-839), so it will fail to authenticate." >&2
    echo "Fix: re-run scripts/add-athena-mcp from this directory, which registers the" \
         "headersHelper instead; then relaunch." >&2
  fi
fi

"${HOME}/.local/bin/claude" --verbose --dangerously-skip-permissions "${@}"
