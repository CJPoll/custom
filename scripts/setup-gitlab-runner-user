#!/usr/bin/env bash
#
# setup-gitlab-runner-user — provision the dedicated `gitlab-runner` system user.
#
#   * user gitlab-runner, home /home/gitlab-runner, shell /bin/bash, NO sudo/wheel
#   * purpose: run the self-hosted GitLab Runner and its rootless Docker in
#     isolation from your primary account. CI job code executes as this user
#     (inside rootless-docker containers), so it deliberately has no root.
#
# Run as root:  sudo scripts/setup-gitlab-runner-user  [--dry-run]
# Idempotent; safe to re-run. Next: setup-gitlab-runner-docker, then setup-gitlab-runner.

set -euo pipefail

USER_NAME="gitlab-runner"
USER_HOME="/home/gitlab-runner"
USER_SHELL="/bin/bash"
DRY_RUN=false

usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,"");print;next} {exit}' "$0"; }
for a in "$@"; do case "$a" in
  --dry-run) DRY_RUN=true ;;
  -h|--help) usage; exit 0 ;;
  *) echo "unknown argument: $a" >&2; usage >&2; exit 1 ;;
esac; done

log()  { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[!]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[x]\033[0m %s\n' "$*" >&2; exit 1; }
run()  { if $DRY_RUN; then printf '    + %s\n' "$*"; else "$@"; fi; }

[ "$(id -u)" -eq 0 ] || die "must run as root (use sudo)"

if getent passwd "$USER_NAME" >/dev/null; then
  log "user $USER_NAME already exists — skipping useradd"
else
  log "creating user $USER_NAME (home=$USER_HOME, shell=$USER_SHELL, no sudo)"
  run useradd -m -d "$USER_HOME" -s "$USER_SHELL" "$USER_NAME"
fi

# Guard rail: the runner user must never have root.
if getent passwd "$USER_NAME" >/dev/null \
   && grep -qxE 'wheel|sudo|docker' <<<"$(id -nG "$USER_NAME" | tr ' ' '\n')"; then
  die "$USER_NAME is in wheel/sudo/docker — those are root-equivalent; remove it
      (e.g. gpasswd -d $USER_NAME docker). The runner user must have no root."
fi
$DRY_RUN || log "confirmed no root groups: $(id -nG "$USER_NAME" 2>/dev/null || echo '(pending)')"

log "done. Next: sudo scripts/setup-gitlab-runner-docker"
