#!/usr/bin/env bash
#
# setup-gitlab-runner-user — provision one dedicated GitLab runner system user.
#
# One runner user per trust domain per host (DND-1937): its CI never shares a
# home, cache, token or docker daemon with another runner user's.
#
#   * user <name> (default gitlab-runner), home /home/<name> at mode 0700,
#     shell /bin/bash, NO sudo/wheel/docker group
#   * /srv/ci/<name>, /srv/ci/<name>/docker (its rootless docker data root) and
#     /srv/ci/<name>/cache (the job cache), each 0700 and owned by <name>
#   * CI job code executes as this user (inside rootless-docker containers), so
#     it deliberately has no root, and no runner user can read another's files.
#
# Usage (as root):
#   sudo scripts/setup-gitlab-runner-user [--user <name>] [--dry-run]
#
#   --user <name>   gitlab-runner (default; the original DND-177 install) or
#                   gitlab-runner-<suffix>, e.g. gitlab-runner-personal
#   --dry-run       print what would change; change nothing
#   -h, --help      this text (stdout, exit 0, does nothing else)
#
# Idempotent; safe to re-run. Next: setup-gitlab-runner-docker --user <name>,
# then setup-gitlab-runner --user <name>. Flags may come in any order.

set -euo pipefail

USER_NAME="gitlab-runner"
USER_SHELL="/bin/bash"
DRY_RUN=false

usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,"");print;next} {exit}' "$0"; }
SCRIPTS_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KIT_LIB="${SCRIPTS_DIR}/lib/gitlab-runner-kit.sh"
if [ ! -r "${KIT_LIB}" ]; then
  printf 'missing %s\nFix: run this script from the custom repo checkout (scripts/setup-gitlab-runner-user)\n' "${KIT_LIB}" >&2; exit 1
fi
# shellcheck source=lib/gitlab-runner-kit.sh
. "${KIT_LIB}"
# A refusal never echoes a glrt- token, whichever flag one was pasted into.
die()  { printf '\033[1;31m[x]\033[0m %s\n' "$(grk_redact "$1")" >&2; printf 'Fix: %s\n' "$(grk_redact "$2")" >&2; exit 1; }
while [ $# -gt 0 ]; do case "$1" in
  --dry-run) DRY_RUN=true ;;
  -h|--help) usage; exit 0 ;;
  --user=*) USER_NAME="${1#--user=}" ;;
  --user) [ $# -ge 2 ] || die "--user needs a value" "pass --user gitlab-runner-<suffix>, or omit --user for gitlab-runner"
          USER_NAME="$2"; shift ;;
  *) usage >&2; die "unknown argument: $1" "run with --help and pass only the flags it lists" ;;
esac; shift; done

log()  { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
run()  { if $DRY_RUN; then printf '    + %s\n' "$*"; else "$@"; fi; }

grk_validate_user "${USER_NAME}" || exit 1

# ATHENA_RUNNER_KIT_ROOT: the test seam (scripts/test/gitlab-runner-kit). Every
# file path is under it; unset in production, so paths are the real ones.
R="${ATHENA_RUNNER_KIT_ROOT:-}"
if [ -n "${R}" ] && { [[ "${R}" != /* ]] || [ ! -d "${R}" ]; }; then
  die "ATHENA_RUNNER_KIT_ROOT='${R}' is not an absolute existing directory" "unset ATHENA_RUNNER_KIT_ROOT (it is a test seam), or point it at a test root"
fi

[ "$(id -u)" -eq 0 ] || die "must run as root" "re-run with sudo: sudo $0 --user ${USER_NAME}"

if getent passwd "${USER_NAME}" >/dev/null; then
  log "user ${USER_NAME} already exists — skipping useradd"
else
  log "creating user ${USER_NAME} (home=/home/${USER_NAME}, shell=${USER_SHELL}, no sudo)"
  run useradd -m -d "/home/${USER_NAME}" -s "${USER_SHELL}" "${USER_NAME}"
fi

# Guard rail: the runner user must never have root.
if getent passwd "${USER_NAME}" >/dev/null \
   && grep -qxE 'wheel|sudo|docker' <<<"$(id -nG "${USER_NAME}" | tr ' ' '\n')"; then
  die "${USER_NAME} is in wheel/sudo/docker — those are root-equivalent" \
      "remove it from each (e.g. gpasswd -d ${USER_NAME} docker), then re-run. The runner user must have no root."
fi

USER_HOME="/home/${USER_NAME}"
if getent passwd "${USER_NAME}" >/dev/null; then
  USER_HOME="$(getent passwd "${USER_NAME}" | cut -d: -f6)"
  [[ "${USER_HOME}" == /* ]] || die "${USER_NAME}'s home '${USER_HOME}' is not an absolute path" \
    "set it with: usermod -d /home/${USER_NAME} ${USER_NAME}, then re-run"
fi

# Neither runner user can read the other's home.
log "home ${USER_HOME}: mode 0700"
run chmod 0700 "${R}${USER_HOME}"

CI_DIR="$(grk_ci_dir "${USER_NAME}")"
log "CI dirs ${CI_DIR}{,/docker,/cache}: mode 0700, owned by ${USER_NAME}"
run install -d -m 0755 -o root -g root "${R}/srv/ci"
for d in "${CI_DIR}" "${CI_DIR}/docker" "${CI_DIR}/cache"; do
  run install -d -m 0700 -o "${USER_NAME}" -g "${USER_NAME}" "${R}${d}"
done

$DRY_RUN || log "confirmed no root groups: $(id -nG "${USER_NAME}" 2>/dev/null || echo '(pending)')"

log "done. Next: sudo scripts/setup-gitlab-runner-docker --user ${USER_NAME}"
