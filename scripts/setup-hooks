      && echo "  ok   unrelated keys preserved" || { echo "  FAIL merge clobbered unrelated keys"; ok=0; }
    # THE AGENT-STASH ENV (DND-775): install appends, is idempotent, never
    # overwrites; --remove-env removes exactly its keys; the checker agrees.
    envs="${tmp}/settings-env.json"
    printf '{\n    "model": "x"\n}\n' > "$envs"
