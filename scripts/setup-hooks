      && echo "  ok   the checker passes with both matcher rows wired" \
      || { echo "  FAIL the checker must pass with both matcher rows wired"; ok=0; }
    rt="$(REGISTRY="$tworeg" apply install "$two" 0)"
    grep -q "MARKER:nochange" <<<"$rt" \
      && echo "  ok   a second install of the two-matcher registry changes nothing" \
      || { echo "  FAIL a second install must be a no-op: $rt"; ok=0; }
    # Sabotage: remove one of the two wirings; the checker must go red, naming it.
