stamp = env.pop("ATHENA_AGENT_ENV_INSTALLED_AT", "")
if not re.fullmatch(r"\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ", stamp):
    sys.exit(1)
age = datetime.datetime.now(datetime.timezone.utc) - datetime.datetime.strptime(stamp, "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=datetime.timezone.utc)
if not datetime.timedelta(seconds=-5) <= age <= datetime.timedelta(seconds=60):
    sys.exit(1)
sys.exit(0 if env == want and f"{main}/ai/git-hooks/agent-stash-guard.sh" in cmd
         and "/.local/worktrees/" not in cmd and env["ATHENA_AGENT_BIN"] == f"{main}/ai/agent-bin" else 1)
