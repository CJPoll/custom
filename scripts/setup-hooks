    HOOKS_REPO_DIR="$fix887"; CHECKER="${fix887}/ai/bin/check-hooks-registered"
    two="${tmp}/settings-two.json"
    printf '{}\n' > "$two"
    # matchers_of <settings>: the sorted PreToolUse matchers the script is wired under.
    matchers_of() {
      SETTINGS="$1" python3 - <<'PY3'
import json, os
s = json.load(open(os.environ["SETTINGS"]))
ms = sorted(m.get("matcher", "") for m in s.get("hooks", {}).get("PreToolUse", [])
            for h in m.get("hooks", []) if h.get("command", "").endswith("/dnd-887-two-matchers.sh"))
print(",".join(ms))
PY3
    }
    two_check() { HOOKS_REGISTRY_FILE="$tworeg" HOOKS_SETTINGS_FILE="$1" "$CHECKER" 2>&1; }
    REGISTRY="$tworeg" apply install "$two" 0 >/dev/null
    [ "$(matchers_of "$two")" = "Bash,Edit|Write" ] \
      && echo "  ok   two same-script rows with different matchers are both installed" \
      || { echo "  FAIL both matcher rows must be installed, got [$(matchers_of "$two")]"; ok=0; }
