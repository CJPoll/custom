      && echo "  ok   remove-env restores exactly the owner's env" \
      || { echo "  FAIL remove-env must leave exactly the owner's entries: $(cat "$envs")"; ok=0; }
    printf '{"env": {"ATHENA_AGENT_BIN": "/elsewhere"}}\n' > "$envs"
    cp "$envs" "${envs}.before"
    if apply install-env "$envs" 0 >/dev/null 2>&1; then
      echo "  FAIL install-env overwrote a differing ATHENA_AGENT_BIN"; ok=0
    elif cmp -s "$envs" "${envs}.before"; then
      echo "  ok   install-env refuses (never overwrites) a key set to another value"
    else
      echo "  FAIL a refused install-env still changed the file"; ok=0
    fi
    printf '{"model": "y"}\n' > "$envs"
    # --install is the routine hook-drift fix agents run: it must NEVER activate
    # the guard (critic, DND-775 round 1). Only --install-env does.
    HOOKS_SETTINGS_FILE="$envs" "$0" --install >/dev/null 2>&1 \
      && python3 -c "import json,sys; s=json.load(open('$envs')); sys.exit(0 if 'env' not in s and s.get('hooks') else 1)" \
      && echo "  ok   CLI: --install wires the hooks and never the agent-stash env" \
      || { echo "  FAIL CLI: --install must not write the agent-stash env"; ok=0; }
    HOOKS_SETTINGS_FILE="$envs" "$0" --install-env >/dev/null 2>&1 \
      && python3 -c "import json,sys; s=json.load(open('$envs')); sys.exit(0 if s.get('env',{}).get('ATHENA_AGENT_BIN') else 1)" \
      && HOOKS_SETTINGS_FILE="$envs" "$0" --remove-env >/dev/null 2>&1 \
      && python3 -c "import json,sys; s=json.load(open('$envs')); sys.exit(0 if 'env' not in s and s.get('hooks') and s.get('model')=='y' else 1)" \
      && echo "  ok   CLI: --install-env activates, --remove-env removes only the env" \
      || { echo "  FAIL CLI --install-env / --remove-env round trip"; ok=0; }

    [ "$ok" = 1 ] && { echo "ALL CASES PASS"; exit 0; } || { echo "SELF-TEST FAILED"; exit 1; }
    ;;

  install|remove|install-env|remove-env)
    if [ "$DRY_RUN" = 0 ] && [ -f "$SETTINGS" ]; then
      bak="${SETTINGS}.bak-$(date +%Y%m%d-%H%M%S)"
      cp -p "$SETTINGS" "$bak"
      say "backed up ${SETTINGS} -> ${bak}"
    fi
    # --install and --remove touch the hooks only: --install is the routine
    # hook-drift fix agents are told to run, so it must never activate
    # anything. --install-env merges the agent-stash env (DND-775): the OWNER's
    # activation step. --remove-env removes exactly that env (the guard's
    # one-command disable).
    case "$ACTION" in
      install)     steps="install" ;;
      remove)      steps="remove" ;;
      install-env) steps="install-env" ;;
      remove-env)  steps="remove-env" ;;
    esac
    for step in $steps; do
      out="$(apply "$step" "$SETTINGS" "$DRY_RUN")"
      echo "$out" | grep -v '^MARKER:' || true
      case "$step" in
        install-env|remove-env) what="agent-stash env (ai/hooks/registry.json env)" ;;
        *) what="registry hooks" ;;
      esac
      if grep -q "MARKER:nochange" <<<"$out"; then
        say "setup-hooks: nothing to do for the ${what} (${step})."
      elif grep -q "MARKER:wouldchange" <<<"$out"; then
        say "setup-hooks: (dry-run) the above ${what} change (${step}) would be applied to ${SETTINGS}."
      else
        say "setup-hooks: ${step} of the ${what} applied to ${SETTINGS}. It loads at session start: restart sessions to activate."
      fi
    done
    ;;
esac
