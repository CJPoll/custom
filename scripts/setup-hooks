import json, os, sys
main = os.environ["HOOKS_REPO_DIR"]
spec = json.load(open(os.environ["REGISTRY"]))["env"]
env = json.load(open(os.environ["SETTINGS"]))["env"]
want = {"GIT_CONFIG_COUNT": str(len(spec["git_config"]))}
for i, e in enumerate(spec["git_config"]):
    want[f"GIT_CONFIG_KEY_{i}"] = e["key"]
    want[f"GIT_CONFIG_VALUE_{i}"] = e["value"].replace("{{MAIN}}", main)
for k, v in spec["vars"].items():
    want[k] = v.replace("{{MAIN}}", main)
cmd = next(v for k, v in env.items() if k.startswith("GIT_CONFIG_VALUE_") and "agent-stash-guard.sh" in v)
# The install stamp (DND-1036): a real UTC second, within a minute of now.
