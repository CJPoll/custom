#!/usr/bin/env bash
#
# setup-hooks — wire the harness hooks into ~/.claude/settings.json.
#
# Source of truth is ai/hooks/registry.json. This installer MERGES those entries
# into the existing settings (adding any that are missing, de-duplicated on
# (event, matcher, script), and replacing a registry script's wiring under a
# matcher the registry no longer declares for it),
# NEVER rewriting the whole "hooks" block — a full rewrite is exactly what
# silently dropped safe-wait-guard + pronoun-guard on 2026-09-17. It backs up
# settings.json (timestamped) before any change, so there is always an undo path
# for a file that is not in git.
#
# Idempotent: re-running adds only what is missing and reports "already wired"
# otherwise. `--check` delegates to ai/bin/check-hooks-registered (the single
# source of the compare logic, also run by the shipwright gate).
#
# Usage:
#   setup-hooks [--install] [--dry-run]   merge registry hooks into settings (default).
#                                         Hooks only: never the agent-stash env.
#   setup-hooks --install-env [--dry-run] merge the agent-stash env (DND-775). The
#                                         OWNER's activation step; restart sessions
#                                         after. Agents do not run it.
#   setup-hooks --check                   assert registry hooks are wired (gate check)
#   setup-hooks --remove [--dry-run]      remove the registry hooks from settings
#   setup-hooks --remove-env [--dry-run]  remove exactly the agent-stash env keys
#                                         (DND-775's one-command disable; restart
#                                         sessions after)
#   setup-hooks --self-test               verify install/check/idempotency on a temp file
#   setup-hooks --help
#
# Override the target file with HOOKS_SETTINGS_FILE (used by --self-test; default
# ~/.claude/settings.json).
#
# The agent-stash env (DND-775) is ai/hooks/registry.json's `env` section: the
# GIT_CONFIG_* pairs that register the reference-transaction hook
# ai/git-hooks/agent-stash-guard.sh, GIT_TRACE2=/dev/null, and ATHENA_AGENT_BIN.
# Its GIT_CONFIG pairs are APPENDED after any the settings env already holds,
# never written over an index in use; a key already present with another value
# is refused, never overwritten. --remove-env deletes exactly those keys and
# renumbers the rest. An --install-env that adds ATHENA_AGENT_BIN also writes
# ATHENA_AGENT_ENV_INSTALLED_AT (UTC, to the second) in the same write, so
# check-hooks-registered can tell a session started before the install
# (PENDING RESTART) from drift (DND-1036); --remove-env removes it too.
#
# Exit codes: 0 ok · 1 usage/arg error · 2 missing prerequisite (no python3/registry)
# · 3 an unreadable settings file or env · 4 an unquotable main-checkout path
# · 5 the settings env already holds part of the agent-stash env with other values

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd -P)"
REPO_DIR="$(cd -- "${SCRIPT_DIR}/.." && pwd -P)"
# HOOKS_REGISTRY_FILE is a TEST SEAM, like HOOKS_SETTINGS_FILE beside it: the
# self-test needs a registry naming a hook that is deliberately not on disk, and
# the alternative is a case that re-implements norm() and asserts on its own
# copy instead of on the shipped code.
REGISTRY="${HOOKS_REGISTRY_FILE:-${REPO_DIR}/ai/hooks/registry.json}"
CHECKER="${REPO_DIR}/ai/bin/check-hooks-registered"

# Hook commands must be wired at the MAIN checkout's path, NEVER a worktree's:
# a worktree path vanishes on cleanup, leaving settings.json pointing at a hook
# that no longer exists — silently disabling the guard, the 2026-09-17 outage
# class. Captains run from worktrees (observed 2026-09-18, DND-182), so resolve
# the main checkout through git's common dir (a worktree's --git-common-dir IS
# the main checkout's .git) and wire THAT. Falls back to REPO_DIR outside git.
main_checkout_dir() {
  local common parent
  common="$(git -C "$REPO_DIR" rev-parse --git-common-dir 2>/dev/null)" || { printf '%s\n' "$REPO_DIR"; return 0; }
  [ -n "$common" ] || { printf '%s\n' "$REPO_DIR"; return 0; }
  case "$common" in /*) ;; *) common="${REPO_DIR}/${common}" ;; esac
  parent="$(dirname -- "$common")"
  if [ -d "$parent" ]; then (cd -- "$parent" && pwd -P); else printf '%s\n' "$REPO_DIR"; fi
}
HOOKS_REPO_DIR="$(main_checkout_dir)"
SETTINGS="${HOOKS_SETTINGS_FILE:-${HOME}/.claude/settings.json}"

ACTION="install"
DRY_RUN=0

usage() { awk 'NR==1{next} /^#/{sub(/^# ?/,"");print;next} {exit}' "$0"; }
say()   { printf '%s\n' "$*"; }

while [ $# -gt 0 ]; do
  case "$1" in
    --install)  ACTION="install" ;;
    --check)    ACTION="check" ;;
    --remove)   ACTION="remove" ;;
    --install-env) ACTION="install-env" ;;
    --remove-env) ACTION="remove-env" ;;
    --self-test) ACTION="self-test" ;;
    # Internal: print this tool's normalized form of one path. Used by the
    # self-test to compare against check-hooks-registered's, driving both
    # SHIPPED implementations rather than copies of them.
    # Consume the value only if there IS one, so `--norm` as the last argument
    # does not `shift` an empty stack and trip `set -e` with a bare exit.
    --norm) ACTION="norm"; NORM_ARG="${2:-}"; if [ $# -ge 2 ]; then shift; fi ;;
    --dry-run)  DRY_RUN=1 ;;
    -h|--help)  usage; exit 0 ;;
    *) echo "error: unknown argument: $1" >&2; usage >&2; exit 1 ;;
  esac
  shift
done

command -v python3 >/dev/null 2>&1 || { echo "error: python3 required. Fix: install python3 or wire hooks by hand from ai/hooks/registry.json." >&2; exit 2; }
[ -f "$REGISTRY" ] || { echo "error: registry not found at $REGISTRY. Fix: restore ai/hooks/registry.json from git." >&2; exit 2; }

# The path normalizer AND the merge/remove logic, as ONE python program with a
# SINGLE norm(). `apply` runs the whole program; `norm_path` runs it with
# NORM_ONLY=1, which prints norm(NORM_IN) and exits BEFORE any registry/settings
# read — so the agreement case drives the EXACT norm() the installer uses, not a
# second copy of it. (setup-hooks and check-hooks-registered stay two
# INDEPENDENT norm()s that must agree; what this removes is the duplicate copy
# that used to live inside setup-hooks itself — which let the agreement case
# pass green while the shipped install-path norm() drifted, the critic finding
# of the DND-188 merge round.)
MERGE_PY="$(cat <<'PY'
import json, os, sys

def norm(cmd):
    # Resolve symlinks so two spellings of the same script compare equal — on
    # this machine ~/.claude/hooks is a symlink to the repo's ai/hooks/, so a live
    # entry `~/.claude/hooks/foo.sh` is the SAME file as `<repo>/ai/hooks/foo.sh`.
    # Without this, a raw-string compare treats them as distinct and install
    # appends a duplicate wiring (double-firing the guard).
    #
    # THE DIRECTORY IS RESOLVED EVEN WHEN THE FILE DOES NOT EXIST. Falling back
    # to the literal string for a missing file made the comparison depend on
    # something irrelevant to it — whether the script happens to be on disk
    # right now. Two cases hit that: a hook that is ALREADY WIRED but whose file
    # is temporarily absent (a moved checkout, a half-finished edit) was seen as
    # unwired and duplicated, which is the exact double-firing this function
    # exists to prevent; and a hook being ADDED on a branch, where `--self-test`
    # resolves the repo dir to the MAIN checkout by design, so the file is not
    # there yet and a correct registry entry reported a false failure. Resolving
    # only `dirname` answers the question actually being asked — are these two
    # spellings the same location — and needs no file to do it.
    if not cmd:
        return cmd
    try:
        if os.path.exists(cmd):
            return os.path.realpath(cmd)
        head, tail = os.path.split(cmd)
        # A missing HEAD is left alone, exactly as check-hooks-registered's
        # `norm` leaves it: realpath would resolve it against the CWD and
        # invent an absolute path for a command that names no location this
        # process can see. The two must agree, or drift is reported by one tool
        # and not the other.
        if not head or head == os.curdir or not os.path.isdir(head):
            return cmd
        return os.path.join(os.path.realpath(head), tail)
    except OSError:
        return cmd

# NORM_ONLY: print this tool's norm() of NORM_IN and exit, BEFORE reading any
# registry or settings file. This is the entry the agreement case reaches
# through `--norm`, so it drives the very function `apply` uses below.
if os.environ.get("NORM_ONLY"):
    sys.stdout.write(norm(os.environ.get("NORM_IN", "")) + "\n")
    sys.exit(0)

repo   = os.environ["REPO_DIR"]
reg    = json.load(open(os.environ["REGISTRY"]))["hooks"]
path   = os.environ["SETTINGS"]
mode   = os.environ["MODE"]
dry    = os.environ["DRY"] == "1"

def absscript(rel): return os.path.join(repo, rel)

try:
    with open(path) as f: settings = json.load(f)
except FileNotFoundError:
    settings = {}
except json.JSONDecodeError as e:
    print(f"error: {path} is not valid JSON ({e}).", file=sys.stderr)
    print("Fix: repair or restore the file, then re-run setup-hooks.", file=sys.stderr)
    sys.exit(3)

if mode in ("install-env", "remove-env"):
    # THE AGENT-STASH ENV (DND-775): the registry's `env` section, merged into
    # settings `env`. GIT_CONFIG pairs are APPENDED after any the settings
    # already hold (never written over an index in use); `remove-env` deletes
    # exactly these keys and renumbers what is left. {{MAIN}} is the main
    # checkout (repo, above), never a worktree.
    import re
    spec = json.load(open(os.environ["REGISTRY"])).get("env")
    if spec is None:
        print("MARKER:nochange")
        sys.exit(0)
    if not re.fullmatch(r"/[A-Za-z0-9._/+-]+", repo):
        print(f"error: the main checkout path {repo!r} holds characters the hook command cannot quote.", file=sys.stderr)
        print("Fix: move the checkout to a path of letters, digits and . _ / + - and re-run.", file=sys.stderr)
        sys.exit(4)
    ex = lambda v: v.replace("{{MAIN}}", repo)
    pairs = [(e["key"], ex(e["value"])) for e in spec["git_config"]]
    ours = {k for k, _ in pairs}
    # Must equal AgentStashEnv::INSTALLED_AT (ai/lib/agent_stash_env.rb); the
    # self-test's install-env case asserts the checker reads what this writes.
    STAMP_KEY = "ATHENA_AGENT_ENV_INSTALLED_AT"
    vars_ = {k: ex(v) for k, v in spec["vars"].items()}
    env = settings.get("env", {})
    if not isinstance(env, dict):
        print(f"error: {path}: \"env\" is not an object.", file=sys.stderr)
        print("Fix: repair the file by hand; setup-hooks never rewrites a block it cannot read.", file=sys.stderr)
        sys.exit(3)
    raw = env.get("GIT_CONFIG_COUNT", "0")
    if not (isinstance(raw, str) and raw.isdigit()):
        print(f"error: {path}: env GIT_CONFIG_COUNT is {raw!r}, not a count.", file=sys.stderr)
        print("Fix: repair it by hand (a string of digits), then re-run.", file=sys.stderr)
        sys.exit(3)
    n = int(raw)
    entries = []
    for i in range(n):
        k, v = env.get(f"GIT_CONFIG_KEY_{i}"), env.get(f"GIT_CONFIG_VALUE_{i}")
        if not (isinstance(k, str) and isinstance(v, str)):
            print(f"error: {path}: env GIT_CONFIG_KEY_{i}/VALUE_{i} missing under GIT_CONFIG_COUNT={n}.", file=sys.stderr)
            print("Fix: repair the GIT_CONFIG_* entries by hand, then re-run.", file=sys.stderr)
            sys.exit(3)
        entries.append((k, v))
    changes = []
    if mode == "install-env":
        conflicts = []
        have = dict(entries)
        for k, v in pairs:
            if k in have and have[k] != v:
                conflicts.append(f"{k} is set to a different value")
        for k, v in vars_.items():
            if k in env and env[k] != v:
                conflicts.append(f"{k} is {env[k]!r}, want {v!r}")
        stray = [key for key in env if re.fullmatch(r"GIT_CONFIG_(KEY|VALUE)_\d+", key)
                 and int(key.rsplit("_", 1)[1]) >= n]
        for key in stray:
            conflicts.append(f"{key} sits past GIT_CONFIG_COUNT={n} (git never reads it; appending would overwrite it)")
        if conflicts:
            print(f"error: {path} already holds part of the agent-stash env with other values:", file=sys.stderr)
            for c in conflicts:
                print(f"  - {c}", file=sys.stderr)
            print("Fix: run `setup-hooks --remove-env`, then `setup-hooks --install-env` (never overwritten in place).", file=sys.stderr)
            sys.exit(5)
        idx = n
        for k, v in pairs:
            if k in have:
                continue
            env[f"GIT_CONFIG_KEY_{idx}"] = k
            env[f"GIT_CONFIG_VALUE_{idx}"] = v
            changes.append(f"+ env GIT_CONFIG_KEY_{idx}={k}")
            idx += 1
        if idx != n:
            env["GIT_CONFIG_COUNT"] = str(idx)
        bin_added = False
        for k, v in vars_.items():
            if k not in env:
                env[k] = v
                changes.append(f"+ env {k}={v}")
                bin_added = bin_added or k == "ATHENA_AGENT_BIN"
        # The install time (DND-1036), written in the same file write that
        # adds ATHENA_AGENT_BIN, and at no other time: a session whose shell
        # snapshot predates it is a pending restart, not drift. ATHENA_AGENT_BIN
        # is the key whose arrival puts the wrapper on a new session's PATH. A
        # run that only adds GIT_CONFIG pairs (a grown landed env, a partial
        # env) never moves it, and a no-op run never backfills it: stamping
        # "now" onto an older install would read sessions started between the
        # two -- whose missing wrapper is a real failure -- as pending.
        if bin_added:
            import datetime
            stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
            env[STAMP_KEY] = stamp
            changes.append(f"+ env {STAMP_KEY}={stamp}")
    else:  # remove-env
        keep = [(k, v) for k, v in entries if k not in ours]
        if len(keep) != len(entries):
            for i in range(n):
                env.pop(f"GIT_CONFIG_KEY_{i}", None)
                env.pop(f"GIT_CONFIG_VALUE_{i}", None)
            for i, (k, v) in enumerate(keep):
                env[f"GIT_CONFIG_KEY_{i}"] = k
                env[f"GIT_CONFIG_VALUE_{i}"] = v
            for k, _ in entries:
                if k in ours:
                    changes.append(f"- env GIT_CONFIG {k}")
            if keep:
                env["GIT_CONFIG_COUNT"] = str(len(keep))
            else:
                env.pop("GIT_CONFIG_COUNT", None)
        for k, v in vars_.items():
            # GIT_TRACE2 is removed only when it is ours (/dev/null): the owner
            # may set it for other reasons.
            if k in env and (k != "GIT_TRACE2" or env[k] == v):
                del env[k]
                changes.append(f"- env {k}")
        if STAMP_KEY in env:
            del env[STAMP_KEY]
            changes.append(f"- env {STAMP_KEY}")
    if env:
        settings["env"] = env
    else:
        settings.pop("env", None)
    for c in changes:
        print(c)
    if not changes:
        print("MARKER:nochange")
        sys.exit(0)
    if dry:
        print("MARKER:wouldchange")
        sys.exit(0)
    with open(path, "w") as f:
        json.dump(settings, f, indent=4)
        f.write("\n")
    print("MARKER:changed")
    sys.exit(0)

hooks = settings.setdefault("hooks", {})

# A wiring is identified by (event, matcher, script) -- DND-887. Keyed on
# (event, script) alone, a second registry row for the same script on the same
# event with a different matcher collapsed into the first: it was never
# installed, and check-hooks-registered could not see it. Claude Code treats an
# omitted matcher, "" and "*" alike (match everything), so they compare equal.
# check-hooks-registered's `mnorm` makes the same choice; the two must agree.
def mnorm(matcher):
    return "" if matcher in (None, "", "*") else matcher

def has(event, matcher, cmd):
    target, want = norm(cmd), mnorm(matcher)
    for m in hooks.get(event, []):
        if mnorm(m.get("matcher")) != want:
            continue
        for h in m.get("hooks", []):
            if norm(h.get("command")) == target:
                return True
    return False

def drop(event, target, keep):
    """Remove every wiring of `target` on `event` whose group matcher `keep`
    rejects, then drop only the groups THIS call emptied (and the event, if
    that leaves it empty). A group that was already empty is someone else's
    content and stays. Returns the matchers removed, so the caller reports
    each one."""
    removed, emptied = [], []
    for m in hooks.get(event, []):
        if keep(mnorm(m.get("matcher"))):
            continue
        before = len(m.get("hooks", []))
        m["hooks"] = [h for h in m.get("hooks", []) if norm(h.get("command")) != target]
        if len(m["hooks"]) != before:
            removed.append(m.get("matcher"))
            if not m["hooks"]:
                emptied.append(id(m))
    if emptied:
        hooks[event] = [m for m in hooks[event] if id(m) not in emptied]
        if not hooks[event]:
            del hooks[event]
    return removed

# The matchers the registry declares for each (event, script) pair.
declared = {}
for e in reg:
    declared.setdefault((e["event"], e["script"]), set()).add(mnorm(e["matcher"]))

changes = []
if mode == "install":
    # Stale wiring first: a registry script wired on its event under a matcher
    # the registry does not declare for it -- a row whose matcher changed, or
    # two rows that were once one combined matcher (DND-840). Left in place it
    # double-fires beside the declared rows, so it is replaced. Only commands
    # that resolve to a registry script, on an event the registry wires that
    # script on, are touched; every other entry is left exactly as found
    # (merge, never rewrite).
    #
    # Replacing REMOVES a live wiring, so it runs only when the registry being
    # installed is the main checkout's own. From a worktree's branch copy (or a
    # HOOKS_REGISTRY_FILE) it would narrow or drop a live guard before the
    # change is reviewed or landed -- the DND-670 path in reverse (DND-887
    # critic). There the stale wiring is kept and named, and the checker still
    # reports it.
    from_main = os.environ.get("FROM_MAIN") == "1"
    for (event, script), matchers in declared.items():
        target = norm(absscript(script))
        if not from_main:
            for m in hooks.get(event, []):
                if mnorm(m.get("matcher")) not in matchers and any(
                        norm(h.get("command")) == target for h in m.get("hooks", [])):
                    print(f'~ {event:13} {m.get("matcher")!r} -> {script}: stale matcher kept; only an '
                          f'install from the main checkout\'s own registry ({repo}) replaces it, after '
                          f'the change lands there.')
            continue
        for gone in drop(event, target, lambda mm, ms=matchers: mm in ms):
            changes.append(f'~ {event:13} {gone!r} -> {script} (stale matcher, replaced)')
    for e in reg:
        cmd = absscript(e["script"])
        if has(e["event"], e["matcher"], cmd):
            continue
        # Never wire a script the MAIN checkout does not have. Run from a
        # worktree whose branch adds a hook, the registry names a script that
        # exists only on the branch; wiring it at the main checkout's path
        # makes every event it matches fail with exit 127 until the branch
        # lands, and forever if it never does (DND-670, DND-743). Wire it after
        # it lands. check-hooks-registered treats such a hook as pending.
        # A script that is there but not executable fails the same way (exit
        # 126), so it is skipped too, and the fix named.
        if not os.path.isfile(cmd):
            print(f'~ {e["event"]:13} {e["matcher"]!r} -> {e["script"]}: skipped, not in the main '
                  f'checkout ({repo}) yet. Land it, then re-run setup-hooks --install there.')
            continue
        if not os.access(cmd, os.X_OK):
            print(f'~ {e["event"]:13} {e["matcher"]!r} -> {e["script"]}: skipped, not executable in '
                  f'the main checkout ({repo}). Fix: land a `chmod +x` for it, then re-run '
                  f'setup-hooks --install there.')
            continue
        changes.append(f'+ {e["event"]:13} {e["matcher"]!r} -> {e["script"]}')
        hooks.setdefault(e["event"], []).append(
            {"matcher": e["matcher"], "hooks": [{"type": "command", "command": cmd}]}
        )
else:  # remove: every wiring of a registry script on its event, whatever the matcher
    for (event, script) in declared:
        for gone in drop(event, norm(absscript(script)), lambda mm: False):
            changes.append(f'- {event:13} {gone!r} -> {script}')

for c in changes:
    print(c)

if not changes:
    print("MARKER:nochange")
    sys.exit(0)

if dry:
    print("MARKER:wouldchange")
    sys.exit(0)

with open(path, "w") as f:
    json.dump(settings, f, indent=4)
    f.write("\n")
print("MARKER:changed")
PY
)"

# Merge (or remove) the registry hooks into a settings file. Emits, on stdout,
# a one-line-per-change report and a trailing MARKER line the caller reads.
# All JSON work is done in python for safety, through the SINGLE norm() above.
apply() {
  local mode="$1"        # "install" | "remove"
  local settings="$2"
  local dry="$3"
  # FROM_MAIN=1 only when the registry being installed IS the main checkout's
  # own: replacing a stale matcher removes a live wiring, so it waits for the
  # change to land there (DND-887 critic).
  local from_main=0
  [ "$(realpath -m -- "$REGISTRY")" = "$(realpath -m -- "${HOOKS_REPO_DIR}/ai/hooks/registry.json")" ] && from_main=1
  REPO_DIR="$HOOKS_REPO_DIR" REGISTRY="$REGISTRY" SETTINGS="$settings" MODE="$mode" DRY="$dry" FROM_MAIN="$from_main" python3 -c "$MERGE_PY"
}

# norm_path <path>  -- print the SHIPPED norm() of one path, by running the
# SAME program `apply` runs, with NORM_ONLY=1 (which prints norm(NORM_IN) and
# exits before any settings read). Exists so the agreement case drives the
# installer's OWN norm(), not a copy of it: a case that re-implements the thing
# it pins cannot fail for the reason it names, which is exactly how the previous
# version of that case passed green while the two norm()s had drifted.
norm_path() {
  NORM_ONLY=1 NORM_IN="$1" python3 -c "$MERGE_PY"
}

case "$ACTION" in
  norm)
    norm_path "${NORM_ARG:-}"
    ;;

  check)
    exec "$CHECKER"
    ;;

  self-test)
    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT
    # The worktree-safety cases below judge the REAL resolution, so keep it.
    REAL_HOOKS_REPO_DIR="$HOOKS_REPO_DIR"
    # Everything else runs in a FIXTURE REPO whose origin/main is this tree
    # (ai/test/lib/landed-fixture.bash). The checker bars on what LANDED, so
    # run against the real checkout "check passes after install" fails on any
    # branch that edits the registry, and it reads the real origin over the
    # network (DND-743). In the fixture, installer and checker see one registry
    # and the fixture is its own main checkout.
    # shellcheck source=ai/test/lib/landed-fixture.bash
    . "${REPO_DIR}/ai/test/lib/landed-fixture.bash"
    fix="${tmp}/fixture"
    landed_fixture "$REPO_DIR" "$fix" scripts/setup-hooks ai/bin/check-hooks-registered ai/lib/landed.rb ai/lib/strict_argv.rb ai/lib/agent_stash_env.rb ai/hooks \
      || { echo "  FAIL could not build the fixture repo"; echo "SELF-TEST FAILED"; exit 1; }
    if [ "$REGISTRY" != "${REPO_DIR}/ai/hooks/registry.json" ]; then
      cp "$REGISTRY" "${fix}/ai/hooks/registry.json"
      landed_fixture_land "$fix" || { echo "  FAIL could not land the registry in the fixture repo"; echo "SELF-TEST FAILED"; exit 1; }
    fi
    fix="$(cd -- "$fix" && pwd -P)"
    REGISTRY="${fix}/ai/hooks/registry.json"
    CHECKER="${fix}/ai/bin/check-hooks-registered"
    HOOKS_REPO_DIR="$fix"
    export HOOKS_SETTINGS_FILE="${tmp}/settings.json"
    printf '{\n    "model": "x"\n}\n' > "$HOOKS_SETTINGS_FILE"
    ok=1
    r1="$(apply install "$HOOKS_SETTINGS_FILE" 0)"
    grep -q "MARKER:changed" <<<"$r1" || { echo "  FAIL first install should change"; ok=0; }
    python3 -c "import json;json.load(open('$HOOKS_SETTINGS_FILE'))" || { echo "  FAIL result not valid JSON"; ok=0; }
    "$CHECKER" >/dev/null 2>&1 && echo "  ok   check passes after install" || { echo "  FAIL check should pass after install"; ok=0; }
    r2="$(apply install "$HOOKS_SETTINGS_FILE" 0)"
    grep -q "MARKER:nochange" <<<"$r2" || { echo "  FAIL second install should be a no-op (idempotent)"; ok=0; }
    # Symlink dedup: a settings file that references the hooks through a symlinked
    # dir (mirrors this machine's ~/.claude/hooks -> repo ai/hooks) must be seen as
    # already wired — install must NOT append duplicate entries.
    slink="${tmp}/settings-symlink.json"
    hlink="${tmp}/hlink"
    ln -s "${HOOKS_REPO_DIR}/ai/hooks" "$hlink"
    REGISTRY="$REGISTRY" HLINK="$hlink" SLINK="$slink" python3 - <<'PY'
import json, os
reg = json.load(open(os.environ["REGISTRY"]))["hooks"]
hlink = os.environ["HLINK"]
hooks = {}
for e in reg:
    cmd = os.path.join(hlink, os.path.basename(e["script"]))
    hooks.setdefault(e["event"], []).append(
        {"matcher": e["matcher"], "hooks": [{"type": "command", "command": cmd}]})
json.dump({"hooks": hooks}, open(os.environ["SLINK"], "w"), indent=4)
PY
    rs="$(apply install "$slink" 0)"
    grep -q "MARKER:nochange" <<<"$rs" || { echo "  FAIL symlink-spelled hooks should be seen as wired (no duplicate install)"; ok=0; }
    HOOKS_SETTINGS_FILE="$slink" "$CHECKER" >/dev/null 2>&1 && echo "  ok   symlink-spelled hooks recognized as wired" || { echo "  FAIL check should pass on symlink-spelled hooks"; ok=0; }
    # ...and the same, for a hook whose FILE IS NOT THERE, driving the SHIPPED
    # code path rather than a copy of norm(). `norm` resolves the directory
    # rather than the whole path, so "are these two spellings the same
    # location" does not depend on whether the script is on disk right now.
    # Without that, a wired hook whose file is temporarily absent reads as
    # unwired and install DUPLICATES it (double-firing the guard on restore),
    # and a hook being added on a branch reddens this suite against the main
    # checkout it is not in yet. The case above only covers this incidentally,
    # and stops covering it the moment every registry hook exists in main -- so
    # this one uses a registry of its own naming a hook that is deliberately
    # not there.
    ghostreg="${tmp}/ghost-registry.json"
    printf '%s\n' '{ "hooks": [ { "event": "SessionStart", "matcher": "", "script": "ai/hooks/definitely-not-on-disk.sh" } ] }' > "$ghostreg"
    ghost="${tmp}/settings-ghost.json"
    HLINK="$hlink" SLINK="$ghost" python3 - <<'PY2'
import json, os
cmd = os.path.join(os.environ["HLINK"], "definitely-not-on-disk.sh")
json.dump({"hooks": {"SessionStart": [
    {"matcher": "", "hooks": [{"type": "command", "command": cmd}]}]}},
    open(os.environ["SLINK"], "w"), indent=4)
PY2
    rg="$(REGISTRY="$ghostreg" apply install "$ghost" 0)"
    grep -q "MARKER:nochange" <<<"$rg" \
      && echo "  ok   a symlink-spelled hook whose file is absent is still seen as wired" \
      || { echo "  FAIL an absent hook file must not make install duplicate the wiring"; ok=0; }
    # --install never wires a script the main checkout cannot RUN: a file
    # without the executable bit fails with exit 126 on every event, the same
    # class as the exit-127 absent script. It is skipped and named.
    printf '#!/bin/sh\nexit 0\n' > "${fix}/ai/hooks/noexec-fixture.sh"; chmod -x "${fix}/ai/hooks/noexec-fixture.sh"
    noexecreg="${tmp}/noexec-registry.json"
    printf '%s\n' '{ "hooks": [ { "event": "SessionStart", "matcher": "", "script": "ai/hooks/noexec-fixture.sh" } ] }' > "$noexecreg"
    noexec="${tmp}/settings-noexec.json"; printf '{}\n' > "$noexec"
