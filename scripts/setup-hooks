    ghost_out="$(HOOKS_REGISTRY_FILE="$ghostreg" HOOKS_SETTINGS_FILE="$ghost" "$CHECKER" 2>&1)" \
      && { echo "  FAIL the checker must fail a wired hook whose file is absent (dangling)"; ok=0; } \
      || if grep -q "definitely-not-on-disk.sh: does not exist" <<<"$ghost_out"; then
           echo "  ok   the checker resolves the symlink spelling and flags the absent hook as dangling"
         else
           echo "  FAIL the checker did not name the absent wired hook as dangling: $ghost_out"; ok=0
         fi
    # The two norm()s must agree on the input class that SEPARATES them, not
    # only on the absolute paths the installer happens to write. A `.`-headed
    # relative command is that class: one implementation returned the literal
    # string and the other invented a CWD-absolute path, while both comments
    # asserted step-lock as an invariant. Both sides here are the SHIPPED
    # implementations, reached through each tool's --norm: a case that compares
    # two copies cannot fail for the reason it names, which is how the previous
    # version of this case passed while the divergence was live.
    norm_agrees=1
    for probe in "./definitely-not-on-disk.sh" "definitely-not-on-disk.sh" \
                 "/nonexistent/dir/x.sh" "${hlink}/definitely-not-on-disk.sh" \
                 "${HOOKS_REPO_DIR}/ai/hooks/registry.json"; do
      py="$("$0" --norm "$probe")"
      rb="$("$CHECKER" --norm "$probe")"
      [ "$py" = "$rb" ] || { echo "  FAIL the two norm() implementations disagree on [$probe]: setup-hooks=[$py] checker=[$rb]"; ok=0; norm_agrees=0; }
    done
    [ "$norm_agrees" -eq 1 ] && echo "  ok   setup-hooks and check-hooks-registered normalize a path identically"

    # DND-887: a wiring is keyed on (event, matcher, script). Two registry rows
    # for ONE script on ONE event with different matchers are two wirings; keyed
    # on (event, script) the second collapsed into the first, was never
    # installed, and the checker could not see it. Every case below drives the
    # SHIPPED installer and checker against a two-row registry.
    tworeg="${tmp}/two-matcher-registry.json"
    printf '%s\n' '{ "hooks": [
      { "event": "PreToolUse", "matcher": "Bash",       "script": "ai/hooks/dnd-887-two-matchers.sh" },
      { "event": "PreToolUse", "matcher": "Edit|Write", "script": "ai/hooks/dnd-887-two-matchers.sh" } ] }' > "$tworeg"
    # These cases get their own fixture repo, whose LANDED registry is the
    # two-row one and whose main checkout has the script. Since DND-743 the
    # checker bars on what landed (a row only the branch declares is pending,
    # never drift) and --install skips a script the main checkout lacks, so a
    # synthetic registry that is neither landed nor on disk proves nothing.
    fix887="${tmp}/fixture-887"
    landed_fixture "$REPO_DIR" "$fix887" scripts/setup-hooks ai/bin/check-hooks-registered ai/lib/landed.rb ai/lib/strict_argv.rb ai/lib/agent_stash_env.rb ai/hooks \
      || { echo "  FAIL could not build the DND-887 fixture repo"; echo "SELF-TEST FAILED"; exit 1; }
